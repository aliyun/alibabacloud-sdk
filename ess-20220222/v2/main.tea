    query['CreditSpecification'] = request.creditSpecification;
  }
  if (!$isNull(request.customPriorities)) {
    query['CustomPriorities'] = request.customPriorities;
  }
  if (!$isNull(request.dataDisks)) {
    query['DataDisks'] = request.dataDisks;
  }
  if (!$isNull(request.dedicatedHostClusterId)) {
    query['DedicatedHostClusterId'] = request.dedicatedHostClusterId;
  }
  if (!$isNull(request.dedicatedHostId)) {
    query['DedicatedHostId'] = request.dedicatedHostId;
  }
  if (!$isNull(request.deletionProtection)) {
    query['DeletionProtection'] = request.deletionProtection;
  }
  if (!$isNull(request.deploymentSetId)) {
    query['DeploymentSetId'] = request.deploymentSetId;
  }
  if (!$isNull(request.hostName)) {
    query['HostName'] = request.hostName;
  }
  if (!$isNull(request.hpcClusterId)) {
    query['HpcClusterId'] = request.hpcClusterId;
  }
  if (!$isNull(request.httpEndpoint)) {
    query['HttpEndpoint'] = request.httpEndpoint;
