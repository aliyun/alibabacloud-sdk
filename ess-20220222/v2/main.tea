model CreateScalingRuleRequest {
  adjustmentType?: string(name='AdjustmentType', description='The adjustment method of the scaling rule. This parameter is required for simple scaling rules and step scaling rules. Valid values:

- QuantityChangeInCapacity: adds or removes a specified number of ECS instances.
