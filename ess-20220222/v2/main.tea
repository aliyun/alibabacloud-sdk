      autoSnapshotPolicyId?: string(name='AutoSnapshotPolicyId', description='The ID of the automatic snapshot policy applied to the data cloud disk.', example='sp-bp19nq9enxqkomib****'),
      burstingEnabled?: boolean(name='BurstingEnabled', description='Specifies whether to enable the burstable performance feature for the data cloud disk. Valid values:

- true: enables the feature.
- false: disables the feature. 
> You can set this parameter only when `SystemDisk.Category` is set to `cloud_auto`.

<props="china">For more information, see [ESSD AutoPL cloud disks](https://help.aliyun.com/document_detail/368372.html).', example='false'),
      categories?: [ string ](name='Categories', description='The multiple disk types of the data cloud disk. If the disk type with a higher priority is unavailable, Auto Scaling automatically tries the disk type with the next highest priority to create the data cloud disk. Valid values:
