      device?: string(name='Device', description='The mount point of the data cloud disk. If you do not specify this parameter, the system automatically allocates a mount point by default during automatic creation of the ECS instance. The mount point starts from /dev/xvdb and ends at /dev/xvdz.', example='/dev/xvdb'),
      diskName?: string(name='DiskName', description='The name of the data cloud disk. The name must be 2 to 128 characters in length and can contain letters, digits, colons (:), underscores (_), and hyphens (-). It must start with a letter and cannot start with `http://` or `https://`.', example='cloud_ssdData'),
      encrypted?: string(name='Encrypted', description='Specifies whether to encrypt the data cloud disk. Valid values:

