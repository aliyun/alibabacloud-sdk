/**
 * @summary Creates an Elastic Container Instance (ECI) scaling configuration. Auto Scaling uses this scaling configuration as a template for ECI instances and performs automatic creation of ECI instances to meet your business needs when a scale-out activity is triggered.
 *
 * @description The scaling configuration specifies the template for ECI instances used during scale-out activities.
 * The Cpu and Memory parameters specify the range of vCPUs and memory to define the instance type. Auto Scaling determines the available instance types based on factors such as I/O optimization and zone, and creates the most cost-effective instance based on price sorting. This method applies only when the scaling policy of the scaling group is set to cost optimization and no instance type is specified in the scaling configuration.
 *
 * @param request CreateEciScalingConfigurationRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateEciScalingConfigurationResponse
 */
@context("createEciScalingConfigurationWithContext")
async function createEciScalingConfigurationWithOptions(request: CreateEciScalingConfigurationRequest, runtime: $RuntimeOptions): CreateEciScalingConfigurationResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.acrRegistryInfos)) {
    query['AcrRegistryInfos'] = request.acrRegistryInfos;
  }
  if (!$isNull(request.activeDeadlineSeconds)) {
    query['ActiveDeadlineSeconds'] = request.activeDeadlineSeconds;
  }
  if (!$isNull(request.autoCreateEip)) {
    query['AutoCreateEip'] = request.autoCreateEip;
  }
  if (!$isNull(request.autoMatchImageCache)) {
    query['AutoMatchImageCache'] = request.autoMatchImageCache;
  }
  if (!$isNull(request.containerGroupName)) {
    query['ContainerGroupName'] = request.containerGroupName;
  }
  if (!$isNull(request.containers)) {
    query['Containers'] = request.containers;
  }
  if (!$isNull(request.costOptimization)) {
    query['CostOptimization'] = request.costOptimization;
  }
  if (!$isNull(request.cpu)) {
    query['Cpu'] = request.cpu;
