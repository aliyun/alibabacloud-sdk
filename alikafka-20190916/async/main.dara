model CreateAclRequest {
  aclOperationType: string(name='AclOperationType', description='The operation type. Valid values:

- **Write**: write

- **Read**: read

- **Describe**: read a transactional ID
- **IdempotentWrite**: perform an idempotent write to a cluster
- **IDEMPOTENT_WRITE**: perform an idempotent write to a cluster. Available only for serverless instances.
- **DESCRIBE_CONFIGS**: query configurations. Available only for serverless instances.

This parameter is required.', example='Read', position='Query'),
  aclOperationTypes?: string(name='AclOperationTypes', description='The operation types for batch authorization. Separate multiple operations with commas (,). Valid values:

- **Write**: write

- **Read**: read

- **Describe**: read a transactional ID
- **IdempotentWrite**: perform an idempotent write to a cluster
- **IDEMPOTENT_WRITE**: perform an idempotent write to a cluster. Available only for serverless instances.
- **DESCRIBE_CONFIGS**: query configurations. Available only for serverless instances.


> This parameter is supported only for serverless instances.', example='Write,Read', position='Query'),
  aclPermissionType?: string(name='AclPermissionType', description='The authorization method. Valid values:
- **DENY**: deny.
 
- **ALLOW**: allow.

> This parameter is supported only for serverless instances.', example='DENY', position='Query'),
  aclResourceName: string(name='AclResourceName', description='The resource name.

- The name of the resource. It can be a topic name, a group ID, a cluster name, or a transactional ID.

- You can use an asterisk (*) to specify all resources of this type.


> 
> - You can query the authorized resources by using an asterisk (*) only after you grant permissions to all resources.

This parameter is required.', example='X****', position='Query'),
  aclResourcePatternType: string(name='AclResourcePatternType', description='The matching mode. Valid values:

- **LITERAL**: exact match

- **PREFIXED**: prefix match

This parameter is required.', example='LITERAL', position='Query'),
  aclResourceType: string(name='AclResourceType', description='The resource type. Valid values:

- **Topic**: topic

- **Group**: consumer group
- **Cluster**: instance
- **TransactionalId**: transactional ID

This parameter is required.', example='Group', position='Query'),
  host?: string(name='Host', description='The source IP address.
>- Only specific IP addresses or an asterisk (*) (which allows all IP addresses) are supported. CIDR blocks are not supported.
>- This parameter is supported only for serverless instances.', example='*', position='Query'),
  instanceId: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='alikafka_pre-cn-v0h1cng0****', position='Query'),
  regionId: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou', position='Query'),
  username: string(name='Username', description='The username.

- Before calling this API, you must create a SASL user by calling CreateSaslUser. You can query existing users by calling DescribeSaslUsers.
- You can use an asterisk (*) to specify all usernames.

> You can query the authorized users by using an asterisk (*) only after you grant permissions to all users.

This parameter is required.', example='test***', position='Query'),
}

model CreateAclResponseBody = {
  code?: int32(name='Code', description='The status code. A value of 200 indicates success.', example='200'),
  message?: string(name='Message', description='The returned message.', example='operation success'),
  requestId?: string(name='RequestId', description='The request ID.', example='56729737-C428-4E1B-AC68-7A8C2D5****'),
  success?: boolean(name='Success', description='Indicates whether the call was successful.', example='true'),
}

model CreateAclResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateAclResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateAcl  CreateAclRequest
  * @return CreateAclResponse
 */
async function createAcl(request: CreateAclRequest): CreateAclResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateAcl', 'POST', '/', 'json', false, 'json', request);
}

