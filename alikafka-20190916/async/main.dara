model CreateTopicRequest {
  compactTopic?: boolean(name='CompactTopic', description='The cleanup policy that is configured when the storage engine of the topic is set to local storage. Valid values:

- false: delete cleanup policy.
- true: compact cleanup policy.', example='false', position='Query'),
  config?: string(name='Config', description='The supplementary configuration.

- The value must be in JSON format.

- This parameter takes effect only when **LocalTopic** is set to **true**.

- Supported configurations for reserved instances:
  - **retention.ms**: the message retention period. Valid values: 3600000 to 31536000000. Unit: milliseconds.
  - **max.message.bytes**: the maximum message size. Valid values: 1048576 to 10485760. Unit: bytes.
  - **message.timestamp.type**: the type of the message timestamp. CreateTime indicates the timestamp specified by the producer when sending a message. If not specified, the value is the creation time of the message on the client. LogAppendTime indicates the time when the message is written to disk on the server. Valid values: CreateTime or LogAppendTime. Default value: Createtime. We recommend that you use ApendTime.

- Supported configurations for Serverless instances:
  - **retention.hours**: the message retention period. The value type is String. Valid values: 24 to 8760.
  - **max.message.bytes**: the maximum message size. The value type is String. Valid values: 1048576 to 10485760.
  - **message.timestamp.type**: the type of the message timestamp. CreateTime indicates the timestamp specified by the producer when sending a message. If not specified, the value is the creation time of the message on the client. LogAppendTime indicates the time when the message is written to disk on the server. Valid values: CreateTime or LogAppendTime. Default value: Createtime. We recommend that you use ApendTime.', example='{"retention.ms": "3600000"}', position='Query'),
  instanceId: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='alikafka_pre-cn-mp919o4v****', position='Query'),
  localTopic?: boolean(name='LocalTopic', description='The storage engine of the topic. Valid values:

- false: cloud storage.
- true: local storage.', example='false', position='Query'),
  minInsyncReplicas?: long(name='MinInsyncReplicas', description='The minimum number of in-sync replicas (ISR).

- This parameter takes effect only when **LocalTopic** is set to **true**.

- The value must be less than the number of topic replicas.

- Valid values: 1 to 3.', example='1', minimum=1, maximum=3, position='Query'),
  partitionNum?: string(name='PartitionNum', description='The number of partitions for the topic.

- Valid values: 1 to 360.

- The console provides different configuration suggestions based on the instance edition. Configure the number of partitions based on the console suggestions to reduce data skew risks.

Default value:

- Reserved instances: 12

- Serverless instances: 3', example='12', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the instance to which the topic belongs.

This parameter is required.', example='cn-hangzhou', position='Query'),
  remark: string(name='Remark', description='The description of the topic.

- The description can contain only letters, digits, underscores (_), and hyphens (-).

- The description must be 3 to 64 characters in length.

This parameter is required.', example='alikafka_topic_test', position='Query'),
  replicationFactor?: long(name='ReplicationFactor', description='The number of replicas for the topic.

- This parameter takes effect only when **LocalTopic** is set to **true**.

- Valid values: 1 to 3.

> If the number of replicas is set to **1**, data loss may occur. Proceed with caution.', example='3', minimum=1, maximum=3, position='Query'),
  tag?: [ 
    {
      key: string(name='Key', description='The tag key of the resource.

- N ranges from 1 to 20.

- If this parameter is left empty, all tag keys are matched.

- The tag key can be up to 128 characters in length and cannot start with `aliyun` or `acs:`. It cannot contain `http://` or `https://`.

This parameter is required.', example='FinanceDept'),
      value?: string(name='Value', description='The tag value of the resource.

- N ranges from 1 to 20.

- This parameter can be left empty.

- The tag value can be up to 128 characters in length and cannot start with aliyun or acs:. It cannot contain http:// or https://.', example='FinanceJoshua'),
    }
  ](name='Tag', description='The tag list.', position='Query'),
  topic: string(name='Topic', description='The name of the topic.

- Reserved instances: The name can contain letters, digits, underscores (_), hyphens (-), and periods (.). The name must be 3 to 64 characters in length.
- Serverless instances: The name can contain letters, digits, underscores (_), hyphens (-), and periods (.). The name must be 1 to 249 characters in length.

This parameter is required.', example='alikafka_topic_test', position='Query'),
}

