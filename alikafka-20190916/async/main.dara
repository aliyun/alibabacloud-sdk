model CreatePrePayInstanceRequest {
  confluentConfig?: {
    confluentVersion?: string(name='ConfluentVersion', description='The platform version of the Confluent instance. Valid values: 7.8.2 and 8.2.1. If you select 7.8.2, you must configure ZooKeeper. If you select 8.2.1, you must configure KRaft Controller. You can configure only one of the two metadata components in a single request.', example='7.8.2'),
    connectCU?: int32(name='ConnectCU', description='The number of CPU cores for the Connect component.', example='4'),
