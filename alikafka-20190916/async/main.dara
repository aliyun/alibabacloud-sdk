model CreatePostPayInstanceRequest {
  deployType: int32(name='DeployType', description='The deployment type. Valid values:

- **4**: Internet- and VPC-connected instance

- **5**: VPC-connected instance

This parameter is required.', example='4', position='Query'),
  diskSize?: int32(name='DiskSize', description='The cloud disk capacity.

For valid values, see [Billing overview](https://help.aliyun.com/document_detail/84737.html).
> This parameter is not required when you create a Serverless instance.', example='1500', position='Query'),
  diskType?: string(name='DiskType', description='The cloud disk type. Valid values:

- **0**: premium performance disk

- **1**: SSD
> This parameter is not required when you create a Serverless instance.', example='0', position='Query'),
  eipMax?: int32(name='EipMax', description='The Internet traffic.

- Required if **DeployType** is set to **4**.

- For valid values, see [Billing overview](https://help.aliyun.com/document_detail/84737.html).

> This parameter is not required when you create a Serverless instance.', example='3', position='Query'),
  ioMaxSpec?: string(name='IoMaxSpec', description='The traffic specification.

- For valid values, see [Billing overview](https://help.aliyun.com/document_detail/84737.html).

> This parameter is not required when you create a Serverless instance.', example='alikafka.hw.2xlarge', position='Query'),
  paidType?: int32(name='PaidType', description='The billing method. Valid values:

- 1 (default): pay-as-you-go for reserved instances.
- 3: pay-as-you-go for reserved capacity of Serverless instances plus pay-as-you-go for Serverless elastic scaling.', example='0', position='Query'),
  partitionNum?: int32(name='PartitionNum', description='The number of partitions to purchase.

* For valid values, see [Billing overview](https://help.aliyun.com/document_detail/84737.html).
> This parameter is not required for Serverless instances.', example='100', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the instance.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.

If not specified, the instance is added to the default resource group. You can view resource group IDs in the Resource Group console.', example='rg-ac***********7q', position='Query'),
  serverlessConfig?: {
    reservedPublishCapacity?: long(name='ReservedPublishCapacity', description='The reserved publish throughput specification. Only integers are supported. The minimum value is 60. Required for Serverless instances.

> The actual upper limit is subject to available inventory in the current region. Refer to the available options on the purchase page.', example='60'),
    reservedSubscribeCapacity?: long(name='ReservedSubscribeCapacity', description='The reserved subscribe throughput specification. Only integers are supported. The minimum value is 20. Required for Serverless instances.

> The actual upper limit is subject to available inventory in the current region. Refer to the available options on the purchase page.', example='20'),
  }(name='ServerlessConfig', description='The settings for the Serverless instance. Required when creating a Serverless instance.', shrink='json', position='Query'),
  specType?: string(name='SpecType', description='The instance type.

When PaidType is set to 1 (pay-as-you-go for reserved instances), valid values are:

- normal: Standard Edition (high-write)
- professional: Professional Edition (high-write)
- professionalForHighRead: Professional Edition (high-read)

When PaidType is set to 3 (pay-as-you-go for reserved capacity of Serverless instances plus pay-as-you-go for Serverless elastic scaling), valid values are:

- basic: Serverless Basic Edition
- normal: Serverless Standard Edition
- professional: Serverless Professional Edition

For descriptions of the above instance types, see [Billing overview](https://help.aliyun.com/document_detail/84737.html).', example='professional', position='Query'),
  tag?: [ 
    {
      key: string(name='Key', description='The tag key of the resource.
- N ranges from 1 to 20.
- If left empty, all tag keys are matched.
- The value can be up to 128 characters in length and cannot start with aliyun or acs:, or contain http:// or https://.

This parameter is required.', example='FinanceDept'),
      value?: string(name='Value', description='The tag value of the resource.
- N ranges from 1 to 20.
- If the tag key is empty, this parameter must also be empty. If empty, all tag values are matched.
- The value can be up to 128 characters in length and cannot start with aliyun or acs:, or contain http:// or https://.', example='test'),
    }
  ](name='Tag', description='The list of tags.', position='Query'),
}

