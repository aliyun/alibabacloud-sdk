  operatingObjectNames?: [ string ](name='operatingObjectNames', description='数字员工内部名称列表，最多100项，每项非空且最多256字符；SPECIFIED空数组表示不关联任何员工，非空名单按去重后全量替换', shrink='json', position='Body'),
  opsUserCode?: string(name='opsUserCode', description='代理用户编码（租户内唯一），仅当应用凭证配置为 source_uid 时使用', example='alice', position='Query'),
  opsUserId?: string(name='opsUserId', description='代理用户ID（WINNEXO 平台用户ID），仅当应用凭证配置为 winnexo_uid 时使用', example='10001', position='Query'),
  parentId?: long(name='parentId', description='The internal primary key of the new parent folder. If this parameter is omitted or set to null, the original parent folder is retained. If a non-null value is passed, knowledge base management permissions for the target parent folder are required. This parameter cannot be committed at the same time as the digital employee associate or version summary configurations.', example='1001', position='Body'),
  path?: string(name='path', description='The new directory path. If this parameter is omitted or set to null, a new path is not explicitly specified and is processed by the directory service.', example='/Product knowledge base', position='Body'),
  tenantId?: string(name='tenantId', description='The ID of the target tenant. It is used for tenant routing in public requests. The server-side authentication chain verifies access permissions. You cannot use this parameter to access unauthorized tenants.', example='10000', position='Query'),
}

