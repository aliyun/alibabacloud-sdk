import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'WinNexo';
  @version = '2026-05-12';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddUserGroupMembersRequest {
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='10000', position='Query'),
  userGroupId: string(name='userGroupId', description='目标用户组ID

This parameter is required.', example='7ea8973f-7a5c-4e8a-956b-4fe0e7e2eb11', position='Body'),
  userIds: [ long ](name='userIds', description='待添加的平台用户ID列表，1至100个

This parameter is required.', example='1', shrink='json', position='Body'),
}

model AddUserGroupMembersResponseBody = {
  affectedCount?: long(name='affectedCount', description='实际新增成员关系数量', example='2'),
  code?: string(name='code', description='业务状态码：成功为 200', example='200'),
  message?: string(name='message', description='错误描述，成功时为空', example='successful'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  requestedCount?: long(name='requestedCount', description='去重前请求成员数量', example='2'),
  userGroupId?: string(name='userGroupId', description='目标用户组ID', example='7ea8973f-7a5c-4e8a-956b-4fe0e7e2eb11'),
}

model AddUserGroupMembersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddUserGroupMembersResponseBody(name='body'),
}

/**
  * @description WinNexo 用户管理 OpenAPI：批量添加用户组成员。租户身份来自鉴权上下文。
  * @param request  the request parameters of AddUserGroupMembers  AddUserGroupMembersRequest
  * @return AddUserGroupMembersResponse
 */
async function addUserGroupMembers(request: AddUserGroupMembersRequest): AddUserGroupMembersResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddUserGroupMembers', 'POST', '/openapi/addUserGroupMembers', 'json', true, 'form', request);
}

model BatchRemoveOperatingObjectFavoritesRequest {
  graphName: string(name='graphName', description='数字员工所属图谱技术名

This parameter is required.', example='crm', position='Body'),
  objectIds: [ string ](name='objectIds', description='待取消关注的对象业务 ID，原始数组 1 至 200 项，每项为最长 128 字符的非空字符串

This parameter is required.', example='contract-001', shrink='json', position='Body'),
  objectType: string(name='objectType', description='数字员工配置的主对象或显式一级关联对象类型

This parameter is required.', example='contract', position='Body'),
  operatingObjectName: string(name='operatingObjectName', description='数字员工技术名；不得用 objectType 替代

This parameter is required.', example='customer_assistant', position='Body'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数；缺省时使用调用方默认租户', example='10000', position='Query'),
}

model BatchRemoveOperatingObjectFavoritesResponseBody = {
  code?: string(name='code', description='业务状态码：成功为 200', example='200'),
  graphName?: string(name='graphName', example='string_value'),
  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
  objectType?: string(name='objectType', example='string_value'),
  operatingObjectName?: string(name='operatingObjectName', example='string_value'),
  remainingCount?: long(name='remainingCount', description='精确范围内剩余关注对象数量', example='0'),
  removedCount?: long(name='removedCount', description='实际删除的物理关注记录数量', example='2'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  requestedCount?: long(name='requestedCount', description='去重后的请求对象数量', example='2'),
  results?: [ 
    {
      isFavorited?: boolean(name='isFavorited', example='true'),
      objectId?: string(name='objectId', example='exampleObjectId'),
      processed?: boolean(name='processed', example='true'),
    }
  ](name='results'),
}

model BatchRemoveOperatingObjectFavoritesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BatchRemoveOperatingObjectFavoritesResponseBody(name='body'),
}

/**
  * @description 按 graphName、operatingObjectName、objectType 三个独立维度幂等取消关注。原始数组单次 1 至 200 项，每项为最长 128 字符的非空字符串；服务端校验后保持顺序去重，非字符串、超长值或数组超限均被拒绝。删除、逐项状态和剩余有效数量在同一事务内完成。要安全取消全部关注，还必须调用 ClearOperatingObjectFavorites 清理列表不可见的历史、MISSING 或权限隐藏记录，并最终读回确认 total 为 0。
  * @param request  the request parameters of BatchRemoveOperatingObjectFavorites  BatchRemoveOperatingObjectFavoritesRequest
  * @return BatchRemoveOperatingObjectFavoritesResponse
 */
async function batchRemoveOperatingObjectFavorites(request: BatchRemoveOperatingObjectFavoritesRequest): BatchRemoveOperatingObjectFavoritesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'BatchRemoveOperatingObjectFavorites', 'POST', '/openapi/batchRemoveOperatingObjectFavorites', 'json', true, 'form', request);
}

