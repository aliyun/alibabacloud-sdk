  *     5. 已存在的授权记录会被更新（expire_date / permissions）
  * @param request  the request parameters of GrantAgentUsers  GrantAgentUsersRequest
  * @return GrantAgentUsersResponse
 */
async function grantAgentUsers(request: GrantAgentUsersRequest): GrantAgentUsersResponse {
