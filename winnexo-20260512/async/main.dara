  message?: string(name='message', description='The error description. This is empty when the call succeeds.', example='successful'),
  requestId?: string(name='requestId', description='The request trace ID.', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  revokedCount?: long(name='revokedCount', description='The number of records successfully revoked in this call.', example='1'),
}

model RevokeAgentUsersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: RevokeAgentUsersResponseBody(name='body'),
}

/**
  * @description Revokes the usage permissions of a user or user group on a specified digital human.
  *     Business logic:
  *     1. Constructs an AuthContext from identity.
  *     2. Performs mutual exclusion validation on the request body: either userIds or userGroupIds must be specified.
  *     3. Delegates to AgentAuthorizationAuthorizedService.revoke_authorization for execution.
  *     4. Pre-validation: MANAGE permission + agent existence check (performed by the AuthorizedService layer, which authenticates before exposing existence).
  *     5. After direct user authorization is revoked, the user may still have access through user group authorization.
  * @param request  the request parameters of RevokeAgentUsers  RevokeAgentUsersRequest
  * @return RevokeAgentUsersResponse
 */
async function revokeAgentUsers(request: RevokeAgentUsersRequest): RevokeAgentUsersResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'RevokeAgentUsers', 'POST', '/openapi/revokeAgentUsers', 'json', true, 'form', request);
}

