model MoveKnowledgeBaseResourceResponseBody = {
  code?: string(name='code', description='The response code.', example='200'),
  knowledgeId?: string(name='knowledgeId', description='The target knowledge base ID. This value is echoed from the request parameter.', example='exampleKnowledgeId'),
  message?: string(name='message', description='The description of the status code.', example='ok'),
  requestId?: string(name='requestId', description='The request ID.', example='375701FC-2FB9-5782-BE8F-A3F5E2F2158C'),
  sourceDirectoryId?: string(name='sourceDirectoryId', description='The source directory ID. This value is echoed from the request parameter.', example='exampleSourceDirectoryId'),
  sourceId?: string(name='sourceId', description='The unique identifier on the business system side, that is, the business ID.', example='2000358'),
