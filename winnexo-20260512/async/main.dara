  wnUserId?: string(name='wnUserId', description='The WinNexo user ID.', example='1', position='Body'),
}

model GetTokenEnsureEnableResponseBody = {
  code?: string(name='code', description='The status code.', example='200'),
  gmtCreate?: string(name='gmtCreate', description='The creation time.', example='2026-08-25T10:00:00+08:00'),
  message?: string(name='message', description='The description of the status code.', example='successful'),
  requestId?: string(name='requestId', description='The request ID.', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  token?: string(name='token', description='The temporary access credential for the data catalog.', example='example_token_value'),
  tokenMasked?: string(name='tokenMasked', description='The masked token value.', example='string_value'),
}

model GetTokenEnsureEnableResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetTokenEnsureEnableResponseBody(name='body'),
}

/**
  * @description Retrieves the INSTANCE token for a user and ensures that it is in an active state (idempotent).
  *     Business logic:
  *     1. Obtains user_id from identity (caller_type=user is enforced).
  *     2. Constructs an AuthContext and delegates permission verification to UserTokenAuthorizedService.
  *     3. Calls ensure_active_token:
  *        - If an ACTIVE token exists, returns the token in plaintext as-is (no reset, no key rotation).
  *        - If an INACTIVE token exists, automatically re-enables it and returns the plaintext.
  *        - If no token exists (or only expired RESET records exist), creates a new token and returns the plaintext.
  *     Difference from EnableToken: When an ACTIVE token already exists, EnableToken returns only the masked value. This operation guarantees that a usable plaintext credential is returned without destroying the existing token.
  * @param request  the request parameters of GetTokenEnsureEnable  GetTokenEnsureEnableRequest
  * @return GetTokenEnsureEnableResponse
 */
async function getTokenEnsureEnable(request: GetTokenEnsureEnableRequest): GetTokenEnsureEnableResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetTokenEnsureEnable', 'POST', '/openapi/getTokenEnsureEnable', 'json', true, 'form', request);
}

