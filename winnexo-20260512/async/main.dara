  fileRecordId: string(name='fileRecordId', description='新文件的文件记录 ID

This parameter is required.', example='exampleFileRecordId', position='Body'),
  forceSync?: boolean(name='forceSync', description='是否同步等待重新解析完成；默认 false，异步入队', example='false', position='Body'),
  sourceId: string(name='sourceId', description='待替换的企业知识库 FILE 数据源 ID

This parameter is required.', example='exampleSourceId', position='Body'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='10000', position='Query'),
}

