  *     业务逻辑：
  *     1. 从 identity 构造 AuthContext
  *     2. 委托 UserManagementAuthorizedService.list_system_roles 完成权限校验（PLATFORM_USER_VIEW）
  *     3. 按请求 Accept-Language 渲染角色名称与说明
  *     4. 返回固定的 7 个系统内置角色
  *     返回字段 roleCode 可直接用于 createUser / updateUser 的 roleCodes 参数。
  * @param request  the request parameters of ListRoles  ListRolesRequest
  * @return ListRolesResponse
 */
async function listRoles(request: ListRolesRequest): ListRolesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ListRoles', 'POST', '/openapi/listRoles', 'json', false, 'json', request);
}

