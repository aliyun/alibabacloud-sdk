  * - **Arguments**：必填，技能入参对象，结构由 `GetSkill` 返回的 inputConfig 描述。
  * - **ClientToken**：可选幂等键；当前版本仅记录到任务元数据，不做强幂等去重。
  * 注意：同步模式（Async=false）、Stream、CallbackUrl 一期不支持，将在后续版本提供。
  * @param request  the request parameters of RunSkill  RunSkillRequest
  * @return RunSkillResponse
 */
async function runSkill(request: RunSkillRequest): RunSkillResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'RunSkill', 'POST', '/openapi/runSkill', 'json', true, 'form', request);
}

