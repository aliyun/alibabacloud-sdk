  outputType?: string(name='outputType', description='输出类型：followUpOnly=仅追问类推荐（默认），skillOnly=仅推荐执行的 skill，both=追问+skill', example='followUpOnly', position='Body'),
  recentMessageCount?: long(name='recentMessageCount', description='组装上下文的最近消息条数，范围 1-30，默认 10（约 5 轮 user+assistant 对话回合）', example='10', minimum=1, maximum=30, position='Body'),
  sessionId: string(name='sessionId', description='会话ID

This parameter is required.', example='exampleSessionId', position='Body'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数；winnexo-cli 通过 --tenant-id 显式传入', example='10000', position='Query'),
}

model RecommendNextActionsResponseBody = {
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码（ERR.* / InvalidParameter.*）', example='200'),
  message?: string(name='message', description='错误描述，成功时为空', example='successful'),
  nextActions?: [ 
    {
      actionTitle?: string(name='actionTitle', description='不超过 15 字的祈使句标题', example='继续分析这个指标'),
      skillCode?: string(name='skillCode', description='技能唯一编码，recommend_action 时返回；前端据此触发技能', example='exampleSkillCode'),
      skillName?: string(name='skillName', description='技能展示名，recommend_action 时返回；仅用于展示', example='示例技能'),
      type?: string(name='type', description='推荐类型：recommend_reply=继续追问，recommend_action=触发技能', example='recommend_reply'),
    }
  ](name='nextActions', description='0-3 项下一步推荐'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  title?: string(name='title', description='会话标题', example='示例会话标题'),
}

model RecommendNextActionsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: RecommendNextActionsResponseBody(name='body'),
}

/**
  * @description ## 请求说明
  * 基于会话最近 N 条消息与智能体绑定的 skill，调用 LLM 生成 0~3 项下一步推荐（继续追问或推荐执行的技能）。
  * - `sessionId`：会话 ID，必填；仅允许当前鉴权用户有权限的会话。
  * - `recentMessageCount`：组装上下文的最近消息条数，范围 1-30，默认 10（约 5 轮 user+assistant 对话回合）。
  * - `customPrompt`：自定义推荐指令（不超过 10000 字符），作为自定义指令注入默认推荐模板（位于输出格式约束之前），输出仍受模板的 JSON 格式与类型约束。
  * - `outputType`：输出类型过滤。followUpOnly=仅追问类推荐（默认），skillOnly=仅技能推荐，both=同时生成两类。
  * 与内部端点不同，OpenAPI 调用不受用户个人设置中下一步推荐开关的限制，始终执行推荐生成。
  * @param request  the request parameters of RecommendNextActions  RecommendNextActionsRequest
  * @return RecommendNextActionsResponse
 */
async function recommendNextActions(request: RecommendNextActionsRequest): RecommendNextActionsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'RecommendNextActions', 'POST', '/openapi/recommendNextActions', 'json', true, 'form', request);
}

