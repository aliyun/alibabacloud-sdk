  autoPreference?: string(name='autoPreference', description='The AUTO preference. Valid values: none (default), performance (performance first), and credit (cost first). If omitted or set to null, the current value is retained. If set to an empty string, the value is reset to none. For fixed models, this parameter can be saved but does not take effect.', example='credit', position='Body'),
  description?: [ 
    {
      content?: string(name='content', description='The text content. This parameter is required when type is set to text.', example='Sample content'),
      enabled?: boolean(name='enabled', description='Specifies whether the feature is enabled. This parameter is optional when type is set to web_search.', example='true'),
      name?: string(name='name', description='The file name.', example='SampleName.pdf'),
