      skillCode?: string(name='skillCode', description='The skill code. This parameter has a value when type is set to skill.', example='string_value'),
      type: string(name='type', description='The element type. Valid values: text, web_search, mention, and skill.

This parameter is required.', example='text'),
    }
  ](name='description', description='The description.', shrink='json', position='Body'),
  digitalEmployeeName?: [ string ](name='digitalEmployeeName', description='The list of digital employee names.', example='["test"]', shrink='json', position='Body'),
  isOpen?: boolean(name='isOpen', description='Specifies whether public access is enabled.', example='true', position='Body'),
  model?: string(name='model', description='The execution model tier. If not specified, the model tier is not updated.', example='quick', position='Body'),
  name?: string(name='name', description='The file name.', example='SampleName.pdf', position='Body'),
  opsUserCode?: string(name='opsUserCode', description='The proxy user code, which is unique within the tenant. This parameter is used only when the application credential is configured as source_uid.', example='alice', position='Query'),
  opsUserId?: string(name='opsUserId', description='The proxy user ID, which is the WINNEXO platform user ID. This parameter is used only when the application credential is configured as winnexo_uid.', example='10001', position='Query'),
  outputMode?: string(name='outputMode', description='The output conversation mode. If not specified, the current configuration is retained.', example='SAME_CONVERSATION', position='Body'),
  segments?: [ 
    {
      content?: string(name='content', description='The text content. This parameter is required when type is set to text.', example='Sample content'),
      enabled?: boolean(name='enabled', description='Specifies whether the feature is enabled. This parameter is optional when type is set to web_search.', example='true'),
      name?: string(name='name', description='The file name.', example='SampleName.pdf'),
      objectId?: string(name='objectId', description='The object ID. This parameter has a value when type is set to mention.', example='exampleObjectId'),
      objectType?: string(name='objectType', description='The object type, such as customer. This parameter has a value when type is set to mention.', example='string_value'),
      skillCode?: string(name='skillCode', description='The skill code. This parameter has a value when type is set to skill.', example='string_value'),
      type: string(name='type', description='The element type. Valid values: text, web_search, mention, and skill.

This parameter is required.', example='text'),
    }
  ](name='segments', description='The segments.', shrink='json', position='Body'),
  taskDetail?: {
    relatedObjects?: [ 
      {
        mentionType?: string(name='mentionType', description='The mention type, such as objects.', example='string_value'),
        name?: string(name='name', description='The file name.', example='SampleName.pdf'),
        objectId?: string(name='objectId', description='The object ID. This parameter has a value when the object is specified by using @.', example='exampleObjectId'),
        objectType?: string(name='objectType', description='The object type, such as customer or company.', example='string_value'),
      }
    ](name='relatedObjects', description='The related objects.'),
    relatedSemantics?: [ 
      {
        attributes?: string(name='attributes', description='The semantic attributes in JSON string format. This parameter is used for filtering during semantic retrieval.', example='{"level": "VIP"}'),
        entity?: string(name='entity', description='The semantic entity name, such as customer or opportunity.', example='customer'),
      }
    ](name='relatedSemantics', description='The related semantics.'),
    relatedSkills?: [ 
      {
        displayName?: string(name='displayName', description='The display name of the skill.', example='string_value'),
        name?: string(name='name', description='The file name.', example='SampleName.pdf'),
        skillCode?: string(name='skillCode', description='The skill code.', example='string_value'),
        sourceIds?: [ string ](name='sourceIds', description='sourceIds', example='["sourceIds"]'),
      }
    ](name='relatedSkills', description='The related skills.'),
    taskUnderstand?: string(name='taskUnderstand', description='The task understanding description refined by the LLM.', example='string_value'),
  }(name='taskDetail', description='The task details.', shrink='json', position='Body'),
  taskId: string(name='taskId', description='The task ID.

This parameter is required.', example='exampleTaskId', position='Body'),
  tenantId?: string(name='tenantId', description='The tenant ID. This is a common parameter. If not specified, the default tenant of the caller is used.', example='10000', position='Query'),
  triggerConfig?: {
    cron?: string(name='cron', description='The cron expression. This parameter is required when trigger_mode is set to scheduled. Example: \\"00 09 * * *\\".', example='string_value'),
    language?: string(name='language', description='The language, such as zh-CN or en-US. This parameter is automatically injected by the server.', example='zh-CN'),
    pushConfig?: [ 
      {
        channelType?: string(name='channelType', description='The push channel.', example='DINGTALK'),
        contentScope?: string(name='contentScope', description='The scope of the push content. Default value: all_replies.', example='all_replies'),
        deliveryMethod?: string(name='deliveryMethod', description='The delivery method. Default value: channel_bot.', example='channel_bot'),
        enabled?: boolean(name='enabled', description='Specifies whether to push notifications to this channel. Default value: false.', example='true'),
        fileFormat?: string(name='fileFormat', description='The push format for output files. Default value: file.', example='file'),
        operatingObjectName?: string(name='operatingObjectName', description='The digital employee to which the sending bot belongs. This parameter is required and cannot be empty.', example='string_value'),
        receiverType?: string(name='receiverType', description='The receiver type. Currently, only self is supported.', example='string_value'),
      }
    ](name='pushConfig', description='The list of task push channels. If this list is empty or no channel is enabled, no push notification is sent.'),
    timezone?: string(name='timezone', description='The time zone, such as Asia/Shanghai. This parameter is automatically injected by the server.', example='Asia/Shanghai'),
    triggerMode: string(name='triggerMode', description='The trigger mode. Valid values: manual and scheduled.

This parameter is required.', example='manual'),
  }(name='triggerConfig', description='The trigger configuration. The configuration varies based on the trigger type.', shrink='json', position='Body'),
  visibility?: string(name='visibility', description='The visibility scope for group tasks. Valid values: PRIVATE (visible only to the creator and group owner), COLLABORATIVE (visible to specified collaborators), and PUBLIC (visible to all group members). If not specified, the visibility scope is not updated. This parameter is ignored for personal tasks.', example='COLLABORATIVE', position='Body'),
  visibleMemberUserIds?: [ string ](name='visibleMemberUserIds', description='The full replacement list of collaborators. This parameter takes effect only when visibility is set to COLLABORATIVE. A maximum of 1,000 members can be specified. If the visibility is changed from COLLABORATIVE to another value, the list is cleared. If not specified, the members are not updated. The task creator and group creator do not need to be specified because they are covered by the authentication layer. This parameter is ignored for personal tasks.', example='["10001"]', shrink='json', position='Body'),
}

