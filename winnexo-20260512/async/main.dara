  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='E68654BD-F7BA-5837-8686-5645D739A47C'),
  sourceDirectoryId?: string(name='sourceDirectoryId', description='源目录 ID（echo 回入参）', example='exampleSourceDirectoryId'),
