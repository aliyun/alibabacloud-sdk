model AddUserGroupMembersRequest {
  appToken?: string(name='appToken', description='平台应用 Token（控制台签发）。传入后将以 opsUserId 或 opsUserCode 指定的用户身份执行', example='wn_app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx', position='Query'),
  opsUserCode?: string(name='opsUserCode', description='代理用户编码（租户内唯一），仅当应用凭证配置为 source_uid 时使用', example='alice', position='Query'),
  opsUserId?: string(name='opsUserId', description='代理用户ID（WINNEXO 平台用户ID），仅当应用凭证配置为 winnexo_uid 时使用', example='10001', position='Query'),
  tenantId?: string(name='tenantId', description='The tenant ID. This is a common parameter. In winnexo-cli, pass this parameter explicitly by using `--tenant-id`.', example='10000', position='Query'),
  userGroupId: string(name='userGroupId', description='The ID of the target user group.

This parameter is required.', example='7ea8973f-7a5c-4e8a-956b-4fe0e7e2eb11', position='Body'),
  userIds: [ long ](name='userIds', description='The list of platform user IDs to add. Supports single or batch input. Duplicate relationships are idempotent.

This parameter is required.', example='1', shrink='json', position='Body'),
}

model AddUserGroupMembersResponseBody = {
  affectedCount?: long(name='affectedCount', description='The number of user group member relationships that were actually added.', example='2'),
  code?: string(name='code', description='The status code.', example='200'),
  message?: string(name='message', description='The description of the status code.', example='successful'),
  requestId?: string(name='requestId', description='The request trace ID.', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  requestedCount?: long(name='requestedCount', description='The number of requested members before deduplication.', example='2'),
  userGroupId?: string(name='userGroupId', description='The ID of the target user group.', example='7ea8973f-7a5c-4e8a-956b-4fe0e7e2eb11'),
}

model AddUserGroupMembersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddUserGroupMembersResponseBody(name='body'),
}

/**
  * @description ## Request description
  * - This operation supports batch addition of members by providing a user group ID and one or more user IDs.
  * - Duplicate entries in the user ID list do not cause errors. The system automatically handles duplicates to ensure each user is added only once.
  * - The caller must have the required permissions to perform this operation.
  * - This operation is applicable to scenarios that require quick team structure management or access control policy adjustments.
  * @param request  the request parameters of AddUserGroupMembers  AddUserGroupMembersRequest
  * @return AddUserGroupMembersResponse
 */
async function addUserGroupMembers(request: AddUserGroupMembersRequest): AddUserGroupMembersResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddUserGroupMembers', 'POST', '/openapi/addUserGroupMembers', 'json', true, 'form', request);
}

