This parameter is required.', example='401001', position='Body'),
  graphName?: string(name='graphName', description='The knowledge graph name.', example='crm_graph', position='Body'),
  tenantId?: string(name='tenantId', description='The tenant ID. This is a common parameter. Pass it explicitly by using --tenant-id in winnexo-cli.', example='10000', position='Query'),
}

model RevertGraphDraftResourceResponseBody = {
  code?: string(name='code', description='The error code.', example='200'),
  message?: string(name='message', description='The prompt message.', example='successful'),
  requestId?: string(name='requestId', description='The request trace ID.', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  reverted: boolean(name='reverted', description='Indicates whether the draft is actually revoked (true / false).

This parameter is required.', example='true'),
}

model RevertGraphDraftResourceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: RevertGraphDraftResourceResponseBody(name='body'),
}

/**
  * @description Revokes a single semantic resource draft via OpenAPI (personal token only).
  *     Business orchestration:
  *     1. Draft domain identity verification (personal token only. Deploy/system-level tokens are rejected)
  *        and semantic management permission verification.
  *     2. When graphName is provided, verifies draft ownership consistency (prevents accidental cross-knowledge-graph deletion).
  *        If the draft no longer exists, returns reverted=false (idempotent semantics, no error is reported).
  *     Error codes:
  *     - ERR.User.TokenUserOnly: Personal drafts support only user tokens.
  *     - ERR.Robject.Global.InvalidParameter: draftChangeId does not belong to the specified knowledge graph.
  * @param request  the request parameters of RevertGraphDraftResource  RevertGraphDraftResourceRequest
  * @return RevertGraphDraftResourceResponse
 */
async function revertGraphDraftResource(request: RevertGraphDraftResourceRequest): RevertGraphDraftResourceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'RevertGraphDraftResource', 'POST', '/openapi/revertGraphDraftResource', 'json', true, 'form', request);
}

model RevokeAgentUsersRequest {
  operatingObjectName: string(name='operatingObjectName', description='The name of the digital human.

This parameter is required.', example='string_value', position='Body'),
  tenantId?: string(name='tenantId', description='The tenant ID. This is a common parameter. If not specified, the default tenant of the caller is used.', example='10000', position='Query'),
  userGroupIds?: [ string ](name='userGroupIds', description='The list of user group IDs to be revoked (16-character hex strings).', example='string_value', shrink='json', position='Body'),
