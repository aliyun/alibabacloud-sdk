  code?: string(name='code', description='业务状态码：成功为 200', example='200'),
  graphName?: string(name='graphName', description='canonical 图谱技术名', example='crm'),
  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
  objectType?: string(name='objectType', description='对象类型技术名', example='contract'),
  operatingObjectName?: string(name='operatingObjectName', description='canonical 数字员工技术名', example='customer_assistant'),
  remainingCount?: long(name='remainingCount', description='同一事务内复核的未过滤剩余物理记录数量', example='0'),
  removedCount?: long(name='removedCount', description='实际删除的物理关注记录数量', example='2'),
