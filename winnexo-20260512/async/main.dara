  statusCode?: int32(name='statusCode'),
  body?: ClearOperatingObjectFavoritesResponseBody(name='body'),
}

/**
  * @description 按 graphName、operatingObjectName、objectType 三个独立维度清空当前调用用户的全部持久化关注，包括列表不可见的历史、MISSING 和权限隐藏记录。接口不返回不可见对象 ID，并在同一事务内复核剩余物理记录为零。
  * @param request  the request parameters of ClearOperatingObjectFavorites  ClearOperatingObjectFavoritesRequest
  * @return ClearOperatingObjectFavoritesResponse
 */
async function clearOperatingObjectFavorites(request: ClearOperatingObjectFavoritesRequest): ClearOperatingObjectFavoritesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ClearOperatingObjectFavorites', 'POST', '/openapi/clearOperatingObjectFavorites', 'json', true, 'form', request);
}

model CreateAnnouncementRequest {
  content: string(name='content', description='公告正文

This parameter is required.', example='系统将于今晚进行维护。', position='Body'),
  displayPage?: string(name='displayPage', description='展示页面：ALL、FRONTEND、BACKEND', example='ALL', position='Body'),
  displayType?: string(name='displayType', description='展示类型：POPUP、LIST、BANNER', example='LIST', position='Body'),
  effectiveEnd?: string(name='effectiveEnd', description='带时区的 ISO8601 生效结束时间；不传表示永久有效', example='2026-08-21T14:00:00+08:00', position='Body'),
  effectiveStart?: string(name='effectiveStart', description='带时区的 ISO8601 生效开始时间；不传表示立即生效', example='2026-08-20T14:00:00+08:00', position='Body'),
  priority: string(name='priority', description='公告重要性：URGENT、IMPORTANT、GENERAL

This parameter is required.', example='GENERAL', position='Body'),
  publishNow?: boolean(name='publishNow', description='是否创建后立即发布', example='false', position='Body'),
  targetRoleCodes?: [ string ](name='targetRoleCodes', description='指定系统角色 code 列表；targetRoleMode=SPECIFIED 时使用', example='["SYSTEM_ADMIN"]', shrink='json', position='Body'),
  targetRoleMode?: string(name='targetRoleMode', description='目标角色范围：ALL、SPECIFIED', example='ALL', position='Body'),
  targetTenantIds?: [ long ](name='targetTenantIds', description='指定目标租户 ID 列表；targetTenantMode=SPECIFIED 时使用', example='[10000]', shrink='json', position='Body'),
  targetTenantMode?: string(name='targetTenantMode', description='目标租户范围：ALL、SPECIFIED', example='ALL', position='Body'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数；缺省时使用调用方默认租户', example='10000', position='Query'),
  title: string(name='title', description='公告标题

This parameter is required.', example='系统维护通知', position='Body'),
}

model CreateAnnouncementResponseBody = {
  announcementId?: long(name='announcementId', description='公告业务 ID', example='1001'),
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码', example='200'),
  createdBy?: long(name='createdBy', description='创建人平台用户 ID', example='10001'),
  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
