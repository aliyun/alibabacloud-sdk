  createdAt?: string(name='createdAt', description='The task creation time in ISO 8601 UTC format.', example='string_value'),
  message?: string(name='message', description='The prompt message.', example='The current zone list is illegal.'),
  requestId?: string(name='requestId', description='The request ID.', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  runId?: string(name='runId', description='The asynchronous task ID, used for querying with getSkillRun.', example='exampleRunId'),
