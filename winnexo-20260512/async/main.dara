  pageSize?: int32(name='pageSize', description='每页数量，范围 1-100', example='10', minimum=1, maximum=100, position='Body'),
  tags?: [ string ](name='tags', description='按标签过滤，数组任一命中即匹配', example='string_value', shrink='json', position='Body'),
