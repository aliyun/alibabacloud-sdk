/**
  * @description 关闭用户的 INSTANCE Token。
  *     业务逻辑：
  *     1. 从 identity 取 user_id（强制 caller_type=user）
  *     2. 构造 AuthContext，委托 UserTokenAuthorizedService 完成权限校验
  *     3. 调用 disable_token（ACTIVE → INACTIVE）
  *     4. 返回 disabled=True
  *     幂等性：若当前无 ACTIVE Token，deactivate_all 影响 0 行，不报错。
  * @param request  the request parameters of DisableToken  DisableTokenRequest
  * @return DisableTokenResponse
 */
async function disableToken(request: DisableTokenRequest): DisableTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'DisableToken', 'POST', '/openapi/disableToken', 'json', true, 'form', request);
}

model EnableTokenRequest {
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='10000', position='Query'),
  wnUserId?: string(name='wnUserId', description='目标用户 ID（WINNEXO 平台用户ID，空则操作自身，管理员可传入他人 ID 代操作）', example='1', position='Body'),
}

model EnableTokenResponseBody = {
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码（ERR.* / InvalidParameter.*）', example='200'),
  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  token?: string(name='token', description='Token 明文（仅本次返回，请妥善保管）', example='example_token_value'),
  tokenMasked?: string(name='tokenMasked', description='脱敏后的 Token 值', example='string_value'),
}

model EnableTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: EnableTokenResponseBody(name='body'),
}

/**
  * @description 开启用户的 INSTANCE Token（幂等）。
  *     业务逻辑：
  *     1. 从 identity 取 user_id（强制 caller_type=user）
  *     2. 构造 AuthContext，委托 UserTokenAuthorizedService 完成权限校验
  *     3. 调用 enable_token：
  *        - 已有 ACTIVE → 幂等返回（仅脱敏值，不重复下发明文）
  *        - 有 INACTIVE → 重新激活（返回明文）
  *        - 都没有 → 新建（返回明文）
  *     安全约束：Token 明文仅在首次开启时返回一次，后续幂等调用不再下发明文。
  * @param request  the request parameters of EnableToken  EnableTokenRequest
  * @return EnableTokenResponse
 */
async function enableToken(request: EnableTokenRequest): EnableTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'EnableToken', 'POST', '/openapi/enableToken', 'json', true, 'form', request);
}

