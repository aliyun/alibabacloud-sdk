  code?: string(name='code', description='The business status code. A value of 200 indicates success. A failure returns a backend error code (ERR.* / InvalidParameter.*).', example='200'),
  message?: string(name='message', description='The status code description.', example='successful'),
  nextActions?: [ 
    {
      actionTitle?: string(name='actionTitle', description='The recommendation title.', example='Continue analyzing this metric'),
      skillCode?: string(name='skillCode', description='The skill code.', example='exampleSkillCode'),
      skillName?: string(name='skillName', description='The skill name.', example='SampleSkill'),
      type?: string(name='type', description='The recommendation type.', example='recommend_reply'),
    }
  ](name='nextActions', description='The next-step recommendations.'),
