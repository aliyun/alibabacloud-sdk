  skillName?: string(name='skillName', description='The skill name. Used when skillCode is not specified. The name must be unique within the tenant scope.', example='string_value', position='Body'),
  tenantId?: string(name='tenantId', description='The tenant ID. This is a common parameter. If not specified, the default tenant of the caller is used.', example='10000', position='Query'),
}

