model ResetPasswordRequest {
  passwordEncrypted: string(name='passwordEncrypted', description='RSA-OAEP-SHA256 加密后的新密码 base64 密文（必填，不可为空）

This parameter is required.', example='string_value', position='Body'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='21577', position='Query'),
