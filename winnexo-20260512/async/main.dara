/**
  * @description Disables the INSTANCE token of a user.
  *     Business logic:
  *     1. Retrieves user_id from identity (caller_type=user is enforced).
  *     2. Constructs an AuthContext and delegates permission verification to UserTokenAuthorizedService.
  *     3. Calls disable_token (ACTIVE → INACTIVE).
  *     4. Returns disabled=True.
  *     Idempotence: If no ACTIVE token exists, deactivate_all affects 0 rows and does not return an error.
  * @param request  the request parameters of DisableToken  DisableTokenRequest
  * @return DisableTokenResponse
 */
async function disableToken(request: DisableTokenRequest): DisableTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'DisableToken', 'POST', '/openapi/disableToken', 'json', true, 'form', request);
}

model EnableTokenRequest {
  tenantId?: string(name='tenantId', description='The ID of the effective tenant.', example='10000', position='Query'),
  wnUserId?: string(name='wnUserId', description='The ID of the target user (WINNEXO platform user ID). If this parameter is left empty, the operation is performed on the caller. Administrators can specify another user\\\\"s ID to perform the operation on behalf of that user.', example='1', position='Body'),
}

model EnableTokenResponseBody = {
  code?: string(name='code', description='The status code.', example='200'),
  message?: string(name='message', description='The description of the status code.', example='ok'),
  requestId?: string(name='requestId', description='The request ID.', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  token?: string(name='token', description='The temporary access credential for the data catalog.', example='example_token_value'),
  tokenMasked?: string(name='tokenMasked', description='The masked token value.', example='string_value'),
}

model EnableTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: EnableTokenResponseBody(name='body'),
}

/**
  * @description Enables the INSTANCE token for a user (idempotent).
  *     Business logic:
  *     1. Retrieves user_id from identity (caller_type=user is required).
  *     2. Constructs an AuthContext and delegates permission verification to UserTokenAuthorizedService.
  *     3. Calls enable_token:
  *        - If an ACTIVE token exists, returns idempotently (only the masked value is returned, and the plaintext is not issued again).
  *        - If an INACTIVE token exists, reactivates it (returns the plaintext).
  *        - If no token exists, creates one (returns the plaintext).
  *     Security constraint: The token plaintext is returned only once when the token is first enabled. Subsequent idempotent calls do not return the plaintext.
  * @param request  the request parameters of EnableToken  EnableTokenRequest
  * @return EnableTokenResponse
 */
async function enableToken(request: EnableTokenRequest): EnableTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'EnableToken', 'POST', '/openapi/enableToken', 'json', true, 'form', request);
}

