  wnUserId?: string(name='wnUserId', description='目标用户 ID（WINNEXO 平台用户ID，空则操作自身，管理员可传入他人 ID 代操作）', example='1', position='Body'),
}

model GetTokenInfoResponseBody = {
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码（ERR.* / InvalidParameter.*）', example='200'),
  enabled?: boolean(name='enabled', description='Token 是否开启（存在 ACTIVE 状态的 Token）', example='true'),
  gmtCreate?: string(name='gmtCreate', description='Token 创建时间（ISO 8601）', example='string_value'),
  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  tokenMasked?: string(name='tokenMasked', description='脱敏后的 Token 值', example='string_value'),
}

model GetTokenInfoResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetTokenInfoResponseBody(name='body'),
}

/**
  * @description 查询用户的 INSTANCE Token 状态。
  *     业务逻辑：
  *     1. 从 identity 取 user_id（强制 caller_type=user）
  *     2. 构造 AuthContext，委托 UserTokenAuthorizedService 完成权限校验
  *     3. 查询 ACTIVE INSTANCE Token
  *     4. 存在 → 返回 enabled=True + 脱敏值 + 创建时间
  *     5. 不存在 → 返回 enabled=False
  * @param request  the request parameters of GetTokenInfo  GetTokenInfoRequest
  * @return GetTokenInfoResponse
 */
async function getTokenInfo(request: GetTokenInfoRequest): GetTokenInfoResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetTokenInfo', 'POST', '/openapi/getTokenInfo', 'json', true, 'form', request);
}

