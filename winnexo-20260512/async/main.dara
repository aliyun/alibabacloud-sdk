  * @return ListVisibleKnowledgeBaseContentsResponse
 */
async function listVisibleKnowledgeBaseContents(request: ListVisibleKnowledgeBaseContentsRequest): ListVisibleKnowledgeBaseContentsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ListVisibleKnowledgeBaseContents', 'POST', '/openapi/listVisibleKnowledgeBaseContents', 'json', true, 'form', request);
}

