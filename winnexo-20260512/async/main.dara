/**
  * @description OpenAPI 重置用户密码。
  *     业务编排：
  *     1. 调用 UserManagementService.reset_member_password 传入 password_encrypted（必填）
  *        → service 内部完成 RSA 解密 + 复杂度校验 + bcrypt hash + 写入
  *     2. 返回重置结果
  *     错误码：
  *     - ERR.User.NotFound: 用户不存在
  *     - ERR.User.NotInTenant: 用户不在当前租户下
  *     - ERR.User.WinnexoPasswordRequired: 用户无密码凭证（非 WINNEXO 类型）
  * @param request  the request parameters of ResetPassword  ResetPasswordRequest
  * @return ResetPasswordResponse
 */
async function resetPassword(request: ResetPasswordRequest): ResetPasswordResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ResetPassword', 'POST', '/openapi/resetPassword', 'json', true, 'form', request);
}

model ResetTokenRequest {
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='10000', position='Query'),
  wnUserId?: string(name='wnUserId', description='目标用户 ID（WINNEXO 平台用户ID，空则操作自身，管理员可传入他人 ID 代操作）', example='1', position='Body'),
}

model ResetTokenResponseBody = {
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码（ERR.* / InvalidParameter.*）', example='200'),
  message?: string(name='message', description='错误描述，成功时为空', example='ok'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  token?: string(name='token', description='新 Token 明文（仅本次返回，请妥善保管）', example='example_token_value'),
  tokenMasked?: string(name='tokenMasked', description='脱敏后的新 Token 值', example='string_value'),
}

model ResetTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ResetTokenResponseBody(name='body'),
}

/**
  * @description 重置用户的 INSTANCE Token。
  *     业务逻辑：
  *     1. 从 identity 取 user_id（强制 caller_type=user）
  *     2. 构造 AuthContext，委托 UserTokenAuthorizedService 完成权限校验
  *     3. 调用 reset_token：
  *        - 旧 ACTIVE Token → RESET（永久失效）
  *        - 生成新 ACTIVE Token
  *     4. 返回新 Token 明文 + 脱敏值
  *     注意：重置后旧 Token 永久失效且不可恢复。新 Token 明文仅在本次响应中返回。
  * @param request  the request parameters of ResetToken  ResetTokenRequest
  * @return ResetTokenResponse
 */
async function resetToken(request: ResetTokenRequest): ResetTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ResetToken', 'POST', '/openapi/resetToken', 'json', true, 'form', request);
}

