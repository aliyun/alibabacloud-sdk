  directoryId?: string(name='directoryId', description='The business ID of the enterprise knowledge base directory for the current tenant, which is not the internal primary key. When digital employee associations or version summary configurations are included, the target must be the root directory of a standard enterprise knowledge base.', example='kb-example', position='Body'),
  name?: string(name='name', description='The new directory name. It can be up to 256 characters in length. If this parameter is omitted or set to null, the original value is retained.', example='Product knowledge base', position='Body'),
