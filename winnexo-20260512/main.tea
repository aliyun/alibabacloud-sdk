  if (!Util.isUnset(request.directoryId)) {
    body['directoryId'] = request.directoryId;
  }
  if (!Util.isUnset(request.itemIdsShrink)) {
    body['itemIds'] = request.itemIdsShrink;
  }
  if (!Util.isUnset(request.mode)) {
    body['mode'] = request.mode;
