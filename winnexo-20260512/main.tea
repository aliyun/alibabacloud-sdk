import Util;
import XML;
import Credential;
import FileForm;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = '';
  
  checkConfig(config);
  @endpoint = getEndpoint('winnexo', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CheckHealthRequest {
  tenantId?: string(name='tenantId', description='租户ID，公共参数；winnexo-cli 通过 --tenant-id 显式传入', example='10000'),
}

model CheckHealthResponseBody = {
  authSource?: string(name='authSource', description='认证来源: bearer / aliyun_gateway', example='aliyun_gateway'),
  callerType?: string(name='callerType', example='aliyun_main'),
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码（ERR.* / InvalidParameter.*）', example='200'),
  digitalEmployeeName?: string(name='digitalEmployeeName', description='当前请求生效的数字员工名（运营对象）；未传且租户下无数字员工时为空', example='string_value'),
  message?: string(name='message', description='错误描述，成功时为空'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  tenantId?: long(name='tenantId', description='生效租户ID', example='21577'),
  userId?: long(name='userId', description='平台用户ID', example='10001'),
}

model CheckHealthResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CheckHealthResponseBody(name='body'),
}

/**
 * @summary 服务健康检查
 *
 * @param request CheckHealthRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CheckHealthResponse
 */
async function checkHealthWithOptions(request: CheckHealthRequest, headers: map[string]string, runtime: Util.RuntimeOptions): CheckHealthResponse {
  Util.validateModel(request);
  var query : map[string]any = {};
  if (!Util.isUnset(request.tenantId)) {
    query['tenantId'] = request.tenantId;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'CheckHealth',
    version = '2026-05-12',
    protocol = 'HTTPS',
    pathname = `/openapi/checkHealth`,
    method = 'GET',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 服务健康检查
 *
 * @param request CheckHealthRequest
 * @return CheckHealthResponse
 */
async function checkHealth(request: CheckHealthRequest): CheckHealthResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return checkHealthWithOptions(request, headers, runtime);
}

model CreateConversationRequest {
  metadata?: string(name='metadata', description='会话元数据，可含 model 等透传字段（model 需为合法抽象模型名，否则回退默认）', example='string_value'),
  objectId?: string(name='objectId', description='关联业务对象ID', example='exampleObjectId'),
  operatingObjectName?: [ any ](name='operatingObjectName', description='operatingObjectName', example='string_value'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='10000'),
}

model CreateConversationShrinkRequest {
  metadata?: string(name='metadata', description='会话元数据，可含 model 等透传字段（model 需为合法抽象模型名，否则回退默认）', example='string_value'),
  objectId?: string(name='objectId', description='关联业务对象ID', example='exampleObjectId'),
  operatingObjectNameShrink?: string(name='operatingObjectName', description='operatingObjectName', example='string_value'),
  tenantId?: string(name='tenantId', description='租户ID，公共参数，缺省时使用调用方默认租户', example='10000'),
}

model CreateConversationResponseBody = {
  code?: string(name='code', description='业务状态码：成功为 200，失败为后端错误码（ERR.* / InvalidParameter.*）', example='200'),
  conversationId?: string(name='conversationId', description='新建会话ID', example='exampleConversationId'),
  createdAt?: string(name='createdAt', description='会话创建时间戳（秒）', example='1'),
  message?: string(name='message', description='错误描述，成功时为空'),
  metadata?: map[string]any(name='metadata'),
  requestId?: string(name='requestId', description='请求追踪 ID', example='019FF406-1B10-0065-A97D-2D1920C2A03D'),
  title?: string(name='title', description='会话标题（已按调用方语言国际化）', example='示例标题'),
}

model CreateConversationResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateConversationResponseBody(name='body'),
}

/**
 * @summary 创建会话
 *
 * @param tmpReq CreateConversationRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateConversationResponse
 */
async function createConversationWithOptions(tmpReq: CreateConversationRequest, headers: map[string]string, runtime: Util.RuntimeOptions): CreateConversationResponse {
  Util.validateModel(tmpReq);
  var request = new CreateConversationShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!Util.isUnset(tmpReq.operatingObjectName)) {
    request.operatingObjectNameShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.operatingObjectName, 'operatingObjectName', 'json');
  }
  var query : map[string]any = {};
  if (!Util.isUnset(request.tenantId)) {
    query['tenantId'] = request.tenantId;
  }

  var body : map[string]any = {};
  if (!Util.isUnset(request.metadata)) {
    body['metadata'] = request.metadata;
  }
  if (!Util.isUnset(request.objectId)) {
    body['objectId'] = request.objectId;
  }
  if (!Util.isUnset(request.operatingObjectNameShrink)) {
    body['operatingObjectName'] = request.operatingObjectNameShrink;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CreateConversation',
    version = '2026-05-12',
    protocol = 'HTTPS',
    pathname = `/openapi/createConversation`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 创建会话
 *
 * @param request CreateConversationRequest
 * @return CreateConversationResponse
 */
async function createConversation(request: CreateConversationRequest): CreateConversationResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return createConversationWithOptions(request, headers, runtime);
}

