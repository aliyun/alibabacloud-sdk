    version = '2026-05-12',
    protocol = 'HTTPS',
    pathname = `/openapi/resetPassword`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

