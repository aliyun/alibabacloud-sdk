  }
  if (!Util.isUnset(tmpReq.userGroupIds)) {
    request.userGroupIdsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.userGroupIds, 'userGroupIds', 'json');
  }
  var query : map[string]any = {};
  if (!Util.isUnset(request.tenantId)) {
