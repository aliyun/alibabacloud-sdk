model CreateQuotaAlarmRequest {
  alarmName: string(name='AlarmName', description='The name of the quota alert rule.

This parameter is required.', example='q_hvnoqv alarm', position='Body'),
  originalContext?: string(name='OriginalContext', description='The original context information.', example='{}', position='Body'),
  productCode: string(name='ProductCode', description='The abbreviation of the cloud service.

> For more information about how to obtain the abbreviation of a cloud service, see ProductCode in [ListProductQuotas](https://help.aliyun.com/document_detail/440554.html).

This parameter is required.', example='config', position='Body'),
  quotaActionCode: string(name='QuotaActionCode', description='The quota ID.

> For more information about how to obtain the quota ID of a cloud service, see QuotaActionCode in [ListProductQuotas](https://help.aliyun.com/document_detail/440554.html).

This parameter is required.', example='q_hvnoqv', position='Body'),
  quotaDimensions?: [ 
    {
      key?: string(name='Key', description='The key of the quota dimension.

> You must specify both Dimensions.N.Key and Dimensions.N.Value. The value range of N depends on the number of dimensions supported by the cloud service. You can call the [ListProductQuotaDimensions](https://help.aliyun.com/document_detail/440553.html) operation to query the supported quota dimensions. The length of the returned array is the maximum value of N.', example='regionId'),
      value?: string(name='Value', description='The value of the quota dimension.

 > You must specify both Dimensions.N.Key and Dimensions.N.Value. The value range of N depends on the number of dimensions supported by the cloud service. You can call the [ListProductQuotaDimensions](https://help.aliyun.com/document_detail/440553.html) operation to query the supported quota dimensions. The length of the returned array is the maximum value of N.', example='cn-hangzhou'),
    }
  ](name='QuotaDimensions', description='The quota dimensions.
The dimensions are properties of a quota item. A quota item is uniquely identified by Dimensions and QuotaActionCode.
> Some dimensions are required for specific cloud services. You can call the [ListProductQuotaDimensions](https://help.aliyun.com/document_detail/440553.html) operation to query the supported quota dimensions of a cloud service. The Requisite response parameter indicates whether a dimension is required.', position='Body'),
  threshold?: float(name='Threshold', description='The numeric value of the quota alert threshold. Valid values:

- If ThresholdType is set to used, you receive an alert notification when the used quota is greater than or equal to the specified value. The quota alert threshold must be greater than the used quota.

- If ThresholdType is set to usable, you receive an alert notification when the available quota is less than or equal to the specified value. The quota alert threshold must be less than the available quota.

> You must specify either this parameter or ThresholdPercent.', example='150', minimum=1, position='Body'),
  thresholdPercent?: float(name='ThresholdPercent', description='The percentage of the quota alert threshold. Valid values:

- If ThresholdType is set to used, you receive an alert notification when the used quota is greater than or equal to the specified percentage. Valid values: (50%, 100%].

- If ThresholdType is set to usable, you receive an alert notification when the available quota is less than or equal to the specified percentage. Valid values: (0%, 50%].

> You must specify either this parameter or Threshold.', example='50', minimum=50, maximum=100, position='Body'),
  thresholdType?: string(name='ThresholdType', description='The quota alert type. Valid values:

- used: alerts on the used quota. This is the default value.
- usable: alerts on the remaining available quota.', example='used', position='Body'),
  webHook?: string(name='WebHook', description='The public URL to which Quota Center sends alert notifications by using HTTP POST requests.', example='https://alert.aliyun.com/callback', position='Body'),
}

