  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CommercializeFetch', 'POST', '/{workspaceId}/spi/path/{cjfCode}/api/support/{zjfCode}/firefly/commercializeFetch', 'json', false, 'json', request);
}

