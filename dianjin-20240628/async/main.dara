model EndToEndRealTimeDialogRequest {
  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='llm-xxxxx', position='Path'),
  asrModelId?: string(name='asrModelId', description='The ID of the speech recognition model. The default value is nls-base. Supported models include paraformer-realtime-v2 and paraformer-realtime-8k-v2.', example='nls-base', position='Query'),
  inputFormat?: string(name='inputFormat', description='The input audio format. Supported formats are pcm, wav, and mp3.', example='pcm', position='Query'),
  outputFormat?: string(name='outputFormat', description='The output audio format.', example='wav', position='Query'),
  pitchRate?: int32(name='pitchRate', description='The pitch rate.
● If \\\\`ttsModelId\\\\` is \\\\`nls-base\\\\`:
The value ranges from -500 to 500. The default is 0.
● If \\\\`ttsModelId\\\\` is \\\\`cosyvoice-v2\\\\`: Specifies the pitch of the synthesized audio. The value ranges from 0.5 to 2.', example='0', position='Query'),
  sampleRate?: string(name='sampleRate', description='The sample rate.', example='SAMPLE_RATE_16K', position='Query'),
  speechRate?: int32(name='speechRate', description='The speech rate.
● If \\\\`ttsModelId\\\\` is \\\\`nls-base\\\\`: The value ranges from -500 to 500. The default is 0.
● If \\\\`ttsModelId\\\\` is \\\\`cosyvoice-v2\\\\`:
Specifies the speech rate of the synthesized audio. The value ranges from 0.5 to 2.
○ 0.5: Half the default speed.
○ 1: The default speed. The default speed is the model\\\\"s standard output speed and may vary slightly by speaker. It is about four characters per second.
○ 2: Twice the default speed.', example='0', position='Query'),
  ttsModelId?: string(name='ttsModelId', description='The ID of the speech synthesis model. The default value is nls-base. The cosyvoice-v2 model is supported.', example='nls-base', position='Query'),
  voiceCode?: string(name='voiceCode', description='The voice parameter. This is available only for models that support word-level or sentence-level timestamps.', example='longxiaochun_v2', position='Query'),
  volume?: int32(name='volume', description='The volume. The value ranges from 0 to 100. This parameter is optional. The default value is 50.', example='50', position='Query'),
}

