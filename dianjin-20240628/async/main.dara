model CreateLibraryRequest {
  workspaceId: string(name='workspaceId', description='Workspace ID

This parameter is required.', example='llm-ik******RVYCKzt', position='Path'),
  description: string(name='description', description='Document library description

This parameter is required.', example='描述文档库的具体作用', position='Body'),
  indexSetting?: {
    chunkStrategy?: {
      docTreeSplit?: boolean(name='docTreeSplit', description='Layout-based chunking', example='true'),
      docTreeSplitSize?: int32(name='docTreeSplitSize', description='Layout-based chunk size', example='300'),
      enhanceGraph?: boolean(name='enhanceGraph', description='Parse images in documents', example='true'),
      enhanceTable?: boolean(name='enhanceTable', description='Parse tables in documents', example='true'),
      overlap?: int32(name='overlap', description='Chunk overlap length', example='20'),
      sentenceSplit?: boolean(name='sentenceSplit', description='Split by sentence', example='true'),
      sentenceSplitSize?: int32(name='sentenceSplitSize', description='Sentence-based chunk size', example='300'),
      size?: int32(name='size', description='Chunk size', example='300'),
      split?: boolean(name='split', description='Enable chunking', example='true'),
    }(name='chunkStrategy', description='Chunking strategy'),
    modelConfig?: {
      temperature?: double(name='temperature', description='Control the randomness and diversity of model responses. Higher values flatten the probability distribution over candidate tokens, increasing diversity. Lower values sharpen the distribution, increasing determinism.

Valid range: [0, 2). Avoid 0.', example='0.8'),
      topP?: double(name='topP', description='Probability threshold for nucleus sampling. For example, with a value of 0.8, only the smallest set of most likely tokens whose cumulative probability is at least 0.8 is used. Higher values increase randomness. Lower values increase determinism.', example='0.8'),
    }(name='modelConfig', description='Model configuration'),
    promptRoleStyle?: string(name='promptRoleStyle', description='Prompt role style. Specify a role and tone to guide response quality. Examples: Document analysis expert, friendly customer service agent, professional financial analyst.', example='你是一位信息处理专家，耐心、友好、逻辑清晰。'),
    queryEnhancer?: {
      enableFollowUp?: boolean(name='enableFollowUp', description='Rewrite queries using history', example='true'),
      enableMultiQuery?: boolean(name='enableMultiQuery', description='Use Large Language Models (LLMs) to decompose queries', example='true'),
      enableOpenQa?: boolean(name='enableOpenQa', description='Use LLMs to answer queries', example='true'),
      enableQueryRewrite?: boolean(name='enableQueryRewrite', description='Enable query rewriting', example='true'),
      enableSession?: boolean(name='enableSession', description='Enable multi-turn conversations', example='true'),
      localKnowledgeId?: string(name='localKnowledgeId', description='Document library ID for knowledge rewriting', example='xxxx'),
      withDocumentReference?: boolean(name='withDocumentReference', description='Include document references in responses', example='true'),
    }(name='queryEnhancer', description='Query enhancement configuration'),
    recallStrategy?: {
      documentRankType?: string(name='documentRankType', description='Merge and sort policy', example='model'),
      limit?: int32(name='limit', description='Number of results from two-way merge and summarization', example='20'),
    }(name='recallStrategy', description='Retrieval strategy'),
    textIndexSetting?: {
      category?: string(name='category', description='Text index type. Only ElasticSearch is supported.', example='ElasticSearch'),
      enable?: boolean(name='enable', description='Enable text indexing', example='true'),
      indexAnalyzer?: string(name='indexAnalyzer', description='Text index analyzer: Standard, IkMaxWord, or IkSmart', example='Standard'),
      rankThreshold?: double(name='rankThreshold', description='Text index ranking threshold', example='0.5'),
      searchAnalyzer?: string(name='searchAnalyzer', description='Text index search analyzer: Standard, IkMaxWord, or IkSmart', example='Standard'),
      topK?: int32(name='topK', description='Number of final text index results', example='50'),
    }(name='textIndexSetting', description='Text index configuration'),
    vectorIndexSetting?: {
      category?: string(name='category', description='Vector index source. Only ADB is supported.', example='ADB'),
      embeddingType?: string(name='embeddingType', description='Text embedding type for vector indexing', example='DashScope'),
      enable?: boolean(name='enable', description='Enable vector indexing', example='true'),
      rankThreshold?: double(name='rankThreshold', description='Vector index ranking threshold', example='0.5'),
      topK?: int32(name='topK', description='Number of final vector index results', example='50'),
    }(name='vectorIndexSetting', description='Vector index settings'),
  }(name='indexSetting', description='Index settings for the document library', position='Body'),
  libraryName: string(name='libraryName', description='Document library name

This parameter is required.', example='金融知识文档库', position='Body'),
}

