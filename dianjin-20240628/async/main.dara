  channelId: string(name='channelId', description='This parameter is required.', position='Body'),
  data: string(name='data', description='This parameter is required.', position='Body'),
  encryptType?: string(name='encryptType', example='AES', position='Body'),
  env?: string(name='env', position='Body'),
  productId: string(name='productId', description='This parameter is required.', position='Body'),
  requestId: string(name='requestId', description='This parameter is required.', position='Body'),
