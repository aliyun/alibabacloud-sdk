model UpdatePrometheusInstanceRequest {
  prometheusInstanceId: string(name='prometheusInstanceId', description='The Prometheus instance ID.

This parameter is required.', example='rw-xxxxxxx', position='Path'),
  archiveDuration?: integer(name='archiveDuration', description='The number of days for automatic archiving after storage expires. A value of 0 indicates no archiving. Valid values for archive days:
V1: 1 to 365 days. Only supported for billing by metric write volume.
V2: 1 to 3650 days (3650 indicates permanent retention).', example='365', position='Body'),
  authFreeReadPolicy?: string(name='authFreeReadPolicy', description='The authentication-free read policy. IP CIDR blocks and VPC IDs are supported.', example='{
  "SourceIp": [
    "192.168.1.0/24",
    "172.168.2.22"
  ],
  "SourceVpc": [
    "vpc-xx1",
    "vpc-xx2"
  ]
}', position='Body'),
  authFreeWritePolicy?: string(name='authFreeWritePolicy', description='The authentication-free read policy. IP CIDR blocks and VPC IDs are supported.', example='{
  "SourceIp": [
    "192.168.1.0/24",
    "172.168.2.22"
  ],
  "SourceVpc": [
    "vpc-xx1",
    "vpc-xx2"
  ]
}', position='Body'),
  enableAuthFreeRead?: boolean(name='enableAuthFreeRead', description='Specifies whether to enable authentication-free read.', example='true', position='Body'),
  enableAuthFreeWrite?: boolean(name='enableAuthFreeWrite', description='Specifies whether to enable authentication-free write.', example='true', position='Body'),
  enableAuthToken?: boolean(name='enableAuthToken', description='Specifies whether to enable access token authentication.', example='true', position='Body'),
  paymentType?: string(name='paymentType', description='The billing method. This can be modified only once during the instance lifetime:
POSTPAY: pay-as-you-go by metric reporting volume.
POSTPAY_GB: pay-as-you-go by metric write volume.', example='POSTPAY_GB', position='Body'),
  prometheusInstanceName?: string(name='prometheusInstanceName', description='The instance name.', example='test-prom-name', position='Body'),
  status?: string(name='status', description='Instance storage database status of the instance. Only RUNNING is supported. If left empty, instance storage database status is not changed.', example='RUNNING', position='Body'),
  storageDuration?: integer(name='storageDuration', description='The storage duration (days):
By write volume: 90, 180.
By metric reporting volume: 15, 30, 60, 90, 180.', example='90', position='Body'),
  storeConfig?: PrometheusInstanceStoreConfig(name='storeConfig', description='The Prometheus storage configuration.', position='Body'),
  workspace?: string(name='workspace', description='The workspace to which the instance belongs.', example='default-cms-1500199863951574-cn-shanghai', position='Body'),
}

