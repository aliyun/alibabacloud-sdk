        applications?: [ string ](name='applications', description='The application list.'),
        expression?: string(name='expression', description='The filter expression.', example='attributes["http.route"] != "/health"'),
        fields?: [ string ](name='fields', description='The field list.'),
        rules?: [ 
          {
