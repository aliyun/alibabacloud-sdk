model NotifyPolicyConfig {
  description?: string(name='description', description='The description of the policy, which helps identify its purpose.', example='生产环境告警通知策略'),
  name?: string(name='name', description='The policy name. We recommend that you specify this parameter for the Create operation. If a policy with the same name already exists in the workspace, ConflictName (409) is returned.', example='生产环境告警通知策略'),
  notifyStrategy?: NotifyStrategyConfig(name='notifyStrategy', description='The notification strategy sub-entity, which includes noise reduction, notification routing, channels, and custom templates. Required for the Create operation.', example='{}'),
  responsePlan?: ResponsePlanConfig(name='responsePlan', description='The response plan sub-entity, which includes upgrade, repeated notification, automatic recovery, and action integration. Optional.', example='{}'),
  subscription?: SubscriptionConfig(name='subscription', description='The subscription sub-entity, which includes event filtering, cross-workspace routing, and legacy product event subscription switches. Optional. If not specified, all events in the current workspace are subscribed to.', example='{}'),
  uuid?: string(name='uuid', description='The unique identifier of the policy. Required for the Update operation. Omitted for the Create operation because it is generated by the backend.', example='04779a183add4f2ca06ab440f16cc580'),
  version?: int32(name='version', description='Required for the Update operation. The write succeeds only when this value matches the backend record. If the values do not match, OptimisticLockFailed is returned.', example='1'),
}

model NotifyPolicySummary {
  createTime?: string(name='createTime', description='The creation time, represented as a UNIX millisecond timestamp string.', example='1700000000000'),
  description?: string(name='description', description='The description of the notification policy.', example='A notification policy for testing'),
  enabled?: boolean(name='enabled', description='Indicates whether the notification policy is enabled.', example='true'),
  name?: string(name='name', description='The Policy Name of the notification policy.', example='Sample notification policy'),
  notifyStrategy?: NotifyStrategyDetail(name='notifyStrategy', description='The configuration details of the notification policy.'),
  updateTime?: string(name='updateTime', description='The update time, represented as a UNIX millisecond timestamp string.', example='1700000000000'),
  userId?: string(name='userId', description='The Alibaba Cloud account UID.', example='1234567890'),
  uuid?: string(name='uuid', description='The unique identifier of the notification policy.', example='ns-uuid-001'),
  version?: int32(name='version', description='The version number of the notification policy.', example='1'),
  workspace?: string(name='workspace', description='The workspace identifier.', example='default'),
}

model NotifyRouteForSubscription {
  channels?: [ 
    {
      channelType?: string(name='channelType', description='The channel type.', example='default'),
      enabledSubChannels?: [ string ](name='enabledSubChannels', description='The list of enabled sub-channels.'),
      receivers?: [ string ](name='receivers', description='The list of receivers.'),
    }
  ](name='channels', description='The list of notification channels.'),
  effectTimeRange?: {
    dayInWeek?: [ int32 ](name='dayInWeek', description='The effective days of the week (0 = Sunday, 1 = Monday, ..., 6 = Saturday).'),
    endTimeInMinute?: int32(name='endTimeInMinute', description='The end time of the day, in minutes from 0:00.', example='1'),
    startTimeInMinute?: int32(name='startTimeInMinute', description='The start time of the day, in minutes from 0:00.', example='1'),
    timeZone?: string(name='timeZone', description='The time zone.', example='1700000000'),
  }(name='effectTimeRange', description='The effective period configuration.'),
}

model NotifyStrategyConfig {
  customTemplateEntries?: [ 
    {
      templateUuid?: string(name='templateUuid', description='The UUID of the notification template.', example='template-uuid-xxx'),
    }
  ](name='customTemplateEntries', description='The list of custom notification templates.', example='[]'),
  description?: string(name='description', description='The description of the notification policy.', example='生产环境告警通知策略'),
  groupingSetting: {
    groupingKeys?: [ string ](name='groupingKeys', description='The event fields by which events are grouped. Events in the same group are merged into a single notification. An empty array indicates no grouping.', example='["alertname"]'),
    periodMin?: int32(name='periodMin', description='This parameter does not take effect for this operation. You do not need to set this parameter.', example='0'),
    silenceSec?: int32(name='silenceSec', description='This parameter does not take effect for this operation. You do not need to set this parameter.', example='0'),
    times?: int32(name='times', description='This parameter does not take effect for this operation. You do not need to set this parameter.', example='0'),
  }(name='groupingSetting', description='The noise reduction settings.

This parameter is required.'),
  ignoreRestoredNotification?: boolean(name='ignoreRestoredNotification', description='Specifies whether to ignore notifications for recovery events. A value of true indicates that recovery notifications are not sent.', example='true'),
  routes: [ 
    {
      channels?: [ 
        {
          channelType: string(name='channelType', description='The channel type. Valid values: DING, WEIXIN, FEISHU, SLACK, TEAMS, WEBHOOK, CONTACT, GROUP, DUTY, and DING_COOL_APP. Lowercase values are not supported. For email, text message, or phone call notifications, use CONTACT with enabledSubChannels.

This parameter is required.', example='WEBHOOK'),
          enabledSubChannels?: [ string ](name='enabledSubChannels', description='Required only for CONTACT, GROUP, or DUTY. The sub-channel types in uppercase. Valid values: EMAIL, SMS, VOICE, DING, WEIXIN, FEISHU, and WEBHOOK.', example='["EMAIL","SMS"]'),
          receivers: [ string ](name='receivers', description='The list of receiver identifiers. At least one receiver is required. Specify a webhook UUID for WEBHOOK, a robot UUID for chatbots, or a contact ID for CONTACT.

This parameter is required.', example='["webhook-uuid-xxx"]'),
        }
      ](name='channels', description='The list of notification channels.', example='[]'),
      digitalEmployeeName?: string(name='digitalEmployeeName', description='The digital employee name. Required when enableRca is set to true.', example='数字员工名'),
      effectTimeRange?: {
        dayInWeek?: [ int32 ](name='dayInWeek', description='The effective days. Valid values: 0 to 6 (0 = Sunday, 6 = Saturday). The value 7 is not supported.', example='[0,1,2,3,4,5,6]'),
        endTimeInMinute?: int32(name='endTimeInMinute', description='The end time of the day in minutes. Valid values: 0 to 1439.', example='1439'),
        startTimeInMinute?: int32(name='startTimeInMinute', description='The start time of the day in minutes. Valid values: 0 to 1438.', example='0'),
        timeZone?: string(name='timeZone', description='The IANA time zone identifier.', example='Asia/Shanghai'),
      }(name='effectTimeRange', description='The effective time range.'),
      enableRca?: boolean(name='enableRca', description='Specifies whether to enable Root Cause Analysis (RCA).', example='false'),
      filterSetting?: FilterSetting(name='filterSetting', description='The route-level event filter conditions.', example='{}'),
    }
  ](name='routes', description='The list of notification channel routing settings.

This parameter is required.', example='[]'),
}

model NotifyStrategyDetail {
  customTemplateEntries?: [ 
    {
      templateUuid?: string(name='templateUuid', description='The UUID of the notification template.', example='template-uuid-xxx'),
    }
  ](name='customTemplateEntries', description='The list of custom notification templates.', example='[]'),
  description?: string(name='description', description='The description of the notification policy.', example='生产环境告警通知策略'),
  groupingSetting?: {
    groupingKeys?: [ string ](name='groupingKeys', description='The event fields by which events are grouped for noise reduction. Events in the same group are merged into a single notification. An empty array indicates no grouping.', example='["alertname"]'),
    periodMin?: int32(name='periodMin', description='The check period in minutes.', example='0'),
    silenceSec?: int32(name='silenceSec', description='The silence duration in seconds.', example='0'),
    times?: int32(name='times', description='The number of trigger times.', example='0'),
  }(name='groupingSetting', description='The grouping and merging settings.'),
  ignoreRestoredNotification?: boolean(name='ignoreRestoredNotification', description='Specifies whether to ignore notifications for recovery events. A value of true indicates that recovery notifications are not sent.', example='true'),
  routes?: [ 
    {
      channels?: [ 
        {
          channelType?: string(name='channelType', description='The channel type. Valid values: DING, WEIXIN, FEISHU, SLACK, TEAMS, WEBHOOK, CONTACT, GROUP, DUTY, and DING_COOL_APP.', example='WEBHOOK'),
          enabledSubChannels?: [ string ](name='enabledSubChannels', description='The enabled sub-channels. Valid values: EMAIL, SMS, VOICE, DING, WEIXIN, FEISHU, and WEBHOOK.', example='["EMAIL","SMS"]'),
          receivers?: [ string ](name='receivers', description='The list of receiver identifiers.', example='["webhook-uuid-xxx"]'),
        }
      ](name='channels', description='The list of notification channels.', example='[]'),
      digitalEmployeeName?: string(name='digitalEmployeeName', description='The digital employee name. This parameter is required when enableRca is set to true.', example='数字员工名'),
      effectTimeRange?: {
        dayInWeek?: [ int32 ](name='dayInWeek', description='The effective days of the week. Valid values: 0 to 6 (0 = Sunday, 6 = Saturday). The value 7 is not supported.', example='[0,1,2,3,4,5,6]'),
        endTimeInMinute?: int32(name='endTimeInMinute', description='The end time of the day in minutes. Valid values: 0 to 1439.', example='1439'),
        startTimeInMinute?: int32(name='startTimeInMinute', description='The start time of the day in minutes. Valid values: 0 to 1438.', example='0'),
        timeZone?: string(name='timeZone', description='The IANA time zone identifier.', example='Asia/Shanghai'),
      }(name='effectTimeRange', description='The effective time range.'),
      enableRca?: boolean(name='enableRca', description='Specifies whether to enable root cause analysis (RCA).', example='false'),
      filterSetting?: FilterSetting(name='filterSetting', description='The route-level event filter conditions.', example='{}'),
    }
  ](name='routes', description='The list of notification channel routing settings.', example='[]'),
}

model NotifyStrategyForModify {
  autoRecoverSeconds?: int32(name='autoRecoverSeconds', description='The automatic recovery time in seconds.', example='300'),
  customTemplateEntries?: [ 
    {
      targetType: string(name='targetType', description='The notification type.

This parameter is required.', example='SMS'),
      templateUuid: string(name='templateUuid', description='The template UUID.

This parameter is required.', example='123123-12-31-231-23-12-3123'),
    }
  ](name='customTemplateEntries', description='The notification channel templates.'),
  description?: string(name='description', description='The description.', example='test'),
  enableIncidentManagement?: boolean(name='enableIncidentManagement', description='Indicates whether incident management is enabled.', example='true'),
  escalationId?: [ string ](name='escalationId', description='The list of escalation policy IDs.'),
  filterSetting?: FilterSetting(name='filterSetting', description='The filter settings.'),
  groupingSetting: {
    groupingKeys?: [ string ](name='groupingKeys', description='The grouping keys.'),
    periodMin?: int32(name='periodMin', description='The check period in minutes.', example='5'),
    silenceSec?: int32(name='silenceSec', description='The silence duration in seconds.', example='300'),
    times?: int32(name='times', description='The number of times the alert is triggered.', example='1'),
  }(name='groupingSetting', description='The grouping settings.

This parameter is required.'),
  ignoreRestoredNotification?: boolean(name='ignoreRestoredNotification', description='Indicates whether to send a notification when the alert is restored.', example='false'),
  notifyStrategyName: string(name='notifyStrategyName', description='The name of the notification policy.

This parameter is required.', example='Policy Name'),
  pushingSetting?: {
    alertActionIds?: [ string ](name='alertActionIds', description='The list of alert action IDs.'),
    restoreActionIds?: [ string ](name='restoreActionIds', description='The list of recovery action IDs.'),
    templateUuid?: string(name='templateUuid', description='The message template UUID.', example='Template UUID'),
  }(name='pushingSetting', description='The push settings.'),
  repeatNotifySetting?: {
    endIncidentState?: string(name='endIncidentState', description='The end incident state.', example='"Resolved"'),
    repeatInterval?: int32(name='repeatInterval', description='The time interval for repeat notifications.', example='5'),
  }(name='repeatNotifySetting', description='The repeat notification settings.'),
  routes: [ 
    {
      channels?: [ 
        {
          channelType: string(name='channelType', description='The channel type.

This parameter is required.', example='CONTACT'),
          enabledSubChannels?: [ string ](name='enabledSubChannels', description='The enabled notification types.'),
          receivers: [ string ](name='receivers', description='The channel receivers.

This parameter is required.'),
        }
      ](name='channels', description='The notification channels.'),
      digitalEmployeeName?: string(name='digitalEmployeeName', description='The name of the digital employee.', example='On-call Assistant'),
      effectTimeRange?: {
        dayInWeek?: [ int32 ](name='dayInWeek', description='The effective days (Monday to Sunday).'),
        endTimeInMinute?: int32(name='endTimeInMinute', description='The end time in minutes.', example='30', minimum=0, maximum=1439),
        startTimeInMinute?: int32(name='startTimeInMinute', description='The start time in minutes.', example='60', minimum=0, maximum=1438),
        timeZone?: string(name='timeZone', description='The time zone.', example='+08:00'),
      }(name='effectTimeRange', description='The effective time range.'),
      enableRca?: boolean(name='enableRca', description='Indicates whether root cause analysis is enabled.', example='true'),
      filterSetting?: FilterSetting(name='filterSetting', description='The route condition.'),
      severities?: [ string ](name='severities', description='The list of severity levels.'),
    }
  ](name='routes', description='The notification channel route settings.

This parameter is required.'),
  workspaceFilterSetting?: WorkspaceFilterSetting(name='workspaceFilterSetting', description='The workspace filter settings.'),
}

model NotifyStrategyForSNSModify {
  customTemplateEntries?: [ 
    {
      targetType?: string(name='targetType', description='**[Deprecated]** This parameter is deprecated and does not take effect. The actual purpose of the template is determined by the type field of the template object referenced by templateUuid.', example='DING'),
      templateUuid?: string(name='templateUuid', description='The UUID of the template.', example='adef12efca3f-8728-1928-eeaac12ef9ad92'),
    }
  ](name='customTemplateEntries', description='The notification channel templates.'),
  description?: string(name='description', description='The description.', example='test'),
  enableIncidentManagement?: boolean(name='enableIncidentManagement', description='Specifies whether to enable incident management.', example='true'),
  groupingSetting: {
    groupingKeys?: [ string ](name='groupingKeys', description='The grouping keys.'),
    periodMin?: int32(name='periodMin', description='The check period in minutes.', example='1'),
    silenceSec?: int32(name='silenceSec', description='The silence duration in seconds.', example='300'),
    times?: int32(name='times', description='The number of times the condition is triggered.', example='10'),
  }(name='groupingSetting', description='The grouping settings.

This parameter is required.'),
  ignoreRestoredNotification?: boolean(name='ignoreRestoredNotification', description='Specifies whether to send a notification when the alert is recovered.', example='true'),
  routes: [ 
    {
      channels?: [ 
        {
          channelType: string(name='channelType', description='The channel type.

This parameter is required.', example='DING'),
          enabledSubChannels?: [ string ](name='enabledSubChannels', description='The enabled notification types.', example='["EMAIL","SMS"]'),
          receivers: [ string ](name='receivers', description='The channel receivers.

This parameter is required.', example='["my-webhook-uuid"]'),
        }
      ](name='channels', description='The notification channels.'),
      digitalEmployeeName?: string(name='digitalEmployeeName', description='The digital employee name.'),
      effectTimeRange?: {
        dayInWeek?: [ int32 ](name='dayInWeek', description='The effective days of the week (Monday through Sunday).', example='[0,1,2,3,4,5,6]'),
        endTimeInMinute?: int32(name='endTimeInMinute', description='The end time in minutes.', example='1'),
        startTimeInMinute?: int32(name='startTimeInMinute', description='The start time in minutes.', example='59'),
        timeZone?: string(name='timeZone', description='The time zone.', example='Asia/Shanghai'),
      }(name='effectTimeRange', description='The effective time range.'),
      enableRca?: boolean(name='enableRca', description='Specifies whether to enable root cause analysis (RCA).'),
      filterSetting?: {
        conditions?: [ 
          {
            field?: string(name='field', description='The JSON path of the field, such as labels._cms_rule_name.', example='subject'),
            op?: string(name='op', description='The comparison operator.', example='EQ'),
            value?: string(name='value', description='The value.', example='Pod OOM'),
          }
        ](name='conditions', description='The subscription conditions.'),
        expression?: string(name='expression', description='If expression is not empty, it takes precedence and relation is ignored. If expression is empty or not specified, the system uses relation (AND or OR) to perform a simple AND/OR operation on all conditions. Condition numbers correspond to the indexes of the conditions array (starting from 1). Each condition evaluates whether a single event field matches by using field (the event field path, which supports dot-separated nesting such as resource.tags.pod), op (the operator, such as CONTAIN, EQ, or IN), and value (the match value).', example='(1 AND 2 )OR 3'),
        relation?: string(name='relation', description='The relationship between conditions. If an expression is configured, the expression takes higher precedence.', example='AND'),
      }(name='filterSetting', description='The route-level filter. This is different from the top-level subscription.filterSetting.'),
      severities?: [ string ](name='severities', description='**[Deprecated]** This parameter is deprecated and does not take effect. Route matching only checks filterSetting and effectTimeRange.'),
    }
  ](name='routes', description='The notification channel routing settings.

This parameter is required.'),
}

