  severity?: string(name='severity', description='The severity level.', example='CRITICAL'),
  times?: int32(name='times', description='The number of consecutive times the condition is triggered.', example='3'),
}

model CloudMonitoringCompositeEscalationEntry {
  comparisonOperator?: string(name='comparisonOperator', description='The comparison operator.', example='GT'),
  metricName?: string(name='metricName', description='The metric name.', example='cpuUsage'),
  period?: int32(name='period', description='The collection period, in seconds.', example='60'),
  preCondition?: string(name='preCondition', description='The precondition.', example='3 consecutive times'),
  statistics?: string(name='statistics', description='The statistical method.', example='Average'),
  threshold?: string(name='threshold', description='The threshold.', example='80'),
}

model CloudMonitoringExpressEscalation {
