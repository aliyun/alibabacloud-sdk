}

function close(): void {
  @handler.close();
}

model ActionIntegrationConfig {
  actions?: [ string ](name='actions', description='The list of action integration configurations. An action integration is an automated action that is executed after an alert rule is triggered, such as sending a notification or invoking a webhook. Each action integration is referenced by its action integration ID.'),
  enabled?: boolean(name='enabled', description='Indicates whether action integration is enabled.', example='false'),
}

model AddonMeta {
  alias?: string(name='alias', description='The alias of the component. This is the display name.', example='ECS 监控'),
  categories?: [ string ](name='categories', description='The categorization information of the component.'),
  dashboards?: [ 
    {
      description?: string(name='description', description='The description.', example='描述信息'),
      name?: string(name='name', description='The name of the diagram.', example='ECS 监控概览大盘'),
      url?: string(name='url', description='The URL of the diagram.', example='assets/dashboards/ecs.png'),
    }
  ](name='dashboards', description='A list of component diagrams.'),
  description?: string(name='description', description='The description.', example='The out-of-the-box and comprehensive ECS observe dashboards and alarm rules. Based on AliYun CloudMonitor agentless metrics, exporter agent metrics, host audit logs, host events and other data.'),
  environments?: [ 
    {
      commonSchemaRefs?: [ 
        {
          group?: string(name='group', description='The group name of the CommonSchema.', example='acs-ecs'),
          version?: string(name='version', description='The group version of the CommonSchema.', example='0.1.0'),
        }
      ](name='commonSchemaRefs', description='The list of attached CommonSchemas.'),
      dependencies?: {
        clusterTypes?: [ string ](name='clusterTypes', description='The supported cluster types.'),
        features?: map[string]boolean(name='features', description='The probe dependency description. This is the component name. In later versions, this field is replaced by the collectors field.'),
        services?: [ string ](name='services', description='The list of dependent services.'),
      }(name='dependencies', description='The dependency description.'),
      description?: string(name='description', description='The description of the environment type.', example='支持容器集群的工作覆盖监控'),
      enable?: boolean(name='enable', description='Indicates whether the environment type is enabled.', example='true/false'),
      label?: string(name='label', description='The display name of the environment type.', example='容器环境'),
      name?: string(name='name', description='The name of the environment type.', example='CS/ECS/Cloud/Client'),
      policies?: {
        alertDefaultStatus?: string(name='alertDefaultStatus', description='Indicates whether the alert rule is enabled by default after installation.', example='RUNNING'),
        bindDefaultPolicy?: boolean(name='bindDefaultPolicy', description='The default mode. This integration mode does not require attaching an entity.', example='true/false'),
        bindEntity?: {
          entityGroupMode?: boolean(name='entityGroupMode', description='Indicates whether group mode is used.', example='true/false'),
          entityType?: string(name='entityType', description='The entity type.', example='acs.ecs.instance'),
          singleEntityMode?: boolean(name='singleEntityMode', description='Indicates whether single-entity mode is used.', example='true/false'),
          vpcIdFieldKey?: string(name='vpcIdFieldKey', description='The field in the entity from which to fetch the VPC ID.', example='vpcId'),
        }(name='bindEntity', description='Information about the attached target entity.'),
        defaultInstall?: boolean(name='defaultInstall', description='Indicates whether the component is installed by default.', example='true/false'),
        enableServiceAccount?: boolean(name='enableServiceAccount', description='Indicates whether to enable internal authorization token allocation.', example='true/false'),
        metricCheckRule?: {
          promQL?: [ string ](name='promQL', description='The Prometheus Query Language (PromQL) for the check rule.'),
        }(name='metricCheckRule', description='The data check rule after the component is integrated.'),
        needRestartAfterIntegration?: boolean(name='needRestartAfterIntegration', description='Indicates whether to prompt for a workload restart after integration.', example='true/false'),
        protocols?: [ 
          {
            description?: string(name='description', description='The description of the protocol.', example='使用 Prometheus 协议写入指标数据'),
            icon?: string(name='icon', description='The display icon for the protocol.', example='assets/logos/ecs.svg'),
            label?: string(name='label', description='The display name of the protocol.', example='Prometheus 协议'),
            name?: string(name='name', description='The name of the protocol.', example='Prometheus'),
          }
        ](name='protocols', description='The list of supported client protocols.'),
        targetAddonName?: string(name='targetAddonName', description='The name of the target component for redirection.', example='cloud-acs-ecs'),
      }(name='policies', description='Information about the control policy group for the component.'),
      policyType?: string(name='policyType', description='The policy type.', example='ECS'),
    }
  ](name='environments', description='The list of supported environment types.'),
  icon?: string(name='icon', description='The icon of the component.', example='assets/logos/ecs.svg'),
  keywords?: [ string ](name='keywords', description='The list of keywords.'),
  language?: string(name='language', description='The language. Valid values:

- zh: Chinese (default)

- en: English', example='zh'),
  latestReleaseCreateTime?: string(name='latestReleaseCreateTime', description='The last time the component was integrated.', example='2025-10-25 09:12:12'),
  name?: string(name='name', description='The name of the component.', example='cloud-acs-ecs'),
  once?: boolean(name='once', description='Indicates whether the component can be installed only once under a policy.', example='true/false'),
  scene?: string(name='scene', description='The scenario.', example='feature'),
  version?: string(name='version', description='The version number.', example='0.0.1'),
  weight?: int32(name='weight', description='The sorting weight of the component.', example='1000'),
}

model AlertEventIntegrationPolicyForModify {
  alertEventIntegrationPolicyName: string(name='alertEventIntegrationPolicyName', description='The name.

This parameter is required.', example='test integration'),
  description?: string(name='description', description='The description.', example='test'),
  filterSetting?: FilterSetting(name='filterSetting', description='The filter settings.'),
  integrationSetting?: string(name='integrationSetting', description='The subscription settings.', example='{"region":"cn-hangzhou"}'),
  transformerSetting?: [
    TransformAction
  ](name='transformerSetting', description='The transform settings.'),
  type?: string(name='type', description='The type.', example='ALERT_CUSTOM'),
}

model AlertEventIntegrationPolicyForView {
  alertEventIntegrationPolicyId?: string(name='alertEventIntegrationPolicyId', description='The universally unique identifier (UUID).', example='123123123'),
  alertEventIntegrationPolicyName: string(name='alertEventIntegrationPolicyName', description='The name.

This parameter is required.', example='集成名'),
  createTime?: string(name='createTime', description='The time when the policy was created.', example='2025-03-11T08:21:58Z'),
  description?: string(name='description', description='The description.', example='workspace test'),
  enable?: boolean(name='enable', description='Indicates whether the policy is enabled.', example='true'),
  filterSetting?: FilterSetting(name='filterSetting', description='The filter configuration.'),
  integrationSetting?: string(name='integrationSetting', description='The subscription settings.', example='{"region":"cn-hangzhou"}'),
  token?: string(name='token', description='The key for the integration\\\\"s reporting endpoint.', example='10-16818f1445e10a1d012922b285bfb334'),
  transformerSetting?: [
    TransformAction
  ](name='transformerSetting', description='The transformation settings.'),
  type?: string(name='type', description='The type.', example='ALERT_CUSTOM'),
  updateTime?: string(name='updateTime', description='The time when the policy was last updated.', example='2024-12-16T02:00:23Z'),
  userId?: string(name='userId', description='The user ID.', example='123123'),
  workspace?: string(name='workspace', description='The workspace.', example='workspace-test'),
}

model AlertRuleAction {
  actions?: [ string ](name='actions', description='A list of action integration IDs.'),
}

model AlertRuleAlertMetricFilterDef {
  dim?: string(name='dim', description='The dimension in APM metrics.', example='status'),
  dimDisabled?: boolean(name='dimDisabled', description='If set to \\\\`true\\\\`, the filter item does not appear in the \\\\`group by\\\\` clause of a PromQL query.', example='true'),
  displayNameCn?: string(name='displayNameCn', description='The display name in Chinese.', example='Application Status'),
  displayNameEn?: string(name='displayNameEn', description='The display name in English.', example='Application Status'),
  hidden?: boolean(name='hidden', description='Specifies whether to hide the filter. If hidden, the filter does not appear in the frontend UI. However, its value can be uploaded when rendering a PromQL query. For example, in an Application Performance Management (APM) scenario, the pid filter is typically hidden from the configuration UI. The frontend displays it as a separate application search list.', example='true'),
  labelDisabled?: boolean(name='labelDisabled', description='If set to \\\\`true\\\\`, the filter item does not appear in the label filter of a PromQL query.', example='true'),
  opt?: string(name='opt', description='The operator for the filter condition.', example='='),
  supportedOpts?: [ 
    {
      displayNameCn?: string(name='displayNameCn', description='The display name in Chinese.', example='Online'),
      displayNameEn?: string(name='displayNameEn', description='The display name in English.', example='Online'),
      value?: string(name='value', description='The matching value.', example='online'),
    }
  ](name='supportedOpts', description='A list of supported options.'),
}

model AlertRuleAlertMetricInput {
  filterValues?: [
    AlertRuleAlertMetricInputFilterValue
  ](name='filterValues', description='A list of filter conditions. Call the ListAlertMetrics operation to query the lists of parameters and filter conditions that the metric supports.'),
  groupId?: string(name='groupId', description='The key of the metric group.', example='apm.jvm'),
  metricId?: string(name='metricId', description='The key of the predefined metric.', example='appstat.jvm.GcPsMarkSweepCount'),
  paramValues?: [
    AlertRuleAlertMetricInputParamValue
  ](name='paramValues', description='A list of parameters. Call the ListAlertMetrics operation to query the lists of parameters and filter conditions that the metric supports.'),
}

model AlertRuleAlertMetricInputFilterValue {
  dim: string(name='dim', description='The dimension of the filter condition.

This parameter is required.', example='rootIp'),
  opt: string(name='opt', description='The operator for the filter condition.

This parameter is required.', example='ALL'),
  value?: string(name='value', description='The value of the filter condition.', example='127.0.0.1'),
}

model AlertRuleAlertMetricInputParamValue {
  name: string(name='name', description='The name of the predefined metric parameter.

This parameter is required.', example='paramName'),
  value: string(name='value', description='The value of the predefined metric parameter.

This parameter is required.', example='paramValue'),
}

model AlertRuleAlertMetricParamDef {
  maxWidth?: int32(name='maxWidth', description='The maximum width of the input control. This parameter is valid only for SELECT_PARAM and INPUT_PARAM.', example='200'),
  minWidth?: int32(name='minWidth', description='The minimum width of the input control. This parameter is valid only for SELECT_PARAM and INPUT_PARAM.', example='100'),
  name?: string(name='name', description='The name.', example='env'),
  placeholderCn?: string(name='placeholderCn', description='The Chinese placeholder text displayed on the frontend. This parameter is valid only for INPUT_PARAM.', example='请输入值'),
  placeholderEn?: string(name='placeholderEn', description='The English placeholder text displayed on the frontend. This parameter is valid only for INPUT_PARAM.', example='Enter value'),
  type?: string(name='type', description='● TEXT_PARAM: A read-only text parameter defined by the backend. No user input control is displayed on the frontend.● INPUT_PARAM: An input box parameter.● SELECT_PARAM: A selection box parameter.', example='TEXT_PARAM'),
  value?: string(name='value', description='The value.', example='staging'),
  values?: [ 
    {
      labelCn?: string(name='labelCn', description='The Chinese display name of the option.', example='测试环境'),
      labelEn?: string(name='labelEn', description='The English display name of the option.', example='Staging'),
      value?: string(name='value', description='The value.', example='staging'),
    }
  ](name='values', description='The list of available options in the drop-down list. This parameter is valid only for SELECT_PARAM.'),
}

model AlertRuleCondition {
  alertCount?: int32(name='alertCount', description='Applicable condition type: SLS_CONDITION.

The number of times the condition must be met before an alert is triggered. Default value: 1.', example='1'),
  caseList?: [ 
    {
      condition?: string(name='condition', description='The match expression. Example: logLevel: error.', example='logLevel: error'),
      countCondition?: string(name='countCondition', description='The count match expression. Examples:
Range combination: __count__ >= 3 && __count__ <= 10
Single range: __count__ >= 3', example='count >= 3'),
      level?: string(name='level', description='The alert level when the condition is met.', example='INFO'),
      type?: string(name='type', description='The match type: has data, has specific count of data, has data match, or has specific count of data match.

Valid values:
- HasData: has data
- HasDataCount: has specific count of data
- HasDataMatch: has data match
- HasDataMatchCount: has specific count of data match', example='HasData'),
    }
  ](name='caseList', description='Applicable condition type: SLS_CONDITION.

The list of Simple Log Service (SLS) alert conditions.'),
  compareList?: [ 
    {
      aggregate?: string(name='aggregate', description='The aggregation function applied after time series.

- count
- sum
- avg
- min
- max
- p90
- p95
- p99', example='count'),
      baseUnit?: string(name='baseUnit', description='The data unit.', example='%'),
      displayUnit?: string(name='displayUnit', description='The display unit.', example='%'),
      oper?: string(name='oper', description='The comparison operator. Determines whether year-over-year or period-over-period comparison is used.

- Greater than: GT
- Greater than or equal to: GTE
- Less than: LT
- Less than or equal to: LTE
- Equal to: EQ
- Not equal to: NE
- Year-over-year increase: YOY_UP
- Year-over-year decrease: YOY_DOWN', example='GT'),
      value?: double(name='value', description='The comparison threshold.', example='50'),
      valueLevelList?: [ 
        {
          level?: string(name='level', description='The level corresponding to the threshold.', example='INFO'),
          value?: double(name='value', description='The comparison threshold.', example='120'),
        }
      ](name='valueLevelList', description='The list of alert levels for different values.'),
      yoyTimeUnit?: string(name='yoyTimeUnit', description='The year-over-year time unit. Valid only when oper is set to YOY_UP or YOY_DOWN.
Valid values: minute, hour, day, week, month.', example='month'),
      yoyTimeValue?: int32(name='yoyTimeValue', description='The year-over-year time value. Used together with yoyTimeUnit.', example='1'),
    }
  ](name='compareList', description='Applicable condition type: APM_CONDITION.

The list of Application Performance Monitoring (APM) alert comparison conditions.'),
  compositeEscalation?: {
    escalations?: [ 
      {
        comparisonOperator?: string(name='comparisonOperator', description='The threshold comparison operator. Valid values:

- GreaterThanOrEqualToThreshold: Greater than or equal to.
- GreaterThanThreshold: Greater than.
- LessThanOrEqualToThreshold: Less than or equal to.
- LessThanThreshold: Less than.
- NotEqualToThreshold: Not equal to.
- EqualToThreshold: Equal to.
- GreaterThanYesterday: Year-over-year increase compared with the same time yesterday.
- LessThanYesterday: Year-over-year decrease compared with the same time yesterday.
- GreaterThanLastWeek: Year-over-year increase compared with the same time last week.
- LessThanLastWeek: Year-over-year decrease compared with the same time last week.
- GreaterThanLastPeriod: Period-over-period increase compared with the previous period.
- LessThanLastPeriod: Period-over-period decrease compared with the previous period.', example='GreaterThanOrEqualToThreshold'),
        metricName?: string(name='metricName', description='The metric name.', example='cpu_total'),
        period?: long(name='period', description='The time window of the metric.', example='60'),
        statistics?: string(name='statistics', description='The statistical method. The value of this parameter is determined by the Statistics column corresponding to the MetricName of the specified cloud service. Example values for the statistical method of a metric:

- $Maximum: maximum value.
- $Minimum: minimum value.
- $Average: average value.
- $Availability: availability rate (typically used for site monitoring).

Note: $ is the unified prefix symbol for metrics.', example='$Maximum'),
        threshold?: double(name='threshold', description='The alert threshold.', example='50'),
      }
    ](name='escalations', description='The list of composite conditions for multiple metrics.'),
    level?: string(name='level', description='The alert level triggered when the condition is met. Composite metric alerts support only one level.', example='INFO'),
    relation?: string(name='relation', description='The relationship between multiple metric conditions. Valid values: and, or.', example='and'),
    times?: int32(name='times', description='The number of times the condition must be met to trigger an alert.', example='3'),
  }(name='compositeEscalation', description='Applicable condition type: CMS_BASIC_CONDITION.

Valid when escalationType is set to composite. The composite metric alert condition.'),
  countOperator?: string(name='countOperator', description='The count comparison operator, specified when type=LOG_SET_CONDITION. Valid values: GTE / GT / EQ / LTE / LT.', example='GTE'),
  countThreshold?: long(name='countThreshold', description='The count threshold, specified when type=LOG_SET_CONDITION.', example='3'),
  enableSeveritySuppression?: boolean(name='enableSeveritySuppression', description='Used when type=UMODEL_METRICSET_MULTI_CONDITION. Specifies whether to enable severity suppression to the highest level. Default value: true. Only the highest severity level is reported for the same entity.'),
  escalationType?: string(name='escalationType', description='Applicable condition type: CMS_BASIC_CONDITION.

Valid values:

- simple: simple metric condition
- composite: composite metric condition
- express: expression condition', example='simple'),
  expressEscalation?: {
    level?: string(name='level', description='The alert level triggered when the condition is met. Expression-based alerts support only one level.

- CRITICAL
- WARNING
- INFO', example='INFO'),
    rawExpression?: string(name='rawExpression', description='The alert conditional expression.', example='@cpu_total[60].$Average > 60'),
    times?: int32(name='times', description='The number of times the condition must be met to trigger an alert.', example='3'),
  }(name='expressEscalation', description='Applicable condition type: CMS_BASIC_CONDITION.

Valid when escalationType=composite. Specifies the multi-metric composite alert conditions.'),
  matchField?: string(name='matchField', description='The log field name, specified when type=LOG_SET_CONDITION and matchOperator=CONTAINS/EQUALS/REGEX.', example='logLevel'),
  matchOperator?: string(name='matchOperator', description='The match operator, specified when type=LOG_SET_CONDITION. Valid values: PRESENT / NOT_PRESENT / CONTAINS / EQUALS / REGEX.', example='CONTAINS'),
  matchValue?: string(name='matchValue', description='The match value, specified when type=LOG_SET_CONDITION and matchOperator=CONTAINS/EQUALS/REGEX.', example='error'),
  max?: double(name='max', description='The upper bound of the range specified when type=BASIC_CONDITION and oper=IN_RANGE/OUT_OF_RANGE.', example='100'),
  min?: double(name='min', description='The lower bound of the range specified when type=BASIC_CONDITION and oper=IN_RANGE/OUT_OF_RANGE.', example='0'),
  noDataAlertLevel?: string(name='noDataAlertLevel', description='Applicable condition type: APM_CONDITION.

The alert level when no data is available. If not specified, no alert is triggered for no-data scenarios.', example='INFO'),
  noDataAppendValue?: string(name='noDataAppendValue', description='Applicable condition type: APM_CONDITION.

The value to use as compensation when no data is available.', example='1'),
  noDataPolicy?: string(name='noDataPolicy', description='Applicable condition type: CMS_BASIC_CONDITION.


Specifies how to handle alerts when no monitoring data is available. Valid values:

- KEEP_LAST_STATE (default): No action is taken.
- INSUFFICIENT_DATA: The alert content indicates no data.
- OK: Normal.', example='KEEP_LAST_STATE'),
  oper?: string(name='oper', description='The comparison operator. Determines whether year-over-year or period-over-period comparison is used.

- Greater than: GT
- Greater than or equal to: GTE
- Less than: LT
- Less than or equal to: LTE
- Equal to: EQ
- Not equal to: NE
- Year-over-year increase: YOY_UP
- Year-over-year decrease: YOY_DOWN', example='LT'),
  relation?: string(name='relation', description='Applicable condition type: APM_CONDITION.

The logical relationship between multiple conditions. Valid values:
- and
- or', example='and'),
  simpleEscalation?: {
    escalations?: [ 
      {
        comparisonOperator?: string(name='comparisonOperator', description='The threshold comparison operator. Valid values:

- GreaterThanOrEqualToThreshold: Greater than or equal to.
- GreaterThanThreshold: Greater than.
- LessThanOrEqualToThreshold: Less than or equal to.
- LessThanThreshold: Less than.
- NotEqualToThreshold: Not equal to.
- EqualToThreshold: Equal to.
- GreaterThanYesterday: Year-over-year increase compared with the same time yesterday.
- LessThanYesterday: Year-over-year decrease compared with the same time yesterday.
- GreaterThanLastWeek: Year-over-year increase compared with the same time last week.
- LessThanLastWeek: Year-over-year decrease compared with the same time last week.
- GreaterThanLastPeriod: Period-over-period increase compared with the previous period.
- LessThanLastPeriod: Period-over-period decrease compared with the previous period.', example='GreaterThanOrEqualToThreshold'),
        level?: string(name='level', description='The alert level triggered when the condition is met. Expression-based alerts support only one level.

- CRITICAL
- WARNING
- INFO', example='INFO'),
        statistics?: string(name='statistics', description='The statistical method. The valid values of this parameter are determined by the Statistics column corresponding to the MetricName of the specified cloud service. Examples: Maximum, Minimum, and Average.', example='Average'),
        threshold?: double(name='threshold', description='The alert threshold.', example='100'),
        times?: int32(name='times', description='The number of times the condition must be met to trigger an alert.', example='3'),
      }
    ](name='escalations', description='The list of conditions. If an alert rule corresponds to multiple levels, each level has a condition object.'),
    metricName?: string(name='metricName', description='Applicable condition type: CMS_BASIC_CONDITION.

The metric associated with the alert condition.', example='cpu_total'),
    period?: long(name='period', description='The time window of the metric, in seconds.', example='60'),
  }(name='simpleEscalation', description='Applicable condition type: CMS_BASIC_CONDITION.

Valid only when escalationType is set to simple. The alert condition for a single metric.'),
  thresholdList?: [ 
    {
      max?: double(name='max', description='The upper bound of the range (required when operator=IN_RANGE/OUT_OF_RANGE).', example='100'),
      min?: double(name='min', description='The lower bound of the range (required when operator=IN_RANGE/OUT_OF_RANGE).', example='0'),
      severity?: string(name='severity', description='The severity level.', example='CRITICAL'),
      threshold?: double(name='threshold', description='The threshold (required when the operator is not a range operator).', example='80'),
    }
  ](name='thresholdList', description='The list of multi-level thresholds and severity levels, used to map different thresholds to corresponding alert levels.'),
  triggers?: [ 
    {
      durationSecs?: int32(name='durationSecs', description='The duration in seconds that the condition must be continuously met before an alert is triggered.', example='60'),
      expression?: {
        conditions?: [ 
          {
            expressionType?: string(name='expressionType', description='The conditional expression type of the sub-condition, typically SIMPLE.', example='SIMPLE'),
            operator?: string(name='operator', description='The comparison operator of the sub-condition, used to compare the query result with the threshold.', example='GT'),
            queryName?: string(name='queryName', description='The query name referenced by the sub-condition, corresponding to the name in queries.', example='cpuUsageQuery'),
            threshold?: double(name='threshold', description='The threshold value of the sub-condition.', example='80'),
          }
        ](name='conditions', description='The list of sub-conditions for the trigger condition. Multiple sub-conditions are evaluated based on the logicOperator of the parent expression.'),
        expressionType?: string(name='expressionType', description='The expression type. SIMPLE indicates a single-metric condition. COMPOSITE indicates a multi-metric composite condition.', example='SIMPLE'),
        logicOperator?: string(name='logicOperator', description='The multi-metric composite operator. Valid only when expressionType=COMPOSITE.', example='AND'),
      }(name='expression', description='The expression of the trigger condition. Supports two forms: SIMPLE (single-metric) and COMPOSITE (multi-metric AND/OR/UNLESS combination).'),
      severity?: string(name='severity', description='The alert severity level that corresponds to this trigger condition when it is met.', example='CRITICAL'),
    }
  ](name='triggers', description='Specified when type=UMODEL_METRICSET_MULTI_CONDITION. The list of trigger conditions. Each item contains severity, durationSecs, and an expression (SIMPLE for single-metric or COMPOSITE for multi-metric AND/OR/UNLESS).'),
  type: string(name='type', description='The rule condition type. Valid values:
- SLS_CONDITION: SLS alert condition.
- APM_CONDITION: APM alert condition.
- CMS_BASIC_CONDITION: CloudMonitor Basic CloudMonitor alerts condition.

This parameter is required.', example='SLS_CONDITION'),
  value?: double(name='value', description='The threshold for triggering an alert.', example='60'),
}

