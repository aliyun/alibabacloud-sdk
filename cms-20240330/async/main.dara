  partitionKey?: string(name='partitionKey', description='The partition key. This value is read-only and maintained by the system for rule routing and sharding.', example='Sample value'),
  queryConfig?: QueryConfigUnified(name='queryConfig', description='The query configuration. Valid types: PROMETHEUS_SINGLE_QUERY, UMODEL_METRICSET_QUERY, and APM_MULTI_QUERY.'),
  rcaConfig?: AlertRuleRcaConfig(name='rcaConfig', description='The RCA (root cause analysis) configuration.'),
  regionId?: string(name='regionId', description='The region ID, aligned with V1 AlertRule.regionId. Priority: the regionId in the request body takes precedence over the gateway callerRegionId.', example='example-id-001'),
