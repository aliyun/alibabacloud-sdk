  delay?: int32(name='delay', description='The fixed delay for scheduling. Unit: seconds. The default value is 30.', example='30', minimum=0, maximum=120, position='Body'),
  description?: string(name='description', description='The description of the aggregation task group.', example='desc', position='Body'),
