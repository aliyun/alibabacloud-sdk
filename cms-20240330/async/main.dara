    }
  ](name='conditions', description='The subscription conditions.'),
  expression?: string(name='expression', description='Use either expression or relation. If expression is not empty, it takes precedence and relation is ignored. If expression is empty or not specified, relation (AND or OR) is used to perform a simple AND/OR operation on all conditions. Condition numbers correspond to the indexes of the conditions array (starting from 1). Each condition evaluates whether a single event field matches by using field (the event field path, which supports dot-notation nesting such as resource.tags.pod), op (the operator, such as CONTAIN, EQ, or IN), and value (the matching value).', example='1 and 2 or 3'),
  relation?: string(name='relation', description='The logical relationship between conditions. This parameter takes effect when expression is empty.', example='AND'),
}

