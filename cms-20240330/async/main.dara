    {
      key?: string(name='key', description='The tag key.', example='region'),
      value?: string(name='value', description='The tag value.', example='cn-hangzhou'),
    }
  ](name='markTags', description='The list of mark tags for the alert rule, used for categorization and retrieval.'),
  metric?: string(name='metric', description='The metric name.', example='memory'),
  metricSet?: string(name='metricSet', description='The monitoring metrics set.', example='cpu_usage'),
  namespace?: string(name='namespace', description='Applicable query type: CMS_BASIC_QUERY.

The namespace of the metric.', example='acs_ecs_dashboard'),
  offsetSecs?: long(name='offsetSecs', description='Specified when type=METRIC_SET_QUERY or LOG_SET_QUERY. The query time offset in seconds. Used together with windowSecs to implement an offset query of [T - windowSecs - offsetSecs, T - offsetSecs]. Valid range: 0 to 86400.', example='0'),
  queries?: [ 
    {
      apmAlertMetricId?: string(name='apmAlertMetricId', description='Applicable query type: APM_MULTI_QUERY.

The ID of the APM predefined metric.', example='appstat.jvm.ThreadNewCount'),
      apmFilters?: [ 
        {
          dim?: string(name='dim', description='The dimension in the APM metric.', example='rpcType'),
          type?: string(name='type', description='The filter operation type. Valid values:
* eq: Equal to.
* neq: Not equal to.
* match: Regex match.
* nmatch: Regex not match.', example='eq'),
          value?: string(name='value', description='The value corresponding to the filter operation.', example='h3ji7a0y9i@2ac80e27fdfd0a2'),
        }
      ](name='apmFilters', description='Applicable query type: ARMS_MULTI_QUERY.

The dimension filter configuration for APM metrics. Must be used together with apmAlertMetricId.'),
      apmGroupBy?: [ string ](name='apmGroupBy', description='Applicable query type: ARMS_MULTI_QUERY.

The list of aggregation dimensions for the query, specifying which dimensions of the metric to aggregate by.'),
      duration?: long(name='duration', description='Applicable query type: ARMS_MULTI_QUERY.

The alert data duration.', example='120'),
      end?: long(name='end', description='Applicable query type: SLS_MULTI_QUERY.

The relative time offset end time.

If start and end are specified, do not specify window.', example='0'),
      expr?: string(name='expr', description='Applicable query types: APM_MULTI_QUERY, SLS_MULTI_QUERY.

The query expression.

- For APM_MULTI_QUERY, this field is optional and contains the PromQL generated for predefined metrics (used for data preview).
- For SLS_MULTI_QUERY, this field contains the SQL query statement.', example='sum by (rpc,acs_arms_service_id,pid,rpcType) (sum_over_time_lorc(arms_app_requests_count_ign_destid_endpoint_parent_ppid_prpc{callKind=~\\\\"http|rpc|custom_entry|server|consumer\\\\",pid=\\\\"gaddp9ap8q@cb005ffdf44b8ac\\\\",source=\\\\"apm\\\\"}[1m]))'),
      labelFilters?: [ 
        {
          name?: string(name='name', description='The key (label name) for the label filter.', example='host'),
          operator?: string(name='operator', description='The label filter operator, such as =, !=, =~, or !~.', example='='),
          value?: string(name='value', description='The value for the label filter.', example='web-01'),
        }
      ](name='labelFilters', description='Valid only for METRIC_SET_MULTI_QUERY. The label filter conditions (optional, independent for each query).'),
      metric?: string(name='metric', description='Valid only for METRIC_SET_MULTI_QUERY. The metric name.', example='cpuUsage'),
      metricSet?: string(name='metricSet', description='Valid only for METRIC_SET_MULTI_QUERY. The metric set name.', example='ecs_metrics'),
      name?: string(name='name', description='The subquery name. Uniquely identifies the query within the same alert rule and can be referenced by the expression conditions in triggers.', example='cpuUsageQuery'),
      promQl?: string(name='promQl', description='The PromQL query statement. Used when type=APM_MULTI_QUERY.', example='avg(rate(http_requests_total[5m]))'),
      start?: long(name='start', description='Applicable query type: SLS_MULTI_QUERY.

The relative time offset start time for SLS queries.

If start and end are specified, do not specify window. Example: start=15, timeUnit=minute indicates 15 minutes ago.', example='15'),
      timeUnit?: string(name='timeUnit', description='Applicable query type: SLS_MULTI_QUERY.

The time unit for the start, end, and window parameters: day/hour/minute/second.', example='hour'),
      window?: long(name='window', description='Applicable query type: SLS_MULTI_QUERY.

The time frame query interval. If window is specified, do not specify start or end.', example='1'),
    }
  ](name='queries', description='Applicable query types: SLS_MULTI_QUERY, APM_MULTI_QUERY.

The list of subqueries.

For the SLS_MULTI_QUERY query type, a maximum of three subqueries are supported. The number and order of subqueries must match the sub-datasource configurations in datasource.dsList.'),
  relationType?: string(name='relationType', description='Applicable query type: CMS_BASIC_QUERY.

The resource scope for the rule query. Valid values:
- USER: All resources under the user UID.
- GROUP: Application group.
- INSTANCE: Specified instance list.', example='USER'),
  secondJoin?: AlertRuleSlsQueryJoin(name='secondJoin', description='Applicable query type: SLS_MULTI_QUERY.

The set join operation configuration for the results of subquery 2 (queries[2]) and subquery 3 (queries[3]).'),
  serviceIds?: [ string ](name='serviceIds', description='The list of service IDs.'),
  type: string(name='type', description='The query type.

Valid values:
- PROMQL_QUERY: PromQL query.
- SLS_MULTI_QUERY: SLS query.
- APM_MULTI_QUERY: APM query.
- CMS_BASIC_QUERY: CloudMonitor Basic monitoring query.

Different query types have different valid fields in the query object. Refer to the "Applicable query type" description in each field for details.

The query type must match the datasource type. The mapping is as follows:
- Prometheus datasource (PROMETHEUS_DS): PROMQL_QUERY
- APM datasource (APM_DS): APM_MULTI_QUERY
- SLS datasource (SLS_MULTI_DS): SLS_MULTI_QUERY
- CloudMonitor Basic monitoring data datasource (CMS_BASIC_DS): CMS_BASIC_QUERY

This parameter is required.', example='PROMQL_QUERY'),
  windowSecs?: long(name='windowSecs', description='Specified when type=METRIC_SET_QUERY or LOG_SET_QUERY. The aggregation time window in seconds. Valid range: 60 to 86400.', example='300'),
}

