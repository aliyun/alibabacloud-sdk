}

model CmsEventForView {
  annotations?: map[string]any(name='annotations', description='Additional annotations for the event. This is an unstructured description field.', example='{ "description": "High load detected on server", "operator": "auto" }'),
  data?: any(name='data', description='The raw data of the event. The format depends on the event type and dataschema.', example='{ "metricName": "cpu_usage", "value": 95.2, "threshold": 80 }'),
  datacontenttype?: string(name='datacontenttype', description='The content type of the data field.', example='"application/json"'),
  dataschema?: string(name='dataschema', description='The data schema definition, which describes the structure of the data field.', example='"https://schema.alibabacloud.com/cms/alert/v1"'),
  dedupId?: string(name='dedupId', description='The deduplication ID. It identifies different instances of the same event, such as a repeatedly reported event.', example='"dedup-abc123"'),
  id?: string(name='id', description='The unique identifier for the event. The system generates this globally unique ID.', example='"event-1234567890"'),
  integrationUuid?: string(name='integrationUuid', description='The unique integration identifier. It is used for identity recognition in cross-system integrations.', example='"integration-xyz"'),
  labels?: map[string]any(name='labels', description='The key-value pairs of the event labels.', example='{\\\\"source\\\\": \\\\"system\\\\"}'),
  receiveTime?: long(name='receiveTime', description='The timestamp when the event was received and processed.', example='1743846610000'),
  resource?: EventResourceForEventView(name='resource', description='Information about the resource associated with the event, such as the instance ID, IP address, and region.'),
  severity?: string(name='severity', description='The severity level of the event.', example='"CRITICAL"'),
  source?: string(name='source', description='The name of the source system or service, such as ECS, RDS, or VPC.', example='"ECS"'),
  sourcetype?: string(name='sourcetype', description='The type of event source. It distinguishes between sources such as monitoring systems, Simple Log Service, and application observability.', example='"CloudMonitor"'),
  status?: string(name='status', description='The current status of the event.', example='Running'),
  subject?: string(name='subject', description='The subject or title of the event. It briefly describes the event.', example='"Instance cpu usage exceeds threshold"'),
  subtype?: string(name='subtype', description='The event subtype.', example='"HighCPUUsage"'),
  sysId?: string(name='sysId', description='The internal system event ID. It is used for internal tracking and log association.', example='"sys-event-987654321"'),
  time?: string(name='time', description='The time when the event occurred.', example='"2025-04-05T10:30:00Z"'),
  timestamp?: long(name='timestamp', description='The timestamp of the event occurrence.', example='1743846600000'),
  type?: string(name='type', description='The event type.', example='"Alert"'),
  workspace?: string(name='workspace', description='The ID or name of the workspace. It is used for multi-tenant or organization fencing.', example='"ws-abc123"'),
  workspaceTags?: map[string]any(name='workspaceTags', description='The workspace tags. They help you manage events by tag.', example='{ "department": "finance", "project": "payment-gateway" }'),
}

model CompareList {
  absDeviation?: double(name='absDeviation', description='The dynamic baseline minimum deviation or absolute deviation dead zone. This parameter takes effect only when a baseline operator is used. If |current value − boundary| < absDeviation, no alert is triggered. The unit is the same as the metric unit. The value must be greater than or equal to 0. A value of 0 indicates no restriction.', example='0.0'),
  aggregate: string(name='aggregate', description='The aggregation function.

This parameter is required.', example='AVG'),
  baselinePeriod?: string(name='baselinePeriod', description='The baseline period. This parameter takes effect only when a baseline operator is used. Valid values:
- AUTO: Automatically identifies the period. The specific identification result cannot be displayed.
- DAILY: Daily period.
- WEEKLY: Weekly period. The backend automatically expands the historical training window to at least 14 days.
- NONE: No period.', example='AUTO'),
  operator: string(name='operator', description='The comparison operator. Valid values:
- GTE: greater than or equal to.
- LTE: less than or equal to.
- YOY_UP: year-over-year increase. You must also specify yoyTimeUnit and yoyTimeValue.
- YOY_DOWN: year-over-year decrease. You must also specify yoyTimeUnit and yoyTimeValue.
- ABOVE_UPPER: dynamic baseline spike. You must specify sensitivity. When using a baseline operator, threshold is not used for evaluation. Set it to 0 as a placeholder.
- BELOW_LOWER: dynamic baseline drop. You must specify sensitivity. When using a baseline operator, threshold is not used for evaluation. Set it to 0 as a placeholder.
- OUT_OF_BAND: dynamic baseline bidirectional. You must specify sensitivity. When using a baseline operator, threshold is not used for evaluation. Set it to 0 as a placeholder.

This parameter is required.', example='OUT_OF_BAND'),
  sensitivity?: string(name='sensitivity', description='The dynamic baseline sensitivity. This parameter takes effect only when a baseline operator is used. Valid values:
- HIGH: The narrowest band and the most sensitive.
- MEDIUM: Medium sensitivity.
- LOW: The widest band and the least sensitive.', example='MEDIUM'),
  threshold: float(name='threshold', description='The threshold.

This parameter is required.', example='100'),
  yoyTimeUnit?: string(name='yoyTimeUnit', description='The year-over-year time unit. This parameter takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='day'),
  yoyTimeValue?: int32(name='yoyTimeValue', description='The year-over-year time value. This parameter takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='1'),
}

model ConditionConfigUnified {
  absDeviation?: double(name='absDeviation', description='The dynamic baseline minimum deviation or absolute deviation dead zone (UMODEL_METRICSET_CONDITION / APM_SIMPLE_CONDITION). Takes effect only for baseline operators. If |current value − boundary| < absDeviation, no alert is fired. The unit is the same as the metric. The value must be >= 0. A value of 0 means no restriction.', example='0.0'),
  aggregate?: string(name='aggregate', description='The aggregate functions (APM_SIMPLE_CONDITION).', example='AVG'),
  alertCount?: int32(name='alertCount', description='The consecutive trigger count threshold (type=SLS_MULTI_CONDITION). An alert is fired only after the condition is met N times. Default value: 1.', example='1'),
  baselinePeriod?: string(name='baselinePeriod', description='The baseline period. Takes effect only for baseline operators. Valid values: AUTO (automatic detection), DAILY (daily), WEEKLY (weekly), and NONE (no period). When set to WEEKLY, the backend automatically expands the historical training window to at least 14 days. Automatic detection does not return the specific detection result.', example='AUTO'),
  compareList?: [
    CompareList
  ](name='compareList', description='The multiple comparisons (APM_COMPOSITE_CONDITION).'),
  compositeEscalation?: CloudMonitoringCompositeEscalation(name='compositeEscalation', description='The multi-metric composite trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to COMPOSITE. Required fields: relation, severity, times, and escalations.'),
  countOperator?: string(name='countOperator', description='The count comparison operator (type=UMODEL_LOGSET_CONDITION).', example='GTE'),
  countThreshold?: long(name='countThreshold', description='The count threshold (type=UMODEL_LOGSET_CONDITION).', example='100'),
  durationSecs?: int32(name='durationSecs', description='The duration in seconds. Used by PROMETHEUS_SIMPLE and UMODEL_METRICSET.', example='60'),
  enableSeveritySuppression?: boolean(name='enableSeveritySuppression', description='Specifies whether to enable severity suppression to the highest level (type=UMODEL_METRICSET_MULTI_CONDITION / PROMETHEUS_MULTI_CONDITION). Default value: true. When enabled, only the highest severity trigger is reported for the same entity.', example='true'),
  escalationType?: string(name='escalationType', description='The expression type for CLOUD_MONITORING_CONDITION. Valid values: SIMPLE, COMPOSITE, EXPRESS, and PROMETHEUS. Only SIMPLE and COMPOSITE are supported in write paths. Specify the corresponding escalation sub-object based on the type.', example='SIMPLE'),
  expressEscalation?: CloudMonitoringExpressEscalation(name='expressEscalation', description='The expression-based trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to EXPRESS. This field is output only in read paths.'),
  legacyRaw?: string(name='legacyRaw', description='The raw V1 condition JSON string returned when type is set to UNKNOWN_CONDITION and the read path fails to parse the condition. When the frontend detects that this field is not empty, display it as read-only.', example='Sample value'),
  legacyType?: string(name='legacyType', description='Returned when type is set to UNKNOWN_CONDITION. Indicates that this rule cannot be edited through the new API. Submit a ticket to contact the CloudMonitor team.', example='default'),
  matchField?: string(name='matchField', description='The log field name (used when type is set to UMODEL_LOGSET_CONDITION and matchOperator is set to CONTAINS, EQUALS, or REGEX).', example='Sample value'),
  matchOperator?: string(name='matchOperator', description='The log match operator (type=UMODEL_LOGSET_CONDITION).', example='PRESENT'),
  matchValue?: string(name='matchValue', description='The log match value (used when type is set to UMODEL_LOGSET_CONDITION and matchOperator is set to CONTAINS, EQUALS, or REGEX).', example='Sample value'),
  max?: double(name='max', description='The upper bound of the range (used when UMODEL_METRICSET_CONDITION operator is set to IN_RANGE or OUT_OF_RANGE).', example='1.0'),
  min?: double(name='min', description='The lower bound of the range (used when UMODEL_METRICSET_CONDITION operator is set to IN_RANGE or OUT_OF_RANGE).', example='1.0'),
  noDataAlertLevel?: string(name='noDataAlertLevel', description='The no-data alert level (SLS_MULTI_CONDITION). APM and Prometheus conditions have migrated to noDataPolicy and noDataAlertSeverity.', example='INFO'),
  noDataAlertSeverity?: string(name='noDataAlertSeverity', description='The no-data alert severity level (PROMETHEUS_SIMPLE_CONDITION / PROMETHEUS_MULTI_CONDITION). Takes effect only when noDataPolicy is set to NO_DATA_TO_ALERT. SLS_MULTI_CONDITION still uses noDataAlertLevel.', example='INFO'),
  noDataAppendValue?: double(name='noDataAppendValue', description='The value to substitute when no data is available (APM_SIMPLE_CONDITION / APM_COMPOSITE_CONDITION). Nullable.', example='1.0'),
  noDataPolicy?: string(name='noDataPolicy', description='The no-data handling policy (CLOUD_MONITORING_CONDITION / PROMETHEUS_MULTI_CONDITION / PROMETHEUS_SIMPLE_CONDITION / APM_SIMPLE_CONDITION / APM_COMPOSITE_CONDITION). Valid values: NO_DATA_TO_OK, NO_DATA_TO_ALERT, KEEP_LAST_STATE, and APPEND_VALUE (APM only).', example='Sample value'),
  operator?: string(name='operator', description='The comparison operator (UMODEL_METRICSET_CONDITION or APM_SIMPLE_CONDITION).', example='GT'),
  prometheus?: CloudMonitoringPrometheusEscalation(name='prometheus', description='The PromQL-based trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to PROMETHEUS. This field is output only in read paths.'),
  relation?: string(name='relation', description='The logical relationship between conditions (APM_COMPOSITE_CONDITION).', example='AND'),
  sensitivity?: string(name='sensitivity', description='The dynamic baseline sensitivity (UMODEL_METRICSET_CONDITION / APM_SIMPLE_CONDITION). Takes effect only when operator is set to ABOVE_UPPER, BELOW_LOWER, or OUT_OF_BAND. Valid values: HIGH (narrowest band, most sensitive), MEDIUM, and LOW (widest band, least sensitive).', example='MEDIUM'),
  severity?: string(name='severity', description='The severity level (UMODEL / PROMETHEUS_SIMPLE / APM_COMPOSITE).', example='INFO'),
  simpleEscalation?: CloudMonitoringSimpleEscalation(name='simpleEscalation', description='The single-metric multi-level trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to SIMPLE. Required fields: metricName, period, and escalations.'),
  threshold?: double(name='threshold', description='The threshold (UMODEL_METRICSET_CONDITION).', example='30'),
  thresholdList?: [
    ThresholdList
  ](name='thresholdList', description='The multi-threshold list (APM_SIMPLE_CONDITION).'),
  triggers?: [
    Triggers
  ](name='triggers', description='The trigger list. This field is polymorphic based on type. CLOUD_MONITORING_CONDITION does not use this field. Use simpleEscalation.escalations or compositeEscalation.escalations instead. For SLS_MULTI_CONDITION, each case contains matchField, matchOperator, matchValue, countOperator, countThreshold, and severity. At least one case is required. For UMODEL_METRICSET_MULTI_CONDITION, each trigger contains severity, durationSecs, and an expression (SIMPLE or COMPOSITE). For PROMETHEUS_MULTI_CONDITION, each trigger contains severity, durationSecs, and an expression (SIMPLE or COMPOSITE). Triggers are sorted by severity priority, and the first match fires.'),
  type: string(name='type', description='The detection condition type.

This parameter is required.', example='PROMETHEUS_SIMPLE_CONDITION'),
  yoyTimeUnit?: string(name='yoyTimeUnit', description='The year-over-year time unit (APM_SIMPLE_CONDITION). Takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='minute'),
  yoyTimeValue?: int32(name='yoyTimeValue', description='The year-over-year time value (APM_SIMPLE_CONDITION). Takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='1'),
}

