            keys?: [ string ](name='keys', description='The sensitive keywords.'),
            maskChar?: string(name='maskChar', description='The mask character.', example='*'),
            mode?: string(name='mode', description='The masking mode.', example='keyword'),
            types?: [ string ](name='types', description='The built-in sensitive types.'),
