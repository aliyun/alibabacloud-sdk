  maxRunTimeInSeconds?: int32(name='maxRunTimeInSeconds', description='The maximum retry time to execute the aggregation task. Unit: seconds. The default value is 600.', example='600', position='Body'),
  precheckString?: string(name='precheckString', description='The dry run configuration. This parameter is not configured by default. The input string must be a valid JSON string.', example='{"policy":"skip","prometheusId":"xxx","query":"scalar(sum(count_over_time(up{job=\\\\"_arms/kubelet/cadvisor\\\\"}[15s])) / 21)","threshold":0.5,"timeout":15,"type":"promql"}', position='Body'),
