        }(name='selector', description='The service selector.'),
        target?: {
          workspace?: string(name='workspace', description='The target workspace.', example='target-checkout-ws'),
        }(name='target', description='The processing target.'),
      }(name='config', description='The processor configuration.'),
      name?: string(name='name', description='The processor name.', example='drop-health-check'),
      type?: string(name='type', description='The processor type.', example='filter'),
    }
  ](name='processors', description='The common processors.', position='Body'),
  sinks?: [ 
    {
      datasets?: [ string ](name='datasets', description='The list of datasets.'),
      logstore?: string(name='logstore', description='SLS Logstore', example='error-spans'),
