  regionId?: string(name='regionId', description='The region ID.', example='cn-beijing'),
  ruleConfig?: string(name='ruleConfig', description='The list of configuration rules.', example='[{"entrancePid":"xxxxx@b57c44xx6e86","rpcMatcher":{"matchType":"EQUALS","pattern":"/createApp"},"characteristics":{"operation":"AND","rules":[{"target":"CUSTOM_EXTRACT","matcher":{"matchType":"CONTAINS","pattern":[]}}]}}]'),
  workspace?: string(name='workspace', description='The workspace.', example='default-cms-xxxxxxx-cn-hangzhou'),
}

model CloudMonitoringCompositeEscalation {
  escalations?: [
    CloudMonitoringCompositeEscalationEntry
  ](name='escalations', description='The list of multi-condition configurations.'),
