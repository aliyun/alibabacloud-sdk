  bizType?: string(name='bizType', description='The business type.', example='ALERT'),
  datasource?: string(name='datasource', description='The data source, in JSON string format.', example='{"type":"SLS","project":"my-project"}'),
  description?: string(name='description', description='The template description.', example='Triggers an alert when the CPU usage of an ECS instance exceeds the threshold'),
  gmtCreate?: long(name='gmtCreate', description='The creation time, in UNIX millisecond timestamp format.', example='1700000000000'),
  gmtModified?: long(name='gmtModified', description='The last modified time, in UNIX millisecond timestamp format.', example='1700000000000'),
  id?: long(name='id', description='The template ID.', example='1001'),
  isSystem?: int32(name='isSystem', description='Indicates whether the template is a system template. Valid values: 1: yes. 0: no.', example='1'),
  labels?: string(name='labels', description='The labels, in JSON string format.', example='{"env":"prod","team":"ops"}'),
  namespace?: string(name='namespace', description='The namespace.', example='acs_ecs_dashboard'),
  productCategory?: string(name='productCategory', description='The cloud service category.', example='ecs'),
  ruleConfigs?: string(name='ruleConfigs', description='The rule configurations, in JSON string format.', example='{"threshold":80,"duration":60}'),
  scenes?: string(name='scenes', description='The applicable scenarios.', example='ECS'),
  schemaVersion?: string(name='schemaVersion', description='The schema version.', example='1.0'),
  sourceType?: string(name='sourceType', description='The source type.', example='SYSTEM'),
  status?: int32(name='status', description='The template status. Valid values: 1: enabled. 0: disabled.', example='1'),
  subType?: string(name='subType', description='The subtype.', example='THRESHOLD'),
  templateName?: string(name='templateName', description='The template name.', example='ECS CPU Usage Alert Template'),
  userId?: string(name='userId', description='The ID of the user to whom the template belongs.', example='1234567890'),
  uuid?: string(name='uuid', description='The template UUID.', example='a1b2c3d4-e5f6-7890-abcd-ef1234567890'),
}

