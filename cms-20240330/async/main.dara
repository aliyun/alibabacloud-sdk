    SubscriptionOp
  ](name='subscriptions', description='Dedicated to Update operations. Performs batch create, update, or remove adjustments on member subscriptions.'),
  uuid?: string(name='uuid', description='The unique identifier of the alert policy. This parameter is required for Update operations. Do not specify this parameter for Create operations because the backend automatically generates the value.', example='7076c75c-c804-461e-975f-c6f9ed5af745'),
  version?: int32(name='version', description='The optimistic lock version number. This parameter is required for Update operations and must match the current value on the backend. Otherwise, a 409 VersionConflict error is returned. The version number increments by 1 after each successful update.', example='1'),
}

model SubscriptionAndNotifyStrategyForView {
  createTime?: string(name='createTime', description='The creation time. The value is a UNIX timestamp string in milliseconds.', example='1719820800000'),
  description?: string(name='description', description='The description of the alert policy.', example='Alert policy for ECS faults in the production environment. Notifications are sent to the on-duty group'),
  enabled?: boolean(name='enabled', description='Indicates whether the alert policy is enabled. This field is controlled by the EnableAlertPolicy and DisableAlertPolicy operations. The Create and Update operations do not directly set this field.', example='true'),
  migrationBatchId?: string(name='migrationBatchId', description='The migration batch ID. This is an internal system field. The value is an empty string for user-created policies and is populated for policies migrated from the legacy version.', example='123'),
  migrationMeta?: string(name='migrationMeta', description='The migration metadata JSON string. This is an internal system field. You do not need to configure this field.', example='{}'),
  name?: string(name='name', description='The name of the alert policy.', example='ECS Fault Notification Policy'),
  notifyStrategy?: NotifyStrategyForSNSView(name='notifyStrategy', description='The snapshot of the notification strategy details, including notification routes (routes), notification channels (channels), grouping settings (groupingSetting), and custom templates (customTemplateEntries).'),
  notifyStrategyUuid?: string(name='notifyStrategyUuid', description='The UUID of the associated notifyStrategy. This UUID is shared with the responsePlan UUID.', example='7076c75c-c804-461e-975f-c6f9ed5af745'),
  responsePlan?: IncidentResponsePlanForSNSView(name='responsePlan', description='The snapshot of the event response plan details, including escalation policy (escalationId), repeat notification (repeatNotifySetting), automatic recovery (autoRecoverSeconds), and action integration (pushingSetting).'),
  subscription?: SubscriptionForSNSView(name='subscription', description='The snapshot of the primary subscription details, including filter conditions (filterSetting) and cross-workspace subscription configuration (workspaceFilterSetting).'),
  subscriptionUuid?: string(name='subscriptionUuid', description='The UUID of the primary subscription. This UUID is generated when the alert policy is bound to a subscription in a 1:1 relationship.', example='7076c75c-c804-461e-975f-c6f9ed5af745'),
  subscriptions?: [
    SubscriptionForView
  ](name='subscriptions', description='The list of all associated subscriptions, including the primary subscription. This list is generated by the backend through a reverse lookup. The array length is greater than 1 only when workspace-level subscriptions are added in addition to the primary subscription.'),
  updateTime?: string(name='updateTime', description='The last update time. The value is a UNIX timestamp string in milliseconds.', example='1719820800000'),
  userId?: string(name='userId', description='The userId of the owner.', example='1234567890123456'),
  uuid?: string(name='uuid', description='The UUID of the alert policy.', example='7076c75c-c804-461e-975f-c6f9ed5af745'),
  version?: int32(name='version', description='The optimistic lock version number. You must pass in the current value during an Update operation to prevent concurrent conflicts. The value is incremented by 1 after each successful Update operation.', example='1'),
  workspace?: string(name='workspace', description='The workspace identifier.', example='default-cms-1234567890-cn-hangzhou'),
}

