  data?: QueryAlertRulesResult(name='data', description='The business data returned by the API, including the list of alert rule query results and pagination information.', example='{"alertRules":[],"totalCount":0}'),
  message?: string(name='message', description='The detailed error description returned when the request fails. This parameter is empty when the request succeeds.', example='The request is invalid.'),
  nextToken?: string(name='nextToken', description='The token for the next page. A value of null indicates that no more pages are available.', example='caeba0bbb2be03f84eb48b699f0a4883'),
