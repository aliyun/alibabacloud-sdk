            value?: string(name='value', description='The value.', example='Pod OOM'),
          }
        ](name='conditions', description='The subscription conditions.'),
        expression?: string(name='expression', description='If expression is not empty, it takes precedence and relation is ignored. If expression is empty or not specified, the relation (AND or OR) is used to perform a simple AND/OR operation on all conditions. Condition numbers correspond to the indexes of the conditions array (starting from 1). Each condition evaluates whether a single event field matches by using field (the event field path, which supports dot-separated nesting such as resource.tags.pod), op (the operator, such as CONTAIN, EQ, or IN), and value (the match value).', example='(1 AND 2 )OR 3'),
        relation?: string(name='relation', description='The relationship between conditions. If an expression is configured, the expression takes higher precedence.', example='AND'),
      }(name='filterSetting', description='The route-level filter. This is at a different level from the top-level subscription.filterSetting.'),
      severities?: [ string ](name='severities', description='**[Deprecated]** This parameter is deprecated and does not take effect. Route matching only checks filterSetting and effectTimeRange.'),
    }
  ](name='routes', description='The notification channel routing settings.

This parameter is required.'),
}

