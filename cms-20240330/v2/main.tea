    templateUuid?: string(name='templateUuid', description='Deprecated. This parameter does not take effect even if a value is passed in.', example='uuid'),
  }(name='pushingSetting', description='The action integration execution configuration that defines automated actions to trigger when an incident occurs and when it is recovered.'),
  repeatNotifySetting?: {
    endIncidentState?: string(name='endIncidentState', description='The incident status at which repeat notifications stop. Repeat notifications are no longer sent after the incident reaches this status.', example='resolved'),
    repeatInterval?: int32(name='repeatInterval', description='The repeat notification interval. Unit: seconds.', example='300'),
  }(name='repeatNotifySetting', description='The repeat notification settings. When an incident remains unresolved, notifications are sent repeatedly at a fixed interval.'),
}

