  name?: string(name='name', description='Policy Name of the alert policy. If this parameter is not specified, the backend derives Policy Name from notifyStrategy.', example='my-alert-policy'),
  notifyStrategy?: NotifyStrategyForSNSModify(name='notifyStrategy', description='The notification configuration that defines noise reduction rules, notification channel routing, and templates. This parameter is required for Create operations.'),
  responsePlan?: IncidentResponsePlanForSNSModify(name='responsePlan', description='The event management configuration that defines recovery notifications, repeat notifications, automatic recovery, and escalation policies.'),
  subscription?: SubscriptionForSNSModify(name='subscription', description='The single primary subscription configuration that defines event filter conditions. This parameter is mutually exclusive with subscriptions. Do not specify both parameters at the same time.'),
  subscriptions?: [
    SubscriptionOp
  ](name='subscriptions', description='Dedicated to Update operations. Performs batch create, update, or remove adjustments on member subscriptions.'),
  uuid?: string(name='uuid', description='The unique identifier of the alert policy. This parameter is required for Update operations. Do not specify this parameter for Create operations because the backend automatically generates the value.', example='7076c75c-c804-461e-975f-c6f9ed5af745'),
