  countThreshold?: long(name='countThreshold', description='**[Deprecated]** The write path is disabled. Use countCondition instead.', example='100', deprecated=true),
  matchField?: string(name='matchField', description='**[Deprecated]** The write path is disabled. Use condition instead.', example='Sample value', deprecated=true),
  matchOperator?: string(name='matchOperator', description='**[Deprecated]** The write path is disabled. Use condition instead.', example='PRESENT', deprecated=true),
  matchValue?: string(name='matchValue', description='**[Deprecated]** The write path is disabled. Use condition instead.', example='Sample value', deprecated=true),
  operator?: string(name='operator', description='The detection operator (aligned with V1 caseList.type): HAS_DATA / HAS_DATA_COUNT / HAS_DATA_MATCH / HAS_DATA_MATCH_COUNT.', example='HAS_DATA'),
