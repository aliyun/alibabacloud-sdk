  lhsField?: string(name='lhsField', description='The left field in the format $<query_idx>.<field>, such as $0.hostIp.', example='request_id'),
  operator?: string(name='operator', description='The comparison operator. Valid values: ==, !=, <, >, <=, and >=.', example='='),
  rhsField?: string(name='rhsField', description='The right field in the format $<query_idx>.<field>, such as $1.hostIp.', example='trace_id'),
