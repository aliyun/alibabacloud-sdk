  instanceId?: string(name='instanceId', description='The Prometheus instance ID, which is used when the type is PROMETHEUS.', example='rw-xxx'),
  legacyRaw?: string(name='legacyRaw', description='The original V1 datasource JSON string returned as a fallback when the type is UNKNOWN and the read path parsing fails. If this field is not empty, the frontend displays it in read-only mode.', example='{"type":"SLS"}'),
  legacyType?: string(name='legacyType', description='The legacy type returned when the type is UNKNOWN. This indicates that the rule cannot be edited by using the new API. Submit a ticket to contact the CloudMonitor team.', example='SLS'),
  namespace?: string(name='namespace', description='The namespace of the virtual Prometheus instance. This parameter is optional when the type is VIRTUAL_PROMETHEUS.', example='selectdb'),
  productCategory?: string(name='productCategory', description='The category of the Alibaba Cloud service. This parameter is optional when the type is CLOUD_MONITORING. If this information is missing from the source, the value is unknown.', example='ecs'),
  project?: string(name='project', description='The name of the Simple Log Service project. This parameter is required when the type is SLS. All stores share the same project.', example='my-project'),
  regionId?: string(name='regionId', description='The region ID. This parameter is optional for all types and defaults to the region of the rule or gateway.', example='cn-hangzhou'),
  stores?: [
    Stores
  ](name='stores', description='The list of Simple Log Service stores. This parameter is used when the type is SLS and must contain at least one store. Each store includes the store and storeType fields. The project and regionId fields are moved to the top level. The fields with the same names remaining in the stores are deprecated and return a 400 error if used in the write path.', example='[{"store":"cms-alert-log","storeType":"log"}]'),
  tenantId?: string(name='tenantId', description='The ID of the tenant to which the virtual Prometheus instance belongs. This parameter is optional when the type is VIRTUAL_PROMETHEUS.', example='t-xxxxxxx'),
  type?: string(name='type', description='The data source type. Valid values and corresponding fields: PROMETHEUS (instanceId is required; regionId is optional), VIRTUAL_PROMETHEUS (instanceId is required; regionId, namespace, and tenantId are optional), UMODEL (regionId is optional; other fields are carried in queryConfig or conditionConfig), APM (regionId is optional), XTRACE (regionId is optional), EBPF (regionId is optional), RUM (regionId is optional), CLOUD_MONITORING (regionId and productCategory are optional), SLS (project and stores are required), and UNKNOWN (read-only fallback; do not use in the write path). Non-enum values such as CMS_BASIC_DS or SLS_DS are not allowed and return an Invalidtype 400 error.

This parameter is required.', example='PROMETHEUS'),
}

