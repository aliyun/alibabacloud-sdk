  ](name='conditions', description='The list of join conditions for SLS query result sets, which defines the matching rules between multiple SLS query results for cross-logstore data association analysis.', example='[{"lhsField":"$0.hostIp","operator":"==","rhsField":"$1.hostIp"}]'),
