  baselinePeriod?: string(name='baselinePeriod', description='The baseline period. Effective only for baseline operators. Valid values: AUTO (automatic detection), DAILY (daily), WEEKLY (weekly), and NONE (no period). When set to WEEKLY, the backend automatically expands the historical training window to at least 14 days.', example='AUTO'),
  conditions?: [
    MetricSetTriggerSimpleExpression
  ](name='conditions', description='The list of sub-conditions. Used when expressionType is COMPOSITE. Each item contains queryName, operator, and threshold.'),
  durationSecs?: int32(name='durationSecs', description='The duration in seconds that data must continuously meet the condition before an alert is triggered. If not specified, the value is inherited from conditionConfig.durationSecs.', example='1'),
  expressionType?: string(name='expressionType', description='The expression type. Valid values: SIMPLE (single-metric threshold) and COMPOSITE (multi-metric AND/OR/UNLESS combination).', example='SIMPLE'),
  logicOperator?: string(name='logicOperator', description='The logical operator. Used when expressionType is COMPOSITE. Valid values: AND (all conditions met), OR (any condition met), and UNLESS (first condition met and all others not met).', example='AND'),
  max?: double(name='max', description='The upper bound of the range. Required when expressionType is SIMPLE and operator is IN_RANGE/OUT_OF_RANGE. The value must be greater than or equal to min.', example='1.0'),
  min?: double(name='min', description='The lower bound of the range. Required when expressionType is SIMPLE and operator is IN_RANGE/OUT_OF_RANGE.', example='1.0'),
  operator?: string(name='operator', description='The comparison operator (used when expressionType is SIMPLE). Valid values: GT (greater than), GE (greater than or equal to), LT (less than), LE (less than or equal to), EQ (equal to), NE (not equal to), IN_RANGE (within range, requires min/max), OUT_OF_RANGE (outside range, requires min/max), PRESENT (field exists, no threshold/min/max required), NOT_PRESENT (field does not exist, no threshold/min/max required), ABOVE_UPPER/BELOW_LOWER/OUT_OF_BAND (dynamic baseline spike/drop/bidirectional, requires sensitivity, no threshold/min/max).', example='OUT_OF_BAND'),
  queryName?: string(name='queryName', description='The referenced query name (used when expressionType is SIMPLE), corresponding to QueryConfigUnified.queries[].name.', example='SampleName'),
  sensitivity?: string(name='sensitivity', description='The dynamic baseline sensitivity. Effective when expressionType is SIMPLE and a baseline operator is used. Valid values: HIGH (narrowest band, most sensitive), MEDIUM, and LOW (widest band, least sensitive).', example='MEDIUM'),
  severity?: string(name='severity', description='The alert severity level: CRITICAL > ERROR > WARN / WARNING > INFO. Multiple triggers are sorted by this priority, and the first match fires.', example='INFO'),
  threshold?: double(name='threshold', description='The comparison threshold. Used when expressionType is SIMPLE and operator is GT/GE/LT/LE/EQ/NE. For IN_RANGE/OUT_OF_RANGE, use min/max instead. Not required for PRESENT/NOT_PRESENT.', example='1.0'),
}

model MetricSetNamedQueryEntry {
  labelFilters?: [
    LabelFilters
  ](name='labelFilters', description='The optional label filter conditions, which are independent for each query.', example='[{"name":"env","operator":"=","value":"prod"}]'),
  metric?: string(name='metric', description='The metric name.', example='cpuUsage'),
  metricSet?: string(name='metricSet', description='The metric set name.', example='ecs_metrics'),
  name?: string(name='name', description='The query name, such as $A or $B, referenced by the condition trigger.', example='cpuQuery'),
}

model MetricSetTriggerCompositeExpression {
  conditions?: [
    MetricSetTriggerSimpleExpression
  ](name='conditions', description='The list of sub-conditions, where each item is a simple comparison expression.', example='[{"expressionType":"SIMPLE","queryName":"cpuQuery","operator":"GT","threshold":80}]'),
  expressionType?: string(name='expressionType', description='The expression type, which is fixed to COMPOSITE.', example='COMPOSITE'),
  logicOperator?: string(name='logicOperator', description='The logical operator. Valid values: AND (all conditions are met), OR (any condition is met), and UNLESS (the first condition is met and none of the others are met).', example='AND'),
}

model MetricSetTriggerSimpleExpression {
  absDeviation?: double(name='absDeviation', description='The minimum deviation or absolute deviation dead zone for the dynamic baseline. Takes effect only for baseline operators. The unit is the same as the metric. The value must be greater than or equal to 0. A value of 0 indicates no restriction.', example='0.0'),
  baselinePeriod?: string(name='baselinePeriod', description='The baseline period. Takes effect only for baseline operators. Valid values:
- AUTO: Automatically identifies the period.
- DAILY: Daily period.
- WEEKLY: Weekly period. The backend automatically expands the historical training window to at least 14 days.
- NONE: No period.', example='AUTO'),
  expressionType?: string(name='expressionType', description='The expression type. Fixed value: SIMPLE.', example='SIMPLE'),
  max?: double(name='max', description='The upper bound of the range. Required when operator is set to IN_RANGE or OUT_OF_RANGE. The value must be greater than or equal to min.', example='100'),
  min?: double(name='min', description='The lower bound of the range. Required when operator is set to IN_RANGE or OUT_OF_RANGE.', example='0'),
  operator?: string(name='operator', description='The comparison operator. Valid values:
- GT: Greater than.
- GE: Greater than or equal to.
- LT: Less than.
- LE: Less than or equal to.
- EQ: Equal to.
- NE: Not equal to.
- IN_RANGE: Within the range. Both min and max must be specified.
- OUT_OF_RANGE: Outside the range. Both min and max must be specified.
- PRESENT: The field exists. The threshold, min, and max parameters are not required.
- NOT_PRESENT: The field does not exist. The threshold, min, and max parameters are not required.
- ABOVE_UPPER: Dynamic baseline spike. The sensitivity parameter is required. The threshold, min, and max parameters are not required.
- BELOW_LOWER: Dynamic baseline drop. The sensitivity parameter is required. The threshold, min, and max parameters are not required.
- OUT_OF_BAND: Dynamic baseline bidirectional deviation. The sensitivity parameter is required. The threshold, min, and max parameters are not required.', example='OUT_OF_BAND'),
  queryName?: string(name='queryName', description='The referenced query name, corresponding to QueryConfigUnified.queries[].name.', example='cpuQuery'),
  sensitivity?: string(name='sensitivity', description='The dynamic baseline sensitivity. Takes effect only for baseline operators. Valid values:
- HIGH: The narrowest band and highest sensitivity.
- MEDIUM: Medium sensitivity.
- LOW: The widest band and lowest sensitivity.', example='MEDIUM'),
  threshold?: double(name='threshold', description='The comparison threshold. Used when operator is set to GT, GE, LT, LE, EQ, or NE. For IN_RANGE or OUT_OF_RANGE, use min and max instead. Not required for PRESENT or NOT_PRESENT.', example='80'),
}

model MigrationStatusFilter {
  isMigrated?: boolean(name='isMigrated', description='Specifies whether to filter by migration rule. Valid values:
- true: Only migrated rules (migration_status is not 0 or NULL).
- false: Only native rules (migration_status = 0).'),
}

