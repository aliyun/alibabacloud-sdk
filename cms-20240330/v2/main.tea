  message?: string(name='message', description='The error description returned when the request fails. This parameter is empty when the request succeeds.', example='The specified alert rule UUID does not exist.'),
  nextToken?: string(name='nextToken', description='The cursor for the next page in keyset-based pagination. A value of null indicates that no more data is available. Use this value to retrieve the next page of results.', example='caeba0bbb2be03f84eb48b699f0a4883'),
  pageNumber?: int32(name='pageNumber', description='The page number of the returned data.', example='1'),
  pageSize?: int32(name='pageSize', description='The number of records per page in the returned data.', example='10'),
  requestId?: string(name='requestId', description='The unique ID of the API request, which is used for troubleshooting and correlating server-side logs.', example='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'),
  success?: boolean(name='success', description='Indicates whether the request was successful.', example='True'),
  total?: int32(name='total', description='The total number of alert rules actually affected by the operation.', example='8'),
}

