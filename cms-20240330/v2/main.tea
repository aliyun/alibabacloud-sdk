model ResponsePlanConfig {
  autoRecoverSeconds?: long(name='autoRecoverSeconds', description='The number of seconds for automatic recovery. If no new trigger occurs within this duration, the event is automatically recovered.', example='300'),
  escalationId?: [ string ](name='escalationId', description='The list of escalation plan IDs.', example='["esc-uuid-xxx"]'),
  pushingSetting?: {
    alertActionIds?: [ string ](name='alertActionIds', description='The list of action integration IDs triggered by alerts.', example='["action-uuid-xxx"]'),
    restoreActionIds?: [ string ](name='restoreActionIds', description='The list of action integration IDs triggered by recovery.', example='["action-uuid-yyy"]'),
  }(name='pushingSetting', description='The action integration push settings.'),
  repeatNotifySetting?: {
    endIncidentState?: string(name='endIncidentState', description='The target incident status at which repeat notifications stop.', example='RECOVERED'),
    repeatInterval?: int32(name='repeatInterval', description='The repeat notification interval, in seconds.', example='300'),
  }(name='repeatNotifySetting', description='The repeat notification configuration.'),
}

model ResponsePlanDetail {
  autoRecoverSeconds?: long(name='autoRecoverSeconds', description='The number of seconds for automatic recovery. If no new trigger occurs within this duration, the event is automatically recovered.', example='300'),
