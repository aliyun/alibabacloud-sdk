This parameter is required.', example='host.name'),
  type?: string(name='type', description='The match type of the APM query filter condition. Valid values:
- ALL: Matches all values.
- EQ: Matches the exact value.
- NE: Does not match the value.
- DISABLED: Disables the filter condition.

This parameter is required.', example='EQ'),
  value?: string(name='value', description='The filter value. This parameter can be empty when the type is ALL or DISABLED.', example='cn-hangzhou'),
}

model ApmMeasureConfig {
  groupBy?: [ string ](name='groupBy', description='The list of grouping dimensions for the APM metric. This parameter specifies the dimension keys by which to perform grouping and aggregation on metric data.', example='["host.name", "service.name"]'),
  measureCode?: string(name='measureCode', description='The code identifier of the APM metric. This parameter specifies the metric type to collect and query.

This parameter is required.', example='CPU'),
  windowSecs?: int32(name='windowSecs', description='The query time window, in seconds.

This parameter is required.', example='10'),
}

model ApmThresholdConfig {
  max?: double(name='max', description='The upper bound of the range.', example='100'),
  min?: double(name='min', description='The lower bound of the range.', example='0'),
  severity?: string(name='severity', description='The warning level.

This parameter is required.', example='INFO'),
  threshold?: float(name='threshold', description='The threshold.', example='30'),
}

model ArmsIntegrationConfig {
  enabled?: boolean(name='enabled', description='Indicates whether ARMS integration is enabled.', example='true'),
}

model BizSourceFilter {
  eq?: string(name='eq', description='The exact match.', example='managed_service_for_prometheus'),
}

model BizTraceConfig {
  advancedConfig?: string(name='advancedConfig', description='The advanced configuration.', example='{"sample":{"strategy":"BY_APP"}}'),
  bizTraceCode?: string(name='bizTraceCode', description='The business trace identifier.', example='label_env'),
  bizTraceId?: string(name='bizTraceId', description='The business trace ID.', example='e339260ed64c95d'),
  bizTraceName?: string(name='bizTraceName', description='The business trace name.', example='just test'),
  createTime?: string(name='createTime', description='The creation time.', example='2025-12-12 00:00:00'),
  regionId?: string(name='regionId', description='The region ID.', example='cn-beijing'),
  ruleConfig?: string(name='ruleConfig', description='The list of configuration rules.', example='[{"entrancePid":"xxxxx@b57c44xx6e86","rpcMatcher":{"matchType":"EQUALS","pattern":"/createApp"},"characteristics":{"operation":"AND","rules":[{"target":"CUSTOM_EXTRACT","matcher":{"matchType":"CONTAINS","pattern":[]}}]}}]'),
  workspace?: string(name='workspace', description='The workspace.', example='default-cms-xxxxxxx-cn-hangzhou'),
}

model CloudMonitoringCompositeEscalation {
  escalations?: [
    CloudMonitoringCompositeEscalationEntry
  ](name='escalations', description='The multi-condition configuration list for cloud service monitoring composite triggers, which includes multiple sub-trigger conditions combined by logical operators (AND/OR) to determine whether to trigger an alert.', example='[{"metricName":"cpuUsage","comparisonOperator":"GT","threshold":"80","period":60}]'),
  relation?: string(name='relation', description='The logical relationship between conditions (AND/OR).', example='AND'),
  severity?: string(name='severity', description='The severity level.', example='CRITICAL'),
  times?: int32(name='times', description='The consecutive trigger count.', example='3'),
}

model CloudMonitoringCompositeEscalationEntry {
  comparisonOperator?: string(name='comparisonOperator', description='The comparison operator.', example='GT'),
  metricName?: string(name='metricName', description='The metric name.', example='cpuUsage'),
  period?: int32(name='period', description='The collection period, in seconds.', example='60'),
  preCondition?: string(name='preCondition', description='The precondition.', example='3 consecutive times'),
  statistics?: string(name='statistics', description='The statistical method.', example='Average'),
  threshold?: string(name='threshold', description='The threshold.', example='80'),
}

model CloudMonitoringExpressEscalation {
  rawExpression?: string(name='rawExpression', description='The raw expression.', example='cpu_usage > 90'),
  severity?: string(name='severity', description='The severity level.', example='CRITICAL'),
  times?: int32(name='times', description='The number of consecutive times the alert is triggered.', example='3'),
}

model CloudMonitoringPrometheusEscalation {
  promQl?: string(name='promQl', description='The PromQL query statement.', example='rate(http_errors_total[5m]) > 0.1'),
  severity?: string(name='severity', description='The severity level.', example='CRITICAL'),
  times?: int32(name='times', description='The number of consecutive times the alert is triggered.', example='3'),
}

model CloudMonitoringSimpleEscalation {
  escalations?: [
    CloudMonitoringSimpleEscalationEntry
  ](name='escalations', description='The configuration list for multi-level triggers in cloud service monitoring. Each item defines a trigger level (such as Warning or Critical) and includes parameters such as the threshold, duration period, and notification method.', example='[{"severity":"CRITICAL","comparisonOperator":"GT","threshold":"80","times":3}]'),
  metricName?: string(name='metricName', description='The metric name.', example='cpuUsage'),
  period?: int32(name='period', description='The collection period in seconds.', example='60'),
}

model CloudMonitoringSimpleEscalationEntry {
  comparisonOperator?: string(name='comparisonOperator', description='The comparison operator.', example='GT'),
  preCondition?: string(name='preCondition', description='The precondition.', example='3 consecutive times'),
  severity?: string(name='severity', description='The severity level.', example='CRITICAL'),
  statistics?: string(name='statistics', description='The statistical method.', example='Average'),
  threshold?: string(name='threshold', description='The threshold.', example='80'),
  times?: int32(name='times', description='The number of consecutive times the condition must be met to trigger an alert.', example='3'),
}

model CmsEventForView {
  annotations?: map[string]any(name='annotations', description='Additional annotations for the event. This is an unstructured description field.', example='{ "description": "High load detected on server", "operator": "auto" }'),
  data?: any(name='data', description='The raw data of the event. The format depends on the event type and dataschema.', example='{ "metricName": "cpu_usage", "value": 95.2, "threshold": 80 }'),
  datacontenttype?: string(name='datacontenttype', description='The content type of the data field.', example='"application/json"'),
  dataschema?: string(name='dataschema', description='The data schema definition, which describes the structure of the data field.', example='"https://schema.alibabacloud.com/cms/alert/v1"'),
  dedupId?: string(name='dedupId', description='The deduplication ID. It identifies different instances of the same event, such as a repeatedly reported event.', example='"dedup-abc123"'),
  id?: string(name='id', description='The unique identifier for the event. The system generates this globally unique ID.', example='"event-1234567890"'),
  integrationUuid?: string(name='integrationUuid', description='The unique integration identifier. It is used for identity recognition in cross-system integrations.', example='"integration-xyz"'),
  labels?: map[string]any(name='labels', description='The key-value pairs of the event labels.', example='{\\\\"source\\\\": \\\\"system\\\\"}'),
  receiveTime?: long(name='receiveTime', description='The timestamp when the event was received and processed.', example='1743846610000'),
  resource?: EventResourceForEventView(name='resource', description='Information about the resource associated with the event, such as the instance ID, IP address, and region.'),
  severity?: string(name='severity', description='The severity level of the event.', example='"CRITICAL"'),
  source?: string(name='source', description='The name of the source system or service, such as ECS, RDS, or VPC.', example='"ECS"'),
  sourcetype?: string(name='sourcetype', description='The type of event source. It distinguishes between sources such as monitoring systems, Simple Log Service, and application observability.', example='"CloudMonitor"'),
  status?: string(name='status', description='The current status of the event.', example='Running'),
  subject?: string(name='subject', description='The subject or title of the event. It briefly describes the event.', example='"Instance cpu usage exceeds threshold"'),
  subtype?: string(name='subtype', description='The event subtype.', example='"HighCPUUsage"'),
  sysId?: string(name='sysId', description='The internal system event ID. It is used for internal tracking and log association.', example='"sys-event-987654321"'),
  time?: string(name='time', description='The time when the event occurred.', example='"2025-04-05T10:30:00Z"'),
  timestamp?: long(name='timestamp', description='The timestamp of the event occurrence.', example='1743846600000'),
  type?: string(name='type', description='The event type.', example='"Alert"'),
  workspace?: string(name='workspace', description='The ID or name of the workspace. It is used for multi-tenant or organization fencing.', example='"ws-abc123"'),
  workspaceTags?: map[string]any(name='workspaceTags', description='The workspace tags. They help you manage events by tag.', example='{ "department": "finance", "project": "payment-gateway" }'),
}

model CompareList {
  absDeviation?: double(name='absDeviation', description='The dynamic baseline minimum deviation or absolute deviation dead zone. This parameter takes effect only when a baseline operator is used. If |current value − boundary| < absDeviation, no alert is triggered. The unit is the same as the metric unit. The value must be greater than or equal to 0. A value of 0 indicates no restriction.', example='0.0'),
  aggregate?: string(name='aggregate', description='The aggregation function.

This parameter is required.', example='AVG'),
  baselinePeriod?: string(name='baselinePeriod', description='The baseline period. This parameter takes effect only when a baseline operator is used. Valid values:
- AUTO: Automatically identifies the period. The specific identification result cannot be displayed.
- DAILY: Daily period.
- WEEKLY: Weekly period. The backend automatically expands the historical training window to at least 14 days.
- NONE: No period.', example='AUTO'),
  operator?: string(name='operator', description='The comparison operator. Valid values:
- GTE: greater than or equal to.
- LTE: less than or equal to.
- YOY_UP: year-over-year increase. You must also specify yoyTimeUnit and yoyTimeValue.
- YOY_DOWN: year-over-year decrease. You must also specify yoyTimeUnit and yoyTimeValue.
- ABOVE_UPPER: dynamic baseline spike. You must specify sensitivity. When using a baseline operator, threshold is not used for evaluation. Set it to 0 as a placeholder.
- BELOW_LOWER: dynamic baseline drop. You must specify sensitivity. When using a baseline operator, threshold is not used for evaluation. Set it to 0 as a placeholder.
- OUT_OF_BAND: dynamic baseline bidirectional. You must specify sensitivity. When using a baseline operator, threshold is not used for evaluation. Set it to 0 as a placeholder.

This parameter is required.', example='OUT_OF_BAND'),
  sensitivity?: string(name='sensitivity', description='The dynamic baseline sensitivity. This parameter takes effect only when a baseline operator is used. Valid values:
- HIGH: The narrowest band and the most sensitive.
- MEDIUM: Medium sensitivity.
- LOW: The widest band and the least sensitive.', example='MEDIUM'),
  threshold?: float(name='threshold', description='The threshold.

This parameter is required.', example='100'),
  yoyTimeUnit?: string(name='yoyTimeUnit', description='The year-over-year time unit. This parameter takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='day'),
  yoyTimeValue?: int32(name='yoyTimeValue', description='The year-over-year time value. This parameter takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='1'),
}

model ConditionConfigUnified {
  absDeviation?: double(name='absDeviation', description='The minimum deviation or absolute deviation dead zone for dynamic baselines. This parameter takes effect only for baseline operators in UMODEL_METRICSET_CONDITION and APM_SIMPLE_CONDITION. If the absolute difference between the current value and the boundary is less than the absDeviation value, no alert is triggered. The unit is the same as the metric unit. The value must be greater than or equal to 0. A value of 0 indicates no limit.', example='0.0'),
  aggregate?: string(name='aggregate', description='The aggregation function used for APM_SIMPLE_CONDITION. For UModel conditions, this semantic has been migrated to QueryConfigUnified, and this field no longer takes effect.', example='AVG'),
  alertCount?: int32(name='alertCount', description='The consecutive trigger count threshold for SLS_MULTI_CONDITION. An alert is triggered only after the condition is met for the specified number of consecutive times. Default value: 1.', example='1'),
  baselinePeriod?: string(name='baselinePeriod', description='The baseline period. This parameter takes effect only for baseline operators. Valid values: AUTO (automatic identification), DAILY (daily), WEEKLY (weekly), and NONE (no period). For weekly baselines, the backend automatically extends the historical training window to 14 days or more. Automatic identification cannot echo specific identification conclusions.', example='AUTO'),
  compareList?: [
    CompareList
  ](name='compareList', description='The list of multiple comparisons for APM_COMPOSITE_CONDITION.'),
  compositeEscalation?: CloudMonitoringCompositeEscalation(name='compositeEscalation', description='The multi-metric composite trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to COMPOSITE. The relation, severity, times, and escalations parameters are required.'),
  countOperator?: string(name='countOperator', description='The count comparison operator for UMODEL_LOGSET_CONDITION.', example='GTE'),
  countThreshold?: long(name='countThreshold', description='The count threshold for UMODEL_LOGSET_CONDITION.', example='100'),
  durationSecs?: int32(name='durationSecs', description='The duration in seconds. This parameter is directly used for PROMETHEUS_SIMPLE, UMODEL_METRICSET_CONDITION, and UMODEL_LOGSET_CONDITION. For UMODEL_METRICSET_MULTI_CONDITION, it serves as the global default value, and each trigger can override it with its own durationSecs value.', example='60'),
  enableSeveritySuppression?: boolean(name='enableSeveritySuppression', description='Specifies whether to enable severity suppression for UMODEL_METRICSET_MULTI_CONDITION and PROMETHEUS_MULTI_CONDITION. Default value: true. When enabled, only the highest severity trigger is reported for the same entity.', example='true'),
  escalationType?: string(name='escalationType', description='The expression type for CLOUD_MONITORING_CONDITION. Valid values: SIMPLE, COMPOSITE, EXPRESS, and PROMETHEUS. The write path only supports SIMPLE and COMPOSITE. Specify the corresponding escalation sub-object based on the type.', example='SIMPLE'),
  expressEscalation?: CloudMonitoringExpressEscalation(name='expressEscalation', description='The expression trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to EXPRESS. This parameter is output only in the read path.'),
  legacyRaw?: string(name='legacyRaw', description='The original V1 condition JSON string returned as a fallback when parsing fails in the read path and the type is UNKNOWN_CONDITION. The frontend displays this field as read-only when it is not empty.', example='示例值'),
  legacyType?: string(name='legacyType', description='The legacy type returned when the type is UNKNOWN_CONDITION. This indicates that the rule cannot be edited by using the new API. Submit a ticket to contact the CloudMonitor product team.', example='default'),
  matchField?: string(name='matchField', description='The log field name used for UMODEL_LOGSET_CONDITION when matchOperator is set to CONTAINS, EQUALS, or REGEX.', example='示例值'),
  matchOperator?: string(name='matchOperator', description='The log match operator for UMODEL_LOGSET_CONDITION.', example='PRESENT'),
  matchValue?: string(name='matchValue', description='The log match value used for UMODEL_LOGSET_CONDITION when matchOperator is set to CONTAINS, EQUALS, or REGEX.', example='示例值'),
  max?: double(name='max', description='The upper bound of the range used for UMODEL_METRICSET_CONDITION when operator is set to IN_RANGE or OUT_OF_RANGE.', example='1.0'),
  min?: double(name='min', description='The lower bound of the range used for UMODEL_METRICSET_CONDITION when operator is set to IN_RANGE or OUT_OF_RANGE.', example='1.0'),
  noDataAlertLevel?: string(name='noDataAlertLevel', description='The no-data alert level for SLS_MULTI_CONDITION. For APM and Prometheus conditions, this parameter has been migrated to noDataPolicy and noDataAlertSeverity.', example='INFO'),
  noDataAlertSeverity?: string(name='noDataAlertSeverity', description='The no-data alert severity. This parameter takes effect for PROMETHEUS_SIMPLE_CONDITION, PROMETHEUS_MULTI_CONDITION, UMODEL_METRICSET_CONDITION, and UMODEL_METRICSET_MULTI_CONDITION when noDataPolicy is set to NO_DATA_TO_ALERT. For UMODEL_METRICSET conditions, this field is required when noDataPolicy is set to NO_DATA_TO_ALERT, and must not be specified for other policies. SLS_MULTI_CONDITION still uses noDataAlertLevel.', example='INFO'),
  noDataAppendValue?: double(name='noDataAppendValue', description='The compensated value when no data is available for APM_SIMPLE_CONDITION and APM_COMPOSITE_CONDITION. This parameter is nullable.', example='1.0'),
  noDataDurationSecs?: int32(name='noDataDurationSecs', description='The tolerance duration in seconds before no data is determined. This parameter takes effect for UMODEL_METRICSET_CONDITION and UMODEL_METRICSET_MULTI_CONDITION when noDataPolicy is not empty. The noDataPolicy is applied only after no data is continuously reported for longer than this duration. This prevents empty query results in a single cycle caused by UModel data write jitter. The value must be a positive integer. If not specified, the backend uses the fallback value of max(collection interval × 2, 300).', example='600'),
  noDataPolicy?: string(name='noDataPolicy', description='The no-data processing policy for CLOUD_MONITORING_CONDITION, PROMETHEUS_MULTI_CONDITION, PROMETHEUS_SIMPLE_CONDITION, APM_SIMPLE_CONDITION, APM_COMPOSITE_CONDITION, UMODEL_METRICSET_CONDITION, and UMODEL_METRICSET_MULTI_CONDITION. Valid values: NO_DATA_TO_OK (treats no data as normal and recovers existing alerts), NO_DATA_TO_ALERT (triggers an alert for no data), KEEP_LAST_STATE (maintains the last state before no data), and APPEND_VALUE (APM only). If not specified, no-data determination is disabled, and the behavior remains the same as before this feature was released. UMODEL_METRICSET_CONDITION and UMODEL_METRICSET_MULTI_CONDITION do not support APPEND_VALUE because their data sources do not support backfilling.', example='示例值'),
  operator?: string(name='operator', description='The comparison operator. For UMODEL_METRICSET_CONDITION, valid values are GT (greater than), GE (greater than or equal to), LT (less than), LE (less than or equal to), EQ (equal to), NE (not equal to), IN_RANGE (within the range, requires min and max), OUT_OF_RANGE (outside the range, requires min and max), PRESENT (field exists), NOT_PRESENT (field does not exist), ABOVE_UPPER (dynamic baseline spike), BELOW_LOWER (dynamic baseline drop), and OUT_OF_BAND (bidirectional dynamic baseline, requires sensitivity, do not specify threshold, min, or max). This field is not used for UMODEL_LOGSET_CONDITION. For APM_SIMPLE_CONDITION, valid values are GT, GTE, LT, LTE, EQ, NE, YOY_UP, YOY_DOWN (YOY operators require yoyTimeUnit and yoyTimeValue), ABOVE_UPPER, BELOW_LOWER, and OUT_OF_BAND (dynamic baseline, requires sensitivity).', example='GT'),
  prometheus?: CloudMonitoringPrometheusEscalation(name='prometheus', description='The PromQL trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to PROMETHEUS. This parameter is output only in the read path.'),
  relation?: string(name='relation', description='The logical relation between conditions for APM_COMPOSITE_CONDITION.', example='AND'),
  sensitivity?: string(name='sensitivity', description='The dynamic baseline sensitivity for UMODEL_METRICSET_CONDITION and APM_SIMPLE_CONDITION. This parameter takes effect only when operator is set to ABOVE_UPPER, BELOW_LOWER, or OUT_OF_BAND. Valid values: HIGH (narrowest band and most sensitive), MEDIUM, and LOW (widest band and least sensitive).', example='MEDIUM'),
  severity?: string(name='severity', description='The severity level for UMODEL_METRICSET_CONDITION, UMODEL_LOGSET_CONDITION, PROMETHEUS_SIMPLE, and APM_COMPOSITE.', example='INFO'),
  simpleEscalation?: CloudMonitoringSimpleEscalation(name='simpleEscalation', description='The single-metric multi-level trigger configuration for CLOUD_MONITORING_CONDITION when escalationType is set to SIMPLE. The metricName, period, and escalations parameters are required.'),
  threshold?: double(name='threshold', description='The threshold used for UMODEL_METRICSET_CONDITION when a non-range operator is specified.', example='30'),
  thresholdList?: [
    ThresholdList
  ](name='thresholdList', description='The list of multiple thresholds for APM_SIMPLE_CONDITION.'),
  triggers?: [
    Triggers
  ](name='triggers', description='The list of triggers. This field is polymorphic based on the type. CLOUD_MONITORING_CONDITION does not use this field; use simpleEscalation.escalations or compositeEscalation.escalations instead. For SLS_MULTI_CONDITION, each case includes matchField, matchOperator, matchValue, countOperator, countThreshold, and severity, and at least one case is required. For UMODEL_METRICSET_MULTI_CONDITION, each trigger includes severity, durationSecs, and an expression (SIMPLE or COMPOSITE). For PROMETHEUS_MULTI_CONDITION, each trigger includes severity, durationSecs, and an expression (SIMPLE or COMPOSITE). Triggers are sorted by severity priority, and the first matched trigger is executed.'),
  type?: string(name='type', description='The detection condition type. Valid values and required fields: PROMETHEUS_SIMPLE_CONDITION (requires operator, threshold, durationSecs, and severity), UMODEL_METRICSET_CONDITION (requires operator, durationSecs, and severity; requires threshold for non-range operators; requires min and max when operator is IN_RANGE or OUT_OF_RANGE; noDataPolicy and noDataDurationSecs are optional, but noDataAlertSeverity is required when noDataPolicy is NO_DATA_TO_ALERT), UMODEL_LOGSET_CONDITION (requires matchOperator, durationSecs, and severity; requires matchField and matchValue when matchOperator is CONTAINS, EQUALS, or REGEX; countOperator and countThreshold are optional), UMODEL_METRICSET_MULTI_CONDITION (requires triggers; durationSecs as global default and enableSeveritySuppression are optional; noDataPolicy and noDataDurationSecs are optional, but noDataAlertSeverity is required when noDataPolicy is NO_DATA_TO_ALERT), APM_SIMPLE_CONDITION (requires operator and aggregate; requires thresholdList or threshold; requires yoyTimeUnit and yoyTimeValue when operator is YOY_UP or YOY_DOWN; noDataPolicy and noDataAppendValue are optional), APM_COMPOSITE_CONDITION (requires compareList, relation, and severity; noDataPolicy and noDataAppendValue are optional), CLOUD_MONITORING_CONDITION (requires escalationType; requires simpleEscalation when escalationType is SIMPLE; requires compositeEscalation when escalationType is COMPOSITE; noDataPolicy is optional), and UNKNOWN_CONDITION (read-only fallback, do not use in the write path). Non-enum values such as SLS_CONDITION or CMS_BASIC_CONDITION are prohibited. The backend returns an Invalidtype 400 error for invalid values.

This parameter is required.', example='PROMETHEUS_SIMPLE_CONDITION'),
  yoyTimeUnit?: string(name='yoyTimeUnit', description='The year-over-year time unit for APM_SIMPLE_CONDITION. This parameter takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='minute'),
  yoyTimeValue?: int32(name='yoyTimeValue', description='The year-over-year time value for APM_SIMPLE_CONDITION. This parameter takes effect only when operator is set to YOY_UP or YOY_DOWN.', example='1'),
}

