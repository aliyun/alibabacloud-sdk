  containsCustomWebhooks?: [ string ](name='containsCustomWebhooks', description='The list of custom webhooks in the rule contains any value in the array. This uses OR logic and corresponds to notification.customWebhooks in V1.', example='["https://my-service.example.com/webhook/alert"]'),
  containsDingWebhooks?: [ string ](name='containsDingWebhooks', description='The list of DingTalk webhooks in the rule contains any value in the array. This uses OR logic and corresponds to notification.dingWebhooks in V1.', example='["https://oapi.dingtalk.com/robot/send?access_token=abc123"]'),
  containsFsWebhooks?: [ string ](name='containsFsWebhooks', description='The list of Lark webhooks in the rule contains any value in the array. This uses OR logic and corresponds to notification.fsWebhooks in V1.', example='["https://open.feishu.cn/open-apis/bot/v2/hook/abc123"]'),
  containsGroups?: [ string ](name='containsGroups', description='The list of contact groups in the rule contains any value in the array. This uses OR logic and corresponds to notification.groups in V1.', example='["运维组","SRE团队"]'),
  containsSlackWebhooks?: [ string ](name='containsSlackWebhooks', description='The list of Slack webhooks in the rule contains any value in the array. This uses OR logic and corresponds to notification.slackWebhooks in V1.', example='["https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX"]'),
  containsWxWebhooks?: [ string ](name='containsWxWebhooks', description='The list of WeCom webhooks in the rule contains any value in the array. This uses OR logic and corresponds to notification.wxWebhooks in V1.', example='["https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=abc123"]'),
}

