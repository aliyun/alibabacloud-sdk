  updatedCount?: int32(name='updatedCount', description='The number of successfully enabled or disabled rules.', example='1'),
  updatedUuidList?: [ string ](name='updatedUuidList', description='The list of UUIDs of successfully enabled or disabled rules.', example='["a1b2c3d4-e5f6-7890-abcd-ef1234567890","b2c3d4e5-f6a7-8901-bcde-f12345678901"]'),
}

