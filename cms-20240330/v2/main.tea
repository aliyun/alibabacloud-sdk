model EntityDiscoverRule {
  annotations?: [ 
    {
      op?: string(name='op', description='The operation.', example='in'),
      tagKey?: string(name='tagKey', description='The annotation key.', example='instanceId'),
      tagValues?: [ string ](name='tagValues', description='The annotation values.'),
    }
  ](name='annotations', description='The annotation matches.'),
  entityTypes?: [ string ](name='entityTypes', description='The entity types.'),
  fieldRules?: [ 
    {
      fieldKey?: string(name='fieldKey', description='The field key.', example='instanceId'),
      fieldValues?: [ string ](name='fieldValues', description='The field values.'),
      op?: string(name='op', description='The operation.', example='in'),
    }
  ](name='fieldRules', description='The field matching rules.'),
