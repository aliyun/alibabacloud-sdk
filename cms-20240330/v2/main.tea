model AlertRuleV2 {
  actionIntegrationConfig?: ActionIntegrationConfig(name='actionIntegrationConfig', description='The action integration configuration.'),
  annotations?: map[string]string(name='annotations', description='The annotations.'),
  armsIntegrationConfig?: ArmsIntegrationConfig(name='armsIntegrationConfig', description='The ARMS integration configuration.'),
  bizSource?: string(name='bizSource', description='The business source (read-only, such as managed_service_for_prometheus / umodel / application_insights / cloud_monitoring / sls).', example='示例值'),
  conditionConfig?: ConditionConfigUnified(name='conditionConfig', description='The detection condition configuration aggregate (Prometheus simple / UModel / APM simple / APM composite).'),
  contentTemplate?: string(name='contentTemplate', description='The content template.', example='Alert triggered: ${metricName} current value ${currentValue} exceeds threshold ${threshold}'),
  createdAt?: string(name='createdAt', description='The creation time (read-only), in ISO 8601 format.', example='1751595283143'),
  datasourceConfig?: DatasourceConfigUnified(name='datasourceConfig', description='The datasource configuration aggregate (shared by PROMETHEUS / UMODEL / APM in a single object; fields are selected based on the type).'),
  datasourceType?: string(name='datasourceType', description='The datasource type (read-only, derived).', example='default'),
  displayName?: string(name='displayName', description='The display name.', example='CPU resource usage alert 95%'),
  enabled?: boolean(name='enabled', description='Specifies whether the alert rule is enabled.', example='true'),
  labels?: map[string]string(name='labels', description='The labels.'),
  managedBy?: string(name='managedBy', description='The rule manager (read-only). An empty value indicates a user-created rule. A non-empty value indicates that the rule was created and managed by the corresponding cloud service.', example='integrationCenter'),
  notifyConfig?: NotifyConfigUnified(name='notifyConfig', description='The notification configuration aggregate (currently only DIRECT_NOTIFY, corresponding to DirectNotifyConfig).'),
  notifyStrategyId?: string(name='notifyStrategyId', description='The notification policy ID (read-only, derived from the first entry in the notification policy list).', example='example-id-001'),
  observeResourceConfig?: ObserveResourceConfig(name='observeResourceConfig', description='The observable resource configuration.'),
  observeResourceGlobalScope?: boolean(name='observeResourceGlobalScope', description='**[Deprecated]** Specifies whether the rule applies to all resources of the resource type (read-only, derived). For new integrations, use observeResourceConfig.relationType to check whether the value is ALL for equivalent semantics.', example='true', deprecated=true),
  observeResourceList?: [ string ](name='observeResourceList', description='The observable resource ID list (read-only, derived).'),
  observeResourceType?: string(name='observeResourceType', description='**[Deprecated]** The observable resource type (read-only, derived). For new integrations, use observeResourceConfig.entityType instead.', example='default', deprecated=true),
  partitionKey?: string(name='partitionKey', description='The partition key (read-only, maintained by the system for rule routing and sharding).', example='示例值'),
  queryConfig?: QueryConfigUnified(name='queryConfig', description='The query configuration aggregate (PROMETHEUS_SINGLE_QUERY / UMODEL_METRICSET_QUERY / APM_MULTI_QUERY).'),
  rcaConfig?: AlertRuleRcaConfig(name='rcaConfig', description='The RCA (root cause analysis) configuration.'),
  regionId?: string(name='regionId', description='The region ID (aligned with V1 AlertRule.regionId; priority: request body regionId > gateway callerRegionId).', example='example-id-001'),
  scheduleConfig?: ScheduleConfigUnified(name='scheduleConfig', description='The scheduling configuration aggregate (currently only FIXED is supported).'),
  severityLevels?: string(name='severityLevels', description='The severity levels covered by this rule, comma-separated (read-only, derived; consistent with the filter.severityLevels query parameter format).', example='1'),
  status?: string(name='status', description='The alert status (read-only).', example='Alarm'),
  updatedAt?: string(name='updatedAt', description='The update time (read-only), in ISO 8601 format.', example='1764556086388'),
  uuid?: string(name='uuid', description='The rule UUID (system-generated, read-only).', example='xxxxx-xxxx-xxxx'),
  workspace?: string(name='workspace', description='The workspace.', example='workspace-test'),
}

model ApmCompositeCompareConfig {
