  action?: string(name='action', description='The action type.

This parameter is required.', example='CREATE'),
  actionIntegrationConfig?: ActionIntegrationConfig(name='actionIntegrationConfig', description='The action integration configuration.', example='{"enabled":true,"actions":[]}'),
  annotations?: map[string]string(name='annotations', description='The annotations.', example='{"summary":"CPU usage exceeds 90%"}'),
  armsIntegrationConfig?: ArmsIntegrationConfig(name='armsIntegrationConfig', description='The ARMS integration configuration.', example='{"enabled":false}'),
  bizSource?: string(name='bizSource', description='The business source. Valid values include managed_service_for_prometheus, umodel, application_insights, cloud_monitoring, and sls. Pass this field as needed for CREATE, UPDATE, and PATCH actions.', example='示例值'),
  conditionConfig?: ConditionConfigUnified(name='conditionConfig', description='The condition aggregation configuration.', example='{"type":"PROMETHEUS_SIMPLE_CONDITION","durationSecs":0,"severity":"CRITICAL"}'),
  contentTemplate?: string(name='contentTemplate', description='The content template.', example='实例 {{instance}} CPU 使用率超过 {{threshold}}%'),
  datasourceConfig?: DatasourceConfigUnified(name='datasourceConfig', description='The data source aggregation configuration.', example='{"type":"PROMETHEUS","instanceId":"prom-cn-hangzhou-xxxxx"}'),
  displayName?: string(name='displayName', description='The display name.', example='test'),
  drillEvalTime?: long(name='drillEvalTime', description='The alert drill evaluation time in Unix milliseconds. This field is required by the backend when drillMode is ONE_SHOT. The time cannot be later than the current time or earlier than 90 days ago.', example='1783728000000'),
  drillMode?: string(name='drillMode', description='The alert drill mode. This field is required by the backend when the action is DRILL_ALERT. Valid values: ONE_SHOT specifies a single point in time to simulate a complete lifecycle consisting of three events: OCCURRED, PERSISTENT, and RECOVERED. TIME_TRAVEL specifies a time range to simulate the lifecycle in multiple rounds based on the rule scheduling interval.', example='ONE_SHOT'),
  drillTimeRange?: {
    endTime?: long(name='endTime', description='The drill end time in Unix milliseconds. The end time must be later than the start time.', example='1783814400000'),
    startTime?: long(name='startTime', description='The drill start time in Unix milliseconds.', example='1783728000000'),
  }(name='drillTimeRange', description='The alert drill time range in Unix milliseconds. This field is required by the backend when drillMode is TIME_TRAVEL. The endTime must be later than the startTime and cannot be later than the current time. The lifecycle is simulated in multiple rounds based on the rule scheduling interval. The maximum number of rounds is 500. If the limit is exceeded, the backend returns a 400 error.', example='{"startTime":1783728000000,"endTime":1783814400000}'),
  enabled?: boolean(name='enabled', description='Specifies whether the rule is enabled.', example='true'),
  labels?: map[string]string(name='labels', description='The labels.', example='{"env":"production"}'),
  notifyConfig?: NotifyConfigUnified(name='notifyConfig', description='The notification aggregation configuration.', example='{"type":"DIRECT_NOTIFY","channels":[{"type":"GROUP","identifiers":["<contact-group-id>"]}]}'),
  observeResourceConfig?: ObserveResourceConfig(name='observeResourceConfig', description='The observable resource configuration.', example='{"relationType":"CLOUD_INSTANCE","resources":[]}'),
  observeResourceInstanceId?: string(name='observeResourceInstanceId', description='**[Deprecated]** The ID of the monitored object instance. For new integrations, use observeResourceConfig.resources instead. This field is retained only for compatibility with legacy SDKs.', example='example-id-001', deprecated=true),
  observeResourceType?: string(name='observeResourceType', description='**[Deprecated]** The resource type of the monitored object. For new integrations, use observeResourceConfig.entityType instead. This field is retained only for compatibility with legacy SDKs.', example='default', deprecated=true),
  queryConfig?: QueryConfigUnified(name='queryConfig', description='The query aggregation configuration.', example='{"type":"PROMETHEUS_SINGLE_QUERY","expr":"up > 0"}'),
  rcaConfig?: AlertRuleRcaConfig(name='rcaConfig', description='The root cause analysis (RCA) configuration. Pass this field as needed for CREATE, UPDATE, and PATCH actions.', example='{"enabled":false}'),
  regionId?: string(name='regionId', description='The region ID. This aligns with V1 AlertRule.regionId. If not provided, the gateway callerRegionId is used.', example='example-id-001'),
  scheduleConfig?: ScheduleConfigUnified(name='scheduleConfig', description='The schedule aggregation configuration.', example='{"type":"FIXED","intervalSecs":60}'),
  uuid?: string(name='uuid', description='The UUID of the rule. This field is required for UPDATE and PATCH actions.', example='xxx-xxx-xxx'),
  uuidList?: [ string ](name='uuidList', description='The list of UUIDs for the rules to be deleted. This is used for the BATCH_DELETE action.', example='["cms_v2_81d01768-fee9-459f-af49-ab2704f1db2b"]'),
  workspace?: string(name='workspace', description='The workspace ID. This field is required for CREATE, UPDATE, PATCH, DELETE, ENABLE, DISABLE, BATCH_DELETE, BATCH_ENABLE, and BATCH_DISABLE actions. It identifies the CloudMonitor workspace to which the rule belongs.', example='workspace-test'),
}

