          signatureHash?: string(name='SignatureHash', description='Use the properties under SupportedApps.', example='wi299382'),
          supportedApps?: [ 
            {
              packageName?: string(name='PackageName', description='The package name of the app invoked by WhatsApp. This parameter is required for WhatsApp templates where Category is set to AUTHENTICATION and Button Type is set to ONE_TAP or ZERO_TAP.', example='com.kuaidian.waimaistaff'),
              signatureHash?: string(name='SignatureHash', description='The signature hash value of the app invoked by WhatsApp. This parameter is required for WhatsApp templates where Category is set to AUTHENTICATION and Button Type is set to ONE_TAP or ZERO_TAP.', example='ieid83kdiek'),
            }
