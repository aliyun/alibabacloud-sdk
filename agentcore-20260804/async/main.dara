      {
        exists?: boolean(name='exists', description='Indicates whether the selected department still exists. A value of false indicates that the selection is invalid and the synchronization scope must be reconfirmed.', example='true'),
        id?: string(name='id', description='The unique identifier of the department returned by the identity provider. When querying the child departments of this node, use this value as parentDepartmentId.', example='10001'),
        name?: string(name='name', description='The name of the department returned by the identity provider.', example='R&D Department'),
      }
    ](name='selectedDepartments', description='The names and validity of the saved selected departments. This can be an empty array when the mode is AllAuthorized. An empty array does not indicate that the organization has no departments.', example='[{"id":"10001","name":"研发部","exists":true}]'),
    syncScope?: {
      departmentIds?: [ string ](name='departmentIds', description='When the mode is SelectedDepartments, the list must contain at least one non-empty department ID, which should be obtained from ListIdentityProviderDepartments. When the mode is AllAuthorized, pass an empty array or omit this parameter.', example='["10001"]'),
      mode?: string(name='mode', description='AllAuthorized: the full authorized scope, which is restricted by the application\\\\"s address book authorization. SelectedDepartments: the selected departments and all their child departments. When explicitly submitting syncScope, you must provide a valid mode, which is verified by the backend.', example='SelectedDepartments'),
    }(name='syncScope', description='The saved synchronization scope of the downstream system. AllAuthorized indicates the address book scope authorized for the application.', example='{"mode":"SelectedDepartments","departmentIds":["10001"]}'),
  }(name='data', description='The business data returned in the response.', example='{"syncScope":{"mode":"SelectedDepartments","departmentIds":["10001"]},"selectedDepartments":[{"id":"10001","name":"研发部","exists":true}],"estimateStatus":"Ready","expandedDepartmentCount":2,"estimatedUserCount":12}'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code of the API request. This code does not indicate the execution result of the asynchronous task.', example='200'),
