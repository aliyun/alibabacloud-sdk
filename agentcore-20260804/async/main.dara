- DINGTALK: DingTalk.
- FEISHU: Lark.
- WECOM: WeCom.

This parameter is required.', example='DINGTALK'),
    credential: map[string]string(name='credential', description='The channel credentials. All fields must be provided and field values must be non-empty strings. DingTalk uses clientID and clientSecret. Lark uses appId and appSecret. WeCom uses botId and secret.

This parameter is required.'),
    enabled?: boolean(name='enabled', description='Specifies whether to enable the IM channel. Default value: true.'),
    serviceEndpointId: string(name='serviceEndpointId', description='The ID of the ServiceEndpoint to bind. The endpoint must belong to the specified agent and its current version, be in the ready state, and have a public network address.

This parameter is required.', example='se-1'),
  }(name='body', description='The request body.', shrink='json', position='Body'),
  clientToken?: string(name='clientToken', description='A reserved idempotency token. The backend does not provide persistent idempotency guarantees in the current phase.', example='client-token-1', position='Query'),
}

