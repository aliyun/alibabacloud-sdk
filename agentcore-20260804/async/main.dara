model ListIdentityProvidersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListIdentityProvidersResponseBody(name='body'),
}

/**
  * @description ## Features and prerequisites
  * Returns the local binding summary without querying the actual SAML and SCIM configurations of AgentIdentity. If no bindings exist, items is an empty array. A workspace currently supports only one external binding. The default value of maxResults is 10, and the valid values are 1 to 100. Currently, nextToken must be omitted or left empty. A non-empty value returns InvalidParameter, and multi-page results cannot be fabricated.
  * The status of CustomSSO indicates the task status of shared resources and logon configurations. You must combine protocol and saml to determine whether SAML is configured. SCIM queries are independently performed by using GetIdentityProviderSCIM. The list does not issue tokens and does not return the vendor appSecret, encryptKey, or verificationToken.
  * ## Requests and examples
  * GET /workspaces/{workspaceId}/identity-providers
  * Call conventions: Call the API in the region of the target workspace by using an AccessKey pair or STS token that has permissions on the identity provider resources of the workspace. In the following examples, ws-example, URLs, certificates, and tokens are placeholder values and must be replaced with actual values. The request example shows the body parameters of the public API, not the extra body wrapper of the backend direct connection API. The response example shows only the business part. The outer layer also includes requestId, success, code, message, and httpStatusCode. Retain the requestId for troubleshooting and do not record keys. Asynchronous business tasks do not mean that the HTTP request uses a long connection to wait for completion.
  * ```text
  * GET /workspaces/ws-example/identity-providers?maxResults=10
  * ```
  * ## Response example
  * ```json
  * {
  *   "items": [
  *     {
  *       "workspaceId": "ws-example",
  *       "identityProviderType": "CustomSSO",
  *       "status": "READY",
  *       "loginEnabled": false,
  *       "syncEnabled": false
  *     }
  *   ],
  *   "maxResults": 10,
  *   "totalCount": 1
  * }
  * ```
  * ## Errors and handling
  * Error handling: 400 InvalidParameter indicates that the parameters or current configuration prerequisites are not met. 404 IdentityProviderNotFound indicates that no binding of the matching type exists. A synchronous call failure to the upstream may return 503 IdentityProviderProvisioningUnavailable. Retain the request ID for troubleshooting and do not interpret a read failure as unconfigured. Actual authentication and workspace non-existence errors follow the common error handling.
  * 400 InvalidParameter: maxResults is out of bounds or nextToken is non-empty, which is currently not supported. When a query fails, an error is displayed instead of being cleared as unconfigured.
  * ## Call relationships and usage boundaries
  * This API is used to discover current bindings. The specific SAML configuration of CustomSSO is queried by using GetIdentityProvider. The SP address is queried by using GetIdentityProviderServiceProvider. The actual SCIM configuration and independent operation results are queried by using GetIdentityProviderSCIM.
  * @param request  the request parameters of ListIdentityProviders  ListIdentityProvidersRequest
  * @return ListIdentityProvidersResponse
 */
async function listIdentityProviders(request: ListIdentityProvidersRequest): ListIdentityProvidersResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ListIdentityProviders', 'GET', '/workspaces/{workspaceId}/identity-providers', 'json', false, 'json', request);
}

model ListImageCachesRequest {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the source ACR Enterprise instance. The match must be exact. Empty character strings are invalid.', example='cri-example', position='Query'),
  digest?: string(name='digest', description='The complete image digest in the sha256: format followed by a 64-character lowercase hexadecimal string. The format is verified by the console. The match must be exact, and prefixes are not supported.', example='sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', position='Query'),
  imageRefContains?: string(name='imageRefContains', description='Performs a case-insensitive literal substring search on the complete source image reference in the registry/repository:tag format, where the repository already includes the namespace. If the value is empty after trimming leading and trailing whitespace, it is treated as not provided. Percent signs, underscores, and backslashes are treated as literal characters.', example='team/app', position='Query'),
  maxResults?: int32(name='maxResults', description='The maximum number of results to return. If this parameter is not provided or is set to 0, the default value is 20. If the value exceeds 100, it is treated as 100. Negative values return an InvalidMaxResults error. The value can be adjusted for subsequent pages.', example='20', position='Query'),
  namespace?: string(name='namespace', description='The source namespace. The match is case-sensitive and must be exact. Empty strings are invalid.', example='team', position='Query'),
  nextToken?: string(name='nextToken', description='Omit this parameter for the first request. For subsequent requests, pass the nextToken value from the previous response exactly as returned. If the filter conditions change, you must query the first page again.', example='opaque-token', position='Query'),
  regionId: string(name='regionId', description='The product entry region, which is determined by the selected region endpoint.

This parameter is required.', example='cn-hangzhou', position='Query'),
  registry?: string(name='registry', description='The domain name of the source repository. The match is case-insensitive and must be exact. Do not include the protocol, path, or tag. Public network and VPC domain names are not considered equal. Empty strings are invalid.', example='example-registry.cn-hangzhou.cr.aliyuncs.com', position='Query'),
  repository?: string(name='repository', description='The name of the repository under the namespace. The match is case-sensitive and must be exact. Do not include the namespace. If this parameter is provided, the namespace parameter must also be provided. Empty strings are invalid.', example='app', position='Query'),
  status?: string(name='status', description='Filters the results by a single cache status. Omit this parameter to query all statuses.', example='READY', position='Query'),
  tag?: string(name='tag', description='The tag of the source image. The match is case-sensitive and must be exact. The latest tag is not inferred. Empty strings are invalid.', example='v1', position='Query'),
  workspaceId: string(name='workspaceId', description='The current routed workspace. The server verifies the account, region, and resource ownership. This parameter cannot be omitted or used to access other workspaces.

This parameter is required.', example='ws-example', position='Query'),
}

