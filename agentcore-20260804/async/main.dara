  repository?: string(name='repository', description='The repository name under the namespace. The match is case-sensitive and must be exact. Do not include the namespace. If you specify this parameter, you must also specify the namespace. An empty string is invalid.', example='app', position='Query'),
  status?: string(name='status', description='The cache status used to filter the results. To query all caches, omit this parameter.', example='READY', position='Query'),
