        maxSandboxCount?: int32(name='maxSandboxCount', description='The upper limit of instances. Valid values: 0 to 100. Default value: 10. The value cannot be less than the value of minSandboxCount.', example='10'),
        minSandboxCount?: int32(name='minSandboxCount', description='The lower limit of instances. Valid values: 0 to 100. Default value: 1. The value cannot be greater than the value of maxSandboxCount.', example='1'),
