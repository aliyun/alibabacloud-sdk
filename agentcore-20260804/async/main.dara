  data?: {
    configuration?: {
      baseUrl?: string(name='baseUrl', description='The URL configured for the external provisioning system. The presence of a URL does not indicate that the external configuration is complete or that AgentCore synchronization is enabled.', example='https://example.com/scim/v2'),
      status?: string(name='status', description='The receiving status of AgentIdentity. A value of Enabled indicates that SCIM receiving is enabled. A value of Disabled indicates that SCIM receiving is disabled. This value is not equivalent to the expected value of syncEnabled in AgentCore.', example='Enabled'),
    }(name='configuration', description='The actual SAML configuration is read on demand only by calling GetIdentityProvider. SCIM query and preparation operations return the actual receiving status and URL.'),
    credential?: {
      createTime?: string(name='createTime', description='The creation time returned by AgentIdentity.', example='2026-10-26T00:00:00Z'),
      credentialId?: string(name='credentialId', description='The credential ID. This parameter is required when you delete a credential. Use the ID returned in the credential list, not the plaintext token.', example='credential-example'),
      expireTime?: string(name='expireTime', description='The expiration time returned by AgentIdentity. Only credentials that are enabled and not expired are considered available.', example='2027-10-26T00:00:00Z'),
      status?: string(name='status', description='The credential status of AgentIdentity. Only credentials that are enabled and not expired are considered available. This field is not the operationStatus of a SCIM task.', example='Enabled'),
    }(name='credential', description='The current credential summary, including credentialId, status, createTime, and expireTime. The plaintext token is not included and cannot be repeatedly obtained.'),
    token?: string(name='token', description='The plaintext token is returned only when a new credential is created. If the prepare operation reuses a valid credential, this value is null. The token cannot be retrieved from the list. If the response is lost, query the list first. The token is not automatically reissued and is not written to logs or persistent frontend caches.', example='example-scim-token'),
  }(name='data', description='The operation result. For the result structure, see the response parameters of this operation. The response of an asynchronous write operation indicates that the request is accepted, but does not guarantee that the background task is complete.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The processing status of the current request. This status does not indicate the final result of the background task.', example='200'),
  message?: string(name='message', description='The request acceptance or error message. For asynchronous node results, you must verify them by calling the corresponding query operation.', example='success'),
  requestId?: string(name='requestId', description='The request ID. You can use this ID to associate the current call with troubleshooting. Keep the ID if the call fails.', example='request-example'),
  success?: boolean(name='success', description='Indicates whether the current request is successful. A value of true indicates that the request is processed successfully. For asynchronous write operations, you must continue to query the task result.'),
}

model CreateIdentityProviderSCIMCredentialResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateIdentityProviderSCIMCredentialResponseBody(name='body'),
}

/**
  * @description Creates a SCIM access token to authorize an enterprise identity system to send user provisioning requests to AgentCore. For example, when you plan to replace the token used by the enterprise identity system, you can create a new token first and revoke the old token after the switchover is complete.
  * SCIM is a user provisioning protocol through which an enterprise identity system sends user information by using a receiving endpoint and an access token.
  * ### Before you begin
  * A `CustomSSO` binding is created, and the SCIM receiving endpoint is enabled by calling [PrepareIdentityProviderSCIM](https://api.aliyun.com/document/AgentCore/2026-08-04/PrepareIdentityProviderSCIM).
  * A maximum of two SCIM credentials can be retained in the same user pool. When the limit is reached, query existing credentials by calling [ListIdentityProviderSCIMCredentials](https://api.aliyun.com/document/AgentCore/2026-08-04/ListIdentityProviderSCIMCredentials) and revoke the credentials that are no longer in use.
  * ### What to do next
  * **Step 1:** Save the plaintext of the `token` in the response. The token is returned only upon creation. You can only query the credential summary later.
  * **Step 2:** Configure the receiving endpoint and the new token in the enterprise identity system.
  * **Step 3:** After you confirm that the enterprise identity system uses the new token, revoke the old token by calling [DeleteIdentityProviderSCIMCredential](https://api.aliyun.com/document/AgentCore/2026-08-04/DeleteIdentityProviderSCIMCredential) as needed.
  * If the creation response is lost, query the credential list to verify the creation result to avoid duplicate creation and occupying the credential quota. The user synchronization switch is configured separately by calling [UpdateIdentityProviderSCIM](https://api.aliyun.com/document/AgentCore/2026-08-04/UpdateIdentityProviderSCIM).
  * @param request  the request parameters of CreateIdentityProviderSCIMCredential  CreateIdentityProviderSCIMCredentialRequest
  * @return CreateIdentityProviderSCIMCredentialResponse
 */
async function createIdentityProviderSCIMCredential(request: CreateIdentityProviderSCIMCredentialRequest): CreateIdentityProviderSCIMCredentialResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateIdentityProviderSCIMCredential', 'POST', '/workspaces/{workspaceId}/scim-provisioning/credentials', 'json', false, 'json', request);
}

