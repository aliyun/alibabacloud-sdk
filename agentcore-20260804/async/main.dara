type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'AgentCore';
  @version = '2026-08-04';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddMemoriesRequest {
  workspaceId: string(name='workspaceId', description='The ID of the AgentCore workspace.

This parameter is required.', example='ws-2f5f9c5a8d0e4c3b', position='Path'),
  memoryStoreName: string(name='memoryStoreName', description='The name of the MemoryStore.

This parameter is required.', example='customer-memory', position='Path'),
  body: {
    messages?: [ 
      {
        content: string(name='content', description='The content of the message.

This parameter is required.', example='The user likes hiking'),
        role: string(name='role', description='The role of the message.

This parameter is required.', example='user'),
      }
    ](name='messages', description='The list of messages. You must provide either this parameter or Text, but not both. The list must contain 1 to 20 messages, and the total size of the content must not exceed 32,000 UTF-8 bytes.'),
    metadata?: map[string]string(name='metadata', description='The string key-value metadata. You can specify up to 16 keys. The maximum length of a key is 64 characters, and the maximum length of a value is 1,024 characters.'),
    referenceTime?: string(name='referenceTime', description='The time reference point for the batch of messages or text. The value must be in RFC 3339 format with a time zone and support fractional seconds.', example='2023-05-08T13:56:00+08:00'),
    scope?: {
      agentId?: string(name='agentId', description='The ID of the agent. The length is limited to 1 to 128 UTF-8 bytes. The ID cannot contain a forward slash (/) or an asterisk (*).', example='agent-001'),
      sessionId?: string(name='sessionId', description='The ID of the session. The length is limited to 1 to 128 UTF-8 bytes. The ID cannot contain a forward slash (/) or an asterisk (*).', example='session-001'),
      userId?: string(name='userId', description='The ID of the user. The length is limited to 1 to 128 UTF-8 bytes. The ID cannot contain a forward slash (/) or an asterisk (*).', example='user-001'),
    }(name='scope', description='The scope of the write operation. UserId, AgentId, and SessionId are all optional.'),
    sync?: boolean(name='sync', description='Specifies whether to synchronously wait for memory extraction to complete. Default value: true.'),
    text?: string(name='text', description='The text to be written directly. You must provide either this parameter or Messages, but not both. The size of the text must not exceed 32,000 UTF-8 bytes.', example='The user likes hiking'),
  }(name='body', description='The request body for writing to memory.

This parameter is required.', shrink='json', position='Body'),
}

model AddMemoriesResponseBody = {
  code?: string(name='code', description='The business status code.', example='SUCCESS'),
  data?: {
    memories?: [ 
      {
        memoryId?: string(name='memoryId', description='The ID of the long-term memory.', example='mem-2f5f9c5a8d0e4c3b'),
