model CreateImageCacheResponseBody = {
  code: string(name='code', description='The business response code.

This parameter is required.', example='SUCCESS'),
  data: {
    acrInstanceId: string(name='acrInstanceId', description='The ID of the source ACR Enterprise instance.

This parameter is required.', example='cri-example'),
