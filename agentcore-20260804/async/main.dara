    modelIds: [ string ](name='modelIds', description='This parameter is required.'),
  }(name='body', shrink='json', position='Body'),
  clientToken?: string(name='clientToken', example='client-token-1', position='Query'),
}

model BatchDeleteModelsResponseBody = {
  code?: string(name='code', example='SUCCESS'),
  data?: {
    modelIds?: [ string ](name='modelIds'),
    workspaceId?: string(name='workspaceId', example='ws-1'),
  }(name='data'),
  httpStatusCode?: int32(name='httpStatusCode', example='200'),
  message?: string(name='message', example='success'),
  requestId?: string(name='requestId', example='request-1'),
  success?: boolean(name='success'),
}

model BatchDeleteModelsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BatchDeleteModelsResponseBody(name='body'),
}

/**
  * @param request  the request parameters of BatchDeleteModels  BatchDeleteModelsRequest
  * @return BatchDeleteModelsResponse
 */
async function batchDeleteModels(request: BatchDeleteModelsRequest): BatchDeleteModelsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'BatchDeleteModels', 'POST', '/workspaces/{workspaceId}/models/actions/batch-delete', 'json', true, 'form', request);
}

