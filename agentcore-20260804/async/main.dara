model PrepareIdentityProviderSCIMRequest {
  workspaceId: string(name='workspaceId', description='Required. The ID of the destination workspace. The region of the request must be the same as the region of the destination workspace.

This parameter is required.', example='ws-example', position='Path'),
}

model PrepareIdentityProviderSCIMResponseBody = {
  code?: string(name='code', description='The business result code. If the call fails, handle the error based on the HTTP status code and the message.', example='SUCCESS'),
  data?: {
    configuration?: {
      baseUrl?: string(name='baseUrl', description='The URL configured for the external provisioning system. The presence of a URL does not indicate that the external configuration is completed or AgentCore synchronization is enabled.', example='https://example.com/scim/v2'),
      status?: string(name='status', description='The receiving status of AgentIdentity. A value of Enabled indicates that SCIM receiving is enabled. A value of Disabled indicates that SCIM receiving is disabled. This status is not equivalent to the expected value of syncEnabled in AgentCore.', example='Enabled'),
    }(name='configuration', description='The actual SAML configuration is read on demand only by calling GetIdentityProvider. SCIM query and preparation operations return the actual receiving status and URL.'),
    credential?: {
      createTime?: string(name='createTime', description='The creation time returned by AgentIdentity.', example='2026-10-26T00:00:00Z'),
      credentialId?: string(name='credentialId', description='The credential ID. This parameter is required when you delete a credential. Use the ID returned in the credential list, not the plaintext of the token.', example='credential-example'),
      expireTime?: string(name='expireTime', description='The expiration time returned by AgentIdentity. Only credentials with the status of Enabled that have not expired are considered available.', example='2027-10-26T00:00:00Z'),
      status?: string(name='status', description='The credential status of AgentIdentity. Only credentials with the status of Enabled that have not expired are considered available. This field is not the operationStatus of the SCIM task.', example='Enabled'),
    }(name='credential', description='The current credential summary, including credentialId, status, createTime, and expireTime. The token is not included because it cannot be repeatedly obtained.'),
    token?: string(name='token', description='The plaintext of the newly issued SCIM token. The plaintext is returned only in the current response. If an existing valid credential is reused, an empty string ("") is returned. In this case, use the saved token.', example='example-scim-token'),
  }(name='data', description='The operation result. For the result structure, see the response fields of this operation. The response of an asynchronous write operation indicates that the request is accepted, but does not guarantee that the background task is completed.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The processing status of the current request. This status does not indicate the final result of the background task.', example='200'),
  message?: string(name='message', description='The request acceptance or error message. For asynchronous tasks, you must check the task result by calling the corresponding query operation.', example='success'),
  requestId?: string(name='requestId', description='The request ID. You can use this ID to associate the current call with troubleshooting. Keep the ID if the call fails.', example='request-example'),
  success?: boolean(name='success', description='Indicates whether the current request is successful. A value of true indicates that the request is processed successfully. For asynchronous write operations, you must continue to query the task result.'),
}

model PrepareIdentityProviderSCIMResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: PrepareIdentityProviderSCIMResponseBody(name='body'),
}

/**
  * @description Prepares the receiving endpoint and access token for integrating an enterprise identity system with SCIM user synchronization. The enterprise identity system uses this information to provision users to the shared user pool of AgentCore.
  * SCIM is a user provisioning protocol. The enterprise identity system first sends users to the receiving endpoint, and then AgentCore synchronizes the users from the user pool to the workspace.
  * ### Before you begin
  * A `CustomSSO` binding has been created by using [CreateIdentityProvider](https://api.aliyun.com/document/AgentCore/2026-08-04/CreateIdentityProvider), and the shared user pool is ready. SCIM integration can be performed independently of SAML logon configuration.
  * ### What this operation prepares
  * This operation enables the SCIM receiving endpoint and returns the receiving URL and credential summary:
  * | Current credential status | Returned result |
  * | --- | --- |
  * | An unexpired credential with the status of `Enabled` already exists | Reuses the existing credential. The `token` field returns an empty string `""`. Use the previously saved token. |
  * | No available credentials exist | Creates a new credential. The `token` field returns the plaintext of the new token, which is returned only in this response. |
  * The plaintext of an existing token cannot be queried again. If the token is lost, you can create a new token by calling [CreateIdentityProviderSCIMCredential](https://api.aliyun.com/document/AgentCore/2026-08-04/CreateIdentityProviderSCIMCredential). A maximum of two credentials can be retained for the same user pool. When the limit is reached, you must delete unused credentials first.
  * ### Subsequent configuration
  * 1. Configure the returned receiving URL and valid token in the SCIM user provisioning settings of the enterprise identity system.
  * 2. Complete the connection test and user assignment in the enterprise identity system.
  * 3. Enable AgentCore user synchronization by calling [UpdateIdentityProviderSCIM](https://api.aliyun.com/document/AgentCore/2026-08-04/UpdateIdentityProviderSCIM), and then query the synchronization result by calling [GetIdentityProviderSCIM](https://api.aliyun.com/document/AgentCore/2026-08-04/GetIdentityProviderSCIM).
  * @param request  the request parameters of PrepareIdentityProviderSCIM  PrepareIdentityProviderSCIMRequest
  * @return PrepareIdentityProviderSCIMResponse
 */
async function prepareIdentityProviderSCIM(request: PrepareIdentityProviderSCIMRequest): PrepareIdentityProviderSCIMResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'PrepareIdentityProviderSCIM', 'POST', '/workspaces/{workspaceId}/scim-provisioning/prepare', 'json', false, 'json', request);
}

