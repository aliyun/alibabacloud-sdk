  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='ws-123456', position='Path'),
  pluginName: string(name='pluginName', description='The identifier of the workspace component. The value collaboration corresponds to the collaboration component in the console. For other component identifiers, use the original values defined in the API parameter enumeration.

This parameter is required.', example='collaboration', position='Path'),
  body?: {
