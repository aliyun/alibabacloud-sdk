        appKey?: string(name='appKey', description='The AppKey of the DingTalk application. Required when the binding type is DingTalk.', example='dingexampleappkey01'),
        binding?: string(name='binding', description='The SAML binding URI in the historical metadata snapshot. Use saml.bindingType for CustomSSO updates.', example='urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect'),
        certificates?: string(name='certificates', description='The certificate string in the historical metadata snapshot. Use saml.x509Certificates to edit the configuration. Do not submit the old metadata.', example=''),
        corpId?: string(name='corpId', description='The CorpId of the DingTalk enterprise. Required when the binding type is DingTalk.', example='dingexamplecorpid01'),
        entityId?: string(name='entityId', description='Required for manual entry. Must be non-empty and up to 2048 characters. Existing configurations cannot be changed. This is different from the local entity ID returned by SP queries.', example='https://idp.example.com/entity'),
        loginUrl?: string(name='loginUrl', description='Required for manual entry. Must be an absolute HTTPS URL without user credentials or fragments.', example='https://idp.example.com/sso'),
      }(name='metadata', description='The application configuration of the external identity provider. Application secret configurations are not returned.'),
