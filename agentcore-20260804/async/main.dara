    }(name='model', description='The model configuration. Available only when modelSource is set to PLATFORM.'),
    modelSource?: string(name='modelSource', description='The source of the model configuration. PLATFORM indicates that the platform parses and delivers the model configuration. RUNTIME indicates that the external runtime manages the model independently, and the model parameter cannot be passed at the same time. Valid values:
- PLATFORM: Platform model.
- RUNTIME: Runtime model.', example='PLATFORM'),
    name?: string(name='name', description='The name of the external agent.', example='my-external-agent'),
    skills?: [ 
      {
        name: string(name='name', description='The skill name.

This parameter is required.', example='code-analysis'),
        sourceType?: string(name='sourceType', description='The source type of the skill. Valid values:
- REFERENCE: References the AI Registry.
- STATIC: Statically provided with the package.', example='REFERENCE'),
        version?: string(name='version', description='The skill version.', example='1.0.0'),
        versionSelector?: {
          type?: string(name='type', description='The type of the version selector. Valid values:
- LABEL: By label.
- VERSION: By specific version.', example='LABEL'),
          value?: string(name='value', description='The value of the selector. When the type is LABEL, this is the label name, such as latest. When the type is VERSION, this is the specific version number.', example='latest'),
        }(name='versionSelector', description='The referenced version selector. If omitted, the default is LABEL/latest. Currently, only LABEL/latest is supported.'),
      }
    ](name='skills', description='The list of skill configurations.'),
    template?: {
      aiRegistry?: {
        name: string(name='name', description='The name of the template in the AI Registry.

This parameter is required.', example='code-review-template'),
        version: string(name='version', description='The version of the template in the AI Registry.

This parameter is required.', example='1.0.0'),
      }(name='aiRegistry', description='The AI Registry template configuration.'),
    }(name='template', description='The agent template configuration.'),
    tools?: [ 
      {
        name: string(name='name', description='The tool name.

This parameter is required.', example='code-reviewer'),
        type: string(name='type', description='The tool type. Valid values:
- MCP: MCP tool.

This parameter is required.', example='MCP'),
      }
    ](name='tools', description='The list of tool configurations.'),
  }(name='body', description='The request body.', shrink='json', position='Body'),
  clientToken?: string(name='clientToken', description='The reserved idempotency token. The backend does not provide idempotency guarantees in the current phase.', example='client-token-1', position='Query'),
