model FindCustomAgentImagePreparationRequest {
  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='ws-example', position='Path'),
  clientToken: string(name='clientToken', description='The idempotency token passed as a query parameter. This parameter is required when you explicitly submit customImage or container.type=custom, and optional for ACR image and code package submissions. The value must be 1 to 128 characters in length and can contain letters, digits, periods, underscores, colons, and hyphens. Reuse the same token for retries of the same submission. If the same token is used for different parameters, the request will be rejected.

This parameter is required.', example='image-update-20261022-001', position='Query'),
}

model FindCustomAgentImagePreparationResponseBody = {
  code?: string(name='code', description='The business status code.', example='SUCCESS'),
  data?: {
    agentId?: string(name='agentId', description='The ID of the target agent.', example='agent-example'),
    error?: {
      code?: string(name='code', description='The business error code for image preparation. Used to identify the failure type. For the specific cause, see message.', example='ImageSyncFailed'),
      message?: string(name='message', description='The specific cause of the failure, which may include underlying errors such as image not found, authentication failure, network timeout, or certificate verification error. Passwords, tokens, or authentication headers are not returned. If the underlying system does not provide a specific cause, a general description is returned.', example='tls: failed to verify certificate: x509: certificate signed by unknown authority'),
    }(name='error', description='The error information. Returned only when the operation fails. Otherwise, null is returned.'),
    failedPhase?: string(name='failedPhase', description='The phase where the failure occurred. Returned only when the status is FAILED. Otherwise, null is returned.', example='COPYING'),
    phase?: string(name='phase', description='The current phase. Only SUCCEEDED indicates that the target version deployment succeeded.', example='FAILED'),
    preparationId?: string(name='preparationId', description='The ID of the preparation task submitted from the console.', example='agent-example:1'),
  }(name='data', description='The preparation query result. For the asynchronous execution status, see phase.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='message', description='The response message.', example='success'),
  requestId?: string(name='requestId', description='The request ID.', example='123e4567-e89b-12d3-a456-426614174000'),
  success?: boolean(name='success', description='Indicates whether the API call is successful.', example='true'),
}

model FindCustomAgentImagePreparationResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: FindCustomAgentImagePreparationResponseBody(name='body'),
}

/**
  * @description Uses the `clientToken` of a create or update request to retrieve a custom image preparation task, which allows you to continue querying the processing progress after a request response is lost.
  * ### Search scope
  * Pass the `clientToken` used when submitting [CreateCustomAgent](https://api.aliyun.com/document/AgentCore/2026-08-04/CreateCustomAgent) or [UpdateCustomAgent](https://api.aliyun.com/document/AgentCore/2026-08-04/UpdateCustomAgent) as a query parameter, and use the original workspace.
  * The preparation task can be retrieved only if the submission result includes `imagePreparation`. If no corresponding preparation task exists, a resource not found error is returned.
  * ### Query phases
  * | `phase` | Description |
  * | --- | --- |
  * | `QUEUED`, `CHECKING` | Queued or checking the source. |
  * | `COPYING` | Copying the image. |
  * | `STARTING` | Starting the target version. |
  * | `HEALTH_CHECKING` | Waiting for the target version instance to be ready. |
  * | `SUCCEEDED` | The target version deployment succeeded. |
  * | `FAILED` | The preparation or deployment failed. Check `failedPhase` and `error`. |
  * | `CANCELLED` | The target version has been replaced by a subsequent configuration or canceled. |
  * After the task is found, you can use the `preparationId` to call [GetCustomAgentImagePreparation](https://api.aliyun.com/document/AgentCore/2026-08-04/GetCustomAgentImagePreparation) to continuously query the progress.
  * @param request  the request parameters of FindCustomAgentImagePreparation  FindCustomAgentImagePreparationRequest
  * @return FindCustomAgentImagePreparationResponse
 */
async function findCustomAgentImagePreparation(request: FindCustomAgentImagePreparationRequest): FindCustomAgentImagePreparationResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'FindCustomAgentImagePreparation', 'GET', '/workspaces/{workspaceId}/custom-image-preparations', 'json', false, 'json', request);
}

