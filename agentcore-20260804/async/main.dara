    loginEnabled?: boolean(name='loginEnabled', description='The currently saved expected value of the logon switch, which alone does not prove that the upstream logon configuration has taken effect.'),
    protocol?: string(name='protocol', description='The currently saved logon protocol for CustomSSO, which is SAML when configured. This field is not returned for DingTalk or Lark.', example='SAML'),
    saml?: {
      bindingType?: string(name='bindingType', description='The saved SAML binding type, which is HTTP-Redirect or HTTP-POST.', example='HTTP-Redirect'),
      entityId?: string(name='entityId', description='The saved enterprise IdP entity ID, which is different from the entity ID of the service provider (SP).', example='https://idp.example.com/entity'),
      loginUrl?: string(name='loginUrl', description='The saved enterprise IdP SSO logon URL.', example='https://idp.example.com/sso'),
      x509Certificates?: [ string ](name='x509Certificates', description='The list of saved enterprise IdP X.509 signing certificates.', example='["-----BEGIN CERTIFICATE-----\\\\\\\\nMIICwDCCAaigAwIBAgIULlsHLfcADyBax5ZtFlj+YGzZVo0wDQYJKoZIhvcNAQEL\\\\\\\\nBQAwGjEYMBYGA1UEAwwPaWRwLmV4YW1wbGUuY29tMB4XDTI2MDEwMTAwMDAwMFoX\\\\\\\\nDTM2MDEwMTAwMDAwMFowGjEYMBYGA1UEAwwPaWRwLmV4YW1wbGUuY29tMIIBIjAN\\\\\\\\nBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAto0DN0W1CrPRzK9QZ9A1aApb4Lg8\\\\\\\\noGlp2c0PbN3LokXe/HzwxCMXx65IDnrenttxzTwp9BgUnUN/3LRzWaOL2UQ/vNYN\\\\\\\\nW9LFLkI1T64UPyI7eyi28YlALhb41xkYhEp7rz+MjqifBzVZeTDUxBYtbK2hAhbY\\\\\\\\nEL1+udwsXEx0KB7xuQ/rbI2OKeqAEAD1tfYg7T/SM2wrXNYhx+o1HtchM4/0I8Ok\\\\\\\\nkk27JQ4y3ofzC5sTySmFF1Y7XcpSd+5WSyazedhkAieo8AB01DkJV6nnKfH8sH0E\\\\\\\\nBsnH3FP8FhqCLrIeEkjX9B9OcIRLGjiZqx4u/ryW1QhMldnv+pFfNjWy/wIDAQAB\\\\\\\\nMA0GCSqGSIb3DQEBCwUAA4IBAQC1hSQG8AwtGOoX2gKBK4Hi5XBrBreij8WlLTUW\\\\\\\\nld0FINQ0Rg84f/27CjDthywj6wgxCesCuOVFhpxQa1UacsP/Gcai1aKABtLWImca\\\\\\\\nWECRYK5gDkwhTMFKM9mXA26hH1l4v/UR2iTpEK9H78egC4W7bs2LDTpPryuaNKTq\\\\\\\\nP2O0tMbNkAHB8yecz5LxHXnxadL9Egow25g2RClvpifWqDnuS9TSbKkIWLcPLjoc\\\\\\\\nJj2K9ILpBwhXiXi/BiSgyYTLiYvVvih9vX4s+hKGZNJc0j92YLiOHDF0XH1oxgdV\\\\\\\\njfTmRiedeb2VZJZElptD92z0AqFR7z2d5B+OqpPA2gjuMLV5\\\\\\\\n-----END CERTIFICATE-----"]'),
    }(name='saml', description='The saved standardized SAML configuration for CustomSSO. The original metadata XML is not echoed. This field is not returned if no valid configuration is saved or if the identity provider is DingTalk or Lark. This value is the locally saved configuration and is not equivalent to the actual upstream configuration.'),
    status?: string(name='status', description='The status of the identity provider resource and logon configuration. Valid values:
- CONFIGURED: The configuration is accepted.
- UPDATING: The configuration is being updated.
- SYNCING: Synchronization is in progress.
- SYNCED: The synchronization phase is completed.
- READY: The resource is ready.
- SYNC_FAILED: Synchronization failed.
- UPDATE_FAILED: The update failed.
- DISCONNECTING: Unbinding is in progress.
- DISCONNECT_FAILED: Unbinding failed.
READY alone does not indicate that users have been imported. Query the SCIM operation results for CustomSSO separately.', example='READY'),
    syncEnabled?: boolean(name='syncEnabled', description='The currently saved expected value of the synchronization switch. For DingTalk and Lark, it is used for subsequent address book change events. The SCIM switch for CustomSSO is managed through UpdateIdentityProviderSCIM, and the operation results are queried through GetIdentityProviderSCIM.'),
    syncScope?: {
      departmentIds?: [ string ](name='departmentIds', description='The list of department IDs in the synchronization scope, obtained from ListIdentityProviderDepartments. In SelectedDepartments mode, at least one non-empty department ID must be provided. In AllAuthorized mode, this parameter should be omitted or an empty array should be passed.', example='["10001"]'),
      mode?: string(name='mode', description='The synchronization scope mode. AllAuthorized: all members within the authorization scope of the application address book. SelectedDepartments: the selected departments and all their sub-departments. A valid mode must be provided when syncScope is explicitly submitted.', example='SelectedDepartments'),
    }(name='syncScope', description='The saved synchronization scope for DingTalk and Lark. The default value for valid historical configurations is AllAuthorized, and this field may not be returned for corrupted historical configurations. This field is not returned for CustomSSO.'),
    workspaceId?: string(name='workspaceId', description='The ID of the workspace to which the identity provider belongs.', example='ws-123456'),
  }(name='data', description='The currently saved identity provider binding information, including the expected configuration and resource status. The actual update may still be executing in the background.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code of the API request, which does not represent the execution result of the background task.', example='200'),
  message?: string(name='message', description='The response message of the API request. An error description is returned if the request fails.', example='success'),
  requestId?: string(name='requestId', description='The unique identifier of the request. Provide this value when you troubleshoot issues.', example='request-123456'),
  success?: boolean(name='success', description='Indicates whether the API request is successful. To check whether the background configuration has taken effect, query the identity provider status separately.'),
}

model UpdateIdentityProviderResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateIdentityProviderResponseBody(name='body'),
}

/**
  * @description ### Prerequisites and update methods
  * The workspace must be bound to an identity provider of the corresponding type. For DingTalk and Lark, you must submit at least one of loginEnabled, syncEnabled, metadata, and syncScope. protocol and saml are not accepted. For CustomSSO, use protocol, saml, and loginEnabled. metadata, syncEnabled, and syncScope are not accepted. The SCIM synchronization switch is managed separately through UpdateIdentityProviderSCIM.
  * ### DingTalk and Lark
  * The metadata is merged by field. Submit only the fields that need to be updated. Omitted fields and existing keys remain unchanged. Explicitly submitting null, empty strings, or blank strings will be rejected. The server validates the complete configuration after merging. When incremental synchronization is enabled, the merged configuration must include encryptKey and verificationToken.
  * syncEnabled controls subsequent address book change events and does not control the initial synchronization or manual synchronization. syncScope applies only to DingTalk and Lark. If it is omitted or set to null, the current scope is retained. Saving the scope does not automatically trigger a full synchronization. To perform manual synchronization, call CreateIdentityProviderSyncJob after saving and waiting for the identity provider to be ready, and then call GetIdentityProviderSyncJob to query the task result.
  * ### Custom SAML identity provider
  * CustomSSO currently supports only SAML. The saml parameter supports two mutually exclusive methods: providing metadataXml, or providing the four manual configuration fields: entityId, loginUrl, bindingType, and x509Certificates.
  * metadataXml is a single IdP EntityDescriptor XML text of up to 1 MiB, not a URL or file path. DTDs and external entities are prohibited. For manual configuration, entityId must be non-empty and up to 2,048 characters, and cannot be changed after saving. loginUrl must be an absolute HTTPS URL without user credentials and fragments. bindingType must be HTTP-Redirect or HTTP-POST. Certificates must be valid X.509 signing certificates, with a maximum of 10 certificates.
  * jitProvisionEnabled controls the automatic creation of users during the initial logon, and jitUpdateEnabled controls whether user information is updated during logon. Omitting these switches during an update retains the existing values. Modifying only the JIT switches also requires an existing valid SAML configuration. Saving the SAML configuration does not automatically enable logon. A valid configuration must exist before enabling logon. Setting loginEnabled to false only triggers a shutdown of logon and does not delete the saved SAML or SCIM configurations.
  * ### Asynchronous results and retries
  * When actual changes exist, the expected configuration and the UPDATING status of the identity provider are returned. The CONFIGURED status may also be returned when resource configurations are restored. Call GetIdentityProvider to wait for the READY status. If the operation fails, check for statuses such as UPDATE_FAILED. If the configuration is identical and no restoration is required, the current binding may be returned directly without generating a new task. A successful HTTP request does not indicate that the background task or upstream configuration has taken effect.
  * Operation conflicts occur when in-flight operations exist. If a submission times out, query the configuration and status before deciding whether to retry. The status parameter describes the status of the identity provider resource and logon configuration. The SCIM operation results for CustomSSO must be queried through GetIdentityProviderSCIM and cannot be inferred from this operation.
  * @param request  the request parameters of UpdateIdentityProvider  UpdateIdentityProviderRequest
  * @return UpdateIdentityProviderResponse
 */
async function updateIdentityProvider(request: UpdateIdentityProviderRequest): UpdateIdentityProviderResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'UpdateIdentityProvider', 'PUT', '/workspaces/{workspaceId}/identity-providers/{identityProviderType}', 'json', true, 'form', request);
}

