    accessScope?: string(name='accessScope', description='The user access scope.', example='ALL'),
    agenticFsMounts?: [ 
      {
        mountPath?: string(name='mountPath', description='The absolute mount path in the container, such as /data/train. Mount targets cannot be duplicated or form parent-child directory overwrites, and must avoid platform-reserved directories.', example='/mnt/agenticfs/data'),
        path?: string(name='path', description='The existing non-empty relative directory in the access point. This parameter is required and verified by the backend for each mount item. Root directories, absolute paths, and parent directory segments are not allowed.', example='workspace/data'),
        readOnly?: boolean(name='readOnly', description='Specifies whether the mount is read-only. If this parameter is omitted, the default value is false. This parameter does not represent a RAM role read-only policy.', example='false'),
