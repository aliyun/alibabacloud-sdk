      streamToolCall?: boolean(name='streamToolCall', description='Specifies whether the model supports streaming tool invocation. A value of true indicates that it is supported. A value of false indicates that it is not supported.'),
      toolCall?: boolean(name='toolCall', description='Specifies whether the model supports tool invocation. A value of true indicates that it is supported. A value of false indicates that it is not supported.'),
      video?: boolean(name='video', description='Specifies whether the model supports video input. A value of true indicates that it is supported. A value of false indicates that it is not supported.'),
