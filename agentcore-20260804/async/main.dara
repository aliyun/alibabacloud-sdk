model InstallWorkspacePluginRequest {
  workspaceId: string(name='workspaceId', description='This parameter is required.', example='ws-123456', position='Path'),
  pluginName: string(name='pluginName', description='This parameter is required.', example='collaboration', position='Path'),
  body?: {
    config?: {
      network?: {
        internet?: {
          enabled?: boolean(name='enabled', description='设置为 true 且未指定 VPC 时使用 PUB_NET；设置为 true 且指定 VPC 时使用 PRIVATE_PUBNET；仅指定 VPC 时使用 PRIVATE_NET。公网和 VPC 至少配置一种。', example='true'),
        }(name='internet', description='控制协作组件是否允许访问公网。该配置只控制公网访问能力，不表示将组件服务暴露到公网。'),
        vpc?: {
          enabled?: boolean(name='enabled', description='显式控制 collaboration 插件是否使用 VPC 网络。设置为 false 时，VpcId 和 VSwitchIds 将被忽略；设置为 true 时必须同时提供 VpcId 和至少两个 VSwitchIds。', example='true'),
          vSwitchIds: [ string ](name='vSwitchIds', description='交换机 ID 列表。collaboration 插件要求交换机至少覆盖两个不同可用区，且所有交换机必须属于 VpcId 指定的 VPC。

This parameter is required.'),
          vpcId: string(name='vpcId', description='This parameter is required.', example='vpc-bp1234567890'),
        }(name='vpc', description='协作插件部署使用的用户 VPC 和交换机列表。交换机对应的可用区由服务端查询，不需要用户传入 Zones。'),
      }(name='network', description='collaboration 插件使用的网络配置。未指定时，服务端使用工作空间已有的网络配置。'),
    }(name='config', description='插件专属配置。配置结构由 PluginName 决定。当前 collaboration 插件支持 Network。'),
  }(name='body', shrink='json', position='Body'),
  clientToken?: string(name='clientToken', example='workspace-plugin-install-20260810-001', position='Query'),
}

