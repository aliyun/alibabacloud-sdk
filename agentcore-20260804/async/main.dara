This parameter is required.', example='ws-example', position='Path'),
  body: {
    syncEnabled: boolean(name='syncEnabled', description='Do not set this parameter to true during CustomSSO initialization. You can only update it later by calling UpdateIdentityProviderSCIM. Determine the result based on operationStatus.

This parameter is required.'),
  }(name='body', description='Submits business parameters as described in this API. The body parameters of the public API are mapped to the backend wrapper by the gateway. Do not mix them with the backend direct connection body wrapper.

This parameter is required.', shrink='json', position='Body'),
}

