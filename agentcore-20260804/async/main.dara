    metadata?: {
      binding?: string(name='binding', description='The SAML binding URI in the historical metadata snapshot. For CustomSSO updates, use the saml.bindingType field.', example='urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect'),
