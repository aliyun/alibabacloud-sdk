    status?: string(name='status', example='ENABLING'),
    workspaceId?: string(name='workspaceId', example='ws-123456'),
  }(name='data'),
  httpStatusCode?: int32(name='httpStatusCode', example='200'),
  message?: string(name='message', example='success'),
  requestId?: string(name='requestId', example='request-123456'),
  success?: boolean(name='success', example='true'),
}

model InstallWorkspacePluginResponse = {
