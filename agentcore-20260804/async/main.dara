model GetCustomAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetCustomAgentResponseBody(name='body'),
}

/**
  * @description After creating or updating a custom agent, you can poll this operation to query the execution result of the latest configuration version. latestVersionStatus corresponds to latestSpecVersion. latestExecutionError indicates the cause of the pending or failed status for this version. If retryable is true, you can query again later.
  * The returned configuration is the latest submitted configuration and may not have taken effect. Verify the deployment and running status by checking latestVersionStatus, the overall agent status, and the running instance statistics sandboxPhaseCounts.
  * If the queried custom agent does not exist, has been deleted, or does not belong to the specified workspace, a resource not found error is returned.
  * @param request  the request parameters of GetCustomAgent  GetCustomAgentRequest
  * @return GetCustomAgentResponse
 */
async function getCustomAgent(request: GetCustomAgentRequest): GetCustomAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetCustomAgent', 'GET', '/workspaces/{workspaceId}/custom-agents/{agentId}', 'json', false, 'json', request);
}

