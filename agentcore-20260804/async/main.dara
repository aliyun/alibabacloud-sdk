model ConvertMcpToFreeEditResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ConvertMcpToFreeEditResponseBody(name='body'),
}

/**
  * @description Converts an MCP server installed from a marketplace template to free-edit mode so that you can directly modify the server configuration. After the conversion, the original source and tag information is retained, and the template editing restrictions are removed. The server no longer appears on the use case page associated with the template.
  * @param request  the request parameters of ConvertMcpToFreeEdit  ConvertMcpToFreeEditRequest
  * @return ConvertMcpToFreeEditResponse
 */
async function convertMcpToFreeEdit(request: ConvertMcpToFreeEditRequest): ConvertMcpToFreeEditResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ConvertMcpToFreeEdit', 'POST', '/workspaces/{workspaceId}/mcp-servers/{mcpServerId}/convert-to-free-edit', 'json', false, 'json', request);
}

