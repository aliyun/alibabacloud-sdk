model CreateAgentIMChannelRequest {
  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='ws-1', position='Path'),
  agentId: string(name='agentId', description='The agent ID.

This parameter is required.', example='agent-1', position='Path'),
  body?: {
    channelConfig?: {
      showThinking?: boolean(name='showThinking', description='Specifies whether to display the thinking process in IM messages. Default value: false.'),
      showToolCalls?: boolean(name='showToolCalls', description='Specifies whether to display the tool calling process in IM messages. Default value: false.'),
    }(name='channelConfig', description='The channel behavior configuration.'),
