      x509Certificates?: [ string ](name='x509Certificates', description='A non-empty array is required for manual entry. Use PEM X.509 certificate text. The current validity period is verified. A maximum of two certificates are allowed after deduplication.', example='["-----BEGIN CERTIFICATE-----\\\\\\\\nMIICwDCCAaigAwIBAgIULlsHLfcADyBax5ZtFlj+YGzZVo0wDQYJKoZIhvcNAQEL\\\\\\\\nBQAwGjEYMBYGA1UEAwwPaWRwLmV4YW1wbGUuY29tMB4XDTI2MDEwMTAwMDAwMFoX\\\\\\\\nDTM2MDEwMTAwMDAwMFowGjEYMBYGA1UEAwwPaWRwLmV4YW1wbGUuY29tMIIBIjAN\\\\\\\\nBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAto0DN0W1CrPRzK9QZ9A1aApb4Lg8\\\\\\\\noGlp2c0PbN3LokXe/HzwxCMXx65IDnrenttxzTwp9BgUnUN/3LRzWaOL2UQ/vNYN\\\\\\\\nW9LFLkI1T64UPyI7eyi28YlALhb41xkYhEp7rz+MjqifBzVZeTDUxBYtbK2hAhbY\\\\\\\\nEL1+udwsXEx0KB7xuQ/rbI2OKeqAEAD1tfYg7T/SM2wrXNYhx+o1HtchM4/0I8Ok\\\\\\\\nkk27JQ4y3ofzC5sTySmFF1Y7XcpSd+5WSyazedhkAieo8AB01DkJV6nnKfH8sH0E\\\\\\\\nBsnH3FP8FhqCLrIeEkjX9B9OcIRLGjiZqx4u/ryW1QhMldnv+pFfNjWy/wIDAQAB\\\\\\\\nMA0GCSqGSIb3DQEBCwUAA4IBAQC1hSQG8AwtGOoX2gKBK4Hi5XBrBreij8WlLTUW\\\\\\\\nld0FINQ0Rg84f/27CjDthywj6wgxCesCuOVFhpxQa1UacsP/Gcai1aKABtLWImca\\\\\\\\nWECRYK5gDkwhTMFKM9mXA26hH1l4v/UR2iTpEK9H78egC4W7bs2LDTpPryuaNKTq\\\\\\\\nP2O0tMbNkAHB8yecz5LxHXnxadL9Egow25g2RClvpifWqDnuS9TSbKkIWLcPLjoc\\\\\\\\nJj2K9ILpBwhXiXi/BiSgyYTLiYvVvih9vX4s+hKGZNJc0j92YLiOHDF0XH1oxgdV\\\\\\\\njfTmRiedeb2VZJZElptD92z0AqFR7z2d5B+OqpPA2gjuMLV5\\\\\\\\n-----END CERTIFICATE-----"]'),
    }(name='saml', description='The input supports either XML or complete manual entry. Queries return the standardized configuration and do not echo the original XML. This parameter can be omitted if it is not configured.'),
    status?: string(name='status', description='The status. Valid values:
- CONFIGURED: The configuration is accepted and waiting for user pool activation.
- SYNCING: Organization members are being synchronized.
- SYNCED: Organization member synchronization is complete.
- READY: The binding is in effect.
- SYNC_FAILED: Organization member synchronization failed.
- UPDATING: The configuration is being updated.
- UPDATE_FAILED: Configuration update failed.
- DISCONNECTING: The binding is being disconnected.
- DISCONNECT_FAILED: Disconnection failed.', example='READY'),
    syncEnabled?: boolean(name='syncEnabled', description='Specifies whether to enable organization member synchronization. If enabled, organization members are synchronized as workspace users by the external identity provider.'),
    syncScope?: {
      departmentIds?: [ string ](name='departmentIds', description='When the mode is SelectedDepartments, this parameter must contain at least one non-empty department ID, which should be obtained from ListIdentityProviderDepartments. When the mode is AllAuthorized, pass an empty array or omit this parameter.', example='["10001"]'),
      mode?: string(name='mode', description='Valid values:
- AllAuthorized: All authorized scopes, subject to the application address book authorization limits.
- SelectedDepartments: The selected departments and all their sub-departments.
When explicitly submitting syncScope, you must provide a valid mode, which is verified by the backend.', example='SelectedDepartments'),
    }(name='syncScope', description='Follows the synchronization scope definition by department. If omitted during creation, the default value is AllAuthorized, and the first vendor synchronization is determined by syncOnBind. If omitted or set to null during an update, the original value is retained. Updating the saved scope does not automatically trigger full synchronization.'),
    updatedAt?: string(name='updatedAt', description='The time when the binding was last modified, in RFC 3339 UTC format.', example='2026-08-12T03:04:05Z'),
    workspaceId?: string(name='workspaceId', description='The workspace ID.', example='ws-123456'),
  }(name='data', description='The binding details of the external identity provider.'),
