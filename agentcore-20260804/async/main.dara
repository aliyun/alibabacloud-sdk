    bucketName?: string(name='bucketName', description='The name of the private OSS bucket.', example='bucket-001'),
    name?: string(name='name', description='The name of the workspace.', example='production-agents-v2'),
    networkConfiguration?: {
      publicEgressEnabled?: boolean(name='publicEgressEnabled', description='Returns the target configuration value. Updating indicates that the change is still in progress, and UpdateFailed indicates that the current change failed. This parameter only controls whether the latest versions of managed and custom agents use the public network egress of the platform. It does not control fixed historical versions, model or MCP proxy egresses, or the public network egress of the user VPC.', example='true'),
      publicIngressEnabled?: boolean(name='publicIngressEnabled', description='Returns the target configuration value. Updating indicates that the change is in progress, and UpdateFailed indicates that the change failed. When disabled, the public network ingress for all agent endpoints in the workspace is closed, and the original public network ingress is restored when re-enabled. INNER_DIRECT and user VPC ingress are not affected, and collaboration and Element Web ingress are not controlled by this parameter.', example='true'),
      vpc?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable VPC networking.', example='true'),
        vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitch IDs.'),
        vpcId?: string(name='vpcId', description='The ID of the user VPC.', example='vpc-bp1234567890'),
      }(name='vpc', description='The VPC network configuration of the user.'),
    }(name='networkConfiguration', description='The network configuration of the workspace.'),
    regionId?: string(name='regionId', description='The region ID of the workspace.', example='cn-hangzhou'),
