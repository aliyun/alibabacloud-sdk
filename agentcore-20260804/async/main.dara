model DebugModelRequest {
  workspaceId: string(name='workspaceId', description='This parameter is required.', example='ws-1', position='Path'),
  modelId: string(name='modelId', description='This parameter is required.', example='model-1', position='Path'),
  body?: {
    prompt: string(name='prompt', description='This parameter is required.', example='hello'),
  }(name='body', shrink='json', position='Body'),
}

model DebugModelResponseBody = {
  code?: string(name='code', example='SUCCESS'),
  data?: {
    connectionId?: string(name='connectionId', example='mc-1'),
    debugSuccess?: boolean(name='debugSuccess'),
    errorCode?: string(name='errorCode', description='调试失败时的错误码。取值：MODEL_CONNECTION_NOT_READY（模型连接尚未发布就绪）、MODEL_CONNECTION_TEST_FAILED（平台调用网关失败）、UPSTREAM_MODEL_NOT_FOUND（模型服务商侧不存在该模型）、UPSTREAM_UNAUTHORIZED（模型服务商拒绝所配置的凭证）、UPSTREAM_RATE_LIMITED（模型服务商限流）、UPSTREAM_SERVER_ERROR（模型服务商服务端错误）、UPSTREAM_HTTP_ERROR（模型服务商返回其它非成功状态）、UPSTREAM_EMPTY_RESPONSE（模型服务商返回空响应）、UPSTREAM_INVALID_RESPONSE（模型服务商响应格式非法）、UPSTREAM_MODEL_ERROR（模型服务商拒绝本次请求）、MODEL_RESPONSE_INVALID（响应解析失败）。', example='UPSTREAM_MODEL_ERROR'),
    errorMessage?: string(name='errorMessage', description='调试失败时的错误描述，为固定脱敏文案，不透传模型服务商的原始错误详情。', example='The model endpoint rejected the debug request.'),
    inputTokens?: long(name='inputTokens', example='3'),
    latencyMs?: long(name='latencyMs', example='12'),
    modelId?: string(name='modelId', example='model-1'),
    outputTokens?: long(name='outputTokens', example='2'),
    response?: string(name='response', example='ok'),
    status?: string(name='status', description='调试结果状态。取值：NORMAL（正常）、ABNORMAL（异常）。', example='NORMAL'),
  }(name='data'),
  httpStatusCode?: int32(name='httpStatusCode', example='200'),
  message?: string(name='message', example='success'),
  requestId?: string(name='requestId', example='request-1'),
  success?: boolean(name='success'),
}

