  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='ws-1', position='Path'),
  agentId: string(name='agentId', description='The ID of the managed Harness agent.

This parameter is required.', example='agent-1', position='Path'),
  body?: {
    accessMode?: string(name='accessMode', description='The inbound access mode.', example='API_KEY'),
    accessScope?: string(name='accessScope', description='The user access scope.', example='ALL'),
    agenticFsMounts?: [ 
      {
        mountPath?: string(name='mountPath', description='The absolute mount path in the container, such as /data/train. Mount targets cannot be duplicated or form parent-child overwrites, and must avoid platform reserved directories.', example='/mnt/agenticfs/data'),
        path?: string(name='path', description='The existing non-empty relative directory under the AccessPoint. This field is required and validated by the backend for each mount item. Root directories, absolute paths, and parent directory segments are not allowed.', example='workspace/data'),
        readOnly?: boolean(name='readOnly', description='Specifies whether the mount is read-only. If omitted, the default value is false. This is not a RAM role read-only policy.', example='false'),
        server?: string(name='server', description='The AccessPoint domain name. This field is required and validated by the backend for each mount item. It does not include a protocol, port, or path. Use the DomainName from the NAS ListAccessPoints response.', example='ap-0123456789abcdef0.0123456789-vlm36.cn-hangzhou.nas.aliyuncs.com'),
      }
    ](name='agenticFsMounts', description='The NAS storage mount configuration. Currently, only the AgenticFS type is supported, which is used to mount file directories in an access point to agent runtime instances. This is the AgenticFS directory mount list. The total number of items with ossMounts cannot exceed 10. If omitted or set to [] during creation, no mounts are configured. If omitted during an update, the original configuration is retained. If set to [], the list is cleared. null is not accepted.'),
    description?: string(name='description', description='The description of the managed Harness agent.', example='Agent for code review'),
    environment?: {
      credentialReferences?: [ 
        {
          credentialId: string(name='credentialId', description='The credential ID.

This parameter is required.', example='cred-1'),
        }
      ](name='credentialReferences', description='The list of credential references.'),
      variables?: [ 
        {
          name: string(name='name', description='The environment variable name.

This parameter is required.', example='API_KEY'),
          value: string(name='value', description='The environment variable value.

This parameter is required.', example='sk-xxxx'),
        }
      ](name='variables', description='The list of environment variables.'),
    }(name='environment', description='The environment configuration.'),
    harness?: {
      configuration?: {
        connectorServiceAccountKey?: string(name='connectorServiceAccountKey', description='The account key record ID in the qodercli connector. You can query it through ListConnectors. It is not the original key. This field can be omitted if there is only one record, but must be specified if there are multiple records. Do not specify this field for qwenpaw.', example='key-example'),
        connectorServiceAccountName?: string(name='connectorServiceAccountName', description='The connector account name bound to qodercli. Do not specify this field for qwenpaw.', example='my-connector-key'),
      }(name='configuration', description='The runtime framework configuration.'),
      type?: string(name='type', description='The runtime framework type. This field is required when harness is provided and must be consistent with the value specified during creation.', example='qodercli'),
    }(name='harness', description='The runtime framework object. If omitted, the original framework is retained. If provided, the type must be the same as that specified during creation. You can update the account binding for the same type of framework.'),
    instruction?: string(name='instruction', description='The agent instructions used to guide the behavior of the agent.', example='You are a code review assistant'),
    model?: {
      modelConnectionId: string(name='modelConnectionId', description='For qwenpaw, use the workspace model connection ID. For qodercli, use the available model identifier returned by ListConnectorModels.

This parameter is required.', example='mc-1'),
      modelName?: string(name='modelName', description='For qwenpaw, use the name of the upstream model created under the model connection. This field is required. For qodercli, this field can be omitted.', example='qwen-max'),
      quota?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable the token quota. If not specified, the default value is true. If set to false, the quota is disabled and existing quota rules are deleted.', example='true'),
        limitType?: string(name='limitType', description='The quota limit type. This field is required and validated by the backend when the quota is enabled. Fixed value: token.', example='token'),
        periodType?: string(name='periodType', description='The statistical period for the quota. This field is required and validated by the backend when the quota is enabled. Valid values: day and month.', example='day'),
        usageLimit?: long(name='usageLimit', description='The maximum number of tokens allowed to be consumed in a single period. This field is required and validated by the backend when the quota is enabled. The value must be greater than 0.', example='1000000', minimum=1),
      }(name='quota', description='The model token quota configuration. If not provided, no quota is configured.'),
      thinkingLevel?: string(name='thinkingLevel', description='The thinking level. Valid values: off, low, medium, high, xhigh, and max. If not provided or set to null during creation, default is used. When updating and submitting the model configuration, if the thinking level is not provided or is null, it is restored to default. Except for off which is converted to none, the value is passed to the runtime framework as is. The system does not verify model support or automatically downgrade the level. If the model does not support the level, adjust the level.', example='high'),
    }(name='model', description='The model configuration.'),
    name?: string(name='name', description='The name of the managed Harness agent.', example='my-agent'),
    network?: {
