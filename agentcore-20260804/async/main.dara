model CreateExternalAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateExternalAgentResponseBody(name='body'),
}

/**
  * @description Registers an agent hosted in the user\\"s runtime environment, which corresponds to the "Managed Agent" in the console. After registration, you can continue to obtain the bootstrap information and complete the connection.
  * ### Configure a managed agent
  * Provide name, and select the configuration based on the model source:
  * | modelSource | Model configuration |
  * | --- | --- |
  * | PLATFORM | Uses a platform model. Provide model.modelConnectionId and model.modelName. |
  * | RUNTIME | The model is managed by the external runtime environment. Do not submit model. |
  * If modelSource is omitted but model is provided, it is processed as PLATFORM. If both are omitted, the agent cannot be created.
  * Configure instructions, MCP tools, and skills through instruction, tools, and skills. You can also reference an agent template through template.aiRegistry. The external process is deployed by the caller. This operation does not create a platform runtime instance.
  * ### Bootstrap sequence
  * **Step 1:** After creation, save the agentId and call [GetExternalAgent](https://api.aliyun.com/document/AgentCore/2026-08-04/GetExternalAgent) to query the configuration processing result.
  * **Step 2:** After the latest configuration takes effect, call [GetExternalAgentBootstrapOptions](https://api.aliyun.com/document/AgentCore/2026-08-04/GetExternalAgentBootstrapOptions) to obtain the available bootstrap networks.
  * **Step 3:** Select an available network and call [CreateExternalAgentBootstrapToken](https://api.aliyun.com/document/AgentCore/2026-08-04/CreateExternalAgentBootstrapToken) to obtain the bootstrap token and CMS configuration. The external process then completes the bootstrap.
  * clientToken is a reserved query parameter and currently does not provide idempotency guarantees.
  * @param request  the request parameters of CreateExternalAgent  CreateExternalAgentRequest
  * @return CreateExternalAgentResponse
 */
async function createExternalAgent(request: CreateExternalAgentRequest): CreateExternalAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateExternalAgent', 'POST', '/workspaces/{workspaceId}/external-agents', 'json', true, 'form', request);
}

model CreateExternalAgentBootstrapTokenRequest {
  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='ws-1', position='Path'),
  agentId: string(name='agentId', description='The ID of the managed agent.

This parameter is required.', example='agent-1', position='Path'),
  networkType: string(name='networkType', description='The access network type. Valid values: INTRANET (internal network) and INTERNET (Internet).

This parameter is required.', example='INTERNET', position='Query'),
}

model CreateExternalAgentBootstrapTokenResponseBody = {
  code?: string(name='code', description='The business status code. The value is SUCCESS if the request is successful.', example='SUCCESS'),
  data?: {
    agentId?: string(name='agentId', description='The ID of the managed agent.', example='agent-1'),
    bootstrapToken?: string(name='bootstrapToken', description='The bootstrap token used for the managed agent onboarding.', example='bootstrap-token'),
    cms?: {
      endpoint?: string(name='endpoint', description='The CMS reporting endpoint.', example='https://public.example.com/apm/trace/opentelemetry'),
      licenseKey?: string(name='licenseKey', description='The license key used for CMS access.', example='license-key'),
      workspace?: string(name='workspace', description='The name of the CMS workspace.', example='cms-workspace'),
    }(name='cms', description='The CMS configuration used for the managed agent onboarding.'),
    networkType?: string(name='networkType', description='The access network type. Valid values: INTRANET (internal network) and INTERNET (Internet).', example='INTERNET'),
    tokenFingerprint?: string(name='tokenFingerprint', description='The fingerprint of the bootstrap token.', example='fingerprint'),
    workspaceId?: string(name='workspaceId', description='The workspace ID.', example='ws-1'),
  }(name='data', description='The bootstrap token and CMS configuration required for the managed agent onboarding.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code. The value is 200 if the request is successful.', example='200'),
  message?: string(name='message', description='The request processing result message.', example='success'),
  requestId?: string(name='requestId', description='The request ID.', example='1a2b3c4d-xxxx-xxxx-xxxx-xxxxxxxxxxxx'),
  success?: boolean(name='success', description='Indicates whether the request is successful.'),
}

model CreateExternalAgentBootstrapTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateExternalAgentBootstrapTokenResponseBody(name='body'),
}

/**
  * @description Issues an access token and connection configurations for a registered managed agent whose configurations have taken effect to complete the onboarding in the runtime environment where the agent resides.
  * ### Prerequisites and parameters
  * The managed agent must be in the running state, and its latest configurations must have taken effect. Call [GetExternalAgentBootstrapOptions](https://api.aliyun.com/document/AgentCore/2026-08-04/GetExternalAgentBootstrapOptions) first to query available networks.
  * The `networkType` parameter is passed as a query parameter. Valid values: `INTRANET` (internal network) and `INTERNET` (Internet). The selected endpoint must be available.
  * ### Use the response
  * Pass the `bootstrapToken` to the external runtime process to complete the onboarding. The `tokenFingerprint` is used to identify the token and cannot be used as a substitute for the token. The `cms` field contains the observability reporting configurations for the corresponding network. Configure the endpoint, workspace, and license key as provided in the response.
  * @param request  the request parameters of CreateExternalAgentBootstrapToken  CreateExternalAgentBootstrapTokenRequest
  * @return CreateExternalAgentBootstrapTokenResponse
 */
async function createExternalAgentBootstrapToken(request: CreateExternalAgentBootstrapTokenRequest): CreateExternalAgentBootstrapTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateExternalAgentBootstrapToken', 'POST', '/workspaces/{workspaceId}/external-agents/{agentId}/bootstrap/create', 'json', false, 'json', request);
}

