      eventSubscriptionCallbackUrl?: string(name='eventSubscriptionCallbackUrl', description='The event subscription callback URL. Configure this URL in the external identity provider application to receive organization change events. Returns an empty string if the user pool is not activated.', example='http://auth.cn-hangzhou.agentteams.aliyuncs.com/roa/dingtalk/event/up-123456'),
      identityProviderType?: string(name='identityProviderType', description='The type of the external identity provider. Valid values: DingTalk, Feishu.', example='DingTalk'),
      loginCallbackUrl?: string(name='loginCallbackUrl', description='The logon callback URL. Configure this URL in the external identity provider application. Returns an empty string if the user pool is not activated.', example='https://signin-cn-hangzhou.aliyunagentid.com/up-123456/dingtalk/callback'),
      loginEnabled?: boolean(name='loginEnabled', description='Specifies whether workspace users are allowed to log on through this external identity provider.'),
