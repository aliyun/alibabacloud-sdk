  * @return UpdateMcpResponse
 */
async function updateMcp(request: UpdateMcpRequest): UpdateMcpResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'UpdateMcp', 'PUT', '/workspaces/{workspaceId}/mcp-servers/{mcpServerId}', 'json', true, 'form', request);
}

