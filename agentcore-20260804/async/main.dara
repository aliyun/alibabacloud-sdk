  * @return ConvertMcpToFreeEditResponse
 */
async function convertMcpToFreeEdit(request: ConvertMcpToFreeEditRequest): ConvertMcpToFreeEditResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ConvertMcpToFreeEdit', 'POST', '/workspaces/{workspaceId}/mcp-servers/{mcpServerId}/convert-to-free-edit', 'json', false, 'json', request);
}

