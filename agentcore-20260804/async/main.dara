    status?: string(name='status', description='The status of the synchronization task. Valid values: PENDING: pending. RUNNING: running. PAUSED: paused. SUCCESS: successful. FAILED: failed. CANCELED: canceled. The first three are non-terminal states, and the last three are terminal states. Query the status until a terminal state is reached to determine the result.', example='SUCCESS'),
    syncedUserCount?: int32(name='syncedUserCount', description='The number of user entries that have been read locally and written or updated, including existing users. This does not represent the number of newly added users or the synchronization percentage. This field is not returned when no statistics are available.', example='12'),
    synchronizationJobId?: string(name='synchronizationJobId', description='The ID of the downstream synchronization task in AgentIdentity. This field is not returned if the task has not been created. You cannot use this ID in place of taskId to call GetIdentityProviderSyncJob.', example='syncjob_0123456789abcdef0123456789abcdef'),
    taskId?: string(name='taskId', description='The local task ID in AgentCore returned by CreateIdentityProviderSyncJob, which is different from the synchronizationJobId in AgentIdentity. You must use the same workspace and identity provider when querying the task.', example='12345678-1234-4234-8234-123456789abc'),
  }(name='data', description='The business data returned in the response.', example='{"taskId":"12345678-1234-4234-8234-123456789abc","status":"PENDING"}'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code of the API request, which does not indicate the execution result of the asynchronous task.', example='200'),
  message?: string(name='message', description='The response message of the API request.', example='success'),
  requestId?: string(name='requestId', description='The unique identifier of the request. Provide this value when troubleshooting issues.', example='01234567-89AB-CDEF-0123-456789ABCDEF'),
  success?: boolean(name='success', description='Indicates whether the API request is successful. To check whether the asynchronous task is completed, query the task status.', example='true'),
}

model CreateIdentityProviderSyncJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateIdentityProviderSyncJobResponseBody(name='body'),
}

/**
  * @description Initiates a one-time user synchronization based on the saved scope without saving the configuration or requiring syncEnabled=true. Prerequisites: the identity provider is in the READY or SYNC_FAILED state, a user pool exists, and no other pending identity provider operations are in progress. The returned taskId only indicates that the request is accepted. Call GetIdentityProviderSyncJob to poll the status until it reaches SUCCESS, FAILED, or CANCELED. If the task fails, check the failureReason. The workspace user quota still applies, and previously synchronized users are not automatically deleted if the scope is reduced.
  * Authorization information: RAM action agentcore:CreateIdentityProviderSyncJob, access level Write, resource ARN: acs:agentcore:{regionId}:{accountId}:workspace/{workspaceId}/identityProvider/{identityProviderType}. This resource is required for authorization.
  * Idempotency and retry: This operation does not provide a ClientToken parameter for conditional idempotency. Repeated submissions do not guarantee the same task is returned. If an operation is already in progress, an operation conflict is returned. Submitting again after the task ends creates a new synchronization task. If a submission times out, query the identity provider status first to avoid blindly resubmitting the request.
  * Calling this API is free of charge, and operation records support ActionTrail auditing.
  * Initial selective synchronization process: CreateIdentityProvider (syncOnBind=false, it is recommended to keep syncEnabled=false initially) → GetIdentityProvider and wait for READY → ListIdentityProviderDepartments to select departments → UpdateIdentityProvider to save syncScope and wait for READY → CreateIdentityProviderSyncJob → GetIdentityProviderSyncJob to query the terminal state. If incremental synchronization is required, configure callbacks and event subscriptions, and then update syncEnabled=true.
  * Response example:
  * ```json
  * {
  *   "requestId": "01234567-89AB-CDEF-0123-456789ABCDEF",
  *   "message": "success",
  *   "httpStatusCode": 200,
  *   "code": "SUCCESS",
  *   "success": true,
  *   "data": {
  *     "taskId": "12345678-1234-4234-8234-123456789abc",
  *     "status": "PENDING"
  *   }
  * }
  * ```
  * @param request  the request parameters of CreateIdentityProviderSyncJob  CreateIdentityProviderSyncJobRequest
  * @return CreateIdentityProviderSyncJobResponse
 */
async function createIdentityProviderSyncJob(request: CreateIdentityProviderSyncJobRequest): CreateIdentityProviderSyncJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateIdentityProviderSyncJob', 'POST', '/workspaces/{workspaceId}/identity-providers/{identityProviderType}/sync-jobs', 'json', false, 'json', request);
}

