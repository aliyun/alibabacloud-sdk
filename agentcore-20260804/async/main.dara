    estimatedUserCount?: long(name='estimatedUserCount', description='The estimated number of users in the saved synchronization scope. This value is returned only when estimateStatus is Ready and the downstream system provides the value. It does not represent the number of users that have already been synchronized.', example='12'),
    expandedDepartmentCount?: long(name='expandedDepartmentCount', description='The estimated number of departments, including child departments. This value is returned only when estimateStatus is Ready and the downstream system provides the value.', example='2'),
