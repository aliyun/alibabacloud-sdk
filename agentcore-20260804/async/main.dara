model PrepareIdentityProviderSCIMResponseBody = {
  code?: string(name='code', description='The business result code. If the request fails, handle the error based on the HTTP status code and the message.', example='SUCCESS'),
  data?: {
    configuration?: {
      baseUrl?: string(name='baseUrl', description='The URL configured for the external provisioning system. The presence of a URL does not indicate that the external configuration is completed or that AC synchronization is enabled.', example='https://example.com/scim/v2'),
      status?: string(name='status', description='The AgentIdentity receiving status. Enabled indicates that SCIM receiving is enabled, and Disabled indicates that it is disabled. This status is not equivalent to the expected value of syncEnabled in AC.', example='Enabled'),
    }(name='configuration', description='The AgentIdentity receiving configuration. The actual SAML configuration is read on demand only by calling GetIdentityProvider. SCIM query and prepare operations return the actual receiving status and URL.'),
    credential?: {
      createTime?: string(name='createTime', description='The creation time returned by AgentIdentity.', example='2026-10-26T00:00:00Z'),
