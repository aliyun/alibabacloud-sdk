      corpId?: string(name='corpId', description='The corpId of the DingTalk enterprise. This parameter is required when the binding type is DingTalk.', example='dingexamplecorpid01'),
      encryptKey?: string(name='encryptKey', description='The data encryption key for event subscription. The value must be the same as the one configured in the external identity provider application. This parameter is used only for writing and is not returned by the query API.', example='example-encrypt-key'),
      verificationToken?: string(name='verificationToken', description='The verification token for event subscription. The value must be the same as the one configured in the external identity provider application. This parameter is used only for writing and is not returned by the query API.', example='example-verification-token'),
    }(name='metadata', description='The application configuration of the external identity provider. When you bind DingTalk, you must provide appKey, appSecret, and corpId. When you bind Feishu, you must provide appId and appSecret.'),
