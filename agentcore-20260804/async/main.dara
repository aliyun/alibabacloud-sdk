model UpdateWorkspaceRequest {
  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='ws-123456', position='Path'),
  body?: {
    name?: string(name='name', description='The updated name of the workspace.', example='production-agents-v2'),
    networkConfiguration?: {
      publicEgressEnabled?: boolean(name='publicEgressEnabled', description='Specifies whether to allow public outbound access from the platform. If this parameter is not specified, the original value is retained. Disabling this feature asynchronously cascades to disable the public network switch for agents. Re-enabling it does not automatically restore the agent switch. This parameter only controls whether the latest versions of managed and custom agents use the public outbound endpoint of the platform. It does not control fixed historical versions, model or MCP proxy endpoints, or the public outbound endpoint of the user VPC.', example='true'),
      publicIngressEnabled?: boolean(name='publicIngressEnabled', description='Specifies whether to allow public inbound access. If this parameter is not specified, the original value is retained. This parameter can be modified together with PublicEgressEnabled and takes effect asynchronously through a unified task. Disabling this feature closes the public inbound endpoints for all agent endpoints in the workspace. Re-enabling it restores the original public inbound endpoints. INNER_DIRECT and user VPC endpoints are not affected. Collaboration and Element Web endpoints are not controlled by this parameter.', example='true'),
      vpc?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable VPC networking.', example='true'),
        vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitch IDs. When VPC networking is enabled, the list must contain at least one vSwitch, and all vSwitches must belong to the VPC specified by VpcId.'),
        vpcId?: string(name='vpcId', description='The ID of the user VPC.', example='vpc-bp1234567890'),
      }(name='vpc', description='The VPC network configuration of the user.'),
    }(name='networkConfiguration', description='The updated network configuration of the workspace.'),
  }(name='body', description='The request body for updating a workspace.', shrink='json', position='Body'),
  clientToken?: string(name='clientToken', description='The client idempotency token.', example='workspace-update-20260805-001', position='Query'),
}

