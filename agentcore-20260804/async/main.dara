  * @return CreateAgentVersionResponse
 */
async function createAgentVersion(request: CreateAgentVersionRequest): CreateAgentVersionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateAgentVersion', 'POST', '/workspaces/{workspaceId}/agents/{agentId}/versions', 'json', true, 'form', request);
}

