  * @return UpdateMcpTemplateConfigResponse
 */
async function updateMcpTemplateConfig(request: UpdateMcpTemplateConfigRequest): UpdateMcpTemplateConfigResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'UpdateMcpTemplateConfig', 'PUT', '/workspaces/{workspaceId}/mcp-servers/{mcpServerId}/template-config', 'json', true, 'form', request);
}

