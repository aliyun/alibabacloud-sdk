model AddMemoriesRequest {
  workspaceId: string(name='workspaceId', description='The AgentCore workspace ID.

This parameter is required.', example='ws-2f5f9c5a8d0e4c3b', position='Path'),
  memoryStoreName: string(name='memoryStoreName', description='The MemoryStore name.

This parameter is required.', example='customer-memory', position='Path'),
  body: {
    messages?: [ 
      {
        content: string(name='content', description='The message content.

This parameter is required.', example='The user likes hiking'),
        role: string(name='role', description='The message role.

This parameter is required.', example='user'),
      }
    ](name='messages', description='The message list. You must provide either this parameter or Text, but not both. You can specify 1 to 20 messages, and the total size of the content cannot exceed 32,000 UTF-8 bytes.'),
    metadata?: map[string]string(name='metadata', description='The string key-value metadata. You can specify up to 16 keys. The maximum length of a key is 64 characters, and the maximum length of a value is 1,024 characters.'),
    referenceTime?: string(name='referenceTime', description='The time reference point for the batch of messages or text. The value must be in RFC 3339 format with a time zone and support fractional seconds.', example='2023-05-08T13:56:00+08:00'),
    scope?: {
      agentId?: string(name='agentId', description='The agent ID. The length is limited to 1 to 128 UTF-8 bytes. The value cannot contain a forward slash (/) or an asterisk (*).', example='agent-001'),
      sessionId?: string(name='sessionId', description='The session ID. The length is limited to 1 to 128 UTF-8 bytes. The value cannot contain a forward slash (/) or an asterisk (*).', example='session-001'),
      userId?: string(name='userId', description='The user ID. The length is limited to 1 to 128 UTF-8 bytes. The value cannot contain a forward slash (/) or an asterisk (*).', example='user-001'),
    }(name='scope', description='The write scope. UserId, AgentId, and SessionId are all optional.'),
    sync?: boolean(name='sync', description='Specifies whether to synchronously wait for the memory extraction to complete. Default value: true.'),
    text?: string(name='text', description='The text to be written directly. You must provide either this parameter or Messages, but not both. The size cannot exceed 32,000 UTF-8 bytes.', example='The user likes hiking'),
  }(name='body', description='The write memory request.

This parameter is required.', shrink='json', position='Body'),
}

model AddMemoriesResponseBody = {
  code?: string(name='code', description='The business status code.', example='SUCCESS'),
  data?: {
    memories?: [ 
      {
        memoryId?: string(name='memoryId', description='The long-term memory ID.', example='mem-2f5f9c5a8d0e4c3b'),
      }
    ](name='memories', description='The memory references. This parameter is returned only when sync is set to true. An empty array is allowed. This parameter is not returned together with taskId.'),
    taskId?: string(name='taskId', description='The task ID. This parameter is returned only when sync is set to false. This parameter is not returned together with memories.', example='task-2f5f9c5a8d0e4c3b'),
  }(name='data', description='The write result.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='message', description='The response message.', example='success'),
  requestId?: string(name='requestId', description='The request ID.', example='01A00000-0000-0000-0000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request is successful.'),
}

model AddMemoriesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddMemoriesResponseBody(name='body'),
}

/**
  * @description Writes messages or text to a memory store to fetch long-term memory to retrieve and use later.
  * - If `sync` is omitted or set to `true`: waits for the fetch to complete and returns `memories`. Returns an empty array if no memories are fetched.
  * - If `sync` is set to `false`: returns a `taskId`. You can query the fetch progress and results by calling [GetMemoryTask](https://api.aliyun.com/document/AgentCore/2026-08-04/GetMemoryTask).
  * @param request  the request parameters of AddMemories  AddMemoriesRequest
  * @return AddMemoriesResponse
 */
async function addMemories(request: AddMemoriesRequest): AddMemoriesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddMemories', 'POST', '/workspaces/{workspaceId}/memorystores/{memoryStoreName}/memories', 'json', true, 'form', request);
}

