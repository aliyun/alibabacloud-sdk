    status?: string(name='status', description='The status of the synchronization task. Valid values: PENDING: to be executed; RUNNING: executing; PAUSED: paused; SUCCESS: successful; FAILED: failed; CANCELED: canceled. The first three are non-terminal states, and the last three are terminal states. Query the status until a terminal state is reached to determine the result.', example='SUCCESS'),
    syncedUserCount?: int32(name='syncedUserCount', description='The number of user entries that have been locally read and written or updated, including existing users. This does not represent the number of newly added users or the synchronization percentage. This is not returned when no statistics are available.', example='12'),
    synchronizationJobId?: string(name='synchronizationJobId', description='The downstream AgentIdentity synchronization task ID. This is not returned if the task has not been created. You cannot use this ID instead of taskId to call GetIdentityProviderSyncJob.', example='syncjob_0123456789abcdef0123456789abcdef'),
    taskId?: string(name='taskId', description='The local AgentCore task ID returned by CreateIdentityProviderSyncJob. This is not the synchronizationJobId of AgentIdentity. You must use the same workspace and identity provider when querying.', example='12345678-1234-4234-8234-123456789abc'),
  }(name='data', description='The business data returned by the current request.', example='{"taskId":"12345678-1234-4234-8234-123456789abc","status":"PENDING"}'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code for the current API request. This does not indicate the execution result of the asynchronous task.', example='200'),
  message?: string(name='message', description='The response message for the current API request.', example='success'),
  requestId?: string(name='requestId', description='The unique identifier of the request. Provide this value when troubleshooting issues.', example='01234567-89AB-CDEF-0123-456789ABCDEF'),
  success?: boolean(name='success', description='Indicates whether the current API request is successful. To determine whether the asynchronous task is complete, query the task status.', example='true'),
}

model CreateIdentityProviderSyncJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateIdentityProviderSyncJobResponseBody(name='body'),
}

/**
  * @description Synchronizes users from an enterprise identity provider to a workspace based on the saved department scope. This is suitable for importing users for the first time or manually updating workspace users after adjusting the synchronization scope.
  * ### Prerequisites
  * - The identity provider is configured and its status is `READY`. If the previous synchronization failed and the status is `SYNC_FAILED`, you can also re-initiate it.
  * - The user pool is ready, and no identity provider operations are in progress.
  * - Manual synchronization uses the saved `syncScope`. You do not need to enable `syncEnabled`, which is used for subsequent address book change synchronization.
  * ### Steps for synchronizing by department
  * **Step 1:** Query departments by calling [ListIdentityProviderDepartments](https://api.aliyun.com/document/AgentCore/2026-08-04/ListIdentityProviderDepartments) and select the scope to synchronize.
  * **Step 2:** Save the `syncScope` by calling [UpdateIdentityProvider](https://api.aliyun.com/document/AgentCore/2026-08-04/UpdateIdentityProvider), and then call [GetIdentityProvider](https://api.aliyun.com/document/AgentCore/2026-08-04/GetIdentityProvider) to wait for the configuration processing to complete.
  * **Step 3:** Call this operation to initiate the synchronization and save the returned `taskId`.
  * **Step 4:** Query the progress by calling [GetIdentityProviderSyncJob](https://api.aliyun.com/document/AgentCore/2026-08-04/GetIdentityProviderSyncJob). After the synchronization is complete, view the workspace user list.
  * If you want to select departments before the initial synchronization, set `syncOnBind=false` when creating the identity provider, and then perform the preceding steps.
  * ### Synchronization results and re-execution
  * Synchronization is subject to the maximum number of users allowed in the workspace. Narrowing the synchronization scope does not actively delete users that have already been synchronized.
  * Each successful initiation creates a new synchronization task. If a request times out or the response is lost, check the identity provider status by calling [GetIdentityProvider](https://api.aliyun.com/document/AgentCore/2026-08-04/GetIdentityProvider) before deciding whether to resubmit the request.
  * @param request  the request parameters of CreateIdentityProviderSyncJob  CreateIdentityProviderSyncJobRequest
  * @return CreateIdentityProviderSyncJobResponse
 */
async function createIdentityProviderSyncJob(request: CreateIdentityProviderSyncJobRequest): CreateIdentityProviderSyncJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateIdentityProviderSyncJob', 'POST', '/workspaces/{workspaceId}/identity-providers/{identityProviderType}/sync-jobs', 'json', false, 'json', request);
}

