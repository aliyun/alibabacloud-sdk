  statusCode?: int32(name='statusCode'),
  body?: VerifyWorkspaceAgenticFsMountRamAuthorizationResponseBody(name='body'),
}

/**
  * @description Determines the shared role and target access point based on the workspace and server, checks whether the role has a mounted policy with the expected name and a type of Custom, and returns AUTHORIZED or UNAUTHORIZED. Consistent with OSS/ACR, this operation does not verify the policy body, role trust, or actual mount read/write permissions. If the upstream query fails, an error is returned.
  * @param request  the request parameters of VerifyWorkspaceAgenticFsMountRamAuthorization  VerifyWorkspaceAgenticFsMountRamAuthorizationRequest
  * @return VerifyWorkspaceAgenticFsMountRamAuthorizationResponse
 */
async function verifyWorkspaceAgenticFsMountRamAuthorization(request: VerifyWorkspaceAgenticFsMountRamAuthorizationRequest): VerifyWorkspaceAgenticFsMountRamAuthorizationResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'VerifyWorkspaceAgenticFsMountRamAuthorization', 'GET', '/workspaces/{workspaceId}/agentic-fs/authorize/verify', 'json', false, 'json', request);
}

