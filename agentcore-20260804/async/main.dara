      expireTime?: string(name='expireTime', description='The expiration time returned by AgentIdentity. Only credentials that are in the Enabled state and have not expired are considered available.', example='2027-10-26T00:00:00Z'),
      status?: string(name='status', description='The AgentIdentity credential status. Only credentials that are in the Enabled state and have not expired are considered available. This field is not the operationStatus of a SCIM task.', example='Enabled'),
    }(name='credential', description='The current credential summary, including credentialId, status, createTime, and expireTime. It does not include the repeatedly retrievable token.'),
    token?: string(name='token', description='The plaintext token returned only when a new credential is created. If the prepare operation reuses a valid credential, this value is null. The token cannot be retrieved again from the list. If the response is lost, query the list first. The token is not automatically reissued. Do not write the token to logs or persistent frontend caches.', example='example-scim-token'),
  }(name='data', description='The operation result. For the result structure, see the response fields of this API operation. For asynchronous write API operations, the response indicates that the request is accepted and does not guarantee that the background task is completed.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code of the current request. This code indicates the processing status of the request and is not equivalent to the final result of the background task.', example='200'),
