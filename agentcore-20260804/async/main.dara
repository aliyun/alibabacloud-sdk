      }(name='directProxy', description='The direct proxy authentication configuration.'),
      enabled?: boolean(name='enabled', description='Specifies whether the configuration is enabled.'),
      httpToMcp?: [ 
        {
          credential?: string(name='credential', description='The authentication credential.', example='example-credential'),
          id?: string(name='id', description='The authentication scheme ID.', example='mcp-1234567890abcdef'),
          name?: string(name='name', description='The name.', example='mcp-example'),
          position?: string(name='position', description='The position of the credential.', example='header'),
          type?: string(name='type', description='The type.', example='basic'),
        }
      ](name='httpToMcp', description='The list of HTTP_TO_MCP authentication configurations.'),
    }(name='auth', description='The backend authentication configuration. When enabled is set to true, specify directProxy (name and value) for DIRECT_PROXY, specify the httpToMcp array (each item includes id, type, and credential; apiKey also requires position and name) for HTTP_TO_MCP, and specify codePackage for CODE_PACKAGE. Multiple authentication objects are supported, and the first one serves as the default upstream credential. HTTP_TO_MCP credentials are merged into the securitySchemes of Swagger.'),
    customTags?: [ string ](name='customTags', description='The custom tags. Multiple tags are supported. Pass an empty list to clear the tags.'),
    deploymentConfig?: {
      accessControl?: {
