      verificationToken?: string(name='verificationToken', description='The verification token for event subscription. The value must be the same as the one configured in the external identity provider application. This parameter is used only for write operations and is not returned by query operations.', example='example-verification-token'),
    }(name='metadata', description='The application configuration of the external identity provider. When you bind DingTalk, you must provide appKey, appSecret, and corpId. When you bind Lark, you must provide appId and appSecret.'),
    syncEnabled?: boolean(name='syncEnabled', description='Specifies whether to enable organization member synchronization. When enabled, organization members are synchronized as workspace users by the external identity provider.'),
    syncOnBind?: boolean(name='syncOnBind', description='Controls the initial synchronization when DingTalk or Feishu is bound. If this parameter is omitted or set to null, the default value is true. If this parameter is set to false, only the configuration is saved, and synchronization must be explicitly triggered later. CustomSSO does not use the provider pull channel.'),
    syncScope?: {
