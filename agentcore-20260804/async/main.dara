      nonSecretFields?: map[string]string(name='nonSecretFields', description='The non-sensitive credential fields and their values.'),
    }(name='credentialSummary', description='The channel credential summary. Only non-sensitive fields and configured secret field names are returned. Secret values are not returned.'),
    enabled?: boolean(name='enabled', description='Specifies whether to enable the IM channel. Default value: true.'),
