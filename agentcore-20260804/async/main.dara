This parameter is required.', example='DingTalk', position='Path'),
  taskId: string(name='taskId', description='The local AgentCore task ID returned by CreateIdentityProviderSyncJob, not the synchronizationJobId of AgentIdentity. You must use the same workspace and identity provider when querying.

This parameter is required.', example='12345678-1234-4234-8234-123456789abc', position='Path'),
}

model GetIdentityProviderSyncJobResponseBody = {
  code?: string(name='code', description='The business status code of the API request. SUCCESS indicates that the request is successful, but does not indicate that the asynchronous synchronization task is complete.', example='SUCCESS'),
  data?: {
    currentStep?: string(name='currentStep', description='The current execution step of the AgentCore asynchronous task. This field may not be returned if the task has not started.', example='SYNC'),
    failureReason?: string(name='failureReason', description='The failure summary of the asynchronous task. This field is not returned when no failure information is available. You can use it in combination with taskId and requestId for troubleshooting.', example='The identity provider synchronization job failed.'),
    status?: string(name='status', description='The status of the synchronization task. Valid values: PENDING (to be executed), RUNNING (executing), PAUSED (paused), SUCCESS (successful), FAILED (failed), and CANCELED (canceled). The first three are non-terminal states, and the last three are terminal states. Query until a terminal state is reached to determine the result.', example='SUCCESS'),
    syncedUserCount?: int32(name='syncedUserCount', description='The number of user entries that have been locally read and written or updated, including existing users. It does not represent the number of newly added users or the synchronization percentage. This field is not returned when no statistics are available.', example='12'),
    synchronizationJobId?: string(name='synchronizationJobId', description='The downstream AgentIdentity synchronization task ID. This field is not returned if the task is not yet created. It cannot be used in place of taskId to call GetIdentityProviderSyncJob.', example='syncjob_0123456789abcdef0123456789abcdef'),
    taskId?: string(name='taskId', description='The local AgentCore task ID returned by CreateIdentityProviderSyncJob, not the synchronizationJobId of AgentIdentity. You must use the same workspace and identity provider when querying.', example='12345678-1234-4234-8234-123456789abc'),
  }(name='data', description='The business data returned by the request.', example='{"taskId":"12345678-1234-4234-8234-123456789abc","status":"SUCCESS","currentStep":"SYNC","synchronizationJobId":"syncjob_0123456789abcdef0123456789abcdef","syncedUserCount":12}'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code of the API request. It does not indicate the execution result of the asynchronous task.', example='200'),
  message?: string(name='message', description='The response message of the API request.', example='success'),
  requestId?: string(name='requestId', description='The unique identifier of the request. Provide this value when troubleshooting issues.', example='01234567-89AB-CDEF-0123-456789ABCDEF'),
  success?: boolean(name='success', description='Indicates whether the API request is successful. To check whether the asynchronous task is complete, query the task status.', example='true'),
}

model GetIdentityProviderSyncJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetIdentityProviderSyncJobResponseBody(name='body'),
}

/**
  * @description Queries the progress, number of processed users, and failure causes of a user synchronization task to track whether manual synchronization is complete.
  * Use the `taskId` returned by [CreateIdentityProviderSyncJob](https://api.aliyun.com/document/AgentCore/2026-08-04/CreateIdentityProviderSyncJob) and keep the same workspace and identity provider.
  * ### Determine synchronization results
  * | `status` | Meaning and what to do next |
  * | --- | --- |
  * | `PENDING`, `RUNNING` | The node is not yet complete. You can continue to query. |
  * | `PAUSED` | The node is paused and has not ended. |
  * | `SUCCESS` | The synchronization is complete. You can view the workspace users. |
  * | `FAILED` | The synchronization failed. Check `failureReason`. |
  * | `CANCELED` | The node is canceled. |
  * `syncedUserCount` is the number of processed users, including updated existing users. It is not the number of newly added users and cannot be directly used as a completion percentage. `null` is returned when the count is not yet available.
  * @param request  the request parameters of GetIdentityProviderSyncJob  GetIdentityProviderSyncJobRequest
  * @return GetIdentityProviderSyncJobResponse
 */
async function getIdentityProviderSyncJob(request: GetIdentityProviderSyncJobRequest): GetIdentityProviderSyncJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetIdentityProviderSyncJob', 'GET', '/workspaces/{workspaceId}/identity-providers/{identityProviderType}/sync-jobs/{taskId}', 'json', false, 'json', request);
}

