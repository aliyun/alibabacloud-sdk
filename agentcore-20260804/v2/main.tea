model UpdateMcpRequest {
  body?: {
    addresses?: [ string ](name='addresses', description='The list of MCP service addresses.'),
    auth?: {
      codePackage?: {
        apiKey?: string(name='apiKey', description='The API key used to verify the MCP caller.', example='example-api-key'),
        headerName?: string(name='headerName', description='The name of the request header that carries the API key.', example='X-API-Key'),
      }(name='codePackage', description='The caller API key authentication configuration for a code-deployed MCP.'),
      directProxy?: {
        name?: string(name='name', description='The name.', example='mcp-example'),
        value?: string(name='value', description='The value of the authentication parameter.', example='example-credential'),
      }(name='directProxy', description='The direct proxy authentication configuration.'),
      enabled?: boolean(name='enabled', description='Specifies whether to enable the configuration.'),
      httpToMcp?: [ 
        {
          credential?: string(name='credential', description='The authentication credential.', example='example-credential'),
          id?: string(name='id', description='The authentication scheme ID.', example='mcp-1234567890abcdef'),
          name?: string(name='name', description='The name.', example='mcp-example'),
          position?: string(name='position', description='The position of the credential.', example='header'),
          type?: string(name='type', description='The type.', example='basic'),
        }
      ](name='httpToMcp', description='The list of HTTP_TO_MCP authentication configurations.'),
    }(name='auth', description='The backend authentication configuration. When enabled is set to true: for DIRECT_PROXY, specify directProxy (name/value); for HTTP_TO_MCP, specify the httpToMcp array (each item includes id, type, and credential, and apiKey also requires position and name). Multiple authentication objects are supported, and the first one is the default upstream credential. HTTP_TO_MCP credentials are merged into the securitySchemes of Swagger.'),
    backendMcpProtocol?: string(name='backendMcpProtocol', description='Optional. Valid values: legacy and modern. This parameter is used only for DIRECT_PROXY. If omitted for direct connection, the current value is retained and validated against the existing protocol of the resource. The modern value is incompatible with SSE. Updates are rejected if they break existing client access contracts. For CODE_PACKAGE, this parameter is not required. Valid inputs are ignored, existing field values are not changed, and no publication or Function Compute (FC) session affinity changes are triggered. FC session affinity is configured only based on protocol and DeploymentConfig.McpConfiguration.SessionMode. The gateway protocol is determined by the result of successful probing after FC deployment. For HTTP_TO_MCP, valid values are ignored and not saved.', example='modern'),
    customTags?: [ string ](name='customTags', description='The custom tags. Multiple tags are supported. Pass an empty list to clear the tags.'),
    deploymentConfig?: {
      accessControl?: {
        credentialId?: string(name='credentialId', description='The ID of the AgentCore credential referenced when the mode is set to CREDENTIAL.', example='credential-id'),
