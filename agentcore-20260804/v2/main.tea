  description?: string(name='description', description='The MCP service description in this language.', example='MCP service for querying knowledge bases'),
  name?: string(name='name', description='The MCP marketplace template name in this language.', example='Knowledge base'),
  readme?: string(name='readme', description='The MCP marketplace template instructions in this language.', example='# Knowledge base\\\\nKnowledge base query service'),
}

model ItemsI18nValue = {
  description?: string(name='description', description='The description of the MCP service in the language.', example='MCP service for querying knowledge bases'),
