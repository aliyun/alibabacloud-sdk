      }
    ](name='memories', description='The list of memories to be directly written when extract is set to false. The list can contain 1 to 100 memories. You cannot provide text, messages, referenceTime, or request-level metadata at the same time.'),
    messages?: [ 
      {
        content?: string(name='content', description='The content of the message.

This parameter is required.', example='The user likes hiking'),
        referenceTime?: string(name='referenceTime', description='The reference time of the message in RFC 3339 format with a time zone. If omitted, the request-level referenceTime is used. If both are omitted, the time of the current request is used.', example='2023-05-08T13:56:00+08:00'),
        role?: string(name='role', description='The role of the message.

This parameter is required.', example='user'),
      }
    ](name='messages', description='The list of messages. You must provide either text or messages, but not both. The list can contain 1 to 20 messages, and the total length of the content cannot exceed 32,000 UTF-8 bytes.'),
    metadata?: map[string]string(name='metadata', description='The string key-value metadata. A maximum of 16 keys are supported. A key can be up to 64 characters in length, and a value can be up to 1,024 characters in length.', example='{"topic":"hiking"}'),
    referenceTime?: string(name='referenceTime', description='The time reference point for the batch of messages or text. It uses the RFC 3339 format with a time zone and supports fractional seconds.', example='2023-05-08T13:56:00+08:00'),
    scope?: {
      agentId?: string(name='agentId', description='The agent ID. The length is limited to 1 to 128 UTF-8 bytes. It cannot contain a forward slash (/) or an asterisk (*).', example='agent-001'),
      sessionId?: string(name='sessionId', description='The session ID. The length is limited to 1 to 128 UTF-8 bytes. It cannot contain a forward slash (/) or an asterisk (*).', example='session-001'),
      teamId?: string(name='teamId', description='The business team ID defined by the caller. It cannot be empty when provided and can be up to 128 UTF-8 bytes in length.', example='team-001'),
      userId?: string(name='userId', description='The user ID. The length is limited to 1 to 128 UTF-8 bytes. It cannot contain a forward slash (/) or an asterisk (*).', example='user-001'),
    }(name='scope', description='The write scope. UserId, AgentId, and SessionId are all optional.'),
    sync?: boolean(name='sync', description='Specifies whether to synchronously wait for the memory extraction to complete. Default value: true.'),
    text?: string(name='text', description='The text to be directly written. You must provide either text or messages, but not both. The text cannot exceed 32,000 UTF-8 bytes.', example='The user likes hiking'),
  }(name='body', description='The write memory request.

This parameter is required.'),
}

