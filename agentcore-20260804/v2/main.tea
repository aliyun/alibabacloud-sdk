 * @return BeginAssetUploadResponse
 */
async function beginAssetUpload(workspaceId: string, knowledgeBaseId: string, request: BeginAssetUploadRequest): BeginAssetUploadResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return beginAssetUploadWithOptions(workspaceId, knowledgeBaseId, request, headers, runtime);
}

model CompleteAssetUploadRequest {
  body?: {
    uploadId?: string(name='uploadId', description='The uploadId returned by BeginAssetUpload. It must match the current upload session and the current upload target generation of the asset.

This parameter is required.', example='upload-001'),
  }(name='body', description='Specifies the upload session returned by BeginAssetUpload to prevent delayed confirmations from affecting subsequent uploads.

This parameter is required.'),
}

model CompleteAssetUploadShrinkRequest {
  bodyShrink?: string(name='body', description='Specifies the upload session returned by BeginAssetUpload to prevent delayed confirmations from affecting subsequent uploads.

This parameter is required.'),
}

model CompleteAssetUploadResponseBody = {
  code?: string(name='code', description='The stable result code.', example='SUCCESS'),
  data?: {
    assetId?: string(name='assetId', description='The stable ID of the asset. You can specify this ID when creating an asset. If assetId is not specified but clientToken is provided, the platform stably derives the ID based on the resource scope and clientToken. If neither is provided, a new asset is created for each request. Setting overwrite=true allows you to register a new upload session for the same asset, and the previously published version continues to be used until new results are published.', example='asset-001'),
    chunkConfiguration?: {
      headingLevel?: int32(name='headingLevel', description='This parameter is required when the strategy is BY_HEADING, and the value ranges from 1 to 6. Headings at or above this level are used as boundaries. Deeper headings are retained in the body text. Overlong sections fall back to paragraph or sentence splitting. Documents without headings fall back to intelligent splitting. This parameter is ignored for other strategies and is validated by the backend based on the strategy.', example='2'),
      maxChunkSize?: int32(name='maxChunkSize', description='The value ranges from 1 to 6,000 characters. This follows the character length metric of EB and is not the number of tokens. If omitted, the server-side default value is used.', example='512'),
      overlapSize?: int32(name='overlapSize', description='This parameter takes effect only when the strategy is BY_LENGTH. The unit is characters, and the default value is 0. The valid value must be greater than or equal to 0 and less than the valid maxChunkSize. The length after overlapping must not exceed the maximum chunk length. This parameter is ignored for other strategies and is validated by the backend based on the strategy.', example='40'),
      preprocessRules?: {
        removeUrlsAndEmails?: boolean(name='removeUrlsAndEmails', description='Specifies whether to remove URLs and email addresses during parsing.', example='false'),
        replaceConsecutiveWhitespace?: boolean(name='replaceConsecutiveWhitespace', description='Specifies whether to replace consecutive spaces, line breaks, and tabs with a single space.', example='true'),
      }(name='preprocessRules', description='The text preprocessing rules applied before splitting.'),
      separator?: string(name='separator', description='This parameter is required and cannot be empty when the strategy is BY_SEPARATOR. It matches the literal string as a whole without using regular expressions. This parameter is ignored for other strategies.', example='\\n\\n'),
      strategy?: string(name='strategy', description='The saved chunking strategy. AUTO indicates automatic chunking, and BY_SEPARATOR indicates chunking by separator. BY_LENGTH and BY_HEADING are returned only for backward compatibility with historical configurations. Only AUTO and BY_SEPARATOR are accepted when creating or updating configurations in the first phase.

This parameter is required.', example='AUTO'),
    }(name='chunkConfiguration', description='The effective chunking configuration used for the current asset processing. Explicitly uploaded configurations take precedence over the default knowledge base values. Subsequent modifications to the knowledge base configuration do not change this snapshot.'),
    chunkCount?: int32(name='chunkCount', description='The total number of chunks in the currently published results. The value is 0 before the first publication. During re-chunking or editing, the count still reflects the published results.', example='20'),
    contentType?: string(name='contentType', description='The MIME type of the uploaded original file for this asset.', example='application/pdf'),
    createdAt?: string(name='createdAt', description='The time in ISO 8601 UTC format.', example='2026-10-27T02:00:00Z'),
    enabled?: boolean(name='enabled', description='If disabled, the asset does not participate in regular viewing, retrieval, and downloading. Management APIs are still controlled by management permissions.', example='true'),
    fileName?: string(name='fileName', description='The file name of the currently uploaded original file. Modifying the display name does not change this value.', example='guide.pdf'),
    knowledgeBaseId?: string(name='knowledgeBaseId', description='The knowledge base to which the asset belongs.', example='kb-001'),
    lastError?: {
      code?: string(name='code', description='The stable product error code. It does not return internal task identifiers, stack traces, or storage addresses.', example='ProcessingFailed'),
      message?: string(name='message', description='The masked error summary that can be displayed to users.', example='File parsing failed'),
    }(name='lastError', description='The masked error of the current upload or processing. It does not contain internal credentials, paths, or run identifiers.'),
    metadata?: [ 
      {
        key?: string(name='key', description='The field name declared in metadataSchema. It must not be duplicated in the same request. Fixed value and system variable fields are generated by the server and cannot be overwritten by customers.

This parameter is required.', example='department'),
        value?: string(name='value', description='The string parsed based on the schema type. If omitted or set to null during upload, no value is assigned and the value is populated by the schema. In the UpdateAsset operation, omitting the field, setting it to null, or passing an empty string deletes the key. Unsubmitted keys remain unchanged. For the DATETIME type, accepted formats include ISO 8601 with time zone, yyyy-MM-dd HH:mm:ss, and yyyy-MM-dd.', example='engineering'),
      }
    ](name='metadata', description='The complete list of effective metadata key-value pairs, including constants and system variable results. Patches involving retrieval projection do not overwrite old effective values until new results are published.', example='[{"key":"department","value":"engineering"}]'),
    name?: string(name='name', description='The default value is the uploaded file name. You can modify the display name by calling UpdateAsset.', example='guide.pdf'),
    publishedResultAvailable?: boolean(name='publishedResultAvailable', description='Indicates whether the published result is available. The value is true if a published version exists and the asset is neither disabled nor deleted. The value may still be true if re-chunking or editing fails, and is false if the initial processing fails.', example='true'),
    sizeBytes?: long(name='sizeBytes', description='The size of the current original file in bytes. This parameter is not returned before the upload is confirmed. After confirmation, the actual size verified by the OSS HEAD request is returned.', example='102400'),
    sourceModifiedTime?: long(name='sourceModifiedTime', description='The last modification time of the source file in UTC epoch milliseconds. This parameter is not returned if the time is not provided.', example='1793066400000'),
    sourceType?: string(name='sourceType', description='The import channel of the asset, such as UPLOAD or OSS. This value is recorded by the platform based on the trusted access path and is not used to grant access permissions.', example='UPLOAD'),
    sourceUri?: string(name='sourceUri', description='The URI of the original source. This value is used only for tracing. It does not grant download authorization or trigger server-side fetching.', example='oss://source-bucket/path/guide.pdf'),
    status?: string(name='status', description='The current upload or processing status of the document. Upload, rebuild, and chunk body editing are all polled through GetAsset. PENDING indicates waiting for processing, PROCESSING indicates processing in progress, COMPLETED indicates that publication is finished, and FAILED indicates final failure with lastError returned. This does not represent the result of a specific historical request. No readable results are available if the first processing fails. During overwrite upload, rebuild, or editing, and after failure, published results remain readable if the enabled and deleted statuses allow.', example='PROCESSING'),
    updatedAt?: string(name='updatedAt', description='The time in ISO 8601 UTC format.', example='2026-10-27T02:05:00Z'),
    workspaceId?: string(name='workspaceId', description='The workspace to which the asset belongs.', example='ws-001'),
  }(name='data', description='The asset management properties, actual file size, source, metadata, chunking configuration, and processing status after the upload is confirmed. Acceptance does not mean that new results are published. Poll the status of GetAsset until it reaches COMPLETED or FAILED. For the cause of failure, see lastError.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The actual HTTP status code.', example='200'),
  message?: string(name='message', description='The description of the masked result.', example='success'),
  requestId?: string(name='requestId', description='The request trace ID.', example='01A00000-0000-0000-0000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request is successful.'),
}

model CompleteAssetUploadResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CompleteAssetUploadResponseBody(name='body'),
}

/**
 * @summary Confirms a specified upload session by using the workspaceId, knowledgeBaseId, and assetId in the path and the uploadId in the request body. The server verifies tenant and resource ownership, requires the uploadId to match the current upload session and the upload_epoch to equal the current next_epoch, and then performs a HEAD operation on the bound original object to verify its existence, actual size of 1 byte to 50 MiB, and content type. Using the metadata and chunking configuration saved during acceptance, the server enters the pending state through a CAS operation that includes the upload identity, target generation, UPLOADING status, and deletion marker. Repeatedly confirming the same accepted upload that is still the current target returns the existing status without incrementing the generation or creating a new task. If the scheduling acceptance result is unknown, the server resubmits the task by using the same taskKey. When a subsequent overwrite upload, edit, or rebuild replaces the target, a delayed Complete request returns a status conflict and does not overwrite the new task or resurrect deleted assets. Non-retryable processing failures remain in the FAILED state and are not requeued by the Complete request.
 *
 * @description Confirms a specified upload session by using the workspaceId, knowledgeBaseId, and assetId in the path and the uploadId in the request body. The server verifies tenant and resource ownership, requires the uploadId to match the current upload session and the upload_epoch to equal the current next_epoch, and then performs a HEAD operation on the bound original object to verify its existence, actual size of 1 byte to 50 MiB, and content type. Using the metadata and chunking configuration saved during acceptance, the server enters the pending state through a CAS operation that includes the upload identity, target generation, UPLOADING status, and deletion marker. Repeatedly confirming the same accepted upload that is still the current target returns the existing status without incrementing the generation or creating a new task. If the scheduling acceptance result is unknown, the server resubmits the task by using the same taskKey. When a subsequent overwrite upload, edit, or rebuild replaces the target, a delayed Complete request returns a status conflict and does not overwrite the new task or resurrect deleted assets. Non-retryable processing failures remain in the FAILED state and are not requeued by the Complete request.
 *
 * @param tmpReq CompleteAssetUploadRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CompleteAssetUploadResponse
