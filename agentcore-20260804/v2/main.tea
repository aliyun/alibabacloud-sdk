    }(name='model', description='The model configuration. This parameter is available only when modelSource is set to PLATFORM.'),
    modelSource?: string(name='modelSource', description='The source of the model configuration. Valid values:

- PLATFORM: The platform parses and delivers the model configuration. You can specify the model parameter.
- RUNTIME: The external runtime manages the model on its own. You cannot specify the model parameter at the same time.', example='PLATFORM'),
    name?: string(name='name', description='The name of the external agent.

This parameter is required.', example='my-external-agent'),
    skills?: [ 
      {
        name?: string(name='name', description='The skill name.

This parameter is required.', example='code-analysis'),
        version?: string(name='version', description='The skill version.', example='1.0.0'),
      }
