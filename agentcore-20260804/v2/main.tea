    version = '2026-08-04',
    protocol = 'HTTPS',
    pathname = `/workspaces/${$URL.percentEncode(workspaceId)}/skill-actions/batch-upload-via-oss`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
