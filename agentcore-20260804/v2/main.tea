model CreateMcpRequest {
  body?: {
    addresses?: [ string ](name='addresses', description='The list of MCP service addresses. Required when Type is DIRECT_PROXY or HTTP_TO_MCP. Do not specify when Type is CODE_PACKAGE.'),
    auth?: {
      codePackage?: {
        apiKey?: string(name='apiKey', description='The API key used to verify MCP callers.', example='example-api-key'),
        headerName?: string(name='headerName', description='The name of the request header that carries the API key.', example='X-API-Key'),
      }(name='codePackage', description='The caller API key authentication configuration for code-deployed MCP.'),
      directProxy?: {
        name?: string(name='name', description='The name.', example='mcp-example'),
        value?: string(name='value', description='The value of the authentication parameter.', example='example-credential'),
      }(name='directProxy', description='The direct proxy authentication configuration.'),
      enabled?: boolean(name='enabled', description='Specifies whether to enable the configuration.'),
      httpToMcp?: [ 
        {
          credential?: string(name='credential', description='The authentication credential.', example='example-credential'),
          id?: string(name='id', description='The authentication scheme ID.', example='mcp-1234567890abcdef'),
          name?: string(name='name', description='The name.', example='mcp-example'),
          position?: string(name='position', description='The position of the credential.', example='header'),
          type?: string(name='type', description='The type.', example='basic'),
        }
      ](name='httpToMcp', description='The list of HTTP_TO_MCP authentication configurations.'),
    }(name='auth', description='The backend authentication configuration. When enabled is set to true: for DIRECT_PROXY, specify directProxy (name/value); for HTTP_TO_MCP, specify the httpToMcp array (each item includes id, type, and credential; for apiKey, position and name are also required), which supports multiple authentication objects where the first one is the default upstream credential; for CODE_PACKAGE, specify codePackage (headerName/apiKey) to verify MCP callers. HTTP_TO_MCP credentials are merged into the securitySchemes of Swagger.'),
    backendMcpProtocol?: string(name='backendMcpProtocol', description='Optional. Valid values: legacy and modern. This parameter is only used for DIRECT_PROXY. If omitted for direct connection, the existing default behavior is maintained and no automatic upgrade is performed. modern does not support SSE. You can use the backendMcpProtocol and protocol recommended by ProbeMcpOrigin to configure backend access, which does not limit the external protocol conversion compatibility of the gateway. No need to pass this parameter for CODE_PACKAGE; valid inputs are ignored and not saved. Function Compute session affinity is configured only based on protocol and DeploymentConfig.McpConfiguration.SessionMode, and the gateway protocol is determined by the successful probing result after Function Compute deployment. Valid values for HTTP_TO_MCP are ignored and not saved.', example='modern'),
    customTags?: [ string ](name='customTags', description='The custom tags. Multiple tags are supported.'),
    deploymentConfig?: {
      accessControl?: {
        credentialId?: string(name='credentialId', description='The ID of the AgentCore credential referenced when the mode is set to CREDENTIAL.', example='credential-id'),
        enabled?: boolean(name='enabled', description='Specifies whether to enable ingress access control.'),
        mode?: string(name='mode', description='The access control mode. ANONYMOUS indicates anonymous access, and CREDENTIAL indicates authentication by using AgentCore credentials.', example='CREDENTIAL'),
      }(name='accessControl', description='The MCP ingress access control configuration.'),
      agentIdentityConfiguration?: {
        authorizationEnabled?: boolean(name='authorizationEnabled', description='Specifies whether to enable authorization.'),
        credentialProviderArn?: string(name='credentialProviderArn', description='The credential provider ARN.', example='acs:agentidentity:cn-hangzhou:1234567890123456:provider/example'),
        credentialProviderType?: string(name='credentialProviderType', description='The credential provider type.', example='oauth2'),
        enabled?: boolean(name='enabled', description='Specifies whether to enable agent identity.'),
      }(name='agentIdentityConfiguration', description='The agent identity configuration.'),
