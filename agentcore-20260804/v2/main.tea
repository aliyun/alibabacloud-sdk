model UpdateExternalAgentRequest {
  body?: {
    description?: string(name='description', description='The description of the managed agent.', example='Code review agent running in the user environment'),
    instruction?: string(name='instruction', description='The agent instructions used to guide the behavior of the agent.', example='You are a code review assistant'),
    model?: {
      modelConnectionId?: string(name='modelConnectionId', description='The model connection ID.

This parameter is required.', example='mc-1'),
      modelName?: string(name='modelName', description='The upstream model name.

This parameter is required.', example='qwen-max'),
      quota?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable the token quota. If this parameter is not specified, the default value is true. If you set this parameter to false, the quota is disabled and existing quota rules are deleted.', example='true'),
        limitType?: string(name='limitType', description='The quota limit type. This parameter is required and verified by the backend when the quota is enabled. Fixed value: token.', example='token'),
        periodType?: string(name='periodType', description='The quota statistical period. This parameter is required and verified by the backend when the quota is enabled. Valid values: day (daily) and month (monthly).', example='day'),
        usageLimit?: long(name='usageLimit', description='The maximum number of tokens allowed to be consumed in a single period. This parameter is required and verified by the backend when the quota is enabled, and must be greater than 0.', example='1000000'),
      }(name='quota', description='The model token quota configuration. If this parameter is not passed, no quota is configured.'),
    }(name='model', description='The model configuration. This parameter is available only when modelSource is set to PLATFORM.'),
    modelSource?: string(name='modelSource', description='The model configuration source. PLATFORM indicates that the platform parses and delivers the model configuration. RUNTIME indicates that the external runtime manages the model itself, and the model parameter cannot be passed at the same time. Valid values: PLATFORM (platform model) and RUNTIME (runtime model).', example='PLATFORM'),
    name?: string(name='name', description='The name of the managed agent.', example='my-external-agent'),
    skills?: [ 
      {
        name?: string(name='name', description='The skill name.

This parameter is required.', example='code-analysis'),
        sourceType?: string(name='sourceType', description='The skill source type. Valid values: REFERENCE (references AI Registry) and STATIC (statically provided with the package).', example='REFERENCE'),
        version?: string(name='version', description='The skill version field compatible with legacy requests. New requests use sourceType and versionSelector, and this parameter is not submitted in combination with sourceType.', example='1.0.0'),
        versionSelector?: {
          type?: string(name='type', description='The version selector type. Valid values: LABEL (by tag) and VERSION (by specific version).', example='LABEL'),
          value?: string(name='value', description='The selector value. When the type is LABEL, the value is the tag name, such as latest. When the type is VERSION, the value is the specific version number.', example='latest'),
        }(name='versionSelector', description='The skill reference version selector, which supports LABEL tags and specific VERSION numbers. If this parameter is omitted, LABEL/latest is used. Selectors are not provided for STATIC sources.'),
      }
    ](name='skills', description='The list of skill configurations.'),
    template?: {
      aiRegistry?: {
        name?: string(name='name', description='The name of the template in AI Registry.

This parameter is required.', example='code-review-template'),
        version?: string(name='version', description='The version of the template in AI Registry.

This parameter is required.', example='1.0.0'),
      }(name='aiRegistry', description='The AI Registry template configuration.'),
    }(name='template', description='The agent template configuration.'),
    tools?: [ 
      {
        name?: string(name='name', description='The tool name.

This parameter is required.', example='code-reviewer'),
        type?: string(name='type', description='The tool type. Valid values: MCP (MCP tool).

This parameter is required.', example='MCP'),
      }
    ](name='tools', description='The list of tool configurations.'),
  }(name='body', description='The request body.'),
  clientToken?: string(name='clientToken', description='The reserved query parameter. The backend does not currently provide idempotence guarantees for deduplication or restoring the original acceptance result based on this identifier.', example='client-token-1'),
