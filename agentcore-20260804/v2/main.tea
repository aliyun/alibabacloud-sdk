async function createExternalAgentBootstrapTokenWithOptions(workspaceId: string, agentId: string, request: CreateExternalAgentBootstrapTokenRequest, headers: map[string]string, runtime: $RuntimeOptions): CreateExternalAgentBootstrapTokenResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.networkType)) {
    query['networkType'] = request.networkType;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'CreateExternalAgentBootstrapToken',
    version = '2026-08-04',
    protocol = 'HTTPS',
    pathname = `/workspaces/${$URL.percentEncode(workspaceId)}/external-agents/${$URL.percentEncode(agentId)}/bootstrap/create`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

