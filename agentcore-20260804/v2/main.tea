      {
        name?: string(name='name', description='The skill name.

This parameter is required.', example='code-analysis'),
        sourceType?: string(name='sourceType', description='The skill source type. Valid values: REFERENCE (references the AI Registry) and STATIC (statically provided with the package).', example='REFERENCE'),
        version?: string(name='version', description='The skill version field for compatibility with legacy requests. For new requests, use sourceType and versionSelector. Do not submit this parameter in combination with sourceType.', example='1.0.0'),
        versionSelector?: {
