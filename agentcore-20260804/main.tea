  description?: string(name='description', description='The description of the MCP service in the language.', example='MCP service for querying knowledge bases'),
  name?: string(name='name', description='The name of the MCP marketplace template in the language.', example='Knowledge base'),
  readme?: string(name='readme', description='The instructions for the MCP marketplace template in the language.', example='# Knowledge base\\\\nKnowledge base query service'),
}

model ItemsI18nValue = {
  description?: string(name='description', description='The MCP service description in the specified language.', example='MCP service for querying knowledge bases'),
  name?: string(name='name', description='The MCP marketplace template name in the specified language.', example='Knowledge Base'),
  readme?: string(name='readme', description='The usage instructions for the MCP marketplace template in the specified language.', example='# Knowledge Base\\\\nKnowledge base query service'),
}

