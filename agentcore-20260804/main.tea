    }(name='saml', description='The input supports either XML or complete manual entry. Queries return standardized configurations and do not echo the original XML. This parameter can be omitted if it is not configured.'),
    syncEnabled?: boolean(name='syncEnabled', description='Specifies whether to enable organization member synchronization. After it is enabled, the external identity provider synchronizes organization members as workspace users.'),
    syncScope?: {
      departmentIds?: [ string ](name='departmentIds', description='When the mode is SelectedDepartments, it must contain at least one non-empty department ID, which should be obtained from ListIdentityProviderDepartments. When the mode is AllAuthorized, pass an empty array or omit this parameter.', example='["10001"]'),
