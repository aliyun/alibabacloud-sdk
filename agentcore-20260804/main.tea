/**
 * @summary Writes messages or text to a memory store. By default, sync is set to true, which synchronously waits for extraction and returns only memories (an empty array is allowed). If sync is set to false, it returns only a taskId that can be queried by using GetMemoryTask.
 *
 * @description Writes messages or text to a memory store to extract long-term memory for subsequent retrieval and use.
 * - sync omitted or set to true: Waits for extraction to complete and returns memories. If no memory is extracted, an empty array is returned.
 * - sync=false: Returns a taskId. You can query the extraction progress and results by using [GetMemoryTask](https://api.aliyun.com/document/AgentCore/2026-08-04/GetMemoryTask).
 *
 * @param tmpReq AddMemoriesRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddMemoriesResponse
 */
async function addMemoriesWithOptions(workspaceId: string, memoryStoreName: string, tmpReq: AddMemoriesRequest, headers: map[string]string, runtime: Util.RuntimeOptions): AddMemoriesResponse {
  Util.validateModel(tmpReq);
  var request = new AddMemoriesShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!Util.isUnset(tmpReq.body)) {
    request.bodyShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.body, 'body', 'json');
  }
  var body : map[string]any = {};
  if (!Util.isUnset(request.bodyShrink)) {
    body['body'] = request.bodyShrink;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'AddMemories',
    version = '2026-08-04',
    protocol = 'HTTPS',
    pathname = `/workspaces/${OpenApiUtil.getEncodeParam(workspaceId)}/memorystores/${OpenApiUtil.getEncodeParam(memoryStoreName)}/memories`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Writes messages or text to a memory store. By default, sync is set to true, which synchronously waits for extraction and returns only memories (an empty array is allowed). If sync is set to false, it returns only a taskId that can be queried by using GetMemoryTask.
 *
 * @description Writes messages or text to a memory store to extract long-term memory for subsequent retrieval and use.
 * - sync omitted or set to true: Waits for extraction to complete and returns memories. If no memory is extracted, an empty array is returned.
 * - sync=false: Returns a taskId. You can query the extraction progress and results by using [GetMemoryTask](https://api.aliyun.com/document/AgentCore/2026-08-04/GetMemoryTask).
 *
 * @param request AddMemoriesRequest
 * @return AddMemoriesResponse
 */
async function addMemories(workspaceId: string, memoryStoreName: string, request: AddMemoriesRequest): AddMemoriesResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return addMemoriesWithOptions(workspaceId, memoryStoreName, request, headers, runtime);
}

