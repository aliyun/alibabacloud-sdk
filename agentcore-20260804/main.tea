/**
 * @summary Queries the departments of an identity provider by page.
 *
 * @description Queries DingTalk or Feishu departments by hierarchy and page. Prerequisites include a bound identity provider, a user pool, valid application credentials, and address book read authorization. If you do not specify parentDepartmentId, the root hierarchy is queried. When expanding a node, specify the ID of the node to query its direct child departments. The hasChildren field indicates whether the node can be expanded and does not mean that child nodes are returned. The nextToken field is used only to query the next page of child departments under the current parent department. This query only reads the directory. It does not save the synchronization scope or import users. If a new department is added to a DingTalk or Feishu organization, re-query the corresponding parent department because the previous list does not reflect the latest directory.\\n\\nAuthorization information: The RAM action is agentcore:ListIdentityProviderDepartments, the access level is List, and the resource ARN is acs:agentcore:{regionId}:{accountId}:workspace/{workspaceId}/identityProvider/{identityProviderType}. This resource is required for authorization.\\n\\nIdempotency and retry: This operation is read-only and can be called repeatedly.\\n\\nCalling this API is free of charge. Operation records support ActionTrail auditing.\\n\\nResponse example:\\n```json\\n{\\n  "requestId": "01234567-89AB-CDEF-0123-456789ABCDEF",\\n  "message": "success",\\n  "httpStatusCode": 200,\\n  "code": "SUCCESS",\\n  "success": true,\\n  "maxResults": 50,\\n  "nextToken": "",\\n  "items": [\\n    {\\n      "id": "10001",\\n      "name": "R&D Department",\\n      "parentId": "1",\\n      "memberCount": 12,\\n      "hasChildren": true\\n    }\\n  ]\\n}\\n```
 *
 * @param request ListIdentityProviderDepartmentsRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ListIdentityProviderDepartmentsResponse
 */
async function listIdentityProviderDepartmentsWithOptions(workspaceId: string, identityProviderType: string, request: ListIdentityProviderDepartmentsRequest, headers: map[string]string, runtime: Util.RuntimeOptions): ListIdentityProviderDepartmentsResponse {
  Util.validateModel(request);
  var query : map[string]any = {};
  if (!Util.isUnset(request.maxResults)) {
    query['maxResults'] = request.maxResults;
  }
  if (!Util.isUnset(request.nextToken)) {
    query['nextToken'] = request.nextToken;
  }
  if (!Util.isUnset(request.parentDepartmentId)) {
    query['parentDepartmentId'] = request.parentDepartmentId;
  }

