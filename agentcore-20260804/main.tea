  var params = new OpenApi.Params{
    action = 'DeleteIdentityProvider',
    version = '2026-08-04',
    protocol = 'HTTPS',
    pathname = `/workspaces/${OpenApiUtil.getEncodeParam(workspaceId)}/identity-providers/${OpenApiUtil.getEncodeParam(identityProviderType)}`,
    method = 'DELETE',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

