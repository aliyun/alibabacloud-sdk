      }(name='configuration', description='The runtime harness configuration.'),
      type?: string(name='type', description='The runtime harness type.', example='qodercli'),
    }(name='harness', description='The agent runtime harness.'),
    instruction?: string(name='instruction', description='The agent instruction that guides the behavior of the agent.', example='You are a code review assistant'),
    model?: {
      modelConnectionId?: string(name='modelConnectionId', description='The model connection ID.

This parameter is required.', example='mc-1'),
      modelName?: string(name='modelName', description='The upstream model name.', example='qwen-max'),
      quota?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable the token quota. Default value: true. Set to false to disable and delete existing quota rules.', example='true'),
        limitType?: string(name='limitType', description='The quota limit type. Required when the quota is enabled, as validated by the backend. Fixed value: token.', example='token'),
        periodType?: string(name='periodType', description='The statistical period for the quota. Required when the quota is enabled, as validated by the backend. Valid values: day (daily) and month (monthly).', example='day'),
        usageLimit?: long(name='usageLimit', description='The maximum number of tokens that can be consumed within a single period. Required when the quota is enabled, as validated by the backend. The value must be greater than 0.', example='1000000'),
      }(name='quota', description='The model token quota configuration. If not specified, no quota is configured.'),
    }(name='model', description='The model configuration.'),
