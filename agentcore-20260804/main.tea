      }(name='accessInternet', description='The public network access configuration.'),
      accessVpc?: {
        enabled?: boolean(name='enabled', description='Specifies whether to allow VPC access.', example='true'),
      }(name='accessVpc', description='The VPC access configuration.'),
    }(name='network', description='The network configuration.'),
    ossMounts?: [ 
      {
        bucketName?: string(name='bucketName', description='The OSS bucket name. Required for each mount item as validated by the backend.', example='bucket-001'),
        mountPath?: string(name='mountPath', description='The absolute mount path in the container. Required for each mount item as validated by the backend.', example='/mnt/oss/datasets'),
        path?: string(name='path', description='The relative object prefix within the bucket. If not specified, the entire bucket is mounted.', example='datasets'),
        readOnly?: boolean(name='readOnly', description='Specifies whether to mount in read-only mode. Default value: false.'),
      }
    ](name='ossMounts', description='The list of OSS mounts. A maximum of 10 items are allowed. Pass an empty array to clear existing mounts.'),
