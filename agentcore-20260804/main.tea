/**
 *
 */
import Util;
import GatewayClient;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @productId = 'AgentCore';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('agentcore', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model DataResourceValue = {
  content?: string(name='content', description='The content.', example='Sample content'),
  metadata?: map[string]any(name='metadata', description='The metadata.'),
  name?: string(name='name', description='The name.', example='agentspec-example'),
  type?: string(name='type', description='The type.', example='file'),
}

