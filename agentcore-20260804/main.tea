    }(name='scope', description='The write scope. UserId, AgentId, and SessionId are all optional.'),
    sync?: boolean(name='sync', description='Specifies whether to synchronously wait for memory extraction to complete. Default value: true.'),
    text?: string(name='text', description='The text to write directly. You must provide either this parameter or Messages, but not both. The size cannot exceed 32,000 UTF-8 bytes.', example='The user likes hiking'),
  }(name='body', description='The memory write request.

This parameter is required.'),
}

