  if (!Util.isUnset(request.bodyShrink)) {
    body['body'] = request.bodyShrink;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'BatchUploadSkillsViaOss',
    version = '2026-08-04',
    protocol = 'HTTPS',
    pathname = `/workspaces/${OpenApiUtil.getEncodeParam(workspaceId)}/skill-actions/batch-upload-via-oss`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
