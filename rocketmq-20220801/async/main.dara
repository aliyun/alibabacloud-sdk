      deliveryOrderType?: string(name='deliveryOrderType', description='The delivery order of messages to the target instance. Valid values for the parameter:
- Concurrently: concurrent delivery
- Orderly: ordered delivery', example='Concurrently'),
      instanceId?: string(name='instanceId', description='The instance ID. If instanceType is set to EXTERNAL_ROCKETMQ, an instance ID is automatically generated. You can obtain this ID by querying the backup plan.', example='rmq-cn-em93y94xxx'),
      instanceType?: string(name='instanceType', description='The instance type. Valid values:
