model CreateConsumerGroupRequest {
  instanceId: string(name='instanceId', description='The instance ID of the instance to which the consumer group to be created belongs.

This parameter is required.', example='rmq-cn-7e22ody****', position='Path'),
  consumerGroupId: string(name='consumerGroupId', description='The ID of the consumer group to be created. Used as the identity of the consumer group, which is globally unique.

Valid values:

- Character restrictions: letters a~z or A~Z, digits 0~9, underscores (_), and hyphens (-).
- Length restrictions: 1 to 60 characters.

For reserved word restrictions, see [Parameter limits](https://help.aliyun.com/document_detail/440347.html).

This parameter is required.', example='GID_test_groupId', position='Path'),
  consumeRetryPolicy: {
    deadLetterTargetTopic?: string(name='deadLetterTargetTopic', description='The dead-letter topic.

If a consumer fails to consume a message and the message still failed after retries, the message is delivered to the dead-letter topic for subsequent business recovery or backtracking. For more information, see [Consumption retry and dead-letter messages](https://help.aliyun.com/document_detail/440356.html).', example='DLQ_mqtest'),
    fixedIntervalRetryTime?: int32(name='fixedIntervalRetryTime', description='The fixed retry interval, in seconds. This parameter takes effect when the retry policy is set to FixedRetryPolicy.

Valid values:
- Concurrent delivery: 10 to 1800
- Ordered delivery: 1 to 600', example='10'),
    maxRetryTimes?: int32(name='maxRetryTimes', description='The maximum number of retry attempts.', example='16'),
    retryPolicy: string(name='retryPolicy', description='The retry policy type. For more information, see [Message retry](https://help.aliyun.com/document_detail/440356.html).

Valid parameter values:
- FixedRetryPolicy: fixed-interval retry, supported only for ordered delivery
- DefaultRetryPolicy: progressive backoff retry, supported only for concurrent delivery

This parameter is required.', example='DefaultRetryPolicy'),
  }(name='consumeRetryPolicy', description='The consumption retry policy of the consumer group to be created. For more information, see [Consumption retry](https://help.aliyun.com/document_detail/440356.html).

This parameter is required.', position='Body'),
  deliveryOrderType: string(name='deliveryOrderType', description='The delivery order type of the consumer group to be created.

Valid parameter values:
- Concurrently: concurrent delivery
- Orderly: ordered delivery

This parameter is required.', example='Concurrently', position='Body'),
  exclusive?: boolean(name='exclusive', description='Specifies whether to enable exclusive subscription, which means a LiteTopic can only be subscribed to by one consumer. Set to true to enable or false to shutdown.', position='Body'),
  maxReceiveTps?: long(name='maxReceiveTps', description='The maximum TPS for consuming messages.', example='1000', position='Body'),
  messageModel?: string(name='messageModel', description='The subscribe pattern for consumers:
- CLUSTERING: clustering consumption pattern. All consumers in the ConsumerGroup share the same subscription.
- LITE_SELECTIVE: lightweight consumption pattern. Consumers in the ConsumerGroup can have different subscriptions.', example='LITE_SELECTIVE', position='Body'),
  remark?: string(name='remark', description='The remarks for the consumer group to be created.', example='This is the remark for test.', position='Body'),
  topicName?: string(name='topicName', description='The name of the lite-type topic to subscribe to when using the LITE_SELECTIVE consumption pattern.', example='liteTopicTest', position='Body'),
}

