  - EXTERNAL_ROCKETMQ: external instance, open-source instance, or open-source cluster', example='ALIYUN_ROCKETMQ'),
      regionId?: string(name='regionId', description='The region ID.', example='cn-hangzhou'),
      topicName?: string(name='topicName', description='The name of the disaster recovery topic. Required.', example='Topic_xxx'),
    }
  ](name='topics', description='The topics included in the backup mapping. Required.', position='Body'),
}

