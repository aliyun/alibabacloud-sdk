init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'SWAS-OPEN';
  @version = '2020-06-01';
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-northeast-1' = 'swas.ap-northeast-1.aliyuncs.com',
    'ap-northeast-2' = 'swas.ap-northeast-2.aliyuncs.com',
