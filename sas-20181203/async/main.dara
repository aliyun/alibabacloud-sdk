  type?: string(name='Type', description='The type of the leaked information. The value is fixed as **AccessKey**.', example='AccessKey'),
  whitelistStatus?: string(name='WhitelistStatus', description='Indicates whether the AccessKey pair leak event is added to the whitelist. Valid values:

