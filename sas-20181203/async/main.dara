  gmtCreate?: string(name='GmtCreate', description='The time when the AccessKey pair leak event was first discovered.', example='2021-07-06 17:49:41'),
  gmtModified?: string(name='GmtModified', description='The most recent discovery time of the leak event.', example='2021-07-06 17:49:39'),
  remark?: string(name='Remark', description='The remarks of the AccessKey pair leak event.', example='12'),
  requestId?: string(name='RequestId', description='The request ID. Alibaba Cloud generates a unique identifier for each API request. You can use this ID to troubleshoot issues.', example='79CFF74D-E967-5407-8A78-EE03B925FDAA'),
  source?: string(name='Source', description='The intelligence source of the AccessKey pair leak event.', example='GitHub'),
  tokenValid?: int32(name='TokenValid', description='The validity of the key associated with the AccessKey pair. Valid values:

