  appNum?: int32(name='AppNum', description='The number of application vulnerabilities. This field is 0 when ImageVul is set to true.', example='0'),
  scaNum?: int32(name='ScaNum', description='The number of software composition analysis (SCA) vulnerabilities.', example='2'),
  vulAsapSum?: int32(name='VulAsapSum', description='The number of high-priority vulnerabilities.', example='1'),
  vulLaterSum?: int32(name='VulLaterSum', description='The number of medium-priority vulnerabilities.', example='1'),
  vulNntfSum?: int32(name='VulNntfSum', description='The number of low-priority vulnerabilities.', example='1'),
  sysAsapNum?: int32(name='SysAsapNum', description='The number of high-priority system vulnerabilities among Linux software vulnerabilities and Windows system vulnerabilities.', example='1'),
}

