  statusList?: string(name='StatusList', description='The fix status of the vulnerability. Valid values:
- **1**: unfixed
- **4**: being fixed
- **7**: fixed.', example='1'),
  tag?: string(name='Tag', description='The tag of the container image.', example='oval'),
  type?: string(name='Type', description='The type of vulnerability to query. Set the value to **cve**, which indicates container image vulnerabilities.

This parameter is required.', example='cve'),
