  policyVersion?: string(name='PolicyVersion', description='The version of the policy. Set the value to **2.0.0**.

This parameter is required.', example='2.0.0'),
  selectType?: string(name='SelectType', description='The method used to cover assets. Valid values:
- **ALL_MACHINE**: All assets.
