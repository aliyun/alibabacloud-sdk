    body['params'] = request.params;
  }

  var realHeaders : map[string]string = {};
  if (!Util.isUnset(headers.commonHeaders)) {
    realHeaders = headers.commonHeaders;
  }
  if (!Util.isUnset(headers.accept)) {
    realHeaders['Accept'] = Util.toJSONString(headers.accept);
  }
  if (!Util.isUnset(headers.xDashScopeSSE)) {
    realHeaders['X-DashScope-SSE'] = Util.toJSONString(headers.xDashScopeSSE);
  }
  if (!Util.isUnset(headers.xGWAccess)) {
    realHeaders['X-GW-Access'] = Util.toJSONString(headers.xGWAccess);
  }
  if (!Util.isUnset(headers.xGWNonce)) {
    realHeaders['X-GW-Nonce'] = Util.toJSONString(headers.xGWNonce);
  }
  if (!Util.isUnset(headers.xGWProtocol)) {
    realHeaders['X-GW-Protocol'] = Util.toJSONString(headers.xGWProtocol);
  }
  if (!Util.isUnset(headers.xGWSignature)) {
    realHeaders['X-GW-Signature'] = Util.toJSONString(headers.xGWSignature);
  }
  if (!Util.isUnset(headers.xGWTimestamp)) {
    realHeaders['X-GW-Timestamp'] = Util.toJSONString(headers.xGWTimestamp);
  }
  if (!Util.isUnset(headers.xRequestId)) {
    realHeaders['X-Request-Id'] = Util.toJSONString(headers.xRequestId);
  }
  var req = new OpenApi.OpenApiRequest{ 
    headers = realHeaders,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'Chat',
