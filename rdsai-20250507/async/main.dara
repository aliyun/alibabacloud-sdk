import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'RdsAi';
  @version = '2025-05-07';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-wulanchabu' = 'rdsai.aliyuncs.com',
    'cn-shenzhen' = 'rdsai.aliyuncs.com',
    'cn-beijing' = 'rdsai.aliyuncs.com',
    'cn-shanghai' = 'rdsai.aliyuncs.com',
    'cn-guangzhou' = 'rdsai.aliyuncs.com',
    'cn-hangzhou' = 'rdsai.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model ChatMessagesRequest {
  conversationId?: string(name='ConversationId', description='The conversation ID.', example='fea7bdca-e848-44dd-b1ae-852472b8****', position='Query'),
  eventMode?: string(name='EventMode', description='The event output type. Valid values: inline and separate. Default value: inline. When set to inline, tool invocation events, sub-node events, and document events are included in the answer field of the event = message response. When set to separate, tool invocation events, sub-node events, and document events each have their own event.', example='inline', position='Query'),
  files?: [ 
    {
      transferMethod?: string(name='TransferMethod'),
      type?: string(name='Type'),
      uploadFileId?: string(name='UploadFileId'),
    }
  ](name='Files', shrink='json', position='Query'),
  inputs?: {
    customAgentId?: string(name='CustomAgentId', description='The custom agent ID for the user.', example='d1b7d639-f34e-44c7-8231-987da14d****'),
    enableThinking?: string(name='EnableThinking', description='Specifies whether to enable deep thinking mode.', example='true'),
    language?: string(name='Language', description='The conversation language.', example='zh-cn'),
    modelId?: string(name='ModelId', description='The model ID.', example='qwen3.7-max'),
    regionId?: string(name='RegionId', description='The region ID.', example='cn-beijing'),
    resumeCallId?: string(name='ResumeCallId', description='The tool approval call ID for resuming execution. Pass this parameter after all decisions in the current approval round are completed in the console to continue the interrupted ChatMessage Loop. Do not pass this parameter for regular conversations.', example='call-example'),
    thinkEffort?: string(name='ThinkEffort', description='The thinking depth.', example='default'),
    timezone?: string(name='Timezone', description='The time zone. Default value: **Asia/Shanghai**.', example='UTC'),
    toolApprovalMode?: string(name='ToolApprovalMode', description='The tool approval mode for the current conversation. Valid values: read_only (read-only, write tools are rejected), manual (write tools require manual approval), and auto (the approval sub-agent automatically determines the action. If the result is needs_human, the approval is escalated to manual review). When this parameter is passed, the approval mode of the current conversation is updated.', example='manual'),
    workspaceId?: string(name='WorkspaceId', description='The ContextDB workspace ID.', example='00000000-0000-4000-8000-000000000001'),
  }(name='Inputs', description='The task inputs.', shrink='json', position='Query'),
  parentMessageId?: string(name='ParentMessageId', description='The parent message ID.', example='84dc9f9b-424a-404d-9c36-35e9d000****', position='Query'),
  query?: string(name='Query', description='The query content.', example='Check the disk usage of instance rm-bp14as9914vd3**** and whether storage expansion is needed', maxLength=65536, position='Query'),
}

model ChatMessagesResponseBody = {
  answer?: string(name='Answer', description='The answer content.', example='The disk usage of instance rm-bp14as9914vd3**** is 23%, and storage expansion is not needed at this time. If you need to view the detailed configuration, performance monitoring, or perform other operations for an instance, let me know your specific requirements!'),
  approvalStatus?: string(name='ApprovalStatus', description='The tool invocation approval status.', example='pending'),
  callId?: string(name='CallId', description='The tool invocation ID.', example='call-example'),
  conversationId?: string(name='ConversationId', description='The conversation ID.', example='9cbbe885-b240-4803-9d15-6781a3fd****'),
  createdAt?: long(name='CreatedAt', description='The creation time.', example='1763986004'),
  description?: string(name='Description', description='The tool invocation description.', example='Search ContextDB records'),
  event?: string(name='Event', description='The event.', example='MysqlIOException'),
  id?: string(name='Id', description='The message ID.', example='60b335ca-124d-4ee1-864b-de554987****'),
  messageId?: string(name='MessageId', description='The message ID.', example='oas8pwy2-slxw-sf98-bx83-cb2hkktl****'),
  mode?: string(name='Mode', description='The query mode.', example='This field will be deprecated in the future. Ignore it'),
  requestId?: string(name='RequestId', description='The request ID.', example='FE9C65D7-930F-57A5-A207-8C396329****'),
  roundId?: string(name='RoundId', description='The tool approval round ID.', example='round-example'),
  taskId?: string(name='TaskId', description='The asynchronous task ID.', example='01c3d43d-9466-4bd5-8196-4cbbce08****'),
  toolArguments?: map[string]any(name='ToolArguments', description='The tool invocation parameters.'),
  toolName?: string(name='ToolName', description='The tool name.', example='contextdb.search'),
}

model ChatMessagesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ChatMessagesResponseBody(name='body'),
}

/**
  * @param request  the request parameters of ChatMessages  ChatMessagesRequest
  * @return ChatMessagesResponse
 */
async function chatMessages(request: ChatMessagesRequest): ChatMessagesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ChatMessages', 'POST', '/v1/chat-messages', 'json', false, 'json', request);
}

function chatMessagesWithResponseIterable(request: ChatMessagesRequest): iterator[ChatMessagesResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'ChatMessages', 'POST', '/v1/chat-messages', 'json', false, 'json', request);
}

