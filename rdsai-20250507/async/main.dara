- **fixed**: By fixed value.

- **ratio**: By percentage.

- **auto**: Automatic allocation.', example='fixed'),
        roleArn?: string(name='RoleArn'),
        tokenQuota?: long(name='TokenQuota', description='The quota limit for the current key.', example='100000'),
      }
    ](name='CustomKeyList', description='The list of custom API keys.'),
    systemApiKey?: string(name='SystemApiKey', description='The system-generated key.', example='sk-rds-xxx'),
  }(name='Data', description='The response data.'),
  message?: string(name='Message', description='The response message.', example='success'),
  requestId?: string(name='RequestId', description='Id of the request', example='FE9C65D7-930F-57A5-A207-8C396329****'),
  success?: boolean(name='Success', description='The request result.', example='true'),
}

