  endTime?: string(name='EndTime', description='带时区的 ISO 8601 结束时间，整秒精度，默认当前时间；应大于开始时间且不晚于当前时间，区间左闭右开。', example='2026-11-06T00:00:00+08:00'),
  gatewayRegion?: string(name='GatewayRegion', description='网关日志地域：cn-shanghai（国内）、cn-hongkong（香港）、ap-southeast-1（新加坡）、us-east-1（美国）；兼容 cn-hangzhou，仅查询路由等同 cn-shanghai；杭州预发实际数据地域为 cn-hangzhou。不传时使用当前站点默认地域；预发只查询预发日志，国内映射杭州预发，美国预发未配置时返回 ServiceUnavailable。', example='cn-shanghai'),
  modelId?: string(name='ModelId', description='可选请求模型 ID；不传或空白时不筛选，非空时精确匹配 custom_log.requestedModel 或 ai_log.request_model 任一字段，与 SearchRequestId、WyIds 等条件取交集。不按 ai_log.model 筛选，不支持模糊匹配。', example='example-model'),
  pageNumber?: int32(name='PageNumber', description='页码，从 1 开始；分页偏移超过查询上限时返回 InvalidParameter。', example='1'),
  pageSize?: int32(name='PageSize', description='每页返回数量，最大 50。', example='10'),
  searchRequestId?: string(name='SearchRequestId', description='可选请求 ID；不传或空白时不筛选，非空时精确匹配 SLS request_id，与 ModelId、WyIds 等条件取交集。不得包含控制字符或管道符。', example='model-call-example-001'),
  startTime?: string(name='StartTime', description='带时区的 ISO 8601 开始时间，整秒精度，默认 UTC+8 今日零点；不得早于当前时间按 UTC+8 回退 3 个自然月，区间不超过 30 天。', example='2026-11-05T00:00:00+08:00'),
  wyIds?: [ string ](name='WyIds', description='可选用户 ID 列表，最多 50 项；不传或空数组时不筛选。非空时精确匹配 custom_log.wyId，列表内取 OR，与租户、BizType、SearchRequestId 和 ModelId 条件取 AND。每项去除首尾空白后为 1 至 128 个字符，不允许控制字符或管道符。', example='["wy-example-001"]'),
}

