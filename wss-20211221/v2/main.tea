import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'wss';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('wss', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CreateMultiOrderRequest {
  channelCookie?: string(name='ChannelCookie', description='The cookie information used for channel attribution. Specify this parameter if channel attribution information exists. Otherwise, you can leave it empty.', example='channel=example'),
  orderItems?: [ 
    {
      amount?: int32(name='Amount', description='The purchase quantity.', example='1'),
      autoPay?: boolean(name='AutoPay', description='Specifies whether to enable automatic payment.', example='true'),
      autoRenew?: boolean(name='AutoRenew', description='Specifies whether to enable auto-renewal.', example='false'),
      buyChange?: boolean(name='BuyChange', description='Specifies whether to modify the configuration of the monthly duration package.', example='true'),
      components?: [ 
        {
          key?: string(name='Key', description='The key of the module.', example='RegionId'),
          value?: string(name='Value', description='The value of the module.

The sample values and valid values for each key of the monthly duration package for Enterprise Edition are as follows:

- RegionId: cn-shanghai
- InstanceType: eds.enterprise_office.4c8g
- DurationType (hours): [Enum] 
   - 120
   - 250
- OsType: [Enum] 
   - Windows
   - Linux
- RootDiskSize (GiB): 80
- RootDiskCategory: [Enum] 
   - cloud_efficiency (ultra cloud disk)
   - cloud_auto (ESSD AutoPL cloud disk)
   - cloud_essd (enhanced standard SSD, supported only by specific instance types)
- RootPerformanceLevel: [Enum] 
   - PL0
   - PL1
   - PL2
   - PL3
- DataDiskSize (GiB): Valid values are the same as those of RootDiskSize.
- DataDiskCategory: Valid values are the same as those of RootDiskCategory.
- DataPerformanceLevel: Valid values are the same as those of RootPerformanceLevel.', example='cn-shanghai'),
        }
      ](name='Components', description='The product modules.'),
      instanceIds?: [ string ](name='InstanceIds', description='The list of instance IDs.'),
      paidCallBackUrl?: string(name='PaidCallBackUrl', description='The callback URL after the order is paid. Specify the URL to receive the payment result based on your business requirements.', example='https://example.com/order/paid'),
      period?: int32(name='Period', description='The subscription period. Valid values:

- If `PeriodUnit` is set to `Year`, valid values are 1, 2, 3, and 5.

- If `PeriodUnit` is set to `Month`, valid values are 1, 2, 3, and 6.', example='1'),
      periodUnit?: string(name='PeriodUnit', description='The unit of the subscription period for the subscription instance.

> This parameter is required only when the billing method of the instance is subscription. This parameter is case-sensitive. Make sure that the spelling is correct.', example='Year'),
      promotionId?: string(name='PromotionId', description='The ID of the promotion.', example='youhuiquan_promotion_option_id_for_blank'),
      resourceIds?: [ string ](name='ResourceIds', description='The list of resource IDs.
> For the monthly duration package, this parameter corresponds to the cloud desktop ID. This parameter is required when OrderType is not set to `create`.'),
      resourceType?: string(name='ResourceType', description='The resource type.
> This parameter is case-sensitive. Make sure that the spelling is correct.

This parameter is required.', example='DurationPackage'),
      unifiedExpireDay?: int32(name='UnifiedExpireDay', description='The unified expiration date, which can be a day from the 1st to the 28th of a month. If this parameter is not specified, the standard renewal process is applied.', example='15'),
    }
  ](name='OrderItems', description='The product information.'),
  orderType?: string(name='OrderType', description='The order type.', example='create'),
  properties?: map[string]string(name='Properties', description='The extended properties.'),
  resellerOwnerUid?: long(name='ResellerOwnerUid', description='The ID of the actual end user. This parameter is required when a reseller partner places an order.', example='100000000001'),
}

