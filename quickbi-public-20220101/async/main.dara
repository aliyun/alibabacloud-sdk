model AddUserRequest {
  accountId?: string(name='AccountId', description='The Alibaba Cloud account ID.
>Warning: For Quick BI versions released after December 31, 2024, AccountId is a required parameter. Update your API calls before this date.', example='191476xxxxx23754', position='Query'),
