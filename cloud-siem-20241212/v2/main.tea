AND (
    proc_path LIKE \\\\"%/groups\\\\"
    OR (
        (
            proc_path LIKE \\\\"%/cat\\\\"
            OR proc_path LIKE \\\\"%/head\\\\"
            OR proc_path LIKE \\\\"%/tail\\\\"
            OR proc_path LIKE \\\\"%/more\\\\"
        )
        AND cmdline LIKE \\\\"%/etc/group%\\\\"
    )
)'),
  detectionExpressionType?: string(name='DetectionExpressionType', description='The expression type of the detection rule. Valid values:
- sql: SQL
- playbook: playbook', example='sql'),
  detectionRuleDescription?: string(name='DetectionRuleDescription', description='The description of the detection rule.', example='dr-123'),
  detectionRuleName?: string(name='DetectionRuleName', description='The name of the detection rule.', example='dr-ha1i09ob3zmqrs85****'),
