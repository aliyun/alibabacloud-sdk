    outputTokens?: long(name='OutputTokens', description='The number of tokens used for output.', example='856'),
    reasoningTokens?: long(name='ReasoningTokens', description='The number of reasoning tokens used on the current day.', example='420'),
    retryAllowed?: boolean(name='RetryAllowed', description='Indicates whether a retry is allowed.'),
    status?: string(name='Status', description='The status of the conversation turn.', example='success'),
