  * @return GetIncidentInvestigationResponse
 */
async function getIncidentInvestigation(request: GetIncidentInvestigationRequest): GetIncidentInvestigationResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetIncidentInvestigation', 'POST', '/', 'json', true, 'form', request);
}

