  bizId?: string(name='BizId', description='The business order ID of the caller. This ID is recorded when the request is accepted and returned as-is when you query the result of the asynchronous task.', example='order-20260928-001'),
  imageUrl?: string(name='ImageUrl', description='The URL of the original image. The image must be in JPG, JPEG, PNG, BMP, or WEBP format. The resolution must be between 256×256 and 3000×3000 pixels, and the file size cannot exceed 10 MB.

This parameter is required.', example='"https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg"'),
  mask?: string(name='Mask', description='The specific area to remove. This parameter must be used in combination with the editor, and the input format is RLE. If this parameter is specified, it takes precedence and the remove_non_product_area_elements and remove_product_area_elements parameters are ignored. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage. If multiple parameters are specified, the priority is as follows: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='"474556 160 475356 160 476156 160 476956 160 477756 160 478556 160 479356 160 480156 160 480956 160 481756 160 482556 160 483356 160 484156 160 484956 160 485756 160 486556 160 487356 160 488156 160 488956 160 489756 160 490556 160 491356 160 492156 160"'),
  nonObjectRemoveElements?: [ int32 ](name='NonObjectRemoveElements', description='The types of elements to remove from the image background.', example='[1,2,4]'),
  objectRemoveElements?: [ int32 ](name='ObjectRemoveElements', description='The types of elements to remove from the image subject. Valid values:
- 1: Transparent text blocks.
- 2: Specific names.
- 3: Text.
- 4: Watermarks.
You can select multiple element types. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage. If multiple parameters are specified, the priority is as follows: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements. For more information about each type, see the product documentation. Image subject: the core product area in the image.', example='[1,2,4]'),
  position?: string(name='Position', description='The specific area to remove. This parameter must be used in combination with the editor, and the input format is four-point coordinates [xx,yy,zz,dd]. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage. If multiple parameters are specified, the priority is as follows: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='[10,20,100,200]'),
  userImage?: [ string ](name='UserImage', description='The URLs of user-specified image elements to remove.'),
  userText?: [ string ](name='UserText', description='The user-specified text strings to remove.'),
}

