/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'Aidge';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('aidge', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AddDisplayKnowledgeRequest {
  ragId?: string(name='RagId', description='The knowledge base ID.

This parameter is required.', example='rag_xxx'),
  records?: [ 
    {
      imageUrl?: string(name='ImageUrl', description='The HTTP or HTTPS URL of the product image.', example='https://xxxx/img_1784599244373_9c2309a0.jpg'),
      skuId?: string(name='SkuId', description='The SKU ID. If this parameter is left empty, the platform generates an ID.', example='sku-001'),
      skuName?: string(name='SkuName', description='The SKU name.', example='Product front image'),
    }
  ](name='Records', description='The records to add. A maximum of 500 records are supported.

This parameter is required.'),
}

model AddDisplayKnowledgeShrinkRequest {
  ragId?: string(name='RagId', description='The knowledge base ID.

This parameter is required.', example='rag_xxx'),
  recordsShrink?: string(name='Records', description='The records to add. A maximum of 500 records are supported.

This parameter is required.'),
}

model AddDisplayKnowledgeResponseBody = {
  code?: string(name='Code', description='The error code.', example='success'),
  data?: {
    acceptedCount?: int32(name='AcceptedCount', description='The number of accepted records.', example='10'),
    errorCode?: string(name='ErrorCode', description='The business error code.', example='success'),
    errorMessage?: string(name='ErrorMessage', description='The business error message.', example='Success'),
    failedCount?: int32(name='FailedCount', description='The number of failed records.', example='0'),
    knowledgeBaseStatus?: string(name='KnowledgeBaseStatus', description='The knowledge base status.', example='UPDATING-Updating
AVAILABLE-Available
UNAVAILABLE-Unavailable'),
    ragId?: string(name='RagId', description='The knowledge base ID.', example='rag_xxxx'),
    results?: [ 
      {
        errorCode?: string(name='ErrorCode', description='The error code for the failure.', example='Success'),
        errorMessage?: string(name='ErrorMessage', description='The reason for the failure.', example='The deviceName format is incorrect.'),
        index?: int32(name='Index', description='The index of the record in the original request array.', example='3'),
        recordId?: long(name='RecordId', description='The record ID.', example='204737029000011'),
        skuId?: string(name='SkuId', description='The effective SKU ID.', example='sku-001'),
        status?: string(name='Status', description='The record status.', example='UPDATING-Updating
EMBEDDED-Vectorization completed
FAILED-Failed'),
        success?: boolean(name='Success', description='Indicates whether the record was accepted.', example='True'),
      }
    ](name='Results', description='The processing result of each record.'),
    success?: boolean(name='Success', description='Indicates whether the business processing was successful.', example='True'),
    taskId?: string(name='TaskId', description='The asynchronous task ID. This parameter is empty for synchronous API operations.', example='0ea3b66e88a543658520c994f08896a0'),
    usageMap?: map[string]long(name='UsageMap', description='The usage information. This parameter is empty for free API operations.', example='{"ProcessedImageCount":1}'),
  }(name='Data', description='The result of adding content to the display knowledge base.'),
  message?: string(name='Message', description='The returned message or failure description.', example='Success'),
  requestId?: string(name='RequestId', description='The request ID.', example='E1AD60F1-BAC7-546B-9533-E7AD02B16E3F'),
  success?: boolean(name='Success', description='Indicates whether the call was successful.', example='True'),
}

model AddDisplayKnowledgeResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDisplayKnowledgeResponseBody(name='body'),
}

/**
 * @summary Synchronously adds content to a display knowledge base in batches.
 *
 * @param tmpReq AddDisplayKnowledgeRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddDisplayKnowledgeResponse
 */
@context("addDisplayKnowledgeWithContext")
async function addDisplayKnowledgeWithOptions(tmpReq: AddDisplayKnowledgeRequest, runtime: $RuntimeOptions): AddDisplayKnowledgeResponse {
  tmpReq.validate();
  var request = new AddDisplayKnowledgeShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!$isNull(tmpReq.records)) {
    request.recordsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.records, 'Records', 'json');
  }
  var query = {};
  if (!$isNull(request.ragId)) {
    query['RagId'] = request.ragId;
  }
  if (!$isNull(request.recordsShrink)) {
    query['Records'] = request.recordsShrink;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddDisplayKnowledge',
    version = '2026-04-28',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Synchronously adds content to a display knowledge base in batches.
 *
 * @param request AddDisplayKnowledgeRequest
 * @return AddDisplayKnowledgeResponse
 */
async function addDisplayKnowledge(request: AddDisplayKnowledgeRequest): AddDisplayKnowledgeResponse {
  var runtime = new $RuntimeOptions{};
  return addDisplayKnowledgeWithOptions(request, runtime);
}

model AiTryOnRequest {
  clothImageUrl?: string(name='ClothImageUrl', description='The list of product image URLs. Required for single-item and multi-item outfit scenarios.   
• Single-item: Pass images of the same product from different angles. The standard edition supports up to two product images, but requires that all images contain one and only one main product. We recommend using product images with a white background.   
• Multi-item outfit: Pass images of all products to be worn. The standard edition supports up to two product images (each image can contain multiple products). A single outfit can include up to six clothing items and accessories.   
Note: For the clothing replacement, face replacement, and pose replacement modes, specify only one mode per call. Do not upload parameters for multiple modes simultaneously.', example='https://ae01.alicdn.com/kf/S3470dc9f4be09a6cbed34e90dc8fs.jpg'),
  clothType?: string(name='ClothType', description='Specifies the product types for the current try-on request. You can specify multiple types at a time. If you do not specify this parameter, the system automatically identifies all supported categories in the product images. Valid values: tops, outwear, bottoms, dresses, tops and bottoms, socks, shoes, hats, earrings, necklaces, braceles, scarves, bags, and glasses.', example='tops'),
  mode?: string(name='Mode', description='The try-on mode, which determines the maximum number of product images and outfit items. Currently, only `lite` is supported.', example='lite'),
  modelImageUrl?: string(name='ModelImageUrl', description='● The URL of the model scene image. Only one image is supported.   
● The image must support public network access over HTTP or HTTPS.   
● Supported formats: JPG, JPEG, PNG, BMP, and WEBP.   
● The width and height must be between 256 and 2049 pixels.   
● The size of a single file cannot exceed 10 MB.

This parameter is required.', example='https://example.com/model.jpg\\\\'),
  modelTemplateUrl?: string(name='ModelTemplateUrl', description='The URL of the model template image. Only one image is supported. This image provides reference identity information such as gender, skin color, age, and body type.   
Required for the model skin replacement scenario. Do not specify this parameter for the clothing replacement or pose replacement scenarios. For the clothing replacement, face replacement, and pose replacement modes, specify only one mode per call. Do not upload parameters for multiple modes simultaneously.    
We recommend using the official model templates. Experience URL: [E-commerce Operation Assistant Aidge Console](https://ecoa.console.aliyun.com/translate?category=assetOptimize&apiType=VirtualTryOn)', example='https://xxxx'),
  poseTemplateUrl?: string(name='PoseTemplateUrl', description='The URL of the pose template image. Only one image is supported. This image provides a reference for the person\\\\"s pose.
Required for the pose fission scenario.
If specified, the image is generated based on the template pose.
If not specified, the pose from the model scene image is used if provided; otherwise, the pose from the model source image is retained.
Note: For the clothing replacement, face replacement, and pose replacement modes, specify only one mode per call. Do not upload parameters for multiple modes simultaneously.
We recommend using the official pose templates. Experience URL: [E-commerce Operation Assistant Aidge Console](https://ecoa.console.aliyun.com/translate?category=assetOptimize&apiType=VirtualTryOn)', example='https://xxxx'),
  ratio?: string(name='Ratio', description='The aspect ratio of the output image. By default, it is the same as the original image specified by ModelImageUrl. Valid values: 1:1, 2:3, 3:4, and 9:16.', example='1:1'),
  resolution?: string(name='Resolution', description='The resolution of the output image.
Synchronous API: Supports 1K.
Asynchronous API: Supports 1K and 2K. The asynchronous API supports 2K only for single-item scenarios.

This parameter is required.', example='1K'),
  tryonType?: string(name='TryonType', description='Specifies the number of products to try on. This parameter takes effect only in try-on scenarios. Default value: `singletryon`.   
Valid values:   
• `singletryon`: Single-item try-on.   
• `multitryon`: Multi-item outfit.', example='singletryon'),
}

model AiTryOnResponseBody = {
  code?: string(name='Code', description='The error code. This parameter is not returned if the call is successful.', example='200'),
  data?: {
    imageHeight?: string(name='ImageHeight', description='The actual height of the generated image.', example='1360'),
    imageUrl?: string(name='ImageUrl', description='The URL of the generated image.', example='https://example.com/virtual-try-on-result.png'),
    imageWidth?: string(name='ImageWidth', description='The actual width of the generated image.', example='768'),
    usageMap?: {
      processedImageCount?: long(name='ProcessedImageCount', description='The number of processed images.', example='1'),
      resolution?: string(name='Resolution', description='The resolution of the image.', example='1K'),
    }(name='UsageMap', description='The usage fields.', example='{"ProcessedImageCount":1,"Resolution":"1K"}'),
  }(name='Data', description='The returned result struct.'),
  message?: string(name='Message', description='The error message. This parameter is not returned if the call is successful.', example='OK'),
  requestId?: string(name='RequestId', description='The ID of the request, which is used to identify a unique API call.', example='E1AD60F1-BAC7-546B-9533-E7AD02B16E3F'),
  success?: boolean(name='Success', description='Indicates whether the call is successful. A value of true indicates success, and a value of false indicates failure.', example='True'),
}

model AiTryOnResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AiTryOnResponseBody(name='body'),
}

/**
 * @summary Generates virtual try-on images by using AI algorithms to replace a model\\"s clothing with a specified garment based on the input garment and model images. The operation preserves the model\\"s posture, facial features, and other visual details while ensuring a realistic and well-fitted appearance of the garment. It returns a processed image based on the provided URL of the original product image.
 *
 * @description # Product overview
 * Virtual try-on is an AI-based image generation API service that replaces the clothing on a model with specified garments based on user-provided clothing and model images. It preserves the model\\"s other details and scene details without changing the model\\"s pose or facial features, ensuring a realistic and well-fitted appearance of the garments. You only need to provide the URLs of the original product images to obtain the processed images.
 * # Scenarios
 * *   **Virtual try-on for clothing, shoes, and hats:**
 *     
 * Supports virtual try-on for 14 categories of clothing, shoes, hats, and accessories, including tops, coats, bottoms, dresses, jumpsuits, socks, shoes, hats, earrings, necklaces, bracelets, scarves, bags, and glasses. After you upload a person image and product images, the system intelligently matches the position and proportion of the products based on the person\\"s pose and body parts to generate natural and realistic try-on effects. This intuitively displays the on-body performance of the clothing and presents a coordinated and realistic wearing effect.
 * *   **Model replacement (model skin/face replacement)**
 *     
 *     You provide the original model scene image and the face or reference image of the target model to apply the target person\\"s face to the model in the original image. This is applicable to customer-specified models, unified brand images, and character image adaptation for different markets. It also reduces the duplication of using the same model image as other merchants.
 *     
 * *   **Pose replacement (pose fission)**
 *     
 * You provide the original model scene image and a pose reference image with a specified pose to generate the effect of the original person and outfit in the new pose. This displays the fit, silhouette, and on-body performance of the products in different poses such as standing, raising hands, and turning around.
 * *   **E-commerce product display and marketing:**
 *     
 * Helps merchants quickly generate model try-on images for different products, reducing the costs of traditional shooting, outfit changes, and post-production, and improving the production efficiency of product images.
 * *   **Online shopping experience optimization:**
 *     
 * Consumers can preview the wearing effect of products through virtual try-on to more intuitively understand the style, matching, and overall effect of the products, assisting in purchase decisions and enhancing the shopping experience.
 * # Features 
 * | Feature | Supported scope | User input and specification method | Scenario value |
 * | --- | --- | --- | --- |
 * | **Clothing replacement/product wearing** | *   Clothing: tops, bottoms (pants, skirts), coats, dresses, jumpsuits/rompers.
 *     
 * *   Shoes and hats: shoes, socks, hats.
 *     
 * *   Accessories: earrings, necklaces, bracelets, scarves, bags, glasses. | Upload a model image and product images, and the products will naturally fit the model. The system automatically matches the wearing position based on the clothing category, ensuring that the pose, proportion, and wearing layers are consistent with real human effects, while maintaining the person\\"s scene and pose in the original image.
 * Try-on modes:
 * *   Supports single-item try-on.
 *     
 * *   Supports multi-item outfit matching (multiple items in one image or multiple items across multiple images).
 *     
 * Note: The multi-item outfit matching capability was newly launched in November. | Uniformly generates the wearing effects of clothing, shoes, hats, and accessories, reducing item-by-item outfit changes and real-life shooting. |
 * | **Model replacement/model skin replacement (face replacement)** | Supports user-specified target models.
 * The original image can be a single-item try-on image or a multi-item outfit image. | Upload the original model scene image and provide one face photo or clear model reference image of the target person to replace the face and identity features of the model in the scene with those of the target person.
 * The original outfit, pose, and scene are all preserved, and the generated result uses the person\\"s pose and background from the scene image. | Uses customer-specified or authorized model images to reduce duplication with existing model images and unify brand visuals. |
 * | **Pose replacement/pose fission** | Generates images based on the user-specified pose.
 * The original image can be a single-item try-on image or a multi-item outfit image. | Upload the original model scene image and one pose reference image to change the model\\"s pose to the action in the reference image. The person and outfit remain unchanged, and the wrinkles, drape, and layers of the clothing naturally adjust to the new pose. | Displays the fit, silhouette, and on-body style of the products in different poses, expanding the detail pages and marketing materials. |
 * # 4. Effect examples
 * | Scenario | Type/outfit description | Original model scene image | Product image/reference image | Effect image |
 * | --- | --- | --- | --- | --- |
 * | Single-item try-on | **Vest**
 * Black buttoned sleeveless vest | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/b7810d3c-547d-44eb-8a4e-4ef7dc2db008.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/dc248e7a-48ba-4e13-a2f9-c5e25bbafdb3.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/bec2501d-698f-4bf8-9ed7-6d20bb2d2b70.png) |
 * | Single-item try-on | Top | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/4ff4ce16-4069-4721-a77d-44afd0b6c839.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/0c63b027-95a0-4380-809c-dabdbeeae49f.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/933fa99c-2e75-417c-8ca1-ff8b89e8512d.png) |
 * | Single-item try-on | Bottom | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/71976528-8ccc-4583-a28e-fbd595c5eb83.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/abe67eeb-35f5-44a8-8701-c3e1b40cf0e4.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/f3705fa3-9458-4cd2-8ee9-57144898cf05.png) |
 * | Single-item try-on | Shoes | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/e60b4b54-16dc-4170-a2f4-6f9571c95048.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/0ece47ca-08d2-4f6e-b945-695592a49b09.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/46c2ca51-13f8-4e4b-93ae-fcdac30a9c99.png) |
 * | Single-item try-on | Jumpsuit | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/f36cad25-f199-4338-b945-7901c810c819.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/5aa1a24d-0d3f-4765-92f5-7ea6c9f0b0b8.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/YVOLrG0ZAjy0Gnpz/img/0449c368-c362-42f5-8292-3ebba7b2d478.png) |
