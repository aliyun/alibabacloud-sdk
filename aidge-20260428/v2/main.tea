async function textTranslateAsyncWithOptions(tmpReq: TextTranslateAsyncRequest, runtime: $RuntimeOptions): TextTranslateAsyncResponse {
  tmpReq.validate();
  var request = new TextTranslateAsyncShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!$isNull(tmpReq.sourceTextList)) {
    request.sourceTextListShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.sourceTextList, 'SourceTextList', 'json');
  }
  var query = {};
  if (!$isNull(request.bizId)) {
    query['BizId'] = request.bizId;
  }
  if (!$isNull(request.bizName)) {
    query['BizName'] = request.bizName;
  }
  if (!$isNull(request.formatType)) {
    query['FormatType'] = request.formatType;
  }
  if (!$isNull(request.glossary)) {
    query['Glossary'] = request.glossary;
  }
  if (!$isNull(request.sourceLanguage)) {
    query['SourceLanguage'] = request.sourceLanguage;
  }
  if (!$isNull(request.sourceTextListShrink)) {
    query['SourceTextList'] = request.sourceTextListShrink;
  }
  if (!$isNull(request.targetLanguage)) {
    query['TargetLanguage'] = request.targetLanguage;
  }
  if (!$isNull(request.translateScene)) {
    query['TranslateScene'] = request.translateScene;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'TextTranslateAsync',
    version = '2026-04-28',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

