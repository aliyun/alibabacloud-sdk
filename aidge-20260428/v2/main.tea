  var body : map[string]any = {};
  if (!$isNull(request.bizName)) {
    body['BizName'] = request.bizName;
  }
  if (!$isNull(request.formatType)) {
    body['FormatType'] = request.formatType;
  }
  if (!$isNull(request.glossary)) {
    body['Glossary'] = request.glossary;
  }
  if (!$isNull(request.sourceLanguage)) {
    body['SourceLanguage'] = request.sourceLanguage;
  }
  if (!$isNull(request.sourceTextListShrink)) {
    body['SourceTextList'] = request.sourceTextListShrink;
  }
  if (!$isNull(request.targetLanguage)) {
    body['TargetLanguage'] = request.targetLanguage;
  }
  if (!$isNull(request.translateScene)) {
    body['TranslateScene'] = request.translateScene;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
