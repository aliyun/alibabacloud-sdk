model AssetOptimizeProRequest {
  columnNameList?: [ string ](name='ColumnNameList', description='The list of column names to be recognized in the size chart. This parameter is optional.', example='["Bust","Waist","Hip"]'),
  glossary?: string(name='Glossary', description='The ID of the intervention glossary. This parameter is optional. You must create the glossary in the console and provide its ID. If this parameter is left empty, the translation results are not modified.', example='glossary_1'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Specifies whether to translate the text on the main subject of the image. This helps protect embedded information such as product names from being translated. Default value: false.', example='false'),
  languageModel?: string(name='LanguageModel', description='The output language format for the size chart. If this parameter is left empty, the original language is used. Valid values: en for English, cn for Chinese.', example='cn'),
  needTrans?: boolean(name='NeedTrans', description='Specifies whether translation is required. Valid values: true and false. If this parameter is set to true, SourceLanguage and TargetLanguage are required.

This parameter is required.', example='true'),
  productUrl?: string(name='ProductUrl', description='The product URL. This parameter is required. Currently, only 1688 product links are supported.

This parameter is required.', example='https://detail.1688.com/offer/771024907536.html'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. This parameter is optional. For supported language pairs, see the list of supported translation languages. This parameter is required if NeedTrans is set to true.', example='zh'),
  sourcePlatform?: string(name='SourcePlatform', description='The source platform. Currently, only 1688 is supported.

This parameter is required.', example='1688'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code. This parameter is optional. For supported language pairs, see the list of supported translation languages. This parameter is required if NeedTrans is set to true.', example='en'),
  targetPlatform?: string(name='TargetPlatform', description='The target platform for product listing. Currently, only TEMU is supported.

This parameter is required.', example='temu'),
  threshold?: double(name='Threshold', description='The confidence threshold for size chart detection. Default value: 0.4. If this parameter is set to 0, all images are considered size charts. If this parameter is set to 1, no images are considered size charts.', example='0.4'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names in images. This parameter is optional. Default value: false. This helps protect brand names from being translated.', example='false'),
}

