  tmpReq.validate();
  var request = new ProductVideoGenerationShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!$isNull(tmpReq.productImages)) {
    request.productImagesShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.productImages, 'product_images', 'json');
  }
  var query = {};
  if (!$isNull(request.aspectRatio)) {
    query['aspect_ratio'] = request.aspectRatio;
  }
  if (!$isNull(request.duration)) {
    query['duration'] = request.duration;
  }
  if (!$isNull(request.productImagesShrink)) {
    query['product_images'] = request.productImagesShrink;
  }
  if (!$isNull(request.productTitle)) {
    query['product_title'] = request.productTitle;
  }
  if (!$isNull(request.resolution)) {
    query['resolution'] = request.resolution;
  }
  if (!$isNull(request.script)) {
    query['script'] = request.script;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
