  objectDetectElements?: [ int32 ](name='ObjectDetectElements', description='The types of elements to detect on the image subject. Valid values: 1 (watermark), 2 (logo), 3 (text), and 4 (text-containing color block). You can specify multiple values.', example='[1,2,3,4]'),
