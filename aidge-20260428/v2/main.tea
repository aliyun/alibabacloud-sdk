async function imageTranslationStandardWithOptions(request: ImageTranslationStandardRequest, runtime: $RuntimeOptions): ImageTranslationStandardResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.glossary)) {
    query['Glossary'] = request.glossary;
  }
  if (!$isNull(request.imageUrl)) {
    query['ImageUrl'] = request.imageUrl;
  }
  if (!$isNull(request.includingProductArea)) {
    query['IncludingProductArea'] = request.includingProductArea;
  }
  if (!$isNull(request.sourceLanguage)) {
    query['SourceLanguage'] = request.sourceLanguage;
  }
  if (!$isNull(request.targetLanguage)) {
    query['TargetLanguage'] = request.targetLanguage;
  }
  if (!$isNull(request.translatingBrandInTheProduct)) {
    query['TranslatingBrandInTheProduct'] = request.translatingBrandInTheProduct;
  }
  if (!$isNull(request.useImageEditor)) {
    query['UseImageEditor'] = request.useImageEditor;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'ImageTranslationStandard',
    version = '2026-04-28',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

