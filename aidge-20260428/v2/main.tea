 *
 * @param request VirtualTryOnRequest
 * @return VirtualTryOnResponse
 */
async function virtualTryOn(request: VirtualTryOnRequest): VirtualTryOnResponse {
  var runtime = new $RuntimeOptions{};
  return virtualTryOnWithOptions(request, runtime);
}

model VisionFlowRequest {
  ability?: [ int32 ](name='Ability', description='The AI capabilities to be processed. Multiple values are supported. Valid values: 1 (Intelligent element recognition), 2 (Intelligent cutout), 3 (Intelligent erasure), 4 (Image translation Pro), 5 (Intelligent cropping), and 6 (High-definition upscaling).

This parameter is required.', example='[1,2,3,4]'),
  backGroundType?: string(name='BackGroundType', description='The background type of the returned image. Valid values: WHITE_BACKGROUND (White background image) and TRANSPARENT (Transparent background image). Required when the intelligent cutout capability is selected.', example='WHITE_BACKGROUND'),
  glossary?: string(name='Glossary', description='The ID of the intervention glossary. Optional. You must create the glossary in the console and provide its ID. If this parameter is left empty, the translation results are not modified.', example='glossary_1'),
  imageUrl?: string(name='ImageUrl', description='The URL of the image to be processed. Required. The resolution must be greater than 256×256, the long side must not exceed 1920 pixels, and the short side must not exceed 1080 pixels. The size must not exceed 5 MB. Supported formats include PNG, JPEG, JPG, BMP, and WEBP.

This parameter is required.', example='https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Specifies whether to translate text on the image subject. Optional. Default value: false. This parameter helps protect embedded information such as product names from being translated.', example='false'),
  isFilter?: boolean(name='IsFilter', description='Specifies whether to include images with the specified elements in subsequent processing. A value of true indicates that images with the elements are included in subsequent processing. A value of false indicates that images with the elements are not included. Required when the intelligent element recognition capability is selected.', example='true'),
  mask?: string(name='Mask', description='The specific erasure area in Run-Length Encoding (RLE) format. Optional. If this parameter is specified, it takes precedence and the ObjectRemoveElements and NonobjectRemoveElements parameters are ignored.', example='474556 160 475356 160'),
  nonobjectDetectElements?: [ int32 ](name='NonobjectDetectElements', description='The elements to detect on the non-subject area of the image. Multiple values are supported. Valid values: 1 (Watermark), 2 (Logo), 3 (Text), and 4 (Text block). When the intelligent element recognition capability is selected, at least one of this parameter and ObjectDetectElements must be specified.', example='[1,2,3]'),
  nonobjectRemoveElements?: [ int32 ](name='NonobjectRemoveElements', description='The elements to remove from the non-subject area of the image. Multiple values are supported. Valid values: 1 (Transparent text block), 2 (Specific name), 3 (Text), and 4 (Cluttered text). When the intelligent erasure capability is selected, at least one of this parameter and ObjectRemoveElements must be specified.', example='[1,2,4]'),
  objectDetectElements?: [ int32 ](name='ObjectDetectElements', description='The elements to detect on the image subject. Multiple values are supported. Valid values: 1 (Watermark), 2 (Logo), 3 (Text), and 4 (Text block). When the intelligent element recognition capability is selected, at least one of this parameter and NonobjectDetectElements must be specified.', example='[1,2,3,4]'),
  objectRemoveElements?: [ int32 ](name='ObjectRemoveElements', description='The elements to remove from the image subject. Multiple values are supported. Valid values: 1 (Transparent text block), 2 (Specific name), 3 (Text), and 4 (Cluttered text). When the intelligent erasure capability is selected, at least one of this parameter and NonobjectRemoveElements must be specified.', example='[1,2,4]'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. Optional. For supported language pairs, see the list of supported translation languages.', example='zh'),
  targetHeight?: int32(name='TargetHeight', description='The expected height of the cropped image, in pixels. Valid values: 100 to 5000. Required when the intelligent cropping capability is selected.', example='800'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code. Optional. For supported language pairs, see the list of supported translation languages.', example='en'),
  targetWidth?: int32(name='TargetWidth', description='The expected width of the cropped image, in pixels. Valid values: 100 to 5000. Required when the intelligent cropping capability is selected.', example='800'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names in the image. Optional. Default value: false. This parameter helps protect brand name information from being translated.', example='false'),
  upscaleFactor?: int32(name='UpscaleFactor', description='The image upscaling factor. Optional. Default value: 2. Valid values: 2 to 4. Required when the high-definition upscaling capability is selected.', example='2'),
}

model VisionFlowShrinkRequest {
  abilityShrink?: string(name='Ability', description='The AI capabilities to be processed. Multiple values are supported. Valid values: 1 (Intelligent element recognition), 2 (Intelligent cutout), 3 (Intelligent erasure), 4 (Image translation Pro), 5 (Intelligent cropping), and 6 (High-definition upscaling).

This parameter is required.', example='[1,2,3,4]'),
  backGroundType?: string(name='BackGroundType', description='The background type of the returned image. Valid values: WHITE_BACKGROUND (White background image) and TRANSPARENT (Transparent background image). Required when the intelligent cutout capability is selected.', example='WHITE_BACKGROUND'),
  glossary?: string(name='Glossary', description='The ID of the intervention glossary. Optional. You must create the glossary in the console and provide its ID. If this parameter is left empty, the translation results are not modified.', example='glossary_1'),
  imageUrl?: string(name='ImageUrl', description='The URL of the image to be processed. Required. The resolution must be greater than 256×256, the long side must not exceed 1920 pixels, and the short side must not exceed 1080 pixels. The size must not exceed 5 MB. Supported formats include PNG, JPEG, JPG, BMP, and WEBP.

This parameter is required.', example='https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Specifies whether to translate text on the image subject. Optional. Default value: false. This parameter helps protect embedded information such as product names from being translated.', example='false'),
  isFilter?: boolean(name='IsFilter', description='Specifies whether to include images with the specified elements in subsequent processing. A value of true indicates that images with the elements are included in subsequent processing. A value of false indicates that images with the elements are not included. Required when the intelligent element recognition capability is selected.', example='true'),
  mask?: string(name='Mask', description='The specific erasure area in Run-Length Encoding (RLE) format. Optional. If this parameter is specified, it takes precedence and the ObjectRemoveElements and NonobjectRemoveElements parameters are ignored.', example='474556 160 475356 160'),
  nonobjectDetectElementsShrink?: string(name='NonobjectDetectElements', description='The elements to detect on the non-subject area of the image. Multiple values are supported. Valid values: 1 (Watermark), 2 (Logo), 3 (Text), and 4 (Text block). When the intelligent element recognition capability is selected, at least one of this parameter and ObjectDetectElements must be specified.', example='[1,2,3]'),
  nonobjectRemoveElementsShrink?: string(name='NonobjectRemoveElements', description='The elements to remove from the non-subject area of the image. Multiple values are supported. Valid values: 1 (Transparent text block), 2 (Specific name), 3 (Text), and 4 (Cluttered text). When the intelligent erasure capability is selected, at least one of this parameter and ObjectRemoveElements must be specified.', example='[1,2,4]'),
  objectDetectElementsShrink?: string(name='ObjectDetectElements', description='The elements to detect on the image subject. Multiple values are supported. Valid values: 1 (Watermark), 2 (Logo), 3 (Text), and 4 (Text block). When the intelligent element recognition capability is selected, at least one of this parameter and NonobjectDetectElements must be specified.', example='[1,2,3,4]'),
  objectRemoveElementsShrink?: string(name='ObjectRemoveElements', description='The elements to remove from the image subject. Multiple values are supported. Valid values: 1 (Transparent text block), 2 (Specific name), 3 (Text), and 4 (Cluttered text). When the intelligent erasure capability is selected, at least one of this parameter and NonobjectRemoveElements must be specified.', example='[1,2,4]'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. Optional. For supported language pairs, see the list of supported translation languages.', example='zh'),
  targetHeight?: int32(name='TargetHeight', description='The expected height of the cropped image, in pixels. Valid values: 100 to 5000. Required when the intelligent cropping capability is selected.', example='800'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code. Optional. For supported language pairs, see the list of supported translation languages.', example='en'),
  targetWidth?: int32(name='TargetWidth', description='The expected width of the cropped image, in pixels. Valid values: 100 to 5000. Required when the intelligent cropping capability is selected.', example='800'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names in the image. Optional. Default value: false. This parameter helps protect brand name information from being translated.', example='false'),
  upscaleFactor?: int32(name='UpscaleFactor', description='The image upscaling factor. Optional. Default value: 2. Valid values: 2 to 4. Required when the high-definition upscaling capability is selected.', example='2'),
}

model VisionFlowResponseBody = {
  code?: string(name='Code', description='The status code. If the call is successful, "success" is returned.', example='success'),
  data?: {
    taskId?: string(name='TaskId', description='The ID of the asynchronous task, which is used to query the processing result by calling QueryAsyncTaskResult.', example='e4c48e88-3c34-91e3-ab8a-08484dc4d402'),
  }(name='Data', description='The submission result data of the asynchronous task, which includes the asynchronous task ID.'),
  message?: string(name='Message', description='The error message. If the call is successful, "Success" is returned.', example='Success'),
  requestId?: string(name='RequestId', description='The request ID, which is used to identify a unique request.', example='F3E65785-0180-1227-91B0-2F5F52F679FB'),
  success?: boolean(name='Success', description='Indicates whether the call is successful. A value of true indicates success, and a value of false indicates failure.', example='true'),
}

model VisionFlowResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: VisionFlowResponseBody(name='body'),
}

/**
 * @summary Provides a one-stop AI image processing service for e-commerce sellers. Orchestrates six atomic capabilities—element recognition, intelligent cutout, intelligent erasure, image translation Pro, intelligent cropping, and high-definition upscaling—into an image processing workflow. Users can upload an image once, select the required capabilities, and complete multiple image optimizations in sequence to output product images that meet the requirements of e-commerce platforms. (Asynchronous)
 *
 * @description # 1. Product introduction
 * Provides a one-stop AI image processing service for e-commerce sellers. Orchestrates six atomic capabilities—element recognition, intelligent cutout, intelligent erasure, image translation Pro, intelligent cropping, and high-definition upscaling—into an image processing workflow. Users can upload an image once, select the required capabilities, and complete multiple image optimizations in sequence to output product images that meet the requirements of e-commerce platforms. (Asynchronous)
 * # 2. Scenarios
 * Applicable to batch optimization of product images in cross-platform listing scenarios. Adapts source product images into main images, SKU images, and detail images required by listing platforms. Supports the following operations:
 * *   Identifies low-quality images with text, watermarks, logos, or cluttered text, and allows users to filter the images to be processed.
 *     
 * *   Removes non-compliant elements such as watermarks, logos, cluttered text, and Chinese text from the original image.
 *     
 * *   Removes the background around the main product subject.
 *     
 * *   Translates text in the image into other languages.
 *     
 * *   Expands the image to other sizes (by ratio or dimensions) and automatically fills the background.
 *     
 * *   Crops the image to a specified size.
 *     
 * *   Upscales the image pixels by a specified factor.
 * # 3. Features
 * Users input the URL of a product image and select the required AI capabilities through the Ability parameter (1=Intelligent element recognition, 2=Intelligent cutout, 3=Intelligent erasure, 4=Image translation Pro, 5=Image expansion, 6=Intelligent cropping, 7=High-definition upscaling). The system executes the selected capabilities in a preset sequence. Because intelligent element recognition helps users determine whether an image contains specific elements, and the presence of these elements affects the selection of subsequent AI capabilities, an additional input option is provided. This option allows users to choose whether to filter out images from subsequent AI processing or retain them without further processing.
 * ![ai-pipeline-flowchart.svg](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/bddb522a-0795-4b5c-b25d-10e933426367.svg)
 * The following section describes each AI capability:
 * **1. Intelligent element recognition**: An element detection capability designed specifically for e-commerce images. It identifies elements such as text, logos, watermarks, and text blocks in the subject and background of an image, and returns Boolean detection results. Users can filter images based on the recognition results (for example, processing only images with watermarks) and link this capability with subsequent ones—first identifying the types of elements to be optimized, and then precisely executing operations such as erasure.
 *     
 * **2. Intelligent cutout**: Automatically identifies the main product subject in an image and precisely separates it from the background. Based on deep learning models, it supports precise segmentation of complex edges such as hair and transparent objects. It can output images with transparent or white backgrounds, supports custom background colors and target size cropping, and directly generates product display images that comply with e-commerce platform specifications.
 *     
 * **3. Intelligent erasure**: Automatically identifies and removes non-compliant elements in e-commerce images, such as text, specific names (brand or store names), transparent text blocks, and cluttered text. It supports specifying the removal of elements in the subject area or non-subject area separately. It also supports precisely specifying the removal area through the Mask parameter to achieve efficient and compliant cleanup of large batches of images.
 *     
 * **4. Image translation Pro**: Integrates multimodal large model technology to translate text in an image into a target language and directly renders it in the corresponding position of the original image. It supports over 100 language pairs. It provides features such as product subject text protection, brand name protection, and translation intervention glossaries to avoid mistranslating embedded product information. After translation, it can return layout information such as text position, font, and color to support secondary editing.
 *     
 * **5. Intelligent image expansion**: Expands the image canvas based on AI generation technology to broaden the image field of view without cropping the subject. It supports multiple expansion methods: expanding by aspect ratio (1:1, 3:4, 4:3, 9:16, 16:9), scaling by horizontal or vertical proportion (1.0 to 3.0 times), and shifting pixels in the up, down, left, or right directions. The AI automatically fills and generates naturally transitioning background content.
 *     
 * **6. Intelligent cropping**: Intelligently crops images to specified sizes, automatically identifies the main subject area of the image, and precisely retains the core content. It supports custom output width and height (100 to 5000 pixels) and adapts to the image size requirements of different e-commerce platforms and ad slots, ensuring that the subject stands out and the picture is balanced after cropping.
 *     
 * **7. High-definition upscaling**: Enhances details and reduces noise while upscaling the image. It supports 2x to 4x upscaling. It is applicable to improving the clarity of low-resolution product images and optimizing visual presentation. It supports output in formats such as PNG, JPG, and BMP.
 * # 4. Effect comparison
 * | **Original image** | **Capabilities used** | **Output image** |
 * | --- | --- | --- |
 * | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/3c1af966-8a5a-491d-9bfa-aefc321c9bed.png) | *   Intelligent recognition
 *     
 * *   Image translation Pro
 *     
 * *   Intelligent cropping | ![R1.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/c2579e3e-389e-4717-84e3-834e60fea6b0.png) |
 * | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/a92d14a9-ecf4-4e77-ad96-a2fcdd95dd1d.png) | *   Intelligent cutout
 *     
 * *   Intelligent erasure
 *     
 * *   Intelligent cropping | ![R1.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/f631f578-3496-4aa1-b5ef-cd1ea603e049.png) |
 * | ![C2.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/12965cf8-cfdf-4a85-95fe-fdfcefcaa4ae.png) | *   Intelligent recognition
 *     
 * *   Intelligent erasure
 *     
 * *   High-definition upscaling | ![R2.jpeg](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/NpQlK5jRe9w5jqDv/img/95d29e79-8622-45fb-b284-cd580fe40ea0.jpeg) |
 *
 * @param tmpReq VisionFlowRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return VisionFlowResponse
 */
@context("visionFlowWithContext")
async function visionFlowWithOptions(tmpReq: VisionFlowRequest, runtime: $RuntimeOptions): VisionFlowResponse {
  tmpReq.validate();
  var request = new VisionFlowShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!$isNull(tmpReq.ability)) {
    request.abilityShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.ability, 'Ability', 'json');
  }
  if (!$isNull(tmpReq.nonobjectDetectElements)) {
    request.nonobjectDetectElementsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.nonobjectDetectElements, 'NonobjectDetectElements', 'json');
  }
  if (!$isNull(tmpReq.nonobjectRemoveElements)) {
    request.nonobjectRemoveElementsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.nonobjectRemoveElements, 'NonobjectRemoveElements', 'json');
  }
  if (!$isNull(tmpReq.objectDetectElements)) {
    request.objectDetectElementsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.objectDetectElements, 'ObjectDetectElements', 'json');
  }
  if (!$isNull(tmpReq.objectRemoveElements)) {
    request.objectRemoveElementsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.objectRemoveElements, 'ObjectRemoveElements', 'json');
  }
  var query = {};
  if (!$isNull(request.abilityShrink)) {
    query['Ability'] = request.abilityShrink;
  }
  if (!$isNull(request.backGroundType)) {
    query['BackGroundType'] = request.backGroundType;
  }
  if (!$isNull(request.glossary)) {
    query['Glossary'] = request.glossary;
  }
  if (!$isNull(request.imageUrl)) {
    query['ImageUrl'] = request.imageUrl;
  }
  if (!$isNull(request.includingProductArea)) {
    query['IncludingProductArea'] = request.includingProductArea;
  }
  if (!$isNull(request.isFilter)) {
    query['IsFilter'] = request.isFilter;
  }
  if (!$isNull(request.mask)) {
    query['Mask'] = request.mask;
  }
  if (!$isNull(request.nonobjectDetectElementsShrink)) {
    query['NonobjectDetectElements'] = request.nonobjectDetectElementsShrink;
  }
  if (!$isNull(request.nonobjectRemoveElementsShrink)) {
    query['NonobjectRemoveElements'] = request.nonobjectRemoveElementsShrink;
  }
  if (!$isNull(request.objectDetectElementsShrink)) {
    query['ObjectDetectElements'] = request.objectDetectElementsShrink;
  }
  if (!$isNull(request.objectRemoveElementsShrink)) {
    query['ObjectRemoveElements'] = request.objectRemoveElementsShrink;
  }
  if (!$isNull(request.sourceLanguage)) {
    query['SourceLanguage'] = request.sourceLanguage;
  }
  if (!$isNull(request.targetHeight)) {
    query['TargetHeight'] = request.targetHeight;
  }
  if (!$isNull(request.targetLanguage)) {
    query['TargetLanguage'] = request.targetLanguage;
  }
  if (!$isNull(request.targetWidth)) {
    query['TargetWidth'] = request.targetWidth;
  }
  if (!$isNull(request.translatingBrandInTheProduct)) {
    query['TranslatingBrandInTheProduct'] = request.translatingBrandInTheProduct;
  }
  if (!$isNull(request.upscaleFactor)) {
    query['UpscaleFactor'] = request.upscaleFactor;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'VisionFlow',
    version = '2026-04-28',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

