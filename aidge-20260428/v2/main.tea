  returnCharacterProp?: int32(name='ReturnCharacterProp', description='Specifies whether to return the text proportion. Valid values: 1 (yes) and 0 (no). Default value: 0. This parameter takes effect only when the following conditions are met: 1. ReturnCharacter is set to 1. 2. ObjectDetectElements or NonObjectDetectElements is set to 3, which means text recognition is required.', example='1'),
  returnProductNum?: int32(name='ReturnProductNum', description='Specifies whether to return the number of subjects. Valid values: 1 (yes) and 0 (no). Default value: 0.', example='1'),
  returnProductProp?: int32(name='ReturnProductProp', description='Specifies whether to return the area proportion of the subject. Valid values: 1 (yes) and 0 (no). Default value: 0.', example='1'),
