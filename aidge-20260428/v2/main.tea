model VideoTranslationRequest {
  capabilities?: [ string ](name='Capabilities', description='The list of translation capabilities. Valid values: `speech` and `visual`. You can select both. At least one capability must be specified. Duplicate values are not allowed.

This parameter is required.'),
  enableQualityCheck?: boolean(name='EnableQualityCheck', description='Specifies whether to enable the quality check for on-screen text processing. This parameter takes effect only when `visual` is included and explicitly set to `true`. If only `speech` is selected, this parameter is ignored, no quality check is performed, no quality check fields are returned, and no error is reported for this parameter. Enabling the quality check may increase the processing time. Do not enable it unless necessary. Default value: `false`.', example='false'),
  eraseOnly?: boolean(name='EraseOnly', description='Specifies whether to only erase on-screen text without translation. This parameter is valid only when `visual` is included. Valid values: `true`: erases the on-screen text without translation. `false`: translates the on-screen text. Default value: `false`.', example='false'),
  removeLogo?: boolean(name='RemoveLogo', description='Specifies whether to erase brand logos. This parameter is valid only when `visual` is included. Valid values: `true`: erases brand logos. `false`: retains brand logos. Default value: `false`. This parameter is independent of `EraseOnly`.', example='false'),
  sourceLanguage?: string(name='SourceLanguage', description='The original language of the video (source language). For supported languages, see Language support.', example='zh'),
  subtitleMode?: string(name='SubtitleMode', description='The subtitle processing mode. This parameter is valid only when `speech` is included. Valid values: `erase`: erases the original subtitles only. `replace`: replaces the original subtitles with translated subtitles, which means erasing the original subtitles and adding subtitles synchronized with the translated speech. If this parameter is not specified, the original subtitles are not processed, which means neither erasing the original subtitles nor adding new subtitles.', example='replace'),
  targetLanguage?: string(name='TargetLanguage', description='The target language. This parameter is required when `speech` is included. If only `visual` is included and `EraseOnly` is set to true, this parameter is optional and ignored if provided. In other cases, this parameter is required.', example='en'),
