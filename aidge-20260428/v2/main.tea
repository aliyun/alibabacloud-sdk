      title?: string(name='Title', description='Required for product replacement. The name of the target product to be replaced. The maximum length is 200 characters. Example: Light yellow cooling sun-protective clothing.', example='Light moon yellow cool-touch sun protection clothing'),
    }(name='ProductInfo', description='The target product information. We recommend filling in this information to improve voiceover accuracy.'),
    recreateMode?: string(name='RecreateMode', description='The generation method. Default value: reference. Valid values: reference (directly references the original video) and rebuild (breaks down the original video before regenerating).', example='reference'),
    sourceVideoUrl?: string(name='SourceVideoUrl', description='The HTTP(S) URL of the reference video. The duration ranges from 2 to 360 seconds. The URL must remain accessible during task execution. We recommend that the validity period be no less than 24 hours.

This parameter is required.', example='https://example.com/source.mp4'),
  }(name='Input', description='The video variation input parameters.

This parameter is required.'),
  output?: {
    duration?: int32(name='Duration', description='The target duration in seconds. In reference mode, the input value is ignored and forced to -1, following the original video duration. In rebuild mode, you can pass an integer from 5 to 60 seconds, or pass -1 for automatic duration.', example='-1'),
    quality?: string(name='Quality', description='The output resolution. Default value: `720p`.', example='720p、1080p'),
    ratio?: string(name='Ratio', description='The output aspect ratio. Default value: `auto` (automatically matches the original video).', example='auto、9:16、3:4、1:1、4:3、16:9'),
