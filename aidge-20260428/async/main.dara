  data?: {
    result?: {
      details?: [ 
        {
          clazz?: string(name='Clazz', description='The non-empty category name.', example='OPPO VIVO Smartphone Store'),
          confidence?: float(name='Confidence', description='A finite numeric value. The value range is not specified.', example='0.99'),
        }
      ](name='Details', description='The classification details. This can be an empty array.'),
      grounding?: {
        coverage?: string(name='Coverage', description='The coverage.', example='partial'),
        regions?: [ 
          {
            bbox2d?: [ float ](name='Bbox2d', description='The bounding box coordinates.', example='[0,0,456,398]'),
            label?: string(name='Label', description='The label.', example='store_sign'),
            text?: string(name='Text', description='The recognized text.', example='oppo'),
          }
        ](name='Regions', description='The list of regions.'),
      }(name='Grounding', description='The localization information.'),
      scenes?: [ string ](name='Scenes', description='The non-empty array of scene classifications.'),
    }(name='Result', description='The details of the scene recognition result.'),
    usageMap?: map[string]long(name='UsageMap', description='The usage information.', example='{"ProcessingCount":1}'),
  }(name='Data', description='The scene recognition result.'),
  message?: string(name='Message', description='The response message or failure description.', example='Success'),
  requestId?: string(name='RequestId', description='The request ID.', example='70CBEFDF-BB17-1EB3-8A21-569F3124738F'),
  success?: boolean(name='Success', description='Indicates whether the call is successful.', example='True'),
}

