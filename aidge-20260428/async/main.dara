    mode?: string(name='Mode', description='The replacement mode. Valid values: `product_replacement` (default) and `person_replacement`.', example='product_replacement'),
    personReferenceImageUrls?: [ string ](name='PersonReferenceImageUrls', description='The URLs of the reference images for the target character during character replacement. You can provide 1 to 5 images, which must be of the same character. Arrange them in the order of facial close-up, front, 45-degree angle, side, and back. Example: `["https://example.com/person.jpg"]`.'),
    productImageUrls?: [ string ](name='ProductImageUrls', description='Required for product replacement. The URLs of the target product images. You can upload 1 to 8 images for the same SKU. Provide images with clear main subjects, no occlusions, and clean backgrounds. Example: `["https://example.com/product.png"]`.'),
    productInfo?: {
      category?: string(name='Category', description='The product category. Example: Women\\\\"s clothing/Sun-protective clothing.', example='Women\\\\"s clothing/sun protection clothing'),
      detail?: string(name='Detail', description='The actual product information, such as SKU, brand, color, material, size, specifications, logo, and usage instructions. This is used to constrain voiceover facts. Example: Pale yellow, cooling fabric, sun protection down to the back of the hand, UPF50+.', example='Light moon yellow, cool-touch fabric, sun protection extending to the back of the hand, UPF50+'),
      title?: string(name='Title', description='Required for product replacement. The name of the target product to be replaced. Maximum length: 200 characters. Example: Pale yellow cooling sun-protective clothing.', example='Light moon yellow cool-touch sun protection clothing'),
    }(name='ProductInfo', description='The target product information. Providing this parameter is recommended to improve voiceover accuracy.'),
    recreateMode?: string(name='RecreateMode', description='The generation method. Default value: `reference`. Valid values: `reference` (directly references the original video) and `rebuild` (breaks down the original video before regenerating).', example='reference'),
    sourceVideoUrl: string(name='SourceVideoUrl', description='The HTTP(S) URL of the reference video. The duration ranges from 2 to 360 seconds. The URL must remain accessible during task execution. A validity period of at least 24 hours is recommended.

This parameter is required.', example='https://example.com/source.mp4'),
  }(name='Input', description='The input parameters for video variation generation.

This parameter is required.', shrink='json', position='Query'),
