model ImageRecognitionRequest {
  imageUrl: string(name='ImageUrl', description='The URL of the image to be recognized.

This parameter is required.', example='https://fb-es.mrvcdn.com/kf/E6332bde0101849968532c4f08dac757cZ.jpg', position='Query'),
  nonObjectDetectElements?: [ int32 ](name='NonObjectDetectElements', description='Specifies the elements to detect on the non-subject area of the image. Valid values: 1 for watermark, 2 for logo, 3 for text, and 4 for text-containing color block. You can specify multiple element types. This parameter and ObjectDetectElements cannot be empty at the same time.', example='[1,2,3,4]', shrink='json', position='Query'),
  objectDetectElements?: [ int32 ](name='ObjectDetectElements', description='Specifies the elements to detect on the image subject. Valid values: 1 for watermark, 2 for logo, 3 for text, and 4 for text-containing color block. You can specify multiple element types.', example='[1,2,3,4]', shrink='json', position='Query'),
  returnBorderPixel?: int32(name='ReturnBorderPixel', description='Specifies whether to return border pixel information. Valid values:
- 1: Return border pixel information.
- 0: Do not return border pixel information.', example='1', position='Query'),
  returnCharacter?: int32(name='ReturnCharacter', description='Specifies whether to return text information. Valid values:
- 1: Return text information.
- 0: Do not return text information.', example='1', position='Query'),
  returnCharacterProp?: int32(name='ReturnCharacterProp', description='Specifies whether to return text property information. Valid values:
- 1: Return text property information.
- 0: Do not return text property information.', example='1', position='Query'),
  returnProductNum?: int32(name='ReturnProductNum', description='Specifies whether to return the product quantity. Valid values:
- 1: Return the product quantity.
- 0: Do not return the product quantity.', example='1', position='Query'),
  returnProductProp?: int32(name='ReturnProductProp', description='Specifies whether to return product property information. Valid values:
- 1: Return product property information.
- 0: Do not return product property information.', example='1', position='Query'),
}

