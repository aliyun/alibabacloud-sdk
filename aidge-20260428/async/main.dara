  modelImageUrl: string(name='ModelImageUrl', description='The URL of the model image. Only one image is supported. The URL must be a publicly accessible HTTP or HTTPS URL. The image must be in JPG, JPEG, PNG, BMP, or WEBP format. The resolution must be between 256×256 and 2049×2049 pixels, and the file size must not exceed 10 MB.<br>

This parameter is required.', example='https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg', position='Query'),
  resolution: string(name='Resolution', description='Required. The resolution of the generated image. Valid values: 1K and 2K.

This parameter is required.', example='1K', position='Query'),
}

