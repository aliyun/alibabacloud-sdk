  imageUrl: string(name='ImageUrl', description='The HTTP(S) URL of the overall floor display image.

This parameter is required.', example='https://example.com/image.jpg', position='Query'),
  ragId: string(name='RagId', description='The ID of the SKU asset knowledge base.

This parameter is required.', example='rag_9c1f2b7d4e5a4c8fa1b2c3d4e5f60718', position='Query'),
