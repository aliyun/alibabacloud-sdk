  }(name='Data', description='The intelligent element recognition result.'),
  message?: string(name='Message', description='The error message. This parameter is not returned when the call is successful.', example='OK'),
  requestId?: string(name='RequestId', description='Id of the request', example='E1AD60F1-BAC7-546B-9533-E7AD02B16E3F'),
  success?: boolean(name='Success', description='Indicates whether the call was successful.', example='True'),
}

