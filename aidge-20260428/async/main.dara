  code?: string(name='Code', description='The response code. If the call is successful, "success" is returned.', example='success'),
  data?: {
    translations?: [ 
      {
        characters?: long(name='Characters', description='The number of characters in the source text.', example='11'),
        detectedLanguage?: string(name='DetectedLanguage', description='The automatically detected source language code.', example='en'),
        translatedText?: string(name='TranslatedText', description='The translated text.', example='Hello world'),
      }
    ](name='Translations', description='The list of translation results. Each element corresponds to a translation result for an item in the input text list.'),
    usageMap?: map[string]long(name='UsageMap', description='The usage information, which includes the number of input characters.', example='{"InputCharacterCount":5}'),
