  *     
  * *   Does not involve the image subject area
  *     
  * ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/0d68612e-845d-466f-8a4a-b85facea095b.png) | *   Involves the image subject area
  *     
  * ![b6ef803f-743f-4e61-b901-d1f68167186f.jpeg](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/621daadc-454f-41b4-9ac4-752d457034b6.jpeg)
  * *   Does not involve the image subject area
  *     
  * ![dee0c7cf-8b0d-4d6d-9677-d5f2e6099834.jpeg](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/caa6994b-2f97-484d-a807-671a0dc75947.jpeg) |
  * | Specified image element removal (supports multiple image links) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/9297951f-53c1-4476-8c69-5c31df3fce21.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/ef3f35aa-609f-454c-bba0-dd1710c83945.png) |
  * | Specified text removal (supports multiple text strings) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/c784d8be-4b4d-4972-8b99-828c742b8f03.png) | ![image.png](https://alidocs.oss-cn-zhangjiakou.aliyuncs.com/res/Mp7ld7bZAb2VAOBQ/img/805423ca-bd0d-4d44-a18e-a7d7bfe88587.png) |
  * @param request  the request parameters of ImageRemove  ImageRemoveRequest
  * @return ImageRemoveResponse
 */
async function imageRemove(request: ImageRemoveRequest): ImageRemoveResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ImageRemove', 'POST', '/', 'json', false, 'json', request);
}

model ImageRemoveAsyncRequest {
  bizId?: string(name='BizId', description='The business order ID of the caller. This ID is recorded when the request is accepted and returned as-is when you query the result of the asynchronous task.', example='order-20260928-001', position='Query'),
  imageUrl: string(name='ImageUrl', description='The URL of the original image. The image must be in JPG, JPEG, PNG, BMP, or WEBP format. The resolution must be between 256 × 256 and 3000 × 3000 pixels, and the file size cannot exceed 10 MB.

This parameter is required.', example='"https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg"', position='Query'),
  mask?: string(name='Mask', description='The specific area to erase. This parameter must be used in conjunction with the editor. The input format is Run-Length Encoding (RLE).
If this parameter is specified, it takes precedence and the remove_non_product_area_elements and remove_product_area_elements parameters are ignored. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage.
If multiple parameters are specified, the priority is as follows: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='"474556 160 475356 160 476156 160 476956 160 477756 160 478556 160 479356 160 480156 160 480956 160 481756 160 482556 160 483356 160 484156 160 484956 160 485756 160 486556 160 487356 160 488156 160 488956 160 489756 160 490556 160 491356 160 492156 160"', position='Query'),
  nonObjectRemoveElements?: [ int32 ](name='NonObjectRemoveElements', description='The list of element types to remove from the image background.', shrink='json', position='Query'),
  objectRemoveElements?: [ int32 ](name='ObjectRemoveElements', description='The types of elements to remove from the image subject. Valid values:
- 1: Transparent text blocks.
- 2: Specific names.
- 3: Text.
- 4: Promotional stickers.
You can select multiple element types. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage.
If multiple parameters are specified, the priority is as follows: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.
For more information about each type, see the product documentation.
Image subject: the core product area in the image.', shrink='json', position='Query'),
  position?: string(name='Position', description='The specific area to erase. This parameter must be used in conjunction with the editor. The input format is a four-point coordinate array, such as [xx,yy,zz,dd]. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage.
If multiple parameters are specified, the priority is as follows: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='[10,20,100,200]', position='Query'),
  userImage?: [ string ](name='UserImage', description='The list of URLs for user-specified image elements to erase.', shrink='json', position='Query'),
  userText?: [ string ](name='UserText', description='The list of user-specified text strings to erase.', shrink='json', position='Query'),
}

