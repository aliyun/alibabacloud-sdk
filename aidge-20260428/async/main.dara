model TextTranslateRequest {
  bizName?: string(name='BizName', description='This field represents your identity and facilitates communication for various issues. If you are an internal Alibaba organization, we recommend that you specify this parameter based on the actual scenario, such as BU name-product or BU name-chat. If you are an external Alibaba partner, we recommend that you specify the full name of your company. The company name must be the same as the company name you used when registering your Alibaba Cloud account.', example='MyCompany-Chat', position='Body'),
  formatType?: string(name='FormatType', description='The format type of the source text. This parameter is optional. Valid values:
- text: Plain text format.
- html: Web page format, which retains HTML tags.', example='text', position='Body'),
  glossary?: string(name='Glossary', description='The ID of the intervention glossary. This parameter is optional. You must create the glossary in the console and provide its ID. If the provided intervention glossary ID is empty, the translation results are not modified.', example='glossary_1', position='Body'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. If this parameter is not specified, the language is automatically detected. This parameter is optional. You can set this parameter to auto for language identification.   
<props="china">For supported language pairs, see [Language pair mapping table](https://www.alibabacloud.com/help/en/document_detail/3041883.html).      

<props="intl">For supported language pairs, see [Language pair mapping table](https://www.alibabacloud.com/help/zh/aidge/language-direction-mapping).', example='auto', position='Body'),
  sourceTextList: [ string ](name='SourceTextList', description='The list of text to be translated. This parameter is required. The total character length cannot exceed 50,000, and the list length cannot exceed 50.

This parameter is required.', example='["Hello world"]', shrink='json', position='Body'),
  targetLanguage: string(name='TargetLanguage', description='The target language code. This parameter is required.   
<props="china">For supported language pairs, see [Language pair mapping table](https://www.alibabacloud.com/help/en/document_detail/3041883.html).      

<props="intl">For supported language pairs, see [Language pair mapping table](https://www.alibabacloud.com/help/zh/aidge/language-direction-mapping).

This parameter is required.', example='ko', position='Body'),
  translateScene?: string(name='TranslateScene', description='The business scenario identifier. You can specify only one of the following values. After the value is specified, the translation engine calls the terminology library and style policy of the corresponding industry to output translations that better fit the industry. If this parameter is not specified or an invalid value is specified, the general translation policy is used. Valid values:
- e-commerce-title: Cross-border e-commerce product title translation.
- e-commerce-description: Cross-border e-commerce product description translation.
- e-commerce-chat: Cross-border e-commerce conversation translation.
- e-commerce-cpv: Cross-border e-commerce product CPV attribute translation.
- novel: Novel translation.
- game: Game translation.', example='e-commerce-title', position='Body'),
}

