  userText?: [ string ](name='UserText', description='The user-specified text to remove. Multiple text strings are supported. The input format is ["xx","yy"]. This parameter is optional, but you must specify at least one of the following parameters: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, and UserImage.
