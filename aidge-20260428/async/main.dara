  bizName?: string(name='BizName', description='The business scenario identifier. This parameter is optional. Valid values: e-commerce-title, e-commerce-description, e-commerce-chat, e-commerce-cpv, novel, and game. If this parameter is not specified or is invalid, the general translation policy is used by default.', example='Alibaba-Product', position='Body'),
  formatType?: string(name='FormatType', description='The format type of the source text. This parameter is optional. Valid values: text (plain text format) and html (web page format, which retains HTML tags).', example='text', position='Body'),
  glossary?: string(name='Glossary', description='The ID of the intervention glossary. This parameter is optional. You must create the glossary in the console and provide its ID. If the provided intervention glossary ID is empty, the translation results are not modified.', example='custom_glossary', position='Body'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. This parameter is optional. If you do not specify this parameter, the language is automatically detected. You can set this parameter to auto to enable language detection.', example='auto', position='Body'),
