    pdProp?: string(name='PdProp', description='The proportion of the product in the image.', example='74.15%'),
    recText?: [ string ](name='RecText', description='The list of recognized text.'),
    textProp?: string(name='TextProp', description='The proportion of text in the image.', example='7.52%'),
