}

model AssetOptimizeLiteResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AssetOptimizeLiteResponseBody(name='body'),
}

/**
  * @description ## Product Introduction
  * A one-click cross-platform product listing optimization service for cross-border e-commerce sellers (minimum cost edition). Accepts a product link from a source platform and outputs all listing assets adapted to the target platform requirements, including titles, attributes, main images, SKU images, detail images, and copywriting. Uses an officially preset minimum-cost workflow that focuses on filtering and lightweight processing without calling expensive image translation capabilities, maximizing cost control while ensuring listing compliance. (Asynchronous)
  * ## Scenarios
  * Suitable for cost-sensitive cross-platform listing scenarios where speed, volume, and low cost are the top priorities. Examples include bulk listing from 1688 to TEMU, batch uploading of high-SKU inventory, entry-level AI processing for top sellers and ERP/SaaS platforms, and merchants with high daily processing volumes but low requirements for marketing performance.
  * By filtering images that contain watermarks or non-compliant elements and prioritizing clean original images, this service reduces AI generation steps and helps merchants complete cross-platform listings at minimal call cost.
  * ## Features
  * This service uses an officially preset minimum-cost product optimization workflow that covers the entire pipeline from asset retrieval, compliance filtering, and text optimization to image processing:
  * 1. Automatically parses 1688 product links and extracts multiple asset types such as titles, SKUs, main images, detail images, and attributes.
  * 2. Performs text filtering and SEO optimization based on the TEMU platform blocklist and compliance rules.
  * 3. Intelligently identifies watermarks, logos, and Chinese text in images, prioritizing filtering and selecting clean original images. SKU images and a small number of main images are processed with image translation capabilities to meet platform standards (high-conversion images with marketing text may be filtered out).
  * 4. Completes category matching, attribute filling, and localized rewriting based on target platform requirements.
  * @param request  the request parameters of AssetOptimizeLite  AssetOptimizeLiteRequest
  * @return AssetOptimizeLiteResponse
 */
async function assetOptimizeLite(request: AssetOptimizeLiteRequest): AssetOptimizeLiteResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AssetOptimizeLite', 'POST', '/', 'json', false, 'json', request);
}

model AssetOptimizeProRequest {
  columnNameList?: [ string ](name='ColumnNameList', description='The list of column names to recognize in size chart images. Optional.', example='["Bust","Waist","Hip"]', shrink='json', position='Query'),
  glossary?: string(name='Glossary', description='The glossary ID. Optional. Create a glossary in the console and provide its ID. If left empty, translation results are not modified by any glossary.', example='glossary_1', position='Query'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Specifies whether to translate text on the product subject area of images. Setting this to false helps protect embedded information such as product names from being translated. Default value: false.', example='false', position='Query'),
  languageModel?: string(name='LanguageModel', description='The output language format for size chart images. If not specified, the original format is used. Set to en for English output or cn for Chinese output.', example='cn', position='Query'),
  needTrans: boolean(name='NeedTrans', description='Specifies whether translation is required (true/false). If set to true, SourceLanguage and TargetLanguage are required.

This parameter is required.', example='true', position='Query'),
  productUrl: string(name='ProductUrl', description='The product URL. This parameter is required. Only 1688 product links are supported.

This parameter is required.', example='https://detail.1688.com/offer/771024907536.html', position='Query'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. Optional. For supported language pairs, refer to the supported translation language list. This parameter is required if NeedTrans is set to true.', example='zh', position='Query'),
  sourcePlatform: string(name='SourcePlatform', description='The source platform. Only 1688 is supported.

This parameter is required.', example='1688', position='Query'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code. Optional. For supported language pairs, refer to the supported translation language list. This parameter is required if NeedTrans is set to true.', example='en', position='Query'),
  targetPlatform: string(name='TargetPlatform', description='The target listing platform. Only temu is supported.

This parameter is required.', example='temu', position='Query'),
  threshold?: double(name='Threshold', description='The confidence threshold for size chart detection. Default value: 0.4. A value of 0 treats all images as size charts. A value of 1 treats no images as size charts.', example='0.4', position='Query'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names on images. Optional. Default value: false. Setting this to false helps protect brand name information from being translated.', example='false', position='Query'),
}

model AssetOptimizeProResponseBody = {
  code?: string(name='Code', description='The status code. The value "success" is returned for a successful call.', example='success'),
  data?: {
    taskId?: string(name='TaskId', description='The asynchronous task ID. Use this ID to query the processing result by calling QueryAsyncTaskResult.', example='8080345d-b28a-9e2e-9ad7-370f8e236949'),
  }(name='Data', description='The submit result of the asynchronous task, which contains the asynchronous task ID.'),
  message?: string(name='Message', description='The error message. The value "Success" is returned for a successful call.', example='Success'),
  requestId?: string(name='RequestId', description='The request ID, which uniquely identifies the request.', example='4FCCA90A-A7A4-1D37-88C3-C17549886E70'),
  success?: boolean(name='Success', description='Indicates whether the call is successful. A value of true indicates success. A value of false indicates failure.', example='true'),
}

model AssetOptimizeProResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AssetOptimizeProResponseBody(name='body'),
}

/**
  * @description ## Product Introduction
  * A one-click cross-platform product listing optimization service for cross-border e-commerce sellers (best performance edition). Accepts a 1688 product link as input and outputs a complete set of assets adapted to TEMU platform requirements, including titles, attributes, main images, SKU images, detail images, and copywriting.
  * ## Common scenarios
  * Suitable for scenarios that demand high-quality cross-platform product listing assets and strong conversion performance. Examples include categories with high dependency on marketing assets such as apparel, accessories, beauty, and home goods. Also ideal for brand merchants and high-value products that need to preserve the tone of marketing images with embedded copywriting. Designed for top sellers and ERP/SaaS platforms conducting localized operations across multiple languages and markets, as well as scenarios that require category-specific assets (such as size charts and weight/dimension tables) to improve listing quality and conversion rates.
  * ## Functions and features
  * This service uses an officially pre-built "Best Performance" product optimization workflow that covers the entire pipeline from asset retrieval, diagnosis, filtering, and optimization to output:
  * 1. Automatically parses 1688 product links to extract all assets including titles, SKUs, main images, detail images, and attributes. Intelligently diagnoses missing assets and optimization opportunities.
  * 2. Uses LLM-based text compliance filtering, SEO keyword optimization, five-point description generation, and multilingual localization rewriting.
  * 3. Invokes multiple image processing capabilities including intelligent recognition, intelligent background removal, intelligent erasure, Image Translation Pro, image expansion, intelligent cropping, and HD upscaling.
  * 4. Outputs category-specific assets such as size charts and weight/dimension tables for apparel categories.
  * 5. Delivers a standardized product asset package ready for direct listing.
  * @param request  the request parameters of AssetOptimizePro  AssetOptimizeProRequest
  * @return AssetOptimizeProResponse
 */
async function assetOptimizePro(request: AssetOptimizeProRequest): AssetOptimizeProResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AssetOptimizePro', 'POST', '/', 'json', false, 'json', request);
}

model CategoryAttributeMatchRequest {
  description?: string(name='Description', description='The product details.', example='Silk, new spring style', position='Body'),
  imageUrl?: [ string ](name='ImageUrl', description='The product image URLs. A maximum of 10 images are supported.', example='https://frametour-assets.oss-cn-shanghai.aliyuncs.com/user-faces/viid_face/dd0dd06c-9351-4e5f-bc70-24166a754d7f.jpg', shrink='json', position='Body'),
  itemSpec: string(name='ItemSpec', description='The product attributes that describe the product characteristics.

This parameter is required.', example='For example, the material of the product. Enter the attribute name and attribute value', position='Body'),
  sku: string(name='Sku', description='The product SKU title.

This parameter is required.', example='0:0:Color:Black (without locator);0:1:Color:Smart Locator (without collar);0:2:Color:Range Locator (without collar);0:3:Color:Blue (without locator);0:4:Color:Orange (without locator);0:5:Color:Pink (without locator);0:6:Color:Red (without locator);0:7:Color:Yellow (without locator);0:8:Color:Purple (without locator)', position='Body'),
  sourceCategory: string(name='SourceCategory', description='The product category on the source platform.

This parameter is required.', example='Clothing', position='Body'),
  sourcePlatform: string(name='SourcePlatform', description='The source platform from which the product originates.

This parameter is required.', example='1688', position='Body'),
  targetPlatform: string(name='TargetPlatform', description='The target listing platform. Currently, only temu is supported.

This parameter is required.', example='temu', position='Body'),
  title: string(name='Title', description='The product title.

This parameter is required.', example='Women\\\\"s New Spring Clothing', position='Body'),
}

model CategoryAttributeMatchResponseBody = {
  code?: string(name='Code', description='The error code. This parameter is not returned for successful calls.', example='200'),
  data?: {
    attributes?: [ 
      {
        attrId?: int32(name='AttrId', description='The attribute ID.', example='682439'),
        confidence?: int32(name='Confidence', description='The matching confidence score, ranging from 0 to 100.', example='50'),
