  annotatedImageUrl: string(name='AnnotatedImageUrl', description='The URL of the annotated image, which is the original image overlaid with blue or red rectangular bounding box lines drawn manually. The URL must be publicly accessible. The image size cannot exceed 4000 × 4000 pixels or 10 MB. Supported formats include PNG, JPEG, and JPG.

This parameter is required.', example='https://example.com/annotated_image.png', position='Query'),
  rawImageUrl: string(name='RawImageUrl', description='The URL of the raw image, which is the unannotated photo of the parcel on the scanning platform. The URL must be publicly accessible. The image size cannot exceed 4000 × 4000 pixels or 10 MB. Supported formats include PNG, JPEG, and JPG.

This parameter is required.', example='https://example.com/raw_image.png', position='Query'),
}

model PackageWeightSizeCheckResponseBody = {
  code?: string(name='Code', description='The response code. A value of 200 indicates a successful call. For other response codes, refer to the error code information.', example='200'),
  data?: {
    taskId?: string(name='TaskId', description='The asynchronous task ID, which is used to query the audit result by calling QueryAsyncTaskResult.', example='a8323ada-a196-9061-976f-90e38b27323a'),
  }(name='Data', description='The asynchronous submit result data, which includes the asynchronous task ID.'),
