  imageUrl: string(name='ImageUrl', description='The URL of the original image. The image must be in JPG, JPEG, PNG, BMP, or WEBP format, with a resolution between 256 × 256 and 3000 × 3000 pixels, and a file size of no more than 10 MB.

This parameter is required.', example='https://img.alicdn.com/bao/uploaded/i2/xxx.jpg', position='Query'),
  mask?: string(name='Mask', description='The specific removal area. This parameter must be used with the editor. The input format is RLE.
If specified, this parameter takes priority and the remove_non_product_area_elements and remove_product_area_elements parameters are ignored. This parameter is optional, but at least one of the following parameters must be specified: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, or UserImage.
When multiple parameters are specified, the priority order is: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='"474556 160 475356 160 476156 160 476956 160 477756 160 478556 160 479356 160 480156 160 480956 160 481756 160 482556 160 483356 160 484156 160 484956 160 485756 160 486556 160 487356 160 488156 160 488956 160 489756 160 490556 160 491356 160 492156 160"', position='Query'),
  nonObjectRemoveElements?: [ int32 ](name='NonObjectRemoveElements', description='The elements to remove from the non-subject area of the image (1 = transparent text blocks, 2 = specific names, 3 = text, 4 = image blemishes). You can select multiple element types. This parameter is optional, but at least one of the following parameters must be specified: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, or UserImage.
When multiple parameters are specified, the priority order is: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.
Refer to the product description for details about each type.', example='[1,2]', shrink='json', position='Query'),
  objectRemoveElements?: [ int32 ](name='ObjectRemoveElements', description='The elements to remove from the image subject (1 = transparent text blocks, 2 = specific names, 3 = text, 4 = image blemishes). You can select multiple element types. This parameter is optional, but at least one of the following parameters must be specified: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, or UserImage.
When multiple parameters are specified, the priority order is: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.
Refer to the product description for details about each type.
Image subject: The core product area in the image.', example='[1,2]', shrink='json', position='Query'),
  position?: string(name='Position', description='The specific removal area. This parameter must be used with the editor. The input format is four-point coordinates [xx,yy,zz,dd]. This parameter is optional, but at least one of the following parameters must be specified: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, or UserImage.
When multiple parameters are specified, the priority order is: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='[10,10,100,100]', position='Query'),
  userImage?: [ string ](name='UserImage', description='The user-specified image element links to remove. Multiple image links are supported. The input format is ["https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg","https://ae01.alicdn.com/kf/S342f0070dc9f4be09a6cbed34e90dc8fs.jpg"]. This parameter is optional, but at least one of the following parameters must be specified: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, or UserImage.
When multiple parameters are specified, the priority order is: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='["https://img.alicdn.com/bao/uploaded/i2/xxx.jpg"]', shrink='json', position='Query'),
  userText?: [ string ](name='UserText', description='The user-specified text to remove. Multiple text inputs are supported. The input format is ["xx","yy"]. This parameter is optional, but at least one of the following parameters must be specified: ObjectRemoveElements, NonObjectRemoveElements, Mask, Position, UserText, or UserImage.
When multiple parameters are specified, the priority order is: UserImage > UserText > Position > Mask > ObjectRemoveElements = NonObjectRemoveElements.', example='["xx","yy"]', shrink='json', position='Query'),
}

