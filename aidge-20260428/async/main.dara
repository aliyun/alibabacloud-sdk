  needTrans: boolean(name='NeedTrans', description='Specifies whether translation is required.

This parameter is required.', example='true', position='Query'),
  productUrl: string(name='ProductUrl', description='The product URL.

This parameter is required.', example='https://detail.1688.com/offer/631960323816.html', position='Query'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code, such as zh.', example='zh', position='Query'),
  sourcePlatform: string(name='SourcePlatform', description='The source platform, such as 1688.

This parameter is required.', example='1688', position='Query'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code, such as en.', example='en', position='Query'),
  targetPlatform: string(name='TargetPlatform', description='The target platform, such as temu.

This parameter is required.', example='temu', position='Query'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names in images. Default value: false.', example='false', position='Query'),
}

model AssetOptimizeLiteResponseBody = {
  code?: string(name='Code', description='The error code.', example='200'),
  data?: {
    taskId?: string(name='TaskId', description='The asynchronous task ID, which is used to query the result later.', example='task-xxxxxx'),
  }(name='Data', description='The submit result of the asynchronous task.'),
  message?: string(name='Message', description='The error message.', example='OK'),
  requestId?: string(name='RequestId', description='Id of the request', example='E1AD60F1-BAC7-546B-9533-E7AD02B16E3F'),
