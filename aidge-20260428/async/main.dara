This parameter is required.', example='zh', position='Body'),
  translateScene?: string(name='TranslateScene', description='The format of the text to translate. **html**: web page format. If you set this parameter to html, the source text and translated text are processed in HTML format. **text**: text format. If you set this parameter to text, the source text and translated text are processed as plain text without format processing.', example='e-commerce-title', position='Body'),
}

