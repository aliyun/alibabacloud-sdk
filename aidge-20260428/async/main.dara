    noobjCharacter?: boolean(name='NoobjCharacter', description='Indicates whether the non-subject area contains text.', example='true'),
    noobjLogo?: boolean(name='NoobjLogo', description='Indicates whether the non-subject area contains a logo.', example='false'),
    noobjNpx?: boolean(name='NoobjNpx', description='Indicates whether the non-subject area contains irrelevant pixels or noise.', example='false'),
    noobjWatermark?: boolean(name='NoobjWatermark', description='Indicates whether the non-subject area contains a watermark.', example='false'),
    objCharacter?: boolean(name='ObjCharacter', description='Indicates whether the subject area contains text.', example='true'),
    objLogo?: boolean(name='ObjLogo', description='Indicates whether the subject area contains a logo.', example='false'),
    objNpx?: boolean(name='ObjNpx', description='Indicates whether the subject area contains irrelevant pixels or noise.', example='false'),
    objWatermark?: boolean(name='ObjWatermark', description='Indicates whether the subject area contains a watermark.', example='false'),
