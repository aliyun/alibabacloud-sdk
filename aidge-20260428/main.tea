import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'aidge.cn-beijing.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('aidge', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AssetOptimizeLiteRequest {
  glossary?: string(name='Glossary', description='Custom glossary', example='测试'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Whether to include product region translation', example='false'),
  needTrans?: boolean(name='NeedTrans', description='Whether translation is required

This parameter is required.', example='true'),
  productUrl?: string(name='ProductUrl', description='Product Link URL

This parameter is required.', example='https://detail.1688.com/offer/631960323816.html'),
  sourceLanguage?: string(name='SourceLanguage', description='Source language code, e.g., zh', example='zh'),
  sourcePlatform?: string(name='SourcePlatform', description='Source platform, e.g., 1688

This parameter is required.', example='1688'),
  targetLanguage?: string(name='TargetLanguage', description='Target language code, e.g., en', example='en'),
  targetPlatform?: string(name='TargetPlatform', description='Target platform, e.g., temu

This parameter is required.', example='temu'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Whether to translate brand names in images, default false', example='false'),
}

model AssetOptimizeLiteResponseBody = {
  code?: string(name='Code', description='Error code', example='200'),
  data?: {
    taskId?: string(name='TaskId', description='Asynchronous task ID, used for subsequent result queries', example='task-xxxxxx'),
  }(name='Data', description='Asynchronous task submission result'),
  message?: string(name='Message', description='Error message', example='OK'),
  requestId?: string(name='RequestId', description='Id of the request', example='E1AD60F1-BAC7-546B-9533-E7AD02B16E3F'),
  success?: boolean(name='Success', description='Whether the call was successful', example='True'),
}

model AssetOptimizeLiteResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AssetOptimizeLiteResponseBody(name='body'),
}

/**
 * @summary A one-click cross-platform product material optimization service for cross-border e-commerce sellers (minimum cost version). Input product links from source platforms to generate optimized materials including titles, attributes, main images, SKU images, detail images, and descriptions that comply with the target platform\\"s requirements. Uses officially pre-built minimum-cost workflows, primarily based on filtering and lightweight processing without invoking high-cost image translation capabilities, maximizing cost control while ensuring listing compliance. (Asynchronous)
 *
 * @description ## Product Introduction
 * A one-click cross-platform product material optimization service for cross-border e-commerce sellers (minimum cost version). Input product links from source platforms to generate optimized materials including titles, attributes, main images, SKU images, detail images, and descriptions that comply with the target platform\\"s requirements. Uses officially pre-built minimum-cost workflows, primarily based on filtering and lightweight processing without invoking high-cost image translation capabilities, maximizing cost control while ensuring listing compliance. (Asynchronous)
 * ## Applicable Scenarios
 * Suitable for cost-sensitive cross-platform product listing scenarios where speed, volume, and affordability are top priorities: for example, bulk listing from 1688 to TEMU, high-SKU inventory batch uploads, entry-level AI processing capabilities provided by top sellers and ERP/SaaS platforms, and merchants with high daily processing volumes but low requirements for marketing performance.
 * By filtering images containing watermarks or non-compliant elements and prioritizing clean original images, it helps merchants complete cross-platform listings at minimal cost.
 * ## Feature Overview
 * This service uses an officially pre-built "Minimum Cost" product optimization workflow, covering the full pipeline from material acquisition, compliance filtering, text optimization, to image processing:
 * 1. Automatically parses 1688 product links to extract multiple material types including titles, SKUs, main images, detail images, and attributes;
 * 2. Performs text filtering and SEO optimization based on TEMU platform blacklisted terms and compliance rules;
 * 3. Intelligently identifies watermarks, logos, and Chinese text in images, prioritizing filtering and selecting clean original images. SKU images and a small number of main images are processed using image translation capabilities to comply with platform standards (high-conversion images with marketing text may be filtered out);
 * 4. Completes category matching, attribute filling, and localization rewriting according to target platform requirements.
 *
 * @param request AssetOptimizeLiteRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AssetOptimizeLiteResponse
 */
async function assetOptimizeLiteWithOptions(request: AssetOptimizeLiteRequest, runtime: Util.RuntimeOptions): AssetOptimizeLiteResponse {
  Util.validateModel(request);
  var query = {};
  if (!Util.isUnset(request.glossary)) {
    query['Glossary'] = request.glossary;
  }
  if (!Util.isUnset(request.includingProductArea)) {
    query['IncludingProductArea'] = request.includingProductArea;
  }
  if (!Util.isUnset(request.needTrans)) {
    query['NeedTrans'] = request.needTrans;
  }
  if (!Util.isUnset(request.productUrl)) {
    query['ProductUrl'] = request.productUrl;
  }
  if (!Util.isUnset(request.sourceLanguage)) {
    query['SourceLanguage'] = request.sourceLanguage;
  }
  if (!Util.isUnset(request.sourcePlatform)) {
    query['SourcePlatform'] = request.sourcePlatform;
  }
  if (!Util.isUnset(request.targetLanguage)) {
    query['TargetLanguage'] = request.targetLanguage;
  }
  if (!Util.isUnset(request.targetPlatform)) {
    query['TargetPlatform'] = request.targetPlatform;
  }
  if (!Util.isUnset(request.translatingBrandInTheProduct)) {
    query['TranslatingBrandInTheProduct'] = request.translatingBrandInTheProduct;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'AssetOptimizeLite',
    version = '2026-04-28',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

