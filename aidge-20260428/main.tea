This parameter is required.', example='ko'),
  translateScene?: string(name='TranslateScene', description='The format of the translation text. **html** (web page format. This setting processes both the source text and translated text in HTML format) or **text** (text format. This setting processes both the source text and translated result as plain text without format processing).', example='e-commerce-title'),
}

