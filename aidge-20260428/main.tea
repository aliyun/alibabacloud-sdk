model ImageTranslationProRequest {
  async?: boolean(name='Async', description='Specifies whether to use asynchronous mode. Default value: false (synchronous mode). When set to true, the operation immediately returns a TaskId, and you must call the query translation result operation to obtain the final result.', example='true'),
  glossary?: string(name='Glossary', description='The glossary ID. Optional. Create a glossary separately in the console and provide its ID. If the glossary ID is empty, the translation results are not modified.', example='glossary_1'),
  imageUrl?: string(name='ImageUrl', description='The URL of the original image. Required. Image requirements: width and height cannot exceed 4000 × 4000 pixels, size cannot exceed 10 MB, and supported formats include png, jpeg, jpg, bmp, and webp.

This parameter is required.', example='https://img.alicdn.com/imgextra/i3/O1CN01HTDhDi28Fd85ZYs7H_!!6000000007903-0-tps-800-800.jpg'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Specifies whether to translate text on the image subject body. Optional. Default value: false. This helps you protect information and avoid translating embedded information such as product names.', example='false'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. Required. For supported language pairs, see the supported language pair list.

This parameter is required.', example='en'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code. Required. For supported language pairs, see the supported language pair list.

This parameter is required.', example='ko'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names on the image. Optional. Default value: false. This helps you protect brand name information and avoid unintended translation.', example='false'),
  useImageEditor?: boolean(name='UseImageEditor', description='Specifies whether to return layout information such as text position, font, and color. When set to true, layer information is returned, which can be used with an image editor for secondary editing. Default value: false.', example='false'),
}

