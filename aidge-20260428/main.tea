model AssetOptimizeProRequest {
  columnNameList?: [ string ](name='ColumnNameList', description='The list of column names to recognize in size chart images. Optional.', example='["胸围","腰围","臀围"]'),
  glossary?: string(name='Glossary', description='The glossary ID. Optional. Create a glossary in the console and provide its ID. If left empty, translation results are not modified by any glossary.', example='glossary_1'),
  includingProductArea?: boolean(name='IncludingProductArea', description='Specifies whether to translate text on the product subject area of images. Setting this to false helps protect embedded information such as product names from being translated. Default value: false.', example='false'),
  languageModel?: string(name='LanguageModel', description='The output language format for size chart images. If not specified, the original format is used. Set to en for English output or cn for Chinese output.', example='cn'),
  needTrans?: boolean(name='NeedTrans', description='Specifies whether translation is required (true/false). If set to true, SourceLanguage and TargetLanguage are required.

This parameter is required.', example='true'),
  productUrl?: string(name='ProductUrl', description='The product URL. This parameter is required. Only 1688 product links are supported.

This parameter is required.', example='https://detail.1688.com/offer/771024907536.html'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language code. Optional. For supported language pairs, refer to the supported translation language list. This parameter is required if NeedTrans is set to true.', example='zh'),
  sourcePlatform?: string(name='SourcePlatform', description='The source platform. Only 1688 is supported.

This parameter is required.', example='1688'),
  targetLanguage?: string(name='TargetLanguage', description='The target language code. Optional. For supported language pairs, refer to the supported translation language list. This parameter is required if NeedTrans is set to true.', example='en'),
  targetPlatform?: string(name='TargetPlatform', description='The target listing platform. Only temu is supported.

This parameter is required.', example='temu'),
  threshold?: double(name='Threshold', description='The confidence threshold for size chart detection. Default value: 0.4. A value of 0 treats all images as size charts. A value of 1 treats no images as size charts.', example='0.4'),
  translatingBrandInTheProduct?: boolean(name='TranslatingBrandInTheProduct', description='Specifies whether to translate brand names on images. Optional. Default value: false. Setting this to false helps protect brand name information from being translated.', example='false'),
}

