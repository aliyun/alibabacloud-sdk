import Credential;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-qingdao' = 'dts.aliyuncs.com',
    'cn-beijing' = 'dts.aliyuncs.com',
    'cn-zhangjiakou' = 'dts.aliyuncs.com',
