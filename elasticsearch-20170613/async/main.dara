    name?: string(name='name', description='The name of the collector.', example='ct-test'),
    ownerId?: string(name='ownerId', description='The ID of the account.', example='16852099488*****'),
    resId?: string(name='resId', description='The instance ID of the collector.', example='ct-cn-77uqof2s7rg5c****'),
    resType?: string(name='resType', description='The type of the collector. Valid values: fileBeat, metricBeat, heartBeat, and audiBeat.', example='fileBeat'),
