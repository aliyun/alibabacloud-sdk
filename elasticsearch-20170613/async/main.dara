  message?: string(name='message', description='The error description. The value is null when the call is successful. A specific error message is returned when the call fails.', example='Agent subscription is inactive or expired'),
  requestId?: string(name='requestId', description='Id of the request', example='1df6d614-96db-41bd-b8b6-ab061a1724ca'),
