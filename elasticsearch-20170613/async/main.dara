    {
      vsArea?: string(name='vsArea', description='The zone information, such as cn-hangzhou-i.', example='cn-hangzhou-i'),
      vswitchId?: string(name='vswitchId', description='vswitchId', example='vsw-xxxx'),
    }
  ](name='loadBalanceConfig', description='The list of vSwitch and load balancing configurations for each zone in the Network Load Balancer (NLB) architecture.'),
  loadBalanceType?: string(name='loadBalanceType', description='The load balancing type. Default value: DEFAULT.', example='DEFAULT'),
  type?: string(name='type', description='The network type. Only VPC is supported.', example='vpc'),
