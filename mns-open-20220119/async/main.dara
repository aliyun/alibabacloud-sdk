      endpointValue?: string(name='EndpointValue', description='Deprecated. Use Endpoint.EndpointValue instead.', example='test-xxx-queue'),
    }
  ](name='Endpoints', description='This parameter is deprecated. Use Endpoint instead.', shrink='json', position='Query'),
  eventTypes: [ string ](name='EventTypes', description='A list of event types.

This parameter is required.', shrink='json', position='Query'),
  matchRules: [[
    EventMatchRule
  ]  ](name='MatchRules', description='A list of matching rules. The logical relationship between the rules is OR.

This parameter is required.', shrink='json', position='Query'),
  productName: string(name='ProductName', description='The name of the Alibaba Cloud product for which you want to receive event notifications.

This parameter is required.', example='oss', position='Query'),
  ruleName: string(name='RuleName', description='The name of the event rule.

This parameter is required.', example='rule-xsXDW', position='Query'),
}

