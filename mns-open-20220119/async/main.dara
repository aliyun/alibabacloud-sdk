init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Mns-open';
  @version = '2022-01-19';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model EventMatchRule {
  matchState?: boolean(name='MatchState', description='Indicates whether the rule is matched.', example='true'),
  name?: string(name='Name', description='The full name matching rule.', example='testBucket/folder1/file1'),
  prefix?: string(name='Prefix', description='The prefix matching rule.', example='testBucket/prefix1xxx'),
  suffix?: string(name='Suffix', description='The suffix matching rule.', example='suffix/xxxx.test'),
}

