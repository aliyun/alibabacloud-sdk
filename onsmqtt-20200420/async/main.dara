model ApplyTokenRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  actions: string(name='Actions', description='The permission type of the token. Valid values:
- **R**: read-only permissions. The client can only subscribe to the specified topics and cannot publish messages to the topics.
- **W**: write-only permissions. The client can only publish messages to the specified topics and cannot subscribe to the topics.
- **R,W**: read and write permissions. The client can publish messages to and subscribe to the specified topics. Separate **R** and **W** with a comma (,).

This parameter is required.', example='R', position='Query'),
  expireTime: long(name='ExpireTime', description='The expiration time of the token. The value is a millisecond timestamp. The minimum effective period is 60 seconds, and the maximum effective period is 30 days. If the specified value exceeds 30 days, the API operation does not return an error, but the actual effective period is 30 days.

Example: If the effective period of the token is 60 seconds and the current system time in milliseconds is 1609434061000, set this parameter to **1609434121000**, which is the sum of 1609434061000 and 60 × 1000.

This parameter is required.', example='1609434121000', position='Query'),
  instanceId: string(name='InstanceId', description='The ID of the ApsaraMQ for MQTT instance. The instance ID must match the actual instance ID used by the client. You can obtain the instance ID on the **Instance Details** page in the [console](https://mqtt.console.aliyun.com/).

This parameter is required.', example='post-cn-0pp12gl****', position='Query'),
  resources: string(name='Resources', description='The resource name, which is the topic of ApsaraMQ for MQTT. Separate multiple topics with commas (,). Each token can be used to perform operations on up to 100 resources. If multiple topics are specified, they must be sorted in lexicographical order.
The resource parameter registered when you apply for a token supports the MQTT wildcard syntax, including the plus sign (+) for single-level wildcards and the number sign (#) for multi-level wildcards.

For example, if you set **Resources** to "Topic1/+" when you apply for a token, the client can perform operations on any topic in the format of "Topic1/xxx". If you set **Resources** to "Topic1/#", the client can perform operations on any multi-level topic in the format of "Topic1/xxx/xxx/xxx".

> ApsaraMQ for MQTT supports matching child topics. You do not need to create child topics in the console. You can directly configure the settings in the message sending and receiving code. The forward slash (/) in a topic name is used to separate the parent topic and child topics. For more information, see [Terms](https://help.aliyun.com/document_detail/42420.html).

This parameter is required.', example='TopicA/+', position='Query'),
}

model ApplyTokenResponseBody = {
  requestId?: string(name='RequestId', description='The common parameter. The ID of each request is unique.', example='31782AAF-D0CC-44C3-ABFD-1B500276****'),
  token?: string(name='Token', description='The token returned by the broker.

> Do not make any assumptions about the length, format, or rules of the returned token. The actual returned value prevails.', example='****ng=='),
}

model ApplyTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ApplyTokenResponseBody(name='body'),
}

/**
  * @description - The request frequency limit for a single user is 100 calls per second. If you have special requirements, contact the technical support team of ApsaraMQ for MQTT. DingTalk group ID: 35228338.
  * - Each time you successfully call the **ApplyToken** API operation, it is counted as one message TPS, which affects your billing. For billing details, see [Billing overview](https://help.aliyun.com/document_detail/52819.html).
  * @param request  the request parameters of ApplyToken  ApplyTokenRequest
  * @return ApplyTokenResponse
 */
async function applyToken(request: ApplyTokenRequest): ApplyTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ApplyToken', 'POST', '/', 'json', false, 'json', request);
}

