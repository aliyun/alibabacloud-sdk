model DeleteDeviceCertificateRequest {
  caSn: string(name='CaSn', description='The serial number of the CA certificate to which the device certificate belongs. The serial number uniquely identifies a CA certificate. The CA certificate is used to verify the validity of the device certificate. The value can be up to 128 bytes in length.

This parameter is required.', example='007269004887******', position='Query'),
