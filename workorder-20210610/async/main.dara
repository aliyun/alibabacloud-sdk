  statusCode?: int32(name='statusCode'),
  body?: CloseTicketResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CloseTicket  CloseTicketRequest
  * @return CloseTicketResponse
 */
async function closeTicket(request: CloseTicketRequest): CloseTicketResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CloseTicket', 'POST', '/', 'json', true, 'form', request);
}

model CreateTicketRequest {
  categoryId: string(name='CategoryId', description='The ID of the issue category. Obtain this ID from the ListCategories operation.

This parameter is required.', example='53812', position='Body'),
  creatorId?: string(name='CreatorId', description='The Alibaba Cloud UID of the account that submits the ticket. This parameter is required for Marketplace reseller scenarios.', example='1289427240739141', position='Body'),
  description: string(name='Description', description='The description of the issue in the ticket. Only plain text is supported.

This parameter is required.', example='ECS backup failed', position='Body'),
  email?: string(name='Email', description='The contact email address for the ticket.', example='sdahkjdshga@qq.com', position='Body'),
  fileNameList?: [ string ](name='FileNameList', description='A list of attachment names. Use the ObjectKey value returned by the GetAttachmentUploadUrl operation.', shrink='simple', position='Body'),
  secretInfo?: {
    content?: string(name='Content', description='The text of the sensitive information.', example='ID card: 3310xxxx'),
    fileNameList?: [ string ](name='FileNameList', description='A list of attachment names for the sensitive information.'),
  }(name='SecretInfo', description='Sensitive information.', shrink='json', position='Query'),
  severity: int32(name='Severity', description='An enumeration value. A value of 1 indicates a normal issue. A value of 2 indicates an urgent issue.

This parameter is required.', example='1', minimum=0, maximum=1000, position='Body'),
  title?: string(name='Title', description='The title of the ticket.', example='ECS backup failed', position='Body'),
}

