  code?: int32(name='Code', description='The return code of the API request.', example='0'),
  data?: string(name='Data', description='The return value, which is the ticket ID.', example='0005PYGCW'),
  message?: string(name='Message', description='The error message. This parameter is returned when the value of Success is false.', example='success'),
  requestId?: string(name='RequestId', description='The unique ID of the request. Each request has a unique ID.', example='0254B7DE-7365-57B4-8E38-14FE927E3FEB'),
  success?: boolean(name='Success', description='Indicates whether the API call was successful. A value of true indicates that the call was successful.', example='True'),
}

model CreateTicketResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateTicketResponseBody(name='body'),
}

/**
