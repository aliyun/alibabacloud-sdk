/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('ossagent', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ChatRequest {
  messages?: [ 
    {
      content?: string(name='content', description='The conversation text content.', example='Hello'),
      role?: string(name='role', description='The role of the message.', example='user'),
    }
  ](name='messages', description='The messages.'),
  sessionId?: string(name='sessionId', description='The ID of the Q&A session.', example='UUID'),
}

model ChatResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  id?: string(name='id'),
  event?: string(name='event'),
  body?: string(name='body'),
}

/**
 * @summary Initiates a streaming chat session.
 *
 * @param request ChatRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ChatResponse
 */
@sse(true)
@context("chatWithSSECtx")
async function chatWithSSE(request: ChatRequest, headers: map[string]string, runtime: $RuntimeOptions): asyncIterator[ChatResponse] {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.messages)) {
    body['messages'] = request.messages;
  }
  if (!$isNull(request.sessionId)) {
    body['sessionId'] = request.sessionId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'Chat',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/stream`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  var sseResp = callSSEApi(params, req, runtime);
  for (var resp : sseResp) {
    if (!$isNull(resp.event) && !$isNull(resp.event.data)) {
      var data = resp.event.data;
      yield {
        statusCode = resp.statusCode,
        headers = resp.headers,
        id = resp.event.id,
        event = resp.event.event,
        body = data
      };
    }
  }
}
/**
 * @summary Initiates a streaming chat session.
 *
 * @param request ChatRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ChatResponse
 */
@context("chatWithContext")
async function chatWithOptions(request: ChatRequest, headers: map[string]string, runtime: $RuntimeOptions): ChatResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.messages)) {
    body['messages'] = request.messages;
  }
  if (!$isNull(request.sessionId)) {
    body['sessionId'] = request.sessionId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'Chat',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/stream`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Initiates a streaming chat session.
 *
 * @param request ChatRequest
 * @return ChatResponse
 */
async function chat(request: ChatRequest): ChatResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return chatWithOptions(request, headers, runtime);
}

model ConfirmRequest {
  confirmed?: boolean(name='confirmed', description='Specifies whether to approve the tool execution.', example='true'),
  phase?: string(name='phase', description='The current execution phase.', example='PARAM_INPUT'),
  reason?: string(name='reason', description='The reason for whether to call the tool.', example='null'),
  sessionId?: string(name='sessionId', description='The Q&A session ID.', example='UUID'),
  toolCalls?: [ 
    {
      id?: string(name='id', description='The tool ID, returned by the Chat operation.', example='call_662cc029b3444d8d923a7ea6'),
      modifiedInput?: map[string]any(name='modifiedInput', description='The command to execute for the tool calling operation, returned by the Chat operation.', example='{
    "command": "api put-bucket-acl --bucket xxx --acl private",
    "region": "cn-hangzhou"
}'),
      name?: string(name='name', description='The consumer name.', example='ossutil_safe'),
    }
  ](name='toolCalls', description='The tool invocations.'),
}

model ConfirmResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  id?: string(name='id'),
  event?: string(name='event'),
  body?: string(name='body'),
}

/**
 * @summary Confirms a tool calling operation.
 *
 * @param request ConfirmRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ConfirmResponse
 */
@sse(true)
@context("confirmWithSSECtx")
async function confirmWithSSE(request: ConfirmRequest, headers: map[string]string, runtime: $RuntimeOptions): asyncIterator[ConfirmResponse] {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.confirmed)) {
    body['confirmed'] = request.confirmed;
  }
  if (!$isNull(request.phase)) {
    body['phase'] = request.phase;
  }
  if (!$isNull(request.reason)) {
    body['reason'] = request.reason;
  }
  if (!$isNull(request.sessionId)) {
    body['sessionId'] = request.sessionId;
  }
  if (!$isNull(request.toolCalls)) {
    body['toolCalls'] = request.toolCalls;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'Confirm',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/confirm`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  var sseResp = callSSEApi(params, req, runtime);
  for (var resp : sseResp) {
    if (!$isNull(resp.event) && !$isNull(resp.event.data)) {
      var data = resp.event.data;
      yield {
        statusCode = resp.statusCode,
        headers = resp.headers,
        id = resp.event.id,
        event = resp.event.event,
        body = data
      };
    }
  }
}
