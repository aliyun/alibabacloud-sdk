model InterruptRequest {
}

model InterruptResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
 * @summary Interrupts a chat session.
 *
 * @param request InterruptRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return InterruptResponse
 */
@context("interruptWithContext")
async function interruptWithOptions(sessionId: string, request: InterruptRequest, headers: map[string]string, runtime: $RuntimeOptions): InterruptResponse {
  request.validate();
  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
  };
  var params = new OpenApiUtil.Params{
    action = 'Interrupt',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/interrupt/${$URL.percentEncode(sessionId)}`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Interrupts a chat session.
 *
 * @param request InterruptRequest
 * @return InterruptResponse
 */
async function interrupt(sessionId: string, request: InterruptRequest): InterruptResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return interruptWithOptions(sessionId, request, headers, runtime);
}

