/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('ossagent', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ChatRequest {
  messages?: [ 
    {
      content?: string(name='content', description='The conversation text content.', example='Hello'),
      role?: string(name='role', description='The role of the message.', example='user'),
    }
  ](name='messages', description='The messages.'),
  sessionId?: string(name='sessionId', description='The ID of the Q&A session.', example='UUID'),
}

model ChatResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
 * @summary Initiates a streaming chat session.
 *
 * @param request ChatRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ChatResponse
 */
async function chatWithOptions(request: ChatRequest, headers: map[string]string, runtime: Util.RuntimeOptions): ChatResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.messages)) {
    body['messages'] = request.messages;
  }
  if (!Util.isUnset(request.sessionId)) {
    body['sessionId'] = request.sessionId;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'Chat',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/stream`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Initiates a streaming chat session.
 *
 * @param request ChatRequest
 * @return ChatResponse
 */
async function chat(request: ChatRequest): ChatResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return chatWithOptions(request, headers, runtime);
}

model ConfirmRequest {
  confirmed?: boolean(name='confirmed', description='Specifies whether to approve the tool execution.', example='true'),
  phase?: string(name='phase', description='The current execution phase.', example='PARAM_INPUT'),
  reason?: string(name='reason', description='The reason for whether to call the tool.', example='null'),
  sessionId?: string(name='sessionId', description='The Q&A session ID.', example='UUID'),
  toolCalls?: [ 
    {
      id?: string(name='id', description='The tool ID, returned by the Chat operation.', example='call_662cc029b3444d8d923a7ea6'),
      modifiedInput?: map[string]any(name='modifiedInput', description='The command to execute for the tool calling operation, returned by the Chat operation.', example='{
    "command": "api put-bucket-acl --bucket xxx --acl private",
    "region": "cn-hangzhou"
}'),
      name?: string(name='name', description='The consumer name.', example='ossutil_safe'),
    }
  ](name='toolCalls', description='The tool invocations.'),
}

model ConfirmResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
 * @summary Confirms a tool calling operation.
 *
 * @param request ConfirmRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ConfirmResponse
 */
async function confirmWithOptions(request: ConfirmRequest, headers: map[string]string, runtime: Util.RuntimeOptions): ConfirmResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.confirmed)) {
    body['confirmed'] = request.confirmed;
  }
  if (!Util.isUnset(request.phase)) {
    body['phase'] = request.phase;
  }
  if (!Util.isUnset(request.reason)) {
    body['reason'] = request.reason;
  }
  if (!Util.isUnset(request.sessionId)) {
    body['sessionId'] = request.sessionId;
  }
  if (!Util.isUnset(request.toolCalls)) {
    body['toolCalls'] = request.toolCalls;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'Confirm',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/confirm`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Confirms a tool calling operation.
 *
 * @param request ConfirmRequest
 * @return ConfirmResponse
 */
async function confirm(request: ConfirmRequest): ConfirmResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return confirmWithOptions(request, headers, runtime);
}

model GetSessionContentRequest {
  sessionId?: string(name='sessionId', description='The session ID.', example='UUID'),
}

model GetSessionContentResponseBody = {
  content?: [ 
    {
      agentContents?: [ 
        {
          agentContent?: string(name='agentContent', description='The detailed conversation chunk content. All chunks compose the complete response.', example='{\\\\"id\\\\":\\\\"16aa7737-9e6a-4500-abd2-96c5f17d1188\\\\",\\\\"object\\\\":\\\\"chat.completion.chunk\\\\",\\\\"created\\\\":1788408524,\\\\"model\\\\":\\\\"oss-agent\\\\",\\\\"choices\\\\":[{\\\\"index\\\\":0,\\\\"delta\\\\":{\\\\"role\\\\":\\\\"assistant\\\\",\\\\"content\\\\":\\\\"，Hello， I am OSS Agent\\\\"}}]}'),
          timestamp?: string(name='timestamp', description='The time when the content was generated, in the yyyy-MM-dd HH:mm:ss,SSS format.', example='1774577589'),
        }
      ](name='agentContents', description='The detailed conversation content.'),
      timestamp?: string(name='timestamp', description='The time when the session occurred, in the yyyy-MM-dd HH:mm:ss,SSS format.', example='2026-09-03 04:08:30,637'),
      toolConfirm?: boolean(name='toolConfirm', description='Indicates whether tool confirmation is required.', example='false'),
      userContent?: string(name='userContent', description='The user content of the first message in the session.', example='[{\\\\"role\\\\":\\\\"user\\\\",\\\\"content\\\\":\\\\"Hi OSS\\\\"}]'),
    }
  ](name='content', description='The conversation text content.'),
  requestId?: string(name='requestId', description='Id of the request', example='UUID'),
  sessionId?: string(name='sessionId', description='The session ID.', example='UUID'),
}

model GetSessionContentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetSessionContentResponseBody(name='body'),
}

/**
 * @summary Retrieves the details of a session. You can only query sessions generated by your own account.
 *
 * @param request GetSessionContentRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return GetSessionContentResponse
 */
async function getSessionContentWithOptions(request: GetSessionContentRequest, headers: map[string]string, runtime: Util.RuntimeOptions): GetSessionContentResponse {
  Util.validateModel(request);
  var query : map[string]any = {};
  if (!Util.isUnset(request.sessionId)) {
    query['sessionId'] = request.sessionId;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'GetSessionContent',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/oss/agent/get_session_content.json`,
    method = 'GET',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Retrieves the details of a session. You can only query sessions generated by your own account.
 *
 * @param request GetSessionContentRequest
 * @return GetSessionContentResponse
 */
async function getSessionContent(request: GetSessionContentRequest): GetSessionContentResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return getSessionContentWithOptions(request, headers, runtime);
}

model InterruptRequest {
}

model InterruptResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
 * @summary Interrupts a chat session.
 *
 * @param request InterruptRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return InterruptResponse
 */
async function interruptWithOptions(sessionId: string, request: InterruptRequest, headers: map[string]string, runtime: Util.RuntimeOptions): InterruptResponse {
  Util.validateModel(request);
  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
  };
  var params = new OpenApi.Params{
    action = 'Interrupt',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = `/api/chat/interrupt/${OpenApiUtil.getEncodeParam(sessionId)}`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'string',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Interrupts a chat session.
 *
 * @param request InterruptRequest
 * @return InterruptResponse
 */
async function interrupt(sessionId: string, request: InterruptRequest): InterruptResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return interruptWithOptions(sessionId, request, headers, runtime);
}

