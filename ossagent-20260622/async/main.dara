/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'OssAgent';
  @version = '2026-06-22';
  @endpointRule = '';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ChatRequest {
  messages?: [ 
    {
      content?: string(name='content'),
      role?: string(name='role', example='user'),
    }
  ](name='messages', position='Body'),
  sessionId?: string(name='sessionId', example='UUID', position='Body'),
}

model ChatResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
  * @param request  the request parameters of Chat  ChatRequest
  * @return ChatResponse
 */
async function chat(request: ChatRequest): ChatResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Chat', 'POST', '/api/chat/stream', 'string', false, 'json', request);
}

async function chatWithAsyncResponseHandler(request: ChatRequest, responseHandler: AsyncResponseHandler): ChatResponse {
  @handler.validateRequestModel(request);
  return @handler.doResponseHandler('RESTFUL', 'Chat', 'POST', '/api/chat/stream', 'string', false, 'json', request, responseHandler);
}

function chatWithResponseIterable(request: ChatRequest): iterator[string] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequestReturnString('SSE', 'Chat', 'POST', '/api/chat/stream', 'string', false, 'json', request);
}

model ConfirmRequest {
  confirmed?: boolean(name='confirmed', example='true', position='Body'),
  phase?: string(name='phase', example='PARAM_INPUT', position='Body'),
  reason?: string(name='reason', example='null', position='Body'),
  sessionId?: string(name='sessionId', example='UUID', position='Body'),
  toolCalls?: [ 
    {
      id?: string(name='id', example='call_662cc029b3444d8d923a7ea6'),
      modifiedInput?: map[string]any(name='modifiedInput', example='{
    "command": "api put-bucket-acl --bucket xxx --acl private",
    "region": "cn-hangzhou"
}'),
      name?: string(name='name', example='ossutil_safe'),
    }
  ](name='toolCalls', position='Body'),
}

model ConfirmResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
  * @param request  the request parameters of Confirm  ConfirmRequest
  * @return ConfirmResponse
 */
async function confirm(request: ConfirmRequest): ConfirmResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Confirm', 'POST', '/api/chat/confirm', 'string', false, 'json', request);
}

async function confirmWithAsyncResponseHandler(request: ConfirmRequest, responseHandler: AsyncResponseHandler): ConfirmResponse {
  @handler.validateRequestModel(request);
  return @handler.doResponseHandler('RESTFUL', 'Confirm', 'POST', '/api/chat/confirm', 'string', false, 'json', request, responseHandler);
}

function confirmWithResponseIterable(request: ConfirmRequest): iterator[string] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequestReturnString('SSE', 'Confirm', 'POST', '/api/chat/confirm', 'string', false, 'json', request);
}

model InterruptRequest {
  sessionId?: string(name='sessionId', example='UUID', position='Path'),
}

model InterruptResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
  * @param request  the request parameters of Interrupt  InterruptRequest
  * @return InterruptResponse
 */
async function interrupt(request: InterruptRequest): InterruptResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Interrupt', 'POST', '/api/chat/interrupt/{sessionId}', 'string', false, 'json', request);
}

