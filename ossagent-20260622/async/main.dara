/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'OssAgent';
  @version = '2026-06-22';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ChatRequest {
  messages?: [ 
    {
      content?: string(name='content', description='The conversation text content.', example='Hello'),
      role?: string(name='role', description='The role of the message.', example='user'),
    }
  ](name='messages', description='The messages.', position='Body'),
  sessionId?: string(name='sessionId', description='The ID of the Q&A session.', example='UUID', position='Body'),
}

model ChatResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
  * @param request  the request parameters of Chat  ChatRequest
  * @return ChatResponse
 */
async function chat(request: ChatRequest): ChatResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Chat', 'POST', '/api/chat/stream', 'string', false, 'json', request);
}

async function chatWithAsyncResponseHandler(request: ChatRequest, responseHandler: AsyncResponseHandler): ChatResponse {
  @handler.validateRequestModel(request);
  return @handler.doResponseHandler('RESTFUL', 'Chat', 'POST', '/api/chat/stream', 'string', false, 'json', request, responseHandler);
}

function chatWithResponseIterable(request: ChatRequest): iterator[string] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequestReturnString('SSE', 'Chat', 'POST', '/api/chat/stream', 'string', false, 'json', request);
}

model ConfirmRequest {
  confirmed?: boolean(name='confirmed', description='Specifies whether to approve the tool execution.', example='true', position='Body'),
  phase?: string(name='phase', description='The current execution phase.', example='PARAM_INPUT', position='Body'),
  reason?: string(name='reason', description='The reason for whether to call the tool.', example='null', position='Body'),
  sessionId?: string(name='sessionId', description='The Q&A session ID.', example='UUID', position='Body'),
  toolCalls?: [ 
    {
      id?: string(name='id', description='The tool ID, returned by the Chat operation.', example='call_662cc029b3444d8d923a7ea6'),
      modifiedInput?: map[string]any(name='modifiedInput', description='The command to execute for the tool calling operation, returned by the Chat operation.', example='{
    "command": "api put-bucket-acl --bucket xxx --acl private",
    "region": "cn-hangzhou"
}'),
      name?: string(name='name', description='The consumer name.', example='ossutil_safe'),
    }
  ](name='toolCalls', description='The tool invocations.', position='Body'),
}

model ConfirmResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
  * @param request  the request parameters of Confirm  ConfirmRequest
  * @return ConfirmResponse
 */
async function confirm(request: ConfirmRequest): ConfirmResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Confirm', 'POST', '/api/chat/confirm', 'string', false, 'json', request);
}

async function confirmWithAsyncResponseHandler(request: ConfirmRequest, responseHandler: AsyncResponseHandler): ConfirmResponse {
  @handler.validateRequestModel(request);
  return @handler.doResponseHandler('RESTFUL', 'Confirm', 'POST', '/api/chat/confirm', 'string', false, 'json', request, responseHandler);
}

function confirmWithResponseIterable(request: ConfirmRequest): iterator[string] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequestReturnString('SSE', 'Confirm', 'POST', '/api/chat/confirm', 'string', false, 'json', request);
}

model GetSessionContentRequest {
  sessionId?: string(name='sessionId', description='The session ID.', example='UUID', position='Query'),
}

model GetSessionContentResponseBody = {
  content?: [ 
    {
      agentContents?: [ 
        {
          agentContent?: string(name='agentContent', description='The detailed conversation chunk content. All chunks compose the complete response.', example='{\\\\"id\\\\":\\\\"16aa7737-9e6a-4500-abd2-96c5f17d1188\\\\",\\\\"object\\\\":\\\\"chat.completion.chunk\\\\",\\\\"created\\\\":1788408524,\\\\"model\\\\":\\\\"oss-agent\\\\",\\\\"choices\\\\":[{\\\\"index\\\\":0,\\\\"delta\\\\":{\\\\"role\\\\":\\\\"assistant\\\\",\\\\"content\\\\":\\\\"，Hello， I am OSS Agent\\\\"}}]}'),
          timestamp?: string(name='timestamp', description='The time when the content was generated, in the yyyy-MM-dd HH:mm:ss,SSS format.', example='1774577589'),
        }
      ](name='agentContents', description='The detailed conversation content.'),
      timestamp?: string(name='timestamp', description='The time when the session occurred, in the yyyy-MM-dd HH:mm:ss,SSS format.', example='2026-09-03 04:08:30,637'),
      toolConfirm?: boolean(name='toolConfirm', description='Indicates whether tool confirmation is required.', example='false'),
      userContent?: string(name='userContent', description='The user content of the first message in the session.', example='[{\\\\"role\\\\":\\\\"user\\\\",\\\\"content\\\\":\\\\"Hi OSS\\\\"}]'),
    }
  ](name='content', description='The conversation text content.'),
  requestId?: string(name='requestId', description='Id of the request', example='UUID'),
  sessionId?: string(name='sessionId', description='The session ID.', example='UUID'),
}

model GetSessionContentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetSessionContentResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetSessionContent  GetSessionContentRequest
  * @return GetSessionContentResponse
 */
async function getSessionContent(request: GetSessionContentRequest): GetSessionContentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetSessionContent', 'GET', '/api/oss/agent/get_session_content.json', 'json', false, 'json', request);
}

model InterruptRequest {
  sessionId?: string(name='sessionId', description='The session ID.', example='UUID', position='Path'),
}

model InterruptResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
  * @param request  the request parameters of Interrupt  InterruptRequest
  * @return InterruptResponse
 */
async function interrupt(request: InterruptRequest): InterruptResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Interrupt', 'POST', '/api/chat/interrupt/{sessionId}', 'string', false, 'json', request);
}

