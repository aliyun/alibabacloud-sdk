model UpdateServiceRolloutRequest {
  batch?: {
    batchSize?: string(name='BatchSize', description='The batch size. The number of replicas to update in each batch. Integer or percentage formats are supported. Default value: `"25%"`.', example='25%'),
    interval?: string(name='Interval', description='The batch interval. The wait time between two rollouts. Supported units: `s` (seconds), `m` (minutes), and `h` (hours).', example='60s'),
  }(name='Batch', description='**Batch**  
* Type: object
* Required: no
* Description: The batch rollout configuration. Used to adjust batch policy parameters. Mutually exclusive with Partition.'),
  partition?: {
    partition?: string(name='Partition', description='**Partition**  
* Type: string
* Required: yes
* Description: The partition value. Two formats are supported:
  1. Integer format: such as "5", which indicates that 5 old replicas are retained.
  2. Percentage format: such as "50%", which indicates that 50% of the old replicas are retained.
  Adjustment strategies:
  - Increase the value: Roll back to the old version and increase the proportion of old replicas.
  - Decrease the value: Proceed to the new version and decrease the proportion of old replicas.
  - Set to "0%": Complete the full update and switch all replicas to the new version.
* Example: 30%', example='30%'),
  }(name='Partition', description='**Partition**  
* Type: object
* Required: no
* Description: The partition rollout configuration. Used to adjust partition policy parameters. Mutually exclusive with Batch.'),
  paused?: boolean(name='Paused', description='Specifies whether to pause the rollout. A value of `true` indicates that the rollout is paused. A value of `false` indicates that the rollout is resumed.', example='true'),
}

model UpdateServiceRolloutResponseBody = {
  message?: string(name='Message', description='The returned message. Describes the request processing result. Valid values:
- "Rollout updated successfully": The rollout policy is updated.
- "Rollout paused successfully": The rollout is paused.
- "Rollout resumed successfully": The rollout is resumed.', example='Rollout updated successfully'),
  requestId?: string(name='RequestId', description='The request ID. The unique identifier returned for each request, used for troubleshooting and tracking.', example='40325405-579C-4D82****'),
}

model UpdateServiceRolloutResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateServiceRolloutResponseBody(name='body'),
}

/**
 * @summary Updates a service rollout plan.
 *
 * @description ## Request notes
 * - **Provide at least one parameter**: Specify at least one of the `Partition`, `Batch`, or `Paused` parameters in the request.
 * - **Mutually exclusive parameters**: The `Partition` and `Batch` parameters are mutually exclusive.
 * - **Immediate effect**: Updates take effect immediately and affect the ongoing service rollout process.
 * - **Rollback operations**: Increase the `Partition` value to roll back to a previous version. This action does not trigger automatically and requires a manual update of the service image.
 * - **Pausing does not affect parameters**: Pausing the rollout does not change the configured `Partition` or `Batch` parameters. It only pauses the execution of the current policy.
 *
 * @param request UpdateServiceRolloutRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return UpdateServiceRolloutResponse
 */
