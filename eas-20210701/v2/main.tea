/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'eas';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'pai-eas.cn-beijing.aliyuncs.com',
    'cn-zhangjiakou' = 'pai-eas.cn-zhangjiakou.aliyuncs.com',
    'cn-hangzhou' = 'pai-eas.cn-hangzhou.aliyuncs.com',
    'cn-shanghai' = 'pai-eas.cn-shanghai.aliyuncs.com',
    'cn-shenzhen' = 'pai-eas.cn-shenzhen.aliyuncs.com',
    'cn-hongkong' = 'pai-eas.cn-hongkong.aliyuncs.com',
    'ap-southeast-1' = 'pai-eas.ap-southeast-1.aliyuncs.com',
    'ap-southeast-5' = 'pai-eas.ap-southeast-5.aliyuncs.com',
    'us-east-1' = 'pai-eas.us-east-1.aliyuncs.com',
    'us-west-1' = 'pai-eas.us-west-1.aliyuncs.com',
    'eu-central-1' = 'pai-eas.eu-central-1.aliyuncs.com',
    'ap-south-1' = 'pai-eas.ap-south-1.aliyuncs.com',
    'cn-shanghai-finance-1' = 'pai-eas.cn-shanghai-finance-1.aliyuncs.com',
    'cn-north-2-gov-1' = 'pai-eas.cn-north-2-gov-1.aliyuncs.com',
    'cn-chengdu' = 'pai-eas.cn-chengdu.aliyuncs.com',
    'cn-zhongwei' = 'pai-eas.cn-zhongwei.aliyuncs.com',
    'cn-wulanchabu' = 'pai-eas.cn-wulanchabu.aliyuncs.com',
    'cn-heyuan' = 'pai-eas.cn-heyuan.aliyuncs.com',
    'ap-northeast-2' = 'pai-eas.ap-northeast-2.aliyuncs.com',
    'ap-northeast-1' = 'pai-eas.ap-northeast-1.aliyuncs.com',
    'cn-guangzhou' = 'pai-eas.cn-guangzhou.aliyuncs.com',
    'ap-southeast-3' = 'pai-eas.ap-southeast-3.aliyuncs.com',
    'ap-southeast-7' = 'pai-eas.ap-southeast-7.aliyuncs.com',
    'ap-southeast-8' = 'pai-eas.ap-southeast-8.aliyuncs.com',
    'us-southeast-1' = 'pai-eas.us-southeast-1.aliyuncs.com',
    'na-south-1' = 'pai-eas.na-south-1.aliyuncs.com',
    'me-east-1' = 'pai-eas.me-east-1.aliyuncs.com',
    'me-central-1' = 'pai-eas.me-central-1.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('eas', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model Artifact {
  createdAt?: string(name='CreatedAt', description='The creation time.', example='2024-01-15T10:30:00Z'),
  name?: string(name='Name', description='The artifact name.', example='foo'),
  type?: string(name='Type', description='The artifact type.', example='Image'),
  versions?: [ 
    {
      alias?: string(name='Alias', description='The version alias.', example='foo'),
      description?: string(name='Description', description='The template description associated with the version.', example='Supports new xx feature'),
      releaseName?: string(name='ReleaseName', description='The version name.', example='ali-ahpa-hz'),
      version?: string(name='Version', description='The version number.', example='V2.0'),
    }
  ](name='Versions', description='The version list.'),
}

model ArtifactRelease {
  artifactRef?: string(name='ArtifactRef', description='The artifact reference name.', example='python-env'),
  createdAt?: string(name='CreatedAt', description='The creation time of the artifact release record.', example='2024-01-15T10:30:00Z'),
  description?: string(name='Description', description='The artifact description.', example='Container image for model inference'),
  image?: string(name='Image', description='The container image address used by the artifact.', example='registry.cn-shanghai.aliyuncs.com/eas/echo_cn-shanghai:v0.0.1-20210129111320'),
  type?: string(name='Type', description='The artifact type.', example='Image'),
  version?: string(name='Version', description='The artifact version.', example='V2.0'),
}

model ContainerInfo {
  currentReaon?: string(name='CurrentReaon', description='The reason for the current status.', example='PodInitializing'),
  currentStatus?: string(name='CurrentStatus', description='The current status. Valid values:
- Waiting: waiting
- Running: running
- Terminated: terminated.', example='Waiting'),
  currentTimestamp?: string(name='CurrentTimestamp', description='The time when the current status occurred.', example='2022-03-21T06:17:57Z'),
  image?: string(name='Image', description='The image.', example='registry.cn-shanghai.aliyuncs.com/eas/echo_cn-shanghai:v0.0.1-20210129111320'),
  lastReason?: string(name='LastReason', description='The reason for the previous status.', example='Error'),
  lastStatus?: string(name='LastStatus', description='The previous status. Valid values:
- Waiting: waiting
- Running: running
- Terminated: terminated.', example='Terminated'),
  lastTimestamp?: string(name='LastTimestamp', description='The time when the previous status occurred.', example='2022-03-21T05:17:57Z'),
  name?: string(name='Name', description='The container name.', example='worker0'),
  port?: int32(name='Port', description='The port.', example='8080'),
  ready?: boolean(name='Ready', description='Indicates whether the health check is passed.', example='true'),
  restartCount?: int32(name='RestartCount', description='The number of restarts.', example='0'),
}

model Group {
  accessToken?: string(name='AccessToken', description='The access token for the traffic ingress of the service group.', example='MzJiMDI5MDliODc0MTlkYmI0ZDhlYmExYjczYTIyZTE3Zm********'),
  callerUid?: string(name='CallerUid', description='The UID of the account that created the service group.', example='20123*******'),
  clusterId?: string(name='ClusterId', description='The ID of the cluster where the service group is located.', example='cn-shanghai'),
  createTime?: string(name='CreateTime', description='The time when the service group was created. The time is displayed in UTC.', example='2020-05-19T14:19:42Z'),
  internetEndpoint?: string(name='InternetEndpoint', description='The public endpoint of the service group.', example='http://1110*****.cn-hangzhou.pai-eas.aliyuncs.com/api/predict/test_group'),
  intranetEndpoint?: string(name='IntranetEndpoint', description='The internal endpoint of the service group.', example='http://1110*****.vpc.cn-hangzhou.pai-eas.aliyuncs.com/api/predict/test_group'),
  labels?: [ 
    {
      labelKey?: string(name='LabelKey', description='The label key.', example='key1'),
      labelValue?: string(name='LabelValue', description='The label value.', example='value1'),
    }
  ](name='Labels', description='The list of labels for the service group.'),
  name?: string(name='Name', description='The name of the service group.', example='foo'),
  network?: {
    gatewayId?: string(name='GatewayId', description='The dedicated gateway ID.', example='gw-248xxxxxxvlkhtbrda'),
    securityGroupId?: string(name='SecurityGroupId', description='The security group ID.', example='sg-584xxxxxx7h08llvoww5tv5gl'),
    vSwitchId?: string(name='VSwitchId', description='The vSwitch ID.', example='vsw-bp1xxxxxxwmssgq28gye8'),
    vpcId?: string(name='VpcId', description='The VPC ID.', example='vpc-bp1xxxxxx0qrykjr9b'),
  }(name='Network', description='The virtual private cloud (VPC) configuration of the service group.'),
  parentUid?: string(name='ParentUid', description='The UID of the parent account that created the service group.', example='11234*******'),
  queueService?: string(name='QueueService', description='The queue services included in the service group.', example='qservice'),
  trafficMode?: string(name='TrafficMode', description='The traffic mode.', example='auto'),
  updateTime?: string(name='UpdateTime', description='The time when the service group was updated. The time is displayed in UTC.', example='2021-01-29T11:13:20Z'),
}

model Instance {
  createTime?: string(name='CreateTime', description='The creation time of the instance.', example='2021-05-27T09:46:05Z'),
  currentAmount?: float(name='CurrentAmount', description='The current hourly price of the spot instance.', example='0.444'),
  detached?: boolean(name='Detached', description='Indicates whether the instance is removed from active service rotation.', example='false'),
  externalIP?: string(name='ExternalIP', description='The IP address of the instance in your VPC.', example='192.168.1.100'),
  externalInstancePort?: int32(name='ExternalInstancePort', description='The port number of the instance in your VPC.', example='8080'),
  hostIP?: string(name='HostIP', description='The IP address of the instance\\\\"s host.', example='11.0.XX.XX'),
  hostName?: string(name='HostName', description='The name of the instance\\\\"s host.', example='smart-scene-cls-854dbdc99d-****'),
  innerIP?: string(name='InnerIP', description='The internal IP address of the instance.', example='172.17.0.17'),
  instanceName?: string(name='InstanceName', description='The name of the instance.', example='foo-5fc8946767-v****'),
  instancePort?: int32(name='InstancePort', description='The network port of the instance.', example='8080'),
  instanceType?: string(name='InstanceType', description='The instance type.', example='ecs.c7.large'),
  isLatest?: boolean(name='IsLatest', description='Indicates whether the instance is running the latest version.', example='true'),
  isReplica?: boolean(name='IsReplica', description='Indicates whether the instance is a replica.', example='false'),
  isSpot?: boolean(name='IsSpot', description='Indicates whether the instance is a spot instance.', example='false'),
  isolated?: boolean(name='Isolated', description='Indicates whether the instance accepts traffic.', example='false'),
  lastState?: [  map[string]any ](name='LastState', description='The status of the instance when it last exited.'),
  namespace?: string(name='Namespace', description='The namespace of the instance.', example='foo'),
  originalAmount?: float(name='OriginalAmount', description='The original price of the spot instance before discounts.', example='2.2'),
  readyProcesses?: int32(name='ReadyProcesses', description='The number of processes that have started in the instance.', example='1'),
  reason?: string(name='Reason', description='The identifier for the current status of the instance.', example='RUNNING'),
  replicaName?: string(name='ReplicaName', description='The name of the replica.', example='xwq-sglang-dist-7dff0'),
  resourceType?: string(name='ResourceType', description='The type of the resource group to which the instance belongs. Valid values include PublicResource and PrivateResource.', example='PublicResource'),
  restartCount?: int32(name='RestartCount', description='The number of times the instance has been restarted.', example='1'),
  role?: string(name='Role', description='The server role of the instance. Valid values include Queue, DataLoader, and Standard.', example='Standard'),
  startAt?: string(name='StartAt', description='The start time of the instance. (Deprecated. Use StartTime instead.)', example='2021-05-27T09:46:05Z', deprecated=true),
  startTime?: string(name='StartTime', description='The start time of the instance.', example='2021-05-27T09:46:05Z'),
  status?: string(name='Status', description='The status of the instance.', example='Running'),
  tenantHostIP?: string(name='TenantHostIP', description='The IP address of the host in the dedicated network.', example='192.168.xx.xx'),
  tenantInstanceIP?: string(name='TenantInstanceIP', description='The IP address of the instance in the dedicated network.', example='192.168.xx.xx'),
  totalProcesses?: int32(name='TotalProcesses', description='The total number of processes for the instance.', example='1'),
  zone?: string(name='Zone', description='The zone where the instance is located.', example='cn-shanghai-a'),
}

model Resource {
  clusterId?: string(name='ClusterId', description='The ID of the cluster where the resource group is located.', example='cn-shanghai'),
  cpuCount?: int32(name='CpuCount', description='The total number of CPU cores in the resource group.', example='64'),
  cpuUsed?: int32(name='CpuUsed', description='The number of used CPU cores in the resource group.', example='8'),
  createTime?: string(name='CreateTime', description='The time the resource group was created, in ISO 8601 format.', example='2019-02-26T17:52:49Z'),
  extraData?: map[string]any(name='ExtraData', description='Additional information.', example='{}'),
  features?: [ string ](name='Features', description='The features supported by the resource group.'),
  gpuCount?: int32(name='GpuCount', description='The total number of GPUs in the resource group.', example='1'),
  gpuUsed?: float(name='GpuUsed', description='The number of used GPUs in the resource group.', example='1'),
  instanceCount?: int32(name='InstanceCount', description='The total number of instances (prepaid and postpaid) in the resource group.', example='4'),
  instanceMaxAllocatableCPU?: int32(name='InstanceMaxAllocatableCPU', description='The maximum number of allocatable CPU cores per node.', example='16'),
  instanceMaxAllocatableGPU?: float(name='InstanceMaxAllocatableGPU', description='The maximum number of allocatable GPUs per node.', example='2'),
  instanceMaxAllocatableMemory?: int32(name='InstanceMaxAllocatableMemory', description='The maximum allocatable memory per node in the resource group.', example='2048'),
  memory?: int32(name='Memory', description='The total memory of the resource group, in MB.', example='8192'),
  memoryUsed?: int32(name='MemoryUsed', description='The amount of used memory in the resource group, in MB.', example='2048'),
  message?: string(name='Message', description='The latest status message for the resource group.', example='Resource is ready'),
  postPaidInstanceCount?: int32(name='PostPaidInstanceCount', description='The number of postpaid instances.', example='2'),
  prePaidInstanceCount?: int32(name='PrePaidInstanceCount', description='The number of prepaid instances.', example='2'),
  resourceId?: string(name='ResourceId', description='The unique identifier of the resource group.', example='eas-r-asdasdasd'),
  resourceName?: string(name='ResourceName', description='The name of the resource group.', example='iot'),
  resourceType?: string(name='ResourceType', description='The type of the resource group. Valid values:

- `Dedicated`: A dedicated resource group.

- `SelfManaged`: A self-managed resource group.', example='Dedicated'),
  serviceCount?: int32(name='ServiceCount', description='The number of services deployed in the resource group.', example='1'),
  status?: string(name='Status', description='The status of the resource group.', example='ResouceReady'),
  updateTime?: string(name='UpdateTime', description='The time the resource group was last updated, in ISO 8601 format.', example='2019-02-26T19:52:49Z'),
  usageMode?: string(name='UsageMode', description='The usage mode of the resource group.', example='inference'),
  vendor?: string(name='Vendor', description='The provider of the compute instances in the resource group, such as ECS.', example='ECS'),
}

model ResourceInstance {
  arch?: string(name='Arch', description='The system architecture of the instance.', example='arm64'),
  autoRenewal?: boolean(name='AutoRenewal', description='Indicates whether auto-renewal is enabled for the instance.', example='false'),
