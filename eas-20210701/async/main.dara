model UpdateServiceRolloutRequest {
  clusterId: string(name='ClusterId', description='**ClusterId**  
* Type: string
* Required: yes
* Description: The region ID. The identifier of the region where the service is deployed.
* Example: cn-shanghai

This parameter is required.', example='cn-shanghai', position='Path'),
  serviceName: string(name='ServiceName', description='**ServiceName**  
* Type: string
* Required: yes
* Description: The service name. The name of the service whose rollout policy you want to update.
* Example: my-service

This parameter is required.', example='my-service', position='Path'),
  batch?: {
    batchSize?: string(name='BatchSize', description='The batch size. The number of replicas to update in each batch. Integer or percentage formats are supported. Default value: `"25%"`.', example='25%'),
    interval?: string(name='Interval', description='The batch interval. The wait time between two rollouts. Supported units: `s` (seconds), `m` (minutes), and `h` (hours).', example='60s'),
  }(name='Batch', description='**Batch**  
* Type: object
* Required: no
* Description: The batch rollout configuration. Used to adjust batch policy parameters. Mutually exclusive with Partition.', position='Body'),
  partition?: {
    partition?: string(name='Partition', description='**Partition**  
* Type: string
* Required: yes
* Description: The partition value. Two formats are supported:
  1. Integer format: such as "5", which indicates that 5 old replicas are retained.
  2. Percentage format: such as "50%", which indicates that 50% of the old replicas are retained.
  Adjustment strategies:
  - Increase the value: Roll back to the old version and increase the proportion of old replicas.
  - Decrease the value: Proceed to the new version and decrease the proportion of old replicas.
  - Set to "0%": Complete the full update and switch all replicas to the new version.
* Example: 30%', example='30%'),
  }(name='Partition', description='**Partition**  
* Type: object
* Required: no
* Description: The partition rollout configuration. Used to adjust partition policy parameters. Mutually exclusive with Batch.', position='Body'),
  paused?: boolean(name='Paused', description='Specifies whether to pause the rollout. A value of `true` indicates that the rollout is paused. A value of `false` indicates that the rollout is resumed.', example='true', position='Body'),
}

model UpdateServiceRolloutResponseBody = {
  message?: string(name='Message', description='The returned message. Describes the request processing result. Valid values:
- "Rollout updated successfully": The rollout policy is updated.
