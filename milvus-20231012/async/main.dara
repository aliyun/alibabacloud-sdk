import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'milvus';
  @version = '2023-10-12';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ComponentCapacityConstraint {
  componentType?: string(name='componentType', description='The component type.'),
  maxCapacity?: int32(name='maxCapacity', description='The maximum capacity allowed for the component.'),
  minCapacity?: int32(name='minCapacity', description='The minimum capacity allowed for the component.'),
}

model DBVersionDetail {
  specs?: [ 
    {
      componentSpecs?: [ 
        {
          defaultReplicas?: int32(name='defaultReplicas', description='The default number of replicas for the component.'),
          maxReplicas?: int32(name='maxReplicas', description='The maximum number of replicas allowed for the component.'),
          minReplicas?: int32(name='minReplicas', description='The minimum number of replicas allowed for the component.'),
          name?: string(name='name', description='The name of the component.'),
          specs?: [ string ](name='specs', description='The list of specifications supported by the component.'),
          step?: int32(name='step', description='The step size for adjusting the number of replicas for the component.'),
          type?: string(name='type', description='The type of the component.'),
        }
      ](name='componentSpecs', description='The list of component specification configurations.'),
      isHA?: boolean(name='isHA', description='Specifies whether high-availability deployment is supported.'),
      isStandalone?: boolean(name='isStandalone', description='Specifies whether standalone deployment is supported.'),
      isStandalonePro?: boolean(name='isStandalonePro', description='Specifies whether Standalone Pro deployment is supported.'),
      zoneMode?: string(name='zoneMode', description='The zone deployment mode supported by the specification.'),
    }
  ](name='specs', description='The list of specifications supported by the database version.'),
  status?: string(name='status', description='The status of the database version.'),
  version?: string(name='version', description='The database version.'),
}

model DlfDatabase {
  databaseName?: string(name='databaseName', description='The database name.', example='my_database'),
  description?: string(name='description', description='The database description.', example='Test database'),
  tableCount?: int32(name='tableCount', description='The number of tables.', example='10'),
}

model DlfFieldSchema {
  comment?: string(name='comment', description='The field comment.', example='Primary key field'),
  dimension?: int32(name='dimension', description='The vector dimensions.', example='128'),
  dlfFieldType?: string(name='dlfFieldType', description='The DLF field type.', example='BIGINT'),
  fieldName?: string(name='fieldName', description='The field name.', example='id'),
  isPrimaryKey?: boolean(name='isPrimaryKey', description='Indicates whether the field is a primary key.', example='true'),
  isSupported?: boolean(name='isSupported', description='Indicates whether mapping is supported.', example='true'),
  isVectorField?: boolean(name='isVectorField', description='Indicates whether the field is a vector field.', example='false'),
  milvusFieldType?: string(name='milvusFieldType', description='The Milvus field type.', example='Int64'),
  nullable?: boolean(name='nullable', description='Indicates whether the field can be null.', example='true'),
  unsupportedReason?: string(name='unsupportedReason', description='The reason mapping is not supported.', example='Unsupported type'),
}

model DlfInstance {
  instanceId?: string(name='instanceId', description='The DLF instance ID.', example='dlf-cn-xxx'),
  instanceName?: string(name='instanceName', description='The DLF instance name.', example='my-dlf-instance'),
  instanceType?: string(name='instanceType', description='The instance type.', example='DLF_2_0'),
  regionId?: string(name='regionId', description='The region ID.', example='cn-hangzhou'),
  status?: string(name='status', description='The instance status.', example='RUNNING'),
}

model DlfTable {
  description?: string(name='description', description='The table description.', example='Test table'),
  location?: string(name='location', description='The table storage location.', example='oss://bucket/path'),
  tableFormat?: string(name='tableFormat', description='The table format.', example='PAIMON'),
  tableName?: string(name='tableName', description='The table name.', example='my_table'),
  tableType?: string(name='tableType', description='The table type.', example='MANAGED'),
}

model InstanceDetail {
  autoBackup?: boolean(name='autoBackup', description='The automatic backup.', example='true'),
  components?: [ 
    {
      cuNum?: int32(name='cuNum', description='The number of CUs.', example='4'),
      cuType?: string(name='cuType', description='The CU type.', example='general'),
      dataDisk?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable the data cloud disk for the query node.'),
        performanceLevel?: string(name='performanceLevel', description='The performance level of the ESSD.'),
        size?: int32(name='size', description='The capacity of the data cloud disk, in GiB.'),
        storageClass?: string(name='storageClass', description='The storage class of the data cloud disk.'),
      }(name='dataDisk', description='The query node data cloud disk configuration.'),
      diskSizeType?: string(name='diskSizeType', description='The disk size type of the query node. The value is Large for storage-optimized configurations, and Normal for other configurations.', example='Normal'),
      payType?: string(name='payType', description='The billing method of the component.'),
      podsList?: [ 
        {
          podId?: string(name='podId', description='The Pod ID.'),
          podName?: string(name='podName', description='The pod name.'),
        }
      ](name='podsList', description='The pod list of the component.'),
      replica?: int32(name='replica', description='The number of replicas.', example='1'),
      type?: string(name='type', description='The component type.', example='data'),
    }
  ](name='components', description='The component information.'),
  configuration?: string(name='configuration', description='The configuration.', example='rootCoord:
    maxDatabaseNum: 64 # Maximum number of database
    maxPartitionNum: 4096'),
  createTime?: string(name='createTime', description='The creation time.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2025-04-27T02:04:25Z'),
  dbVersion?: string(name='dbVersion', description='The instance version.', example='2.5'),
  encrypted?: boolean(name='encrypted', description='Specifies whether data encryption is enabled.', example='false'),
  expireTime?: string(name='expireTime', description='The expiration time.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2025-04-27T02:04:25Z'),
  ha?: boolean(name='ha', description='Specifies whether high availability is enabled.', example='true'),
  instanceId?: string(name='instanceId', description='The instance ID.', example='c-xxx'),
  instanceName?: string(name='instanceName', description='The instance name.', example='milvus-test'),
  kmsKeyId?: string(name='kmsKeyId', description='The KMS key ID.', example='key-xxx'),
  multiZoneMode?: string(name='multiZoneMode', description='The multi-zone mode.', example='Single'),
  orderId?: string(name='orderId', description='The order ID.', example='4751'),
  paymentType?: string(name='paymentType', description='The billing method. Valid values:
- PayAsYouGo: pay-as-you-go billing method.
- Subscription: subscription.', example='PayAsYouGo'),
  regionId?: string(name='regionId', description='The region ID.', example='cn-beijing'),
  resourceGroupId?: string(name='resourceGroupId', description='The resource group ID.', example='rg-aek3dcgyq7pnqwa'),
  runningTime?: long(name='runningTime', description='The running time.', example='1'),
  securityGroupIds?: [ string ](name='securityGroupIds', description='The security group IDs.'),
  status?: string(name='status', description='The instance status. Valid values:
- creating: The instance is being created.
- running: The instance is running.
- updating: The instance is being upgraded, such as cluster scaling, configuration changes, and enabling or disabling public network access.
- disable: The instance is unavailable. The cluster has expired and must be renewed for activation.
- deleting: The instance is being deleted.
- deleted: The instance is deleted.', example='running'),
  tags?: [ 
    {
      key?: string(name='key', description='The tag key.', example='k1'),
      value?: string(name='value', description='The tag value.', example='v1'),
    }
  ](name='tags', description='The tags.'),
  vSwitchIds?: [ 
    {
      vswId?: string(name='vswId', description='The vSwitch IDs.', example='vsw-xxx'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='vSwitchIds', description='The vSwitch IDs.'),
  vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-xxx'),
  zoneId?: string(name='zoneId', description='The zone ID of the instance.', example='cn-hangzhou-i'),
}

model MigrationSource {
  authInfo?: {
    authType?: string(name='authType', description='The authentication type.'),
    password?: string(name='password', description='The password used for authentication.'),
    token?: string(name='token', description='The token used for authentication.'),
    username?: string(name='username', description='The username used for authentication.'),
  }(name='authInfo', description='The authentication information of the migration source.'),
  database?: string(name='database', description='The name of the database to be migrated.'),
  endpoint?: {
    endpoint?: string(name='endpoint', description='The endpoint of the migration source.'),
    port?: string(name='port', description='The port number of the migration source.'),
  }(name='endpoint', description='The endpoint information of the migration source.'),
}

model PriceInfo {
  currency?: string(name='currency', description='The pricing currency.'),
  discountAmount?: string(name='discountAmount', description='The discount amount.'),
  optionalPromotions?: [
    PromotionInfo
  ](name='optionalPromotions', description='The list of optional promotions.'),
  originalAmount?: string(name='originalAmount', description='The original amount.'),
  priceModules?: [ 
    {
      originalAmount?: string(name='originalAmount', description='The original amount of the module.'),
      type?: string(name='type', description='The type of the pricing module.'),
    }
  ](name='priceModules', description='The pricing details by module.'),
  rules?: [ 
    {
      amount?: string(name='amount', description='The discount amount of the rule.'),
      name?: string(name='name', description='The name of the discount rule.'),
      ruleId?: string(name='ruleId', description='The ID of the discount rule.'),
    }
  ](name='rules', description='The list of discount rules.'),
  taxAmount?: string(name='taxAmount', description='The tax amount.'),
  tradeAmount?: string(name='tradeAmount', description='The final transaction amount.'),
}

model PromotionInfo {
  canPromFee?: string(name='canPromFee', description='The available discount amount.'),
  isSelected?: boolean(name='isSelected', description='Specifies whether the promotion is selected.'),
  promotionDesc?: string(name='promotionDesc', description='The promotion description.'),
  promotionName?: string(name='promotionName', description='The promotion name.'),
  promotionOptionCode?: string(name='promotionOptionCode', description='The promotion option code.'),
  promotionOptionNo?: string(name='promotionOptionNo', description='The promotion option number.'),
  selected?: boolean(name='selected', description='Indicates whether the promotion is selected.'),
}

model RamAccount {
  bindable?: boolean(name='bindable', description='Indicates whether the RAM user can be bound.', example='true'),
  displayName?: string(name='displayName', description='The display name.', example='Test User'),
  uid?: string(name='uid', description='The Alibaba Cloud UID.', example='1234567890123456'),
  userName?: string(name='userName', description='The RAM username.', example='test-user'),
}

model RamBindingEntry {
  boundUid?: string(name='boundUid', description='The bound Alibaba Cloud UID.', example='1234567890123456'),
  boundUserName?: string(name='boundUserName', description='The name of the bound RAM user.', example='test-user'),
  milvusUsername?: string(name='milvusUsername', description='The Milvus database username.', example='root'),
}

model ScalingActivity {
  componentTypes?: string(name='componentTypes', description='The types of components involved in the auto scaling activity.'),
  description?: string(name='description', description='The detailed description of the auto scaling activity, which can be used to identify the cause when the activity fails.'),
  endTime?: string(name='endTime', description='The end time of the auto scaling activity.'),
  instanceId?: string(name='instanceId', description='The ID of the Milvus instance.'),
  policyType?: string(name='policyType', description='The type of the elastic scaling policy.'),
  scalingActivityId?: string(name='scalingActivityId', description='The ID of the elastic scaling activity.'),
  scalingActivityState?: string(name='scalingActivityState', description='The execution status of the auto scaling activity.'),
  scalingPolicyId?: string(name='scalingPolicyId', description='The ID of the elastic scaling policy.'),
  scalingRuleDetail?: string(name='scalingRuleDetail', description='The details of the elastic scaling rule.'),
  scalingRuleId?: string(name='scalingRuleId', description='The ID of the elastic scaling rule.'),
  scalingRuleName?: string(name='scalingRuleName', description='The name of the rule that triggered the auto scaling activity.'),
  startTime?: string(name='startTime', description='The start time of the auto scaling activity.'),
  timeZone?: string(name='timeZone', description='The time zone used by the elastic scaling rule.'),
}

model ScalingRule {
  adjustInfos?: [ 
    {
      componentType?: string(name='componentType', description='index  query data proxy streaming mix_coordinator'),
      targetValue?: string(name='targetValue', description='The target number of nodes for the component after the rule is executed.', example='2'),
    }
  ](name='adjustInfos', description='The list of target resource configurations for each component.'),
  cronStr?: string(name='cronStr', description='The scheduled execution expression of the rule.'),
  disabled?: boolean(name='disabled', description='Indicates whether the rule is disabled.'),
  endTime?: long(name='endTime', description='The end time of the effective period for the rule.'),
  ruleId?: string(name='ruleId', description='The ID of the elastic scaling rule.'),
  scalingRuleName?: string(name='scalingRuleName', description='The name of the elastic scaling rule.'),
  startTime?: long(name='startTime', description='The start time of the effective period for the rule.'),
  timeZone?: string(name='timeZone', description='The time zone used for the execution time of the rule.', example='Asia/Shanghai'),
}

model OpenStructDlfSnapshotDto {
  changelogRecordCount?: long(name='changelogRecordCount', example='500'),
  commitKind?: string(name='commitKind', example='APPEND'),
  deltaRecordCount?: long(name='deltaRecordCount', example='1000'),
  schemaId?: long(name='schemaId', example='1'),
  snapshotId?: long(name='snapshotId', example='123456789'),
  timeMillis?: long(name='timeMillis', example='1711334400000'),
  totalRecordCount?: long(name='totalRecordCount', example='100000'),
}

model OpenStructDlfTagDto {
  snapshotId?: long(name='snapshotId', example='123456789'),
  tagName?: string(name='tagName', example='milvus-auto-20260101'),
  timeMillis?: long(name='timeMillis', example='1711334400000'),
  totalRecordCount?: long(name='totalRecordCount', example='100000'),
}

