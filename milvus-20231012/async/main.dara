import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'milvus';
  @version = '2023-10-12';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ComponentCapacityConstraint {
  componentType?: string(name='componentType'),
  maxCapacity?: int32(name='maxCapacity'),
  minCapacity?: int32(name='minCapacity'),
}

model DBVersionDetail {
  specs?: [ 
    {
      componentSpecs?: [ 
        {
          defaultReplicas?: int32(name='defaultReplicas', description='The default number of replicas for the component.'),
          maxReplicas?: int32(name='maxReplicas', description='The maximum number of replicas for the component.'),
          minReplicas?: int32(name='minReplicas', description='The minimum number of replicas for the component.'),
          name?: string(name='name', description='The name of the component.'),
          specs?: [ string ](name='specs', description='The available specifications for the component.'),
          step?: int32(name='step', description='The step size for scaling the number of replicas.'),
          type?: string(name='type', description='The type of the component.'),
        }
      ](name='componentSpecs', description='The component specifications.'),
      isHA?: boolean(name='isHA', description='Indicates whether the high availability (HA) edition is supported.'),
      isStandalone?: boolean(name='isStandalone', description='Indicates whether the Standalone edition is supported.'),
      isStandalonePro?: boolean(name='isStandalonePro', description='Indicates whether the Standalone Pro edition is supported.'),
      zoneMode?: string(name='zoneMode', description='The zone mode of the specification.'),
    }
  ](name='specs', description='The specifications supported by the version.'),
  status?: string(name='status', description='The status of the version.'),
  version?: string(name='version', description='The version number.'),
}

model DlfDatabase {
  databaseName?: string(name='databaseName', description='The name of the database.', example='my_database'),
  description?: string(name='description', description='The description of the database.', example='Test database'),
  tableCount?: int32(name='tableCount', description='The number of tables in the database. Read-only.', example='10'),
}

model DlfFieldSchema {
  comment?: string(name='comment', description='A comment for the field.', example='Primary key field'),
  dimension?: int32(name='dimension', description='The dimension of the vector field. This parameter applies only when `isVectorField` is `true`.', example='128'),
  dlfFieldType?: string(name='dlfFieldType', description='The DLF field type.', example='BIGINT'),
  fieldName?: string(name='fieldName', description='The field name.', example='id'),
  isPrimaryKey?: boolean(name='isPrimaryKey', description='Indicates whether the field is a primary key.', example='true'),
  isSupported?: boolean(name='isSupported', description='Indicates whether the DLF field type can be mapped to a Milvus field type.', example='true'),
  isVectorField?: boolean(name='isVectorField', description='Indicates whether the field is a vector field.', example='false'),
  milvusFieldType?: string(name='milvusFieldType', description='The corresponding Milvus field type.', example='Int64'),
  nullable?: boolean(name='nullable', description='Indicates whether the field can be null.', example='true'),
  unsupportedReason?: string(name='unsupportedReason', description='The reason the DLF field type is unsupported. This field is present only when `isSupported` is `false`.', example='Unsupported type'),
}

model DlfInstance {
  instanceId?: string(name='instanceId', description='The unique ID of the DLF instance.', example='dlf-cn-xxx'),
  instanceName?: string(name='instanceName', description='The name of the DLF instance.', example='my-dlf-instance'),
  instanceType?: string(name='instanceType', description='The type of the DLF instance.', example='DLF_2_0'),
  regionId?: string(name='regionId', description='The ID of the region where the DLF instance is located.', example='cn-hangzhou'),
  status?: string(name='status', description='The current status of the DLF instance.', example='RUNNING'),
}

model DlfTable {
  description?: string(name='description', description='A description of the table.', example='Test table'),
  location?: string(name='location', description='The location of the table data, specified as an Object Storage Service (OSS) URI.', example='oss://bucket/path'),
  tableFormat?: string(name='tableFormat', description='The table format, such as `PAIMON`.', example='PAIMON'),
  tableName?: string(name='tableName', description='The table name.', example='my_table'),
  tableType?: string(name='tableType', description='The table type. For example, `MANAGED` indicates that DLF manages the data and metadata lifecycle.', example='MANAGED'),
}

model InstanceDetail {
  autoBackup?: boolean(name='autoBackup', description='The automatic backup configuration.', example='true'),
  components?: [ 
    {
      cuNum?: int32(name='cuNum', description='The number of CUs.', example='4'),
      cuType?: string(name='cuType', description='The CU type.', example='general'),
      dataDisk?: {
        enabled?: boolean(name='enabled'),
        performanceLevel?: string(name='performanceLevel'),
        size?: int32(name='size'),
        storageClass?: string(name='storageClass'),
      }(name='dataDisk'),
      diskSizeType?: string(name='diskSizeType', description='The disk size type for the Query Node. Set this parameter to Large for storage-optimized configurations, and to Normal for other configurations.', example='Normal'),
      payType?: string(name='payType'),
      podsList?: [ 
        {
          podId?: string(name='podId'),
          podName?: string(name='podName'),
        }
      ](name='podsList'),
      replica?: int32(name='replica', description='The number of replicas.', example='1'),
      type?: string(name='type', description='The component type.', example='data'),
    }
  ](name='components', description='The component information.'),
  configuration?: string(name='configuration', description='The configuration.', example='rootCoord:
    maxDatabaseNum: 64 # Maximum number of database
    maxPartitionNum: 4096'),
  createTime?: string(name='createTime', description='The creation time.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2025-04-27T02:04:25Z'),
  dbVersion?: string(name='dbVersion', description='The instance version.', example='2.5'),
  encrypted?: boolean(name='encrypted', description='Indicates whether data encryption is enabled.', example='false'),
  expireTime?: string(name='expireTime', description='The expiration time.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2025-04-27T02:04:25Z'),
  ha?: boolean(name='ha', description='Indicates whether high availability is enabled.', example='true'),
  instanceId?: string(name='instanceId', description='The instance ID.', example='c-xxx'),
  instanceName?: string(name='instanceName', description='The instance name.', example='milvus-test'),
  kmsKeyId?: string(name='kmsKeyId', description='kms key Id。', example='key-xxx'),
  multiZoneMode?: string(name='multiZoneMode', description='The multi-zone deployment mode.', example='Single'),
  orderId?: string(name='orderId', description='The order ID.', example='4751'),
  paymentType?: string(name='paymentType', description='The billing method. Valid values: PayAsYouGo: pay-as-you-go billing method. Subscription: subscription.', example='PayAsYouGo'),
  regionId?: string(name='regionId', description='The region ID.', example='cn-beijing'),
  resourceGroupId?: string(name='resourceGroupId', description='The resource group ID.', example='rg-aek3dcgyq7pnqwa'),
  runningTime?: long(name='runningTime', description='The running time.', example='1'),
  securityGroupIds?: [ string ](name='securityGroupIds', description='The security group IDs.'),
  status?: string(name='status', description='The instance status. Valid values:

- creating: Being created.
- running: Running.
- updating: Being upgraded. This includes specification changes, configuration changes, and public network access changes.
- disable: Unavailable. The cluster has expired and requires renewal to reactivate.
- deleting: Being deleted.
- deleted: Deleted.', example='running'),
  tags?: [ 
    {
      key?: string(name='key', description='The tag key.', example='k1'),
      value?: string(name='value', description='The tag value.', example='v1'),
    }
  ](name='tags', description='The tags.'),
  vSwitchIds?: [ 
    {
      vswId?: string(name='vswId', description='The vSwitch IDs.', example='vsw-xxx'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='vSwitchIds', description='The vSwitch IDs.'),
  vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-xxx'),
  zoneId?: string(name='zoneId', description='The zone ID of the instance.', example='cn-hangzhou-i'),
}

model MigrationSource {
  authInfo?: {
    authType?: string(name='authType', description='The authentication type.'),
    password?: string(name='password', description='The password used for authentication.'),
    token?: string(name='token', description='The token used for authentication.'),
    username?: string(name='username', description='The username used for authentication.'),
  }(name='authInfo', description='The authentication information of the migration source.'),
  database?: string(name='database', description='The name of the database to migrate.'),
  endpoint?: {
    endpoint?: string(name='endpoint', description='The endpoint address of the migration source.'),
    port?: string(name='port', description='The port number of the migration source.'),
  }(name='endpoint', description='The endpoint information of the migration source.'),
}

model PriceInfo {
  currency?: string(name='currency', description='The currency of the price.'),
  discountAmount?: string(name='discountAmount', description='The discount amount.'),
  optionalPromotions?: [
    PromotionInfo
  ](name='optionalPromotions', description='The optional promotions.'),
  originalAmount?: string(name='originalAmount', description='The original price.'),
  priceModules?: [ 
    {
      originalAmount?: string(name='originalAmount', description='The original amount of the price module.'),
      type?: string(name='type', description='The type of the price module.'),
    }
  ](name='priceModules', description='The price modules.'),
  rules?: [ 
    {
      amount?: string(name='amount', description='The amount associated with the pricing rule.'),
      name?: string(name='name', description='The name of the pricing rule.'),
      ruleId?: string(name='ruleId', description='The ID of the pricing rule.'),
    }
  ](name='rules', description='The pricing rules.'),
  taxAmount?: string(name='taxAmount', description='The tax amount.'),
  tradeAmount?: string(name='tradeAmount', description='The actual trade price.'),
}

model PromotionInfo {
  canPromFee?: string(name='canPromFee', description='The fee that can be covered by the promotion.'),
  isSelected?: boolean(name='isSelected', description='Indicates whether the promotion is selected.'),
  promotionDesc?: string(name='promotionDesc', description='The description of the promotion.'),
  promotionName?: string(name='promotionName', description='The name of the promotion.'),
  promotionOptionCode?: string(name='promotionOptionCode', description='The code of the promotion option.'),
  promotionOptionNo?: string(name='promotionOptionNo', description='The number of the promotion option.'),
  selected?: boolean(name='selected', description='Indicates whether the promotion is selected.'),
}

model RamAccount {
  bindable?: boolean(name='bindable', description='Specifies whether the RamAccount can be bound to other resources.', example='true'),
  displayName?: string(name='displayName', description='The display name for the RamAccount, which appears in the console.', example='Test User'),
  uid?: string(name='uid', description='The unique identifier for the RamAccount.', example='1234567890123456'),
  userName?: string(name='userName', description='The user name for the RamAccount.', example='test-user'),
}

model RamBindingEntry {
  boundUid?: string(name='boundUid', description='The unique identifier (UID) of the bound RAM user.', example='1234567890123456'),
  boundUserName?: string(name='boundUserName', description='The bound RAM username.', example='test-user'),
  milvusUsername?: string(name='milvusUsername', description='The Milvus username.', example='root'),
}

model ScalingActivity {
  componentTypes?: string(name='componentTypes', description='The types of components involved in the scaling activity.'),
  description?: string(name='description', description='The description of the scaling activity.'),
  endTime?: string(name='endTime', description='The end time of the scaling activity.'),
  instanceId?: string(name='instanceId', description='The ID of the instance.'),
  policyType?: string(name='policyType', description='The type of the scaling policy.'),
  scalingActivityId?: string(name='scalingActivityId', description='The ID of the scaling activity.'),
  scalingActivityState?: string(name='scalingActivityState', description='The state of the scaling activity.'),
  scalingPolicyId?: string(name='scalingPolicyId', description='The ID of the scaling policy.'),
  scalingRuleDetail?: string(name='scalingRuleDetail', description='The details of the scaling rule.'),
  scalingRuleId?: string(name='scalingRuleId', description='The ID of the scaling rule.'),
  scalingRuleName?: string(name='scalingRuleName', description='The name of the scaling rule that triggered the activity.'),
  startTime?: string(name='startTime', description='The start time of the scaling activity.'),
  timeZone?: string(name='timeZone', description='The time zone of the scaling activity.'),
}

model ScalingRule {
  adjustInfos?: [ 
    {
      componentType?: string(name='componentType', description='The type of the component to be adjusted.'),
      targetValue?: string(name='targetValue', description='The target value for the adjustment.'),
    }
  ](name='adjustInfos', description='The adjustment information of the scaling rule.'),
  cronStr?: string(name='cronStr', description='The cron expression for the scaling schedule.'),
  disabled?: boolean(name='disabled', description='Indicates whether the scaling rule is disabled.'),
  endTime?: long(name='endTime', description='The end time of the scaling rule. Unit: milliseconds.'),
  ruleId?: string(name='ruleId', description='The ID of the scaling rule.'),
  scalingRuleName?: string(name='scalingRuleName', description='The name of the scaling rule.'),
  startTime?: long(name='startTime', description='The start time of the scaling rule. Unit: milliseconds.'),
  timeZone?: string(name='timeZone', description='The time zone of the scaling rule.'),
}

model OpenStructDlfSnapshotDto {
  changelogRecordCount?: long(name='changelogRecordCount', example='500'),
  commitKind?: string(name='commitKind', example='APPEND'),
  deltaRecordCount?: long(name='deltaRecordCount', example='1000'),
  schemaId?: long(name='schemaId', example='1'),
  snapshotId?: long(name='snapshotId', example='123456789'),
  timeMillis?: long(name='timeMillis', example='1711334400000'),
  totalRecordCount?: long(name='totalRecordCount', example='100000'),
}

model OpenStructDlfTagDto {
  snapshotId?: long(name='snapshotId', example='123456789'),
  tagName?: string(name='tagName', example='milvus-auto-20260101'),
  timeMillis?: long(name='timeMillis', example='1711334400000'),
  totalRecordCount?: long(name='totalRecordCount', example='100000'),
}

model ChangeResourceGroupRequest {
