model CreateInstanceRequest {
  regionId?: string(name='RegionId', description='The region ID.', example='cn-beijing', position='Query'),
  aiFunction?: boolean(name='aiFunction', description='Specifies whether to enable AI function.', position='Body'),
  autoBackup?: boolean(name='autoBackup', description='Specifies whether to enable automatic backup.', example='true', position='Body'),
  autoPay?: boolean(name='autoPay', description='Specifies whether to enable automatic payment. Default value: true. Valid values:
- true: Automatic payment is enabled.
- false: Only an order is generated. No payment is made.', example='true', position='Body'),
  autoRenew?: boolean(name='autoRenew', description='Specifies whether to enable auto-renewal. This parameter takes effect only when the billing method of the instance is Subscription.', example='true', position='Body'),
  backupRestoreInfo?: {
    backupId?: string(name='backupId', description='The backup ID.', example='bt-xxxxx'),
    backupName?: string(name='backupName', description='The backup name.', example='Backup1'),
    sourceClusterId?: string(name='sourceClusterId', description='The ID of the source cluster for the backup.', example='c-xxxxxxx'),
  }(name='backupRestoreInfo', description='The backup and restoration information.', position='Body'),
  components?: [ 
    {
      cuNum: int32(name='cuNum', description='The number of compute units (CUs).

This parameter is required.', example='8'),
      cuType?: string(name='cuType', description='The CU type.', example='general'),
      dataDisk?: {
        enabled?: boolean(name='enabled', description='Specifies whether to enable the QueryNode data cloud disk.', example='true'),
        performanceLevel?: string(name='performanceLevel', description='The ESSD performance level (PL). Valid values: PL0, PL1, PL2, and PL3. If StorageClass is not specified, this parameter is used for parsing.', example='PL1'),
        size?: int32(name='size', description='The data cloud disk capacity. Unit: GiB.', example='100'),
        storageClass?: string(name='storageClass', description='The StorageClass of the data cloud disk. Valid values: alicloud-disk-essd-pl0, alicloud-disk-essd-pl1, alicloud-disk-essd-pl2, and alicloud-disk-essd-pl3.', example='alicloud-disk-essd-pl1'),
      }(name='dataDisk', description='The QueryNode data cloud disk configuration. This parameter is supported only when type is set to query.'),
      diskSizeType?: string(name='diskSizeType', description='The disk size type for the Query Node. Set this parameter to Large for storage-optimized instances, and to Normal for compute-optimized and other instance types.', example='Normal'),
      replica: int32(name='replica', description='The number of replicas.

This parameter is required.', example='1'),
      type: string(name='type', description='The component type.

This parameter is required.', example='standalone'),
    }
  ](name='components', description='The component information.', position='Body'),
  configuration?: string(name='configuration', description='The configuration items.', example='rootCoord:
    maxDatabaseNum: 64 # Maximum number of database
    maxPartitionNum: 4096', position='Body'),
  dbAdminPassword?: string(name='dbAdminPassword', description='The database password.', example='test12', position='Body'),
  dbVersion: string(name='dbVersion', description='The Milvus version.

This parameter is required.', example='2.4', position='Body'),
  encrypted?: boolean(name='encrypted', description='Specifies whether to enable OSS encryption.', example='false', position='Body'),
  ha?: boolean(name='ha', description='Specifies whether to enable high availability (HA).', example='true', position='Body'),
  instanceName?: string(name='instanceName', description='The instance name.', example='milvus-test', position='Body'),
  isMultiAzStorage?: boolean(name='isMultiAzStorage', description='Specifies whether to enable multi-zone storage.', position='Body'),
  kmsKeyId?: string(name='kmsKeyId', description='The ID of the KMS key used for encryption.', example='key-xxx', position='Body'),
  loadReplicas?: int32(name='loadReplicas', description='The number of load replicas.', example='2', position='Body'),
  multiZoneMode?: string(name='multiZoneMode', description='The zone configuration.', example='Single', position='Body'),
  nodeType?: string(name='nodeType', description='The node type. Valid values for Milvus standalone: perf, enhanced, and cap. Default value: perf.', example='perf', position='Body'),
  paymentDuration?: int32(name='paymentDuration', description='The payment duration.', example='1', position='Body'),
  paymentDurationUnit?: string(name='paymentDurationUnit', description='The unit of the payment duration.', example='month', position='Body'),
  paymentType: string(name='paymentType', description='The payment type.

This parameter is required.', example='PayAsYouGo', position='Body'),
