  ](name='vSwitchIds', description='The vSwitches.', example='["vsw-123xxx"]', position='Body'),
  vpcId: string(name='vpcId', description='The VPC ID.

This parameter is required.', example='vpc-123xxx', position='Body'),
  zoneId: string(name='zoneId', description='The primary zone.

This parameter is required.', example='cn-beijing-g', position='Body'),
