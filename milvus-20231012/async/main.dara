This parameter is required.', example='rg-acfnsjj5tgai4wi', position='Query'),
  regionId?: string(name='RegionId', description='The region ID.', example='cn-beijing', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-123xxx', position='Query'),
  resourceId?: string(name='ResourceId', description='The resource ID.', example='c-xxx', position='Query'),
  resourceType?: string(name='ResourceType', description='The resource type.', example='instance', position='Query'),
}

