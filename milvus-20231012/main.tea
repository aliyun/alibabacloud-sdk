/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'eu-central-1' = 'milvus.eu-central-1.aliyuncs.com',
    'cn-zhangjiakou' = 'milvus.cn-zhangjiakou.aliyuncs.com',
    'cn-wulanchabu' = 'milvus.cn-wulanchabu.aliyuncs.com',
    'cn-shenzhen' = 'milvus.cn-shenzhen.aliyuncs.com',
    'cn-shanghai' = 'milvus.cn-shanghai.aliyuncs.com',
    'cn-hongkong' = 'milvus.cn-hongkong.aliyuncs.com',
    'cn-hangzhou' = 'milvus.cn-hangzhou.aliyuncs.com',
    'cn-beijing' = 'milvus.cn-beijing.aliyuncs.com',
    'ap-southeast-1' = 'milvus.ap-southeast-1.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('milvus', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ComponentCapacityConstraint {
  componentType?: string(name='componentType'),
  maxCapacity?: int32(name='maxCapacity'),
  minCapacity?: int32(name='minCapacity'),
}

model DBVersionDetail {
  specs?: [ 
    {
      componentSpecs?: [ 
        {
          defaultReplicas?: int32(name='defaultReplicas', description='The default number of replicas for the component.'),
          maxReplicas?: int32(name='maxReplicas', description='The maximum number of replicas for the component.'),
          minReplicas?: int32(name='minReplicas', description='The minimum number of replicas for the component.'),
          name?: string(name='name', description='The name of the component.'),
          specs?: [ string ](name='specs', description='The available specifications for the component.'),
          step?: int32(name='step', description='The step size for scaling the number of replicas.'),
          type?: string(name='type', description='The type of the component.'),
        }
      ](name='componentSpecs', description='The component specifications.'),
      isHA?: boolean(name='isHA', description='Indicates whether the high availability (HA) edition is supported.'),
      isStandalone?: boolean(name='isStandalone', description='Indicates whether the Standalone edition is supported.'),
      isStandalonePro?: boolean(name='isStandalonePro', description='Indicates whether the Standalone Pro edition is supported.'),
      zoneMode?: string(name='zoneMode', description='The zone mode of the specification.'),
    }
  ](name='specs', description='The specifications supported by the version.'),
  status?: string(name='status', description='The status of the version.'),
  version?: string(name='version', description='The version number.'),
}

model DlfDatabase {
  databaseName?: string(name='databaseName', description='The name of the database.', example='my_database'),
  description?: string(name='description', description='The description of the database.', example='Test database'),
  tableCount?: int32(name='tableCount', description='The number of tables in the database. Read-only.', example='10'),
}

model DlfFieldSchema {
  comment?: string(name='comment', description='A comment for the field.', example='Primary key field'),
  dimension?: int32(name='dimension', description='The dimension of the vector field. This parameter applies only when `isVectorField` is `true`.', example='128'),
  dlfFieldType?: string(name='dlfFieldType', description='The DLF field type.', example='BIGINT'),
  fieldName?: string(name='fieldName', description='The field name.', example='id'),
  isPrimaryKey?: boolean(name='isPrimaryKey', description='Indicates whether the field is a primary key.', example='true'),
  isSupported?: boolean(name='isSupported', description='Indicates whether the DLF field type can be mapped to a Milvus field type.', example='true'),
  isVectorField?: boolean(name='isVectorField', description='Indicates whether the field is a vector field.', example='false'),
  milvusFieldType?: string(name='milvusFieldType', description='The corresponding Milvus field type.', example='Int64'),
  nullable?: boolean(name='nullable', description='Indicates whether the field can be null.', example='true'),
  unsupportedReason?: string(name='unsupportedReason', description='The reason the DLF field type is unsupported. This field is present only when `isSupported` is `false`.', example='Unsupported type'),
}

model DlfInstance {
  instanceId?: string(name='instanceId', description='The unique ID of the DLF instance.', example='dlf-cn-xxx'),
  instanceName?: string(name='instanceName', description='The name of the DLF instance.', example='my-dlf-instance'),
  instanceType?: string(name='instanceType', description='The type of the DLF instance.', example='DLF_2_0'),
  regionId?: string(name='regionId', description='The ID of the region where the DLF instance is located.', example='cn-hangzhou'),
  status?: string(name='status', description='The current status of the DLF instance.', example='RUNNING'),
}

model DlfTable {
  description?: string(name='description', description='A description of the table.', example='Test table'),
  location?: string(name='location', description='The location of the table data, specified as an Object Storage Service (OSS) URI.', example='oss://bucket/path'),
