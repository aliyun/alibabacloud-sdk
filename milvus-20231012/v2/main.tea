        enabled?: boolean(name='enabled', description='Specifies whether to enable the data cloud disk for the query node.'),
        performanceLevel?: string(name='performanceLevel', description='The performance level of the ESSD.'),
        size?: int32(name='size', description='The capacity of the data cloud disk, in GiB.'),
        storageClass?: string(name='storageClass', description='The storage class of the data cloud disk.'),
      }(name='dataDisk', description='The query node data cloud disk configuration.'),
      diskSizeType?: string(name='diskSizeType', description='The disk size type of the query node. The value is Large for storage-optimized configurations, and Normal for other configurations.', example='Normal'),
