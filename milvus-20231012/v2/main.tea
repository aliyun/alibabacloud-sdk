  paymentType?: string(name='paymentType', description='The billing method. Valid values:
- PayAsYouGo: pay-as-you-go billing method.
- Subscription: subscription.', example='PayAsYouGo'),
  regionId?: string(name='regionId', description='The region ID.', example='cn-beijing'),
  resourceGroupId?: string(name='resourceGroupId', description='The resource group ID.', example='rg-aek3dcgyq7pnqwa'),
  runningTime?: long(name='runningTime', description='The running time.', example='1'),
