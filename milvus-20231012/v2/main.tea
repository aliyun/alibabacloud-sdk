/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('milvus', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ComponentCapacityConstraint {
  componentType?: string(name='componentType', description='The component type.'),
  maxCapacity?: int32(name='maxCapacity', description='The maximum capacity allowed for the component.'),
  minCapacity?: int32(name='minCapacity', description='The minimum capacity allowed for the component.'),
}

model DBVersionDetail {
  specs?: [ 
    {
      componentSpecs?: [ 
        {
          defaultReplicas?: int32(name='defaultReplicas', description='The default number of replicas for the component.'),
          maxReplicas?: int32(name='maxReplicas', description='The maximum number of replicas allowed for the component.'),
          minReplicas?: int32(name='minReplicas', description='The minimum number of replicas allowed for the component.'),
          name?: string(name='name', description='The name of the component.'),
          specs?: [ string ](name='specs', description='The list of specifications supported by the component.'),
          step?: int32(name='step', description='The step size for adjusting the number of replicas for the component.'),
          type?: string(name='type', description='The type of the component.'),
        }
      ](name='componentSpecs', description='The list of component specification configurations.'),
      isHA?: boolean(name='isHA', description='Specifies whether high-availability deployment is supported.'),
      isStandalone?: boolean(name='isStandalone', description='Specifies whether standalone deployment is supported.'),
      isStandalonePro?: boolean(name='isStandalonePro', description='Specifies whether Standalone Pro deployment is supported.'),
      zoneMode?: string(name='zoneMode', description='The zone deployment mode supported by the specification.'),
    }
  ](name='specs', description='The list of specifications supported by the database version.'),
  status?: string(name='status', description='The status of the database version.'),
  version?: string(name='version', description='The database version.'),
}

model DlfDatabase {
  databaseName?: string(name='databaseName', description='The database name.', example='my_database'),
  description?: string(name='description', description='The database description.', example='Test database'),
  tableCount?: int32(name='tableCount', description='The number of tables.', example='10'),
}

model DlfFieldSchema {
  comment?: string(name='comment', description='The field comment.', example='Primary key field'),
  dimension?: int32(name='dimension', description='The vector dimensions.', example='128'),
  dlfFieldType?: string(name='dlfFieldType', description='The DLF field type.', example='BIGINT'),
  fieldName?: string(name='fieldName', description='The field name.', example='id'),
  isPrimaryKey?: boolean(name='isPrimaryKey', description='Indicates whether the field is a primary key.', example='true'),
  isSupported?: boolean(name='isSupported', description='Indicates whether mapping is supported.', example='true'),
  isVectorField?: boolean(name='isVectorField', description='Indicates whether the field is a vector field.', example='false'),
  milvusFieldType?: string(name='milvusFieldType', description='The Milvus field type.', example='Int64'),
  nullable?: boolean(name='nullable', description='Indicates whether the field can be null.', example='true'),
  unsupportedReason?: string(name='unsupportedReason', description='The reason mapping is not supported.', example='Unsupported type'),
}

model DlfInstance {
  instanceId?: string(name='instanceId', description='The DLF instance ID.', example='dlf-cn-xxx'),
  instanceName?: string(name='instanceName', description='The DLF instance name.', example='my-dlf-instance'),
