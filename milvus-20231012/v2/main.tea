  configuration?: string(name='configuration', description='The configuration.', example='rootCoord:
    maxDatabaseNum: 64 # Maximum number of database
    maxPartitionNum: 4096'),
  createTime?: string(name='createTime', description='The creation time.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2025-04-27T02:04:25Z'),
  dbVersion?: string(name='dbVersion', description='The instance version.', example='2.5'),
  encrypted?: boolean(name='encrypted', description='Specifies whether data encryption is enabled.', example='false'),
  expireTime?: string(name='expireTime', description='The expiration time.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2025-04-27T02:04:25Z'),
  ha?: boolean(name='ha', description='Specifies whether high availability is enabled.', example='true'),
  instanceId?: string(name='instanceId', description='The instance ID.', example='c-xxx'),
  instanceName?: string(name='instanceName', description='The instance name.', example='milvus-test'),
  kmsKeyId?: string(name='kmsKeyId', description='The KMS key ID.', example='key-xxx'),
  multiZoneMode?: string(name='multiZoneMode', description='The multi-zone mode.', example='Single'),
