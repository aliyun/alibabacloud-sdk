  * @param request  the request parameters of AddLogPath  AddLogPathRequest
  * @return AddLogPathResponse
 */
async function addLogPath(request: AddLogPathRequest): AddLogPathResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddLogPath', 'POST', '/pop/v5/log/popListLogDirs', 'json', true, 'form', request);
}

