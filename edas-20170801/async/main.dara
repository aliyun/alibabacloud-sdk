model InsertSwimmingLaneRequest {
  appInfos?: string(name='AppInfos', description='The information about applications related to the lane.', example='[{"appId":"f72deaac-26ba-429a-948d-5fa47c4a****"},{"appId":"5049d2c8-f997-4fc9-92a2-153506a6****"}]', position='Query'),
