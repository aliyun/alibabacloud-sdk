  JDK?: string(name='JDK', description='The JDK version on which the deployment package depends. Valid values: Open JDK 7, Open JDK 8, or Custom OpenJDK. This parameter is not supported for image-based deployments. If you use Custom OpenJDK, you must also configure the \\\\`UserBaseImageUrl\\\\` field.', example='Open JDK 8'),
