import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-qingdao' = 'adb.aliyuncs.com',
    'cn-beijing' = 'adb.aliyuncs.com',
    'cn-hangzhou' = 'adb.aliyuncs.com',
    'cn-shanghai' = 'adb.aliyuncs.com',
    'cn-shenzhen' = 'adb.aliyuncs.com',
    'cn-hongkong' = 'adb.aliyuncs.com',
    'ap-southeast-1' = 'adb.aliyuncs.com',
    'us-west-1' = 'adb.aliyuncs.com',
    'us-east-1' = 'adb.aliyuncs.com',
    'cn-hangzhou-finance' = 'adb.aliyuncs.com',
    'cn-north-2-gov-1' = 'adb.aliyuncs.com',
    'ap-northeast-2-pop' = 'adb.ap-northeast-1.aliyuncs.com',
    'cn-beijing-finance-1' = 'adb.aliyuncs.com',
    'cn-beijing-finance-pop' = 'adb.aliyuncs.com',
    'cn-beijing-gov-1' = 'adb.aliyuncs.com',
    'cn-beijing-nu16-b01' = 'adb.aliyuncs.com',
    'cn-edge-1' = 'adb.aliyuncs.com',
    'cn-fujian' = 'adb.aliyuncs.com',
    'cn-haidian-cm12-c01' = 'adb.aliyuncs.com',
    'cn-hangzhou-bj-b01' = 'adb.aliyuncs.com',
    'cn-hangzhou-internal-prod-1' = 'adb.aliyuncs.com',
    'cn-hangzhou-internal-test-1' = 'adb.aliyuncs.com',
    'cn-hangzhou-internal-test-2' = 'adb.aliyuncs.com',
    'cn-hangzhou-internal-test-3' = 'adb.aliyuncs.com',
    'cn-hangzhou-test-306' = 'adb.aliyuncs.com',
    'cn-hongkong-finance-pop' = 'adb.aliyuncs.com',
    'cn-qingdao-nebula' = 'adb.aliyuncs.com',
    'cn-shanghai-et15-b01' = 'adb.aliyuncs.com',
    'cn-shanghai-et2-b01' = 'adb.aliyuncs.com',
    'cn-shanghai-finance-1' = 'adb.aliyuncs.com',
    'cn-shanghai-inner' = 'adb.aliyuncs.com',
    'cn-shanghai-internal-test-1' = 'adb.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'adb.aliyuncs.com',
    'cn-shenzhen-inner' = 'adb.aliyuncs.com',
    'cn-shenzhen-st4-d01' = 'adb.aliyuncs.com',
    'cn-shenzhen-su18-b01' = 'adb.aliyuncs.com',
    'cn-wuhan' = 'adb.aliyuncs.com',
    'cn-yushanfang' = 'adb.aliyuncs.com',
    'cn-zhangbei-na61-b01' = 'adb.aliyuncs.com',
    'cn-zhangjiakou-na62-a01' = 'adb.aliyuncs.com',
    'cn-zhengzhou-nebula-1' = 'adb.aliyuncs.com',
    'eu-west-1-oxs' = 'adb.ap-northeast-1.aliyuncs.com',
    'me-east-1' = 'adb.ap-northeast-1.aliyuncs.com',
    'rus-west-1-pop' = 'adb.ap-northeast-1.aliyuncs.com',
    'na-south-1' = 'adb.na-south-1.aliyuncs.com',
    'me-central-1' = 'adb.me-central-1.aliyuncs.com',
    'eu-west-1' = 'adb.eu-west-1.aliyuncs.com',
    'eu-central-1' = 'adb.eu-central-1.aliyuncs.com',
    'cn-zhangjiakou' = 'adb.cn-zhangjiakou.aliyuncs.com',
    'cn-wulanchabu' = 'adb.cn-wulanchabu.aliyuncs.com',
    'cn-huhehaote' = 'adb.cn-huhehaote.aliyuncs.com',
    'cn-guangzhou' = 'adb.cn-guangzhou.aliyuncs.com',
    'cn-chengdu' = 'adb.cn-chengdu.aliyuncs.com',
    'ap-southeast-7' = 'adb.ap-southeast-7.aliyuncs.com',
    'ap-southeast-6' = 'adb.ap-southeast-6.aliyuncs.com',
    'ap-southeast-5' = 'adb.ap-southeast-5.aliyuncs.com',
    'ap-southeast-3' = 'adb.ap-southeast-3.aliyuncs.com',
    'ap-northeast-2' = 'adb.ap-northeast-2.aliyuncs.com',
    'ap-northeast-1' = 'adb.ap-northeast-1.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('adb', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AccessTokenModel {
  accessToken?: string(name='AccessToken'),
  comment?: string(name='Comment'),
  createdAt?: string(name='CreatedAt'),
  expiredAt?: string(name='ExpiredAt'),
  status?: string(name='Status'),
}

model Adb4MysqlSparkDiagnosisInfo {
  diagnosisCode?: string(name='DiagnosisCode'),
  diagnosisCodeLabel?: string(name='DiagnosisCodeLabel'),
  diagnosisMsg?: string(name='DiagnosisMsg'),
  diagnosisType?: string(name='DiagnosisType', example='APPLICATION'),
}

model ColDetailModel {
  columnName?: string(name='ColumnName', description='The logical name of the column.', example='example'),
  createTime?: string(name='CreateTime', description='The time when the column was created. The time is displayed in UTC.', example='2023-01-05\\\\"T\\\\"13:17:55\\\\"Z\\\\"'),
  description?: string(name='Description', description='The description of the column.', example='description'),
  distributeKey?: boolean(name='DistributeKey', description='Indicates whether the column is the distribution key.', example='false'),
  nullable?: boolean(name='Nullable', description='Indicates whether the column can be empty.', example='false'),
  partitionKey?: boolean(name='PartitionKey', description='Indicates whether the column is the partition key.', example='true'),
  primaryKey?: boolean(name='PrimaryKey', description='Indicates whether the column is the primary key.', example='true'),
  schemaName?: string(name='SchemaName', description='The logical name of the database.', example='schemaName'),
  tableName?: string(name='TableName', description='The logical name of the table.', example='tableName'),
  type?: string(name='Type', description='The data type of the column.', example='string'),
  updateTime?: string(name='UpdateTime', description='The time when the column was updated. The time is displayed in UTC.', example='2023-01-05\\\\"T\\\\"13:17:55\\\\"Z\\\\"'),
}

model CstoreIndexModel {
  columnOrds?: [ string ](name='ColumnOrds', description='The order of index columns.'),
  createTime?: string(name='CreateTime', description='The time when the index was created.', example='2023-01-05 13:17:55'),
  databaseName?: string(name='DatabaseName', description='The logical name of the database.', example='exampleDatabase'),
  indexColumns?: [
    FieldSchemaModel
  ](name='IndexColumns', description='The index columns.'),
  indexName?: string(name='IndexName', description='The name of the index.', example='indexName'),
  indexType?: string(name='IndexType', description='The type of the index.', example='NORMAL'),
  options?: map[string]string(name='Options', description='The properties.'),
  physicalTableName?: string(name='PhysicalTableName', description='The physical name of the table.', example='physicalDatabase'),
  updateTime?: string(name='UpdateTime', description='The time when the index was updated.', example='2023-01-05 13:17:55'),
}

model DatabaseSummaryModel {
  createTime?: string(name='CreateTime', description='Creation time.', example='2023-01-05 13:17:55'),
  createdBySource?: string(name='CreatedBySource'),
  createdByUser?: string(name='CreatedByUser'),
  dbType?: string(name='DbType'),
  description?: string(name='Description', description='Description.', example='description'),
  location?: string(name='Location'),
  owner?: string(name='Owner', description='Owner.', example='abc'),
  schemaName?: string(name='SchemaName', description='logical database name.', example='testSchema'),
  updateTime?: string(name='UpdateTime', description='Update time.', example='2023-01-05 13:17:55'),
}

model Detail {
  appType?: string(name='AppType', description='The type of the Spark application.', example='BATCH'),
  DBClusterId?: string(name='DBClusterId', description='The ID of the cluster that runs the Spark application.', example='amv-bp11q28kvl688****'),
  data?: string(name='Data', description='The configuration content of the Spark application.', example='{     "name": "SparkPi",     "file": "local:///tmp/spark-examples.jar",     "className": "org.apache.spark.examples.SparkPi",     "args": [         "1000000"     ],     "conf": {         "spark.driver.resourceSpec": "small",         "spark.executor.instances": 1,         "spark.executor.resourceSpec": "small"     } }'),
  durationInMillis?: long(name='DurationInMillis', description='The execution duration of the Spark application, in milliseconds (ms).', example='100'),
  estimateExecutionCpuTimeInSeconds?: long(name='EstimateExecutionCpuTimeInSeconds', description='The CPU time consumed by the Spark application, in milliseconds (ms).', example='100'),
  executionDurationInMillis?: long(name='ExecutionDurationInMillis', description='The execution duration.', example='36000'),
  lastAttemptId?: string(name='LastAttemptId', description='The ID of the last retry of the Spark application.', example='s202204291426hzpre60****-0003'),
  lastUpdatedTimeInMillis?: long(name='LastUpdatedTimeInMillis', description='The time when the Spark application was last updated. This value is a UNIX timestamp, in milliseconds (ms).', example='1651213645200'),
  logRootPath?: string(name='LogRootPath', description='The storage path of the log file.', example='oss://<bucket-name>/logs/driver'),
  resourceGroupName?: string(name='ResourceGroupName', description='The name of the job resource group.', example='spark-rg'),
  resourceProvisioningDurationInMillis?: long(name='ResourceProvisioningDurationInMillis', description='The duration of resource provisioning for the application.', example='36000'),
  runningStartTimeInMillis?: long(name='RunningStartTimeInMillis', description='The timestamp when the job started running.', example='36000', nullable=false),
  startedTimeInMillis?: long(name='StartedTimeInMillis', description='The time when the Spark application was created. This value is a UNIX timestamp, in milliseconds (ms).', example='1651213645010'),
  submittedTimeInMillis?: long(name='SubmittedTimeInMillis', description='The time when the Spark application was submitted. This value is a UNIX timestamp, in milliseconds (ms).', example='1651213645000'),
  terminatedTimeInMillis?: long(name='TerminatedTimeInMillis', description='The time when the Spark application was terminated. This value is a UNIX timestamp, in milliseconds (ms).', example='1651213645300'),
  webUiAddress?: string(name='WebUiAddress', description='The Web UI address.', example='https://adbsparkui-cn-hangzhou.aliyuncs.com/?token=****'),
}

model FieldSchemaModel {
  autoIncrement?: boolean(name='AutoIncrement', description='Indicates whether the column is auto-incremented.', example='true'),
  columnRawName?: string(name='ColumnRawName', description='The original name of the column.', example='ColumnRawName'),
  comment?: string(name='Comment', description='The description of the column.', example='comment'),
  compressFloatUseShort?: boolean(name='CompressFloatUseShort', description='Indicates whether FLOAT data is compressed to SHORT data.', example='false'),
  compression?: string(name='Compression', description='The compression method of the column.', example='compression'),
  createTime?: string(name='CreateTime', description='The time when the column was created.', example='2023-01-05 13:17:55'),
  dataType?: string(name='DataType', description='The data type of the column.', example='long'),
  databaseName?: string(name='DatabaseName', description='The logical name of the database.', example='databaseName'),
  defaultValue?: string(name='DefaultValue', description='The default value of the column.', example='default'),
  delimiter?: string(name='Delimiter', description='The delimiter of the column.', example='delimiter'),
  encode?: string(name='Encode', description='The encryption method of the column.', example='encode'),
  isPartitionKey?: boolean(name='IsPartitionKey', description='Indicates whether the column is the partition key.', example='false'),
  mappedName?: string(name='MappedName', description='The mapping name.', example='mappedName'),
  name?: string(name='Name', description='The name of the column.', example='name'),
  nullable?: boolean(name='Nullable', description='Indicates whether the column can be empty.', example='true'),
  onUpdate?: string(name='OnUpdate', description='The update condition of the column.', example='onUpdate'),
  ordinalPosition?: long(name='OrdinalPosition', description='The location of the column.', example='-1'),
  physicalColumnName?: string(name='PhysicalColumnName', description='The physical name of the column.', example='PhysicalColumnName'),
  pkPosition?: long(name='PkPosition', description='The location of the primary key.', example='-1'),
  precision?: long(name='Precision', description='The precision of the column.', example='1'),
  primarykey?: boolean(name='Primarykey', description='Indicates whether the column is the primary key.', example='true'),
  scale?: long(name='Scale', description='The scale of the column.', example='1'),
  tableName?: string(name='TableName', description='The logical name of the table.', example='tableName'),
  tokenizer?: string(name='Tokenizer', description='The token of the column.', example='tokenizer'),
  type?: string(name='Type', description='The type of the column.', example='long'),
  updateTime?: string(name='UpdateTime', description='The time when the index was updated.', example='2023-01-05 13:17:55'),
  valueType?: string(name='ValueType', description='The value type of the column.', example='valueType'),
}

model Filters {
  appIdRegex?: string(name='AppIdRegex'),
  appNameRegex?: string(name='AppNameRegex'),
  appState?: string(name='AppState'),
  appType?: string(name='AppType'),
  executionTimeRange?: {
    maxTimeInSeconds?: long(name='MaxTimeInSeconds'),
    minTimeInSeconds?: long(name='MinTimeInSeconds'),
  }(name='ExecutionTimeRange'),
  submitTimeRange?: {
    maxTimeInMills?: long(name='MaxTimeInMills'),
    minTimeInMills?: long(name='MinTimeInMills'),
  }(name='SubmitTimeRange'),
  termiatedTimeRange?: {
    maxTimeInMills?: long(name='MaxTimeInMills'),
    minTimeInMills?: long(name='MinTimeInMills'),
  }(name='TermiatedTimeRange'),
}

model LogAnalyzeResult {
  appErrorAdvice?: string(name='AppErrorAdvice', description='The solution for the error log.', example='Please increase cpu quota for your resource group'),
  appErrorCode?: string(name='AppErrorCode', description='The error type if an analysis error occurs.', example='EXCEEDED_QUOTA'),
  appErrorLog?: string(name='AppErrorLog', description='The error log of the Spark log analysis task.', example='exception: cpu is exceeded limits 12/10'),
}

model OperatorNode {
  children?: [
    OperatorNode
  ](name='children'),
  id?: int32(name='id'),
  levelWidth?: int32(name='levelWidth'),
  nodeDepth?: int32(name='nodeDepth'),
  nodeName?: string(name='nodeName'),
  nodeWidth?: int32(name='nodeWidth'),
  parentId?: int32(name='parentId'),
  stats?: {
    bytes?: long(name='bytes'),
    outputRows?: long(name='outputRows'),
    parameters?: string(name='parameters'),
    peakMemory?: long(name='peakMemory'),
    timeCost?: long(name='timeCost'),
  }(name='stats'),
}

model SemanticViewModel {
  comment?: string(name='Comment', description='The annotation for the semantic view', example='这是一个定义销售额相关指标的视图'),
  definition?: string(name='Definition', description='The YAML definition of the semantic view', example='name: revenue_analysis
description: "Semantic view for analyzing revenue across products and customers"

tables:
  - name: customers
    description: "Customer information"
    base_table:
      schema: sales_db
      table: customers
    dimensions:
      - name: customer_name
        synonyms: ["client name", "customer"]
        description: "Full name of the customer"
        expr: c_name
        data_type: VARCHAR
      - name: customer_segment
        synonyms: ["segment", "market segment"]
        description: "Customer market segment"
        expr: c_mktsegment
        data_type: VARCHAR
        is_enum: true

  - name: orders
    description: "Order information"
    base_table:
      schema: sales_db
      table: orders
    dimensions:
      - name: order_date
        description: "Date when order was placed"
        expr: o_orderdate
        data_type: DATE
      - name: order_year
        description: "Year when order was placed"
        expr: YEAR(o_orderdate)
        data_type: NUMBER
    facts:
      - name: order_total
        description: "Total order amount"
        expr: o_totalprice
        data_type: NUMBER
    metrics:
      - name: total_orders
        description: "Total number of orders"
        expr: COUNT(*)
      - name: total_revenue
        description: "Total revenue of orders"
        expr: SUM(o_totalprice)
      - name: average_order_value
        description: "Average order value"
        expr: AVG(o_totalprice)

relationships:
  - name: orders_to_customers
    left_table: orders
    right_table: customers
    relationship_columns:
      - left_column: o_custkey
        right_column: c_custkey

metrics:
  - name: revenue_per_customer
    description: "Average revenue per customer"
    expr: orders.total_revenue / customers.customer_count'),
  score?: double(name='Score', description='The vector retrieval match score (defaults to 1; during retrieval queries, it is a decimal between 0 and 1 representing vector similarity)', example='0.81'),
  viewName?: string(name='ViewName', description='The name of the semantic view', example='revenue_analysis'),
  viewSchema?: string(name='ViewSchema', description='The schema where the semantic view resides', example='sales_db'),
}

model SerDeInfoModel {
  name?: string(name='Name', description='The name of the serialization or deserialization information.', example='example'),
  parameters?: map[string]string(name='Parameters', description='The serialization or deserialization configuration parameter.'),
  serDeId?: long(name='SerDeId', description='The ID of the serialization or deserialization information.', example='123'),
  serializationLib?: string(name='SerializationLib', description='The library that is used for serialization.', example='org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe'),
}

model SparkAnalyzeLogTask {
  DBClusterId?: string(name='DBClusterId', description='The cluster ID.', example='amv-adbxxxxx'),
  result?: LogAnalyzeResult(name='Result', description='The analysis result of the task.'),
  ruleMatched?: boolean(name='RuleMatched', description='Indicates whether the task matched a rule.', example='true'),
  startedTimeInMillis?: long(name='StartedTimeInMillis', description='The time when the task was started. The value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC.', example='1672123543000'),
  submittedTimeInMillis?: long(name='SubmittedTimeInMillis', description='The time when the task was submitted. The value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC.', example='1672123543000'),
  taskErrMsg?: string(name='TaskErrMsg', description='The error message returned if the task fails.', example='Driver log not found'),
  taskId?: long(name='TaskId', description='The ID of the Spark log analysis task.', example='10'),
  taskState?: string(name='TaskState', description='The state of the task.', example='WAITING'),
  terminatedTimeInMillis?: long(name='TerminatedTimeInMillis', description='The time when the task was terminated. The value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC.', example='1672123543000'),
  userId?: long(name='UserId', description='The ID of the user who submitted the task.', example='13719918xxx'),
}

model SparkAppInfo {
  appId?: string(name='AppId', description='The ID of the Spark application.', example='s202207151211hz0c****'),
  appName?: string(name='AppName', description='The name of the Spark application.', example='SparkTest'),
  DBClusterId?: string(name='DBClusterId', description='The database ID.', example='amv-23xxxx'),
  detail?: Detail(name='Detail', description='The information about the Spark application.'),
  message?: string(name='Message', description='The alert message returned, such as task execution failure or insufficient resources. If no alert occurs, null is returned.', example='WARN: Disk is full.'),
  priority?: string(name='Priority', description='The priority of the Spark application.', example='NORMAL'),
  state?: string(name='State', description='The state of the Spark application. Valid values:

*   **SUBMITTED**
*   **STARTING**
*   **RUNNING**
*   **FAILING**
*   **FAILED**
*   **KILLING**
*   **KILLED**
*   **SUCCEEDING**
*   **COMPLETED**
*   **FATAL**
*   **UNKNOWN**', example='SUBMITTED'),
}

model SparkAttemptInfo {
  attemptId?: string(name='AttemptId', description='The attempt ID of the Spark application.', example='s202207151211hz****-0001'),
  detail?: Detail(name='Detail', description='The information about the Spark application.'),
  message?: string(name='Message', description='The alert message returned, such as task execution failure or insufficient resources. If no alert occurs, null is returned.', example='WARN: Disk is full'),
  priority?: string(name='Priority', description='The attempt priority of the Spark application.', example='NORMAL'),
  state?: string(name='State', description='The state of the Spark application. Valid values:

*   **SUBMITTED**
*   **STARTING**
*   **RUNNING**
*   **FAILING**
*   **FAILED**
*   **KILLING**
*   **KILLED**
*   **SUCCEEDING**
*   **COMPLETED**
*   **FATAL**
*   **UNKNOWN**', example='SUBMITTED'),
}

model SparkBatchSQL {
  DBClusterId?: string(name='DBClusterId', description='The cluster ID.', example='amv-bp17s73f016****'),
  errMessage?: string(name='ErrMessage', description='The error message for the query execution.', example='schema is not found'),
  query?: string(name='Query', description='The text of the query.', example='SELECT * FROM db.tb'),
  queryEndTime?: long(name='QueryEndTime', description='The execution end timestamp of the query.', example='1723521767000'),
  queryId?: string(name='QueryId', description='The query ID.', example='sq172352176****'),
  queryStartTime?: long(name='QueryStartTime', description='The execution start timestamp of the query.', example='1723521767000'),
  queryState?: string(name='QueryState', description='The execution status of the query. Valid values:

*   FAILED
*   RUNNING
*   CANCELED
*   PENDING
*   SUBMITTED
*   FINISHED', example='RUNNING'),
  querySubmissionTime?: long(name='QuerySubmissionTime', description='The submission timestamp of the query.', example='1723521767000'),
  resourceGroupName?: string(name='ResourceGroupName', description='The name of the resource group.', example='spark_rg'),
  schema?: string(name='Schema', description='The name of the database for the query execution.', example='default'),
  statements?: [
    SparkBatchSQLStatement
  ](name='Statements', description='The execution results of the SQL statements.'),
  uid?: long(name='Uid', description='The Alibaba Cloud account ID.', example='2198002412336****'),
}

model SparkBatchSQLStatement {
  appId?: string(name='AppId', description='The ID of the Spark job that executes the SQL statement.', example='s20240122jsdx****'),
  code?: string(name='Code', description='The text of the SQL statement.', example='SELECT 100'),
  endTime?: long(name='EndTime', description='The execution end timestamp of the SQL statement.', example='1723521767000'),
  error?: string(name='Error', description='The error message for the SQL statement execution.', example='table is not found'),
  result?: string(name='Result', description='The execution result of the SQL statement. The content is in the response format of the `DataFrame Show` statement in Spark.', example='+---+-----+
|age| name|
+---+-----+
| 14|  Tom|
| 23|Alice|
+---+-----+'),
  resultUri?: string(name='ResultUri', description='The Object Storage Service (OSS) location where the execution results of the SQL statement are stored. If you do not specify a storage location, null is returned.', example='oss://yourbucket/result.json'),
  startTime?: long(name='StartTime', description='The execution start timestamp of the SQL statement.', example='1723521767000'),
  state?: string(name='State', description='The execution status of the SQL statement. Valid values:

*   FAILED
*   RUNNING
*   CANCELED
*   PENDING
*   FINISHED', example='RUNNING'),
  statementId?: string(name='StatementId', description='The ID of the SQL statement.', example='sq1723521767****-0001'),
}

model SparkOperatorInfo {
  metricValue?: long(name='MetricValue'),
  operatorName?: bytes(name='OperatorName'),
}

model SparkSession {
  active?: string(name='Active', example='true'),
  aliyunUid?: long(name='AliyunUid', example='11123123'),
  sessionId?: long(name='SessionId', example='15'),
  state?: string(name='State', example='idle'),
}

model Statement {
  aliyunUid?: long(name='AliyunUid', example='1111111'),
  code?: string(name='Code', example='SELECT * FROM table'),
  codeState?: string(name='CodeState', example='Waiting'),
  codeType?: string(name='CodeType', example='SQL'),
  endTime?: long(name='EndTime', example='1658987911000'),
  error?: string(name='Error', example='Disk is full'),
  haveRows?: boolean(name='HaveRows', example='true'),
  output?: string(name='Output', example='Spark is running, the ouput is...'),
  resourceGroup?: string(name='ResourceGroup', example='rg1'),
  sessionId?: long(name='SessionId', example='10'),
  startTime?: long(name='StartTime', example='1658977911000'),
  statementId?: long(name='StatementId', example='100'),
  totalCount?: long(name='TotalCount', example='1000'),
}

model StatementInfo {
  code?: string(name='Code'),
  completedTimeInMills?: long(name='CompletedTimeInMills'),
  output?: string(name='Output'),
  process?: float(name='Process'),
  startedTimeInMills?: long(name='StartedTimeInMills'),
  state?: string(name='State'),
  statementId?: string(name='StatementId'),
}

