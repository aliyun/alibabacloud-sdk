  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CreateAgentPlatformRequest {
  aiPlatformConfig: {
    serveApiKey: string(name='ServeApiKey', description='The API key of the model for the inference service that the metric analysis platform depends on.

This parameter is required.', example='3760d3**************************'),
    serveEmbeddingEndpoint: string(name='ServeEmbeddingEndpoint', description='The endpoint of the embedding model for the inference service that the metric analysis platform depends on.

This parameter is required.', example='http://111.xx.xx.xx:8100/inferenceservice/emb'),
    serveEmbeddingModelName: string(name='ServeEmbeddingModelName', description='The name of the embedding model for the inference service that the metric analysis platform depends on.

This parameter is required.', example='Qwen3-Embedding-8B'),
    serveEndpoint: string(name='ServeEndpoint', description='The endpoint of the base model for the inference service that the metric analysis platform depends on.

This parameter is required.', example='http://111.xx.xx.xx:8100/inferenceservice/base'),
    serveModelName: string(name='ServeModelName', description='The name of the base model for the inference service that the metric analysis platform depends on.

This parameter is required.', example='Qwen3-235B-A22B-Instruct-2507'),
    specName: string(name='SpecName', description='The specifications of the metric analysis platform.

This parameter is required.', example='large'),
  }(name='AiPlatformConfig', description='The parameters required to create the metric analysis platform.

This parameter is required.', shrink='json', position='Query'),
  DBClusterId: string(name='DBClusterId', description='The instance cluster ID.

This parameter is required.', example='amv-bp11q28kvl688****', position='Query'),
  name: string(name='Name', description='The name of the metric analysis platform.

This parameter is required.', example='testplatform', position='Query'),
  regionId?: string(name='RegionId', description='The region ID.

> You can call the DescribeRegions operation to query the region ID of a specified Data Lakehouse Edition cluster.', example='cn-beijing', position='Query'),
}

model CreateAgentPlatformResponseBody = {
  requestId?: string(name='RequestId', description='Id of the request', example='B47EED99-BFA5-529D-8D85-A6642421D390'),
}

model CreateAgentPlatformResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateAgentPlatformResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateAgentPlatform  CreateAgentPlatformRequest
  * @return CreateAgentPlatformResponse
 */
async function createAgentPlatform(request: CreateAgentPlatformRequest): CreateAgentPlatformResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateAgentPlatform', 'POST', '/', 'json', false, 'json', request);
}

