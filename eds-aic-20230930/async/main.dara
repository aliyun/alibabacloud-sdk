  commandContent?: string(name='CommandContent', description='The content of the command.', example='ls', position='Query'),
  contentEncoding?: string(name='ContentEncoding', description='The encoding method for the command content (`CommandContent`). This value is not case-sensitive.

> An invalid value defaults to `PlainText`.', example='PlainText', position='Query'),
  instanceIds?: [ string ](name='InstanceIds', description='A list of instance IDs. You can specify up to 50 instances per request.', position='Query'),
  timeout?: long(name='Timeout', description='The execution timeout in seconds. The command times out if it does not complete within this period. Defaults to 60 seconds.', example='60', position='Query'),
}

model RunCommandResponseBody = {
  invokeId?: string(name='InvokeId', description='The command execution ID. Use this ID to query the execution result.', example='t-gov2ujrk32v4****'),
  requestId?: string(name='RequestId', description='The request ID.', example='440D7342-5E7C-B2DB-D0B4EAC2BDF1****'),
  runCommandInfos?: [ 
    {
      childTaskId?: string(name='ChildTaskId'),
      instanceId?: string(name='InstanceId'),
      invokeId?: string(name='InvokeId'),
    }
  ](name='RunCommandInfos'),
  taskId?: string(name='TaskId'),
}

model RunCommandResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: RunCommandResponseBody(name='body'),
}

/**
  * @param request  the request parameters of RunCommand  RunCommandRequest
  * @return RunCommandResponse
 */
async function runCommand(request: RunCommandRequest): RunCommandResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'RunCommand', 'POST', '/', 'json', false, 'json', request);
}

model RunSyncCommandRequest {
  commandContent?: string(name='CommandContent', description='The content of the command to execute.', example='ls', position='Query'),
  contentEncoding?: string(name='ContentEncoding', description='The encoding of the command content. If you provide a value that is not a valid option, the system uses the default value, `PlainText`.', example='PlainText', position='Query'),
  instanceIds?: [ string ](name='InstanceIds', description='An array of Cloud Phone instance IDs. You can specify up to 50 instances in a single request.', position='Query'),
  waitTime?: long(name='WaitTime', description='The timeout for command execution, in milliseconds. Valid range: 500 to 3000. Default: 1000.', example='1000', minimum=500, maximum=3000, position='Query'),
}

model RunSyncCommandResponseBody = {
  data?: [ 
    {
      finishTime?: string(name='FinishTime', description='The time when command execution finished.', example='2022-08-11 17:45:03'),
      instanceId?: string(name='InstanceId', description='The ID of the instance on which the command was executed.', example='acp-uto81vfd8t8z****'),
      invocationId?: string(name='InvocationId', description='The invocation ID.', example='t-15775dc8****'),
      invocationStatus?: string(name='InvocationStatus', description='The command execution status.', example='RUNNING'),
      output?: string(name='Output', description='The command output.', example='success'),
      startTime?: string(name='StartTime', description='The time when command execution began.', example='2022-10-11T08:53:32Z'),
    }
  ](name='Data', description='An array of objects, where each object contains the execution result for a single instance.'),
  requestId?: string(name='RequestId', description='The request ID.', example='5C5CEF0A-D6E1-58D3-8750-67DB4F82****'),
  totalCount?: string(name='TotalCount', description='The total number of entries.', example='31'),
}

model RunSyncCommandResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: RunSyncCommandResponseBody(name='body'),
}

/**
  * @description The `RunSyncCommand` operation is designed for commands that return a result quickly, typically within milliseconds. For longer-running commands that may take several seconds, we recommend using the asynchronous [](t2729835.xdita#)operation.
  * @param request  the request parameters of RunSyncCommand  RunSyncCommandRequest
  * @return RunSyncCommandResponse
 */
async function runSyncCommand(request: RunSyncCommandRequest): RunSyncCommandResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'RunSyncCommand', 'POST', '/', 'json', false, 'json', request);
}

model SendFileRequest {
  androidInstanceIdList: [ string ](name='AndroidInstanceIdList', description='The IDs of one or more cloud phone instances.

This parameter is required.', position='Query'),
  autoInstall?: boolean(name='AutoInstall', description='Specifies whether to automatically install the application after the file is uploaded.', example='true', position='Query'),
  clientToken?: string(name='ClientToken', description='A client-generated token that ensures request idempotence and prevents duplicate submissions. The token can contain up to 100 characters.', example='425F351C-3F8E-5218-A520-B6311D0D****', position='Query'),
  fileMd5?: string(name='FileMd5', position='Query'),
  sourceFilePath: string(name='SourceFilePath', description='The destination path on the cloud phone.

> If `UploadType` is `OSS` or `OSS_BRIDGED`, `SourceFilePath` must specify a directory, for example, `/sdcard/Download/`. If `UploadType` is `DOWNLOAD_URL`, `SourceFilePath` must specify a full file path, for example, `/sdcard/Download/MyFile.txt`.

This parameter is required.', example='/sdcard/Download', position='Query'),
  targetFileName?: string(name='TargetFileName', description='The name for the destination file on the cloud phone.

> This parameter is optional and takes effect only when `UploadType` is set to `OSS` or `OSS_BRIDGED`. If you specify this parameter, the file is saved with this name in the path specified by `SourceFilePath`. If you leave this parameter empty, the source file name is used. This parameter is ignored when `UploadType` is set to `DOWNLOAD_URL`.', example='test.txt', position='Query'),
  uploadEndpoint?: string(name='UploadEndpoint', description='The service endpoint of Object Storage Service (OSS). This parameter is required if `UploadType` is `OSS` or `OSS_BRIDGED`.

> If the cloud phone instance and the OSS bucket are in the same region, you can specify an internal endpoint to accelerate data transfer and avoid public data transfer costs. For example, the internal endpoint for the China (Hangzhou) region is `oss-cn-hangzhou-internal.aliyuncs.com`. For a complete list of endpoints, see [OSS regions and endpoints](https://help.aliyun.com/document_detail/31837.html).', example='oss-cn-hangzhou-internal.aliyuncs.com', position='Query'),
  uploadType: string(name='UploadType', description='The storage type of the source file. Valid values:

- **OSS**: The file is stored in Object Storage Service (OSS).

- **DOWNLOAD_URL**: The file is accessible via a public download link.

- **OSS_BRIDGED**: The service first downloads the file from a public download link to an internal OSS bucket, and then distributes it to the cloud phone instances over the internal network.

This parameter is required.', example='OSS', position='Query'),
  uploadUrl: string(name='UploadUrl', description='- If `UploadType` is `OSS`, this parameter specifies the URI of the source object in Object Storage Service (OSS).

> The URI must be in the `oss://<bucket-name>/<object-key>` format. The specified OSS bucket name must have the `cloudphone-saved-bucket-` prefix, for example, `cloudphone-saved-bucket-example`.

- If `UploadType` is `DOWNLOAD_URL` or `OSS_BRIDGED`, this parameter specifies the public download link of the source file.

This parameter is required.', example='oss://cloudphone-saved-bucket-example/send/a.txt', position='Query'),
}

model SendFileResponseBody = {
  data?: [ 
    {
      androidInstanceId?: string(name='AndroidInstanceId', description='The instance ID.', example='acp-34pqe4r0kd9kn****'),
      taskId?: string(name='TaskId', description='The ID of the individual task for a specific cloud phone.', example='t-4ks224ujixw****'),
    }
  ](name='Data', description='The details of the created tasks.', example='425F351C-3F8E-5218-A520-B6311D0D****'),
  requestId?: string(name='RequestId', description='A unique identifier for the request. If you encounter an issue, provide this request ID to technical support for troubleshooting.', example='425F351C-3F8E-5218-A520-B6311D0D****'),
  taskId?: string(name='TaskId', description='The batch task ID.', example='t-ehs0yoedj0xe9****'),
}

model SendFileResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SendFileResponseBody(name='body'),
}

/**
  * @description Use this operation to send files or folders from Object Storage Service (OSS) to cloud phones.
  * @param request  the request parameters of SendFile  SendFileRequest
  * @return SendFileResponse
 */
