model BackupAndroidInstanceRequest {
  androidInstanceIdList: [ string ](name='AndroidInstanceIdList', description='A list of instance IDs.

This parameter is required.', position='Query'),
  backupFileName?: string(name='BackupFileName', description='The name of the backup file.', example='abc', position='Query'),
  backupFilePath: string(name='BackupFilePath', description='The upload URL for the backup file.

This parameter is required.', position='Query'),
  description?: string(name='Description', description='The description of the full instance backup.', example='this is a backup android instance', position='Query'),
  uploadEndpoint: string(name='UploadEndpoint', description='The region where the backup is stored.

This parameter is required.', example='oss-cn-hangzhou-internal.aliyuncs.com', position='Query'),
}

model BackupAndroidInstanceResponseBody = {
  count?: long(name='Count', description='The number of instances that were backed up.', example='1'),
  data?: [ 
    {
      androidInstanceId?: string(name='AndroidInstanceId', description='The cloud phone instance ID.', example='acp-34pqe4r0kd9kn****'),
      backupFileId?: string(name='BackupFileId', description='The ID of the backup file.', example='bf-b0qbg3pbpjkn7****'),
      backupFileName?: string(name='BackupFileName', description='The name of the backup file.', example='a-58ftsoo90p0qa****.ab'),
      taskId?: string(name='TaskId', description='The ID of the task.', example='t-bp67acfmxazb4p****'),
    }
  ](name='Data', description='The returned result objects.'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='440D7342-5FC2-5E7C-B2DB-D0B4EAC2BDF1'),
  taskId?: string(name='TaskId', description='The ID of the task.', example='t-14xwibw7pyrjd****'),
}

model BackupAndroidInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BackupAndroidInstanceResponseBody(name='body'),
}

/**
  * @description 1. To ensure that the backup is successful, shut down the instance before you start the data backup. The operation may fail if the cloud phone instance is used during the backup process.
  * 2. You should test the backup file to ensure that you can restore the instance from it. After the restoration is complete, verify that your data is complete and that all features function correctly. Do not delete the original backup file or reset the source instance until this verification is complete. Otherwise, you may lose your data.
  * 3. You cannot back up and restore data between different image versions, between custom images and public images, or across different architectures, such as cpm.gx7.10xlarge and cpm.gx8.16xlarge.
  * @param request  the request parameters of BackupAndroidInstance  BackupAndroidInstanceRequest
  * @return BackupAndroidInstanceResponse
 */
async function backupAndroidInstance(request: BackupAndroidInstanceRequest): BackupAndroidInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BackupAndroidInstance', 'POST', '/', 'json', false, 'json', request);
}

model BackupAppRequest {
  androidInstanceIdList: [ string ](name='AndroidInstanceIdList', description='A list of instance IDs.

This parameter is required.', position='Query'),
  backupFileName?: string(name='BackupFileName', description='The name of the backup file.', example='MyBackup', position='Query'),
  backupFilePath: string(name='BackupFilePath', description='The URL of the backup file.

This parameter is required.', position='Query'),
  description?: string(name='Description', description='The description of the application backup.', example='this is a backup app', position='Query'),
  sourceAppList: [ string ](name='SourceAppList', description='A list of package names for the applications to back up.

This parameter is required.', position='Query'),
  uploadEndpoint: string(name='UploadEndpoint', description='Specifies the region where the backup is created.

This parameter is required.', example='oss-cn-shanghai-internal.aliyuncs.com', position='Query'),
}

model BackupAppResponseBody = {
  count?: long(name='Count', description='The number of instances that are backed up.', example='1'),
  data?: [ 
    {
      androidInstanceId?: string(name='AndroidInstanceId', description='The ID of the cloud phone instance.', example='acp-34pqe4r0kd9kn****'),
      backupFileId?: string(name='BackupFileId', description='The ID of the backup file.', example='bf-b0qbg3pbpjkn7****'),
      backupFileName?: string(name='BackupFileName', description='The name of the backup file.', example='MyBackup'),
      taskId?: string(name='TaskId', description='The ID of the task.', example='t-4ks224ujixw****'),
