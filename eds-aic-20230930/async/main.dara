init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'eds-aic';
  @version = '2023-09-30';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ActivateEdgeMobileAgentRequest {
  deviceClass?: string(name='DeviceClass', description='The device form factor. Valid values:
- BOX
- PHONE
- PAD
- OTHER', example='BOX', position='Query'),
  deviceId: string(name='DeviceId', description='The unique identifier of the device.

This parameter is required.', example='sn-0001eevqa6jeapl*****', position='Query'),
  deviceMeta?: string(name='DeviceMeta', description='The extended device metadata in JSON format. The string contains information such as fingerprint, deviceModel, and firmwareVersion.', example='{"frmwareVersion": "1.0.0"}', position='Query'),
  licenseKey: string(name='LicenseKey', description='The license key.

This parameter is required.', example='lic-ez197xvdf0j5eo0*****', position='Query'),
}

model ActivateEdgeMobileAgentResponseBody = {
  data?: {
    authToken?: string(name='AuthToken', description='The assigned API key. The plaintext value is returned only upon the first activation.', example='cpk-81vfd8t8zdfxdf*****'),
    deviceId?: string(name='DeviceId', description='The device ID.', example='sn-0001eevqa6jeapl*****'),
    idempotent?: boolean(name='Idempotent', description='Indicates whether the request is an idempotent duplicate request.', example='false'),
    instanceId?: string(name='InstanceId', description='The EdgeMobile instance ID.', example='em-uto81vfd8t8z****'),
  }(name='Data', description='The response data object.'),
  requestId?: string(name='RequestId', description='The request ID.', example='5C5CEF0A-D6E1-58D3-8750-67DB4F82****'),
}

model ActivateEdgeMobileAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ActivateEdgeMobileAgentResponseBody(name='body'),
}

/**
  * @param request  the request parameters of ActivateEdgeMobileAgent  ActivateEdgeMobileAgentRequest
  * @return ActivateEdgeMobileAgentResponse
 */
async function activateEdgeMobileAgent(request: ActivateEdgeMobileAgentRequest): ActivateEdgeMobileAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ActivateEdgeMobileAgent', 'POST', '/', 'json', false, 'json', request);
}

model AttachKeyPairRequest {
  instanceIds?: [ string ](name='InstanceIds', description='The IDs of the cloud phone instances. You can specify a maximum of 50 cloud phone instances.', position='Query'),
  keyPairId: string(name='KeyPairId', description='The ID of the ADB key pair.

This parameter is required.', example='kp-6v2q33ae4tw3a****', position='Query'),
}

model AttachKeyPairResponseBody = {
  data?: {
    attachedInstanceIds?: [ string ](name='AttachedInstanceIds', description='The IDs of the cloud phone instances to which the ADB key pair is successfully attached.'),
    failCount?: int32(name='FailCount', description='The number of the cloud phone instances to which the ADB key pair failed to be attached.', example='0'),
    keyPairId?: string(name='KeyPairId', description='The ID of the ADB key pair.', example='kp-6v2q33ae4tw3a****'),
    totalCount?: int32(name='TotalCount', description='The total number of the cloud phone instances.', example='100'),
  }(name='Data', description='The object that is returned.'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='69BCBBE4-FCF2-59B8-AD9D-531EB422****'),
}

model AttachKeyPairResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachKeyPairResponseBody(name='body'),
}

/**
  * @description - You can attach to an ADB key pair only to cloud phone instances in the Running state.
  * - After you attach an ADB key pair, make sure the private key of the ADB key pair is copied to the \\~/.android directory (macOS or Linux operating systems) or the C:\\Users\\Username.android directory (Windows operating systems). In addition, you must run the adb kill-server command to restart the ADB process to ensure correct ADB connection. Otherwise, ADB connection may fail due to authentication exceptions.
  * @param request  the request parameters of AttachKeyPair  AttachKeyPairRequest
  * @return AttachKeyPairResponse
 */
async function attachKeyPair(request: AttachKeyPairRequest): AttachKeyPairResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AttachKeyPair', 'POST', '/', 'json', false, 'json', request);
}

