This parameter is required.', position='Query'),
  description?: string(name='Description', description='The description of the backup file.', example='This is a backup/data request.', position='Query'),
  excludeSourceFilePathList?: [ string ](name='ExcludeSourceFilePathList', position='Query'),
  sourceAppList?: [ string ](name='SourceAppList', description='A list of application package names to back up.', position='Query'),
  sourceFilePathList?: [ string ](name='SourceFilePathList', description='A list of file paths to back up.', position='Query'),
  uploadEndpoint?: string(name='UploadEndpoint', description='The domain name of the upload URL.

> If you upload the file to an OSS bucket, call the DescribeBuckets operation to obtain the bucket information. If the cloud phone and the bucket are in the same region, use the value of the intranetEndpoint field. If they are in different regions, use the value of the extranetEndpoint field.', example='oss-cn-shanghai-internal.aliyuncs.com', position='Query'),
  uploadType?: string(name='UploadType', description='The backup type.', example='OSS', position='Query'),
}

