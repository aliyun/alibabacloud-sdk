model SetNetworkBlacklistRequest {
  domainBlacklist?: [ string ](name='DomainBlacklist', description='Domain name blacklist.

> Supports a maximum of 200 domain names.', position='Query'),
  ipBlacklist?: [ string ](name='IpBlacklist', description='IP address blacklist.

> Supports a maximum of 200 IP addresses or IP address segments.', position='Query'),
}

model SetNetworkBlacklistResponseBody = {
  requestId?: string(name='RequestId', description='Request ID.', example='2B9E6946-0E2A-5D2B-B275-361DF81F****'),
}

model SetNetworkBlacklistResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SetNetworkBlacklistResponseBody(name='body'),
}

/**
  * @description - This operation requires image version 26.01 or later.
  * - This API call synchronously updates the IP address blacklist and the domain name blacklist.
  * - The IP address blacklist supports individual IP addresses and IP address segments. The update overwrites the existing configuration. If you pass an empty string (""), all configured IP blacklist entries are purged.
  * - The domain name blacklist supports only exact matches and does not support regular expressions. If you pass an empty string (""), all configured domain name blacklist entries are purged.
  * - After you change the configuration, restart the cloud phone to apply the new blacklist rules. Note that these rules may not take effect if you use an agent.
  * @param request  the request parameters of SetNetworkBlacklist  SetNetworkBlacklistRequest
  * @return SetNetworkBlacklistResponse
 */
async function setNetworkBlacklist(request: SetNetworkBlacklistRequest): SetNetworkBlacklistResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'SetNetworkBlacklist', 'POST', '/instances/{instanceId}', 'json', false, 'json', request);
}

