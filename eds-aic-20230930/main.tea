model BatchGetAcpConnectionTicketRequest {
  connectionMode?: string(name='ConnectionMode', description='The connection mode.', example='custom'),
  endUserId?: string(name='EndUserId', description='The ID of the assigned user. If you do not specify this parameter, the system user assigned in the background is used to obtain the ticket.

<props="china">
The usage of this parameter varies based on the Cloud Phone edition and the instance streaming mode:

- Cloud Phone Instance Edition or Cloud Phone Matrix Edition (preemptive mode): You can obtain a `Ticket` only by using the same `EnduserId`.
- Cloud Phone Matrix Edition (collaborative mode): You can pass different `EnduserId` values to obtain `Ticket` values and stream for different users (up to 5) at the same time. You can pass only one `EnduserId` at a time.

> You can define the instance streaming mode by using the `StreamMode` parameter of the `ModifyCloudPhoneNode` operation.', example='user'),
  instanceGroupId?: string(name='InstanceGroupId', description='The instance group ID.', example='ag-25nt4kk9whjh****'),
  instanceIds?: [ string ](name='InstanceIds', description='The list of Cloud Phone instance IDs. You can specify 1 to 100 IDs.'),
