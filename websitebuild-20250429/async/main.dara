/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'WebsiteBuild';
  @version = '2025-04-29';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-zhangjiakou' = 'websitebuild.aliyuncs.com',
    'ap-southeast-1' = 'websitebuild-intl.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model AppAiStaff {
  staffId?: string(name='StaffId', description='The employee ID.', example='370196'),
  staffName?: string(name='StaffName', description='The employee name.'),
  staffType?: string(name='StaffType', description='The employee type.'),
  status?: string(name='Status', description='Valid values: unknown, init, testing, and online.', example='online'),
}

model AppInstance {
  appSubType?: string(name='AppSubType'),
  appType?: string(name='AppType'),
  bizId?: string(name='BizId'),
  buildType?: string(name='BuildType'),
  deleted?: int32(name='Deleted'),
  description?: string(name='Description'),
  designSpecBizId?: string(name='DesignSpecBizId'),
  designSpecId?: string(name='DesignSpecId'),
  domain?: string(name='Domain'),
  endTime?: string(name='EndTime'),
  espBizId?: string(name='EspBizId'),
  gmtCreate?: string(name='GmtCreate'),
  gmtDelete?: string(name='GmtDelete'),
  gmtModified?: string(name='GmtModified'),
  gmtPublish?: string(name='GmtPublish'),
  iconUrl?: string(name='IconUrl'),
  name?: string(name='Name'),
  profile?: AppInstanceProfile(name='Profile'),
  siteHost?: string(name='SiteHost'),
  slug?: string(name='Slug'),
  sourceType?: string(name='SourceType'),
  startTime?: string(name='StartTime'),
  status?: string(name='Status', description='trial,draft,live,refunded,expired,released'),
  statusText?: string(name='StatusText'),
  thumbnailUrl?: string(name='ThumbnailUrl'),
  userId?: string(name='UserId'),
}

model AppInstanceAggregate {
  aiStaffList?: [
    AppAiStaff
  ](name='AiStaffList', description='The list of AI agents associated with the application.'),
  appOperationAddress?: AppOperationAddress(name='AppOperationAddress', description='The operation address of the application.'),
  appServiceList?: [
    AppServiceAggregate
  ](name='AppServiceList', description='The list of service instances associated with the application.'),
  appSubType?: string(name='AppSubType', description='The application subtype.', example='SEO_CONTENT'),
  appType?: string(name='AppType', description='The application type.', example='WEBSITE'),
  bizId?: string(name='BizId', description='The business ID of the application instance.', example='WS20250915163734000001'),
  buildType?: string(name='BuildType', description='The build type.', example='CLOUD_DREAM_SAAS'),
  createTime?: string(name='CreateTime', description='The creation time.', example='2025-01-01 00:00:00'),
  deleted?: int32(name='Deleted', description='Indicates whether the instance is deleted.', example='0'),
  description?: string(name='Description', description='The application description.', example='base'),
  designSpecBizId?: string(name='DesignSpecBizId', description='The business ID of the design specification.', example='WS20250801151731000007'),
  designSpecId?: string(name='DesignSpecId', description='The design specification ID.'),
  domain?: string(name='Domain', description='The primary domain name.', example='stxycw.com'),
  endTime?: string(name='EndTime', description='The end time.', example='2026-01-05T15:59:00Z'),
  espBizId?: string(name='EspBizId', description='The ID of the associated delivery order.', example='p20202933455'),
  gmtDelete?: string(name='GmtDelete', description='The deletion time.', example='2025-01-01 00:00:00'),
  gmtModified?: string(name='GmtModified', description='The update time.', example='2025-08-28T02:25:41Z'),
  gmtPublish?: string(name='GmtPublish', description='The publication time.', example='2025-01-01 00:00:00'),
  iconUrl?: string(name='IconUrl', description='The URL of the application icon.', example='icon/WS20250626112715000001/thumbnail.jpg'),
  name?: string(name='Name', description='The application name.', example='docs'),
  partnerDetail?: {
    bindData?: {
      bizId?: string(name='BizId', description='The external business ID.', example='WS20250801153127000002'),
      gmtCreate?: string(name='GmtCreate', description='The creation time.', example='1672123722000'),
      gmtModified?: string(name='GmtModified', description='The update time.', example='Wed Nov 26 10:15:28 CST 2025'),
      id?: string(name='Id', description='The record ID.'),
      mobile?: string(name='Mobile', description='The mobile phone number.', example='***********'),
      parentPk?: string(name='ParentPk', description='The primary key of the parent record.', example='1123213'),
      partnerId?: string(name='PartnerId', description='The partner ID.', example='10001'),
      userId?: string(name='UserId', description='The Alibaba Cloud account ID of the bound user.', example='123456789'),
    }(name='BindData', description='data'),
    partnerId?: string(name='PartnerId', description='The partner ID.', example='10001'),
    status?: string(name='Status', description='The partner binding status. Valid values: BOUND (bound) and UNBOUND (unbound).', example='BOUND'),
  }(name='PartnerDetail', description='The partner details.'),
  profile?: AppInstanceProfile(name='Profile', description='The configuration and runtime information of the application instance.'),
  resourceGroupId?: string(name='ResourceGroupId', description='The ID of the enterprise resource group to which the instance belongs.', example='rg-aek2smovqqpvuly'),
  siteHost?: string(name='SiteHost', description='The website domain name.', example='abcd.scd.wanwang.xin'),
  slug?: string(name='Slug', description='The application identifier.', example='31104757'),
  sourceType?: string(name='SourceType', description='The source type.', example='MARKET_CLOUD_DREAM'),
  startTime?: string(name='StartTime', description='The start time.', example='2023-03-24T10:10Z'),
  status?: string(name='Status', description='trial,draft,live,refunded,expired,released', example='live'),
  statusText?: string(name='StatusText', description='The status text.', example='Published'),
  tags?: [ 
    {
      tagKey?: string(name='TagKey', description='The tag key of the instance. Valid values of N: **1** to **20**. If you specify this parameter, it cannot be an empty string.

The tag key can be up to 64 characters in length. It cannot start with `aliyun` or `acs:`, and cannot contain `http://` or `https://`.', example='Group'),
      tagValue?: string(name='TagValue', description='The tag value of the instance. Valid values of N: **1** to **20**. If you specify this parameter, it can be an empty string.

The tag value can be up to 128 characters in length. It cannot start with `aliyun` or `acs:`, and cannot contain `http://` or `https://`.', example='ufo'),
    }
  ](name='Tags', description='The tags.'),
  templateRecord?: TemplateRecord(name='TemplateRecord', description='The application template record information.'),
  thumbnailUrl?: string(name='ThumbnailUrl', description='The URL of the application thumbnail.', example='thumbnails/WS20250626112715000001/thumbnail.jpg'),
  userId?: string(name='UserId', description='The user ID.', example='123241414'),
  version?: string(name='Version', description='The version.', example='2019-04-02'),
}

model AppInstanceProfile {
  applicationType?: string(name='ApplicationType', description='The application type code. For example, PC_WebSite indicates a PC website.', example='PC_WebSite'),
  applicationTypeText?: string(name='ApplicationTypeText', description='The display name of the application type.', example='PC Website'),
  bizId?: string(name='BizId', description='The business identifier of the application instance.', example='WS_SITE_1'),
  caseAuditStatus?: string(name='CaseAuditStatus', description='The audit status.', example='1'),
  caseShelfStatus?: string(name='CaseShelfStatus', description='The listing status.', example='online'),
  chatbiTaskId?: string(name='ChatbiTaskId', description='The ID of the ChatBI BuildSchemaIndex asynchronous task.', example='task-1'),
  chatbiTaskStatus?: string(name='ChatbiTaskStatus', description='The status of the ChatBI BuildSchemaIndex task. Valid values: running, finish, and failed.', example='finish'),
  commodityCode?: string(name='CommodityCode', description='The commodity code used when placing the order.', example='domain_website_public_cn'),
  customerService?: string(name='CustomerService', description='The customer service contact information or description.', example='support@example.com'),
  deployArea?: string(name='DeployArea', description='The deployment region code of the application.', example='HongKong'),
  icpbaNo?: string(name='IcpbaNo', description='The ICP filing number bound to the custom domain name. Multiple filing numbers are separated by commas (,).', example='京ICP备12345678号-1'),
  independentDeployment?: {
    canRetry?: boolean(name='CanRetry', description='Specifies whether a retry is allowed after the dedicated server fails to start.'),
    deployArea?: string(name='DeployArea', description='The deployment region code of the dedicated server.', example='HongKong'),
    dnsRecordType?: string(name='DnsRecordType', description='The DNS record type used when binding a domain name to the dedicated IP address.', example='A'),
    eligibility?: string(name='Eligibility', description='The eligibility status of the dedicated server. Valid values:
- UPGRADE_REQUIRED: A version upgrade is required.
- AVAILABLE: The dedicated server can be started.
- UNAVAILABLE: The dedicated server is currently unavailable.', example='AVAILABLE'),
    enableStatus?: string(name='EnableStatus', description='The status of the dedicated server. Valid values:
- NOT_ENABLED: Not started.
- ENABLING: Starting.
- ACTIVE: Started.
- FAILED: Failed to start.', example='ACTIVE'),
    independentIp?: string(name='IndependentIp', description='The dedicated IP address assigned after the dedicated server is started.', example='203.0.113.10'),
    serverSpec?: string(name='ServerSpec', description='The display specification of the dedicated server. This does not represent the real-time resource usage of the container.', example='2 vCPUs 2 GB'),
    taskId?: long(name='TaskId', description='The task ID for starting the dedicated server.', example='17'),
  }(name='IndependentDeployment', description='The dedicated server information. This field is computed in real time by DescribeAppInstance and is not populated in list API responses.'),
  instanceId?: string(name='InstanceId', description='The ID of the associated Lingxiao instance.', example='lx-1'),
  openChatBi?: boolean(name='OpenChatBi', description='Indicates whether the current user is included in the ChatBI feature canary release whitelist.'),
  ordTime?: string(name='OrdTime', description='The time when the order was placed, in the yyyy-MM-dd HH:mm:ss format.', example='2026-09-17 10:30:00'),
  orderId?: string(name='OrderId', description='The order ID.', example='order-1'),
  payTime?: string(name='PayTime', description='The time when the payment was made, in the yyyy-MM-dd HH:mm:ss format.', example='2026-09-17 10:35:00'),
  previewUrl?: string(name='PreviewUrl', description='The URL used to access the application preview page.', example='https://example.com/preview'),
  seoSite?: string(name='SeoSite', description='The SEO site configuration identifier.', example='seo-site-1'),
  shareRenderWatermark?: string(name='ShareRenderWatermark', description='The switch for the share rendering watermark. A value of 1 indicates enabled, and a value of 0 indicates disabled. This field is empty if not configured.', example='1'),
  siteVersion?: string(name='SiteVersion', description='The site version code.', example='Max_Edition'),
  siteVersionText?: string(name='SiteVersionText', description='The display name of the site version, including the deployment region.', example='Flagship Edition [Hong Kong]'),
  source?: string(name='Source', description='The identifier of the creation or synchronization source.', example='MARKET_CLOUD_DREAM'),
  templateEtag?: string(name='TemplateEtag', description='The ETag identifier of the current application template.', example='etag-1'),
  templateId?: string(name='TemplateId', description='The template ID used by the current application.', example='tpl-1'),
}

