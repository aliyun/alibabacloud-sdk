model AppMaterialTask {
  bizGroupId?: string(name='BizGroupId', description='The business group ID.', example='111'),
  completeTime?: string(name='CompleteTime', description='The task completion time.', example='2025-12-26 11:30:05'),
  completeTimeFormat?: string(name='CompleteTimeFormat', description='The display format of the completion time.', example='1 minute ago'),
  failReason?: string(name='FailReason', description='The failure reason.', example='Invalid parameters'),
  finalFileUrls?: [ string ](name='FinalFileUrls', description='The list of final files.'),
