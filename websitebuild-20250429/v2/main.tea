model BrandKnowledgeDocument {
  contentSufficient?: boolean(name='ContentSufficient', description='Specifies whether the content is sufficient to be considered for plan summary candidates.'),
  contentType?: string(name='ContentType', description='The MIME type of the file.', example='application/pdf'),
  createdAt?: long(name='CreatedAt', description='The creation time in Unix milliseconds.', example='1735660800000'),
  deletable?: boolean(name='Deletable', description='Specifies whether deletion is currently allowed.'),
  displayTitle?: string(name='DisplayTitle', description='The display title.', example='Wanxiaozhi product introduction'),
  docCategory?: string(name='DocCategory', description='The document category.', example='PRODUCT'),
  documentId?: string(name='DocumentId', description='The ID of the brand knowledge document.', example='bkd_3f7a1c2e9b7d4a5f8c0e1d2b3a4c5d6e'),
  errorCode?: string(name='ErrorCode', description='The stable error code for main processing failures.', example='BRAND_KNOWLEDGE_PARSE_FAILED'),
  errorMessage?: string(name='ErrorMessage', description='The desensitized error message for main processing failures.', example='Document parsing failed. Please re-upload'),
  fileSize?: long(name='FileSize', description='The file size in bytes.', example='1048576'),
  keyTopics?: [ string ](name='KeyTopics', description='The summary keywords.'),
  oneLineSummary?: string(name='OneLineSummary', description='The one-line summary, which is used only to construct search queries and cannot be used as factual evidence.', example='Introduces the product positioning and core capabilities of the Wanxiaozhi AI website building platform. It can be used as a reference for content topic selection'),
  originalName?: string(name='OriginalName', description='The original file name.', example='Wanxiaozhi product introduction.pdf'),
  projectId?: string(name='ProjectId', description='The ID of the business workspace. For GEO business workspaces of the brand marketing type, this is the appWorkspaceId.', example='d4e5f60718293a4b5c6d7e8f90a1b2c3'),
  readyAt?: long(name='ReadyAt', description='The time when the document is ready for reference, in Unix milliseconds.', example='1735660900000'),
  status?: string(name='Status', description='The document processing status.', example='READY'),
  statusMessage?: string(name='StatusMessage', description='The message displayed on the status page.', example='Parsing completed and available for content plans'),
  summaryErrorCode?: string(name='SummaryErrorCode', description='The stable error code for summary failures.', example='BRAND_KNOWLEDGE_SUMMARY_TIMEOUT'),
  summaryStatus?: string(name='SummaryStatus', description='The summary status.', example='SUCCEEDED'),
  updatedAt?: long(name='UpdatedAt', description='The last update time in Unix milliseconds.', example='1735660900000'),
}

model ContentPlan {
  additionalRequirements?: string(name='AdditionalRequirements', description='The additional user comments.', example='Highlight the differentiated capabilities of the product and avoid exaggerated claims'),
  analysisTaskId?: string(name='AnalysisTaskId', description='The ID of the analysis task used for scheduling.', example='cpt_1a2b3c4d5e6f708192a3b4c5d6e7f809'),
  configRevision?: long(name='ConfigRevision', description='The current configuration version of the workspace when the analysis is initiated.', example='12'),
  diagnosisCompletedAt?: long(name='DiagnosisCompletedAt', description='The completion time of the GEO diagnosis, in milliseconds.', example='1735660800000'),
  diagnosisTaskId?: string(name='DiagnosisTaskId', description='The ID of the GEO diagnostic node.', example='1f2e3d4c-5b6a-4798-8a9b-c0d1e2f3a4b5'),
  diagnosisType?: string(name='DiagnosisType', description='The type of the GEO diagnosis.', example='GEO_BRAND'),
  endDate?: string(name='EndDate', description='The end date of the plan in the yyyy-MM-dd format.', example='2026-10-18'),
  generationTaskId?: string(name='GenerationTaskId', description='The ID of the generation task.', example='cpt_9b7d4a5f8c0e1d2b3a4c5d6e3f7a1c2e'),
  planId?: string(name='PlanId', description='The ID of the content plan.', example='plan_3f7a1c2e9b7d4a5f8c0e1d2b3a4c5d6e'),
  projectId?: string(name='ProjectId', description='The ID of the workspace, which is the GEO workspace for brand marketing and corresponds to the appWorkspaceId.', example='d4e5f60718293a4b5c6d7e8f90a1b2c3'),
  publishFrequency?: int32(name='PublishFrequency', description='The number of scheduled articles, which equals the number of matched generation days.', example='3'),
  reportConfigRevision?: long(name='ReportConfigRevision', description='The workspace configuration version used for the diagnostic report, which is strictly read during article generation.', example='12'),
  startDate?: string(name='StartDate', description='The start date of the plan in the yyyy-MM-dd format.', example='2026-10-12'),
  status?: string(name='Status', description='The status of the plan. Valid values: ACTIVE, SUPERSEDED, COMPLETED, and FAILED.', example='ACTIVE'),
  summary?: string(name='Summary', description='The summary of the overall strategy for the plan.', example='This week focuses on two themes: brand awareness and product capabilities, with a total of three articles'),
  supersededBy?: string(name='SupersededBy', description='The ID of the new plan that supersedes the current plan.', example='plan_7a1c2e9b7d4a5f8c0e1d2b3a4c5d6e3f'),
