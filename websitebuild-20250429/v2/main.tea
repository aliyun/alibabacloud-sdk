/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-zhangjiakou' = 'websitebuild.aliyuncs.com',
    'ap-southeast-1' = 'websitebuild-intl.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('websitebuild', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AppAiStaff {
  staffId?: string(name='StaffId', description='The employee ID.', example='370196'),
  staffName?: string(name='StaffName', description='The employee name.'),
  staffType?: string(name='StaffType', description='The employee type.'),
  status?: string(name='Status', description='Valid values: unknown, init, testing, and online.', example='online'),
}

model AppInstance {
  appSubType?: string(name='AppSubType'),
  appType?: string(name='AppType'),
  bizId?: string(name='BizId'),
  buildType?: string(name='BuildType'),
  deleted?: int32(name='Deleted'),
  description?: string(name='Description'),
  designSpecBizId?: string(name='DesignSpecBizId'),
  designSpecId?: string(name='DesignSpecId'),
  domain?: string(name='Domain'),
  endTime?: string(name='EndTime'),
  espBizId?: string(name='EspBizId'),
  gmtCreate?: string(name='GmtCreate'),
  gmtDelete?: string(name='GmtDelete'),
  gmtModified?: string(name='GmtModified'),
  gmtPublish?: string(name='GmtPublish'),
  iconUrl?: string(name='IconUrl'),
  name?: string(name='Name'),
  profile?: AppInstanceProfile(name='Profile'),
  siteHost?: string(name='SiteHost'),
  slug?: string(name='Slug'),
  sourceType?: string(name='SourceType'),
  startTime?: string(name='StartTime'),
  status?: string(name='Status', description='trial,draft,live,refunded,expired,released'),
  statusText?: string(name='StatusText'),
  thumbnailUrl?: string(name='ThumbnailUrl'),
  userId?: string(name='UserId'),
}

model AppInstanceAggregate {
