    'cn-hangzhou-internal-test-1' = 'live.aliyuncs.com',
    'cn-hangzhou-internal-test-2' = 'live.aliyuncs.com',
    'cn-hangzhou-internal-test-3' = 'live.aliyuncs.com',
    'cn-hangzhou-test-306' = 'live.aliyuncs.com',
