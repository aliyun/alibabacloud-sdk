  componentName?: string(name='ComponentName', description='The name of the component. The default value is the component ID.', example='text01'),
  componentType?: string(name='ComponentType', description='The type of the component. Valid values:

- **text**: A text component. The TextLayerContent parameter is required only if you set ComponentType to text.

- **image**: An image component. The ImageLayerContent parameter is required only if you set ComponentType to image.

- **caption**: A translation caption component. The CaptionLayerContent parameter is required only if you set ComponentType to caption.', example='text'),
  effect?: string(name='Effect', description='The display effect of the component. Valid values:

- **none** (default): no effect.

- **animateH**: horizontal scroll.

- **animateV**: vertical scroll.', example='animateV'),
  imageLayerContent?: string(name='ImageLayerContent', description='The properties of the image layer. The value is a JSON string.

>Notice: 

