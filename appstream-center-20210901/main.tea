model DescribeExportTasksRequest {
  pageNumber?: int32(name='PageNumber', description='The page number for a paged query. Pages start from 1. If this parameter is not specified or is set to a value less than 1, the first page is returned. The query results are sorted in descending order of task creation time, with the most recently created tasks listed first. When polling a single task by TaskId, explicitly set this parameter to 1.', example='1'),
  pageSize?: int32(name='PageSize', description='The number of tasks to return per page. If this parameter is not specified, the default value 200 is used. If a value less than 1 is specified, 10 is used. When polling a single task by TaskId, set this parameter to 1 to avoid returning redundant tasks.', example='10'),
  taskId?: string(name='TaskId', description='Filters tasks by export task ID. The value is the TaskId returned by CreateExportTask, which is a 32-character UUID string without hyphens. This parameter requires an exact match and does not support fuzzy queries. If this parameter is not specified, all tasks under the current account that meet other conditions are returned.', example='8119078c29e948dba2e0a9917995332a'),
  taskType?: string(name='TaskType', description='Filters tasks by export task type. The value is case-sensitive and must be one of the following enumerated values:
- WUYING_SERVER_LIST: Wuying host list.
- USER_USAGE_REPORT: User usage report.
- BROWSER_BOOKMARK_LIST: Cloud browser bookmark list.
- BROWSER_RESTRICTED_URL_LIST: Cloud browser URL whitelist.

If this parameter is not specified, tasks are not filtered by type, and all tasks under the current account that meet other conditions are returned. If an unrecognized value is specified, the server does not return a parameter error but cancels type filtering. Therefore, you must specify one of the exact enumerated values above. When querying a single task by TaskId, omit this parameter.', example='WUYING_SERVER_LIST'),
}

