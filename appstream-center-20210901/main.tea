  autoRenew?: boolean(name='AutoRenew', description='Specifies whether to enable auto-renewal.', example='false'),
  bandwidth?: int32(name='Bandwidth', description='The bandwidth value. This parameter takes effect only when NetworkStrategyType is set to DirectIp. Unit: Mbit/s. Valid values: 2 to 100.', example='10'),
  bizRegionId?: string(name='BizRegionId', description='The region.', example='cn-hangzhou'),
  chargeType?: string(name='ChargeType', description='The billing method.', example='PrePaid'),
  dataDisk?: [ 
    {
      dataDiskCategory?: string(name='DataDiskCategory', description='The category of the data cloud disk.', example='cloud_auto'),
      dataDiskPerformanceLevel?: string(name='DataDiskPerformanceLevel', description='The performance level of the data cloud disk.', example='PL0'),
      dataDiskSize?: int32(name='DataDiskSize', description='The size of the data cloud disk.', example='100'),
    }
  ](name='DataDisk', description='The list of data cloud disks.'),
  erdmaEnabled?: boolean(name='ErdmaEnabled', description='Specifies whether to enable dedicated eRDMA network interfaces.', example='true'),
  gpuDriverVersion?: string(name='GpuDriverVersion', description='The version of the GPU driver, such as grid19.', example='grid19'),
  hostName?: string(name='HostName', description='The hostname. The hostname must meet the following requirements:

- The hostname cannot start or end with a period (.) or a hyphen (-). The hostname cannot contain consecutive periods (.) or hyphens (-).

- For a Windows workstation: The hostname must be 2 to 15 characters in length. It cannot contain periods (.) or consecutive hyphens (-), and cannot contain only digits. It can contain uppercase and lowercase letters, digits, and hyphens (-).

- For a Linux workstation:

  - The hostname must be 2 to 64 characters in length. It can contain multiple periods (.). The string between two consecutive periods is a segment. Each segment can contain uppercase and lowercase letters, digits, and hyphens (-).

  - You can use the `${instance_id}` placeholder to pass the instance ID to the HostName parameter. For example, if you set HostName to `k8s-${instance_id}` and the created ECS instance ID is `i-123abc****`, the hostname of the instance is `k8s-i-123abc****`.

- When you create multiple workstations at a time, you can use the `name_prefix[begin_number,bits]name_suffix` naming format to name the workstations in a unified manner. For example, if you set HostName to `ecd-[1,4]-test`, the hostname of the first workstation is `ecd-0001-test`, the hostname of the second workstation is `ecd-0002-test`, and so on.

  - `name_prefix`: the prefix of the hostname.

  - `[begin_number,bits]`: the sequential number in the hostname.

    - `begin_number`: the start number. Valid values: 0 to 999999. Default value: 0. If the specified value is invalid, the default value 0 is used.

    - `bits`: the number of digits. Valid values: 1 to 6. Default value: 6. If the specified value is invalid, the default value 6 is used.

  - `name_suffix`: the suffix of the hostname.', example='testhost'),
  idempotenceToken?: string(name='IdempotenceToken', description='The idempotence token that is used to ensure the uniqueness of the operation.', example='6a1b8c3d'),
  imageId?: string(name='ImageId', description='The image ID.', example='img-bp13mu****'),
