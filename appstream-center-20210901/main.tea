  imageId?: string(name='ImageId', description='The image ID.', example='img-bp13mu****'),
  maxPrice?: float(name='MaxPrice', description='The maximum price.', example='0.05'),
  networkStrategyType?: string(name='NetworkStrategyType', description='The network policy type (invite-only preview).', example='DirectIp'),
  officeSiteId?: string(name='OfficeSiteId', description='The office network ID.', example='cn-hangzhou+dir-643067****'),
  password?: string(name='Password', description='The workstation logon password.', example='YourPassword123'),
  period?: int32(name='Period', description='The subscription duration.', example='1'),
  periodUnit?: string(name='PeriodUnit', description='The time unit.', example='Month'),
  promotionId?: string(name='PromotionId', description='The discount ID.


> If PromotionId is specified, the corresponding discount is applied.', example='17440009****'),
  savingPlanId?: string(name='SavingPlanId', description='The savings plan ID.', example='spn-ce3f5b4fk**46CY'),
