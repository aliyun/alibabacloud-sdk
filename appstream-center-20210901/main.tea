  bandwidth?: int32(name='Bandwidth', description='The bandwidth value. This parameter takes effect only when NetworkStrategyType is set to DirectIp. Unit: Mbit/s. Valid values: 2 to 100.', example='10'),
  bizRegionId?: string(name='BizRegionId', description='The region ID.', example='cn-hangzhou'),
