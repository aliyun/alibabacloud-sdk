  count?: int32(name='Count', description='The total number of tasks that meet the query conditions. This value is independent of the number of tasks returned on the current page and can be used with PageSize to calculate the total number of pages. If no tasks meet the conditions, 0 is returned.', example='1'),
  exportTaskModel?: [ 
    {
      createTime?: string(name='CreateTime', description='The task creation time, in yyyy-MM-dd HH:mm:ss format, accurate to seconds. The returned string does not include the time zone offset.', example='2026-07-27 19:00:00'),
      downloadUrl?: string(name='DownloadUrl', description='The OSS pre-signed download URL of the export file. This field is returned only for tasks whose Status is FINISHED. The default maximum validity period of the signature is 1 hour and does not exceed the 24-hour validity period after the task is created. When the remaining validity period is less than 10 minutes, the server automatically refreshes and returns a new URL. If the task is not completed, the task has expired, or the URL refresh fails, this field is empty. The domain name and path in the example URL are for illustration purposes only. The actual returned value is a complete URL with signature parameters. Use the URL returned by the most recent query for downloading.', example='https://example.oss-cn-hangzhou.aliyuncs.com/...'),
      errorMsg?: string(name='ErrorMsg', description='The cause of the task execution failure. This field is returned only when Status is FAILED. The content is the English error description recorded by the server and can be directly displayed to users or used for troubleshooting. In other states, this field is empty.', example='The export sub type is not supported.'),
      exportFileName?: string(name='ExportFileName', description='The export file name, which consists of the task type, task creation time (in yyyyMMddHHmmss format), and the first 8 characters of the task ID, connected by underscores. The file extension is .xlsx. If the file is not generated, this field is empty.', example='WUYING_SERVER_LIST_20260727190000_8119078c.xlsx'),
      progress?: float(name='Progress', description='The export task progress, in percentage. Valid values: 0 to 100. This value is updated based on the execution stage of the task and is 100 when the task is completed.', example='100'),
      status?: string(name='Status', description='The export task status. This operation returns the following values:
- INIT: The task is created and waiting to be executed. Continue polling.
- RUNNING: The export file is being generated. You can display the progress based on Progress and continue polling.
- FINISHED: The export file is generated. Stop polling and use DownloadUrl to download the file.
- FAILED: The task execution failed. Stop polling and check ErrorMsg.

The server also has an internal EXPIRED state, but this operation does not return tasks in this state.', example='FINISHED'),
      taskId?: string(name='TaskId', description='The export task ID, which is a 32-character UUID string without hyphens. You can use this value as the TaskId parameter of this operation to poll the task.', example='8119078c29e948dba2e0a9917995332a'),
      taskType?: string(name='TaskType', description='The export task type. For the meaning of each value, see the TaskType request parameter.', example='WUYING_SERVER_LIST'),
