model TagResourcesRequest {
  regionId?: string(name='RegionId', description='The region ID. This parameter is required. Specify the ID of the region where the app instance group resides, such as `cn-hangzhou`.

This parameter is required.', example='cn-hangzhou'),
  resourceId?: [ string ](name='ResourceId', description='The list of resource IDs to which you want to bind tags. This parameter is required. Specify the app instance group IDs. You can specify up to 50 IDs in a single request. Duplicate IDs are automatically deduplicated.

**All IDs must belong to existing app instance groups under the current Alibaba Cloud account.** If any ID does not exist or does not belong to the current account, the entire request fails and the error code `InvalidAppInstanceGroup.NotFound` is returned. No tags are bound to any resources.

This parameter is required.'),
