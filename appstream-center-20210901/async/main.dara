  exportTaskModel?: {
    createTime?: string(name='CreateTime', description='The time when the task was created. The time is in the yyyy-MM-dd HH:mm:ss format, accurate to seconds. The returned string does not contain a time zone offset.', example='2026-07-27 19:00:00'),
    downloadUrl?: string(name='DownloadUrl', description='The download URL of the exported file. When the task is created by calling this operation, the file is not generated and this field is empty. The null in the example represents a JSON null value, not the string "null". You can subsequently call DescribeExportTasks to query the latest download URL of the completed task and use it within the validity period.', example='null'),
    errorMsg?: string(name='ErrorMsg', description='The error message when the task execution fails. If the task is created by calling this operation, this field is empty. The null in the example represents a JSON null value, not the string "null". When you query the task status and the status is FAILED, you can use this field to identify the cause of the failure.', example='null'),
    progress?: float(name='Progress', description='The progress of the export task, in percentage. Valid values: 0 to 100. If the task is created by calling this operation, 0 is returned. The value is updated based on the execution phase and reaches 100 when the task is completed.', example='0'),
    status?: string(name='Status', description='The status of the task. If the task is created by calling this operation, INIT (initialized and waiting for execution) is returned. You can subsequently call DescribeExportTasks to query RUNNING (executing), FINISHED (completed), or FAILED (failed). Do not treat INIT as export completion.', example='INIT'),
    taskId?: string(name='TaskId', description='The ID of the newly created export task, which is a 32-character UUID string without hyphens. You can use this value as the TaskId parameter in DescribeExportTasks to query the task.', example='8119078c29e948dba2e0a9917995332a'),
    taskType?: string(name='TaskType', description='The type of the export task, which is the same as the TaskType in the request. For the meaning of each type, see the TaskType request parameter.', example='WUYING_SERVER_LIST'),
  }(name='ExportTaskModel', description='The information about the newly created export task. If the task is created, Status is INIT, Progress is 0, and the download URL and error message are empty.'),
  requestId?: string(name='RequestId', description='The ID of the request, which is used to locate call records and troubleshoot issues. The example value is partially desensitized.', example='7D30C5D6-****'),
}

model CreateExportTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateExportTaskResponseBody(name='body'),
}

/**
  * @description Creates an export task and returns the task ID and initial status. The exported file is not returned synchronously.
  * After the task is created, save the TaskId and call DescribeExportTasks to query the task status and progress. We recommend a polling interval of 5 to 10 seconds. If the status is FINISHED, use the DownloadUrl in the latest query result to download the XLSX file. If the status is FAILED, check the ErrorMsg and stop polling.
  * The task is valid for 24 hours after creation. The download URL has an independent signature validity period of up to 1 hour, which does not exceed the remaining validity period of the task. Query the latest URL before downloading. You cannot obtain a valid download URL after the task expires.
  * The WUYING server list export only accepts the filter fields listed in QueryParamJson. Pagination is controlled by the server, and a single task can export up to 100,000 records. The cloud browser bookmarks and URL whitelist exports retrieve the complete list of the target delivery group, which is not affected by the list search terms or the current page. The ownership and product type of the delivery group are verified before execution. Data is read in pages during execution, and no consistent snapshot is provided. A successful creation does not guarantee that subsequent verification, query, or file generation will succeed.
  * @param request  the request parameters of CreateExportTask  CreateExportTaskRequest
  * @return CreateExportTaskResponse
 */
async function createExportTask(request: CreateExportTaskRequest): CreateExportTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateExportTask', 'POST', '/', 'json', true, 'form', request);
}

