model UntagResourcesRequest {
  all?: boolean(name='All', description='Specifies whether to remove all custom tags from the resources. **This parameter takes effect only when `TagKey.N` is not specified**. If `TagKey.N` is specified, this parameter is ignored. Valid values:

- `true`: removes all custom tags from the resources, including Wuying system tags that start with `System/` and were bound by calling the [TagResources](~~TagResources~~) operation.
- `false` (default): does not remove all tags. If `TagKey.N` is also not specified, the operation returns the error code `InvalidParameter.TagKeyListOrAll`.', example='false', position='Body'),
  regionId: string(name='RegionId', description='The region ID. This parameter is required. Specify the ID of the region where the app instance group resides, such as `cn-hangzhou`.

This parameter is required.', example='cn-hangzhou', position='Body'),
  resourceId: [ string ](name='ResourceId', description='The list of resource IDs from which you want to remove tags. This parameter is required. Specify the app instance group IDs. A maximum of 50 IDs can be specified in a single request. Duplicate IDs are automatically deduplicated.

**All IDs must belong to existing app instance groups within the current Alibaba Cloud account.** If any ID does not exist or does not belong to the current account, the entire request fails and the operation returns the error code `InvalidAppInstanceGroup.NotFound`. No resources are untagged.

This parameter is required.', position='Body'),
  resourceType: string(name='ResourceType', description='The resource type. This parameter is required. **Currently, only app instance groups are supported**. The value is case-insensitive. We recommend that you use uppercase letters:

- `APPINSTANCEGROUP`: Wuying app instance group.

If you specify other values, the operation returns the error code `InvalidResourceType.Invalid`.

This parameter is required.', example='APPINSTANCEGROUP', minLength=1, maxLength=64, position='Body'),
  tagKey?: [ string ](name='TagKey', description='The list of tag keys to be removed. A maximum of 20 tag keys can be specified in a single request. **You must specify at least one of `TagKey.N` and `All`**. If neither is specified, the operation returns the error code `InvalidParameter.TagKeyListOrAll`.

- If `TagKey.N` is specified, only the tags corresponding to these tag keys are removed, and the `All` parameter is ignored.
- If a specified tag key does not exist on a resource, the tag key is skipped and no error is returned.
- If `TagKey.N` is not specified, you must set `All` to `true` to remove all custom tags from the resources.

Tag keys that start with `System/` are Wuying system tags. Only the following values are supported:

- `System/Scheduler/GRAYSCALE`: The grayscale tag for the app instance group.
- `System/Scheduler/STOP_NEW_USER_CONNECTION`: Prevents newly bound users from establishing connections to the app instance group.

If you specify other tag keys that start with `System/`, the operation returns the error code `InvalidTagPolicy.KeyInvalid` or `InvalidTag.SystemKeyNotAllow`.', position='Body'),
}

model UntagResourcesResponseBody = {
  requestId?: string(name='RequestId', description='The request ID. You can use the ID to troubleshoot issues.', example='1CBAFFAB-B697-4049-A9B1-67E1FC5F****'),
}

model UntagResourcesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UntagResourcesResponseBody(name='body'),
}

/**
  * @description ## Prerequisites
  * To call this operation as a RAM user or by using STS credentials, you must have the `appstreaming:UntagResources` permission.
  * The resources to be untagged must belong to the current Alibaba Cloud account. **This operation currently supports only app instance group resources**. You must set `ResourceType` to `APPINSTANCEGROUP`. You can call the [ListAppInstanceGroup](~~ListAppInstanceGroup~~) operation to obtain the app instance group ID, and call the [ListTagResources](~~ListTagResources~~) operation to query the tags bound to the resources.
  * ## Metric description
  * - A single request can detach labels from up to **50 resources**. Duplicate resource IDs are automatically deduplicated.
  * - **You must specify at least one of `TagKey.N` and `All`**: If neither is specified, or if `TagKey.N` is not specified and `All` is set to `false`, the operation returns the error code `InvalidParameter.TagKeyListOrAll`.
  *   - If `TagKey.N` is specified: Only the labels corresponding to these label keys are detached. A maximum of 20 label keys can be specified in a single request. In this case, the `All` parameter is ignored.
  *   - If `TagKey.N` is not specified and `All` is set to `true`: All custom labels on the resources are detached, including Wuying system labels that start with `System/` and were attached by calling the [TagResources](~~TagResources~~) operation.
  * - If a specified label key does not exist on a resource, the label key is skipped and no fault is returned.
  * - Label keys that start with `System/` are Wuying system labels. Only `System/Scheduler/GRAYSCALE` and `System/Scheduler/STOP_NEW_USER_CONNECTION` are supported. If you specify other label keys that start with `System/`, the operation returns the error code `InvalidTagPolicy.KeyInvalid` or `InvalidTag.SystemKeyNotAllow`.
  * ## Execution results
  * - **If any specified app instance group does not exist or does not belong to the current account, the entire request fails**, and the operation returns the error code `InvalidAppInstanceGroup.NotFound`. No resources are untagged.
  * - If the untagging is successful, the response contains only `RequestId` and does not return tag details.
  * - If multiple resources are specified and the untagging fails for only some of the resources, the operation still returns a success response, and the response does not contain failure details. Call the [ListTagResources](~~ListTagResources~~) operation to verify the untagging results. If only one resource is specified and the untagging fails, the operation directly returns the corresponding error code.
  * ## Call sequence
  * 1. Call the [ListAppInstanceGroup](~~ListAppInstanceGroup~~) operation to obtain the app instance group ID. To confirm the tag keys bound to the resources, call the [ListTagResources](~~ListTagResources~~) operation.
  * 2. Call this operation, specify `ResourceType=APPINSTANCEGROUP` and `ResourceId.N`, and specify `TagKey.N` or set `All=true` to indicate the tags to be removed.
  * 3. To rebind tags, call the [TagResources](~~TagResources~~) operation.
  * The masked identifiers in the examples are used to demonstrate the format. Replace them with your actual identifiers when you call the operation.
  * @param request  the request parameters of UntagResources  UntagResourcesRequest
  * @return UntagResourcesResponse
 */
async function untagResources(request: UntagResourcesRequest): UntagResourcesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'UntagResources', 'POST', '/', 'json', true, 'form', request);
}

