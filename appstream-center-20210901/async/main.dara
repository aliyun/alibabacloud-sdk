  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateBrowserInstanceGroupResponseBody(name='body'),
}

/**
  * @description ## Before you begin
  * - Prepare available office networks, images, and specifications in the target business region, and ensure that your account has the corresponding browser configurations and resource quotas.
  * - Specify CloudBrowserName and BizRegionId. You must set OsType to Windows.
  * - The authorized users must be created in advance and match the account type. The authorized user groups must belong to the current account and match the account type of the office network.
  * - **Users and UserGroupIds cannot be specified at the same time.**
  * ## MAU billing parameters
  * - Set ChargeType to PostPaid.
  * - **You must explicitly set SubPayType to mau. Omitting this parameter does not enable MAU billing.**
  * - Set ChargeResourceMode to AppInstance.
  * - You do not need to specify Period, PeriodUnit, AppPackageType, AutoPay, AutoRenew, or NodePool.
  * ## Post-processing
  * **A successful API response does not indicate that the browser resources are ready.** After creation, query the status of the browser group and use it only after confirming that it is connectable.
  * This operation creates a new cloud browser group. You do not need to create a delivery group in advance.
  * ## Example descriptions
  * Field examples demonstrate how to specify parameters. Replace resource identifiers with actual values under your current account. Capacity examples do not represent default values or upper limits.
  * An example value of - indicates that the parameter is not required. When calling the API, omit the corresponding parameter instead of passing the - character.
  * @param request  the request parameters of CreateBrowserInstanceGroup  CreateBrowserInstanceGroupRequest
  * @return CreateBrowserInstanceGroupResponse
 */
async function createBrowserInstanceGroup(request: CreateBrowserInstanceGroupRequest): CreateBrowserInstanceGroupResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateBrowserInstanceGroup', 'POST', '/', 'json', true, 'form', request);
}

model CreateExportTaskRequest {
  exportFields?: [ string ](name='ExportFields', description='The list of field codes for the export columns. This parameter is optional and applies only to WUYING_SERVER_LIST. Do not pass this parameter for other task types. You can pass up to 100 elements. The codes are case-sensitive. Leading and trailing whitespace in fields is removed, and blank elements are ignored. Duplicate codes are retained in the order of their first appearance. WuyingServerId is always the first column, and the remaining columns are exported in the order of the request. If this parameter is not passed, only WuyingServerId is exported.

Supported codes: WuyingServerId, WuyingServerName, Status, BizRegionId, ZoneId, OfficeSiteId, ServerInstanceType, ServerInstanceTypeId, Cpu, Memory, Image, OsType, ImageId, SystemDisk, DataDisks, NetworkInterfaceIp, PrivateIpSets, SecurityGroupIds, Bandwidth, ChargeType, SubPayType, VirtualNodePool, CreateTime, ExpiredTime, and VirtualKubeletInfo.

In the original RPC request, pass the values sequentially by using ExportFields.1, ExportFields.2, and so on. For example, ExportFields.1=WuyingServerId and ExportFields.2=Status.', example='["WuyingServerId","Status"]', position='Body'),
  queryParamJson?: string(name='QueryParamJson', description='The JSON string serialized from the query condition object. This parameter is required and cannot be an empty string. Field names must use the following lower camel case format.

- WUYING_SERVER_LIST: If no filter condition is specified, pass the JSON string corresponding to {}. Only wuyingServerIdList, wuyingServerNameOrId, status, bizRegionId, zoneId, officeSiteId, serverInstanceType, imageId, chargeType, virtualNodePoolId, addVirtualNodePoolStatusList, users, networkInterfaceIp, createTimeStart, createTimeEnd, expiredTimeStart, and expiredTimeEnd are supported. The semantics of each field are the same as those in ListWuyingServer. Pagination or other unlisted fields cannot be passed. The values of wuyingServerIdList, addVirtualNodePoolStatusList, and users must be serialized into JSON array strings before the outer query object is serialized.
- BROWSER_BOOKMARK_LIST and BROWSER_RESTRICTED_URL_LIST: The object must and can only contain browserInstanceGroupId, and the value must be a non-empty cloud browser delivery group ID string. It cannot contain Keyword, pagination, or other fields.
- USER_USAGE_REPORT: Use productType, startDate, and endDate to specify the product type and query time range. You can use appInstanceGroupId, bizRegionId, userId, and connectionStatus for filtering. startDate and endDate must be in the yyyy-MM-dd HH:mm:ss format. Query parameters are parsed and verified during the asynchronous execution phase. A successful creation does not mean that all these query conditions have passed the verification.', example='{"bizRegionId":"cn-hangzhou","zoneId":"cn-hangzhou-h"}', position='Body'),
  taskType?: string(name='TaskType', description='The type of the export task. This parameter is required and case-sensitive. Valid values:
- WUYING_SERVER_LIST: WUYING server list.
- USER_USAGE_REPORT: user usage report.
- BROWSER_BOOKMARK_LIST: cloud browser bookmark list.
- BROWSER_RESTRICTED_URL_LIST: cloud browser URL whitelist.

Different task types use different QueryParamJson query conditions. Only WUYING_SERVER_LIST supports selecting export columns by using ExportFields.', example='WUYING_SERVER_LIST', position='Body'),
}

