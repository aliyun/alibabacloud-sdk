model GetAuthCodeRequest {
  regionId?: string(name='RegionId', position='Host'),
  appId?: string(name='AppId', description='The ID of the application to connect to. When specifying this parameter, you must also provide the matching AppVersionId. If omitted, the application configured in the creation or validation environment is used.', example='app-bp1example****', position='Body'),
