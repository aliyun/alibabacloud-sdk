model AuthorizeInstanceGroupRequest {
  appInstanceGroupId?: string(name='AppInstanceGroupId', description='The delivery group ID. You can call the [ListAppInstanceGroup](https://help.aliyun.com/document_detail/428506.html) operation to obtain the ID.', example='aig-9ciijz60n4xsv****', position='Body'),
  appInstanceGroupSetId?: string(name='AppInstanceGroupSetId', description='The delivery group set ID. You must specify either AppInstanceGroupSetId or AppInstanceGroupId, but not both.', example='set-3jm9d0abc00example', position='Body'),
  appInstancePersistentId?: string(name='AppInstancePersistentId', description='The persistent session ID.

> Metric description
> - This parameter is required when the authorization mode of the delivery group is Session. You can call the ListPersistentAppInstances operation to obtain a valid ID.
> - This parameter is required when ProductType is set to WuyingServer. You can call the ListPersistentAppInstances operation to obtain a valid ID.', example='p-0cc7s3mw2fg4j****', position='Body'),
  authorizeUserGroupIds?: [ string ](name='AuthorizeUserGroupIds', description='The list of authorized user group IDs to grant authorization.', position='Body'),
  authorizeUserIds?: [ string ](name='AuthorizeUserIds', description='The list of usernames to add to the delivery group authorization. You can specify 1 to 100 usernames.', position='Body'),
  avatarId?: string(name='AvatarId', description='The user avatar ID.

> This parameter is not available for public use.', example='default', position='Body'),
  productType: string(name='ProductType', description='The product type.

This parameter is required.', example='CloudApp', position='Body'),
  unAuthorizeUserGroupIds?: [ string ](name='UnAuthorizeUserGroupIds', description='The list of authorized user group IDs to revoke authorization.', position='Body'),
  unAuthorizeUserIds?: [ string ](name='UnAuthorizeUserIds', description='The list of usernames to remove from the delivery group authorization. You can specify 1 to 100 usernames.', position='Body'),
  userMeta?: {
    adDomain?: string(name='AdDomain', description='The AD domain name.', example='example.com'),
    type?: string(name='Type', description='The user type.', example='simple'),
  }(name='UserMeta', description='The user information.', shrink='json', position='Body'),
}

model AuthorizeInstanceGroupResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='1CBAFFAB-B697-4049-A9B1-67E1FC5F****'),
}

model AuthorizeInstanceGroupResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AuthorizeInstanceGroupResponseBody(name='body'),
}

/**
  * @description > After you change assigned users, the selected users receive notification emails. Changes typically take about 2 minutes to take effect on the client.
  * @param request  the request parameters of AuthorizeInstanceGroup  AuthorizeInstanceGroupRequest
  * @return AuthorizeInstanceGroupResponse
 */
async function authorizeInstanceGroup(request: AuthorizeInstanceGroupRequest): AuthorizeInstanceGroupResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AuthorizeInstanceGroup', 'POST', '/', 'json', true, 'form', request);
}

model AuthorizeUsersForAppRequest {
  appId: string(name='AppId', description='The ID of the application. The application must be deployed in the image used by the app instance group. You can obtain the application ID from the Apps list returned by the [GetAppInstanceGroup](https://help.aliyun.com/document_detail/600836.html) operation.

This parameter is required.', example='ca-i87mycyn419nu****', position='Query'),
  appInstanceGroupId: string(name='AppInstanceGroupId', description='The ID of the app instance group. You can call the [ListAppInstanceGroup](https://help.aliyun.com/document_detail/428506.html) operation to query the ID.

The application specified by AppId must be deployed in the image used by the app instance group.

This parameter is required.', example='aig-9ciijz60n4xsv****', position='Body'),
  authorizeUserIds?: [ string ](name='AuthorizeUserIds', description='The list of usernames of the users to be authorized for the application. You can specify up to 100 usernames in a single call.

You must specify at least one of AuthorizeUserIds and UnAuthorizeUserIds, or specify both. Adding authorization is subject to the authorized user quota limit of the application.', position='Body'),
  productType: string(name='ProductType', description='The product type. Application-level authorization applies to WUYING Cloud App app instance groups.

Valid values:

- CloudApp: WUYING Cloud App.

This parameter is required.', example='CloudApp', position='Body'),
  unAuthorizeUserIds?: [ string ](name='UnAuthorizeUserIds', description='The list of usernames of the users whose authorization for the application is to be removed. You can specify up to 100 usernames in a single call.

You must specify at least one of AuthorizeUserIds and UnAuthorizeUserIds, or specify both. Removing authorization is not subject to quota limits.', position='Body'),
  userMeta?: {
    adDomain?: string(name='AdDomain', description='The AD domain name. This parameter is required when Type is set to ad, and the value must be the same as the AD domain bound to the workspace to which the app instance group belongs.', example='example.com'),
    type?: string(name='Type', description='The account type. Default value: simple.

Valid values:

- ad: AD account.
- simple: WUYING convenience account.', example='simple'),
  }(name='UserMeta', description='The account information of the authorized user, which is used to specify the account type corresponding to the username.

- **Required** if the workspace to which the app instance group belongs is an AD workspace: Set Type to ad, and set AdDomain to the AD domain bound to the workspace.
- If this parameter is not specified, the default account type is WUYING convenience account (simple).', shrink='json', position='Body'),
}

model AuthorizeUsersForAppResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='1CBAFFAB-B697-4049-A9B1-67E1FC5F****'),
}

model AuthorizeUsersForAppResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AuthorizeUsersForAppResponseBody(name='body'),
}

/**
  * @description ## Operation description
  * This operation manages user authorization for an app instance group at the application level. The authorization result applies only to the application specified by AppId and does not affect the authorization relationships of other applications in the app instance group. To authorize users for the entire app instance group, call the [AuthorizeInstanceGroup](~~AuthorizeInstanceGroup~~) operation.
  * ## Before you begin
  * - The app instance group is created, and **the application specified by AppId is deployed in the image used by the app instance group**. Otherwise, the error code `InvalidAppId.NotFound` is returned.
  * - The app instance group **is not added to an active app instance group set**. App instance groups added to a set cannot be authorized individually and must be authorized through the set. Otherwise, the error code `InvalidAppInstanceGroup.AuthorizeBlockedBySet` is returned.
  * - If the workspace to which the app instance group belongs is an AD workspace, **UserMeta must be specified**, the value of UserMeta.Type must be ad, and the value of UserMeta.AdDomain must be the same as the AD domain bound to the workspace.
  * - If the app instance group is already authorized through a user group and mixed authorization of users and user groups is not supported, you cannot authorize individual users. Otherwise, the error code `AuthAppInstanceGroup.MixNotSupported` is returned.
  * ## Parameter description
  * - **You must specify at least one of AuthorizeUserIds and UnAuthorizeUserIds**, or specify both. If both are empty, the system does not change any authorization relationships when you invoke this operation.
  * - When adding authorization, the sum of the current number of authorized users for the application and the number of newly added users cannot exceed the authorized user quota for the application. If the quota is exceeded, the error code `ExceedAppAuthUserQuota` is returned. Removing authorization is not subject to the quota limit.
  * ## Call sequence
  * 1. Call the [ListAppInstanceGroup](https://help.aliyun.com/document_detail/428506.html) or [GetAppInstanceGroup](https://help.aliyun.com/document_detail/600836.html) operation to obtain the app instance group ID (AppInstanceGroupId) and the application IDs of the applications deployed in the app instance group (AppId in the Apps list).
  * 2. Call the [DescribeUsers](https://help.aliyun.com/document_detail/436936.html) operation to obtain the usernames of the users to be authorized or unauthorized.
  * 3. Call this operation to complete the authorization change.
  * > After the authorization is changed, the selected users will receive a notification email. It generally takes about 2 minutes for the changes to take effect on the terminal.
  * @param request  the request parameters of AuthorizeUsersForApp  AuthorizeUsersForAppRequest
  * @return AuthorizeUsersForAppResponse
 */
async function authorizeUsersForApp(request: AuthorizeUsersForAppRequest): AuthorizeUsersForAppResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AuthorizeUsersForApp', 'POST', '/', 'json', true, 'form', request);
}

model BatchCreateLlmTemplatesRequest {
  llmTemplateItems?: [ 
    {
      config?: string(name='Config', description='The JSON object for model configuration.', example='{
	"id": "qwen3.6-plus",
	"cost": {
		"input": 0,
		"output": 0,
		"cacheRead": 0,
		"cacheWrite": 0
	},
	"name": "Qwen3.6-Plus",
	"input": ["image", "text"],
	"compat": {
		"supportsUsageInStreaming": true
	},
	"maxTokens": 65536,
	"reasoning": false,
	"contextWindow": 1000000
}'),
      description?: string(name='Description', description='The model description.', example='Qwen Plus series models'),
      isDefaultModel?: boolean(name='IsDefaultModel', description='Specifies whether to set the model as the default model. Each model group can have at most one default model.', example='false'),
      llmCode?: string(name='LlmCode', description='The model code. It must be unique under the same provider.', example='qwen3.6-plus'),
      name?: string(name='Name', description='The model name.', example='Qwen3.6-Plus'),
    }
  ](name='LlmTemplateItems', description='The list of model configurations to be created.', position='Body'),
  modelTemplateId?: string(name='ModelTemplateId', description='The ID of the associated model group.', example='mt-xxxx', position='Body'),
  providerTemplateId: string(name='ProviderTemplateId', description='The ID of the model provider template to which the model templates belong.

This parameter is required.', example='mpt-xxxx', position='Body'),
}

model BatchCreateLlmTemplatesResponseBody = {
  data?: {
    llmTemplateIds?: [ string ](name='LlmTemplateIds', description='The list of IDs of the successfully created model templates.'),
    skippedItems?: [ 
      {
        llmCode?: string(name='LlmCode', description='The code of the skipped model.', example='qwen3.5-plus'),
        reason?: string(name='Reason', description='The reason why the model configuration item was skipped.', example='LLM template already exists with same providerTemplateId and llmCode.'),
      }
    ](name='SkippedItems', description='The list of skipped model configuration items.'),
    successCount?: int32(name='SuccessCount', description='The number of successfully created model templates.', example='5'),
    totalCount?: int32(name='TotalCount', description='The total number of requested model templates.', example='6'),
  }(name='Data', description='The returned data object.'),
  requestId?: string(name='RequestId', description='The request ID.', example='1CBAFFAB-B697-4049-A9B1-67E1FC5F****'),
}

model BatchCreateLlmTemplatesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BatchCreateLlmTemplatesResponseBody(name='body'),
}

/**
  * @description You can create multiple model templates under a model provider template in the Wuying Agent Management Center. You can add multiple models at a time and specify one of them as the default model. Existing models are automatically skipped to prevent duplicate model creation.
  * Make sure that you are fully familiar with the operations and usage of the Wuying Agent Management Center before you call this operation.
  * @param request  the request parameters of BatchCreateLlmTemplates  BatchCreateLlmTemplatesRequest
  * @return BatchCreateLlmTemplatesResponse
 */
async function batchCreateLlmTemplates(request: BatchCreateLlmTemplatesRequest): BatchCreateLlmTemplatesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BatchCreateLlmTemplates', 'POST', '/', 'json', true, 'form', request);
}

model BuilderImageByParentRequest {
  regionId?: string(name='RegionId', position='Host'),
  bizType?: int32(name='BizType', description='The business type to which the image belongs. **Required**. Valid values:

- **1**: Basic product.
- **2**: Personal cloud.
- **3**: Cloud office.
- **4**: Cloud Flow.
- **10**: Personal edition.
- **20**: Business edition.
- **60**: Linggou team edition.', example='1', position='Body'),
  dataDiskSize?: int32(name='DataDiskSize', description='The capacity of the data cloud disk in the creation environment. Unit: GiB. Specify this parameter when a data cloud disk is required, and ensure that it meets the disk requirements of the selected resource specifications.', example='100', position='Body'),
  description?: string(name='Description', description='The description of the new image, which facilitates subsequent queries and differentiation of images.', example='Business image that includes office applications and standard configurations', position='Body'),
  distro?: string(name='Distro', description='The operating system distribution information of the image. Enter the distribution identifier that is consistent with the parent image used.', example='Ubuntu 22.04 64-bit', position='Body'),
  driverIdList?: [ string ](name='DriverIdList', description='The list of driver IDs used when creating the image. A maximum of 200 items are supported. When you need to specify drivers, enter the IDs of existing drivers that are applicable to the target image.

**If PropertyMap.DRIVER_LIST is also specified, this parameter overwrites the driver list in it.**', example='["6d4af751-f522-40d7-ab6c-4a0ae587****","b5bdf6c0-41de-4878-8963-e8324106****"]', position='Body'),
  imageCreateMode: string(name='ImageCreateMode', description='The image creation mode. Use the following mode:

- **BUILDER_MANUAL**: Manually enter the creation environment to install applications and configure the image.

This parameter is required.', example='BUILDER_MANUAL', position='Body'),
  imageName?: string(name='ImageName', description='The name of the new image. **Required**. The name must start with a letter or a Chinese character, and can contain letters, digits, Chinese characters, colons (:), underscores (_), periods (.), and hyphens (-). It cannot start with http:// or https://. The length is calculated as 3 for each Chinese character and 1 for each other character. The total length must be 2 to 64 characters.', example='OfficeImage_202611', position='Body'),
  language?: string(name='Language', description='The language of the image. Valid values:

- **zh-CN**: Simplified Chinese.
- **zh-HK**: Traditional Chinese (Hong Kong).
- **en-US**: English.
- **ja-JP**: Japanese.
- **CN**: Compatible value for Simplified Chinese.
- **EN**: Compatible value for English.
- **JP**: Compatible value for Japanese.
- **CN-HK**: Compatible value for Traditional Chinese (Hong Kong).', example='zh-CN', position='Body'),
  nodeInstanceType?: string(name='NodeInstanceType', description='The ID of the node specifications for the creation resources. You can invoke ListNodeInstanceType to query the ID. Select a specification that is active in the creation region and under the associated product, and meets the CPU or GPU computing requirements.', example='appstreaming.general.4c8g', position='Body'),
  officeSiteId?: string(name='OfficeSiteId', description='The ID of the office network used by the creation resources. Specify this parameter when a specific office network is required, and ensure that it is consistent with the creation region.', example='cn-hangzhou+dir-example****', position='Body'),
  packageType?: string(name='PackageType', description='The package type of the image. Keep it consistent with the selected parent image and creation scenario. Valid values:

- **Ecs**: ECS instance image.
- **Vhd**: VHD application image.
- **Container**: Container image.
- **Ecs_Container**: ECS and container combined image.
- **K8s_Node**: Kubernetes node image.

**This operation does not provide the BaseImageId parameter. You cannot explicitly specify the Vhd or Container type that requires a base image to be configured separately.**', example='Ecs', position='Body'),
  parentImageId: string(name='ParentImageId', description='The ID of the parent image used to create the new image. **Required**. You can call ListImage to query the ID. An available distribution record of the parent image must exist in the region where the image is created.

This parameter is required.', example='imgc-bp1parent****', position='Body'),
  performanceType: string(name='PerformanceType', description='The computing type of the creation resources.

- **CPU**: Uses CPU compute resources.
- **GPU**: Uses GPU compute resources.

This parameter is required.', example='CPU', position='Body'),
  productType?: string(name='ProductType', description='The product to which the image belongs. **Required**. Use an activated product and keep it consistent with the selected parent image. Valid values:

- **CloudGame**: Cloud game.
- **CloudApp**: Wuying Cloud App.
- **CloudBrowser**: Secure browser.
- **CloudDesktop**: Wuying Cloud Computer.
- **ImageBuilder**: Image creation resource.
- **ImageValidate**: Image validation resource.
- **AndroidCloud**: Android cloud.
- **GpuRender**: GPU rendering.
- **AndroidGpuRender**: Android cloud GPU rendering.
- **WuyingServer**: Enterprise edition workstation.
- **GpuProxy**: GPU remote rendering proxy.
- **GpuCache**: GPU remote rendering cache.
- **AIAgent**: AI agent service.
- **HostedDesktop**: Hosted computer.
- **WuyingWorkstation**: Personal edition container workstation.
- **WuyingWorkstationBusiness**: Business edition container workstation.
- **WuyingWorkstationTeam**: Linggou container workstation team edition.', example='CloudApp', position='Body'),
  propertyMap?: map[string]string(name='PropertyMap', description='The extended properties of the image. Both keys and values are strings. This parameter can be omitted when no extended configuration is required.

The property key for the driver list is DRIVER_LIST, and the value is a JSON string of an array of driver IDs. We recommend that you specify drivers by using DriverIdList. **If both DriverIdList and PropertyMap.DRIVER_LIST are specified, DriverIdList takes precedence.** Specify other extended properties only when their purposes and values are confirmed.', example='{"DRIVER_LIST":"[\\\\"6d4af751-f522-40d7-ab6c-4a0ae587****\\\\",\\\\"b5bdf6c0-41de-4878-8963-e8324106****\\\\"]"}', shrink='json', position='Body'),
  resourceList?: [ 
    {
      resource?: string(name='Resource', description='The resource content corresponding to ResourceType. For the URL type, enter or return an accessible resource URL.', example='https://example.com/apps/business/setup.exe'),
      resourceType?: string(name='ResourceType', description='The provision method of the resource content. Valid values:

- **HOSTED**: Hosted resource.
- **TEXT**: Text resource.
- **URL**: Resource provided through a URL.', example='URL'),
    }
  ](name='ResourceList', description='The list of resources required for image creation, such as the download URLs of applications to be installed. A maximum of 100 items are supported. The ResourceType and Resource of each item must correspond to each other.', position='Body'),
  runMode?: string(name='RunMode', description='The running mode of the image creation environment. Valid values:

- **NORMAL**: Normal running mode.
- **COMPATIBLE**: Compatible running mode.', example='NORMAL', position='Body'),
  sourceRegion?: string(name='SourceRegion', description='The ID of the region where the image is created. The selected parent image must have been distributed to this region. Available regions are also affected by the region configurations of the account and product.', example='cn-hangzhou', position='Body'),
  systemDiskSize: int32(name='SystemDiskSize', description='The capacity of the system cloud disk in the creation environment. Unit: GiB. The capacity cannot be smaller than the system cloud disk capacity required by the parent image, and must meet the disk requirements of the selected resource specifications.

This parameter is required.', example='80', position='Body'),
  vSwitchIdList?: [ string ](name='VSwitchIdList', description='The list of vSwitch IDs used by the creation resources. A maximum of 100 items are supported. The vSwitches must belong to the selected office network and be located in the creation region.', position='Body'),
  versionName?: string(name='VersionName', description='The display name of the new image version, which is used to differentiate different versions of the same image.', example='Office environment-202611', position='Body'),
}

