model DescribeExportTasksRequest {
  pageNumber?: int32(name='PageNumber', description='The page number for paging. Pages start from 1. If this parameter is not specified or is set to a value less than 1, the first page is returned. The query results are sorted in descending order of task creation time, with the most recently created tasks listed first. When polling a single task by TaskId, we recommend that you explicitly set this parameter to 1.', example='1', position='Body'),
  pageSize?: int32(name='PageSize', description='The number of tasks to return on each page. Default value: 200. If this parameter is set to a value less than 1, the value 10 is used. When polling a single task by TaskId, set this parameter to 1 to avoid returning redundant tasks.', example='10', position='Body'),
  taskId?: string(name='TaskId', description='Filters export tasks by task ID. The value is the TaskId returned by CreateExportTask, which is a 32-character UUID string without hyphens. This parameter requires an exact match and does not support fuzzy queries. If this parameter is not specified, all tasks under the current account that meet other conditions are returned.', example='8119078c29e948dba2e0a9917995332a', position='Body'),
  taskType?: string(name='TaskType', description='Filters export tasks by task type. The value is case-sensitive and must be one of the following valid values:
- WUYING_SERVER_LIST: Wuying host list.
- USER_USAGE_REPORT: User usage report.
- BROWSER_BOOKMARK_LIST: Cloud browser bookmark list.
- BROWSER_RESTRICTED_URL_LIST: Cloud browser URL whitelist.

If this parameter is not specified, tasks are not filtered by type, and all tasks under the current account that meet other conditions are returned. If an unrecognized value is passed, the server does not return a parameter error but cancels the type filter. Therefore, you must pass the exact valid values listed above. When querying a single task by TaskId, omit this parameter.', example='WUYING_SERVER_LIST', position='Body'),
}

model DescribeExportTasksResponseBody = {
  count?: int32(name='Count', description='The total number of tasks that meet the query conditions. This value is independent of the number of tasks returned on the current page and can be used with PageSize to calculate the total number of pages. If no tasks meet the conditions, 0 is returned.', example='1'),
  exportTaskModel?: [ 
    {
      createTime?: string(name='CreateTime', description='The creation time of the task. The format is yyyy-MM-dd HH:mm:ss, accurate to seconds. The returned string does not include the time zone offset.', example='2026-07-27 19:00:00'),
      downloadUrl?: string(name='DownloadUrl', description='The OSS pre-signed download URL of the export file. This field is returned only for tasks whose Status is FINISHED. The default maximum validity period of the signature is 1 hour and does not exceed the 24-hour validity period after the task is created. When the remaining validity period is less than 10 minutes, the server automatically refreshes and returns a new URL. If the task is not completed, the task has expired, or the URL refresh fails, this field is empty. The domain name and path in the example URL are for demonstration purposes. The actual returned value is a complete URL with signature parameters. Use the URL returned by the most recent query for downloading.', example='https://example.oss-cn-hangzhou.aliyuncs.com/...'),
      errorMsg?: string(name='ErrorMsg', description='The cause of the task execution failure. This field is returned only when Status is FAILED. The content is the English error description recorded by the server and can be directly displayed to users or used for troubleshooting. This field is empty in other states.', example='The export sub type is not supported.'),
      exportFileName?: string(name='ExportFileName', description='The name of the export file. The name consists of the task type, task creation time in yyyyMMddHHmmss format, and the first 8 characters of the task ID, connected by underscores, with the .xlsx extension. If the file is not generated, this field is empty.', example='WUYING_SERVER_LIST_20260727190000_8119078c.xlsx'),
      progress?: float(name='Progress', description='The progress of the export task, in percentage. Valid values: 0 to 100. This value is updated based on the execution stage of the task and is 100 when the task is completed.', example='100'),
      status?: string(name='Status', description='The status of the export task. This operation returns the following valid values:
- INIT: The task is created and waiting to be executed. Continue polling.
- RUNNING: The export file is being generated. You can display the progress based on Progress and continue polling.
- FINISHED: The export file is generated. Stop polling and use DownloadUrl to download the file.
- FAILED: The task execution failed. Stop polling and check ErrorMsg.

The server also has an EXPIRED state, but this operation does not return tasks in this state.', example='FINISHED'),
      taskId?: string(name='TaskId', description='The ID of the export task, which is a 32-character UUID string without hyphens. You can use this value as the TaskId parameter for this operation to poll the task.', example='8119078c29e948dba2e0a9917995332a'),
      taskType?: string(name='TaskType', description='The type of the export task. For the meaning of each value, see the TaskType request parameter.', example='WUYING_SERVER_LIST'),
    }
  ](name='ExportTaskModel', description='The list of export tasks, sorted in descending order of task creation time, with the most recently created tasks listed first. If no tasks meet the conditions, an empty array is returned.'),
  pageNumber?: int32(name='PageNumber', description='The actual page number used for this query, which is the echoed value of the PageNumber request parameter.', example='1'),
  pageSize?: int32(name='PageSize', description='The actual number of tasks per page used for this query, which is the echoed value of the PageSize request parameter.', example='10'),
  requestId?: string(name='RequestId', description='The ID of the request, which is used to locate call records and troubleshoot issues. The example value is partially masked.', example='D4A13D91-****'),
}

model DescribeExportTasksResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DescribeExportTasksResponseBody(name='body'),
}

/**
  * @description You can call this operation to query export tasks under the current Alibaba Cloud account by paging, and obtain the task status, execution progress, export file name, and download URL. Export tasks are created by calling CreateExportTask. This operation only reads task information and does not create, modify, or retry tasks.
  * The query results are returned in descending order of task creation time, with the most recently created tasks listed first. Only tasks in the INIT, RUNNING, FINISHED, and FAILED states are returned. Tasks marked as EXPIRED are not included in the results.
  * When polling a single task by TaskId, set PageNumber to 1 and PageSize to 1, set the polling interval to 5 to 10 seconds, and stop polling after the task enters the FINISHED or FAILED state.
  * A task is valid for 24 hours after creation and is marked as expired by a background task after 25 hours. Therefore, within the 24- to 25-hour window, you may still query a FINISHED task, but the DownloadUrl is empty. After a task is marked as expired, the query result is an empty array.
  * If the query result is an empty array, it may be because there are no visible tasks under the current account, the task type does not match, the page number is out of bounds, or the tasks have expired. This operation always returns an array structure and does not return an error when the query result is empty.
  * The DownloadUrl is an OSS pre-signed URL. The default maximum validity period is 1 hour and does not exceed the remaining validity period of the task. The server automatically refreshes the URL when it is about to expire. Use the URL returned by the most recent query for downloading and do not cache the initially returned URL for a long time.
  * @param request  the request parameters of DescribeExportTasks  DescribeExportTasksRequest
  * @return DescribeExportTasksResponse
 */
async function describeExportTasks(request: DescribeExportTasksRequest): DescribeExportTasksResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DescribeExportTasks', 'POST', '/', 'json', true, 'form', request);
}

