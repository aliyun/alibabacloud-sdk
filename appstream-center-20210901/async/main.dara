  password?: string(name='Password', description='The workstation logon password.', example='YourPassword123', position='Body'),
  period?: int32(name='Period', description='The subscription duration.', example='1', position='Body'),
  periodUnit?: string(name='PeriodUnit', description='The time unit.', example='Month', position='Body'),
  promotionId?: string(name='PromotionId', description='The discount ID.


> If PromotionId is specified, the corresponding discount is applied.', example='17440009****', position='Body'),
