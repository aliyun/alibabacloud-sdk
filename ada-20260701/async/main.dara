import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Ada';
  @version = '2026-07-01';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CreateAgentRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  description?: string(name='Description', description='The description of the Agent.', example='Analyzes code changes and generates CR review comments', position='Body'),
  displayName?: string(name='DisplayName', description='The display name of the Agent.', example='CR Code Review Agent', position='Body'),
  knowledgeBases?: any(name='KnowledgeBases', description='The knowledge base reference list, which contains at most one element.', example='[{"name":"code-review-guidelines"}]', position='Body'),
  name: string(name='Name', description='The Agent name, which is also the unique identifier that cannot be modified after creation.

This parameter is required.', example='code-review-agent', minLength=1, maxLength=128, position='Body'),
  skills?: any(name='Skills', description='The Skill reference list. For specific fields, see "Supplementary description of request parameters".', example='[{"name":"code-review"}]', position='Body'),
  systemPrompt?: string(name='SystemPrompt', description='The system prompt.', example='Check the correctness, security, and maintainability of code changes in the CR, and provide review comments by severity', position='Body'),
  tools?: any(name='Tools', description='The reference list of MCP Server and Connector names. The same array supports both types of entries. Each entry specifies one type of reference. If items is omitted for an MCP Server, all public tools are included. Previously specified items retain their original values.', example='[{"mcpServerName":"code-repository-mcp"},{"connectorName":"code-review-data"}]', position='Body'),
  visibility?: string(name='Visibility', description='The visibility scope of the Agent. Valid values:
- user
- tenant

Default value: user.', example='user', position='Body'),
}

model CreateAgentResponseBody = {
  agentId?: string(name='AgentId', description='The Agent ID generated by the service.', example='agent_00000000000000000000000000000001'),
  name?: string(name='Name', description='The name of the created Agent.', example='code-review-agent'),
  requestId?: string(name='RequestId', description='The request ID, which is used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  success?: boolean(name='Success', description='Indicates whether the Agent is created. A successful response always returns `true`. An error response is returned upon failure.', example='true'),
  updatedAt?: long(name='UpdatedAt', description='The last update time, in UNIX millisecond timestamp.', example='1788332400000'),
}

model CreateAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateAgentResponseBody(name='body'),
}

/**
  * @description - `Name` is the unique identifier of the Agent within the current tenant. It can contain only letters, digits, underscores, and hyphens, and must be 1 to 128 characters in length. The name cannot be modified after creation.
  * - Each Agent can be associated with only one knowledge base.
  * @param request  the request parameters of CreateAgent  CreateAgentRequest
  * @return CreateAgentResponse
 */
async function createAgent(request: CreateAgentRequest): CreateAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateAgent', 'POST', '/', 'json', true, 'form', request);
}

model CreateSkillRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  description: string(name='Description', description='The description of the Skill.

This parameter is required.', example='A Skill for reviewing code quality, security risks, and coding standards.', position='Body'),
  metadata: any(name='Metadata', description='The Skill metadata in JSON object format. Exactly one content source must be provided. For more information about the fields, see "Request parameter description".

This parameter is required.', example='{"skillMd":"# Code Review\\\\nCheck code quality, security risks, and coding standards."}', position='Body'),
  name: string(name='Name', description='The unique identifier of the Skill. Only letters, digits, underscores, and hyphens are supported. The value can be up to 64 characters in length.

This parameter is required.', example='code-review', position='Body'),
  visibility?: string(name='Visibility', description='The visibility of the Skill. Valid values:

- user
- tenant

Default value: user.', example='user', position='Body'),
}

model CreateSkillResponseBody = {
  name?: string(name='Name', description='The unique identifier of the Skill.', example='code-review'),
  requestId?: string(name='RequestId', description='The request ID, which is used to locate and troubleshoot the request.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  skillId?: string(name='SkillId', description='Skill ID。', example='skill_example123'),
  success?: boolean(name='Success', description='Indicates whether the Skill and its body or bundle are fully created and readable. A value of true is returned upon success. Business failures are returned as error responses.', example='true'),
  updatedAt?: long(name='UpdatedAt', description='The time when the Skill was last updated after creation. The value is a UNIX timestamp in milliseconds.', example='1760000100000'),
}

model CreateSkillResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateSkillResponseBody(name='body'),
}

/**
  * @description - Creation rules:
  *   - `Name` must be unique within the current tenant and cannot share a name with an official Skill.
  *   - `Description` and `Metadata` are required. `Metadata` must contain exactly one valid content source. Different sources cannot be mixed.
  *   - After the Skill is created, you can modify it by calling `UpdateSkill`.
  * - Content sources:
  *   - `skillMd`: Directly provide the Markdown body without a YAML header. Specify the name and description by using `Name` and `Description`.
  *   - `transitId`: Upload and confirm a ZIP file through Transit. Call the operations in the following order:
  *     1. Call `CreateTransitUploadPolicy` with `FileShowName` to obtain `TransitId`, `FilePath`, and `PolicyInfo`.
  *     2. Upload the ZIP file to object storage by using `PolicyInfo` and `FilePath`.
  *     3. Call `ConfirmTransitUpload` with `TransitId`. Proceed with creation only when the response returns `Confirmed=true`.
  *     4. Call `CreateSkill` and pass the confirmed `TransitId` in `Metadata.transitId`.
  *   - `bundleUrl`: Provide a public HTTPS direct link to a ZIP file. The platform downloads the file and saves it as an Artifact. The original URL is not persisted or returned in responses.
  * @param request  the request parameters of CreateSkill  CreateSkillRequest
  * @return CreateSkillResponse
 */
async function createSkill(request: CreateSkillRequest): CreateSkillResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateSkill', 'POST', '/', 'json', true, 'form', request);
}

model CreateTransitUploadPolicyRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  expireMs?: long(name='ExpireMs', description='The validity period of the upload policy and the Transit record, in milliseconds. Valid values: 1000 to 604800000. The value is rounded down to the nearest whole second. If `ExpireMs` is omitted or a `null` placeholder is passed through the gateway\\\\"s canonical field, the default validity period is `604800000` milliseconds (7 days).', example='604800000', position='Body'),
  fileShowName: string(name='FileShowName', description='The display name of the file. The value must be 1 to 512 characters in length. The object key is generated by the server and is not guaranteed to contain the original file name.

This parameter is required.', example='code-review.zip', minLength=1, maxLength=512, position='Body'),
  network?: string(name='Network', description='The network type of the upload address. Valid values: `public` and `internal`. Default value: `public`.', example='public', position='Body'),
  pathPrefix?: string(name='PathPrefix', description='The path prefix used for object key isolation. This prefix has no Artifact business directory semantics. Default value: `default`.', example='skill-bundle', position='Body'),
}

model CreateTransitUploadPolicyResponseBody = {
  filePath?: string(name='FilePath', description='The object storage key, which is also the `key` field in the PostObject form.', example='skill-bundle/tenant-demo/user-demo/20260904120000_0123456789abcdef0123456789abcdef.zip'),
  policyInfo?: {
    accessId?: string(name='AccessId', description='The `OSSAccessKeyId` field in the PostObject form. Protect this value together with the entire `PolicyInfo`.', example='<REDACTED>'),
    dir?: string(name='Dir', description='The object storage key. The value is the same as the top-level `FilePath`.', example='skill-bundle/tenant-demo/user-demo/20260904120000_0123456789abcdef0123456789abcdef.zip'),
    host?: string(name='Host', description='The target URL to which the client sends the PostObject request.', example='https://upload.example.invalid'),
    policy?: string(name='Policy', description='The Base64-encoded PostObject upload policy. Protect this value together with the entire `PolicyInfo`.', example='<REDACTED>'),
    securityToken?: string(name='SecurityToken', description='The `x-oss-security-token` field in the PostObject form when STS credentials are used. This field may be empty when STS is not used. This field contains sensitive authorization information.', example='<REDACTED>'),
    signature?: string(name='Signature', description='The signature field in the PostObject form. This field contains sensitive authorization information.', example='<REDACTED>'),
  }(name='PolicyInfo', description='The upload policy object. For the complete list of subfields, see the following table.'),
  requestId?: string(name='RequestId', description='The request ID, used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  success?: boolean(name='Success', description='Indicates whether the upload policy is generated. A successful response always returns `true`. An error response is returned upon failure.', example='true'),
  transitId?: string(name='TransitId', description='The ID of the newly created Transit record, used for subsequent queries and storage operations.', example='transit_0123456789abcdef0123456789abcdef'),
}

model CreateTransitUploadPolicyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateTransitUploadPolicyResponseBody(name='body'),
}

/**
  * @description - `Network` can be set to `public` or `internal` to generate a public or same-region internal upload address. Default value: `public`.
  * - The maximum size of a single file is 50 MiB.
  * - `PolicyInfo` contains short-term upload authorization information intended only for the current file upload. Do not log it, persist it long-term, or forward it to other users.
  * - `ExpireMs` controls the validity period of the upload policy and the Transit record, in milliseconds. It is not an absolute timestamp. The default and maximum value is `604800000` (7 days), and the minimum value is `1000` (1 second). The validity period is rounded down to the nearest whole second. For example, 1500 milliseconds takes effect as 1 second.
  * - Call `GetTransitMeta` and read `ExpireAt` to obtain the expiration time of the Transit record. Confirming the upload or querying the record does not extend the validity period.
  * @param request  the request parameters of CreateTransitUploadPolicy  CreateTransitUploadPolicyRequest
  * @return CreateTransitUploadPolicyResponse
 */
async function createTransitUploadPolicy(request: CreateTransitUploadPolicyRequest): CreateTransitUploadPolicyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateTransitUploadPolicy', 'POST', '/', 'json', true, 'form', request);
}

model DeleteAgentRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  name: string(name='Name', description='The name of the Agent to delete.

This parameter is required.', example='code-review-agent', minLength=1, maxLength=128, position='Query'),
}

model DeleteAgentResponseBody = {
  requestId?: string(name='RequestId', description='The request ID, which is used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  success?: boolean(name='Success', description='Indicates whether the Agent is deleted. The value `true` is returned for a successful response. An error response is returned for a failed request.', example='true'),
}

model DeleteAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DeleteAgentResponseBody(name='body'),
}

/**
  * @description - Creators can delete Agents that they created.
  * - After deletion, the Agent can no longer be queried, updated, or run.
  * @param request  the request parameters of DeleteAgent  DeleteAgentRequest
  * @return DeleteAgentResponse
 */
async function deleteAgent(request: DeleteAgentRequest): DeleteAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DeleteAgent', 'POST', '/', 'json', false, 'json', request);
}

model DeleteSkillRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  name: string(name='Name', description='The name of the Skill to delete.

This parameter is required.', example='code-review', position='Query'),
}

model DeleteSkillResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  success?: boolean(name='Success', description='Returns `true` when both the logical deletion of the Skill and the optional logical archiving of the Artifact are complete.', example='true'),
}

model DeleteSkillResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DeleteSkillResponseBody(name='body'),
}

/**
  * @description - Deletion permissions:
  *   - You can only delete custom Skills that the current caller has permission to modify.
  *   - The caller must be the Skill creator or the tenant root account that has permission to manage the tenant-level Skill. Official Skills cannot be deleted.
  * - Deletion results:
  *   - Deletion uses soft delete. After successful deletion, `GetSkill` and `ListSkills` no longer return the Skill, and you can create a new Skill with the same name.
  *   - Recovery is not supported. You cannot delete a Skill that has already been deleted or does not exist.
  * @param request  the request parameters of DeleteSkill  DeleteSkillRequest
  * @return DeleteSkillResponse
 */
async function deleteSkill(request: DeleteSkillRequest): DeleteSkillResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DeleteSkill', 'POST', '/', 'json', false, 'json', request);
}

model GetAgentRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  name: string(name='Name', description='The name of the agent.

This parameter is required.', example='code-review-agent', minLength=1, maxLength=128, position='Query'),
}

model GetAgentResponseBody = {
  agentId?: string(name='AgentId', description='Agent ID。', example='agent_00000000000000000000000000000001'),
  agentVersion?: long(name='AgentVersion', description='The current configuration revision number.', example='2'),
  canDelete?: boolean(name='CanDelete', description='Indicates whether the current identity can delete the agent.', example='true'),
  canModify?: boolean(name='CanModify', description='Indicates whether the current identity can modify the agent.', example='true'),
  createdAt?: long(name='CreatedAt', description='The creation time. The value is a UNIX timestamp in milliseconds.', example='1788332400000'),
  description?: string(name='Description', description='The description of the agent. This field may not be returned if it is not configured.', example='Analyzes code changes and generates CR review comments'),
  displayName?: string(name='DisplayName', description='The display name of the agent. This field may not be returned if it is not configured.', example='CR Code Review Agent'),
  knowledgeBases?: any(name='KnowledgeBases', description='The list of knowledge base references. The list contains at most one element.', example='[{"name":"code-review-guidelines"}]'),
  metadata?: any(name='Metadata', description='The display metadata of the agent. For specific fields, see "Supplementary description of response elements".', example='{"iconUrl":"https://example.com/icons/code-review-agent.png"}'),
  model?: any(name='Model', description='The saved model configuration. This field is returned only for official agents. The value supports an object array and is compatible with legacy single objects and strings. An empty array returns [ \\\\]. Object arrays preserve the original order, duplicate names, and object fields.', example='[{"name":"base","default":true},{"name":"base"},{"name":"base","settings":{"thinking":false,"topK":5}}]'),
  name?: string(name='Name', description='The name of the agent.', example='code-review-agent'),
  official?: boolean(name='Official', description='Indicates whether the agent is an official agent provided by the platform.', example='false'),
  requestId?: string(name='RequestId', description='The request ID, which is used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  skills?: any(name='Skills', description='The list of skill references. For specific fields, see "Supplementary description of response elements".', example='[{"name":"code-review"}]'),
  status?: string(name='Status', description='The status of the agent. The default status of a newly created agent is `draft`.', example='draft'),
  systemPrompt?: string(name='SystemPrompt', description='The system prompt. This field may not be returned if it is not configured.', example='Check the correctness, security, and maintainability of code changes in the CR, and provide review comments by severity'),
  tools?: any(name='Tools', description='The list of MCP Server and Connector name references. For element fields, see the following section.', example='[{"mcpServerName":"code-repository-mcp"},{"connectorName":"code-review-data"}]'),
  updatedAt?: long(name='UpdatedAt', description='The most recent update time. The value is a UNIX timestamp in milliseconds.', example='1788332700000'),
  visibility?: string(name='Visibility', description='The visibility scope of the agent. Valid values: `user` and `tenant`.', example='user'),
}

model GetAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetAgentResponseBody(name='body'),
}

/**
  * @description - You can retrieve agents that you created, agents visible within the current tenant, and official agents provided by the platform.
  * @param request  the request parameters of GetAgent  GetAgentRequest
  * @return GetAgentResponse
 */
async function getAgent(request: GetAgentRequest): GetAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetAgent', 'POST', '/', 'json', false, 'json', request);
}

model GetSkillRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  name: string(name='Name', description='The Skill name.

This parameter is required.', example='code-review', position='Query'),
  network?: string(name='Network', description='The network type of the download URL. Valid values: public and internal. If omitted, no download URL is generated.', example='public', position='Query'),
  skillVersion?: long(name='SkillVersion', description='The release history version number to query. If omitted, the current Skill main record is returned.', example='2', position='Query'),
}

model GetSkillResponseBody = {
  canDelete?: boolean(name='CanDelete', description='Indicates whether the current caller can delete the Skill.', example='true'),
  canModify?: boolean(name='CanModify', description='Indicates whether the current caller can modify the Skill.', example='true'),
  createdAt?: long(name='CreatedAt', description='The creation time of the Skill, in Unix millisecond timestamp.', example='1760000000000'),
  description?: string(name='Description', description='The description in the current Skill main record.', example='A Skill for performing code review and risk alerts'),
  downloadUrl?: string(name='DownloadUrl', description='The bundle download URL. Returned when a network type is specified, an accessible Artifact exists, and pre-signing succeeds.', example='https://example.com/artifacts/code-review-v2.zip?signature=example'),
  downloadUrlNetwork?: string(name='DownloadUrlNetwork', description='The network type used to generate the download URL.', example='public'),
  iconUrl?: string(name='IconUrl', description='The Skill icon URL, sourced from the iconUrl in the metadata. This field may be empty if no icon is configured.', example='https://example.com/icons/code-review.png'),
  metadata?: any(name='Metadata', description='The Skill metadata, mapped to the metadata field in the backend response.', example='{"skillMd":"# Code Review\\\\nCheck code quality.","artifactId":"artifact_example003"}'),
  name?: string(name='Name', description='The Skill name.', example='code-review'),
  official?: boolean(name='Official', description='Indicates whether the Skill is an official Skill.', example='false'),
  requestId?: string(name='RequestId', description='The request ID, used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  skillId?: string(name='SkillId', description='Skill ID。', example='skill_example123'),
  status?: string(name='Status', description='The current Skill status. Common values are DRAFT and PUBLISHED.', example='PUBLISHED'),
  updatedAt?: long(name='UpdatedAt', description='The update time of the Skill, in Unix millisecond timestamp.', example='1760000300000'),
  visibility?: string(name='Visibility', description='The visibility of the current Skill. Common values are user and tenant.', example='user'),
}

model GetSkillResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetSkillResponseBody(name='body'),
}

/**
  * @description - Query target:
  *   - Queries by `Name`. Querying by `SkillId` is not supported.
  *   - Returns the Skill with the matching name that is visible to the current caller under the current tenant first. If no visible record exists, queries the official Skill with the same name.
  *   - If `SkillVersion` is omitted, the current Skill is returned. This parameter is omitted by default.
  * - Download URL:
  *   - `Network` supports `public` and `internal`. If omitted, no download URL is generated.
  *   - If the Skill has an accessible Artifact, a temporary `DownloadUrl` and the corresponding `DownloadUrlNetwork` are returned.
  *   - If the Artifact does not exist, is inaccessible, or the URL generation fails, the Skill query still succeeds, but download URL-related fields may not be returned.
  *   - The original `bundleUrl` used during creation is not stored and is not returned by this operation.
  * @param request  the request parameters of GetSkill  GetSkillRequest
  * @return GetSkillResponse
 */
async function getSkill(request: GetSkillRequest): GetSkillResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetSkill', 'POST', '/', 'json', false, 'json', request);
}

model GetTransitMetaRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  expireMs?: long(name='ExpireMs', description='The validity period of the temporary download URL, in milliseconds. The value must be an integer greater than or equal to 1000 and is rounded down to the nearest whole second. If `ExpireMs` is not specified, the default validity period is `900000` milliseconds (15 minutes). A download URL is generated only when `Network` is specified.', example='900000', position='Query'),
  filePath?: string(name='FilePath', description='The opaque object path returned by `CreateTransitUploadPolicy`. Specify at least one of this parameter and `TransitId`.', example='skill-bundle/tenant-demo/user-demo/20260904120000_code-review.zip', position='Query'),
  network?: string(name='Network', description='The network type for the download URL. Valid values: `public` and `internal`. If this parameter is not specified, no download URL is generated.', example='public', position='Query'),
  transitId?: string(name='TransitId', description='The Transit ID. Specify at least one of this parameter and `FilePath`. If both are specified, this parameter takes precedence.', example='transit_0123456789abcdef0123456789abcdef', position='Query'),
}

model GetTransitMetaResponseBody = {
  downloadUrl?: string(name='DownloadUrl', description='The temporary download URL. If `Network` is not specified, `null` is returned. If the file is not yet available, the URL may not be accessible. Do not write this URL to logs, persist it for long-term use, or share it with unauthorized users.', example='https://download.example.invalid/code-review.zip?signature=<REDACTED>'),
  expireAt?: long(name='ExpireAt', description='The expiration time of the Transit record, expressed as a UTC UNIX timestamp in milliseconds (the number of milliseconds elapsed since 1970-01-01 00:00:00 UTC). You can compare this value directly with the current UNIX timestamp in milliseconds without adding or subtracting 8 hours. Do not use the record after this time.', example='1787734800000'),
  filePath?: string(name='FilePath', description='The opaque object path of the file. Do not parse or manually construct this value.', example='skill-bundle/tenant-demo/user-demo/20260904120000_code-review.zip'),
  requestId?: string(name='RequestId', description='The request ID, which is used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  size?: long(name='Size', description='The file size in bytes. `null` may be returned if no available file has been detected.', example='4096'),
  status?: string(name='Status', description='The Transit file status. Valid values:
- PENDING: The file is not yet available. You can query again later.
- SUCCESS: The file is available.', example='SUCCESS'),
  transitId?: string(name='TransitId', description='Transit ID。', example='transit_0123456789abcdef0123456789abcdef'),
}

model GetTransitMetaResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetTransitMetaResponseBody(name='body'),
}

/**
  * @description - Specify at least one of `TransitId` and `FilePath`. If both are specified, `TransitId` takes precedence.
  * - Use the `TransitId` returned by `CreateTransitUploadPolicy` to query the file. `TransitId` is a temporary capability identifier used during the file upload process. Do not share it with unauthorized users.
  * - `FilePath` is an opaque object path returned by `CreateTransitUploadPolicy`. Use it as-is. Do not parse, modify, or construct it manually.
  * - When you query by `FilePath`, an error is returned if the record does not exist or is not accessible to the caller.
  * - `ExpireMs` specifies the validity period of the download URL in milliseconds. Default value: `900000` (15 minutes). The validity period is rounded down to the nearest whole second. For example, 1500 milliseconds is rounded down to 1 second.
  * - `ExpireAt` is the expiration time of the Transit record, not the expiration time of the download URL. Querying, generating a download URL, and confirming the upload do not extend the record validity period.
  * @param request  the request parameters of GetTransitMeta  GetTransitMetaRequest
  * @return GetTransitMetaResponse
 */
async function getTransitMeta(request: GetTransitMetaRequest): GetTransitMetaResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetTransitMeta', 'POST', '/', 'json', false, 'json', request);
}

model ListAgentsRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  creatorId?: string(name='CreatorId', description='Filters agents by the exact creator ID.', example='example-user', position='Query'),
  maxResults?: int32(name='MaxResults', description='The number of entries per page for cursor-based pagination. Valid values: 1 to 100. Default value: 20.', example='20', minimum=1, maximum=100, position='Query'),
  nextToken?: string(name='NextToken', description='The next page token returned in the previous response.', example='eyJwYWdlIjoyfQ.example', position='Query'),
  pageNumber?: long(name='PageNumber', description='The page number for page number-based pagination. Minimum value: 1. Default value: 1.', example='1', minimum=1, position='Query'),
  pageSize?: long(name='PageSize', description='The number of entries per page for page number-based pagination. Valid values: 1 to 100. Default value: 20.', example='20', minimum=1, maximum=100, position='Query'),
  q?: string(name='Q', description='The search keyword. Matches the name, display name, or description.', example='code review', position='Query'),
  requiredRuntime?: string(name='RequiredRuntime', description='Filters agents by runtime label.', example='qwen', position='Query'),
  scope?: string(name='Scope', description='The query scope. Valid values: `SYSTEM` and `CUSTOM`.', example='CUSTOM', position='Query'),
  visibility?: string(name='Visibility', description='Filters agents by visibility scope. Valid values: `user` and `tenant`.', example='user', position='Query'),
}

model ListAgentsResponseBody = {
  agents?: [ any ](name='Agents', description='The list of agent summaries. For field details, see "Supplementary description of response parameters".'),
  maxResults?: int32(name='MaxResults', description='The actual cursor-based pagination size used.', example='20'),
  nextToken?: string(name='NextToken', description='The next page token. An empty string is returned if there is no next page.', example='eyJwYWdlIjoyfQ.example'),
  pageNumber?: long(name='PageNumber', description='The current page number.', example='1'),
  pageSize?: long(name='PageSize', description='The current page size for page number-based pagination.', example='20'),
  requestId?: string(name='RequestId', description='The request ID, used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  total?: long(name='Total', description='The total number of agents that match the filter conditions.', example='1'),
}

model ListAgentsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListAgentsResponseBody(name='body'),
}

/**
  * @description - By default, returns official platform agents and tenant agents visible to the current identity.
  * - Set `Scope=SYSTEM` to query only official agents, or `Scope=CUSTOM` to query only custom agents.
  * - Both cursor-based pagination and page number-based pagination are supported. When using cursor-based pagination, pass the `NextToken` value from the previous response to the next request, and keep the caller identity, filter conditions, and `MaxResults` unchanged.
  * @param request  the request parameters of ListAgents  ListAgentsRequest
  * @return ListAgentsResponse
 */
async function listAgents(request: ListAgentsRequest): ListAgentsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListAgents', 'POST', '/', 'json', false, 'json', request);
}

model ListSkillsRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  creatorId?: string(name='CreatorId', description='Filters Skills by creator ID.', example='example-user', position='Query'),
  maxResults?: int32(name='MaxResults', description='The number of entries per page for cursor-based pagination. Valid values: 1 to 100. Default value: `20`. If explicitly specified, cursor-based pagination takes precedence.', example='20', minimum=1, maximum=100, position='Query'),
  nextToken?: string(name='NextToken', description='The token returned by the server for the next page. Do not pass this parameter for the first query. For subsequent queries, use the value returned in the previous response.', example='eyJzIjoiZDc3ZGRhYmE3MDMwYWM1NCIsInAiOjJ9.vkKVySx9G26993sTNLZqwGSmgciRsrRm2SgsjOMJoCQ', position='Query'),
  pageNumber?: long(name='PageNumber', description='The page number for compatible page-number-based pagination. Pages start from 1. Default value: `1`.', example='1', position='Query'),
  pageSize?: long(name='PageSize', description='The number of entries per page for compatible page-number-based pagination. Valid values: 1 to 100. Default value: `20`.', example='20', position='Query'),
  q?: string(name='Q', description='Performs a fuzzy match on the Skill name or description.', example='review', position='Query'),
  scope?: string(name='Scope', description='The query scope for Skills. Valid values: `SYSTEM` and `CUSTOM`. If omitted, both official and custom Skills are queried.', example='CUSTOM', position='Query'),
  visibility?: string(name='Visibility', description='Filters Skills by visibility. Common values are `user` and `tenant`.', example='user', position='Query'),
}

model ListSkillsResponseBody = {
  maxResults?: int32(name='MaxResults', description='The number of entries per page for the current cursor-based pagination.', example='20'),
  nextToken?: string(name='NextToken', description='The token for the next page. An empty string is returned if there is no next page.', example='""'),
  pageNumber?: long(name='PageNumber', description='The current page number for compatible page-number-based pagination.', example='1'),
  pageSize?: long(name='PageSize', description='The number of entries per page for compatible page-number-based pagination.', example='20'),
  requestId?: string(name='RequestId', description='The request ID.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  skills?: [ any ](name='Skills', description='The list of Skill summaries. The current public contract does not define a fixed structure for list items. For common fields, see "Supplementary description of response elements".', example='[{"skillId":"skill_example123","name":"code-review","official":false,"description":"A Skill for performing code reviews","iconUrl":"https://example.com/icons/code-review.png","visibility":"user","status":"PUBLISHED","publishedVersion":2,"creatorId":"example-user","createdAt":1760000000000,"canModify":true,"canDelete":true}]'),
  total?: long(name='Total', description='The total number of Skills that match the current visibility and filter conditions.', example='1'),
}

model ListSkillsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListSkillsResponseBody(name='body'),
}

/**
  * @description - Query and filtering: 
  *     - Set `Scope=SYSTEM` to query only official Skills, or `Scope=CUSTOM` to query only custom Skills. If omitted, both official and custom Skills are queried.
  *     - Custom Skills with `user` visibility are visible only to the creator. Skills with `tenant` visibility are visible to the current tenant.
  *     - Filtering by `CreatorId`, `Q`, and `Visibility` is supported. `Q` performs a fuzzy match on the Skill name or description.
  *     - Results are sorted by update time in descending order by default.
  * - Pagination: 
  *     - For cursor-based pagination, use `MaxResults` and `NextToken`. Do not pass `NextToken` for the first query. For subsequent pages, use the token returned in the previous response. When using `NextToken` for subsequent pages, `CreatorId`, `Q`, `Visibility`, `Scope`, and `MaxResults` must remain the same as the previous page. If you change the query conditions, start over from the first page.
  *     - For page-number-based pagination, use `PageNumber` and `PageSize`. If `MaxResults` is explicitly specified, cursor-based pagination takes precedence. If `NextToken` is specified, `PageNumber` is ignored.
  * - Response content: 
  *     - This operation returns only Skill summaries and does not generate Bundle download URLs. To obtain download URLs, call `GetSkill` and specify `Network`.
  * @param request  the request parameters of ListSkills  ListSkillsRequest
  * @return ListSkillsResponse
 */
async function listSkills(request: ListSkillsRequest): ListSkillsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListSkills', 'POST', '/', 'json', false, 'json', request);
}

model UpdateAgentRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  description?: string(name='Description', description='The new description. If not specified, the existing value is retained.', example='Analyzes CR code changes and checks for correctness, security, and maintainability', position='Body'),
  displayName?: string(name='DisplayName', description='The new display name. If not specified, the existing value is retained.', example='CR Code and Security Review Agent', position='Body'),
  expectedVersion?: long(name='ExpectedVersion', description='The expected current configuration revision number. This parameter is omitted by default. For concurrency protection, pass in the `AgentVersion` returned by the most recent `GetAgent` call.', example='2', position='Body'),
  knowledgeBases?: any(name='KnowledgeBases', description='The list of knowledge base bindings, which contains at most one element. If not specified, the existing value is retained. A non-empty array replaces the entire value. Passing `[ ]` removes all bindings.', example='[{"name":"code-review-guidelines"}]', position='Body'),
  name: string(name='Name', description='The name of the Agent to update.

This parameter is required.', example='code-review-agent', minLength=1, maxLength=128, position='Query'),
  skills?: any(name='Skills', description='The list of Skill references. If not specified, the existing value is retained. A non-empty array replaces the entire value. Passing `[ ]` removes all bindings.', example='[{"name":"code-review"}]', position='Body'),
  systemPrompt?: string(name='SystemPrompt', description='The new system prompt. If not specified, the existing value is retained.', example='Check the CR for code defects, security risks, and compatibility issues, and provide actionable suggestions for fixes', position='Body'),
  tools?: any(name='Tools', description='The list of MCP Server and Connector name references. The same array supports both types of entries. Each entry specifies one type of reference. If items is omitted for an MCP entry, all public tools are included. Previously specified items retain their existing values.', example='[{"mcpServerName":"code-repository-mcp"},{"connectorName":"code-review-data"}]', position='Body'),
  visibility?: string(name='Visibility', description='The new visibility scope. Valid values:
- user
- tenant

If not specified, the existing value is retained.', example='tenant', position='Body'),
}

model UpdateAgentResponseBody = {
  agentId?: string(name='AgentId', description='Agent ID。', example='agent_00000000000000000000000000000001'),
  name?: string(name='Name', description='The Agent name.', example='code-review-agent'),
  requestId?: string(name='RequestId', description='The request ID, used for Tracing Analysis and troubleshooting.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  success?: boolean(name='Success', description='Indicates whether the Agent was successfully updated. A successful response always returns `true`. A failure returns an error response.', example='true'),
  updatedAt?: long(name='UpdatedAt', description='The most recent update time, as a UNIX timestamp in milliseconds.', example='1788332700000'),
}

model UpdateAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateAgentResponseBody(name='body'),
}

/**
  * @description - `Name` is used only to locate the Agent and cannot be modified after creation.
  * - Each Agent can be bindded to only one knowledge base.
  * - `Tools` is updated according to the rules below. If `Skills` or `KnowledgeBases` is not specified, the existing value is retained. A non-empty array replaces the entire value. An empty array removes the corresponding binddings. Other optional fields retain their existing values if not specified.
  * @param request  the request parameters of UpdateAgent  UpdateAgentRequest
  * @return UpdateAgentResponse
 */
async function updateAgent(request: UpdateAgentRequest): UpdateAgentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'UpdateAgent', 'POST', '/', 'json', true, 'form', request);
}

model UpdateSkillRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  description?: string(name='Description', description='The updated description of the Skill.', example='A Skill for performing code reviews, security checks, and risk alerts', position='Body'),
  expectedVersion?: long(name='ExpectedVersion', description='The expected version number.', example='2', position='Body'),
  metadata?: any(name='Metadata', description='The updated Skill metadata. The JSON object is replaced as a whole. The content supports exactly one of Transit ID, bundleUrl, or skillMd.', example='{"transitId":"transit_example456"}', position='Body'),
  name: string(name='Name', description='The name of the Skill to update. This parameter is used only to locate the Skill and cannot be used to modify the name.

This parameter is required.', example='code-review', position='Query'),
  visibility?: string(name='Visibility', description='The updated visibility. Valid values: `user` and `tenant`.', example='tenant', position='Body'),
}

model UpdateSkillResponseBody = {
  name?: string(name='Name', description='The Skill name.', example='code-review'),
  requestId?: string(name='RequestId', description='The request ID.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  skillId?: string(name='SkillId', description='Skill ID。', example='skill_example123'),
  success?: boolean(name='Success', description='Returns `true` when the Skill update and optional bundle replacement have been fully committed and confirmed by read-back.', example='true'),
  updatedAt?: long(name='UpdatedAt', description='The time when the Skill was updated, in UNIX millisecond timestamp.', example='1760000200000'),
}

model UpdateSkillResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateSkillResponseBody(name='body'),
}

/**
  * @description - Update rules:
  *   - `Name` is used only to locate the Skill and cannot be modified.
  *   - The caller must be the Skill creator or the tenant root account that has permissions to manage the tenant-level Skill.
  * - Replacement rules:
  *   - `Description` and `Visibility` retain their original values when omitted. Passing `null` is treated the same as omitting the field and cannot be used to clear the original value.
  *   - `Metadata` is replaced as a whole, not merged incrementally. Omitting `Metadata` preserves the original content. When provided, any old fields not included in the new object are deleted.
  *   - When modifying only `Description` or `Visibility`, do not pass `Metadata` or an empty object `{}`. An empty object replaces the entire original Metadata with an empty value.
  * - Content source:
  *   - When replacing the body or bundle, specify exactly one of `skillMd`, `transitId`, or `bundleUrl`.
  *   - For field formats, the Transit upload confirmation process, and `bundleUrl` restrictions of the three sources, refer to CreateSkill. Pass the selected source in `UpdateSkill.Metadata`.
  * @param request  the request parameters of UpdateSkill  UpdateSkillRequest
  * @return UpdateSkillResponse
 */
async function updateSkill(request: UpdateSkillRequest): UpdateSkillResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'UpdateSkill', 'POST', '/', 'json', true, 'form', request);
}

