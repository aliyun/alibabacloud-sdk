/**
 * @summary Stops a session execution or cancels a specified turn.
 *
 * @description If `Params._meta.promptId` is provided, only that turn is canceled. If omitted, the current execution of the session is canceled. To avoid affecting other turns, use the actual `promptId` obtained from the response stream instead of the request `Id`. A cancellation receipt does not mean the turn has ended, nor does it revoke external operations that have already occurred. After calling this operation, continue reading the original response stream or resume reading through `LoadAgentSession` to confirm the desired state of the target turn. Disconnecting the stream connection cannot replace a cancellation request.
 *
 * @param tmpReq CancelAgentSessionRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return CancelAgentSessionResponse
 */
@context("cancelAgentSessionWithContext")
async function cancelAgentSessionWithOptions(tmpReq: CancelAgentSessionRequest, runtime: $RuntimeOptions): CancelAgentSessionResponse {
  tmpReq.validate();
  var request = new CancelAgentSessionShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!$isNull(tmpReq.params)) {
    request.paramsShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.params, 'Params', 'json');
  }
  var body : map[string]any = {};
  if (!$isNull(request.id)) {
    body['Id'] = request.id;
  }
  if (!$isNull(request.jsonrpc)) {
    body['Jsonrpc'] = request.jsonrpc;
  }
  if (!$isNull(request.paramsShrink)) {
    body['Params'] = request.paramsShrink;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'CancelAgentSession',
    version = '2026-07-01',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

