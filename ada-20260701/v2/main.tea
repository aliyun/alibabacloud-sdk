  requestId?: string(name='RequestId', description='The request ID, which is used to locate and troubleshoot the request.', example='0A1B2C3D-4E5F-6789-ABCD-EF0123456789'),
  skillId?: string(name='SkillId', description='The skill ID.', example='skill_example123'),
  success?: boolean(name='Success', description='Indicates whether the operation is successful. true is returned when the skill and its body or bundle are fully created and readable. Business failures are returned in error responses.', example='true'),
  updatedAt?: long(name='UpdatedAt', description='The update time after the skill is created. The value is a UNIX timestamp in milliseconds.', example='1760000100000'),
}

