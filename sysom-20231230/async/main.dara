model CreateCopilotSessionRequest {
  name?: string(name='name', description='不填为 New Session', example='排查 CPU 负载', minLength=1, maxLength=255, position='Body'),
}

model CreateCopilotSessionResponseBody = {
  code?: string(name='code', example='Success'),
  data?: {
    activeTurn?: {
      createdAt?: string(name='createdAt', example='2026-10-29T10:01:00+08:00'),
      finishedAt?: string(name='finishedAt', example='2026-10-29T10:02:00+08:00'),
      inputTokens?: long(name='inputTokens', example='1200'),
      outputTokens?: long(name='outputTokens', example='80'),
      pendingInputId?: string(name='pendingInputId', example='form-001'),
      status?: string(name='status', example='running'),
      turnId?: string(name='turnId', example='d71fc5ceac2949f39a264c8a585f3148'),
      updatedAt?: string(name='updatedAt', example='2026-10-29T10:01:30+08:00'),
    }(name='activeTurn'),
    createdAt?: string(name='createdAt', example='2026-10-29T10:00:00+08:00'),
    cursor?: string(name='cursor', description='十进制事件序号字符串，范围 0..9223372036854775807；避免 JavaScript 精度丢失', example='0', minLength=1, maxLength=19),
    lastTurn?: {
      createdAt?: string(name='createdAt', example='2026-10-29T10:01:00+08:00'),
      finishedAt?: string(name='finishedAt', example='2026-10-29T10:01:00+08:00'),
      inputTokens?: long(name='inputTokens', example='1200'),
      outputTokens?: long(name='outputTokens', example='80'),
      pendingInputId?: string(name='pendingInputId', example='form-001'),
      status?: string(name='status', example='completed'),
      turnId?: string(name='turnId', example='d71fc5ceac2949f39a264c8a585f3148'),
      updatedAt?: string(name='updatedAt', example='2026-10-29T10:01:00+08:00'),
    }(name='lastTurn'),
    name?: string(name='name', example='排查 CPU 负载'),
    scheduledTask?: {
      runId?: string(name='runId', description='本次定时执行的 Run ID', example='run-example-001'),
      scheduledAt?: string(name='scheduledAt', description='计划触发时间，ISO 8601 含时区偏移', example='2026-10-29T09:00:00+08:00'),
      startedAt?: string(name='startedAt', description='Copilot 开始处理时间，ISO 8601 含时区偏移', example='2026-10-29T09:00:00+08:00'),
      taskId?: long(name='taskId', description='任务 ID；任务删除后仍保留', example='42'),
      taskName?: string(name='taskName', description='触发时的任务名称快照', example='每日巡检'),
      timezone?: string(name='timezone', description='任务的 cron 时区', example='Asia/Shanghai'),
    }(name='scheduledTask', description='定时任务触发快照；非定时会话为空'),
    sessionId?: string(name='sessionId', example='c356bc310e4345c3a602a2912322ad21'),
    sessionType?: string(name='sessionType', description='会话初始来源：chat、scheduled_task、alert；后续追问不改变来源', example='openapi'),
    status?: string(name='status', example='active'),
    updatedAt?: string(name='updatedAt', example='2026-10-29T10:00:00+08:00'),
  }(name='data'),
  message?: string(name='message', example='""'),
  requestId?: string(name='requestId', example='5BC79EF5-798B-5499-9683-4E14EBBBF712'),
}

model CreateCopilotSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateCopilotSessionResponseBody(name='body'),
}

/**
  * @description - 本接口仅创建会话，不发送消息，也不触发 Agent 执行。
  * - 创建成功后，使用返回的 sessionId 调用 GenerateCopilotStreamResponse 发送消息。
  * - 会话 ID 由服务端生成，不支持调用方指定。
  * - 每次成功调用均创建一个独立会话。本接口不提供客户端幂等参数，重复调用可能创建多个会话。
  * @param request  the request parameters of CreateCopilotSession  CreateCopilotSessionRequest
  * @return CreateCopilotSessionResponse
 */
async function createCopilotSession(request: CreateCopilotSessionRequest): CreateCopilotSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateCopilotSession', 'POST', '/api/v1/copilot/sessions', 'json', false, 'json', request);
}

