model GetGpuClusterArgsOptionsRequest {
  filterType: string(name='filterType', description='1. Query cluster machine list scenario: Set the retrieval type to comm_instance_id_list or instance_id_list. comm_instance_id_list: Retrieves only the list of machines in the specified cluster that participate in collective communication. instance_id_list: Retrieves the list of all machines in the specified cluster.
2. Query cluster AI task list scenario: Set the retrieval type to comm_task_id_list or task_id_list. comm_task_id_list: Retrieves only the list of tasks in the specified cluster that involve collective communication. task_id_list: Retrieves the list of all tasks in the specified cluster.
3. Query cluster AI job pod list scenario: Set the retrieval type to comm_pod_list or pod_list. comm_pod_list: Retrieves only the list of pods in the specified cluster that participate in collective communication. pod_list: Retrieves the list of all pods in the specified cluster.
4. Query collective communication topology scenario: communication: Retrieves all communication group IDs. channel: Retrieves the channel list under the specified communication group ID. topoType: Retrieves the topology type under the specified channel of the specified communication group ID.

This parameter is required.', example='instance_id_list', position='Query'),
  filterValues?: any(name='filterValues', description='The filter conditions, which is a JSON object. The cluster_id field is required. Other filter conditions support the following values:
- instance_id_list
- comm_instance_id_list
- pod_list
- comm_pod_list
- communication
- task_id_list
- comm_task_id_list
- channel
- topoType', example='{
"cluster_id": "cluster1"
}', position='Query'),
}

model GetGpuClusterArgsOptionsResponseBody = {
  code?: string(name='code', description='The response code, which is Success or Sysom.ServerError.', example='Success  Fail'),
  data?: any(name='data', description='The result of the parameter retrieval.', example='["instance1", "instance2"]'),
  message?: string(name='message', description='The error message returned when the code is not Success.', example='some error msg while fail，“” if success'),
  requestId?: string(name='requestId', description='Id of the request', example='return real request id'),
  total?: int32(name='total', description='The total number of returned items.', example='10'),
}

model GetGpuClusterArgsOptionsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetGpuClusterArgsOptionsResponseBody(name='body'),
}

/**
  * @description After you install the component for the target ACK cluster:
  * 1. When the cluster is managed for the first time, the component is installed on all ECS instances currently in the cluster. If the cluster has more than 50 nodes, only 50 nodes are installed in the first batch.
  * 2. The operating system console periodically checks the scaling status of the managed cluster. When a new ECS instance is added to the cluster, the operating system console automatically installs the component on the instance without user intervention.
  * @param request  the request parameters of GetGpuClusterArgsOptions  GetGpuClusterArgsOptionsRequest
  * @return GetGpuClusterArgsOptionsResponse
 */
async function getGpuClusterArgsOptions(request: GetGpuClusterArgsOptionsRequest): GetGpuClusterArgsOptionsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetGpuClusterArgsOptions', 'GET', '/api/v1/aiTopology/topology/listClusterTopologyOptions', 'json', false, 'json', request);
}

