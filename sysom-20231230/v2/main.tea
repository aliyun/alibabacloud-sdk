  message?: string(name='message', description='The error message returned when the code is not Success.', example='some error msg while fail，“” if success'),
  requestId?: string(name='requestId', description='Id of the request', example='return real request id'),
  total?: int32(name='total', description='The total number of returned entries.', example='10'),
}

