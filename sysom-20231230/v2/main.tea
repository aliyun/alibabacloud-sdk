  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'GetListGpuCluster',
    version = '2023-12-30',
    protocol = 'HTTPS',
    pathname = `/api/v1/aiTopology/topology/listCluster`,
