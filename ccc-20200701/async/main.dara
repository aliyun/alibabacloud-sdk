          channelState?: string(name='ChannelState', description='The status of the voice channel.', example='CREATED'),
          destination?: string(name='Destination', description='The callee of the voice channel.', example='1390501****'),
          index?: int32(name='Index', description='An auto increment ID generated by the system. Customers do not need to concern themselves with it.', example='1'),
          jobId?: string(name='JobId', description='The call ID.', example='job-6538214103685****'),
          originator?: string(name='Originator', description='The originator of the channel.', example='0830019****'),
          releaseInitiator?: string(name='ReleaseInitiator', description='The party that initiated the release of the voice channel, indicating who hung up first.', example='1390501****'),
