          originator?: string(name='Originator', description='The calling party of the voice channel.', example='1318888****'),
          releaseInitiator?: string(name='ReleaseInitiator', description='The party that initiated the release of the call channel, indicating who first initiated the hang-up for this call channel.', example='1390501****'),
