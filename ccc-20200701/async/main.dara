      jobId?: string(name='JobId', description='Call ID.', example='job-6538214103685****'),
    }(name='CallContext', description='Call context environment.'),
    userContext?: {
      breakCode?: string(name='BreakCode', description='Break status code, which can be either system-defined or customer-defined. System-defined break codes include: Warm-up (temporary break state after an agent is published and before becoming idle), RingingTimeout (break caused by agent ringing timeout), and RejectCall (break caused by agent call rejection). There are no restrictions on customer-defined status codes; customers can define them as needed for their business.', example='Warm-up'),
      deviceId?: string(name='DeviceId', description='Device ID, which is the identity ID of a browser-based Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time.', example='ACC-YUNBS-1.0.10-****'),
      extension?: string(name='Extension', description='Agent extension number.', example='8032****'),
      heartbeat?: long(name='Heartbeat', description='The time when the last heartbeat was received from the agent, formatted as a UNIX timestamp in milliseconds.', example='1609136956378'),
