      accessChannelTypeDetailList?: [ 
        {
          accessChannelType?: string(name='AccessChannelType', description='Channel Type.', example='Web'),
          callsOffered?: long(name='CallsOffered', description='Number of assigned sessions.', example='5'),
        }
      ](name='AccessChannelTypeDetailList', description='Statistics for each channel.'),
