      channelContexts?: [ 
        {
          callType?: string(name='CallType', description='The call type of the channel.', example='INTERCEPT'),
          channelFlags?: string(name='ChannelFlags', description='话务通道标志。', example='无'),
          channelId?: string(name='ChannelId', description='话务通道 ID。', example='ch:user:1390501****->8032****:1609138902226:job-653821410368****'),
          channelState?: string(name='ChannelState', description='[responses_200_schema_properties_Data_properties_CallContext_properties_ChannelContexts_items_properties_CallType_enumValueTitles_COACH]Coaching', example='ANSWERED'),
          destination?: string(name='Destination', description='[responses_200_schema_properties_Data_properties_CallContext_properties_ChannelContexts_items_properties_CallType_enumValueTitles_BARGE]Barge-in', example='1390501****'),
          index?: int32(name='Index', description='An auto-incremented ID assigned by the system. Customers do not need to concern themselves with this value.', example='10'),
          jobId?: string(name='JobId', description='通话 ID。', example='job-6538214103685****'),
          originator?: string(name='Originator', description='话务通道的主叫方。', example='0830019****'),
          releaseInitiator?: string(name='ReleaseInitiator', description='[responses_200_schema_properties_Data_properties_CallContext_properties_ChannelContexts_items_properties_CallType_type]string', example='1390501****'),
          releaseReason?: string(name='ReleaseReason', description='话务通道的挂断原因，表示当前话务通道为什么会被挂断，取值来自 SIP 协议中定义的响应码，请客户参考 SIP 协议分析挂断原因。', example='404 - No destination'),
          skillGroupId?: string(name='SkillGroupId', description='话务通道关联的技能组 ID，呼入场景下，关联的技能组 ID 由 IVR 中转人工模块配置的技能组决定，呼出场景下，关联的技能组 ID 为座席签入的第一个技能组的 ID。', example='skillgroup@ccc-test'),
          timestamp?: long(name='Timestamp', description='话务通道最近一次状态变化的时间戳，格式是 Unix 时间戳，单位毫秒。', example='1609138903315'),
          userExtension?: string(name='UserExtension', description='话务通道关联的坐席的分机号。', example='8032****'),
          userId?: string(name='UserId', description='话务通道关联的坐席 ID，如果是客户的话务通道，该字段为空。', example='agent@ccc-test'),
        }
      ](name='ChannelContexts', description='The list of channels.'),
      instanceId?: string(name='InstanceId', description='Instance ID.', example='ccc-test'),
      jobId?: string(name='JobId', description='The call ID.', example='job-6538214103685****'),
    }(name='CallContext', description='Call context environment.'),
    userContext?: {
      breakCode?: string(name='BreakCode', description='Break status code, which can be either System-defined or Custom-defined. System-defined break codes include: Warm-up (temporary break state after an agent is published and before becoming idle), RingingTimeout (break caused by agent ringing timeout), and RejectCall (break caused by agent call rejection). There are no restrictions on Custom-defined status codes, and customers can define them according to their business needs.', example='Warm-up'),
      deviceId?: string(name='DeviceId', description='Device ID, which is the identity ID of a browser-based Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time.', example='ACC-YUNBS-1.0.10-****'),
      extension?: string(name='Extension', description='Agent extension number.', example='8032****'),
      heartbeat?: long(name='Heartbeat', description='The time when the last heartbeat was received from the agent, formatted as a UNIX timestamp in milliseconds.', example='1609136956378'),
      instanceId?: string(name='InstanceId', description='Instance ID.', example='ccc-test'),
      jobId?: string(name='JobId', description='Call ID.', example='job-6538214103685****'),
      mobile?: string(name='Mobile', description='The agent\\\\"s personal phone number.', example='1324730****'),
      outboundScenario?: boolean(name='OutboundScenario', description='Indicates whether the agent is in outbound-only mode.', example='false'),
      reserved?: long(name='Reserved', description='The time when the agent was most recently reserved. Being reserved means an incoming call will be assigned to the agent shortly. The format is a UNIX timestamp in milliseconds.', example='1609136956378'),
      signedSkillGroupIdList?: [ string ](name='SignedSkillGroupIdList', description='List of skill group IDs that the agent has signed into.'),
