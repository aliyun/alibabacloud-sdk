          skillGroupId?: string(name='SkillGroupId', description='The skill group ID associated with the voice channel. In inbound scenarios, the associated skill group ID is determined by the skill group configured in the IVR transfer-to-agent module. In outbound scenarios, the associated skill group ID is the first skill group that the agent signed into.', example='skillgroup@ccc-test'),
          timestamp?: long(name='Timestamp', description='The UNIX timestamp of the most recent status change of the voice channel, in milliseconds.', example='1609138903315'),
          userExtension?: string(name='UserExtension', description='The extension number of the agent associated with the channel.', example='8032****'),
