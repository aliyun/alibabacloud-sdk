model InitiateAttendedTransferRequest {
  callPriority?: int32(name='CallPriority', description='The queuing priority when transferring to a skill group queue. Valid values range from 0 to 9, where 0 is the highest priority and 9 is the lowest.', example='5', position='Query'),
  deviceId?: string(name='DeviceId', description='Device ID. This parameter is meaningless and can be filled with any value.', example='ACC-YUNBS-1.0.10-****', position='Query'),
  instanceId: string(name='InstanceId', description='Instance ID.

This parameter is required.', example='ccc-test', position='Query'),
  jobId: string(name='JobId', description='The call ID.

This parameter is required.', example='job-6538214103685****', position='Query'),
  queuingOverflowThreshold?: long(name='QueuingOverflowThreshold', description='The queuing overflow threshold when the transfer target is a skill group queue. The default value is 0, which means no overflow occurs.', example='0', position='Query'),
  queuingTimeoutSeconds?: long(name='QueuingTimeoutSeconds', description='The queuing timeout period in seconds when the transfer target is a skill group queue.', example='10', position='Query'),
  routingType?: string(name='RoutingType', description='The call assignment type. Valid values are Automatic or Manual. If this parameter is empty, the default value is Automatic, which is also the current system\\\\"s default behavior. When Manual is selected, you must invoke APIs such as ClaimCall to assign the call to a specific agent.', example='Automatic', position='Query'),
  strategyName?: string(name='StrategyName', description='The policy name for agent assignment when transferring to a skill group queue.', example='MOST_IDLE，MOST_SKILLED，MOST_ACQUAINTED，CUSTOMIZED等', position='Query'),
  strategyParams?: string(name='StrategyParams', description='The policy parameters for agent assignment when transferring to a skill group queue.', example='当分配策略为CUSTOMIZED时，本参数的内容为如下格式：
 {
  "functionId": "512fed64-e379-400f-a1a5-14d5730xxxxx",
  "functionName": "routing-strategy-test-2"
}', position='Query'),
  tags?: string(name='Tags', description='Ingest endpoint data, primarily used for extension requirements. Regular users do not need to concern themselves with this.', example='a=b', position='Query'),
  timeoutSeconds?: int32(name='TimeoutSeconds', description='Timeout duration for the consultation transfer, in seconds. If the transferee does not answer within the specified time, the call is disconnected. This field is optional. Default value is 30 seconds.', example='60', position='Query'),
  transferee: string(name='Transferee', description='The transferee, which can be an agent ID or a skill group ID.

This parameter is required.', example='agent2@ccc-test', position='Query'),
  transfereeType?: string(name='TransfereeType', description='The destination type for the transfer. Valid values are AGENT, SKILL_GROUP, and EXTERNAL. If this parameter is not provided, the system determines the destination type based on the format of the target number. If inaccurate detection occurs, explicitly specify this parameter.', example='SKILL_GROUP', position='Query'),
  transferor?: string(name='Transferor', description='The party initiating the transfer. When transferring to an external number, this parameter specifies the caller number. This parameter is invalid when transferring to an internal agent or skill group; in such cases, the initiator is determined by the UserId parameter.', example='无', position='Query'),
  userId?: string(name='UserId', description='The agent ID initiating the consultation transfer.', example='agent@ccc-test', position='Query'),
}

model InitiateAttendedTransferResponseBody = {
  code?: string(name='Code', description='Response code.', example='OK'),
  data?: {
    callContext?: {
      callType?: string(name='CallType', description='Call type.', example='OUTBOUND'),
      channelContexts?: [ 
        {
          callType?: string(name='CallType', description='The call type of the call channel.', example='OUTBOUND'),
          channelFlags?: string(name='ChannelFlags', description='Channel flags.', example='MONITORING'),
          channelId?: string(name='ChannelId', description='Channel ID.', example='ch:user:139xxxx0501->80326034:1609138902226:job-6538214103685****'),
          channelState?: string(name='ChannelState', description='The status of the call channel.', example='ANSWERED'),
          destination?: string(name='Destination', description='The callee of the call channel.', example='1390501****'),
          index?: int32(name='Index', description='Records the order in which this channel was created during the call.', example='10'),
          jobId?: string(name='JobId', description='The call ID.', example='job-6538214103685****'),
          originator?: string(name='Originator', description='The originator of the channel.', example='0830019****'),
          releaseInitiator?: string(name='ReleaseInitiator', description='The party that initiated the release of the call channel, indicating who hung up first.', example='1390501****'),
          releaseReason?: string(name='ReleaseReason', description='The hang-up reason for the voice channel, indicating why the current voice channel was disconnected. The value comes from the response codes defined in the SIP protocol. Customers should refer to the SIP protocol to analyze the hang-up reason.', example='404 - No destination'),
          skillGroupId?: string(name='SkillGroupId', description='The skill group ID associated with the voice channel. In inbound scenarios, the associated skill group ID is determined by the agent transfer module configured in the IVR. In outbound scenarios, the associated skill group ID is the first skill group the agent signed into.', example='skillgroup@ccc-test'),
          timestamp?: long(name='Timestamp', description='The UNIX timestamp of the most recent status change of the voice channel, in milliseconds.', example='1609138903315'),
          userExtension?: string(name='UserExtension', description='The extension number of the agent associated with the channel.', example='8032****'),
          userId?: string(name='UserId', description='The agent ID associated with the channel. This field is empty for a Customer channel.', example='agent@ccc-test'),
        }
      ](name='ChannelContexts', description='List of call channels.'),
      instanceId?: string(name='InstanceId', description='Instance ID.', example='ccc-test'),
      jobId?: string(name='JobId', description='Call ID.', example='job-6538214103685****'),
    }(name='CallContext', description='Call context environment.'),
    contextId?: long(name='ContextId', description='System auto increment ID. Customers do not need to concern themselves with this field.', example='103655'),
    userContext?: {
      breakCode?: string(name='BreakCode', description='Break status code, which can be either System-defined or Custom-defined. System-defined break codes include: Warm-up (temporary break state after an agent is published and before becoming idle), RingingTimeout (break caused by agent ringing timeout), and RejectCall (break caused by agent call rejection). There are no restrictions on Custom-defined status codes; customers can define them as needed for their business.', example='Warm-up'),
      deviceId?: string(name='DeviceId', description='Device ID, the identity ID of a browser-based Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time.', example='ACC-YUNBS-1.0.10-****'),
      extension?: string(name='Extension', description='The agent\\\\"s extension number.', example='8032****'),
      heartbeat?: long(name='Heartbeat', description='The time when the last heartbeat was received from the agent, in UNIX timestamp format with millisecond precision.', example='1609136956378'),
      instanceId?: string(name='InstanceId', description='Instance ID.', example='ccc-test'),
      jobId?: string(name='JobId', description='Call ID.', example='job-6538214103685****'),
      mobile?: string(name='Mobile', description='The agent\\\\"s personal phone number.', example='1324730****'),
      outboundScenario?: boolean(name='OutboundScenario', description='Indicates whether the agent is in outbound-only mode.', example='false'),
      reserved?: long(name='Reserved', description='The most recent time when the agent was reserved. Being reserved means an incoming call will be assigned to the agent shortly. The value is formatted as a UNIX timestamp in milliseconds.', example='1609136956378'),
      signedSkillGroupIdList?: [ string ](name='SignedSkillGroupIdList', description='List of skill group IDs that the agent has signed into.'),
      userId?: string(name='UserId', description='Agent ID.', example='agent@ccc-test'),
      userState?: string(name='UserState', description='Agent status.', example='TALKING'),
      workMode?: string(name='WorkMode', description='Work mode.', example='ON_SITE'),
    }(name='UserContext', description='Agent context environment.'),
  }(name='Data', description='Data.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP status code.', example='200'),
  message?: string(name='Message', description='Response message.', example='无'),
  params?: [ string ](name='Params', description='List of response parameters.'),
  requestId?: string(name='RequestId', description='Request ID.', example='EEEE671A-3E24-4A04-81E6-6C4F5B39DF75'),
}

