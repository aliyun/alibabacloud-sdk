}

model ReleaseCallResponseBody = {
  code?: string(name='Code', description='Response code.', example='OK'),
  data?: {
    callContext?: {
      channelContexts?: [ 
        {
          callType?: string(name='CallType', description='The call type of the channel.', example='OUTBOUND'),
          channelId?: string(name='ChannelId', description='The channel ID.', example='ch:user:1390501****->8032****:1609138902226:job-653821410368****'),
          channelState?: string(name='ChannelState', description='The status of the voice channel.', example='CREATED'),
          channelVariables?: string(name='ChannelVariables', description='Channel-associated data', example='a=b;c=d;'),
          destination?: string(name='Destination', description='The callee of the voice channel.', example='1390501****'),
          jobId?: string(name='JobId', description='The call ID.', example='job-6538214103685****'),
          originator?: string(name='Originator', description='The calling party of the call channel.', example='0830019****'),
          releaseInitiator?: string(name='ReleaseInitiator', description='The party that initiated the hang-up of the call channel, indicating who first terminated the call.', example='1390501****'),
          releaseReason?: string(name='ReleaseReason', description='The reason for releasing the voice channel, indicating why the current voice channel was disconnected. The value is derived from the response codes defined in the SIP protocol. Customers can refer to the SIP protocol to analyze the disconnection reason.', example='404 - No destination'),
          timestamp?: long(name='Timestamp', description='The UNIX timestamp of the most recent status change of the channel, in milliseconds.', example='1609138903315'),
          userExtension?: string(name='UserExtension', description='The extension number of the agent associated with the channel.', example='8032****'),
          userId?: string(name='UserId', description='The agent ID associated with the call channel. This field is empty if the call channel belongs to a Customer.', example='agent@ccc-test'),
        }
      ](name='ChannelContexts', description='List of call channels.'),
      instanceId?: string(name='InstanceId', description='Instance ID.', example='ccc-test'),
      jobId?: string(name='JobId', description='Call ID.', example='job-6538214103685****'),
    }(name='CallContext', description='Call context environment.'),
    contextId?: long(name='ContextId', description='System auto-increment ID. Customers do not need to concern themselves with this.', example='123456'),
    userContext?: {
      breakCode?: string(name='BreakCode', description='Break status code, which can be either system-defined or customer-defined. System-defined break codes include: Warm-up (temporary break state after agent is published and before becoming idle), RingingTimeout (break caused by agent ringing timeout), and RejectCall (break caused by agent call rejection). There are no restrictions on customer-defined status codes; customers can define them according to their business needs.', example='Warm-up'),
      deviceId?: string(name='DeviceId', description='Device ID, which is the identity of a browser-based Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time.', example='ACC-YUNBS-1.0.10-****'),
      extension?: string(name='Extension', description='Agent extension number.', example='8032****'),
      instanceId?: string(name='InstanceId', description='Instance ID.', example='ccc-test'),
      jobId?: string(name='JobId', description='Call ID.', example='job-6538214103685****'),
      outboundScenario?: boolean(name='OutboundScenario', description='Indicates whether the agent is in outbound-only mode.', example='false'),
      signedSkillGroupIdList?: [ string ](name='SignedSkillGroupIdList', description='List of skill group IDs that the agent has signed into.'),
      userId?: string(name='UserId', description='Agent ID.', example='agent@ccc-test'),
      userState?: string(name='UserState', description='Agent status.', example='BREAK'),
      workMode?: string(name='WorkMode', description='Work mode.', example='ON_SITE'),
    }(name='UserContext', description='Agent context environment.'),
  }(name='Data', description='Data.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP status code.', example='200'),
  message?: string(name='Message', description='Response message.', example='无'),
  params?: [ string ](name='Params', description='List of response parameters.'),
  requestId?: string(name='RequestId', description='Request ID.', example='EEEE671A-3E24-4A04-81E6-6C4F5B39DF75'),
