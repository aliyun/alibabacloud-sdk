      outboundScenario?: boolean(name='OutboundScenario', description='Indicates whether the agent is in outbound-only mode.', example='false'),
      reserved?: long(name='Reserved', description='The UNIX timestamp in milliseconds when the agent was most recently reserved. Being reserved means an incoming call will be assigned to the agent shortly.', example='1609136956370'),
