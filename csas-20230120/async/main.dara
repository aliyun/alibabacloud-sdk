      browserAlertTitle?: string(name='BrowserAlertTitle', description='The title of the block page.', example='无权限访问'),
      reportButtonText?: string(name='ReportButtonText', description='The text of the report approval button.', example='前往报备'),
    }(name='BlockTextZh', description='The Chinese content.'),
  }(name='BlockContent', description='The content displayed in the client interception pop-up window.'),
  enabled?: boolean(name='Enabled', description='Specifies whether the feature is enabled. Valid values:
- **true**: Enabled. Users are redirected to an interception page when they access an unauthorized application.
