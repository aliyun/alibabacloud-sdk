This parameter is required.', example='1', position='Query'),
  department?: string(name='Department', description='The department name. Matches any level of department in the organizational structure to which the user belongs. Specify only the department name itself, not the full path of the organizational structure.', example='R&D Department', position='Query'),
  devTag?: string(name='DevTag', description='The unique identifier of the user endpoint device. Exact match is used. The value can be up to 64 characters in length. You can obtain the value from the following operation:
- [ListUserDevices](~~ListUserDevices~~): lists user endpoint devices.', example='36efa42d-2c32-c4dc-e3fc-8541e33a****', position='Query'),
  devType?: string(name='DevType', description='The operating system type of the user endpoint device. Valid values:
- **windows**: Windows. Currently, vulnerability scanning supports only Windows.', example='windows', position='Query'),
  hostname?: string(name='Hostname', description='The hostname of the user endpoint device. Fuzzy match is supported. The value can be up to 64 characters in length.', example='DESKTOP-8A3F', position='Query'),
  pageSize: long(name='PageSize', description='The number of entries per page in a paged query. Valid values: 1 to 1000.

This parameter is required.', example='10', position='Query'),
  saseUserId?: string(name='SaseUserId', description='The user ID. Exact match is used. You can obtain the value from the following operations:
- [ListUserDevices](~~ListUserDevices~~): lists user endpoint devices.
- [GetUserDevice](~~GetUserDevice~~): queries the details of a user endpoint device.', example='su_e8f218fb171edd167c2ad917d21f53148bdefc510ca1f3c3cc0249d3643d****', position='Query'),
  status?: string(name='Status', description='Filters by remediation status. Valid values:
- **Pending**: Pending remediation.
- **Downloading**: Patch is being downloaded.
- **Installing**: Patch is being installed.
- **InstalledNotRestart**: Installed, waiting for the device to restart to take effect.
- **Success**: Remediated. The patch has been installed and the device has been restarted.
- **Failed**: Remediation failed. The patch download or installation failed.', example='Pending', position='Query'),
  updateId?: string(name='UpdateId', description='The patch ID corresponding to the vulnerability. The value can be up to 64 characters in length. You can obtain the value from the following operation:
- [ListVulnerabilities](~~ListVulnerabilities~~): lists vulnerabilities.', example='9f8c1d2e-4b7a-4c31-9e05-6d2f8a71****', position='Query'),
  username?: string(name='Username', description='The username. Fuzzy match is supported. The value can be up to 128 characters in length and can contain Chinese characters, uppercase and lowercase letters, digits, periods (.), underscores (_), asterisks (*), hyphens (-), at signs (@), spaces, middle dots (·), and parentheses.', example='John Smith', position='Query'),
}

model ListDevicesForVulnerabilityResponseBody = {
  devices?: [ 
    {
      department?: string(name='Department', description='The department name to which the user belongs. Multiple departments are separated by commas (,). The value is the nearest department name in the organizational structure, not the full path.', example='R&D Department,Security Team'),
      devTag?: string(name='DevTag', description='The unique identifier of the user endpoint device.', example='36efa42d-2c32-c4dc-e3fc-8541e33a****'),
      devType?: string(name='DevType', description='The operating system type of the user endpoint device. Valid values:
- **windows**: Windows. Currently, vulnerability scanning supports only Windows.', example='windows'),
      fixTaskId?: string(name='FixTaskId', description='The ID of the most recent vulnerability remediation task for this vulnerability. An empty string is returned if no remediation has been issued.', example='vul-fix-task-2f5c8e1a7b94****'),
      hostname?: string(name='Hostname', description='The hostname of the user endpoint device.', example='DESKTOP-8A3F'),
      isExpired?: boolean(name='IsExpired', description='Indicates whether the most recent remediation has timed out. The value true is returned when the Status is Downloading or Installing and more than 24 hours have elapsed since LastFixTime, indicating that the device has not reported remediation results for an extended period and remediation needs to be reissued. Valid values:
- **true**: Timed out.
- **false**: Not timed out.', example='false'),
      lastFixTime?: long(name='LastFixTime', description='The time when the most recent remediation was issued to the user endpoint device. The value is a UNIX timestamp in seconds. The value 0 is returned if no remediation has been issued.', example='1786291200'),
