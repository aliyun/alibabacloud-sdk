        right?: float(name='Right', description='This parameter takes effect when Mode is set to top-right or bottom-right. The right margin.', example='0'),
        top?: float(name='Top', description='This parameter takes effect when Mode is set to top-left or top-right. The top margin.', example='0'),
      }(name='Margin', description='This parameter takes effect when Mode is set to top-left, top-right, bottom-left, or bottom-right. The margin settings.'),
      mode?: string(name='Mode', description='The display mode of the text watermark. Valid values:', example='pos'),
      opacity?: int32(name='Opacity', description='The opacity of the text watermark. Valid values: 1 to 255. A larger value indicates lower transparency.', example='255'),
      posAx?: float(name='PosAx', description='The horizontal anchor point of the text watermark.
Valid values: 0 to 1. When (PosAx, PosAy) is set to (0, 0), the text is drawn with the upper-left corner as the anchor point. When the value is 0.5, the text is drawn at the center point. When (PosAx, PosAy) is set to (1, 1), the text is drawn with the lower-right corner as the anchor point.', example='0'),
      posAy?: float(name='PosAy', description='The vertical anchor point of the text watermark.
