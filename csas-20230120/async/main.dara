      }(name='Margin', description='This parameter takes effect when Mode is set to top-left, top-right, bottom-left, or bottom-right. The margin settings.'),
      mode?: string(name='Mode', description='The display mode of the text watermark. Valid values:

- **pos**: fixed position, with the upper-left corner as the origin.
- **bottom-right**: lower-left mode.', example='bottom-right'),
      opacity?: int32(name='Opacity', description='The opacity of the text watermark. Valid values: 1 to 255. A larger value indicates lower transparency.', example='255'),
      posX?: int32(name='PosX', description='This parameter takes effect when Mode is set to pos. Specifies the horizontal position of the visible watermark in pixels, with the upper-left corner as the origin.', example='10'),
      posY?: int32(name='PosY', description='This parameter takes effect when Mode is set to pos. Specifies the vertical position of the visible watermark in pixels, with the upper-left corner as the origin.', example='10'),
