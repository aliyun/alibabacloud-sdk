      scanTime?: long(name='ScanTime', description='The time when the vulnerability was first detected on the user endpoint device. The value is a UNIX timestamp in seconds.', example='1786291200'),
      status?: string(name='Status', description='The remediation status. Valid values:
- **Pending**: Pending remediation.
- **Downloading**: Patch is being downloaded.
- **Installing**: Patch is being installed.
- **InstalledNotRestart**: Installed, waiting for the device to restart to take effect.
- **Success**: Remediated. The patch has been installed and the device has been restarted.
- **Failed**: Remediation failed. The patch download or installation failed.', example='Pending'),
      username?: string(name='Username', description='The username.', example='John Smith'),
    }
  ](name='Devices', description='The list of user endpoint devices.'),
  requestId?: string(name='RequestId', description='The request ID.', example='3D7EC0AF-DB2A-5D9C-90EC-F090A6BAAEA7'),
  totalNum?: long(name='TotalNum', description='The total number of user endpoint devices that match the query conditions.', example='37'),
}

