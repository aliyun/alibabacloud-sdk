      posX?: long(name='PosX', description='This parameter takes effect when Mode is set to pos. Specifies the horizontal position of the text watermark in pixels, with the upper-left corner as the origin.', example='0'),
      posY?: long(name='PosY', description='This parameter takes effect when Mode is set to pos. Specifies the vertical position of the text watermark in pixels, with the upper-left corner as the origin.', example='0'),
      spaceX?: long(name='SpaceX', description='This parameter takes effect when Mode is set to repeat. Specifies the horizontal spacing for tiled text watermarks.', example='30'),
      spaceY?: long(name='SpaceY', description='This parameter takes effect when Mode is set to repeat. Specifies the vertical spacing for tiled text watermarks.', example='0'),
      visible?: boolean(name='Visible', description='The visibility. Valid values:', example='true'),
      visibleText?: string(name='VisibleText', description='The text watermark content. The format is a UTF-8 string.', example='WatermarkText'),
    }(name='TextVisibleControl', description='The control parameters for image text watermarks.'),
  }(name='ImageControl', description='The image watermark control parameters.', shrink='json', position='Body'),
  imageEmbedJpegQuality?: long(name='ImageEmbedJpegQuality', description='The image watermark parameter that specifies the expected JPEG compression quality factor of the output image. Default value: 95. Valid values: 1 to 100.', example='95', position='Body'),
  imageEmbedLevel?: long(name='ImageEmbedLevel', description='The image watermark parameter. A larger value indicates higher robustness but lower visual quality. Default value: 2. Valid values: 0 to 4.', example='2', position='Body'),
