  dnsConfig?: {
    dnsServers?: [ string ](name='DnsServers', description='An array of DNS server addresses. The gateway preferentially uses the DNS servers configured here to resolve internal domain names.'),
  }(name='DnsConfig', description='The DNS configuration.'),
  jsHookConfig?: {
    mode?: string(name='Mode', description='The mode for rewriting internal network requests in JavaScript. The default value is **disabled**. Valid values:

- **disabled**: Disables traffic redirection for JavaScript.

- **whitelist**: Enables the whitelist mode to redirect traffic as needed.', example='disabled'),
    replaceRules?: [
      PAL7ConfigReplaceRule
    ](name='ReplaceRules', description='An array of rules for rewriting internal network requests in JavaScript.'),
  }(name='JsHookConfig', description='The configuration for rewriting internal network requests in JavaScript.'),
  proxyDomainTypes?: bytes(name='ProxyDomainTypes', description='The type of the proxy domain name. Valid values:

- **automatic**: Uses a mapped proxy domain name.

- **custom**: Uses a custom proxy domain name.', example='automatic'),
  requestHeaderRewriteConfig?: {
    ops?: [
      PAL7ConfigRewriteOp
    ](name='Ops', description='An array of rewrite operations.'),
  }(name='RequestHeaderRewriteConfig', description='The rules for rewriting HTTP request headers.'),
  requestQueryRewriteConfig?: {
    ops?: [
      PAL7ConfigRewriteOp
    ](name='Ops', description='An array of rewrite operations.'),
  }(name='RequestQueryRewriteConfig', description='The configuration for rewriting HTTP request query parameters.'),
  responseHeaderRewriteConfig?: {
    ops?: [
      PAL7ConfigRewriteOp
    ](name='Ops', description='An array of rewrite operations.'),
  }(name='ResponseHeaderRewriteConfig', description='The configuration for rewriting HTTP response headers.'),
  responseRewriteConfig?: {
    mode?: string(name='Mode', description='The rewrite mode. The default value is **auto**. Valid values:

- **disabled**: Disables rewriting of internal domain names in HTML.

- **auto**: Enables the automatic mode. The system automatically detects and rewrites internal domain names in HTML.', example='auto'),
    replaceRules?: [
      PAL7ConfigReplaceRule
    ](name='ReplaceRules', description='An array of rewrite rules.'),
  }(name='ResponseRewriteConfig', description='The configuration for rewriting internal domain names in HTML.'),
}

model PAL7ConfigReplaceRule {
