      fontColor?: string(name='FontColor', description='The font color of the text watermark. The format is 0xFFFFFF or #FFFFFF RGB color format. For example, 0x000000 or #000000 indicates black.', example='#FF0000'),
      fontSize?: long(name='FontSize', description='The font size of the text watermark. A larger value indicates a larger font.', example='30'),
