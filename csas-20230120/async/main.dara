}

model PAL7Config {
  bypassConfig?: {
    appBypassFroms?: [ string ](name='AppBypassFroms', description='An array of source IP address ranges that are allowed to anonymously access the application.'),
    mode?: string(name='Mode', description='The anonymous access mode. The default value is **disabled**. Valid values:

- **disabled**: Disables anonymous access.

- **url**: Sets anonymous access at the URL level.

- **app**: Sets anonymous access at the application level.', example='disabled'),
    urlBypassRules?: [ 
      {
        froms?: [ string ](name='Froms', description='An array of source IP address ranges that are allowed to anonymously access the application paths.'),
        paths?: [ string ](name='Paths', description='The URL paths that allow anonymous access.'),
      }
    ](name='UrlBypassRules', description='An array of rules for anonymous access to URLs.'),
  }(name='BypassConfig', description='The configuration for anonymous access.'),
