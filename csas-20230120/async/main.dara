    }(name='MetadataControl', description='The metadata control parameters.'),
    textVisibleControl?: {
      fontColor?: string(name='FontColor', description='The font color of the text watermark. The format is 0xFFFFFF or #FFFFFF RGB color format.', example='#FF0000'),
      fontSize?: int32(name='FontSize', description='The font size. Valid values: **0** to **72**.', example='30'),
