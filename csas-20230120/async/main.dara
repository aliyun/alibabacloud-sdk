      scope?: string(name='Scope', description='The peripheral filing granularity. This parameter is required when PolicyType is set to PeripheralBlock. Currently, only Channel is supported, which indicates filing by peripheral channel.', example='Channel'),
      softwareId?: string(name='SoftwareId', description='The blocked software ID. This parameter is required when PolicyType is set to SoftwareBlock.', example='swb-c717ee516145****'),
    }
