import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hangzhou' = 'csas.aliyuncs.com',
    'public' = 'csas.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('csas', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AIUsageLimitPolicy {
  description?: string(name='Description', description='A brief description of the policy\\\\"s purpose or scope.'),
  gmtCreate?: string(name='GmtCreate', description='The timestamp (in UTC) when the policy was created, formatted as `YYYY-MM-DDThh:mm:ssZ`. This is a system-generated, read-only property.'),
  gmtModified?: string(name='GmtModified', description='The timestamp (in UTC) when the policy was last modified, formatted as `YYYY-MM-DDThh:mm:ssZ`. This is a system-generated, read-only property.'),
  limitPolicyId?: string(name='LimitPolicyId', description='The unique identifier for the usage limit policy. This is a system-generated, read-only value.'),
  limitValue?: long(name='LimitValue', description='The maximum value for the specified `MetricType` allowed within the `ResetPeriod`. Once this limit is reached, further requests are throttled or rejected.'),
  metricType?: string(name='MetricType', description='The type of metric the limit applies to, such as the number of API requests, tokens processed, or compute units consumed.'),
  name?: string(name='Name', description='A user-friendly name for the policy. This helps you identify the policy in a list.'),
  priority?: int32(name='Priority', description='The priority of the policy, used to determine the evaluation order when multiple policies apply to the same request. A lower number indicates a higher priority.'),
  resetPeriod?: string(name='ResetPeriod', description='The time window during which the usage count is accumulated before it resets. For example: `Hour`, `Day`, or `Month`.'),
  serviceIds?: [ string ](name='ServiceIds', description='A list of service IDs that this policy applies to. The policy is enforced only for requests made to these services.'),
  status?: string(name='Status', description='The status of the policy. Valid values are `Enabled` and `Disabled`. A disabled policy is not enforced.'),
  userGroupIds?: [ string ](name='UserGroupIds', description='A list of user group IDs that this policy applies to. The policy is enforced only for users who belong to these groups.'),
}

