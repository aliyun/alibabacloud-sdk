          alarmEventNameDisplay?: string(name='AlarmEventNameDisplay', description='The display name of the alerting event.', example='Login with unusual location'),
          alarmEventType?: string(name='AlarmEventType', description='The event type of the alerting event.', example='Unusual Logon'),
          alarmEventTypeDisplay?: string(name='AlarmEventTypeDisplay', description='The display name of the alerting event type.', example='Unusual Logon'),
          alarmUniqueInfo?: string(name='AlarmUniqueInfo', description='The unique ID of the alert event.', example='8df914418f****'),
          appName?: string(name='AppName', description='The name of the application to which the alerting event belongs.', example='dfield-cloud-service-prod'),
          autoBreaking?: boolean(name='AutoBreaking', description='Indicates whether automatic defense is enabled.', example='true'),
          canBeDealOnLine?: boolean(name='CanBeDealOnLine', description='Specifies whether the alerting event is supported for online handling, such as quarantine. Valid values:', example='true'),
          canCancelFault?: boolean(name='CanCancelFault', description='Indicates whether the false positive marking can be unmarked. Valid values:', example='true'),
          clusterId?: string(name='ClusterId', description='The cluster ID.', example='c8c87dae64c9947269091f36cfa9adc87'),
          containHwMode?: boolean(name='ContainHwMode', description='Indicates whether critical event protection pattern is enabled for the server. Valid values:', example='false'),
          containerId?: string(name='ContainerId', description='The container ID.', example='95878ef8779fae3dd82126812edd910402fc550a72f9bce87e56a4435d018384'),
          containerImageId?: string(name='ContainerImageId', description='The container image ID.', example='sha256:2e5a3b0ae5f452b3cb458789a9a7542ef40035a84318469a8528c5e444db1****'),
          containerImageName?: string(name='ContainerImageName', description='The container image name.', example='centos7_apache:v1.0.1'),
          dataSource?: string(name='DataSource', description='The data source. You can ignore this field.', example='URL'),
          desc?: string(name='Desc', description='The description of the impact of the alerting event.', example='webshell'),
          details?: [ 
            {
              nameDisplay?: string(name='NameDisplay', description='The display name of the alerting event.', example='login with unusual location'),
              type?: string(name='Type', description='The event type of the alerting event.', example='text'),
              value?: string(name='Value', description='The path where the alerting event occurred.', example='/etc/crontab'),
              valueDisplay?: string(name='ValueDisplay', description='The display path where the alerting event occurred.', example='/etc/crontab'),
            }
          ](name='Details', description='The details of the alerting event.'),
          detectSource?: string(name='DetectSource', description='The detection source. This is an invalid field.', example='-'),
          displaySandboxResult?: boolean(name='DisplaySandboxResult', description='Indicates whether cloud sandbox detection is supported. Valid values:', example='true'),
          eventNotes?: [ 
            {
              note?: string(name='Note', description='The remark information.', example='test'),
              noteId?: long(name='NoteId', description='The ID of the remark record.', example='2859481'),
              noteTime?: string(name='NoteTime', description='The time when the event was recorded.', example='2018-09-26 01:51:01'),
            }
          ](name='EventNotes', description='The remarks of the alerting event.'),
          eventStatus?: int32(name='EventStatus', description='The status of the alerting event. Valid values:', example='1'),
          eventSubType?: string(name='EventSubType', description='The child class of the alerting event.', example='login_common_location'),
          hasTraceInfo?: boolean(name='HasTraceInfo', description='Indicates whether the alerting event is associated with tracing information. Valid values:', example='true'),
          id?: long(name='Id', description='The unique identity of the alerting event.', example='3178'),
          imageUuid?: string(name='ImageUuid', description='The unique identity of the image.', example='ccdab289-9765-47ef-af50-ba6be09aacd6'),
          instanceId?: string(name='InstanceId', description='The ID of the asset instance affected by the alerting event.', example='i-9dp6dwsxdl9z5u1e2f****'),
          instanceName?: string(name='InstanceName', description='The instance name.', example='nginx'),
          internetIp?: string(name='InternetIp', description='The public IP address of the associated instance.', example='8.137.3*.6'),
          intranetIp?: string(name='IntranetIp', description='The private network IP address of the instance.', example='10.36.*6.149'),
          k8sClusterId?: string(name='K8sClusterId', description='The K8s cluster ID.', example='ce3c41ed427794a7bb3d9da4554fc8039'),
          k8sClusterName?: string(name='K8sClusterName', description='The K8s cluster name.', example='testName'),
          k8sNamespace?: string(name='K8sNamespace', description='The K8s namespace.', example='default'),
          k8sNodeId?: string(name='K8sNodeId', description='The K8s node ID.', example='i-bp14a1ay8e0aa9t0****'),
          k8sNodeName?: string(name='K8sNodeName', description='The K8s node name.', example='N/A'),
          k8sPodName?: string(name='K8sPodName', description='The K8s pod name.', example='myapp-pod'),
          largeModel?: boolean(name='LargeModel', description='Indicates whether large model analysis label is supported. Valid values:', example='true'),
          lastTime?: string(name='LastTime', description='The most recent time when the alerting event occurred.', example='2018-09-26 01:51:01'),
          lastTimeStamp?: long(name='LastTimeStamp', description='The UNIX timestamp of the last occurrence, in milliseconds.', example='1631699497000'),
          level?: string(name='Level', description='The risk level of the alerting event. Valid values:', example='remind'),
          maliciousRuleStatus?: string(name='MaliciousRuleStatus', description='The status of the malicious behavior defense rule. Valid values:', example='open'),
          markList?: [ string ](name='MarkList', description='The collection of alerting event labels.'),
          markMisRules?: string(name='MarkMisRules', description='The advanced whitelist rules.', example='<strong>1.</strong>&nbsp&nbsppath&nbsp&nbspcontain&nbsp&nbsp232&nbsp&nbsp'),
          name?: string(name='Name', description='The full name of the alerting event.', example='Unusual Logon-Login with unusual location'),
          occurrenceTime?: string(name='OccurrenceTime', description='The time when the alerting event first occurred.', example='2018-09-26 01:51:01'),
          occurrenceTimeStamp?: long(name='OccurrenceTimeStamp', description='The UNIX timestamp of the first occurrence, in milliseconds.', example='1631699497000'),
          operateErrorCode?: string(name='OperateErrorCode', description='The fault code of the alerting event operation.', example='kill_and_quara.Success'),
          operateMsg?: string(name='OperateMsg', description='The remarks of the alerting event operation.', example='success'),
          operateTime?: long(name='OperateTime', description='The UNIX timestamp of the alerting event operation, in milliseconds.', example='1631699497000'),
          saleVersion?: string(name='SaleVersion', description='The required edition:', example='1'),
          securityEventIds?: string(name='SecurityEventIds', description='The IDs of the alerting events associated with this alerting event.', example='628978308'),
          sourceAliUid?: long(name='SourceAliUid', description='The Alibaba Cloud account ID that generated the alert.', example='124075**67406'),
          stages?: string(name='Stages', description='The attack stage.', example='"["authority_maintenance"]"'),
          supportOperateCode?: string(name='SupportOperateCode', description='The operation type supported by the alert:', example='AI.false_positive'),
          tacticItems?: [ 
            {
              tacticDisplayName?: string(name='TacticDisplayName', description='The ATT&CK tactic name.', example='Malicious scripts-Malicious script code execution'),
              tacticId?: string(name='TacticId', description='The ATT&CK attack stage information.', example='TA0042'),
            }
          ](name='TacticItems', description='The display name of the attack stage.'),
          uniqueInfo?: string(name='UniqueInfo', description='The unique key of the security alert.', example='1dfbdf56c5343b63c4854d08ec20e067'),
          uuid?: string(name='Uuid', description='The unique identifier of the associated instance.', example='9A75F21D3993C0A2B094A4AB132890B2'),
        }
      ](name='SuspEvents', description='The security alert event information.'),
      totalCount?: int32(name='TotalCount', description='The total number of records.', example='72'),
    }(name='Body', description='The message body.'),
  }(name='Data', description='The response information returned by Meta.'),
  message?: string(name='Message', description='The returned message. If the request is successful, a success message is returned. If the request fails, the failure reason is returned.', example='successful'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='67BD8435-6624-5484-A75D-170231B51615'),
  success?: boolean(name='Success', description='Indicates whether the operation is successful. Valid values: true: Successful. false: Failed.', example='true'),
}

model DescribeSuspEventsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DescribeSuspEventsResponseBody(name='body'),
}

