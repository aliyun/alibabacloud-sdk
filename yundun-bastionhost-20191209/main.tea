}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AcceptApproveCommandRequest {
  commandId?: string(name='CommandId', description='The ID of the command to be approved for execution.
> You can call the [ListApproveCommands](https://help.aliyun.com/document_detail/2584310.html) operation to query the IDs of all commands that require approval.

This parameter is required.', example='7'),
  instanceId?: string(name='InstanceId', description='The instance ID of the bastion host.
> You can call the DescribeInstances operation to query the bastion host instance ID.

This parameter is required.', example='bastionhost-cn-st220aw****'),
  projectId?: long(name='ProjectId', description='The project ID.', example='3'),
  regionId?: string(name='RegionId', description='The region ID of the bastion host.
> For the mapping between region IDs and region names, see [Regions and zones](https://help.aliyun.com/document_detail/40654.html).', example='cn-hangzhou'),
}

model AcceptApproveCommandResponseBody = {
  requestId?: string(name='RequestId', description='The unique request ID generated by Alibaba Cloud for this request.', example='EC9BF0F4-8983-491A-BC8C-1B4DD94976DE'),
}

model AcceptApproveCommandResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AcceptApproveCommandResponseBody(name='body'),
}

/**
 * @summary If an O&M engineer runs a command that is configured in a command approval control policy, the administrator receives an approval request for the command in the Bastionhost console. The command can be run only after the administrator approves the request. If the administrator rejects the request, the command cannot be run.
 *
 * @description Approves a command execution request from an O&M engineer.
 * The single-user QPS limit for this operation is 10 calls per second. If this limit is exceeded, API calls are throttled, which may affect your business. Call this operation at an appropriate frequency.
 *
 * @param request AcceptApproveCommandRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AcceptApproveCommandResponse
 */
async function acceptApproveCommandWithOptions(request: AcceptApproveCommandRequest, runtime: Util.RuntimeOptions): AcceptApproveCommandResponse {
  Util.validateModel(request);
  var query = {};
  if (!Util.isUnset(request.commandId)) {
    query['CommandId'] = request.commandId;
  }
  if (!Util.isUnset(request.instanceId)) {
    query['InstanceId'] = request.instanceId;
  }
  if (!Util.isUnset(request.projectId)) {
    query['ProjectId'] = request.projectId;
  }
  if (!Util.isUnset(request.regionId)) {
    query['RegionId'] = request.regionId;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'AcceptApproveCommand',
    version = '2019-12-09',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary If an O&M engineer runs a command that is configured in a command approval control policy, the administrator receives an approval request for the command in the Bastionhost console. The command can be run only after the administrator approves the request. If the administrator rejects the request, the command cannot be run.
 *
 * @description Approves a command execution request from an O&M engineer.
 * The single-user QPS limit for this operation is 10 calls per second. If this limit is exceeded, API calls are throttled, which may affect your business. Call this operation at an appropriate frequency.
 *
 * @param request AcceptApproveCommandRequest
 * @return AcceptApproveCommandResponse
 */
async function acceptApproveCommand(request: AcceptApproveCommandRequest): AcceptApproveCommandResponse {
  var runtime = new Util.RuntimeOptions{};
  return acceptApproveCommandWithOptions(request, runtime);
}

model AcceptOperationTicketRequest {
  comment?: string(name='Comment', description='The approval remarks.', example='Comment'),
  effectCount?: string(name='EffectCount', description='The limit on the number of logons allowed. Valid values:

- **0**: No limit on the number of logons. The O&M engineer can log on an unlimited number of times during the validity period.

- **1**: The O&M engineer can log on only once during the validity period.
> - The logon limit for database asset O&M approval can only be set to no limit on the number of logons in Settings.
> - If an empty character string is passed, the default value is no limit on the number of logons.', example='1'),
  effectEndTime?: string(name='EffectEndTime', description='The end time of the validity period for logon (in seconds, UNIX timestamp format).', example='1679393152'),
  effectStartTime?: string(name='EffectStartTime', description='The start time of the validity period for logon (in seconds, UNIX timestamp format).', example='1685600242'),
  instanceId?: string(name='InstanceId', description='The ID of the bastion host instance.
> You can invoke the [DescribeInstances](https://help.aliyun.com/document_detail/153281.html) operation to query this parameter.

This parameter is required.', example='bastionhost-cn-st220aw****'),
  operationTicketId?: string(name='OperationTicketId', description='The ID of the O&M request to approve.
> You can call the [ListOperationTickets](https://help.aliyun.com/document_detail/2584313.html) operation to query all OperationTicketId values that require approval.

This parameter is required.', example='1'),
  projectId?: long(name='ProjectId', description='The project ID.', example='3'),
  regionId?: string(name='RegionId', description='The region ID of the bastion host.
> For the mapping between region IDs and region names, see [Regions and zones](https://help.aliyun.com/document_detail/40654.html).', example='cn-hangzhou'),
}

model AcceptOperationTicketResponseBody = {
  requestId?: string(name='RequestId', description='The unique identity generated by Alibaba Cloud for this request.', example='EC9BF0F4-8983-491A-BC8C-1B4DD94976DE'),
}

model AcceptOperationTicketResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AcceptOperationTicketResponseBody(name='body'),
}

/**
 * @summary If an administrator enables O&M approval in a control policy, O&M engineers must submit an O&M request and obtain administrator approval before they can log on to assets.
