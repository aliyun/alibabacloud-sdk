model AcceptApproveCommandRequest {
  commandId: string(name='CommandId', description='The ID of the command to be approved for execution.
> You can call the [ListApproveCommands](https://help.aliyun.com/document_detail/2584310.html) operation to query the IDs of all commands that require approval.

This parameter is required.', example='7', position='Query'),
  instanceId: string(name='InstanceId', description='The instance ID of the bastion host.
> You can call the DescribeInstances operation to query the bastion host instance ID.

This parameter is required.', example='bastionhost-cn-st220aw****', position='Query'),
  projectId?: long(name='ProjectId', description='The project ID.', example='3', minimum=1, position='Query'),
  regionId?: string(name='RegionId', description='The region ID of the bastion host.
> For the mapping between region IDs and region names, see [Regions and zones](https://help.aliyun.com/document_detail/40654.html).', example='cn-hangzhou', position='Query'),
}

model AcceptApproveCommandResponseBody = {
  requestId?: string(name='RequestId', description='The unique request ID generated by Alibaba Cloud for this request.', example='EC9BF0F4-8983-491A-BC8C-1B4DD94976DE'),
}

model AcceptApproveCommandResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AcceptApproveCommandResponseBody(name='body'),
}

/**
  * @description Approves a command execution request from an O&M engineer.
  * The single-user QPS limit for this operation is 10 calls per second. If this limit is exceeded, API calls are throttled, which may affect your business. Call this operation at an appropriate frequency.
  * @param request  the request parameters of AcceptApproveCommand  AcceptApproveCommandRequest
  * @return AcceptApproveCommandResponse
 */
async function acceptApproveCommand(request: AcceptApproveCommandRequest): AcceptApproveCommandResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AcceptApproveCommand', 'POST', '/', 'json', false, 'json', request);
}

model AcceptOperationTicketRequest {
  comment?: string(name='Comment', description='The approval remarks.', example='Comment', position='Query'),
  effectCount?: string(name='EffectCount', description='The limit on the number of logons allowed. Valid values:

- **0**: No limit on the number of logons. The O&M engineer can log on an unlimited number of times during the validity period.

- **1**: The O&M engineer can log on only once during the validity period.
> - The logon limit for database asset O&M approval can only be set to no limit on the number of logons in Settings.
> - If an empty character string is passed, the default value is no limit on the number of logons.', example='1', position='Query'),
  effectEndTime?: string(name='EffectEndTime', description='The end time of the validity period for logon (in seconds, UNIX timestamp format).', example='1679393152', position='Query'),
  effectStartTime?: string(name='EffectStartTime', description='The start time of the validity period for logon (in seconds, UNIX timestamp format).', example='1685600242', position='Query'),
  instanceId: string(name='InstanceId', description='The ID of the bastion host instance.
> You can invoke the [DescribeInstances](https://help.aliyun.com/document_detail/153281.html) operation to query this parameter.

This parameter is required.', example='bastionhost-cn-st220aw****', position='Query'),
  operationTicketId: string(name='OperationTicketId', description='The ID of the O&M request to approve.
> You can call the [ListOperationTickets](https://help.aliyun.com/document_detail/2584313.html) operation to query all OperationTicketId values that require approval.

This parameter is required.', example='1', position='Query'),
  projectId?: long(name='ProjectId', description='The project ID.', example='3', minimum=1, position='Query'),
  regionId?: string(name='RegionId', description='The region ID of the bastion host.
> For the mapping between region IDs and region names, see [Regions and zones](https://help.aliyun.com/document_detail/40654.html).', example='cn-hangzhou', position='Query'),
}

model AcceptOperationTicketResponseBody = {
  requestId?: string(name='RequestId', description='The unique identity generated by Alibaba Cloud for this request.', example='EC9BF0F4-8983-491A-BC8C-1B4DD94976DE'),
}

model AcceptOperationTicketResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AcceptOperationTicketResponseBody(name='body'),
}

