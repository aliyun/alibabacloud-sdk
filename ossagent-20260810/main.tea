/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('ossagent', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model A2aRequest {
  env?: string(name='Env', example='a2a'),
  id?: string(name='id', example='791'),
  jsonrpc?: string(name='jsonrpc', example='2.0'),
  method?: string(name='method', example='message/stream'),
  params?: any(name='params', example='{
    "message": {
      "role": "user",
      "parts": [
        {
          "kind": "text",
          "text": "你好“
        }
      ]
      "kind": "message"
    }
  }'),
}

model A2aResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: any(name='body'),
}

/**
 * @summary A2A接口
 *
 * @param request A2aRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return A2aResponse
 */
async function a2aWithOptions(request: A2aRequest, runtime: Util.RuntimeOptions): A2aResponse {
  Util.validateModel(request);
  var query = {};
  if (!Util.isUnset(request.env)) {
    query['Env'] = request.env;
  }
  var body : map[string]any = {};
  if (!Util.isUnset(request.id)) {
    body['id'] = request.id;
  }
  if (!Util.isUnset(request.jsonrpc)) {
    body['jsonrpc'] = request.jsonrpc;
  }
  if (!Util.isUnset(request.method)) {
    body['method'] = request.method;
  }
  if (!Util.isUnset(request.params)) {
    body['params'] = request.params;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'a2a',
    version = '2026-08-10',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'json',
    bodyType = 'any',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary A2A接口
 *
 * @param request A2aRequest
 * @return A2aResponse
 */
async function a2a(request: A2aRequest): A2aResponse {
  var runtime = new Util.RuntimeOptions{};
  return a2aWithOptions(request, runtime);
}

model AgentCardRequest {
  env?: string(name='Env', example='a2a'),
}

model AgentCardResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: any(name='body'),
}

/**
 * @summary 获取Agent_Card
 *
 * @param request AgentCardRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AgentCardResponse
 */
async function agent_cardWithOptions(request: AgentCardRequest, runtime: Util.RuntimeOptions): AgentCardResponse {
  Util.validateModel(request);
  var query = OpenApiUtil.query(Util.toMap(request));
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'agent_card',
    version = '2026-08-10',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'GET',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'any',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 获取Agent_Card
 *
 * @param request AgentCardRequest
 * @return AgentCardResponse
 */
async function agent_card(request: AgentCardRequest): AgentCardResponse {
  var runtime = new Util.RuntimeOptions{};
  return agent_cardWithOptions(request, runtime);
}

