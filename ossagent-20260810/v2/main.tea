/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('ossagent', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model A2aRequest {
  env?: string(name='Env', example='a2a'),
  id?: string(name='id', example='791'),
  jsonrpc?: string(name='jsonrpc', example='2.0'),
  method?: string(name='method', example='message/stream'),
  params?: any(name='params', example='{
    "message": {
      "role": "user",
      "parts": [
        {
          "kind": "text",
          "text": "你好“
        }
      ]
      "kind": "message"
    }
  }'),
}

model A2aResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  id?: string(name='id'),
  event?: string(name='event'),
  body?: any(name='body'),
}

/**
 * @summary A2A接口
 *
 * @param request A2aRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return A2aResponse
 */
@sse(true)
@context("a2aWithSSECtx")
async function a2aWithSSE(request: A2aRequest, runtime: $RuntimeOptions): asyncIterator[A2aResponse] {
  request.validate();
  var query = {};
  if (!$isNull(request.env)) {
    query['Env'] = request.env;
  }
  var body : map[string]any = {};
  if (!$isNull(request.id)) {
    body['id'] = request.id;
  }
  if (!$isNull(request.jsonrpc)) {
    body['jsonrpc'] = request.jsonrpc;
  }
  if (!$isNull(request.method)) {
    body['method'] = request.method;
  }
  if (!$isNull(request.params)) {
    body['params'] = request.params;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'a2a',
    version = '2026-08-10',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'json',
    bodyType = 'any',
  };
  var sseResp = callSSEApi(params, req, runtime);
  for (var resp : sseResp) {
    if (!$isNull(resp.event) && !$isNull(resp.event.data)) {
      var data = resp.event.data;
      yield {
        statusCode = resp.statusCode,
        headers = resp.headers,
        id = resp.event.id,
        event = resp.event.event,
        body = data
      };
    }
  }
}
/**
 * @summary A2A接口
 *
 * @param request A2aRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return A2aResponse
 */
@context("a2aWithContext")
async function a2aWithOptions(request: A2aRequest, runtime: $RuntimeOptions): A2aResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.env)) {
    query['Env'] = request.env;
  }
  var body : map[string]any = {};
  if (!$isNull(request.id)) {
    body['id'] = request.id;
  }
  if (!$isNull(request.jsonrpc)) {
    body['jsonrpc'] = request.jsonrpc;
  }
  if (!$isNull(request.method)) {
    body['method'] = request.method;
  }
  if (!$isNull(request.params)) {
    body['params'] = request.params;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'a2a',
    version = '2026-08-10',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'json',
    bodyType = 'any',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary A2A接口
 *
 * @param request A2aRequest
 * @return A2aResponse
 */
async function a2a(request: A2aRequest): A2aResponse {
  var runtime = new $RuntimeOptions{};
  return a2aWithOptions(request, runtime);
}

model AgentCardRequest {
  env?: string(name='Env', example='a2a'),
}

model AgentCardResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: any(name='body'),
}

/**
 * @summary 获取Agent_Card
 *
 * @param request AgentCardRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AgentCardResponse
 */
@context("agent_cardWithContext")
async function agent_cardWithOptions(request: AgentCardRequest, runtime: $RuntimeOptions): AgentCardResponse {
  request.validate();
  var query = OpenApiUtil.query(request.toMap());
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'agent_card',
    version = '2026-08-10',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'GET',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'any',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 获取Agent_Card
 *
 * @param request AgentCardRequest
 * @return AgentCardResponse
 */
async function agent_card(request: AgentCardRequest): AgentCardResponse {
  var runtime = new $RuntimeOptions{};
  return agent_cardWithOptions(request, runtime);
}

