model AlignStoragePrimaryAzoneRequest {
  DBInstanceName: string(name='DBInstanceName', description='The name of the PolarDB-X instance.

This parameter is required.', example='pxc-htri0ori2r****', position='Query'),
  regionId: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou', position='Query'),
  storageInstanceName?: string(name='StorageInstanceName', description='The name of the storage instance whose primary node zone needs to be aligned.', example='pxc-xdb-m-pxcbjrylg49skcxb17394', position='Query'),
  switchTime?: string(name='SwitchTime', description='The start time of the switch for the storage primary node, in the UTC time format YYYY-MM-DDThh:mm:ssZ.', example='2024-12-11T17:10:00Z', position='Query'),
  switchTimeMode?: string(name='SwitchTimeMode', description='The switchover mode. Valid values:
- 0: immediate switchover
- 1: switchover during the O&M window
- 2: switchover at a specified time', example='0', position='Query'),
}

model AlignStoragePrimaryAzoneResponseBody = {
  message?: string(name='Message', description='The error message.', example='successs'),
  requestId?: string(name='RequestId', description='The request ID.', example='1A6D328C-84B8-40DC-BF49-6C73984D7494'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.'),
}

model AlignStoragePrimaryAzoneResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AlignStoragePrimaryAzoneResponseBody(name='body'),
}

