model UpdateBackupPolicyRequest {
  backupPeriod?: string(name='BackupPeriod', description='The backup cycle. You must specify at least 2 days. The value is a 7-digit number. From left to right, each digit represents whether backup is enabled from Monday to Sunday. A value of 0 indicates that backup is disabled, and a value of 1 indicates that backup is enabled:

- First digit: Monday
- Second digit: Tuesday
- Third digit: Wednesday
- Fourth digit: Thursday
- Fifth digit: Friday
- Sixth digit: Saturday
- Seventh digit: Sunday', example='1001000', position='Query'),
  backupPlanBegin?: string(name='BackupPlanBegin', description='The daily backup start time in UTC.', example='03:00Z', position='Query'),
  backupSetRetention?: int32(name='BackupSetRetention', description='The retention period of backup sets. Unit: days.', example='30', position='Query'),
  backupType?: string(name='BackupType', description='The backup type. Currently, only "0" is supported, which indicates fast backup.', example='0', position='Query'),
  backupWay?: string(name='BackupWay', description='The backup method. Valid values:

- **P**: physical backup.
- **L**: logical backup.', example='P', position='Query'),
  coldDataBackupInterval?: int32(name='ColdDataBackupInterval', description='The interval of cold data backups. Unit: days. Valid values: 1 to 59.', example='30', position='Query'),
  coldDataBackupRetention?: int32(name='ColdDataBackupRetention', description='The retention period of cold data backups. Unit: days. Valid values: 30 to 730.', example='30', position='Query'),
  crossRegionDataBackupRetention?: int32(name='CrossRegionDataBackupRetention', description='The retention period of cross-region data backups. Unit: days.', example='30', position='Query'),
  crossRegionFilterValue?: string(name='CrossRegionFilterValue', example='3,7,1,5,6,2,4', position='Query'),
  crossRegionLogBackupRetention?: int32(name='CrossRegionLogBackupRetention', description='The retention period of cross-region log backups. Unit: days.', example='30', position='Query'),
  DBInstanceName: string(name='DBInstanceName', description='The instance ID.

This parameter is required.', example='pxc-hzjasdyuoo', position='Query'),
  destCrossRegion?: string(name='DestCrossRegion', description='The destination region for cross-region backup.', example='cn-shanghai', position='Query'),
  forceCleanOnHighSpaceUsage?: int32(name='ForceCleanOnHighSpaceUsage', description='Specifies whether to forcibly clean up binary logs when the total space usage of the instance exceeds 80% or the remaining space is less than 50 GB. The cleanup starts from the earliest logs until the total space usage drops below 80% and the remaining space exceeds 50 GB. Valid values:

- **1**: Yes.
- **0**: No.', example='1', position='Query'),
  isCrossRegionDataBackupEnabled?: boolean(name='IsCrossRegionDataBackupEnabled', description='Specifies whether to enable cross-region data backup. Default value: false.', example='false', position='Query'),
  isCrossRegionLogBackupEnabled?: boolean(name='IsCrossRegionLogBackupEnabled', description='Specifies whether to enable cross-region log backup. Default value: false.', example='false', position='Query'),
  isEnabled?: int32(name='IsEnabled', description='Specifies whether to enable backup. The value is fixed to 1, which indicates that backup is enabled.', example='1', position='Query'),
  localLogRetention?: int32(name='LocalLogRetention', description='The number of hours that log backups are retained locally. Valid values: 0 to 168 (7 × 24 hours). A value of 0 indicates that log backups are not retained locally. Default value: 7.', example='7', position='Query'),
  localLogRetentionNumber?: int32(name='LocalLogRetentionNumber', description='The number of local binary logs to retain. Default value: 60. Valid values: 6 to 100.', example='60', position='Query'),
  logLocalRetentionSpace?: int32(name='LogLocalRetentionSpace', description='The maximum binary log space usage in percentage. Valid values: 0 to 50. This parameter specifies a loop space. Default value: 30.', example='30', position='Query'),
  regionId: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou', position='Query'),
  removeLogRetention?: int32(name='RemoveLogRetention', description='The number of days that log backups are retained remotely. Valid values: 7 to 730. Unit: days. Default value: 7.', example='7', position='Query'),
}

