model AttachVscMountPointRequest {
  regionId?: string(name='RegionId', position='Host'),
  description?: string(name='Description', description='A reserved field. This field has no practical meaning.', example='None', position='Query'),
  fileSystemId: string(name='FileSystemId', description='The file system ID.

This parameter is required.', example='e389e5c7-bcb4-4558-846a-e5afc444****', position='Query'),
  inputRegionId: string(name='InputRegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou', position='Query'),
  instanceIds?: [ string ](name='InstanceIds', description='The IDs of the ECS instances to which you want to mount the Apsara File Storage for HDFS file system. Separate multiple ECS instance IDs with commas (,). You can specify up to 100 ECS instance IDs.', example='[
      "i-bp1g6zv0ce8oghu7****",
      "i-bp1g6zv0ce8oghu1****"
]', shrink='json', position='Query'),
  mountPointId: string(name='MountPointId', description='The mount point ID.

This parameter is required.', example='f-037cb49e1d-c****.dfs.aliyuncs.com', position='Query'),
  useAssumeRoleChkServerPerm?: boolean(name='UseAssumeRoleChkServerPerm', description='Specifies whether to use the assumed role to verify the permissions of the compute node. Valid values:
- true: yes.
- false: no. This is the default value.', example='false', position='Query'),
  vscIds?: [ string ](name='VscIds', description='The IDs of the VSCs to which you want to mount the HDFS file system. Specify up to 100 VSC IDs.', shrink='json', position='Query'),
  vscName?: string(name='VscName', description='The custom name of the VSC.', example='1fb6b247-4c4a-4fb9-b3b5-7ea38b167bb5', position='Query'),
  vscType?: string(name='VscType', description='The VSC type. Valid values:
- Primary: the reserved default VSC on the ECS instance. This is the default value.
- Secondary: a repeatable VSC on the ECS instance.', example='Primary', position='Query'),
}

model AttachVscMountPointResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='55C5FFD6-BF99-41BD-9C66-FFF39189****'),
}

model AttachVscMountPointResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachVscMountPointResponseBody(name='body'),
}

