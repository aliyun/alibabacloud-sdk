      mountPointId?: string(name='MountPointId', description='The mount point ID.', example='f-cfea9ae2ref87.cn-zhangjiakou.dfs.aliyuncs.com'),
      vscId?: string(name='VscId', description='The VSC ID. You must specify either InstanceId or VscId, but not both.', example='vsc-bp19yqmujug2r762cnabal'),
      vscName?: string(name='VscName', description='The custom name of the VSC.', example='xc'),
      vscType?: string(name='VscType', description='The VSC type. Valid values:
- Primary (default): the reserved default VSC on an ECS instance.
- Secondary: a repeatable VSC on an ECS instance.', example='Primary'),
    }
  ](name='AttachInfos', description='The mount information list.', shrink='json', position='Query'),
  inputRegionId: string(name='InputRegionId', description='The region ID.

