  dedicatedClusterId?: string(name='DedicatedClusterId', description='The ID of the dedicated cluster for Apsara File Storage for HDFS.', example='alidfs-DC-f76f7ca5-*****'),
  description?: string(name='Description', description='The description of the file system.

The description can be up to 32 characters in length.', example='This is the first Apsara File Storage for HDFS instance for our company'),
  fileSystemName?: string(name='FileSystemName', description='The name of the file system. The name must meet the following requirements:

- The name must be 6 to 64 characters in length. 
- The name must be globally unique and cannot be an empty string.
- The name can contain letters, digits, underscores (_), and hyphens (-).

This parameter is required.', example='MyFirstHDFS'),
  inputRegionId?: string(name='InputRegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou'),
  meteringMode?: string(name='MeteringMode', description='The metering mode.', example='UsageBased,CapacityBased'),
  partitionNumber?: int32(name='PartitionNumber', description='This parameter is reserved and does not require configuration.', example='0'),
  protocolType?: string(name='ProtocolType', description='The protocol type.

Only Hadoop Distributed File System (HDFS) is supported.

This parameter is required.', example='HDFS'),
  provisionedThroughputInMiBps?: long(name='ProvisionedThroughputInMiBps', description='The provisioned throughput. This parameter is required when ThroughputMode is set to Provisioned.

Unit: MB/s.

Valid values: 1 to 5120.', example='1024'),
  spaceCapacity?: long(name='SpaceCapacity', description='The capacity of the file system.

You cannot write data when the amount of stored data reaches the file system capacity.

Unit: GiB.

This parameter is required.', example='1024'),
  storageSetName?: string(name='StorageSetName', description='This parameter is reserved and does not require configuration.', example='AligroupStorageSet'),
  storageType?: string(name='StorageType', description='The storage medium type.

Valid values:

- STANDARD: standard storage. This is the default value.
- PERFORMANCE: performance storage.

This parameter is required.', example='STANDARD'),
  throughputMode?: string(name='ThroughputMode', description='The throughput mode.

Valid values:

- Standard: standard throughput. This is the default value.
- Provisioned: provisioned throughput.', example='Standard'),
  zoneId?: string(name='ZoneId', description='The zone ID.', example='cn-hangzhou-b'),
}

