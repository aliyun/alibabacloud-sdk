  pageSize?: int32(name='PageSize', description='The number of entries to return on each page for paging in a paged query. Settings: Maximum value: 100. Default value: 20.', example='20', minimum=1, maximum=500, position='Query'),
  search?: string(name='Search', position='Query'),
  withoutMeteringData?: boolean(name='WithoutMeteringData', position='Query'),
