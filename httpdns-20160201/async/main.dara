model SdnsListRuleCategoriesRequest {
  domainName?: string(name='DomainName', description='The domain name that is connected to HTTPDNS under the current account. This parameter is required.', example='api.example.com', position='Query'),
}

model SdnsListRuleCategoriesResponseBody = {
  list?: [ 
    {
      clientIpRanges?: [ string ](name='ClientIpRanges', description='The array of original CIDR blocks from the most recent successful submission for an IP_RANGE policy. The order, duplicates, and content of each string are preserved. The response is a JSON array, not a text string of an array. This field is not used for LINE policies.'),
      domainName?: string(name='DomainName', description='The domain name to which the policy is bound.', example='api.example.com'),
      id?: string(name='Id', description='The ID of the policy, which can be used to query, update, enable, disable, or delete the policy. Treat it as a string to avoid precision loss of large integers.', example='123456789012345678'),
      matchType?: string(name='MatchType', description='The match type of the policy. Valid values: LINE: line policy. IP_RANGE: client CIDR block policy.', example='IP_RANGE'),
      recordLine?: {
        lineId?: string(name='LineId', description='The line identifier. Valid values: internal: the Chinese mainland. overseas: outside the Chinese mainland.', example='internal'),
        lineLabel?: string(name='LineLabel', description='The display name of the line.', example='The Chinese mainland'),
        paths?: [ 
          {
            id?: string(name='Id', description='The code of the option at this level. For example, chinanet at the isps level indicates China Telecom. Use valid options for the associated line and maintain consistent hierarchical relationships.', example='chinanet'),
