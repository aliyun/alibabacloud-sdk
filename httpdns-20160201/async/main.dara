/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Httpdns';
  @version = '2016-02-01';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hangzhou' = 'httpdns-api.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model AddDomainRequest {
  accountId?: string(name='AccountId', description='The HTTPDNS account ID.', example='123456', position='Query'),
  domainName: string(name='DomainName', description='The domain name.

This parameter is required.', example='www.example.com', position='Query'),
}

model AddDomainResponseBody = {
  domainName?: string(name='DomainName', description='The domain name.', example='www.example.com'),
  requestId?: string(name='RequestId', description='The request ID.', example='ADA27798-6911-4B06-AF34-53F62F62XXXX'),
}

model AddDomainResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDomainResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddDomain  AddDomainRequest
  * @return AddDomainResponse
 */
async function addDomain(request: AddDomainRequest): AddDomainResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddDomain', 'POST', '/', 'json', false, 'json', request);
}

model CreateSdnsRuleCategoryRequest {
  clientIpRanges?: [ string ](name='ClientIpRanges', description='The array of client IP address ranges required for the IP_RANGE pattern. Send this parameter as a JSON form field. Do not specify this parameter for the LINE pattern. This parameter supports single IPv4 and IPv6 addresses, CIDR blocks, and start-end ranges. Multiple entries have an OR relationship. For CIDR blocks, the IPv4 prefix length ranges from 0 to 32, and the IPv6 prefix length ranges from 0 to 128. Start-end ranges are inclusive and must belong to the same address family, and the start address cannot be greater than the end address. Duplicates, inclusions, and overlaps are allowed within the same policy. When the policy is saved and read back, the array sequence, duplicates, and original text of each string are preserved. The array can contain up to 2,000 array elements. The total number of parsed non-empty address expressions ranges from 1 to 2,000, and duplicates are counted. We recommend that you specify one expression per array element. It is compatible with line breaks within an array element. Each expression can contain up to 128 characters, including leading and trailing spaces. The serialized UTF-8 JSON content cannot exceed 65,535 bytes. The quantity and byte limits take effect simultaneously. Overlaps are not allowed between different IP_RANGE policies for the same account, domain name, and address family. Disabled policies are also checked. Disabling a policy does not release the ranges. This limit does not compare independent configurations of LINE policies and the legacy SetIPRegionResult operation.', shrink='json', position='Body'),
  domainName?: string(name='DomainName', description='The domain name connected to HTTPDNS for the current account. This parameter is required.', example='api.example.com', position='Body'),
  enable?: boolean(name='Enable', description='Specifies whether to enable the policy upon creation. If this parameter is omitted or set to false, the policy is disabled (Status=0). If this parameter is set to true, the policy is enabled (Status=1), and you do not need to call the enable operation. This parameter applies to the LINE and IP_RANGE modes. Actual resolution still requires waiting for configuration propagation.', position='Body'),
  lineId?: string(name='LineId', description='The line identifier required for the LINE mode. Valid values:
- internal: the Chinese mainland.
- overseas: outside the Chinese mainland.

Do not specify this parameter for the IP_RANGE mode.', example='internal', position='Body'),
  matchType?: string(name='MatchType', description='The match type. Valid values:
- LINE: the line mode.
- IP_RANGE: the client IP address range mode.

If this parameter is omitted, it is processed as LINE. To create an IP address range policy, you must explicitly set this parameter to IP_RANGE and provide ClientIpRanges. You cannot provide LineId or Paths at the same time. The match type cannot be changed after creation.', example='IP_RANGE', position='Body'),
  paths?: [ 
    {
      id?: string(name='Id', description='The code of the option at this level. For example, chinanet at the isps level indicates China Telecom. Use valid options for the associated line and maintain consistent hierarchical subordination.', example='chinanet'),
      key?: string(name='Key', description='The level identifier. For the Chinese mainland, use isps, subRegions, and provinces. For regions outside the Chinese mainland, use continents and geoRegions. This parameter corresponds to Level.', example='isps'),
      level?: int32(name='Level', description='The sequence number of the line level. For the Chinese mainland, the values are 1 (ISP), 2 (region), and 3 (province). For regions outside the Chinese mainland, the values are 1 (continent) and 2 (region).', example='1'),
    }
  ](name='Paths', description='The line selection path that describes the line conditions at each level. This parameter applies only to the LINE mode. The IP_RANGE mode does not use line paths. When you create a line policy, provide valid options at each level. Use x for the default option. For the Chinese mainland, the levels include ISP, region, and province. For regions outside the Chinese mainland, the levels include continent and region.', shrink='json', position='Body'),
  rules?: [ 
    {
      argKeys?: [ string ](name='ArgKeys', description='The optional list of custom parameter names used to record the display order. Omit this parameter when matching only by IP address range. If Args is used, the names must correspond to the parameter names in Args.'),
      args?: map[string]string(name='Args', description='The optional custom parameter conditions. The key is the parameter name, and the value is the match value. Omit this parameter when matching only by IP address range. You do not need to add business parameters.'),
      name?: string(name='Name', description='The rule name. This parameter is required and cannot be null. We recommend that you use a non-empty name with business meaning. This parameter cannot replace the policy Id.', example='Default rule'),
      records?: [ 
        {
          ip?: string(name='Ip', description='The single destination IP address corresponding to the record. If Type is set to 1, the value is an IPv4 address, such as 192.0.2.200. If Type is set to 28, the value is an IPv6 address, such as 2001:db8::200. Do not use CIDR blocks, start-end ranges, or domain names.', example='192.0.2.200'),
          type?: int32(name='Type', description='The DNS record type. Valid values:
- 1: A record.
- 28: AAAA record.

Specify an integer. Do not use the string A or AAAA.', example='1'),
          typeLabel?: string(name='TypeLabel', description='The auxiliary display text for the record type. This parameter does not participate in matching or resolution decisions and can be omitted in the request.', example='A'),
          weight?: int32(name='Weight', description='The relative weight of the record. This parameter is used to select one record of the same queried type only when ResultMode is set to 1. We recommend that you set this parameter to a positive integer from 1 to 100. The sum of the weights of all records does not need to be 100. This parameter does not participate in selection when ResultMode is set to 0.', example='100'),
        }
      ](name='Records', description='The list of configured resolution records, which can include A and AAAA records. Actual resolution returns only records of the queried type. If the list is empty or does not contain records of the queried type, the system continues to fall back.'),
      resultMode?: int32(name='ResultMode', description='The record return mode. Valid values:
- 0: returns all records of the queried type.
- 1: returns one record of the queried type based on the weight.', example='0'),
      ttl?: int32(name='Ttl', description='The cache validity period of the record, in seconds. This parameter must be a positive integer.', example='60'),
    }
  ](name='Rules', description='The complete list of rules. This parameter is required and must contain at least one rule. When matching only by IP address range, configure a default rule without ArgKeys and Args, and configure the A or AAAA destination addresses in the Records of this rule. When saved, the serialized UTF-8 JSON content must be less than 65,535 bytes.', shrink='json', position='Body'),
}

model CreateSdnsRuleCategoryResponseBody = {
  id?: string(name='Id', description='The ID of the policy created and saved in this request. This ID is consistent with the ID in the list and details, and is used for querying, updating, enabling, disabling, and deleting the policy. The ID is saved as a string to avoid precision loss of large integers.', example='123456789012345678'),
  requestId?: string(name='RequestId', description='The ID of the request. This ID is used to troubleshoot call issues and is not the policy ID.', example='50F9C40E-188D-4208-BE2C-74271337****'),
}

model CreateSdnsRuleCategoryResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateSdnsRuleCategoryResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateSdnsRuleCategory  CreateSdnsRuleCategoryRequest
  * @return CreateSdnsRuleCategoryResponse
 */
async function createSdnsRuleCategory(request: CreateSdnsRuleCategoryRequest): CreateSdnsRuleCategoryResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateSdnsRuleCategory', 'POST', '/', 'json', true, 'form', request);
}

