  domainInfos?: {
    domainInfo?: [ 
    {
      domainName?: string(name='DomainName'),
      resolveHttpAes?: long(name='ResolveHttpAes'),
      resolveHttpsAes?: long(name='ResolveHttpsAes'),
      resolved?: long(name='Resolved'),
      resolved6?: long(name='Resolved6'),
      resolvedDoh?: long(name='ResolvedDoh'),
      resolvedHttps?: long(name='ResolvedHttps'),
