/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hangzhou' = 'httpdns-api.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('httpdns', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AddDomainRequest {
  accountId?: string(name='AccountId', description='The HTTPDNS account ID.', example='123456'),
  domainName?: string(name='DomainName', description='The domain name.

This parameter is required.', example='www.example.com'),
}

model AddDomainResponseBody = {
  domainName?: string(name='DomainName', description='The domain name.', example='www.example.com'),
