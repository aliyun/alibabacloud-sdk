import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'PAIModelGallery';
  @version = '2026-06-03';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-shenzhen' = 'paimodelgallery.cn-shenzhen.aliyuncs.com',
    'cn-wulanchabu' = 'paimodelgallery.cn-wulanchabu.aliyuncs.com',
    'cn-beijing' = 'paimodelgallery.cn-beijing.aliyuncs.com',
    'ap-northeast-2' = 'paimodelgallery.ap-northeast-2.aliyuncs.com',
    'ap-northeast-1' = 'paimodelgallery.ap-northeast-1.aliyuncs.com',
    'cn-shanghai' = 'paimodelgallery.cn-shanghai.aliyuncs.com',
    'cn-guangzhou' = 'paimodelgallery.cn-guangzhou.aliyuncs.com',
    'cn-hongkong' = 'paimodelgallery.cn-hongkong.aliyuncs.com',
    'ap-southeast-1' = 'paimodelgallery.ap-southeast-1.aliyuncs.com',
    'ap-southeast-3' = 'paimodelgallery.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'paimodelgallery.ap-southeast-5.aliyuncs.com',
    'cn-hangzhou' = 'paimodelgallery.cn-hangzhou.aliyuncs.com',
    'us-west-1' = 'paimodelgallery.us-west-1.aliyuncs.com',
    'us-east-1' = 'paimodelgallery.us-east-1.aliyuncs.com',
    'eu-central-1' = 'paimodelgallery.eu-central-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model ModelGalleryModel {
  collection?: string(name='Collection'),
  compressible?: boolean(name='Compressible'),
  deepThink?: boolean(name='DeepThink'),
  demonstrable?: boolean(name='Demonstrable'),
  deployable?: boolean(name='Deployable'),
  distillable?: boolean(name='Distillable'),
  domain?: string(name='Domain'),
  evaluable?: boolean(name='Evaluable'),
  extraInfo?: map[string]any(name='ExtraInfo'),
  functionCall?: boolean(name='FunctionCall'),
  gmtCreateTime?: string(name='GmtCreateTime'),
  gmtLatestVersionModified?: string(name='GmtLatestVersionModified'),
  gmtModifiedTime?: string(name='GmtModifiedTime'),
  latestVersionName?: string(name='LatestVersionName'),
  modelDescription?: string(name='ModelDescription'),
  modelDoc?: string(name='ModelDoc'),
  modelId?: string(name='ModelId'),
  modelName?: string(name='ModelName'),
  modelSeries?: string(name='ModelSeries'),
  modelType?: string(name='ModelType'),
  orderNumber?: long(name='OrderNumber'),
  origin?: string(name='Origin'),
  parameterSize?: long(name='ParameterSize'),
  searchWords?: string(name='SearchWords'),
  supportedCompressionMethods?: map[string]any(name='SupportedCompressionMethods'),
  supportedCompressionResources?: string(name='SupportedCompressionResources'),
  supportedDistillationMethods?: map[string]any(name='SupportedDistillationMethods'),
  supportedDistillationResources?: string(name='SupportedDistillationResources'),
  supportedEvaluationMethods?: map[string]any(name='SupportedEvaluationMethods'),
  supportedEvaluationResources?: string(name='SupportedEvaluationResources'),
  supportedInferenceMethods?: map[string]any(name='SupportedInferenceMethods'),
  supportedInferenceResources?: string(name='SupportedInferenceResources'),
  supportedTrainingMethods?: map[string]any(name='SupportedTrainingMethods'),
  supportedTrainingResources?: string(name='SupportedTrainingResources'),
  tags?: {
    key?: string(name='Key'),
    value?: string(name='Value'),
  }(name='Tags'),
  task?: string(name='Task'),
  trainable?: boolean(name='Trainable'),
}

model GetModelDeploymentResourcesRequest {
  modelId: string(name='ModelId', description='This parameter is required.', example='model-gfo1kjyxkudbw4fa37', position='Path'),
  bizKey?: string(name='BizKey', example='cmu-biz', position='Query'),
  modelVersion: string(name='ModelVersion', description='This parameter is required.', example='1.0.0', position='Query'),
  profileId: string(name='ProfileId', description='This parameter is required.', example='prf_5cd37a1c7eaa***c6829dbb02', position='Query'),
  workspaceId: string(name='WorkspaceId', description='This parameter is required.', example='295949', position='Query'),
}

model GetModelDeploymentResourcesResponseBody = {
  memberMatches?: [ 
    {
      dedicatedResources?: [ 
        {
          resourceId?: string(name='ResourceId', example='eas-r-lq9p****ao9m2'),
        }
      ](name='DedicatedResources'),
      memberType?: string(name='MemberType', example='Default'),
      publicResources?: [ 
        {
          instanceType?: string(name='InstanceType', example='ml.gx9cf.8.62xlarg'),
        }
      ](name='PublicResources'),
      quotas?: [ 
        {
          quotaId?: string(name='QuotaId', example='quotagn***bb68'),
        }
      ](name='Quotas'),
    }
  ](name='MemberMatches'),
  requestId?: string(name='RequestId', example='B6B54325-C98C-5937-87A3-2F96C07652EC'),
}

model GetModelDeploymentResourcesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetModelDeploymentResourcesResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetModelDeploymentResources  GetModelDeploymentResourcesRequest
  * @return GetModelDeploymentResourcesResponse
 */
async function getModelDeploymentResources(request: GetModelDeploymentResourcesRequest): GetModelDeploymentResourcesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetModelDeploymentResources', 'GET', '/api/v2/modelgallery/models/{ModelId}/deployment-resources', 'json', false, 'json', request);
}

model GetModelDeploymentSpecRequest {
