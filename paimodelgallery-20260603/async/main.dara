model ListModelGalleryModelsRequest {
  collections?: string(name='Collections', example='QuickStart', position='Query'),
  compressible?: boolean(name='Compressible', example='true', position='Query'),
  conditions?: [ 
    {
      column?: string(name='Column', example='ParameterSize'),
      operator?: string(name='Operator', example='LessThan'),
      value?: string(name='Value', example='1024'),
    }
  ](name='Conditions', shrink='json', position='Query'),
  deepThink?: boolean(name='DeepThink', example='true', position='Query'),
  demonstrable?: boolean(name='Demonstrable', example='true', position='Query'),
  deployable?: boolean(name='Deployable', example='true', position='Query'),
  distillable?: boolean(name='Distillable', example='true', position='Query'),
  domain?: string(name='Domain', example='aigc', position='Query'),
  evaluable?: boolean(name='Evaluable', example='true', position='Query'),
  functionCall?: boolean(name='FunctionCall', example='true', position='Query'),
  modelName?: string(name='ModelName', example='Qwen3-235B-A22B-Thinking-2507', position='Query'),
  modelSeries?: string(name='ModelSeries', example='Qwen', position='Query'),
  modelType?: string(name='ModelType', example='LoRA', position='Query'),
  order?: string(name='Order', example='DESC', position='Query'),
  origin?: string(name='Origin', example='ModelScope', position='Query'),
  pageNumber?: int32(name='PageNumber', example='1', position='Query'),
  pageSize?: int32(name='PageSize', example='10', position='Query'),
  query?: string(name='Query', example='Qwen', position='Query'),
  sortBy?: string(name='SortBy', example='GmtCreateTime', position='Query'),
  supportedCompressionResource?: string(name='SupportedCompressionResource', example='GP7V', position='Query'),
  supportedDistillationResource?: string(name='SupportedDistillationResource', example='GP7V', position='Query'),
  supportedEvaluationResource?: string(name='SupportedEvaluationResource', example='GP7V', position='Query'),
  supportedInferenceResource?: string(name='SupportedInferenceResource', example='GP7V', position='Query'),
  supportedTrainingResource?: string(name='SupportedTrainingResource', example='GP7V', position='Query'),
  tag?: [ 
    {
      key?: string(name='Key', example='k1'),
      value?: string(name='Value', example='v1'),
    }
  ](name='Tag', shrink='json', position='Query'),
  task?: string(name='Task', example='large-language-model', position='Query'),
  trainable?: boolean(name='Trainable', example='true', position='Query'),
}

model ListModelGalleryModelsResponseBody = {
  models?: ModelGalleryModel(name='Models', example='[]'),
  requestId?: string(name='RequestId', description='Id of the request', example='B6B54325-C98C-5937-87A3-2F96C07652EC'),
  totalCount?: string(name='TotalCount', example='15'),
