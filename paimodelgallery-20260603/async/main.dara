  * @return ListModelGalleryModelsResponse
 */
async function listModelGalleryModels(request: ListModelGalleryModelsRequest): ListModelGalleryModelsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ListModelGalleryModels', 'GET', '/api/v2/modelgallery/models', 'json', false, 'json', request);
