  supportedInferenceMethods?: map[string]any(name='SupportedInferenceMethods', example='{
  "Methods": [{
    "framework": "blade",
    "scenario": "nvidia-standard",
    "Resource": "GPU"
  }]
}'),
  supportedInferenceResources?: string(name='SupportedInferenceResources', example='GPU,GP7V'),
  supportedTrainingMethods?: map[string]any(name='SupportedTrainingMethods', example='{
  "Methods": [{
    "Method": "SFT",
    "SubMethod": "LoRA_LLM",
    "Resource": "GPU"
  }]
}'),
  supportedTrainingResources?: string(name='SupportedTrainingResources', example='GPU,GP7V'),
  tags?: {
    key?: string(name='Key', example='k1'),
    value?: string(name='Value', example='v1'),
  }(name='Tags'),
  task?: string(name='Task', example='large-language-model'),
  trainable?: boolean(name='Trainable', example='true'),
}

