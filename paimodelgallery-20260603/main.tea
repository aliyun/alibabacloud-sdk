  extraInfo?: map[string]any(name='ExtraInfo', example='{}'),
  functionCall?: boolean(name='FunctionCall', example='true'),
  gmtCreateTime?: string(name='GmtCreateTime', example='2026-04-03T05:54:02.000Z'),
  gmtLatestVersionModified?: string(name='GmtLatestVersionModified', example='2025-12-03T07:21:28.000Z'),
  gmtModifiedTime?: string(name='GmtModifiedTime', example='2026-04-03T05:54:02.000Z'),
