  modelSeries?: string(name='ModelSeries', example='Qwen'),
  modelType?: string(name='ModelType', example='LoRA'),
  orderNumber?: long(name='OrderNumber', example='1'),
  origin?: string(name='Origin', example='PAI'),
  parameterSize?: long(name='ParameterSize', example='1024'),
  searchWords?: string(name='SearchWords', example='llm'),
  supportedCompressionMethods?: map[string]any(name='SupportedCompressionMethods', example='{
  "Methods": [{
    "Method": "Quantization",
    "SubMethod": "MinMax-8Bit",
    "Resource": "GPU"
  }]
}'),
  supportedCompressionResources?: string(name='SupportedCompressionResources', example='GPU,GP7V'),
  supportedDistillationMethods?: map[string]any(name='SupportedDistillationMethods', example='{
  "Methods": [{
    "Method": "EasyDistill",
    "SubMethod": "DataSynthesis",
    "Resource": "GPU"
  }]
}'),
  supportedDistillationResources?: string(name='SupportedDistillationResources', example='GPU,GP7V'),
  supportedEvaluationMethods?: map[string]any(name='SupportedEvaluationMethods', example='{
  "Methods": [{
