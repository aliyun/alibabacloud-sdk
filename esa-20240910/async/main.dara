          negate?: boolean(name='Negate', description='Converts a value or condition to its opposite.'),
        }
      ](name='Criteria', description='The details of logical databases.'),
      logic?: string(name='Logic', description='The logical judgment.', example='and'),
      matchOperator?: string(name='MatchOperator', description='The matching operator.', example='eq'),
      matchType?: string(name='MatchType', description='The matching type.', example='ip.src'),
      matchValue?: any(name='MatchValue', description='The value of the matching condition.', example='1.1.1.1'),
      negate?: boolean(name='Negate', description='Converts a value or condition to its opposite.'),
    }
  ](name='Criteria', description='The details of logical databases.'),
  logic?: string(name='Logic', description='The logical judgment.', example='and'),
  matchOperator?: string(name='MatchOperator', description='The matching operator.', example='eq'),
  matchType?: string(name='MatchType', description='The matching type.', example='ip.src'),
  matchValue?: any(name='MatchValue', description='The value of the matching condition.', example='1.1.1.1'),
  negate?: boolean(name='Negate', description='Converts a value or condition to its opposite.'),
}

model WafSiteSettings {
  addBotProtectionHeaders?: {
    enable?: boolean(name='Enable', description='The switch.'),
  }(name='AddBotProtectionHeaders', description='The bot protection headers.'),
  addSecurityHeaders?: {
    enable?: boolean(name='Enable', description='The switch.'),
  }(name='AddSecurityHeaders', description='The security headers.'),
  bandwidthAbuseProtection?: {
    action?: string(name='Action', description='The action of the bandwidth abuse protection rule.', example='deny'),
    id?: long(name='Id', description='The ID of the bandwidth abuse protection rule.', example='10000001'),
    status?: string(name='Status', description='The switch status of the bandwidth abuse protection rule.', example='on'),
  }(name='BandwidthAbuseProtection', description='The bandwidth abuse protection.'),
  botManagement?: {
    definiteBots?: {
      action?: string(name='Action', description='The action.', example='captcha'),
      id?: long(name='Id', description='The rule ID.', example='20000001'),
    }(name='DefiniteBots', description='The definite bots.'),
    effectOnStatic?: {
      enable?: boolean(name='Enable', description='The switch.', example='true'),
    }(name='EffectOnStatic', description='Specifies whether the rule applies to static resource requests.'),
    JSDetection?: {
      enable?: boolean(name='Enable', description='The switch.'),
    }(name='JSDetection', description='The JavaScript detection.'),
    likelyBots?: {
      action?: string(name='Action', description='The action.', example='deny'),
      id?: long(name='Id', description='The rule ID.', example='20000002'),
    }(name='LikelyBots', description='The likely bots.'),
    verifiedBots?: {
      action?: string(name='Action', description='The action.', example='bypass'),
      id?: long(name='Id', description='The rule ID.', example='20000003'),
    }(name='VerifiedBots', description='The verified bots.'),
  }(name='BotManagement', description='The bot management.'),
  clientIpIdentifier?: {
    headers?: [ string ](name='Headers', description='The specified headers.'),
    mode?: string(name='Mode', description='The identification mode.', example='headers'),
  }(name='ClientIpIdentifier', description='The client IP identification.'),
  disableSecurityModule?: {
    status?: string(name='Status', description='The status switch for disabling the security module.', example='on'),
  }(name='DisableSecurityModule', description='The disable security module configuration.'),
  requestBodyInspection?: {
    action?: string(name='Action', description='The action to take when the request body size exceeds `SizeLimit`.

Common values (the complete enumeration is subject to the server-side configuration):
- `allow`: Allow directly without performing deep packet inspection on the excess portion.

> The complete enum is subject to the WAF server-side configuration.', example='allow'),
    id?: long(name='Id', description='The request body inspection rule ID (unique identifier of the built-in rule). When request body inspection is enabled, the server uses this ID to associate the matching logic of the built-in inspection rule. The ID value is subject to the WAF built-in rule list.', example='10000001'),
    sizeLimit?: string(name='SizeLimit', description='The maximum size of the request body to inspect, in bytes.

- When the request body is less than or equal to this value, the entire content is subject to WAF matching.
- When the request body exceeds this value, the action specified in the `Action` field is taken (for example, inspect only the first N bytes, reject, or allow directly).

> The specific value range and default value are subject to the WAF server-side configuration.', example='16KB'),
  }(name='RequestBodyInspection', description='The request body inspection configuration. Controls the deep packet inspection behavior of WAF for HTTP request bodies. After this feature is enabled, content-based matching rules such as SQL injection and XSS detection take effect on request bodies.

This configuration can contain the following fields:
- `Id`: The unique identifier of the built-in inspection rule.
- `SizeLimit`: The maximum size of the request body to inspect.
- `Action`: The action to take when the request body exceeds the size limit.'),
  securityLevel?: {
    id?: long(name='Id'),
    value?: string(name='Value', description='The security level value.', example='low'),
  }(name='SecurityLevel', description='The security level.'),
}

model WafTimer {
  periods?: [ 
    {
      end?: string(name='End', description='The end time in RFC 3339 UTC format.', example='2025-01-01T01:00:00Z'),
      start?: string(name='Start', description='The start time in RFC 3339 UTC format.', example='2025-01-01T00:00:00Z'),
    }
  ](name='Periods', description='The effective periods.'),
  scopes?: string(name='Scopes', description='The timer type: permanently effective (permanent/empty), effective during time periods (periods), or periodically effective (weekly).', example='permanent'),
  weeklyPeriods?: [ 
    {
      dailyPeriods?: [ 
        {
          end?: string(name='End', description='The end time in HH:mm:ss format.', example='01:00:00'),
          start?: string(name='Start', description='The start time in HH:mm:ss format.', example='00:00:00'),
        }
      ](name='DailyPeriods', description='The effective period within the epoch.'),
      days?: string(name='Days', description='The days of the week, separated by commas. Values 1-7 represent Monday through Sunday.<br>Example: Monday and Wednesday is "1,3".', example='1'),
    }
  ](name='WeeklyPeriods', description='The weekly effective periods.'),
  zone?: int32(name='Zone', description='The time zone. Default value: UTC+00:00.<br>Example: 8 indicates UTC+8, -8 indicates UTC-8.<br>Valid range: -12 to +14.', example='8'),
}

model ActivateClientCertificateRequest {
  id: string(name='Id', description='The certificate ID, which can be obtained by calling the [ListClientCertificates](https://help.aliyun.com/document_detail/2852848.html) operation.

This parameter is required.', example='babaded901474b9693acf530e0fb****', position='Query'),
  siteId: long(name='SiteId', description='The website ID, which can be obtained by calling the [ListSites](https://help.aliyun.com/document_detail/2850189.html) operation.

This parameter is required.', example='1234567890123', position='Query'),
}

model ActivateClientCertificateResponseBody = {
  id?: string(name='Id', description='The certificate ID.', example='babaded901474b9693acf530e0fb****'),
  requestId?: string(name='RequestId', description='The request ID.', example='0AEDAF20-4DDF-4165-8750-47FF9C1929C9'),
  siteId?: long(name='SiteId', description='The website ID.', example='1234567890123'),
  siteName?: string(name='SiteName', description='The website name.', example='example.com'),
}

model ActivateClientCertificateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ActivateClientCertificateResponseBody(name='body'),
}

/**
  * @param request  the request parameters of ActivateClientCertificate  ActivateClientCertificateRequest
  * @return ActivateClientCertificateResponse
 */
async function activateClientCertificate(request: ActivateClientCertificateRequest): ActivateClientCertificateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ActivateClientCertificate', 'GET', '/', 'json', false, 'json', request);
}

