  generation?: int32(name='generation', example='1'),
  image?: string(name='image', example='registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12'),
  osType?: string(name='osType', example='linux-amd64'),
  readyCommand?: string(name='readyCommand', example='curl -sf http://127.0.0.1:49983/health'),
