/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hangzhou' = 'sandbox-vpc.cn-hangzhou.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('sandbox', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AgenticBucketVolumeConfig {
  agenticBucket?: string(name='agenticBucket', example='workspace01'),
  bucketName?: string(name='bucketName', example='sandbox-test'),
  bucketPath?: string(name='bucketPath', example='/'),
  endpoint?: string(name='endpoint', example='https://oss-cn-hangzhou.aliyuncs.com'),
  readOnly?: boolean(name='readOnly', example='true'),
}

model AgenticFSVolumeConfig {
  accessPointID?: string(name='accessPointID', description='The access point ID.', example='ap-xxxx'),
  agenticSpaceID?: string(name='agenticSpaceID', description='The workspace ID.', example='agentic-xxxx'),
  fileSystemID?: string(name='fileSystemID', description='The file system ID.', example='03204sl2qjiax4ocdt2'),
  groupID?: int32(name='groupID', description='The group ID for local mounting.', example='1000'),
  serverAddr?: string(name='serverAddr', description='The AgenticFS access point address.', example='ap-xxxx.03204sl2qjiax4ocdt2-ljs60.cn-shanghai.nas.aliyuncs.com'),
  userID?: int32(name='userID', description='The user ID for local mounting.', example='1000'),
}

model ApiKey {
  apiKeyID?: string(name='apiKeyID', example='a1f8c3d6-****'),
  apiKeyMask?: string(name='apiKeyMask', example='e2b_3f9a****b915'),
  apiKeyName?: string(name='apiKeyName', example='ci-pipeline-key'),
  apiKeyValue?: string(name='apiKeyValue', example='e2b_****'),
  createdTime?: string(name='createdTime', example='2026-08-20T08:30:00Z'),
  expireTime?: string(name='expireTime', example='2099-12-31T23:59:59Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist'),
  lastUsedTime?: string(name='lastUsedTime', example='2026-09-10T14:22:07Z'),
  resourceGroupID?: string(name='resourceGroupID', example='rg-****'),
  source?: string(name='source', example='generated'),
  status?: string(name='status', example='active'),
  teamID?: string(name='teamID', example='5f4a2c18-****'),
  teamName?: string(name='teamName', example='sandbox-dev'),
  teamPlan?: string(name='teamPlan', example='std'),
  userID?: string(name='userID', example='9c1d4e72-****'),
  username?: string(name='username', example='sandbox-admin'),
}

model CertConfig {
  certName?: string(name='certName', description='The certificate name, which is used to identify the certificate in the console.', example='sandbox-example-com'),
  certificate?: string(name='certificate', description='The certificate public key content in PEM format, including the complete certificate chain.', example='-----BEGIN CERTIFICATE-----
MIIDdzCCAl+gAwIBAgIEbGVzc29u
-----END CERTIFICATE-----'),
  privateKey?: string(name='privateKey', description='The certificate private key content in PEM format. The private key is encrypted and stored on the server side, and is not returned in plaintext when queried.', example='-----BEGIN RSA PRIVATE KEY-----
****
-----END RSA PRIVATE KEY-----'),
}

model ContainerConfiguration {
  acrInstanceId?: string(name='acrInstanceId', example='cri-****'),
  image?: string(name='image', example='registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12'),
  registryCredential?: {
    password?: string(name='password', example='Passw0rd****'),
    username?: string(name='username', example='sandbox-puller'),
  }(name='registryCredential'),
}

model CreateApiKeyInput {
  apiKeyName?: string(name='apiKeyName', description='The name of the API key. The name can be up to 128 characters in length and can contain letters, digits, spaces, hyphens (-), underscores (_), and periods (.).', example='ci-pipeline-key'),
  expireTime?: string(name='expireTime', description='The expiration time of the API key. The time is in UTC and in the RFC 3339 format. If you leave this parameter empty, the API key never expires.', example='2099-12-31T23:59:59Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist', description='The IP blacklist. After you configure this parameter, IP addresses in the list cannot use the API key. This parameter is mutually exclusive with ipWhitelist.'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist', description='The IP address whitelist. After you configure this parameter, only IP addresses in the list can use the API key. This parameter is mutually exclusive with ipBlacklist.'),
  teamID?: string(name='teamID', description='The ID of the team to which the API key belongs. The value is in UUID format. If you do not specify this parameter, the default team of the current account is used.', example='5f4a2c18-****'),
}

