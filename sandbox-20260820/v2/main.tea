  }(name='mountConfig', description='The mount configuration.'),
  ossVolumeConfig?: OSSVolumeConfig(name='ossVolumeConfig', description='The OSS Volume configuration.'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='37ddc466-****'),
  volumeName?: string(name='volumeName', description='The name, which must be unique within the team.', example='workspace'),
}

