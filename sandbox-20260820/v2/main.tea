model PublicTemplate {
  createdTime?: string(name='createdTime', example='2026-08-20T08:30:00Z'),
  name?: string(name='name', example='python-data-analysis'),
  resourceGroupID?: string(name='resourceGroupID', example='rg-****'),
  runtimeConfig?: PublicTemplateRuntimeConfig(name='runtimeConfig'),
  status?: PublicTemplateStatus(name='status'),
  teamID?: string(name='teamID', example='5f4a2c18-****'),
  teamName?: string(name='teamName', example='sandbox-dev'),
  templateID?: string(name='templateID', example='tm-8f3a2c7b5e14d806'),
}

model PublicTemplateCache {
  createdTime?: string(name='createdTime', example='2026-09-18T10:00:00Z'),
  imageDigest?: string(name='imageDigest', example='sha256:8f3c2a1b'),
  imageSizeMB?: int32(name='imageSizeMB', example='512'),
  progress?: int32(name='progress', example='80'),
  readyTime?: string(name='readyTime', example='2026-09-18T10:05:00Z'),
  status?: string(name='status', example='Success'),
  statusReason?: string(name='statusReason', example='镜像预热任务排队中'),
  teamID?: string(name='teamID', example='13b721e6-8cc8-5df2-af13-80316f7508af'),
  templateID?: string(name='templateID', example='us7dxqaezw5uu7aa2cm5'),
}

model PublicTemplateLogConfig {
  logstore?: string(name='logstore', example='sandbox-runtime'),
  project?: string(name='project', example='sandbox-log-cn-hangzhou'),
}

model PublicTemplateRegistryConfig {
  networkConfig?: PublicTemplateRegistryNetworkConfig(name='networkConfig'),
}

model PublicTemplateRegistryNetworkConfig {
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group used to access the image repository.', example='sg-****'),
  vSwitchId?: string(name='vSwitchId', description='The ID of the vSwitch used to access the image repository.', example='vsw-****'),
  vpcId?: string(name='vpcId', description='The ID of the VPC used to access the image repository.', example='vpc-****'),
}

model PublicTemplateRuntimeConfig {
  cpu?: float(name='cpu', example='2'),
  diskSize?: int32(name='diskSize', example='10240'),
  internetAccess?: boolean(name='internetAccess'),
