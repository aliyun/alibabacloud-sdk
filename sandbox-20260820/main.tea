  networkConfig?: PublicUpdateTemplateRegistryNetworkConfig(name='networkConfig', description='The image repository network configuration.'),
}

model PublicUpdateTemplateRegistryNetworkConfig {
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group used to access the repository.', example='sg-bp1abc123'),
  vSwitchId?: string(name='vSwitchId', description='The ID of the vSwitch where the repository resides.', example='vsw-bp1abc123'),
  vpcId?: string(name='vpcId', description='The ID of the VPC where the repository resides.', example='vpc-bp1abc123'),
