model PublicUpdateTemplateRuntimeConfig {
  cpu?: float(name='cpu', description='The number of vCPU cores.', example='2'),
  diskSize?: int32(name='diskSize', description='The system cloud disk size in MB.', example='512'),
  internetAccess?: boolean(name='internetAccess', description='Specifies whether the sandbox is allowed to access the Internet.'),
  logConfig?: PublicUpdateTemplateLogConfig(name='logConfig', description='The log configuration.'),
  memorySize?: int32(name='memorySize', description='The memory size in MB.', example='2048'),
  sandboxConfig?: PublicUpdateTemplateSandboxConfig(name='sandboxConfig', description='The sandbox configuration.'),
  vpcBindings?: [ string ](name='vpcBindings', description='If omitted or set to null, the original list is retained. A non-empty array replaces the entire allowed set. An explicit empty array [] clears the inbound VPC restrictions for the new version. This field is independent of vpcConfig. An empty request body {}, an empty runtimeConfig, or a runtimeConfig that contains only vpcBindings: null returns a 400 error and does not clear the bindings. The actual JSON received by the server prevails. An empty array omitted by the SDK cannot clear the list.', example='["vpc-examplea","vpc-exampleb"]'),
  vpcConfig?: PublicUpdateTemplateVPCConfig(name='vpcConfig', description='The VPC network configuration.'),
}

model PublicUpdateTemplateSandboxConfig {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the ACR Enterprise instance.', example='cri-abc123'),
  generation?: int32(name='generation', description='The sandbox generation. Valid values: 1: rund. 2: micro.', example='2'),
  image?: string(name='image', description='The image address.', example='registry.cn-hangzhou.aliyuncs.com/my/ns:v1'),
  osType?: string(name='osType', description='The operating system type.', example='linux'),
  readyCommand?: string(name='readyCommand', description='The readiness probe command for the micro sandbox. This command is supported only by the second generation.', example='/ready'),
  registryConfig?: PublicUpdateTemplateRegistryConfig(name='registryConfig', description='The image repository configuration.'),
  registryType?: string(name='registryType', description='The image repository type.', example='acr'),
  startCommand?: string(name='startCommand', description='The startup command for the micro sandbox. This command is supported only by the second generation.', example='/start-coroutines.sh'),
  steps?: [
    PublicUpdateTemplateStep
  ](name='steps', description='The list of custom build steps. If you do not specify this parameter, the original steps are retained. If you pass an empty array, the steps are cleared.'),
}

model PublicUpdateTemplateStep {
  args?: [ string ](name='args', description='The build instruction parameters. The meaning varies depending on type: for USER, it is [username, optional passwordless sudo flag], and the second item configures passwordless sudo when the string is true; for WORKDIR, it is [directory]; for ENV, it is [key, value, ...], and multiple pairs can be set at once; for RUN, it is [command, optional temporary user].'),
  type?: string(name='type', description='The build instruction type. Valid values: USER, WORKDIR, ENV, and RUN. The instructions are executed sequentially in the order of the array.', example='RUN'),
}

model PublicUpdateTemplateVPCConfig {
