/**
 *
 */
import Util;
import GatewayClient;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @productId = 'Sandbox';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('sandbox', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AgenticBucketVolumeConfig {
  agenticBucket?: string(name='agenticBucket', description='The name of the AgenticBucket.', example='workspace01'),
  bucketName?: string(name='bucketName', description='The name of the OSS bucket.', example='sandbox-test'),
  bucketPath?: string(name='bucketPath', description='The path of the mounted OSS bucket.', example='/'),
  endpoint?: string(name='endpoint', description='The OSS endpoint.', example='https://oss-cn-hangzhou.aliyuncs.com'),
  readOnly?: boolean(name='readOnly', description='Specifies whether the access permissions of the mounted directory are read-only after the OSS bucket is mounted. Valid values:
- true: Read-only.
- false: Read and write.', example='true'),
}

model AgenticFSVolumeConfig {
  accessPointID?: string(name='accessPointID', description='The access point ID.', example='ap-xxxx'),
  agenticSpaceID?: string(name='agenticSpaceID', description='The workspace ID.', example='agentic-xxxx'),
  fileSystemID?: string(name='fileSystemID', description='The file system ID.', example='03204sl2qjiax4ocdt2'),
  groupID?: int32(name='groupID', description='The group ID for local mounting.', example='1000'),
  serverAddr?: string(name='serverAddr', description='The AgenticFS access point address.', example='ap-xxxx.03204sl2qjiax4ocdt2-ljs60.cn-shanghai.nas.aliyuncs.com'),
  userID?: int32(name='userID', description='The user ID for local mounting.', example='1000'),
}

model ApiKey {
  apiKeyID?: string(name='apiKeyID', description='The unique identifier of the API key, in UUID format.', example='a1f8c3d6-****'),
  apiKeyMask?: string(name='apiKeyMask', description='The masked value of the API key. It retains the prefix and the first and last four characters, and replaces the middle characters with four asterisks for secure display in the user interface.', example='e2b_3f9a****b915'),
  apiKeyName?: string(name='apiKeyName', description='The name of the API key. The name can be up to 128 characters in length and can contain only letters, digits, spaces, hyphens (-), underscores (_), and half-width periods (.).', example='ci-pipeline-key'),
  apiKeyValue?: string(name='apiKeyValue', description='The plaintext value of the API key, which starts with e2b_. This value is returned only in the responses of the create, import, and reset operations, and is not returned by other operations.', example='e2b_****'),
  createdTime?: string(name='createdTime', description='The creation time of the API key, in UTC and RFC 3339 format.', example='2026-08-20T08:30:00Z'),
  expireTime?: string(name='expireTime', description='The expiration time of the API key, in UTC and RFC 3339 format. An empty value indicates that the API key never expires.', example='2099-12-31T23:59:59Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist', description='The IP address blacklist. After configuration, the IP addresses in the list cannot use the API key. This parameter is mutually exclusive with ipWhitelist.'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist', description='The IP address whitelist. After configuration, only the IP addresses in the list can use the API key. This parameter is mutually exclusive with ipBlacklist.'),
  lastUsedTime?: string(name='lastUsedTime', description='The time when the API key was last used, in UTC and RFC 3339 format. This value is empty if the API key has never been used.', example='2026-09-10T14:22:07Z'),
  resourceGroupID?: string(name='resourceGroupID', description='The ID of the Alibaba Cloud resource group to which the team belongs.', example='rg-****'),
  source?: string(name='source', description='The source of the API key. Valid values: generated (generated by the service) and custom (imported by the user).', example='generated'),
  status?: string(name='status', description='The status of the API key. Valid values: active (enabled) and inactive (disabled). A disabled API key can no longer be used to access the sandbox service.', example='active'),
  teamID?: string(name='teamID', description='The ID of the team to which the resource belongs, in UUID format.', example='5f4a2c18-****'),
  teamName?: string(name='teamName', description='The name of the team.', example='sandbox-dev'),
  teamPlan?: string(name='teamPlan', description='The team plan edition. Valid values: eco (Economy), std (Standard), pro (Professional), and ent (Enterprise).', example='std'),
  userID?: string(name='userID', description='The user ID of the resource creator, in UUID format.', example='9c1d4e72-****'),
  username?: string(name='username', description='The username of the API key creator.', example='sandbox-admin'),
  vpcBindings?: [ string ](name='vpcBindings', description='The set of source VPC IDs allowed for this API key. An omitted or empty array indicates that no VPC source restrictions are configured. If the array is not empty, requests must meet both this VPC restriction and the configured IP source policies. This list is retained when credentials are rotated by calling ResetApiKey.', example='["vpc-examplea","vpc-exampleb"]'),
}

model CertConfig {
  certName?: string(name='certName', description='The certificate name, which is used to identify the certificate in the console.', example='sandbox-example-com'),
  certificate?: string(name='certificate', description='The certificate public key content in PEM format, including the complete certificate chain.', example='-----BEGIN CERTIFICATE-----
MIIDdzCCAl+gAwIBAgIEbGVzc29u
-----END CERTIFICATE-----'),
  privateKey?: string(name='privateKey', description='The certificate private key content in PEM format. The private key is encrypted and stored on the server side, and is not returned in plaintext when queried.', example='-----BEGIN RSA PRIVATE KEY-----
****
-----END RSA PRIVATE KEY-----'),
}

model ContainerConfiguration {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the Container Registry Enterprise instance. This parameter is required when registryType is set to acree.', example='cri-****'),
  image?: string(name='image', description='The address of the sandbox base image.', example='registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12'),
  registryCredential?: {
    password?: string(name='password', description='The logon password or access token for the image repository. The value is encrypted and stored on the server, and plaintext is not returned in query responses.', example='Passw0rd****'),
    username?: string(name='username', description='The logon username for the image repository.', example='sandbox-puller'),
  }(name='registryCredential', description='The repository access credentials used to pull images. You do not need to configure this parameter when you use public images.'),
}

model CreateApiKeyInput {
  apiKeyName?: string(name='apiKeyName', description='The name of the API key. The name can be up to 128 characters in length and can contain only letters, digits, spaces, hyphens (-), underscores (_), and half-width periods (.).', example='ci-pipeline-key'),
  expireTime?: string(name='expireTime', description='The expiration time of the API key. The time must be in UTC and follow the RFC 3339 format. If this parameter is left empty, the API key never expires.', example='2099-12-31T23:59:59Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist', description='The IP address blacklist. After you configure this parameter, the IP addresses in the list cannot use the API key. This parameter is mutually exclusive with ipWhitelist.'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist', description='The IP address whitelist. After you configure this parameter, only the IP addresses in the list can use the API key. This parameter is mutually exclusive with ipBlacklist.'),
  teamID?: string(name='teamID', description='The ID of the team to which the API key belongs. The ID must be in the UUID format. If this parameter is not specified, the default team of the current account is used.', example='5f4a2c18-****'),
  vpcBindings?: [ string ](name='vpcBindings', description='The list of source VPC IDs that are allowed to use this API key to initiate management and control requests. The list is matched as a set. If this parameter is omitted, set to null, or set to an empty array, no restrictions are imposed on the source VPCs. If this parameter is not empty, only requests from trusted source VPCs that match the list are allowed. Requests from the Internet or from unverified source VPCs are rejected. This parameter can be configured together with the IP address whitelist or blacklist. Requests must meet both restrictions. This field is independent of the vpcBindings field of the template.', example='["vpc-examplea","vpc-exampleb"]'),
}

model CreateCustomDomainInput {
  certConfig?: CertConfig(name='certConfig', description='The HTTPS certificate configuration used by the domain name.'),
  description?: string(name='description', description='The description of the custom domain name.', example='Entry domain name for the sandbox preview environment'),
  domainName?: string(name='domainName', description='The custom domain name.', example='sandbox.example.com'),
  tlsConfig?: TLSConfig(name='tlsConfig', description='The TLS protocol configuration used by the domain name.'),
}

model CreateSnapshotInput {
  name?: string(name='name', description='The snapshot name.', example='name'),
  resourceTags?: [ 
    {
      key?: string(name='key', description='The tag key.', example='project'),
      value?: string(name='value', description='The tag value.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  sandboxID?: string(name='sandboxID', description='The source sandbox ID.

This parameter is required.', example='sbx-****'),
  teamID?: string(name='teamID', description='The team ID.

This parameter is required.', example='70d1****abcd'),
}

model CreateTeamInput {
  description?: string(name='description', description='The description of the team.', example='Sandbox environment for the algorithm team'),
  plan?: string(name='plan', description='The plan specification of the team. Valid values: eco (economy), std (standard), pro (professional), ent (enterprise).', example='std'),
  resourceGroupID?: string(name='resourceGroupID', description='The ID of the Alibaba Cloud resource group to which the team belongs. If this parameter is not specified, the default resource group of the account is used.', example='rg-****'),
  teamName?: string(name='teamName', description='The name of the team.', example='sandbox-dev'),
}

model CreateTemplateBuildConfig {
  copy?: CreateTemplateCopyAction(name='copy', description='The action configuration for pulling the source image and pushing it to the destination repository.'),
  envdInject?: CreateTemplateEnvdInjectAction(name='envdInject', description='The action configuration for packaging the envd daemon process into the image. This is an optional intermediate step in the copy process and is supported only by first-generation sandboxes.'),
  installStorageClients?: boolean(name='installStorageClients', description='The installation of clients required for storage mounting.'),
}

model CreateTemplateCacheInput {
  teamID?: string(name='teamID', description='The team ID.', example='13b721e6-8cc8-5df2-af13-80316f7508af'),
  templateID?: string(name='templateID', description='The unique identifier of the template.', example='us7dxqaezw5uu7aa2cm5'),
}

model CreateTemplateCopyAction {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the destination Container Registry Enterprise instance. This field does not inherit the instance ID of the source image.', example='cri-****'),
  enabled?: boolean(name='enabled', description='Specifies whether to enable the image replication action. This parameter is required when this action block is passed.'),
  image?: string(name='image', description='The destination image address for the push operation. If this parameter is not provided, the service derives a new tag in the repository where the source image is located.', example='registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12-envd'),
  registryConfig?: CreateTemplateRegistryConfig(name='registryConfig', description='The credentials, TLS settings, and network configurations required to access the destination image repository.'),
  registryType?: string(name='registryType', description='The type of the destination image repository. Valid values: oci (standard OCI repository), acr (Container Registry Personal Edition), and acree (Container Registry Enterprise Edition). By default, the value is derived from the destination image address.', example='acree'),
}

model CreateTemplateEnvdInjectAction {
  enabled?: boolean(name='enabled', description='Specifies whether to enable the envd injection action. This parameter is required when this action block is specified.'),
}

model CreateTemplateInput {
  buildConfig?: CreateTemplateBuildConfig(name='buildConfig', description='The build configuration of the template. This configuration specifies the build process in action-based chunks. If this parameter is not specified, the service automatically derives the configuration based on the source image. Public runtime images are used directly without building. For other images, the copy and envdInject actions are automatically executed.'),
  name?: string(name='name', description='The name of the template. The name must be unique within the same team.', example='python-data-analysis'),
  resourceTags?: [ 
    {
      key?: string(name='key', description='The key of the tag.', example='project'),
      value?: string(name='value', description='The value of the tag.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  runtimeConfig?: CreateTemplateRuntimeConfig(name='runtimeConfig', description='The runtime configuration of the template. This configuration determines the specifications and environment of the sandbox instances created from the template.'),
  teamID?: string(name='teamID', description='The ID of the team to which the template belongs. The ID must be in UUID format. If this parameter is not specified, the default team of the current account is used.', example='5f4a2c18-****'),
  templateType?: string(name='templateType', description='The templatetype. Set this parameter to layer to build a layer template.', example='layer'),
}

model CreateTemplateLogConfig {
  logstore?: string(name='logstore', description='The name of the Simple Log Service Logstore that receives sandbox runtime logs.', example='sandbox-runtime'),
  project?: string(name='project', description='The name of the Simple Log Service project that receives sandbox runtime logs.', example='sandbox-log-cn-hangzhou'),
}

model CreateTemplateRegistryAuthConfig {
  password?: string(name='password', description='The logon password or access token for the image repository. The value is encrypted on the server side and is not returned in plaintext when queried.', example='Passw0rd****'),
  userName?: string(name='userName', description='The username for logging on to the image repository.', example='sandbox-puller'),
}

model CreateTemplateRegistryCertConfig {
  insecure?: boolean(name='insecure', description='Specifies whether to skip HTTPS certificate validation for the image repository. Enable this option only for private repositories that use self-signed certificates.'),
}

model CreateTemplateRegistryConfig {
  authConfig?: CreateTemplateRegistryAuthConfig(name='authConfig', description='The logon credentials for the image repository. No configuration is required when accessing a public repository.'),
  certConfig?: CreateTemplateRegistryCertConfig(name='certConfig', description='The certificate validation configuration for accessing the image repository.'),
  networkConfig?: CreateTemplateRegistryNetworkConfig(name='networkConfig', description='The VPC configuration used to access the image repository. Configuration is required only when the repository is reachable only within a VPC.'),
}

model CreateTemplateRegistryNetworkConfig {
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group used to access the image repository.', example='sg-****'),
  vSwitchId?: string(name='vSwitchId', description='The ID of the vSwitch used to access the image repository.', example='vsw-****'),
  vpcId?: string(name='vpcId', description='The ID of the VPC used to access the image repository.', example='vpc-****'),
}

model CreateTemplateRuntimeConfig {
  cpu?: float(name='cpu', description='The CPU specifications of the sandbox instance, in cores.', example='2'),
  diskSize?: int32(name='diskSize', description='The disk specifications of the sandbox instance, in MB.', example='10240'),
  internetAccess?: boolean(name='internetAccess', description='Specifies whether the sandbox instance is allowed to access the Internet.'),
  logConfig?: CreateTemplateLogConfig(name='logConfig', description='The log delivery configuration of the sandbox instance.'),
  memorySize?: int32(name='memorySize', description='The memory specifications of the sandbox instance, in MB.', example='2048'),
  sandboxConfig?: CreateTemplateSandboxConfig(name='sandboxConfig', description='The image and startup configuration of the sandbox instance.'),
  vpcBindings?: [ string ](name='vpcBindings', description='A non-empty array configures the set of source VPCs that are allowed to access the sandbox data endpoint. Omitting the field, setting it to null, or providing an empty array indicates that no inbound bindings are configured. This configuration is independent of the egress network vpcConfig and does not modify the API key source policy. A null value is treated as omitted to maintain compatibility with SDK requests where the field is not set. You can update or clear the list by calling UpdateTemplate. The changes take effect after a new version is successfully built, and existing sandboxes continue to use the original configuration.', example='["vpc-examplea","vpc-exampleb"]'),
  vpcConfig?: CreateTemplateVPCConfig(name='vpcConfig', description='The VPC configuration of the sandbox instance.'),
}

model CreateTemplateSandboxConfig {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the Container Registry Enterprise instance. This parameter is required when registryType is set to acree.', example='cri-****'),
  generation?: int32(name='generation', description='The sandbox generation. Valid values: 1 (first generation) and 2 (second generation). Default value: 1.', example='1'),
  image?: string(name='image', description='The address of the sandbox base image.', example='registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12'),
  osType?: string(name='osType', description='The operating system type of the second-generation sandbox. Valid values: linux-amd64, android-36-osworld, and windows-osworld.', example='linux-amd64'),
  readyCommand?: string(name='readyCommand', description='The readiness probe command for the sandbox. A successful execution indicates that the sandbox is ready to receive requests. This parameter is supported only by first-generation sandboxes.', example='curl -sf http://127.0.0.1:49983/health'),
  registryConfig?: CreateTemplateRegistryConfig(name='registryConfig', description='The credentials, TLS, and network configurations required to access the source image repository.'),
  registryType?: string(name='registryType', description='The type of the image repository. Valid values: oci (standard OCI repository), acr (Container Registry Personal Edition), and acree (Container Registry Enterprise Edition). The default value is inferred from the image address.', example='acree'),
  startCommand?: string(name='startCommand', description='The startup command for the sandbox container. This parameter is supported only by first-generation sandboxes.', example='/usr/local/bin/start.sh'),
  steps?: [
    CreateTemplateStep
  ](name='steps', description='The list of custom build steps.'),
}

model CreateTemplateStep {
  args?: [ string ](name='args', description='The build instruction parameters, whose meaning varies depending on the type: for USER, it is [username, optional passwordless sudo flag], where the second item configures passwordless sudo when it is the string true; for WORKDIR, it is [directory]; for ENV, it is [key, value, ...], allowing multiple pairs to be set at once; for RUN, it is [command, optional temporary user].'),
  type?: string(name='type', description='The build instruction type, which supports four values: USER, WORKDIR, ENV, and RUN, executed sequentially in the order of the array.', example='RUN'),
}

model CreateTemplateVPCConfig {
  role?: string(name='role', description='The ARN of the RAM role assumed by the sandboxed container instance when accessing the VPC. Format: acs:ram::{account ID}:role/{role name}.', example='acs:ram::1234567890123456:role/aliyunfcdefaultrole'),
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group used by the sandboxed container instance.', example='sg-****'),
  vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitch IDs that the sandboxed container instance connects to. Configure vSwitches in multiple zones to improve availability.'),
  vpcId?: string(name='vpcId', description='The ID of the VPC that the sandboxed container instance connects to.', example='vpc-****'),
}

model CreateVolumeInput {
  agenticBucketVolumeConfig?: AgenticBucketVolumeConfig(name='agenticBucketVolumeConfig', description='The AgenticBucket Volume configuration.'),
  agenticFSVolumeConfig?: {
    groupID?: int32(name='groupID', description='The groupID of the local directory.', example='1000'),
    serverAddr?: string(name='serverAddr', description='The Access Point endpoint address.', example='ap-xxxx.xxxx-jnk89.cn-hangzhou.nas.aliyuncs.com:/'),
    userID?: int32(name='userID', description='The userID of the local directory.', example='1000'),
  }(name='agenticFSVolumeConfig', description='The AgenticFS Volume configuration.'),
  juiceFSVolumeConfig?: JuiceFSVolumeConfig(name='juiceFSVolumeConfig', description='The JuiceFS Volume configuration.'),
  mountConfig?: {
    role?: string(name='role', description='The permission role.', example='acs:ram::1118555931230119:role/aliyunfcdefaultrole'),
    vpcConfig?: {
      securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-xxxx'),
      vSwitchIds?: [ string ](name='vSwitchIds', description='The vSwitch IDs.'),
      vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-****'),
    }(name='vpcConfig', description='The VPC configuration.'),
  }(name='mountConfig', description='The mount configuration.'),
  ossVolumeConfig?: OSSVolumeConfig(name='ossVolumeConfig', description='The OSS Volume configuration.'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='37ddc466-****'),
  volumeName?: string(name='volumeName', description='The name, which must be unique within the team.', example='workspace'),
}

model CreateWarmPoolInput {
  capacityPolicy?: WarmPoolCapacityPolicyInput(name='capacityPolicy', description='The warm pool capacity policy, which includes the base target capacity and optional scheduled rules.

This parameter is required.'),
  templateID?: string(name='templateID', description='The template ID, which specifies the template associated with the warm pool.

This parameter is required.', example='tpl-example1234567890'),
}

model CustomDomainResp {
  certConfig?: CertConfig(name='certConfig', description='The HTTPS certificate configuration used by the domain name.'),
  createdAt?: long(name='createdAt', description='The time when the domain name was created. The value is a UNIX timestamp in milliseconds.', example='1755676800000'),
  description?: string(name='description', description='The description of the custom domain name.', example='Domain name for the sandbox preview environment'),
  domainName?: string(name='domainName', description='The custom domain name.', example='sandbox.example.com'),
  tlsConfig?: TLSConfig(name='tlsConfig', description='The TLS protocol configuration used by the domain name.'),
  updatedAt?: long(name='updatedAt', description='The time when the domain name was last updated. The value is a UNIX timestamp in milliseconds.', example='1755763200000'),
}

model E2BLifecycle {
  autoResume?: boolean(name='autoResume'),
  onTimeout?: string(name='onTimeout'),
}

model E2BListedSandbox {
  cpuCount?: int32(name='cpuCount', description='The number of vCPUs.', example='2'),
  diskSizeMB?: int32(name='diskSizeMB', description='The ephemeral disk size.', example='10240'),
  endAt?: string(name='endAt', description='The end time.', example='2026-09-03T02:06:37.932Z'),
  generation?: int32(name='generation', description='The sandbox version.', example='2'),
  memoryMB?: int32(name='memoryMB', description='The memory size.', example='2'),
  metadata?: map[string]string(name='metadata', description='The metadata.'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-****'),
  resourceTags?: [ 
    {
      tagKey?: string(name='tagKey', description='The tag key.', example='project'),
      tagValue?: string(name='tagValue', description='The tag value.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  sandboxID?: string(name='sandboxID', description='The sandbox ID.', example='sbx-xxxx'),
  snapshotID?: string(name='snapshotID', description='The snapshot ID.', example='0d66****b374'),
  startedAt?: string(name='startedAt', description='The start time.', example='2026-09-03T02:05:37.932Z'),
  state?: string(name='state', description='The sandbox state. Valid values:
- running: Running.
- pausing: Pausing.
- paused: Paused.
- resuming: Resuming.
- pause_fail: Pause failed.
- resume_fail: Resume failed.
- snapshotting: Creating a snapshot.
- snapshot_failed: Snapshot creation failed.
- terminated: Terminated.', example='running'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='9f5a1fe9-****'),
  teamName?: string(name='teamName', description='The team name.', example='default'),
  teamPlan?: string(name='teamPlan', description='The QoS version.', example='eco'),
  templateID?: string(name='templateID', description='The unique identifier of the template.', example='f1l97phhfw6ox18iwcfk'),
  templateName?: string(name='templateName', description='The template name.', example='base'),
  userID?: string(name='userID', description='The UID of the creator.', example='2000****'),
}

model E2BListedTemplate {
  buildStatus?: string(name='buildStatus', description='The template build status. Valid values:
- waiting: Waiting to build.
- building: Building.
- ready: Build succeeded.
- error: Build failed.', example='ready'),
  category?: string(name='category', description='The template category. Valid values:
- builtin: A system built-in template.
- custom: A user-created template.', example='custom'),
  containerConfiguration?: ContainerConfiguration(name='containerConfiguration', description='The container image configuration of the template.'),
  cpuCount?: int32(name='cpuCount', description='The CPU specification of the sandbox instance, in cores.', example='2'),
  createdAt?: string(name='createdAt', description='The creation time in UTC, in RFC 3339 format.', example='2026-08-20T08:30:00Z'),
  functionName?: string(name='functionName', description='The Function Compute function name that the template currently points to. This value is empty when the template is in a failed state.', example='sandbox-tm-8f3a2c7b5e14d806'),
  logConfiguration?: LogConfiguration(name='logConfiguration', description='The log delivery configuration of the template.'),
  memoryMB?: int32(name='memoryMB', description='The memory specification of the sandbox instance, in MB.', example='2048'),
  names?: [ string ](name='names', description='The list of template names, including the template name and all its aliases.'),
  public?: boolean(name='public', description='Indicates whether the template is public to all teams.'),
  resourceGroupID?: string(name='resourceGroupID', description='The Alibaba Cloud resource group ID to which the team belongs.', example='rg-****'),
  statusReason?: string(name='statusReason', description='The desensitized description of the reason why the template build failed. This value is empty when the build succeeds.', example='Failed to pull the source image: invalid authentication credentials'),
  tags?: [
    E2BTemplateTag
  ](name='tags', description='The list of template labels. Each label points to a specific build.'),
  teamID?: string(name='teamID', description='The ID of the team to which the resource belongs, in UUID format.', example='5f4a2c18-****'),
  teamName?: string(name='teamName', description='The team name.', example='sandbox-dev'),
  teamPlan?: string(name='teamPlan', description='The team plan specification. Valid values:
- eco: economy.
- std: standard.
- pro: professional.
- ent: enterprise.', example='std'),
  templateID?: string(name='templateID', description='The sandbox template ID.', example='tm-8f3a2c7b5e14d806'),
  updatedAt?: string(name='updatedAt', description='The last update time in UTC, in RFC 3339 format.', example='2026-08-21T09:15:30Z'),
  userID?: string(name='userID', description='The user ID of the resource creator, in UUID format.', example='9c1d4e72-****'),
}

model E2BNetwork {
  allowOut?: [ string ](name='allowOut', description='The allowlist for outbound access from the sandbox. After configuration, the sandbox can access only the destinations in the list.'),
  allowPublicTraffic?: boolean(name='allowPublicTraffic', description='Specifies whether to allow Direct Internet Access to the sandbox.'),
  denyOut?: [ string ](name='denyOut', description='The denylist for outbound access from the sandbox. After configuration, the sandbox cannot access the destinations in the list.'),
  maskRequestHost?: string(name='maskRequestHost', description='The domain name used to rewrite the request Host header when accessing the sandbox. If this parameter is not specified, the original Host is retained.', example='sandbox.example.com'),
}

model E2BSandbox {
  accessEndpoint?: string(name='accessEndpoint', description='The access endpoint.', example='sbx-xxxx.ap-southeast-1.sandbox.aliyun.com'),
  allowInternetAccess?: boolean(name='allowInternetAccess', description='Specifies whether the sandbox is allowed to access the Internet.'),
  cpuCount?: int32(name='cpuCount', description='The vCPU specifications.', example='2'),
  diskSizeMB?: int32(name='diskSizeMB', description='The ephemeral disk specifications.', example='10240'),
  domain?: string(name='domain', description='The access domain name of the sandbox.', example='ap-southeast-1.sandbox.aliyun.com'),
  endAt?: string(name='endAt', description='The end time.', example='2026-09-04T02:03:43.826Z'),
  envVars?: map[string]string(name='envVars', description='The environment variables.', example='{"APP_MODE":"demo"}'),
  envdAccessToken?: string(name='envdAccessToken', description='The authentication credential for accessing the envd daemon process in the sandbox in UUID format. This credential is automatically generated only when secure is set to true.', example='4b1e9d07-****'),
  fcFunctionName?: string(name='fcFunctionName', description='The Function Compute function name.', example='template-d391c80b5d1527de'),
  fcInstanceID?: string(name='fcInstanceID', description='The Function Compute instance ID.', example='c-6a9d1501-133e6f48-b3f07782dd47'),
  fcSessionID?: string(name='fcSessionID', description='The Function Compute session ID of the sandbox in UUID format. This ID is used to locate the underlying session when pausing, resuming, or deleting the sandbox.', example='3a7ecd09-****'),
  generation?: int32(name='generation', description='The sandbox version.', example='2'),
  memoryMB?: int32(name='memoryMB', description='The memory specifications.', example='2'),
  metadata?: map[string]string(name='metadata', description='The metadata configuration.'),
  network?: E2BNetwork(name='network', description='The network configuration.'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-****'),
  resourceTags?: [ 
    {
      tagKey?: string(name='tagKey', description='The tag key.', example='project'),
      tagValue?: string(name='tagValue', description='The tag value.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  runtime?: InnerSandboxRuntimeConfig(name='runtime', description='The runtime configuration.'),
  sandboxID?: string(name='sandboxID', description='The unique identifier of the sandbox.', example='sbx-xxxx'),
  snapshotID?: string(name='snapshotID', description='The snapshot ID.', example='0d66****b374'),
  startedAt?: string(name='startedAt', description='The start time.', example='2026-09-04T02:02:43.826Z'),
  state?: string(name='state', description='The sandbox state. Valid values:
- running: The sandbox is running.
- pausing: The sandbox is being paused.
- paused: The sandbox is paused.
- resuming: The sandbox is being resumed.
- pause_fail: The pause operation failed.
- resume_fail: The resume operation failed.
- snapshotting: A snapshot is being created.
- snapshot_failed: Snapshot creation failed.
- terminated: The sandbox is terminated.', example='running'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='eea033af-****'),
  teamName?: string(name='teamName', description='The team name.', example='default'),
  teamPlan?: string(name='teamPlan', description='The QoS edition.', example='eco'),
  templateID?: string(name='templateID', description='The unique identifier of the template.', example='v9vjyzw64bsu83vw0dgs'),
  templateName?: string(name='templateName', description='The template name.', example='base'),
  userID?: string(name='userID', description='The UID of the creator.', example='2000****'),
  volumeMounts?: InnerSandboxVolumeMount(name='volumeMounts', description='The mount configuration.'),
}

model E2BSnapshot {
  cpuCount?: float(name='cpuCount', description='The CPU specifications of the snapshot.', example='2'),
  createdTime?: string(name='createdTime', description='The creation time of the snapshot.', example='1793685726000'),
  expiredTime?: string(name='expiredTime', description='The expiration time of the snapshot.', example='1796277726000'),
  memoryMB?: int32(name='memoryMB', description='The memory specifications of the snapshot.', example='4'),
  name?: string(name='name', description='The short name of the snapshot.', example='name'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-****'),
  resourceTags?: [ 
    {
      tagKey?: string(name='tagKey', description='The tag key.', example='project'),
      tagValue?: string(name='tagValue', description='The tag value.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  snapshotID?: string(name='snapshotID', description='The snapshot ID.', example='0d66****b374'),
  sourceSandboxID?: string(name='sourceSandboxID', description='The source sandbox ID.', example='sbx-****'),
  status?: string(name='status', description='The snapshot status.', example='Available'),
  tag?: string(name='tag', description='The snapshot tag.', example='tag'),
  teamID?: string(name='teamID', description='The team ID.', example='9A66****b892'),
  teamName?: string(name='teamName', description='The team name.', example='teamName'),
  userID?: string(name='userID', description='The Alibaba Cloud account ID.', example='155****'),
}

model E2BTeam {
  allowUpdateTeamName?: boolean(name='allowUpdateTeamName', description='Specifies whether the team name can be modified. The default team does not allow modification.'),
  createdTime?: string(name='createdTime', description='The creation time of the team in UTC, in RFC 3339 format.', example='2026-08-20T08:30:00Z'),
  description?: string(name='description', description='The team description.', example='Sandbox environment for the algorithm team'),
  plan?: string(name='plan', description='The team plan specification. Valid values:
- eco: economy.
- std: standard.
- pro: professional.
- ent: enterprise.', example='std'),
  readOnly?: boolean(name='readOnly', description='Indicates whether the current caller has read-only access to the team. If the value is true, the team configuration cannot be modified.'),
  resourceGroupID?: string(name='resourceGroupID', description='The ID of the Alibaba Cloud resource group to which the team belongs.', example='rg-****'),
  status?: string(name='status', description='The team status. Valid values:
- active: Normal.
- deleting: Being deleted.
- delete_failed: Failed to delete.', example='active'),
  teamID?: string(name='teamID', description='The ID of the team to which the resource belongs, in UUID format.', example='5f4a2c18-****'),
  teamName?: string(name='teamName', description='The team name.', example='sandbox-dev'),
  userID?: string(name='userID', description='The user ID of the team creator, in UUID format.', example='9c1d4e72-****'),
}

model E2BTemplate {
  buildStatus?: string(name='buildStatus', description='The template build status. Valid values:
- waiting: Waiting to build.
- building: Building in progress.
- ready: Build succeeded.
- error: Build failed.', example='ready'),
  category?: string(name='category', description='The template category. Valid values:
- builtin: Built-in system template.
- custom: User-created custom template.', example='custom'),
  containerConfiguration?: ContainerConfiguration(name='containerConfiguration', description='The container image configuration of the template.'),
  cpuCount?: int32(name='cpuCount', description='The CPU specification of the sandbox instance, in cores.', example='2'),
  createdAt?: string(name='createdAt', description='The creation time in UTC, in RFC 3339 format.', example='2026-08-20T08:30:00Z'),
  logConfiguration?: LogConfiguration(name='logConfiguration', description='The log delivery configuration of the template.'),
  memoryMB?: int32(name='memoryMB', description='The memory specification of the sandbox instance, in MB.', example='2048'),
  names?: [ string ](name='names', description='The list of template names, including the template name and all its aliases.'),
  networkConfiguration?: NetworkConfiguration(name='networkConfiguration', description='The network configuration of the template.'),
  public?: boolean(name='public', description='Indicates whether the template is public to all teams.'),
  resourceGroupID?: string(name='resourceGroupID', description='The Alibaba Cloud resource group ID to which the team belongs.', example='rg-****'),
  statusReason?: string(name='statusReason', description='The desensitized description of the reason why the template build failed. This value is empty when the build succeeds.', example='Failed to pull source image: invalid authentication credentials'),
  tags?: [
    E2BTemplateTag
  ](name='tags', description='The list of template tags. Each tag points to a specific build.'),
  teamID?: string(name='teamID', description='The ID of the team to which the resource belongs, in UUID format.', example='5f4a2c18-****'),
  teamName?: string(name='teamName', description='The team name.', example='sandbox-dev'),
  teamPlan?: string(name='teamPlan', description='The team plan specification. Valid values:
- eco: economy.
- std: standard.
- pro: professional.
- ent: enterprise.', example='std'),
  templateID?: string(name='templateID', description='The sandbox template ID.', example='tm-8f3a2c7b5e14d806'),
  updatedAt?: string(name='updatedAt', description='The last update time in UTC, in RFC 3339 format.', example='2026-08-21T09:15:30Z'),
  userID?: string(name='userID', description='The user ID of the resource creator, in UUID format.', example='9c1d4e72-****'),
}

model E2BTemplateBuild {
  buildID?: string(name='buildID'),
  cpuCount?: int32(name='cpuCount'),
  createdAt?: string(name='createdAt'),
  diskSizeMB?: int32(name='diskSizeMB'),
  envdVersion?: string(name='envdVersion'),
  finishedAt?: string(name='finishedAt'),
  memoryMB?: int32(name='memoryMB'),
  status?: string(name='status'),
  updatedAt?: string(name='updatedAt'),
}

model E2BTemplateTag {
  buildID?: string(name='buildID', description='The ID of the template build output that this label points to, in UUID format.', example='b7e21c05-****'),
  createdAt?: string(name='createdAt', description='The creation time of the label, in UTC and RFC 3339 format.', example='2026-08-20T08:35:12Z'),
  tag?: string(name='tag', description='The label name.', example='latest'),
}

model E2BVolume {
  agenticBucketVolumeConfig?: AgenticBucketVolumeConfig(name='agenticBucketVolumeConfig', description='The AgenticBucket volume configuration.'),
  agenticFSVolumeConfig?: AgenticFSVolumeConfig(name='agenticFSVolumeConfig', description='The AgenticFS volume configuration.'),
  createdAt?: string(name='createdAt', description='The time when the volume was created, in UTC. The time is in the yyyy-MM-ddTHH:mm:ss.SSSSSSZ format, with exactly 6 decimal places for fractional seconds (microsecond precision).', example='2026-09-07T02:12:36.531000Z'),
  juiceFSVolumeConfig?: JuiceFSVolumeConfig(name='juiceFSVolumeConfig', description='The JuiceFS volume configuration.'),
  mountConfig?: VolumeMountConfig(name='mountConfig', description='The mount configuration.'),
  ossVolumeConfig?: OSSVolumeConfig(name='ossVolumeConfig', description='The OSS volume configuration.'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-****'),
  status?: string(name='status', description='The volume status. Valid values:
- AVAILABLE', example='AVAILABLE'),
  statusReason?: string(name='statusReason', description='The status reason.', example='None'),
  storageClass?: string(name='storageClass', description='The storage type. Valid values:
- OSS
- AGENTIC_FS', example='OSS'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='9f5a1fe9-****'),
  updatedAt?: string(name='updatedAt', description='The time when the volume was last updated, in UTC. The time is in the yyyy-MM-ddTHH:mm:ss.SSSSSSZ format, with exactly 6 decimal places for fractional seconds (microsecond precision).', example='2026-09-07T03:48:05.274000Z'),
  userID?: string(name='userID', description='The UID of the creator.', example='2000****'),
  volumeID?: string(name='volumeID', description='The unique identifier of the volume.', example='25878d34-****'),
  volumeName?: string(name='volumeName', description='The name, which is unique within the team.', example='workspace'),
}

model E2BVolumeMount {
  name?: string(name='name'),
  path?: string(name='path'),
}

model IPConfig {
  description?: string(name='description', description='The description of the IP rule. The length cannot exceed 128 characters.', example='办公网出口地址'),
  ipAddress?: string(name='ipAddress', description='The IPv4 address or CIDR block. IPv6 is not supported.', example='203.0.113.25/32'),
}

model ImportApiKeyInput {
  apiKeyName?: string(name='apiKeyName', description='The API key name. The name can be up to 128 characters in length and can contain letters, digits, spaces, hyphens (-), underscores (_), and periods (.).', example='migrated-key'),
  apiKeyValue?: string(name='apiKeyValue', description='The plaintext value of the API key to import. After the import, the source of the key is set to custom.', example='e2b_****'),
  expireTime?: string(name='expireTime', description='The expiration time of the API key in UTC. The time is in RFC 3339 format. If this parameter is left empty, the API key never expires.', example='2099-12-31T23:59:59Z'),
  teamID?: string(name='teamID', description='The ID of the team to which the API key belongs, in UUID format. If this parameter is not specified, the default team of the current account is used.', example='5f4a2c18-****'),
}

model InnerCreateSandboxInput {
  allowInternetAccess?: boolean(name='allowInternetAccess', description='Specifies whether the sandbox is allowed to access external networks.', example='true'),
  autoPause?: boolean(name='autoPause', description='Specifies whether to automatically pause the sandbox after a timeout.', example='true'),
  autoResume?: boolean(name='autoResume', description='Specifies whether to automatically resume the sandbox.', example='true'),
  envVars?: map[string]string(name='envVars', description='The environment variable configuration.', example='{"APP_MODE":"demo"}'),
  metadata?: map[string]string(name='metadata', description='The metadata configuration.'),
  network?: E2BNetwork(name='network', description='The network configuration.'),
  resourceTags?: [ 
    {
      key?: string(name='key', description='The tag key.', example='project'),
      value?: string(name='value', description='The tag value.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  runtime?: InnerSandboxRuntimeConfig(name='runtime', description='The runtime configuration.'),
  secure?: boolean(name='secure', description='Specifies whether authentication is required to access the sandbox envd.', example='true'),
  snapshotID?: string(name='snapshotID', description='The snapshot ID.', example='0d66****b374'),
  snapshotName?: string(name='snapshotName', description='The snapshot name.', example='name'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='76eeecaa-****'),
  templateID?: string(name='templateID', description='The unique identifier of the template.', example='v9vjyzw64bsu83vw0dgs'),
  timeout?: int32(name='timeout', description='The timeout period in seconds.', example='180'),
  volumeMounts?: InnerCreateSandboxVolumeMounts(name='volumeMounts', description='The volume mount configuration.'),
}

model InnerCreateSandboxVolumeMounts {
  agenticFs?: {
    groupID?: int32(name='groupID', description='The group ID for the local mount.', example='1000'),
    mountPoints?: [ 
      {
        mountDir?: string(name='mountDir', description='The local mount directory.', example='/mnt/agenticfs'),
        serverAddr?: string(name='serverAddr', description='The AgenticFS access point address.', example='ap-xxxx.03204sl2qjiax4ocdt2-ljs60.cn-shanghai.nas.aliyuncs.com'),
      }
    ](name='mountPoints', description='The mount point configuration.'),
    userID?: int32(name='userID', description='The user ID for the local mount.', example='1000'),
  }(name='agenticFs', description='The AgenticFS mount configuration.'),
  named?: {
    mountPoints?: [ 
      {
        mountDir?: string(name='mountDir', description='The local mount directory.', example='/mnt/named'),
        volumeName?: string(name='volumeName', description='The volume name.', example='workspace'),
      }
    ](name='mountPoints', description='The mount point configuration.'),
  }(name='named', description='The predefined volume mount configuration.'),
  oss?: {
    mountPoints?: [ 
      {
        bucketName?: string(name='bucketName', description='The bucket name.', example='oss-bucket-test'),
        bucketPath?: string(name='bucketPath', description='The OSS bucket path to mount.', example='/'),
        endpoint?: string(name='endpoint', description='The endpoint URL of OSS.', example='https://oss-cn-shenzhen-internal.aliyuncs.com'),
        mountDir?: string(name='mountDir', description='The local mount directory.', example='/mnt/oss'),
        readOnly?: boolean(name='readOnly', description='Specifies whether the mount is read-only. Valid values:
- true: Read-only.
- false: Read and write.', example='false'),
      }
    ](name='mountPoints', description='The mount point configuration.'),
  }(name='oss', description='The OSS mount configuration.'),
}

model InnerSandboxRuntimeConfig {
  role?: string(name='role', description='The RAM role that grants the required permissions to the sandbox.', example='acs:ram::xxxx:role/xxx_role'),
  vpcConfig?: {
    securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-xxxx'),
    vSwitchIds?: [ string ](name='vSwitchIds', description='The vSwitch IDs.'),
    vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-xxxx'),
  }(name='vpcConfig', description='The VPC configuration.'),
}

model InnerSandboxVolumeMount {
  agenticFs?: {
    groupID?: int32(name='groupID', description='The local mount group ID.', example='1000'),
    mountPoints?: [ 
      {
        accessPointID?: string(name='accessPointID', description='The access point ID.', example='ap-xxxx'),
        agenticSpaceID?: string(name='agenticSpaceID', description='The AgenticSpace workspace ID.', example='agentic-xxxx'),
        fileSystemID?: string(name='fileSystemID', description='The file system ID.', example='03204sl2qjiax4oxxxx'),
        mountDir?: string(name='mountDir', description='The local mount directory.', example='/mnt/agenticfs'),
        serverAddr?: string(name='serverAddr', description='The access point mount address.', example='ap-xxxx.xxxx-ljs60.cn-shanghai.nas.aliyuncs.com'),
      }
    ](name='mountPoints', description='The AgenticFS mount point configuration.'),
    userID?: int32(name='userID', description='The local mount user ID.', example='1000'),
  }(name='agenticFs', description='The AgenticFS mount configuration.'),
  named?: {
    mountPoints?: [ 
      {
        mountDir?: string(name='mountDir', description='The local mount directory.', example='/mnt/named'),
        volumeName?: string(name='volumeName', description='The volume name.', example='workspace'),
      }
    ](name='mountPoints', description='The mount point configuration.'),
  }(name='named', description='The predefined volume mount configuration.'),
  oss?: {
    mountPoints?: [ 
      {
        bucketName?: string(name='bucketName', description='The bucket name.', example='oss-bucket-test'),
        bucketPath?: string(name='bucketPath', description='The OSS bucket path to mount.', example='/'),
        endpoint?: string(name='endpoint', description='The OSS endpoint address.', example='oss-cn-shenzhen-internal.aliyuncs.com'),
        mountDir?: string(name='mountDir', description='The local mount directory.', example='/mnt/oss'),
        readOnly?: boolean(name='readOnly', description='Specifies whether the mount is read-only. Valid values:

- **true**: Read-only.

- **false**: Not read-only.', example='true'),
      }
    ](name='mountPoints', description='The mount point configuration.'),
  }(name='oss', description='The OSS mount configuration.'),
}

model JuiceFSVolumeConfig {
  args?: [ string ](name='args', description='The additional mount parameters.'),
  baseURL?: string(name='baseURL', description='The access point address.', example='http://127.0.0.1:8080'),
  remoteDir?: string(name='remoteDir', description='The remote mount directory.', example='/sandbox/workspace'),
  token?: string(name='token', description='The access token.', example='xxxxxx'),
  volumeName?: string(name='volumeName', description='The JuiceFS volume name.', example='data'),
}

model LogConfiguration {
  logstore?: string(name='logstore', description='The name of the Simple Log Service Logstore that receives sandbox runtime logs.', example='sandbox-runtime'),
  project?: string(name='project', description='The name of the Simple Log Service project that receives sandbox runtime logs.', example='sandbox-log-cn-hangzhou'),
}

model MetricData {
  endTime?: string(name='endTime', description='The end time of the time series query, exclusive.', example='2026-11-05T00:02:00Z'),
  groupBy?: [ string ](name='groupBy', description='The grouping keys used for this query. An empty array is returned if no grouping is applied.

This parameter is required.', example='["teamID"]'),
  period?: int32(name='period', description='The data point interval used for this query, in seconds.

This parameter is required.', example='60'),
  results?: [ 
    {
      metricName?: string(name='metricName', description='The name of the metric in the request.

This parameter is required.', example='cpuUsedCores'),
      series?: [ 
        {
          dimensions?: map[string]string(name='dimensions', description='The team, template, or other grouping values for this series.

This parameter is required.', example='{"teamID":"70d1c834-0333-58d8-97ac-5336eb9179eb"}'),
          points?: [ 
            {
              timestamp?: string(name='timestamp', description='The time corresponding to the metric value, in UTC seconds.

This parameter is required.', example='2026-11-05T00:00:00Z'),
              value?: double(name='value', description='The metric value at this time. The unit is specified in unit.

This parameter is required.', example='0.25'),
            }
          ](name='points', description='The data points in chronological order. Only times with metric values are listed.

This parameter is required.', example='[{"timestamp":"2026-11-05T00:00:00Z","value":0.25},{"timestamp":"2026-11-05T00:01:00Z","value":0.5}]'),
        }
      ](name='series', description='The time series for the metric. An empty array is returned if no data points exist.

This parameter is required.', example='[{"dimensions":{"teamID":"70d1c834-0333-58d8-97ac-5336eb9179eb"},"points":[{"timestamp":"2026-11-05T00:00:00Z","value":0.25},{"timestamp":"2026-11-05T00:01:00Z","value":0.5}]}]'),
      unit?: string(name='unit', description='The unit of the metric value, such as Core for CPU cores.

This parameter is required.', example='Core'),
    }
  ](name='results', description='The result for each requested metric.

This parameter is required.', example='[{"metricName":"cpuUsedCores","unit":"Core","series":[{"dimensions":{"teamID":"70d1c834-0333-58d8-97ac-5336eb9179eb"},"points":[{"timestamp":"2026-11-05T00:00:00Z","value":0.25},{"timestamp":"2026-11-05T00:01:00Z","value":0.5}]}]}]'),
  startTime?: string(name='startTime', description='The start time of the time series query, inclusive.', example='2026-11-05T00:00:00Z'),
  time?: string(name='time', description='The time of the query. Returned only for single-point queries.', example='2026-11-05T00:01:00Z'),
}

model NetworkConfiguration {
  networkMode?: string(name='networkMode', description='The network access mode. Valid values: PUBLIC (public network only), PRIVATE (VPC only), PUBLIC_AND_PRIVATE (both public network and VPC are reachable).', example='PUBLIC_AND_PRIVATE'),
  securityGroupID?: string(name='securityGroupID', description='The ID of the security group used by the sandboxed container instances.', example='sg-****'),
  vpcID?: string(name='vpcID', description='The ID of the VPC to which the sandboxed container instances are connected.', example='vpc-****'),
  vswitchIDs?: [ string ](name='vswitchIDs', description='The list of vSwitch IDs to which the sandboxed container instances are connected. Configure vSwitches in multiple zones to improve availability.'),
}

model OSSVolumeConfig {
  bucketName?: string(name='bucketName', description='The name of the OSS bucket to mount as a storage volume.', example='sandbox-shared-data'),
  bucketPath?: string(name='bucketPath', description='The path prefix within the bucket to use as the mount source. If this parameter is not specified, the entire bucket is mounted.', example='/workspace/'),
  endpoint?: string(name='endpoint', description='The OSS service registration address used to access the bucket. Use an internal network address in the same region as the sandboxed container.', example='oss-cn-hangzhou-internal.aliyuncs.com'),
  readOnly?: boolean(name='readOnly', description='Specifies whether the storage volume is mounted as read-only in the sandboxed container.'),
}

model PublicListedSandbox {
  autoPause?: boolean(name='autoPause', example='true'),
  autoResume?: boolean(name='autoResume', example='true'),
  cpu?: float(name='cpu', example='2'),
  diskSize?: int32(name='diskSize', example='2048'),
  endAt?: string(name='endAt', example='2026-10-30T03:09:21.313Z'),
  memorySize?: int32(name='memorySize', example='10240'),
  resourceGroupID?: string(name='resourceGroupID', example='rg-acfmwxqyrgwabcd'),
  resourceTags?: [ 
    {
      tagKey?: string(name='tagKey', example='project'),
      tagValue?: string(name='tagValue', example='demo'),
    }
  ](name='resourceTags'),
  sandboxID?: string(name='sandboxID', example='sbx-4a4356a4-b731-42c1-ba8e-650f725be098'),
  startedAt?: string(name='startedAt', example='2026-10-30T02:09:21.313Z'),
  state?: string(name='state', example='running'),
  teamID?: string(name='teamID', example='13b721e6-8cc8-5df2-af13-80316f7508af'),
  teamName?: string(name='teamName', example='my-team'),
  templateID?: string(name='templateID', example='us7dxqaezw5uu7aa2cm5'),
  templateName?: string(name='templateName', example='my-base-template'),
  userID?: string(name='userID', example='123456789'),
}

model PublicTemplate {
  createdTime?: string(name='createdTime', description='The time when the template was created, in UTC and RFC 3339 format.', example='2026-08-20T08:30:00Z'),
  name?: string(name='name', description='The template name, which is unique within a team.', example='python-data-analysis'),
  resourceGroupID?: string(name='resourceGroupID', description='The ID of the Alibaba Cloud resource group to which the team belongs.', example='rg-****'),
  resourceTags?: [ 
    {
      tagKey?: string(name='tagKey', description='The tag key.', example='project'),
      tagValue?: string(name='tagValue', description='The tag value.', example='demo'),
    }
  ](name='resourceTags', description='The resource tags.'),
  runtimeConfig?: PublicTemplateRuntimeConfig(name='runtimeConfig', description='The runtime configuration of the template, which determines the specifications and environment of sandbox instances created from this template.'),
  status?: PublicTemplateStatus(name='status', description='The current status of the template.'),
  teamID?: string(name='teamID', description='The ID of the team to which the resource belongs, in UUID format.', example='5f4a2c18-****'),
  teamName?: string(name='teamName', description='The team name.', example='sandbox-dev'),
  templateID?: string(name='templateID', description='The sandbox template ID.', example='tm-8f3a2c7b5e14d806'),
  templateType?: string(name='templateType', description='The templatetype. An empty value indicates a runtime template.', example='layer'),
}

model PublicTemplateCache {
  createdTime?: string(name='createdTime', description='The creation time in UTC.', example='2026-09-18T10:00:00Z'),
  imageDigest?: string(name='imageDigest', description='The digest of the cached image.', example='sha256:8f3c2a1b'),
  imageSizeMB?: int32(name='imageSizeMB', description='The size of the cached image, in MB.', example='512'),
  progress?: int32(name='progress', description='The prefetch progress percentage.', example='80'),
  readyTime?: string(name='readyTime', description='The ready time in UTC.', example='2026-09-18T10:05:00Z'),
  status?: string(name='status', description='The cache status. Valid values: InProgress, Success, Failed, Deleting, and Evicted.', example='Success'),
  statusReason?: string(name='statusReason', description='The reason for the status. This parameter is backfilled when the status is not Success.', example='The image prefetch task is queued'),
  teamID?: string(name='teamID', description='The team ID.', example='13b721e6-8cc8-5df2-af13-80316f7508af'),
  templateID?: string(name='templateID', description='The unique identifier of the template.', example='us7dxqaezw5uu7aa2cm5'),
}

model PublicTemplateLogConfig {
  logstore?: string(name='logstore', description='The name of the Simple Log Service Logstore that receives sandbox runtime logs.', example='sandbox-runtime'),
  project?: string(name='project', description='The name of the Simple Log Service project that receives sandbox runtime logs.', example='sandbox-log-cn-hangzhou'),
}

model PublicTemplateRegistryConfig {
  networkConfig?: PublicTemplateRegistryNetworkConfig(name='networkConfig', description='The VPC configuration used to access the image repository.'),
}

model PublicTemplateRegistryNetworkConfig {
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group used to access the image repository.', example='sg-****'),
  vSwitchId?: string(name='vSwitchId', description='The ID of the vSwitch used to access the image repository.', example='vsw-****'),
  vpcId?: string(name='vpcId', description='The ID of the VPC used to access the image repository.', example='vpc-****'),
}

model PublicTemplateRuntimeConfig {
  cpu?: float(name='cpu', description='The CPU specifications of the sandbox instance, in cores.', example='2'),
  diskSize?: int32(name='diskSize', description='The disk specifications of the sandbox instance, in MB.', example='10240'),
  internetAccess?: boolean(name='internetAccess', description='Specifies whether the sandbox instance is allowed to access the Internet.'),
  logConfig?: PublicTemplateLogConfig(name='logConfig', description='The log delivery configuration of the sandbox instance.'),
  memorySize?: int32(name='memorySize', description='The memory specifications of the sandbox instance, in MB.', example='2048'),
  sandboxConfig?: PublicTemplateSandboxConfig(name='sandboxConfig', description='The image and startup configuration of the sandbox instance.'),
  vpcBindings?: [ string ](name='vpcBindings', description='The collection of inbound source VPCs allowed by the current template configuration. Omitting this field or providing an empty array indicates that no inbound VPC bindings are configured. This configuration is independent of the egress network vpcConfig. Subsequent template updates do not change the inbound VPC bindings of existing sandbox instances.', example='["vpc-examplea","vpc-exampleb"]'),
  vpcConfig?: PublicTemplateVPCConfig(name='vpcConfig', description='The VPC configuration of the sandbox instance.'),
}

model PublicTemplateSandboxConfig {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the Container Registry Enterprise instance. This parameter is required when registryType is set to acree.', example='cri-****'),
  generation?: int32(name='generation', description='The sandbox generation. Valid values: 1 (first generation) and 2 (second generation). Default value: 1.', example='1'),
  image?: string(name='image', description='The address of the sandbox base image.', example='registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12'),
  osType?: string(name='osType', description='The operating system type of the second-generation sandbox. Valid values: linux-amd64, android-36-osworld, and windows-osworld.', example='linux-amd64'),
  readyCommand?: string(name='readyCommand', description='The readiness probe command for the sandbox. A successful execution indicates that the sandbox is ready to receive requests. This parameter is supported only by first-generation sandboxes.', example='curl -sf http://127.0.0.1:49983/health'),
  registryConfig?: PublicTemplateRegistryConfig(name='registryConfig', description='The configuration used to access the image repository. For security reasons, only the network configuration is returned in query responses, and logon credentials are not returned.'),
  startCommand?: string(name='startCommand', description='The startup command for the sandbox container. This parameter is supported only by first-generation sandboxes.', example='/usr/local/bin/start.sh'),
  steps?: [
    PublicTemplateStep
  ](name='steps', description='The list of custom build steps.'),
}

model PublicTemplateStatus {
  finishedAt?: string(name='finishedAt', description='The time when the template reached the current desired state, in UTC and RFC 3339 format. This parameter is empty when the template is still being built or updated.', example='2026-08-20T08:35:12Z'),
  reason?: PublicTemplateStatusReason(name='reason', description='The reason why the template entered a failure state. This parameter is returned only when state is error or updateFailed.'),
  state?: string(name='state', description='The template status. Valid values:
- building: The template is being built.
- ready: The template is active.
- updating: The template is being updated.
- updateFailed: The template failed to be updated.
- error: The template failed to be built.', example='ready'),
}

model PublicTemplateStatusReason {
  message?: string(name='message', description='The details of the failure reason.', example='Failed to pull the source image: invalid authentication information'),
  step?: string(name='step', description='The identity of the failed step.', example='build-context'),
}

model PublicTemplateStep {
  args?: [ string ](name='args', description='The build instruction parameters. The meaning varies depending on the type: for USER, it is [username, optional passwordless sudo flag], where the second item configures passwordless sudo when the string is true; for WORKDIR, it is [directory]; for ENV, it is [key, value, ...], allowing multiple pairs to be set at once; for RUN, it is [command, optional temporary user].'),
  type?: string(name='type', description='The build instruction type. Valid values: USER, WORKDIR, ENV, and RUN. The instructions are executed sequentially in the order of the array.', example='RUN'),
}

model PublicTemplateVPCConfig {
  role?: string(name='role', description='The ARN of the RAM role assumed by the sandbox instance when accessing the VPC. The format is acs:ram::{account ID}:role/{role name}.', example='acs:ram::1234567890123456:role/aliyunfcdefaultrole'),
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group used by the sandbox instance.', example='sg-****'),
  vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitch IDs to which the sandbox instance is connected.'),
  vpcId?: string(name='vpcId', description='The ID of the VPC to which the sandbox instance is connected.', example='vpc-****'),
}

model PublicUpdateTemplateBuildConfig {
  copy?: PublicUpdateTemplateCopyAction(name='copy', description='The image replication action configuration.'),
  envdInject?: PublicUpdateTemplateEnvdInjectAction(name='envdInject', description='The envd injection action configuration.'),
  installStorageClients?: boolean(name='installStorageClients', description='Installs the clients required for storage mounting.'),
}

model PublicUpdateTemplateCopyAction {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the destination ACR Enterprise instance.', example='cri-abc123'),
  enabled?: boolean(name='enabled', description='Specifies whether image replication is enabled.'),
  image?: string(name='image', description='The destination image address for replication.', example='registry.cn-hangzhou.aliyuncs.com/my/ns:v2'),
  registryConfig?: PublicUpdateTemplateRegistryConfig(name='registryConfig', description='The image repository configuration.'),
  registryType?: string(name='registryType', description='The destination repository type.', example='acr'),
}

model PublicUpdateTemplateEnvdInjectAction {
  enabled?: boolean(name='enabled', description='Specifies whether envd injection is enabled.'),
}

model PublicUpdateTemplateInput {
  buildConfig?: PublicUpdateTemplateBuildConfig(name='buildConfig', description='The build configuration.'),
