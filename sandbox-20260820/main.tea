  currentError?: string(name='currentError', description='The masked text of the current background error. This value is null if no error occurs.', example='SourceNotFound: source template does not exist'),
  deleting?: boolean(name='deleting', description='Indicates whether the warm pool is being deleted.'),
  preparing?: long(name='preparing', description='The number of sandboxes that are currently being prepared.', example='0'),
  ready?: long(name='ready', description='The number of sandboxes that are currently ready.', example='0'),
  releasing?: long(name='releasing', description='The number of sandboxes that are currently being released.', example='0'),
  sourceUnavailable?: boolean(name='sourceUnavailable', description='Indicates whether the source of the associated template is unavailable.'),
  targetCapacity?: long(name='targetCapacity', description='The current target capacity.', example='0'),
  teamID?: string(name='teamID', description='The team ID.', example='team-example1234567890'),
