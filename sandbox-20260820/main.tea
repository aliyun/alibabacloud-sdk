}

model Quota {
  cpuCores?: int32(name='cpuCores', description='The vCPU quota. Unit: cores.', example='100'),
  instanceCount?: int32(name='instanceCount', description='The quota for the number of running instances.', example='100'),
  memoryGB?: int32(name='memoryGB', description='The memory quota. Unit: GB.', example='200'),
