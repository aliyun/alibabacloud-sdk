}

model QuotaUsage {
  cpuCores?: double(name='cpuCores', description='The consumed CPU quota in vCPUs, not the CPU utilization.', example='1'),
  instanceCount?: long(name='instanceCount', description='The number of unreleased instance authorizations.', example='1'),
  memoryGB?: double(name='memoryGB', description='The consumed memory quota in GB, not the actual memory used by processes.', example='1.5'),
}

model ResourceUsage {
  endTime?: string(name='endTime', description='The end time of the requested interval, exclusive.

This parameter is required.', example='2026-11-05T02:00:00Z'),
  granularity?: string(name='granularity', description='The aggregation granularity used for this query. Valid values: All, Hour, and Day.

This parameter is required.', example='Hour'),
  groupBy?: [ string ](name='groupBy', description='The grouping key used for this query. An empty array is returned when no grouping is applied.

This parameter is required.', example='["teamID"]'),
  groups?: [ 
    {
      dimensions?: map[string]string(name='dimensions', description='The team, template, or sandbox version corresponding to the usage of this group.

This parameter is required.', example='{"teamID":"70d1c834-0333-58d8-97ac-5336eb9179eb"}'),
      items?: [ 
        {
          buckets?: [ 
            {
              endTime?: string(name='endTime', description='The end time of this usage statistics period, exclusive.

This parameter is required.', example='2026-11-05T01:00:00Z'),
              quantity?: double(name='quantity', description='The cumulative usage within this time period. The unit is specified by unit.

This parameter is required.', example='3600'),
              startTime?: string(name='startTime', description='The start time of this usage statistics period, inclusive.

This parameter is required.', example='2026-11-05T00:00:00Z'),
            }
          ](name='buckets', description='The hourly or daily usage arranged in chronological order. Only time periods with records are returned. This field is omitted when granularity is set to All.', example='[{"startTime":"2026-11-05T00:00:00Z","endTime":"2026-11-05T01:00:00Z","quantity":3600},{"startTime":"2026-11-05T01:00:00Z","endTime":"2026-11-05T02:00:00Z","quantity":1800}]'),
          total?: double(name='total', description='The cumulative usage of this usage item over the entire query interval. This field is omitted if there are no usage records for the item within the interval.', example='5400'),
          unit?: string(name='unit', description='The unit of usage. The unit is CoreSecond for CPU, and GiBSecond for memory and cloud disks.

This parameter is required.', example='CoreSecond'),
          usageName?: string(name='usageName', description='The name of the usage item specified in the request.

This parameter is required.', example='cpuActive'),
        }
      ](name='items', description='The query result for each requested usage item in this group.

This parameter is required.', example='[{"usageName":"cpuActive","unit":"CoreSecond","total":5400,"buckets":[{"startTime":"2026-11-05T00:00:00Z","endTime":"2026-11-05T01:00:00Z","quantity":3600},{"startTime":"2026-11-05T01:00:00Z","endTime":"2026-11-05T02:00:00Z","quantity":1800}]}]'),
    }
  ](name='groups', description='The usage for each group. If no grouping is applied, the usage for the entire query range is returned. An empty array is returned if there are no usage records within the query range.

This parameter is required.', example='[{"dimensions":{"teamID":"70d1c834-0333-58d8-97ac-5336eb9179eb"},"items":[{"usageName":"cpuActive","unit":"CoreSecond","total":5400,"buckets":[{"startTime":"2026-11-05T00:00:00Z","endTime":"2026-11-05T01:00:00Z","quantity":3600},{"startTime":"2026-11-05T01:00:00Z","endTime":"2026-11-05T02:00:00Z","quantity":1800}]}]}]'),
  startTime?: string(name='startTime', description='The start time of the requested interval, inclusive.

This parameter is required.', example='2026-11-05T00:00:00Z'),
}

model SandboxLifecycleEvent {
  action?: string(name='action', description='The action that triggered the event.', example='delete'),
  buildID?: string(name='buildID', description='The template build ID. This field is not returned if there is no associated build.', example='bld-example-001'),
  description?: string(name='description', description='The event description.', example='Sandbox deleted'),
  eventData?: map[string]any(name='eventData', description='The event data as a JSON object. The specific fields vary depending on the event type.'),
  eventID?: string(name='eventID', description='The event ID.', example='df3c6750-2c5e-50d1-8b81-7a2248f6ca3b'),
  eventType?: string(name='eventType', description='The event type.', example='terminated'),
  level?: string(name='level', description='The event category. Valid values: INFO and WARNING.', example='INFO'),
  occurredAt?: string(name='occurredAt', description='The time when the event occurred. The time is in UTC RFC3339 format and supports fractional seconds.', example='2026-10-08T06:18:38.123Z'),
  reason?: string(name='reason', description='The reason for the event. This field is not returned if there is no reason.', example='request'),
  sandboxID?: string(name='sandboxID', description='The instance ID.', example='sbx-62105527-699e-48df-ad3b-7425001ae4f2'),
  teamID?: string(name='teamID', description='The ID of the team to which the event belongs.', example='70d1c834-0333-58d8-97ac-5336eb9179eb'),
  templateID?: string(name='templateID', description='The template ID.', example='4hrtmghh2nzrsdh6yr65'),
}

model TLSConfig {
  cipherSuites?: [ string ](name='cipherSuites', description='The list of allowed TLS cipher suites. If this parameter is not specified, the server default cipher suites are used.'),
  maxVersion?: string(name='maxVersion', description='The maximum TLS protocol version allowed. Example values: TLSv1.2 and TLSv1.3. If this parameter is not specified, the server default value is used. Do not pass an empty string.', example='TLSv1.3'),
  minVersion?: string(name='minVersion', description='The minimum TLS protocol version allowed. Example values: TLSv1.2 and TLSv1.3. If this parameter is not specified, the server default value is used. Do not pass an empty string.', example='TLSv1.2'),
}

model UpdateApiKeyInput {
  apiKeyName?: string(name='apiKeyName', description='The new name of the API key. The name can be up to 128 characters in length and can contain only letters, digits, spaces, hyphens (-), underscores (_), and periods (.).', example='ci-pipeline-key-v2'),
  expireTime?: string(name='expireTime', description='The expiration time of the API key in UTC. The time must be in RFC 3339 format. An empty value indicates that the API key never expires.', example='2099-12-31T23:59:59Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist', description='The IP address blacklist. If you specify this parameter, the existing blacklist is completely overwritten. This parameter is mutually exclusive with ipWhitelist.', example='[{"ipAddress":"192.0.2.1","description":"example client"}]'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist', description='The IP address whitelist. If you specify this parameter, the existing whitelist is completely overwritten. This parameter is mutually exclusive with ipBlacklist.', example='[{"ipAddress":"192.0.2.1","description":"example client"}]'),
  status?: string(name='status', description='The new status of the API key. Valid values:
- active: Enabled.
- inactive: Disabled.', example='inactive'),
  vpcBindings?: [ string ](name='vpcBindings', description='The set of allowed source VPC IDs. This set is updated independently of the IP blacklists and whitelists. If you omit this parameter or set it to null, the original set is retained. A non-empty array completely replaces the original set. An explicit empty array [] purges the VPC restrictions. Updating only this parameter does not affect the IP address lists, and updating the IP address lists does not affect the VPC restrictions. An empty request body {} purges all IP address and VPC source restrictions. You can update this parameter along with other parameters such as the name.', example='["vpc-examplea","vpc-exampleb"]'),
}

model UpdateCustomDomainInput {
