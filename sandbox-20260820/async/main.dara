  generation?: int32(name='generation', example='2'),
  memoryMB?: int32(name='memoryMB', example='2'),
  metadata?: map[string]string(name='metadata'),
  resourceGroupID?: string(name='resourceGroupID', example='rg-****'),
  sandboxID?: string(name='sandboxID', example='sbx-xxxx'),
  startedAt?: string(name='startedAt', example='2026-09-03T02:05:37.932Z'),
  state?: string(name='state', example='running'),
  teamID?: string(name='teamID', example='9f5a1fe9-****'),
  teamName?: string(name='teamName', example='default'),
  teamPlan?: string(name='teamPlan', example='eco'),
