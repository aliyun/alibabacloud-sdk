  maxVersion?: string(name='maxVersion', description='The maximum TLS protocol version allowed. Example values: TLSv1.2 and TLSv1.3. If this parameter is not specified, the server default value is used. Do not pass an empty string.', example='TLSv1.3'),
  minVersion?: string(name='minVersion', description='The minimum TLS protocol version allowed. Example values: TLSv1.2 and TLSv1.3. If this parameter is not specified, the server default value is used. Do not pass an empty string.', example='TLSv1.2'),
}

model UpdateApiKeyInput {
  apiKeyName?: string(name='apiKeyName', description='The new name of the API key. The name can be up to 128 characters in length and can contain letters, digits, spaces, hyphens (-), underscores (_), and periods (.).', example='ci-pipeline-key-v2'),
  expireTime?: string(name='expireTime', description='The expiration time of the API key, in UTC, in RFC 3339 format. Leave this parameter empty to indicate that the API key never expires.', example='2099-12-31T23:59:59Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist', description='The IP blacklist. If specified, the existing blacklist is entirely overwritten. This parameter is mutually exclusive with ipWhitelist.'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist', description='The IP whitelist. If specified, the existing whitelist is entirely overwritten. This parameter is mutually exclusive with ipBlacklist.'),
  status?: string(name='status', description='The new status of the API key. Valid values:
- active: Enabled.
- inactive: Disabled.', example='inactive'),
}

model UpdateCustomDomainInput {
  certConfig?: CertConfig(name='certConfig', description='The new HTTPS certificate configuration for the domain name. When specified, this overwrites the existing configuration.'),
  description?: string(name='description', description='The new description of the custom domain name.', example='Entry domain name for the sandbox production environment'),
  tlsConfig?: TLSConfig(name='tlsConfig', description='The new TLS protocol configuration for the domain name. When specified, this overwrites the existing configuration.'),
}

model UpdateTeamInput {
  description?: string(name='description', description='The new description of the team.', example='Production sandbox environment for the algorithm team'),
  plan?: string(name='plan', description='The new plan specification of the team. Valid values: eco (economy), std (standard), pro (professional), ent (enterprise).', example='pro'),
  resourceGroupID?: string(name='resourceGroupID', description='The ID of the new Alibaba Cloud resource group to which the team belongs.', example='rg-****'),
  teamName?: string(name='teamName', description='The new name of the team. The name can be modified only when allowUpdateTeamName of the team is set to true.', example='sandbox-prod'),
}

model UpdateTemplateInput {
  containerConfiguration?: ContainerConfiguration(name='containerConfiguration', description='The new container image configuration of the template. When passed in, this overwrites the existing configuration entirely.'),
  logConfiguration?: LogConfiguration(name='logConfiguration', description='The new log delivery configuration of the template. When passed in, this overwrites the existing configuration entirely.'),
  networkConfiguration?: NetworkConfiguration(name='networkConfiguration', description='The new network configuration of the template. When passed in, this overwrites the existing configuration entirely.'),
  teamID?: string(name='teamID', description='The ID of the team to which the template belongs, in UUID format. This parameter is used to locate the template to be updated.', example='5f4a2c18-****'),
}

