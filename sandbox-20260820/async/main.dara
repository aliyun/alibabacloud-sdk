}

model E2BNetwork {
  allowOut?: [ string ](name='allowOut'),
  allowPublicTraffic?: boolean(name='allowPublicTraffic'),
  denyOut?: [ string ](name='denyOut'),
  maskRequestHost?: string(name='maskRequestHost', example='sandbox.example.com'),
}

