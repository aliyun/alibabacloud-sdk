  status?: string(name='status', description='The team status. Valid values:
- active: Normal.
- deleting: Being deleted.
- delete_failed: Failed to delete.', example='active'),
  teamID?: string(name='teamID', description='The ID of the team to which the resource belongs, in UUID format.', example='5f4a2c18-****'),
  teamName?: string(name='teamName', description='The team name.', example='sandbox-dev'),
  userID?: string(name='userID', description='The user ID of the team creator, in UUID format.', example='9c1d4e72-****'),
}

