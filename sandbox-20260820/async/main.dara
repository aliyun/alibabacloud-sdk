  logConfiguration?: LogConfiguration(name='logConfiguration'),
  memoryMB?: int32(name='memoryMB', example='2048'),
  names?: [ string ](name='names'),
  public?: boolean(name='public'),
  resourceGroupID?: string(name='resourceGroupID', example='rg-****'),
  statusReason?: string(name='statusReason', example='拉取源镜像失败：认证信息无效'),
  tags?: [
    E2BTemplateTag
  ](name='tags'),
  teamID?: string(name='teamID', example='5f4a2c18-****'),
  teamName?: string(name='teamName', example='sandbox-dev'),
  teamPlan?: string(name='teamPlan', example='std'),
  templateID?: string(name='templateID', example='tm-8f3a2c7b5e14d806'),
  updatedAt?: string(name='updatedAt', example='2026-08-21T09:15:30Z'),
