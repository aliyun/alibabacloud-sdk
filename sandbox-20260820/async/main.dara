}

model InnerCreateSandboxInput {
  allowInternetAccess?: boolean(name='allowInternetAccess', example='true'),
  autoPause?: boolean(name='autoPause', example='true'),
  autoResume?: boolean(name='autoResume', example='true'),
  envVars?: map[string]string(name='envVars'),
  metadata?: map[string]string(name='metadata'),
  network?: E2BNetwork(name='network'),
  runtime?: InnerSandboxRuntimeConfig(name='runtime'),
  secure?: boolean(name='secure', example='true'),
  teamID?: string(name='teamID', example='76eeecaa-****'),
  templateID?: string(name='templateID', example='v9vjyzw64bsu83vw0dgs'),
  timeout?: int32(name='timeout', example='180'),
  volumeMounts?: InnerCreateSandboxVolumeMounts(name='volumeMounts'),
}

model InnerCreateSandboxVolumeMounts {
  agenticFs?: {
    groupID?: int32(name='groupID', example='1000'),
    mountPoints?: [ 
      {
        mountDir?: string(name='mountDir', example='/mnt/agenticfs'),
        serverAddr?: string(name='serverAddr', example='ap-xxxx.03204sl2qjiax4ocdt2-ljs60.cn-shanghai.nas.aliyuncs.com'),
      }
    ](name='mountPoints'),
    userID?: int32(name='userID', example='1000'),
  }(name='agenticFs'),
  named?: {
    mountPoints?: [ 
      {
        mountDir?: string(name='mountDir', example='/mnt/named'),
        volumeName?: string(name='volumeName', example='workspace'),
      }
    ](name='mountPoints'),
  }(name='named'),
  oss?: {
    mountPoints?: [ 
      {
        bucketName?: string(name='bucketName', example='oss-bucket-test'),
        bucketPath?: string(name='bucketPath', example='/'),
        endpoint?: string(name='endpoint', example='https://oss-cn-shenzhen-internal.aliyuncs.com'),
        mountDir?: string(name='mountDir', example='/mnt/oss'),
        readOnly?: boolean(name='readOnly', example='false'),
      }
    ](name='mountPoints'),
  }(name='oss'),
}

model InnerSandboxRuntimeConfig {
  role?: string(name='role', description='The RAM role that grants the required permissions to the sandbox.', example='acs:ram::xxxx:role/xxx_role'),
  vpcConfig?: {
    securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-xxxx'),
    vSwitchIds?: [ string ](name='vSwitchIds', description='The vSwitch IDs.'),
    vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-xxxx'),
  }(name='vpcConfig', description='The VPC configuration.'),
}

model InnerSandboxVolumeMount {
  agenticFs?: {
    groupID?: int32(name='groupID', example='1000'),
    mountPoints?: [ 
      {
        accessPointID?: string(name='accessPointID', example='ap-xxxx'),
        agenticSpaceID?: string(name='agenticSpaceID', example='agentic-xxxx'),
        fileSystemID?: string(name='fileSystemID', example='03204sl2qjiax4oxxxx'),
        mountDir?: string(name='mountDir', example='/mnt/agenticfs'),
        serverAddr?: string(name='serverAddr', example='ap-xxxx.xxxx-ljs60.cn-shanghai.nas.aliyuncs.com'),
      }
    ](name='mountPoints'),
    userID?: int32(name='userID', example='1000'),
  }(name='agenticFs'),
  named?: {
    mountPoints?: [ 
      {
        mountDir?: string(name='mountDir', example='/mnt/named'),
        volumeName?: string(name='volumeName', example='workspace'),
      }
    ](name='mountPoints'),
  }(name='named'),
  oss?: {
    mountPoints?: [ 
      {
        bucketName?: string(name='bucketName', example='oss-bucket-test'),
        bucketPath?: string(name='bucketPath', example='/'),
        endpoint?: string(name='endpoint', example='oss-cn-shenzhen-internal.aliyuncs.com'),
        mountDir?: string(name='mountDir', example='/mnt/oss'),
        readOnly?: boolean(name='readOnly', example='true'),
      }
    ](name='mountPoints'),
  }(name='oss'),
}

model JuiceFSVolumeConfig {
  args?: [ string ](name='args'),
  baseURL?: string(name='baseURL', example='http://127.0.0.1:8080'),
  remoteDir?: string(name='remoteDir', example='/sandbox/workspace'),
  token?: string(name='token', example='xxxxxx'),
  volumeName?: string(name='volumeName', example='data'),
}

model LogConfiguration {
  logstore?: string(name='logstore', description='The name of the Simple Log Service Logstore that receives sandbox runtime logs.', example='sandbox-runtime'),
  project?: string(name='project', description='The name of the Simple Log Service project that receives sandbox runtime logs.', example='sandbox-log-cn-hangzhou'),
}

model NetworkConfiguration {
  networkMode?: string(name='networkMode', example='PUBLIC_AND_PRIVATE'),
  securityGroupID?: string(name='securityGroupID', example='sg-****'),
  vpcID?: string(name='vpcID', example='vpc-****'),
  vswitchIDs?: [ string ](name='vswitchIDs'),
}

model OSSVolumeConfig {
  bucketName?: string(name='bucketName', example='sandbox-shared-data'),
  bucketPath?: string(name='bucketPath', example='/workspace/'),
  endpoint?: string(name='endpoint', example='oss-cn-hangzhou-internal.aliyuncs.com'),
  readOnly?: boolean(name='readOnly'),
}

model PublicTemplate {
  createdTime?: string(name='createdTime', example='2026-08-20T08:30:00Z'),
  name?: string(name='name', example='python-data-analysis'),
