model CreateSchedulerRuleRequest {
  param?: string(name='Param', description='The details of the CDN interaction rule. This parameter is a JSON format character string. The following list describes the structure:
- **ParamType**: Required. String type. The type of CDN interaction. Valid values: **cdn**, which indicates CDN interaction.
