/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'IQS';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('iqs', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AISearchQuery {
  card?: string(name='card'),
  cardQuery?: string(name='cardQuery'),
  page?: int32(name='page'),
  query?: string(name='query'),
  searchEngine?: string(name='searchEngine'),
  searchPlan?: string(name='searchPlan'),
  sessionId?: string(name='sessionId'),
  timeRange?: string(name='timeRange'),
}

model AgentBaseQuery {
  query?: string(name='query', description='The natural language question used to retrieve nearby locations.', example='Luxury hotels within 5 km of Lingyin Temple in Hangzhou'),
}

model CommonAgentQuery {
  limit?: int32(name='limit', description='The maximum number of place results to return. Default value: 10.', example='10'),
  query?: string(name='query', description='The natural language question used to retrieve nearby places.', example='High-end hotels within 5 km of Lingyin Temple in Hangzhou'),
  querySceneEnumCode?: string(name='querySceneEnumCode', description='The search scenario code. Valid values: hotels (hotel), attractions (attraction), restaurants (restaurant), and entertainment (leisure and entertainment). If you do not specify this parameter, the model identifies the scenario.', example='hotels'),
  searchModel?: string(name='searchModel', description='The search result mode. Valid values: single (returns simplified fields) and normal (returns all fields). Default value: normal.', example='normal'),
}

model GenericSearchResult {
  pageItems?: [
    ScorePageItem
  ](name='pageItems', description='The web content list.'),
  queryContext?: QueryContext(name='queryContext', description='The query context information.'),
  requestId?: string(name='requestId', description='requestId', example='123456'),
  sceneItems?: [
    SceneItem
  ](name='sceneItems', description='The list of scenario-specific query results, such as structured results for time and weather.'),
  searchInformation?: SearchInformation(name='searchInformation', description='The search information.'),
  weiboItems?: [
    WeiboItem
  ](name='weiboItems', description='The Weibo list.'),
}

model GetIqsUsageResult {
  records?: [ 
    {
      api?: string(name='api', description='The API name.', example='UnifiedSearch'),
      billingQps?: int32(name='billingQps', description='The queries per second (QPS) for tiered billing.', example='30'),
      date?: string(name='date', description='The metering date in the YYYYMMDD format.', example='20250716'),
      engineType?: string(name='engineType', description='The search engine type.', example='Generic'),
      failedCalls?: int32(name='failedCalls', description='The number of failed calls.', example='0'),
      ladderType?: string(name='ladderType', description='The matched metering tier. Valid values: 1001, 1002, 1003, and 1004.', example='1001'),
      mainAccountId?: string(name='mainAccountId', description='The ID of the Alibaba Cloud account.', example='138608930******0'),
      subAccountId?: string(name='subAccountId', description='The sub-account that initiates the call (RAM user or API key identifier).', example='2193843763***9272'),
      successCalls?: int32(name='successCalls', description='The number of successful calls.', example='5'),
      totalBillStatCalls?: int32(name='totalBillStatCalls', description='The total number of calls.', example='5'),
      totalCalls?: int32(name='totalCalls', description='The total number of calls.', example='5'),
      valueAddedAdvanced?: int32(name='valueAddedAdvanced', description='The value-added package usage for calling enhanced APIs.', example='5'),
      valueAddedSummary?: int32(name='valueAddedSummary', description='The number of value-added package calls used for the summarization feature.', example='5'),
    }
  ](name='records', description='The daily call volume records.'),
}

model GlobalPageItem {
  link?: string(name='link', description='The full URL that the search result points to.

This parameter is required.', example='https://baijiahao.baidu.com/s?id=1787881554557805096'),
  snippet?: string(name='snippet', description='The truncated description of the search result in text format.', example='In terms of 100 km/h to 0 braking performance, the distance is only 33.3 m. Objectively speaking, the Xiaomi SU7 performs really well in this regard. As for range, it features a 101 kWh battery capacity, achieving a CLTC range of 800 km, and an 800 V high-voltage platform that supports 220 km of range in 5 minutes and 510 km in 15 minutes. And in..'),
  title?: string(name='title', description='The title of the search result in plain text.

This parameter is required.', example='Xiaomi SU7 priced from 229,900 CNY, executive personally dispels rumors: no price will be announced before launch'),
}

model GlobalQueryContext {
  originalQuery?: {
    page?: string(name='page', description='The page number.', example='1'),
    query?: string(name='query', description='The query keyword.', example='Latest news on Trump tariffs'),
    timeRange?: string(name='timeRange', description='The time range.', example='NoLimit'),
  }(name='originalQuery', description='The initial query condition.'),
}

model GlobalSceneItem {
  detail?: string(name='detail', description='The detailed information in JSON format.', example='{
"snippet": "As of March 7, 2025, SpaceX Starship has been launched 8 times, with 4 successes and 4 failures.",
"snippetHighlighted": ["8 times"],
"title": "List of Starship launch missions"
}'),
  type?: string(name='type', description='The type of vertical data.', example='answerBox'),
}

model GlobalSearchInformation {
  searchTime?: long(name='searchTime', description='The search time, in milliseconds.', example='1200'),
  total?: long(name='total', description='The total count.', example='10339'),
}

model GlobalSearchResult {
  pageItems?: [
    GlobalPageItem
  ](name='pageItems', description='The web page content list.'),
  queryContext?: GlobalQueryContext(name='queryContext', description='The query context.'),
  requestId?: string(name='requestId', description='requestId', example='123456'),
  sceneItems?: [
    GlobalSceneItem
  ](name='sceneItems', description='The scenario-specific vertical API recall.'),
  searchInformation?: GlobalSearchInformation(name='searchInformation', description='The search information.'),
}

model IncludeImage {
  height?: int32(name='height', description='The image height in pixels.', example='324'),
  imageLink?: string(name='imageLink', description='The image link.', example='http://k.sinaimg.cn/n/sinakd20121/594/w2048h946/20240328/74cf-32c0d62e843df76567d760b4459d57c1.jpg/w700d1q75cms.jpg'),
  width?: int32(name='width', description='The image width in pixels.', example='700'),
}

model LocationInfo {
  city?: string(name='city', description='The city associated with the search. It is used to return information about the corresponding region in scenarios such as weather.', example='Beijing'),
  ip?: string(name='ip', description='The IP address associated with the search. It is used to identify the region in supported scenarios and has a lower priority than city.', example='117.136.110.23'),
}

model MedicalAnswerInput {
  query?: string(name='query', description='The medical question to be answered.', example='What should I do for a stomachache?'),
}

model MedicalAnswerMessage {
  content?: string(name='content'),
  metaData?: MedicalAnswerMetaData(name='metaData'),
}

model MedicalAnswerMetaData {
}

model MedicalAnswerRaDoc {
  content?: string(name='content', description='The content summary of the reference source. Summaries can be returned for medical web pages and drug instructions.', example='Stomach pain can be caused by various factors, including gastrointestinal spasms, inflammation, urinary tract stones, and menstrual pain. It can be relieved by applying a warm compress to the abdomen or treated by taking pain-relieving medication'),
  rawUrl?: string(name='rawUrl', description='The URL of the reference source. This can be an empty string for sources such as papers, clinical guidelines, and books.', example='https://www.example.com/article/4CD364Mm8hh.html'),
  title?: string(name='title', description='The title of the reference source.', example='How to quickly and easily relieve stomach pain'),
  type?: string(name='type', description='The type of the reference source, such as medical web pages, medical books, papers, or clinical guidelines.', example='med_web_source'),
}

model MedicalAnswerResult {
  messages?: [
    MedicalAnswerMessage
  ](name='messages', description='The list of medical Q&A answers. An empty array is returned if the question is empty or no content is matched.'),
  queryContext?: MultimodalQueryContext(name='queryContext', description='The query context information, such as the original query content.'),
  requestId?: string(name='requestId', description='The ID of the request. You can provide this ID for troubleshooting.', example='35E5608A-A737-2038-AFB6-D9D34C6BFD9E'),
  searchInformation?: UnifiedSearchInformation(name='searchInformation', description='The search information, such as the execution duration.'),
}

model MedicalKnowInput {
  query?: string(name='query', description='The medical, drug, disease, or food entity whose properties are to be queried.', example='Amoxicillin Capsules'),
  type?: string(name='type', description='The entity query type. Valid values:
- finding: disease
- food: food
- medicine: medicine
If this parameter is not specified, the type is automatically identified.', example='medicine'),
}

model MedicalKnowResult {
  messages?: [
    MedicalKnowledgeInfo
  ](name='messages', description='The list of recognized entity property results. An empty array is returned if no entities are recognized.'),
  queryContext?: MultimodalQueryContext(name='queryContext', description='The query context information, such as the original query content.'),
  requestId?: string(name='requestId', description='The ID of the request, which can be provided for troubleshooting.', example='35E5608A-A737-2038-AFB6-D9D34C6BFD9E'),
  searchInformation?: UnifiedSearchInformation(name='searchInformation', description='The search information for the query, such as the search duration.'),
}

model MedicalKnowledgeInfo {
  content?: string(name='content', description='The structured text composed of the entity name and its properties.', example='Entity: Amoxicillin capsules
- Property[Exact active ingredient]: Amoxicillin
- Property[Manufactured dosage form]: Oral capsule'),
  url?: string(name='url', description='The source link of the entity property content.', example='https://p.example.cn/0387f345/index?struct_id=VdB%2BLV7w7lHHEp'),
}

model MultimodalOriginalQuery {
  query?: string(name='query', description='The query conditions.', example='Alibaba'),
}

model MultimodalQueryContext {
  originalQuery?: MultimodalOriginalQuery(name='originalQuery', description='Alibaba'),
}

model MultimodalSearchBody {
  advancedParams?: map[string]any(name='advancedParams', description='The additional query items, such as blocked sites.', example='{
    "excludeSites": "www.360doc.com,weibo.com"
  }'),
  engineType?: string(name='engineType', description='The search engine type.', example='Generic'),
  query?: string(name='query', description='The query content.', example='Alibaba'),
}

model MultimodalSearchOutput {
  imageItems?: [
    UnifiedImageItem
  ](name='imageItems', description='Image List'),
  queryContext?: MultimodalQueryContext(name='queryContext', description='Query context information'),
  requestId?: string(name='requestId', description='Request ID', example='sdfsd234-2vxcg345-345vc'),
  searchInformation?: SearchInformation(name='searchInformation', description='Search basic information'),
}

model OmniSearchQuery {
  query?: string(name='query', description='The request parameter.

This parameter is required.', example='What is the weather in Hangzhou today?'),
  sessionId?: string(name='sessionId', description='The session ID. This is a reserved field and is not currently supported.', example='session_id_123'),
  useCot?: boolean(name='useCot', description='Specifies whether to use CoT. This is a reserved field and is not currently supported.', example='false'),
  useModel?: string(name='useModel', description='The model version to use. Valid values: pro for the deep version, and lite for the fast version.', example='pro'),
}

model OmniSearchResult {
  requestId?: string(name='requestId', description='The request ID.', example='35E5608A-A737-2038-AFB6-D9D34C6BFD9E'),
  success?: string(name='success', description='Indicates whether the request is successful.', example='true'),
}

model QueryContext {
  originalQuery?: {
    industry?: string(name='industry', description='The industry classification of the original request.', example='medical'),
    page?: string(name='page', description='The page number of the original request.', example='1'),
    query?: string(name='query', description='The query content of the original request.', example='Apsara Conference'),
    timeRange?: string(name='timeRange', description='The time range of the original request. Valid values: OneDay, OneWeek, OneMonth, OneYear, and NoLimit.', example='NoLimit'),
  }(name='originalQuery', description='The initial query condition.'),
  rewrite?: {
    enabled?: boolean(name='enabled', description='Specifies whether query rewrite is enabled.'),
    timeRange?: string(name='timeRange', description='The rewritten time range. An empty value indicates that no rewrite is performed or the rewrite result is the same as the original result.', example='OneYear'),
  }(name='rewrite', description='The query rewrite information.'),
}

model QueryResult {
  data?: [ 
    {
      address?: string(name='address', description='The detailed address.', example='No. 22 Fayun Lane, West Lake Scenic Area'),
      cityCode?: string(name='cityCode', description='The city code.', example='0571'),
      cityName?: string(name='cityName', description='The city name.', example='Hangzhou'),
      distanceMeter?: string(name='distanceMeter', description='The distance from the center point in meters.', example='815'),
      districtCode?: string(name='districtCode', description='The district code.', example='330106'),
      districtName?: string(name='districtName', description='The district name.', example='Xihu District'),
      id?: string(name='id', description='The internal identifier of the location.', example='B023B0BI3J'),
      images?: [ 
        {
          title?: string(name='title', description='The image name.', example='Lobby'),
          url?: string(name='url', description='The image URL.', example='http://store.example.com/showpic/e76beb3bedca3fe0375cef12742ea23e'),
        }
      ](name='images', description='The list of images.'),
      latitude?: string(name='latitude', description='The latitude of the location.', example='30.234403'),
      longitude?: string(name='longitude', description='The longitude of the location.', example='120.097327'),
      metadata?: {
        averageSpend?: string(name='averageSpend', description='The average spend in CNY.', example='500'),
        businessArea?: string(name='businessArea', description='The business area.', example='Central Area of West Lake Tourist Zone'),
        dailyOpeningHours?: string(name='dailyOpeningHours', description='The business hours for today.', example='09:00-18:00'),
        mainTag?: string(name='mainTag', description='The main tag.', example='Luxury'),
        phone?: string(name='phone', description='The contact phone numbers. Multiple numbers are separated by vertical bars.', example='0571-8732****'),
        score?: string(name='score', description='The rating.', example='4.7'),
        weeklyOpeningDays?: string(name='weeklyOpeningDays', description='The weekly opening days.', example='Monday to Sunday'),
      }(name='metadata', description='The related business information.'),
      name?: string(name='name', description='The location name.', example='Amanfayun Hangzhou'),
      provinceCode?: string(name='provinceCode', description='The province code.', example='330000'),
      provinceName?: string(name='provinceName', description='The province name.', example='Zhejiang Province'),
      typeCode?: string(name='typeCode', description='The location type code.', example='100102'),
      types?: string(name='types', description='The location types. Multiple types are separated by vertical bars.', example='Accommodation|Hotel|Five-star hotel'),
    }
  ](name='data', description='The list of returned locations.'),
  requestId?: string(name='requestId', description='The unique request ID for troubleshooting.', example='15A85F99-408F-5BFA-B617-0C7D3E732ABD'),
}

model ReadPageBody {
  formats?: [ string ](name='formats', description='The format of the parsing result.
- rawHtml: the HTML of the target website.
- html: the page content processed based on readabilityMode.
- markdown: the Markdown content converted from HTML.
- text: the text content extracted from HTML.'),
  location?: string(name='location', description='You do not need to specify this parameter.', example='null'),
  maxAge?: int32(name='maxAge', description='The maximum cache validity period. Unit: seconds. Default value: 1296000.

- If the cache duration is less than the value of maxAge, cached content is returned.

- If the value of maxAge is 0, caching is not used.', example='1296000'),
  pageTimeout?: int32(name='pageTimeout', description='The URL read timeout period. The value of pageTimeout must be less than the value of timeout.

Default value: 10000.', example='10000'),
  readability?: {
    excludeAllImages?: boolean(name='excludeAllImages', description='Specifies whether to exclude all images.

Default value: false.', example='false'),
    excludeAllLinks?: boolean(name='excludeAllLinks', description='Specifies whether to exclude all links.

Default value: false.', example='false'),
    excludedTags?: [ string ](name='excludedTags', description='The tags to exclude.'),
    readabilityMode?: string(name='readabilityMode', description='Valid values:
- none: does not remove any information. Default value: none.

- normal: removes irrelevant information from the target page, such as headers, footers, and navigation elements, based on a proprietary algorithm.

- article: extracts the main body content of the website based on a proprietary algorithm. This mode is suitable for blogs and news websites, but not for directory or navigation pages.', example='none'),
  }(name='readability', description='The readability configuration for the parsing result.'),
  timeout?: int32(name='timeout', description='The end-to-end processing timeout period. Unit: ms.

Valid values: [0, 180000].

Default value: 60000.', example='60000'),
  url?: string(name='url', description='The target URL to parse. The value must start with http:// or https://.

This parameter is required.', example='https://help.aliyun.com/document_detail/2837301.html?spm=a2c4g.11186623.help-menu-2837261.d_0_0_0.59ed3e95CppOt2&scm=20140722.H_2837301._.OR_help-T_cn~zh-V_1'),
}

model ReadPageItem {
  errorMessage?: string(name='errorMessage', description='The error related to the target URL.', example='null'),
  html?: string(name='html', description='The readable HTML of the target URL.', example='<html>\\\\n<head><title>Example Domain</title></head>\\\\n<body><div>\\\\n<h1>Example Domain</h1>\\\\n<p>This domain is for use in documentation examples without needing permission. Avoid use in operations.</p>\\\\n<p><a href=\\\\"https://iana.org/domains/example\\\\">Learn more</a></p>\\\\n</div></body>\\\\n</html>'),
  markdown?: string(name='markdown', description='The Markdown content of the target URL.', example='# Example Domain\\\\nThis domain is for use in documentation examples without needing permission. Avoid use in operations.\\\\n[Learn more](https://iana.org/domains/example)\\\\n'),
  rawHtml?: string(name='rawHtml', description='The raw HTML of the target URL.', example='<!doctype html><html lang=\\\\"en\\\\"><head><title>Example Domain</title><meta name=\\\\"viewport\\\\" content=\\\\"width=device-width, initial-scale=1\\\\"><style>body{background:#eee;width:60vw;margin:15vh auto;font-family:system-ui,sans-serif}h1{font-size:1.5em}div{opacity:0.8}a:link,a:visited{color:#348}</style><body><div><h1>Example Domain</h1><p>This domain is for use in documentation examples without needing permission. Avoid use in operations.<p><a href=\\\\"https://iana.org/domains/example\\\\">Learn more</a></div></body></html>\\\\n'),
  screenshot?: string(name='screenshot'),
  statusCode?: int32(name='statusCode', description='1. If the request to the target site succeeds, the HTTP status code of the target URL is returned.

2. If the request to the target site fails, a custom error code is returned:

    2.1 4030: The target site has security restrictions, such as robots.txt or security policies.
    
    2.2 4080: The request timed out.
    
    2.3 4290: The rate limiting policy of the site was triggered.
    
    2.4 5010: An unknown exception occurred.', example='200'),
  text?: string(name='text', description='The text content of the target URL.', example='# Example Domain\\\\nThis domain is for use in documentation examples without needing permission. Avoid use in operations.\\\\nLearn more\\\\n'),
}

model ReadPageScrapeBody {
  formats?: [ string ](name='formats', description='The formats of the parsed result. Valid values:
- rawHtml: The HTML of the target site.
- html: The page content processed based on the readabilityMode.
- markdown: The Markdown content converted from the HTML.
- text: The text content in the HTML.
- screenshot: The screenshot of the target site.'),
  location?: string(name='location', description='This parameter is not required.', example='null'),
  maxAge?: int32(name='maxAge', description='The maximum cache duration, in seconds.
- If the cache duration is less than the maxAge value, the cached content is returned.
- If the maxAge value is set to 0, the cache is not used.

Default value: 1296000.', example='1296000'),
  pageTimeout?: int32(name='pageTimeout', description='The timeout period for waiting for the resources of the target site to fully load. The pageTimeout value must be less than the timeout value.

Default value: 15000.', example='15000'),
  readability?: {
    excludeAllImages?: boolean(name='excludeAllImages', description='Specifies whether to remove all images.

Default value: false.', example='false'),
    excludeAllLinks?: boolean(name='excludeAllLinks', description='Specifies whether to remove all links.

Default value: false.', example='false'),
    excludedTags?: [ string ](name='excludedTags', description='The tags to exclude.'),
    readabilityMode?: string(name='readabilityMode', description='The readability mode. Valid values:
- none: Does not remove any information. This is the default value.
- normal: Removes irrelevant information from the target page, such as headers, footers, and navigation elements, based on a proprietary algorithm.
- article: Extracts the main body content of the site based on a proprietary algorithm. This mode is suitable for blogs and news sites, but not for directory or navigation pages.', example='none'),
  }(name='readability', description='The readability configuration of the parsed result.'),
  timeout?: int32(name='timeout', description='The end-to-end processing timeout period, in milliseconds.

Valid values: 0 to 180000.

Default value: 60000.', example='60000'),
  url?: string(name='url', description='The target URL to parse. It must start with http:// or https://.

This parameter is required.', example='https://www.example.com'),
}

model RequestContents {
  mainText?: boolean(name='mainText', description='Specifies whether to return the main text. Default value: false.'),
  markdownText?: boolean(name='markdownText', description='Specifies whether to return Markdown. Default value: false.'),
  rerankScore?: boolean(name='rerankScore', description='Specifies whether to enable reranking and return the rerank score. Default value: true.'),
  richMainBody?: boolean(name='richMainBody', description='Specifies whether to return the full rich text content.'),
  summary?: boolean(name='summary', description='Specifies whether to return the enhanced summary. Default value: false. The summary feature is billed separately.'),
}

model ScanFileInfo {
  angle?: int32(name='angle', description='The image rotation angle.', example='100'),
  height?: int32(name='height', description='The image height.', example='100'),
  imageBase64?: string(name='imageBase64', description='The Base64 encoding of the image.', example='erwre'),
  width?: int32(name='width', description='The image width.', example='100'),
}

model ScanFileInput {
  imageBase64?: string(name='imageBase64', description='The Base64 encoding of the image.', example='wrwqr'),
  imageUrl?: string(name='imageUrl', description='The URL of the image.', example='https://www.1241.png'),
  scanFileInputConfig?: ScanFileInputConfig(name='scanFileInputConfig', description='The scan parameters.'),
}

model ScanFileInputConfig {
  autoCrop?: string(name='autoCrop', description='The automatic trim.', example='true'),
  autoRotate?: string(name='autoRotate', description='The automatic rotation.', example='true'),
