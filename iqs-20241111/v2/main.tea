model SceneItem {
  detail?: string(name='detail', description='The result details for vertical scenarios. Different scenarios return different JSON string structures.', example='{"title":"London time","targetTimeZone":"Europe/London"}'),
  type?: string(name='type', description='The result type for vertical scenarios, such as weather or time.', example='time'),
}

model ScorePageItem {
  cardType?: string(name='cardType', description='The search result template. Different templates return different fields.

This parameter is required.', example='structure_web_info'),
  correlationTag?: int32(name='correlationTag', description='The relevance tag. A value of 0 indicates low relevance, and 1 indicates non-low relevance.', example='1'),
  displayLink?: string(name='displayLink', description='The abbreviated URL of this search result.

This parameter is required.', example='baijiahao.baidu.com'),
  hostAuthorityScore?: double(name='hostAuthorityScore', description='The dynamic authority score, which ranges from 0 to 2 and is calculated based on the relevance of the query content.', example='1.923339'),
  hostLogo?: string(name='hostLogo', description='The site logo.', example='https://s2.zimgs.cn/ims?kt=url&at=smstruct&key=aHR0cHM6Ly9ndy5hbGljZG4uY29tL0wxLzcyMy8xNTY1MjU2NjAwLzJhL2YwL2I0LzJhZjBiNDQxMGI5YmVlMDVjOGVlNGJmODk3MTNkNTFjLnBuZw==&sign=yx:CUlNNQVJQjFrk3Kxt2F3KWhTOFU=&tv=400_400'),
  hostname?: string(name='hostname', description='The site name.', example='Xinhua News'),
  htmlSnippet?: string(name='htmlSnippet', description='The description snippet of the search result in HTML format.

This parameter is required.', example='In terms of 100 km/h-0 braking capability, it is only 33.3m. Without bias, just looking at this, the <em>Xiaomi SU7</em> indeed performs well. As for range, with a 101 kWh battery capacity, it achieves a CLTC range of 800 km, and features an 800V high-voltage platform that can add 220 km of range in 5 minutes and 510 km in 15 minutes. And..'),
  htmlTitle?: string(name='htmlTitle', description='The search result title in HTML format.

This parameter is required.', example='<em>Xiaomi</em> SU7 priced from 229,900 yuan, executive personally dispels rumors: no <em>price</em> before launch - Baijiahao'),
  images?: [
    IncludeImage
  ](name='images', description='The image information.'),
  link?: string(name='link', description='The full URL that the search result points to.

This parameter is required.', example='https://baijiahao.baidu.com/s?id=1787881554557805096'),
  mainText?: string(name='mainText', description='The full text of the search result, which is available in some scenarios.', example='Yesterday, Xiaomi Auto was not launched, but related information has been mostly revealed. At the launch event, Lei Jun directly stated that Xiaomi SU7 benchmarks Tesla and Porsche, with 100 industry-leading features. It seems that "far ahead" is no longer a Huawei patent? When introducing the technology, Lei Jun also expanded on five major aspects: motor, battery, mega casting, autonomous driving, and smart cockpit, fully demonstrating Xiaomi Auto\\\\"s technology and technical reserves. All the materials that can be stacked are stacked... Regarding the performance that everyone is interested in, 0-100 km/h acceleration in 2.78s, and a top speed of 265 km/h'),
