  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='None'),
  message?: string(name='Message', description='The response message.', example='Success.'),
  requestId?: string(name='RequestId', description='The request ID.', example='385C2BC3-52FC-564F-9312-97E5DFE1DFC0'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='True'),
}

