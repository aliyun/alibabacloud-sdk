model AddOrganizationMemberRequest {
  accountName: string(name='AccountName', description='The display name. If this parameter is not empty, the name field of the account is updated synchronously.

This parameter is required.', example='Account name', position='Query'),
  orgRoleCode: string(name='OrgRoleCode', description='The organization role code. Valid values: ORG_ADMIN and ORG_MEMBER. Default value: ORG_MEMBER.

This parameter is required.', example='ORG_MEMBER', position='Query'),
  specType?: string(name='SpecType', description='The seat specification. Valid values:
- standard: Standard seat.
- pro: Pro seat.
- max: Premium seat.', example='standard', position='Query'),
}

