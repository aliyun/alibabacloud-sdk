model SubmitVideoRemakeJobRequest {
  regionId?: string(name='RegionId', position='Host'),
  input?: string(name='Input', description='The input materials. The value is a JSON string with the following structure:

- Medias (Array<Object>, required): A non-empty list of media assets. This operation uses the first video in the list and does not support batch remakes. The first item contains the following fields:
  - Type (String, required): The type of the media asset. For this operation, set the value to video for the first item. The value is case-insensitive.
  - Url (String, mutually exclusive with MediaId): The URL of the media asset. The URL must start with http:// or https:// and cannot exceed 2,048 characters in length. Unregistered URLs are automatically registered as media assets.
  - MediaId (String, mutually exclusive with Url): The ID of the registered media asset. If both Url and MediaId are specified, MediaId takes precedence.', example='{"Medias":[{"Type":"video","Url":"https://example.com/source.mp4"}]}', position='Query'),
  remakeParams?: string(name='RemakeParams', description='The remake parameters. The value is a JSON string with the following structure:

- Product (Object, required): The product information, including the original product and the new product.
  - OriginalProductName (String, optional): The name of the product or brand in the original video. This is used to locate and replace mentions of the original product.
  - NewProduct (Object, required): The information about the new product.
    - ProductName (String, required): The name of the product or brand.
    - Description (String, optional): The description of the product.
    - ProductKnowledge (String, optional): The physical knowledge of the product, such as the material and usage.
    - ProductImages (Array\\\\<String\\\\>, required): The images of the new product. The list cannot be empty. Each item is an HTTP or HTTPS URL.
    - SellingPoints (Array\\\\<String\\\\>, optional): The list of selling points of the product.
    - OriginalPrice (String, optional): The original price.
    - CurrentPrice (String, optional): The current price.
    - Discount (String, optional): The discount information, such as "50 off for orders over 200" or "buy one get one free".
- AvatarList (Array\\\\<Object\\\\>, optional): The list of character replacements. Single-character and multi-character replacements are supported. Pass one item for single-character replacement and two to five items for multi-character replacement. Each item is an object that describes the replacement relationship between an original character and a new character. If this parameter is not passed or is an empty array, no characters are replaced.
  - OriginalAvatarImage (String, required for each item in multi-character replacement, optional for single-character replacement): The reference image of the target character in the original video. HTTP and HTTPS URLs or registered image MediaIds are supported. The value cannot be duplicated within the same list.
  - NewAvatarImages (Array\\\\<String\\\\>, required for each item): The list of reference images for the new character. The list cannot be empty. HTTP and HTTPS URLs or registered image MediaIds are supported.
  - AvatarName (String, optional for each item): The role name of the replaced character in the generated script.
- VoiceoverLanguage (String, optional): The voiceover language. Explicitly specify the language, such as zh for Chinese or en for English.
- AdditionalRequirements (String, optional): Additional remake requirements.', example='{
  "Product": {
    "OriginalProductName": "Original Shapewear Bodysuit",
    "NewProduct": {
      "ProductName": "Compression Shapewear Bodysuit",
      "Description": "Description of the new product.",
      "ProductImages": [
        "https://example.com/product-front.png",
        "https://example.com/product-side.png",
        "https://example.com/product-back.png"
      ],
      "ProductKnowledge": "Product materials, physical characteristics, and usage instructions."
    }
  },
  "AvatarList": [
    {
      "OriginalAvatarImage": "https://example.com/original-avatar-a.png",
      "NewAvatarImages": [
        "https://example.com/new-avatar-a.png"
      ],
      "AvatarName": "Alice"
    },
    {
      "OriginalAvatarImage": "https://example.com/original-avatar-b.png",
      "NewAvatarImages": [
        "https://example.com/new-avatar-b.png"
      ],
      "AvatarName": "Bob"
    }
  ],
  "VoiceoverLanguage": "zh"
}', position='Query'),
  userData?: string(name='UserData', description='The user-defined data.', example='{
  "NotifyAddress": "https://example.com/callback"
}', position='Query'),
}

model SubmitVideoRemakeJobResponseBody = {
  errorCode?: string(name='ErrorCode', description='The error code.', example='InvalidParameter'),
  jobId?: string(name='JobId', description='The job ID.', example='0123456789abcdef0123456789abcdef'),
  requestId?: string(name='RequestId', description='The request ID.', example='12345678-1234-4321-ABCD-123456789012'),
}

model SubmitVideoRemakeJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SubmitVideoRemakeJobResponseBody(name='body'),
}

/**
  * @description Submits the original video and remake information such as new products and characters to asynchronously complete video content understanding and creative script generation. Uses the returned JobId to call GetVideoRemakeJob to query the progress and outputs. Video rendering requires a separate call to SubmitVideoRenderJob.
  * @param request  the request parameters of SubmitVideoRemakeJob  SubmitVideoRemakeJobRequest
  * @return SubmitVideoRemakeJobResponse
 */
async function submitVideoRemakeJob(request: SubmitVideoRemakeJobRequest): SubmitVideoRemakeJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'SubmitVideoRemakeJob', 'POST', '/', 'json', false, 'json', request);
}

model SubmitVideoRenderJobRequest {
  regionId?: string(name='RegionId', position='Host'),
  script?: string(name='Script', description='The complete creative script confirmed or edited by the user, formatted as a JSON string. The structure must align with the JSON content in the Result file returned by the GetRemakeScriptJob API.', example='{
"schemaVersion":"creative/v1",
"algoResult":{...},
"extraInfo":{...}
}', position='Query'),
  settings?: string(name='Settings', description='The rendering settings, formatted as a JSON string.

- **Resolution** (String, required): The resolution. Valid values: 720P and 1080P.
  - **AspectRatio** (String, optional): The video aspect ratio. Valid values: 9:16, 16:9, and 1:1. Default value: 9:16.
  - **VoiceoverLanguage** (String, optional): The voiceover language. Valid values: zh (Chinese), en (English), es (Spanish), pt (Portuguese), fr (French), de (German), ja (Japanese), ko (Korean), and ar (Arabic). Default value: zh.
  - **WithSubtitles** (Boolean, optional): Specifies whether to generate subtitles. Default value: true.
  - **TTS** (Object, optional): The text-to-speech (TTS) configuration. If you do not specify this parameter, the default voice is used. This parameter applies only to single-person and voiceover-only scenarios.

    - **VoiceUrl** (String, optional): The URL of the voice file, which must be an HTTP or HTTPS address. If specified, this voice is used for the voiceover throughout the entire video.

  - **Bgm** (String, optional): The URL or 32-character media asset ID of the background music.', example='{
  "VoiceoverLanguage": "zh",
  "Resolution": "1080P",
  "AspectRatio": "9:16",
  "TTS": {
    "VoiceUrl": "http://xxx.mp3"
  },
  "WithSubtitles": true,
  "Bgm": "http://xxx.mp3"
}', position='Query'),
  userData?: string(name='UserData', description='The user-defined parameters, formatted as a JSON string.', example='{"NotifyAddress": "http://xxx.callback.url"}', position='Query'),
}

model SubmitVideoRenderJobResponseBody = {
  errorCode?: string(name='ErrorCode', description='The error code. This parameter is returned when the job is in the Failed state.', example='200'),
  jobId?: string(name='JobId', description='The job ID.', example='68ca759e798b40b4903b255*******'),
  requestId?: string(name='RequestId', description='The request ID.', example='******3B-0E1A-586A-AC29-742247******'),
}

model SubmitVideoRenderJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SubmitVideoRenderJobResponseBody(name='body'),
}

