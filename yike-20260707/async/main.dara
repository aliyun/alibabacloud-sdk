- qwen-image-3.0
- qwen-image-2.0-pro
- qwen-image-2.0
- wan2.7-image', example='wan2.7-image', position='Query'),
  n?: string(name='N', description='The number of images. Valid values: 1 to 4. Default value: 1.', example='1', position='Query'),
  resolution?: string(name='Resolution', description='The resolution. Valid values: 1K (default), 2K, and 4K.', example='720P', position='Query'),
  scene?: string(name='Scene', description='The scenario. This is an enumeration type. Currently, only `general` is supported.', example='general', position='Query'),
