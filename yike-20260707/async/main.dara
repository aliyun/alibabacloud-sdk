model SubmitMediaComprehensionJobRequest {
  regionId?: string(name='RegionId', position='Host'),
  input?: string(name='Input', description='The input media. The value is a JSON string with the following structure:

- Medias (Array<Object>, required): The list of media files. The array must contain 1 to 10 elements. Each element contains the following fields:
  - Type (String, required): The media type. Valid values: video and image. The value is not case-sensitive.
  - Url (String, mutually exclusive with MediaId): The URL of the media file. The URL must start with http:// or https:// and be up to 2,048 characters in length. Unregistered URLs are automatically registered as media files.
  - MediaId (String, mutually exclusive with Url): The ID of the registered media file. If both Url and MediaId are specified, MediaId takes precedence.', example='{
  "Medias": [
    {
      "Type": "video",
      "Url": "https://example.com/source.mp4"
    }
  ]
}', position='Query'),
  jobParams?: string(name='JobParams', description='The analysis parameters. The value is a JSON string up to 65,536 characters in length.

- VideoBreakdown: Supports the ResultType parameter (String, optional). Valid value: Standard (default).
- ProductRecognition: Uses parameters such as product information and prompts. The total number of fields cannot exceed 20. Example fields for product parameters include ProductName, BrandName, and SellingPoints.', example='{
  "ResultType": "Standard"
}
or
{
  "ProductName": "Quiet Blender Soymilk Maker",
  "BrandName": "LiangChu",
  "SellingPoints": [
    "Low-noise blending",
    "One-touch self-cleaning"
  ]
}', position='Query'),
  jobType?: string(name='JobType', description='The job type. Valid values:

- VideoBreakdown: Viral video breakdown. The Medias array must contain exactly one element with Type set to video.
- ProductRecognition: Product image information recognition. All elements in the Medias array must have Type set to image.', example='VideoBreakdown', position='Query'),
  userData?: string(name='UserData', description='The custom parameters. The value is a JSON string. The custom parameters are returned as-is in the callback result (for example, newsKey). NotifyAddress is a system-reserved field for the callback URL. A callback is triggered after the job is completed.', example='{
  "NotifyAddress": "https://example.com/callback"
}', position='Query'),
}

