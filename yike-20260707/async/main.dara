  * @param request  the request parameters of SubmitVideoRenderJob  SubmitVideoRenderJobRequest
  * @return SubmitVideoRenderJobResponse
 */
async function submitVideoRenderJob(request: SubmitVideoRenderJobRequest): SubmitVideoRenderJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'SubmitVideoRenderJob', 'POST', '/', 'json', false, 'json', request);
}

model SubmitVideoTranslationJobRequest {
  clientToken?: string(name='ClientToken', description='The user-level idempotency token, which can be up to 40 characters in length. If the same user repeatedly submits a request with the same token, the original task is returned.', example='vt-client-20260820-001', position='Body'),
  description?: string(name='Description', description='The job description, which is used to record the business purpose or processing requirements.', example='Translate the Chinese product introduction video into English', position='Body'),
  input: string(name='Input', description='The input configuration JSON string. You must specify either Video or VideoMediaId, but not both. You can specify at most one of Audio and AudioMediaId. Subtitle is optional.

This parameter is required.', example='{"VideoMediaId":"media-video-001"}', position='Body'),
  jobParameters: string(name='JobParameters', description='The job parameters JSON string. It must include at least SourceLanguage and TargetLanguage. You can also configure primary subtitle removal, voice translation, on-screen text translation, lip sync, and final editing.

This parameter is required.', example='{"SourceLanguage":"zh","TargetLanguage":"en","NeedDetext":false,"NeedVisualTranslate":false}', position='Body'),
  jobType: string(name='JobType', description='The job type. SubtitleTranslate indicates subtitle translation, and VoiceTranslate indicates voice translation.

This parameter is required.', example='VoiceTranslate', position='Body'),
  output?: string(name='Output', description='The output configuration JSON string. OssUri is the optional OSS output directory for the customer. If OssUri is not specified, a signed URL for the service-owned output is returned.', example='{"OssUri":"oss://example-bucket/video-translation/output/"}', position='Body'),
  title?: string(name='Title', description='The job title. If not specified, the service generates a default title.', example='Product introduction video English translation', position='Body'),
  userData?: string(name='UserData', description='The user-defined data JSON string. When specifying a Message Service (MNS) queue to receive asynchronous notifications, set NotifyAddress to the pure queue name starting with yike-callback- instead of the full queue URL. You can optionally set NotifyMnsEndpoint to the MNS endpoint of the task account.', example='{"NotifyAddress":"yike-callback-test","NotifyMnsEndpoint":"https://1234567890123456.mns.cn-shanghai.aliyuncs.com"}', position='Body'),
}

model SubmitVideoTranslationJobResponseBody = {
  jobId?: string(name='JobId', description='The video translation job ID, which is used to call GetVideoTranslationJob to query the task.', example='vtj_0123456789abcdef0123456789abcdef'),
  requestId?: string(name='RequestId', description='The request ID, which is used for Tracing Analysis and troubleshooting.', example='req-vt-20260820-001'),
}

model SubmitVideoTranslationJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SubmitVideoTranslationJobResponseBody(name='body'),
