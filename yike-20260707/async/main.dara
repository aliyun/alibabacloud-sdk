model SubmitMediaComprehensionJobRequest {
  regionId?: string(name='RegionId', position='Host'),
  input?: string(name='Input', description='The input material. JSON string with the following structure:

- Medias (Array<Object>, required): The list of media assets. Contains 1 to 10 elements. Each element includes the following fields:
  - Type (String, required): The media asset type. Valid values: video or image (case-insensitive).
  - Url (String, either Url or MediaId is required): The URL of the media asset. The URL must start with http:// or https:// and cannot exceed 2048 characters in length. Unregistered URLs are automatically registered as media assets.
  - MediaId (String, either Url or MediaId is required): The ID of a registered media asset. If both Url and MediaId are specified, MediaId takes precedence.', example='{"Medias":[{"Type":"video","Url":"https://xxx.mp4"}]}', position='Query'),
  jobParams?: string(name='JobParams', description='The analysis parameters. JSON string. The total length cannot exceed 65536 characters, and the total number of fields cannot exceed 20.', example='{"ProductName":"Quiet Blender Soymilk Maker","BrandName":"LiangChu","SellingPoints":["Low-noise blending","One-touch self-cleaning"]}', position='Query'),
  jobType?: string(name='JobType', description='The job type.

- VideoBreakdown: viral video breakdown. Requires Medias to contain exactly 1 element with Type=video.
- ProductRecognition: product image information recognition. Requires all elements in Medias to have Type=image.', example='VideoBreakdown', position='Query'),
  userData?: string(name='UserData', description='The custom parameters. JSON string that is returned as-is in the callback result (for example, newsKey). The system reserved field NotifyAddress specifies the callback URL. The callback is triggered after the job is completed.', example='{"NotifyAddress": "http://xxx.callback.url"}', position='Query'),
}

model SubmitMediaComprehensionJobResponseBody = {
  errorCode?: string(name='ErrorCode', description='The business error code. An empty string is returned when the submission is successful.', example='""'),
  jobId?: string(name='JobId', description='The job ID.', example='68ca759e798b40b4903b255********'),
  requestId?: string(name='RequestId', description='Id of the request', example='******11-DB8D-4A9A-875B-275798******'),
}

model SubmitMediaComprehensionJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SubmitMediaComprehensionJobResponseBody(name='body'),
}

