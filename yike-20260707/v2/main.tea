  - Type (String, required): The type of the media asset. Valid values: video and image. The value is not case-sensitive.
  - Url (String, mutually exclusive with MediaId): The URL of the media asset. The URL must start with http:// or https:// and be up to 2,048 characters in length. Unregistered URLs are automatically registered as media assets.
  - MediaId (String, mutually exclusive with Url): The ID of the registered media asset. If both Url and MediaId are specified, MediaId takes precedence.', example='{"Medias":[{"Type":"video","Url":"https://xxx.mp4"}]}'),
  jobParams?: string(name='JobParams', description='The analysis parameters. The value is a JSON string up to 65,536 characters in length and contains a maximum of 20 fields.', example='{"ProductName":"Quiet Blender Soymilk Maker","BrandName":"LiangChu","SellingPoints":["Low-noise blending","One-touch self-cleaning"]}'),
  jobType?: string(name='JobType', description='The job type. Valid values:

- VideoBreakdown: Viral video breakdown. The Medias array must contain exactly one element with Type set to video.
- ProductRecognition: Product image information recognition. All elements in the Medias array must have Type set to image.', example='VideoBreakdown'),
  userData?: string(name='UserData', description='The custom parameters. The value is a JSON string that is returned as-is in the callback result, such as newsKey. NotifyAddress is a system-reserved field that specifies the callback URL. The system sends a callback to this URL after the job is completed.', example='{"NotifyAddress": "http://xxx.callback.url"}'),
}

