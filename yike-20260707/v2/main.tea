import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'Yike';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('yike', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AddProjectMembersRequest {
  projectId?: string(name='ProjectId', description='The project ID.

This parameter is required.', example='pd_061716****'),
  yikeUserIds?: string(name='YikeUserIds', description='The Yike user IDs to be added. Separate multiple IDs with commas. The users must belong to the current Alibaba Cloud account. By default, the Edit permission is granted.

This parameter is required.', example='10001,10002'),
}

model AddProjectMembersResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='01A1E2B8-****'),
  result?: boolean(name='Result', description='Indicates whether the operation is successful. Valid values:
- true: Successful.
- false: Failed.', example='true'),
}

model AddProjectMembersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddProjectMembersResponseBody(name='body'),
}

/**
 * @summary Adds members to a project.
 *
 * @description Adds users under the same Alibaba Cloud account to a specified project in the default workspace of the Alibaba Cloud account, and grants the Edit permission by default. ProjectId specifies the project ID. YikeUserIds specifies a comma-separated list of Yike user IDs, which are not Alibaba Cloud UIDs. Currently, only the default workspace of the Alibaba Cloud account is supported, and projects in newly created workspaces are not supported. This operation follows the behavior of the original member API operation: adding an existing member resets the project permissions. Regular members are assigned the Edit permission, and SuperAdmins of the default workspace retain the Manage permission. Only Alibaba Cloud accounts that have activated ProductionOpenAPI are supported. Default Alibaba Cloud account projects (pd_Alibaba Cloud account ID) are not supported.
 *
 * @param request AddProjectMembersRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddProjectMembersResponse
 */
@context("addProjectMembersWithContext")
async function addProjectMembersWithOptions(request: AddProjectMembersRequest, runtime: $RuntimeOptions): AddProjectMembersResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.projectId)) {
    query['ProjectId'] = request.projectId;
  }
  if (!$isNull(request.yikeUserIds)) {
    query['YikeUserIds'] = request.yikeUserIds;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddProjectMembers',
    version = '2026-07-07',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Adds members to a project.
 *
 * @description Adds users under the same Alibaba Cloud account to a specified project in the default workspace of the Alibaba Cloud account, and grants the Edit permission by default. ProjectId specifies the project ID. YikeUserIds specifies a comma-separated list of Yike user IDs, which are not Alibaba Cloud UIDs. Currently, only the default workspace of the Alibaba Cloud account is supported, and projects in newly created workspaces are not supported. This operation follows the behavior of the original member API operation: adding an existing member resets the project permissions. Regular members are assigned the Edit permission, and SuperAdmins of the default workspace retain the Manage permission. Only Alibaba Cloud accounts that have activated ProductionOpenAPI are supported. Default Alibaba Cloud account projects (pd_Alibaba Cloud account ID) are not supported.
 *
 * @param request AddProjectMembersRequest
 * @return AddProjectMembersResponse
 */
async function addProjectMembers(request: AddProjectMembersRequest): AddProjectMembersResponse {
  var runtime = new $RuntimeOptions{};
  return addProjectMembersWithOptions(request, runtime);
}

