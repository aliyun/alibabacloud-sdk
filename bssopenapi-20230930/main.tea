model AllocateCostCenterResourceRequest {
  fromCostCenterId?: long(name='FromCostCenterId', description='The ID of the source cost center. This parameter is required.

- 0 indicates the unallocated cost center.
- A value greater than 0 indicates an allocated cost center ID.', example='637180'),
  fromOwnerAccountId?: long(name='FromOwnerAccountId', description='The ID of the owner of the source cost center.', example='1529600453335198'),
  nbid?: string(name='Nbid', description='The primary sales channel ID. If this parameter is left empty, the sales channel ID of the current user is used by default.', example='2684201000001'),
  resourceInstanceList?: [ 
    {
      apportionCode?: string(name='ApportionCode', description='The attached resource type of the attached-resource instance. This parameter is required only for attached-resource product instances.
- Currently, eight commodities support attached resources. The commodity codes are oss, dcdn, snapshot, vod, cdn, live, and cbwp.
- You can call the QueryCostUnitResource operation to retrieve all billing instances (including attached-resource instances with their attached resource types) under a specific cost center (including the unallocated cost center) of a user.', example='qwer1-cn-beijing'),
      apportionName?: string(name='ApportionName', description='The name of the attached resource.', example='split-item-test1'),
      commodityCode?: string(name='CommodityCode', description='The commodity code of the billing instance. This parameter is required.', example='oss'),
      commodityName?: string(name='CommodityName', description='The commodity name of the resource.', example='RESOURCE_UDR'),
      instanceId?: string(name='InstanceId', description='The billing granularity ID. This parameter is required.', example='cn-hangzhou;standard'),
      pipCode?: string(name='PipCode', description='The product code, which is the same as the product code in User Center bills.', example='ecs'),
      relatedResources?: string(name='RelatedResources', description='The resources related to the resource instance.', example='related-resource'),
      resourceGroup?: string(name='ResourceGroup', description='The resource group.', example='xihe_mpp'),
      resourceId?: string(name='ResourceId', description='The resource ID.', example='cn-hangzhou;standard:app'),
      resourceNick?: string(name='ResourceNick', description='The custom nickname of the resource.', example='ecs-test-1'),
      resourceSource?: string(name='ResourceSource', description='The source of the resource. Valid values:
- AUTO_ALLOCATE: automatic allocation.
- MANUAL_ALLOCATE: manual allocation.', example='AUTO_ALLOCATE'),
      resourceStatus?: string(name='ResourceStatus', description='The resource status.', example='0'),
      resourceTag?: string(name='ResourceTag', description='The tag of the resource.', example='tag-test1'),
      resourceType?: string(name='ResourceType', description='The resource type.', example='SCU'),
      resourceUserId?: long(name='ResourceUserId', description='The ID of the owner of the billing instance. This parameter is required.', example='273394581313325532'),
      resourceUserName?: string(name='ResourceUserName', description='The username of the resource ownership user.', example='test'),
    }
  ](name='ResourceInstanceList', description='The list of resource instances.

This parameter is required.'),
  toCostCenterId?: long(name='ToCostCenterId', description='The ID of the destination cost center. Valid values:

- -1: moves allocated resources back to the unallocated state.
- A value greater than 0: allocates resources to the specified cost center.', example='638288'),
}

