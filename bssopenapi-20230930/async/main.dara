  ecIdAccountIds?: [ 
    {
      accountIds?: [ long ](name='AccountIds', description='The list of accounts to access. If this parameter is left empty, all accounts under the current entity ID are selected.'),
      ecId?: string(name='EcId', description='The enterprise entity ID.', example='12345'),
    }
  ](name='EcIdAccountIds', description='The list of enterprises and accounts. If this parameter is left empty, the current account is queried.', shrink='json', position='Query'),
