 *         ```
 *         {
 * 			"Statement": [
 * 			{
 * 				"Action": "sts:AssumeRole",
 * 				"Effect": "Allow",
 * 				"Principal": {
 * 				"Service": [
 * 					"ecs.aliyuncs.com"
