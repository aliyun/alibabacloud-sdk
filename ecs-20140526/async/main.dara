model AttachDiskRequest {
  sourceRegionId?: string(name='SourceRegionId', position='Host'),
  bootable?: boolean(name='Bootable', description='Specifies whether to attach the disk as a system disk. Valid values:

- true: Yes.

- false: No.

Default value: false.

> If you set this parameter to `Bootable=true`, the destination ECS instance must not have a system disk attached.', example='false', position='Query'),
  deleteWithInstance?: boolean(name='DeleteWithInstance', description='Specifies whether to release the disk when the instance is released. Valid values:

- true: The disk is released.
- false: The disk is not released. The disk is retained and converted to a pay-as-you-go data disk.

Default value: false.

When you configure this parameter, take note of the following items:

- If you set `DeleteWithInstance` to `false` and the ECS instance is locked for security reasons (that is, `"LockReason" : "security"` is marked in `OperationLocks`), this property of the disk is ignored and the disk is released when the ECS instance is released.

- If the destination disk that you want to attach is an `elastic ephemeral disk`, you must set the `DeleteWithInstance` parameter to `true`.

- This parameter cannot be configured for disks with the multi-attach feature enabled.', example='false', position='Query'),
  device?: string(name='Device', description='The device name of the disk.

> This parameter is being deprecated. To improve compatibility, we recommend that you use other parameters to identify the disk.', example='testDeviceName', position='Query'),
  diskId: string(name='DiskId', description='The ID of the disk that you want to attach. The disk (`DiskId`) and the instance (`InstanceId`) must be in the same zone.

> You can attach data disks and system disks. For the related constraints, see the operation description section above.

This parameter is required.', example='d-bp1j4l5axzdy6ftk****', position='Query'),
  force?: boolean(name='Force', description='Specifies whether to forcibly attach the disk. Valid values:

- true: Yes.
- false: No.

Default value: false.


> Currently, only regional Enterprise SSDs (ESSDs) (`cloud_regional_disk_auto`) support setting this parameter to true.', example='false', position='Query'),
  instanceId: string(name='InstanceId', description='The ID of the ECS instance to which you want to attach the disk.

This parameter is required.', example='i-bp1dq5lozx5f4pmd****', position='Query'),
  keyPairName?: string(name='KeyPairName', description='The name of the SSH key pair to bind to a Linux ECS instance when you attach a system disk.

- Windows Server: SSH key pairs are not supported. Even if you specify this parameter, only the `Password` configuration is applied.

- Linux: Password-based logon is disabled by default.', example='KeyPairTestName', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  password?: string(name='Password', description='The logon password of the instance, which is configured when you attach a system disk. This parameter takes effect only for the administrator and root usernames and does not take effect for other usernames. The password must be 8 to 30 characters in length and must contain at least three of the following character types: uppercase letters, lowercase letters, digits, and special characters. The special characters can be:

```
()`~!@#$%^&*-_+=|{}[]:;\\\\"<>,.?/
```
For Windows instances, the password cannot start with a forward slash (/).

> If you specify the `Password` parameter, send the request over HTTPS to prevent password leaks.', example='EcsV587!', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
}

