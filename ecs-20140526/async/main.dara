  coolOffPeriod: int32(name='CoolOffPeriod', description='The cool-off period. In compliance mode, you can set a cool-off period or skip the cool-off period to lock the snapshot directly. 

During the cool-off period, users with the required RAM permissions can unlock the snapshot, extend or shorten the cool-off period, and extend or shorten the lock duration. The snapshot cannot be deleted during the cool-off period. 

After the cool-off period ends, you can only extend the lock duration. 

Unit: hours. 

Valid values: 0 to 72. A value of 0 indicates that the cool-off period is skipped and the snapshot is locked directly. 

If the snapshot has entered the compliance mode lock period, you must set this parameter to 0 to extend the lock duration.

This parameter is required.', example='3', minimum=0, maximum=72, position='Query'),
  dryRun?: boolean(name='DryRun', description='Specifies whether to only precheck the request. Valid values: 
- true: sends a check request. The operation is not performed. The system checks whether required parameters are specified, the request format is valid, and the service limits are met. If the check fails, the corresponding error is returned. If the check succeeds, the DryRunOperation error code is returned. 
- false (default): sends a normal request. The request is executed after the check succeeds.', example='false', position='Query'),
  lockDuration: int32(name='LockDuration', description='The lock duration. The snapshot lock automatically expires after the lock duration ends. 

Unit: days. 

Valid values: 1 to 36500.

This parameter is required.', example='1', minimum=1, maximum=36500, position='Query'),
  lockMode: string(name='LockMode', description='The lock mode. Valid values: 
- compliance: locks the snapshot in compliance mode. A snapshot locked in compliance mode cannot be unlocked by any user and can be deleted only after the lock duration expires. Users cannot shorten the lock duration, but users with the required RAM permissions can extend the lock duration at any time. When you lock a snapshot in compliance mode, you can optionally specify a cool-off period.

This parameter is required.', example='compliance', position='Query'),
  ownerAccount?: string(name='OwnerAccount', example='158704318252****', position='Query'),
  ownerId?: long(name='OwnerId', example='158704318252****', position='Query'),
  regionId: string(name='RegionId', description='The region ID. You can call the [DescribeRegions](https://www.alibabacloud.com/help/en/ecs/developer-reference/api-ecs-2014-05-26-describeregions) operation to query the most recent region list.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', example='158704318252****', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', example='158704318252****', position='Query'),
  snapshotId: string(name='SnapshotId', description='The snapshot ID.

This parameter is required.', example='s-9dp2qojdpdfmgfmf****', position='Query'),
}

model LockSnapshotResponseBody = {
  lockedSnapshotInfo?: {
    coolOffPeriod?: int32(name='CoolOffPeriod', description='The cool-off period in compliance mode. Unit: hours.', example='3'),
    coolOffPeriodExpiredTime?: string(name='CoolOffPeriodExpiredTime', description='The time when the cool-off period in compliance mode ends. The time follows the [ISO 8601](https://www.alibabacloud.com/help/en/ecs/developer-reference/iso-8601-time-format) standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC.', example='2025-10-15T13:00:00Z'),
    lockCreationTime?: string(name='LockCreationTime', description='The time when the snapshot was locked. The time follows the [ISO 8601](https://www.alibabacloud.com/help/en/ecs/developer-reference/iso-8601-time-format) standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC.', example='2025-10-15T10:00:00Z'),
    lockDuration?: int32(name='LockDuration', description='The lock duration. The snapshot lock automatically expires after the lock duration ends. Unit: days.', example='1'),
    lockDurationStartTime?: string(name='LockDurationStartTime', description='The time when the lock duration starts. The time follows the [ISO 8601](https://www.alibabacloud.com/help/en/ecs/developer-reference/iso-8601-time-format) standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC. 

If you lock a snapshot that is in the progressing state, the lock duration is calculated only after the snapshot enters the accomplished state.', example='2025-10-15T10:00:00Z'),
    lockExpiredTime?: string(name='LockExpiredTime', description='The time when the lock expires. The time follows the [ISO 8601](https://www.alibabacloud.com/help/en/ecs/developer-reference/iso-8601-time-format) standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC.', example='2025-10-16T10:00:00Z'),
    lockMode?: string(name='LockMode', description='The lock mode. Valid values: 
- compliance: the snapshot is locked in compliance mode. A snapshot locked in compliance mode cannot be unlocked by any user and can be deleted only after the lock duration expires. Users cannot shorten the lock duration, but users with the required RAM permissions can extend the lock duration at any time. When you lock a snapshot in compliance mode, you can optionally specify a cool-off period.', example='compliance'),
    lockStatus?: string(name='LockStatus', description='The lock status. Valid values: 
- compliance-cooloff: the snapshot is locked in compliance mode and is still in the cool-off period. The snapshot cannot be deleted, but users with the required RAM permissions can unlock the snapshot, extend or shorten the cool-off period, and extend or shorten the lock duration. 
- compliance: the snapshot is locked in compliance mode and the cool-off period has ended. The snapshot cannot be unlocked or deleted, but users with the required RAM permissions can extend the lock duration. 
- expired: the snapshot was locked, but the lock duration has ended and the lock has expired. The snapshot is not locked and can be deleted.', example='compliance-cooloff'),
    snapshotId?: string(name='SnapshotId', description='The snapshot ID.', example='s-9dp2qojdpdfmgfmf****'),
  }(name='LockedSnapshotInfo', description='The locked snapshot information.'),
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
