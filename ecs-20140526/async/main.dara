  instantAccessRetentionDays?: int32(name='InstantAccessRetentionDays', description='Settings for the retention period of the snapshot instant access feature. The snapshot is subject to automatic release when the retention period expires. This parameter takes effect only when `InstantAccess` is set to `true`. Unit: days. Valid values: 1 to 65535.

Default value: the value of the `RetentionDays` parameter.

> This parameter is deprecated. Standard snapshots for enterprise SSD disks (excluding standard SSD) have been upgraded to [active by default](https://help.aliyun.com/document_detail/193667.html). No additional configuration is required, and no extra costs are incurred.', example='1', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
