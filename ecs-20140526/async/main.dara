  instanceName?: string(name='InstanceName', description='The name of the instance. The name must be 2 to 128 characters in length and can contain letters and digits. It can also contain colons (:), underscores (_), periods (.), and hyphens (-). If this parameter is not specified, the default value is the instance ID.', example='k8s-node-[1,4]-alibabacloud', position='Query'),
  instanceType: string(name='InstanceType', description='The instance type.

