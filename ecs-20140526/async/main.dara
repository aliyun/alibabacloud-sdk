  - PL1: 20 to 65,536.
  - PL2: 461 to 65,536.
  - PL3: 1,261 to 65,536.
- cloud_auto: 1 to 65,536.
- cloud_essd_entry: 10 to 32,768.
- cloud_regional_disk_auto: 10 to 65,536.

This parameter is required.', example='60', position='Query'),
  sourceDiskId: string(name='SourceDiskId', description='The ID of the source cloud disk.

This parameter is required.', example='d-bp1d6tsvznfghy7y****', position='Query'),
  tag?: [ 
    {
      key?: string(name='Key', description='The tag key of the cloud disk. Valid values of N: 1 to 20. If you specify Tag.N.Key, it cannot be an empty string. The tag key can be up to 128 characters in length. It cannot start with aliyun or acs:, and cannot contain http:// or https://.', example='TestKey'),
      value?: string(name='Value', description='The tag value of the cloud disk. Valid values of N: 1 to 20. If you specify Tag.N.Value, it can be an empty string. The tag value can be up to 128 characters in length and cannot contain http:// or https://.', example='TestValue'),
