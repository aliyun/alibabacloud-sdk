  }(name='LogConfigDetails', description='The description of Simple Log Service.'),
  traceDetails?: {
    sample?: long(name='Sample', description='The sampling rate of Tracing Analysis.', example='10'),
    serviceId?: long(name='ServiceId', description='The ID of the SkyWalking service. This parameter is required if TraceType is set to SKYWALKING.', example='10458'),
    servicePort?: string(name='ServicePort', description='The port of the SkyWalking service. This parameter is required if TraceType is set to SKYWALKING.', example='80'),
