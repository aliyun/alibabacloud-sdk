/**
 * @summary Creates a service authentication rule.
 *
 * @param request AddAuthPolicyRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddAuthPolicyResponse
 */
@context("addAuthPolicyWithContext")
async function addAuthPolicyWithOptions(request: AddAuthPolicyRequest, runtime: $RuntimeOptions): AddAuthPolicyResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.acceptLanguage)) {
    query['AcceptLanguage'] = request.acceptLanguage;
  }
  if (!$isNull(request.appId)) {
    query['AppId'] = request.appId;
  }
  if (!$isNull(request.authRule)) {
    query['AuthRule'] = request.authRule;
  }
  if (!$isNull(request.authType)) {
    query['AuthType'] = request.authType;
  }
  if (!$isNull(request.enable)) {
    query['Enable'] = request.enable;
  }
  if (!$isNull(request.k8sNamespace)) {
    query['K8sNamespace'] = request.k8sNamespace;
  }
  if (!$isNull(request.name)) {
    query['Name'] = request.name;
  }
  if (!$isNull(request.namespace)) {
    query['Namespace'] = request.namespace;
  }
  if (!$isNull(request.protocol)) {
    query['Protocol'] = request.protocol;
  }
  if (!$isNull(request.region)) {
    query['Region'] = request.region;
  }
  if (!$isNull(request.source)) {
    query['Source'] = request.source;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddAuthPolicy',
    version = '2019-05-31',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Creates a service authentication rule.
 *
 * @param request AddAuthPolicyRequest
 * @return AddAuthPolicyResponse
 */
async function addAuthPolicy(request: AddAuthPolicyRequest): AddAuthPolicyResponse {
  var runtime = new $RuntimeOptions{};
  return addAuthPolicyWithOptions(request, runtime);
}

