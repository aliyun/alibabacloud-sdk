/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'mse';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('mse', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model GatewayDomain {
  certIdentifier?: string(name='CertIdentifier', description='The ID of the certificate in use.', example='595xx36-cn-hangzhou'),
  gatewayId?: long(name='GatewayId', description='The gateway ID.', example='1'),
  gatewayName?: string(name='GatewayName', description='The name of the gateway.', example='test'),
  gatewayUniqueId?: string(name='GatewayUniqueId', description='The unique ID of the gateway.', example='gw-c9bc5afd61014165bd58f621b491****'),
  gmtCreate?: string(name='GmtCreate', description='The time when the gateway was created.', example='2022-07-31 10:16:46'),
  gmtModified?: string(name='GmtModified', description='The time when the gateway was modified.', example='2022-08-11 15:28:47'),
  id?: long(name='Id', description='The domain ID.', example='36'),
  mustHttps?: string(name='MustHttps', description='Indicates whether HTTPS is forcibly used.', example='true'),
  name?: string(name='Name', description='The domain name.', example='test.com'),
  protocol?: string(name='Protocol', description='The domain protocol.', example='HTTPS'),
}

