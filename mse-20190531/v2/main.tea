            remainder?: int32(name='remainder', description='The percentage value field required for the percentage operation.', example='30'),
            rate?: int32(name='rate', description='The proportion rule. For example, 20% indicates that 20% of the traffic is routed to the node corresponding to the tag.', example='20'),
            type?: string(name='type', description='The type.', example='test'),
            name?: string(name='name', description='The name.', example='key'),
            value?: any(name='value', description='The value.', example='test'),
          }
        ](name='restItems', description='The list of matching conditions for REST requests.'),
        triggerPolicy?: string(name='triggerPolicy', description='The policy type.', example='CONTENT'),
        enable?: boolean(name='enable', description='Specifies whether the rule is enabled.', example='true'),
        appId?: string(name='appId', description='The ID of the application.', example='***@***'),
        priority?: int32(name='priority', description='The priority.', example='1'),
        tags?: [ string ](name='tags', description='The list of tags.'),
        paths?: [ string ](name='paths', description='The list of paths.'),
        path?: string(name='path', description='The path.', example='/hello'),
      }
    ](name='springcloud', description='The Spring Cloud rules.'),
    dubbo?: [ 
      {
        appId?: string(name='appId', description='The ID of the application.', example='***@***'),
        tags?: [ string ](name='tags', description='The list of tags.'),
        triggerPolicy?: string(name='triggerPolicy', description='The policy type.', example='CONTENT'),
        serviceName?: string(name='serviceName', description='The service name (interface).', example='HelloService'),
        group?: string(name='group', description='The Dubbo service group.', example='default'),
        version?: string(name='version', description='The Dubbo service version.', example='1.0.0'),
        methodName?: string(name='methodName', description='The method name of the Dubbo service.', example='hello'),
        paramTypes?: [ string ](name='paramTypes', description='The list of parameter types.'),
        condition?: string(name='condition', description='The logical operator used between the following items. Valid values: AND and OR.', example='AND'),
        argumentItems?: [ 
          {
            operator?: string(name='operator', description='The operator. A value of rawvalue indicates direct comparison. A value of mode indicates a modulo operation. A value of list indicates a whitelist.', example='rawvalue'),
            nameList?: [ string ](name='nameList', description='The list of names.'),
            datum?: string(name='datum', description='The value to be compared for operators such as rawvalue.', example='30'),
            cond?: string(name='cond', description='The comparison operator. Valid values: >=, <=, >, <, and ==.', example='=='),
            divisor?: int32(name='divisor', description='The divisor field required for the mod operator.', example='30'),
            remainder?: int32(name='remainder', description='The percentage value field required for the percentage operation.', example='30'),
            rate?: int32(name='rate', description='The proportion rule. For example, 20% indicates that 20% of the traffic is routed to the node corresponding to the tag.', example='10'),
            index?: int32(name='index', description='The position of the parameter, starting from 0.', example='0'),
            expr?: string(name='expr', description='The expression. See other field descriptions for details.'),
            value?: any(name='value', description='The value to compare. The value obtained from the expression is compared with this value. If the operator is a list whitelist, separate values with commas (,), such as 1,2,3.', example='1,2,3'),
          }
        ](name='argumentItems', description='The list of parameter content.'),
      }
    ](name='dubbo', description='The Dubbo rules.'),
  }(name='Rules', description='The rule information.'),
}

