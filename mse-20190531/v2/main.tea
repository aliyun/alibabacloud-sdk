/**
 * @summary Creates authorization information for gateway authentication.
 *
 * @param tmpReq AddAuthResourceRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddAuthResourceResponse
 */
@context("addAuthResourceWithContext")
async function addAuthResourceWithOptions(tmpReq: AddAuthResourceRequest, runtime: $RuntimeOptions): AddAuthResourceResponse {
  tmpReq.validate();
