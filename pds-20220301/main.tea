  disableDownload?: boolean(name='disable_download', description='Specifies whether to disable downloading of files in the share.', example='false'),
  disablePreview?: boolean(name='disable_preview', description='Specifies whether to disable previewing of files in the share.', example='false'),
  disableSave?: boolean(name='disable_save', description='Specifies whether to disable saving of files in the share.', example='false'),
