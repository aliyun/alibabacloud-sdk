model Domain {
  createdAt?: string(name='created_at', description='The time when the domain was created. The time is in the ISO 8601 format. Example: 2019-03-28T13:03:29.298Z.', example='2019-08-20T06:51:27.292Z'),
  dataHashName?: string(name='data_hash_name', description='The name of the algorithm that is used to calculate the data hash value.', example='sha1'),
  description?: string(name='description', description='The description of the domain.', example='my domain'),
  domainId?: string(name='domain_id', description='The ID of the domain.', example='bj2'),
  domainName?: string(name='domain_name', description='The name of the domain.', example='pdsdomain'),
  initDriveEnable?: boolean(name='init_drive_enable', description='Specifies whether to automatically create a default drive for each user when they first log on. The default value is false.', example='true'),
  initDriveSize?: long(name='init_drive_size', description='The size of the default drive in bytes. This parameter is required if `init_drive_enable` is set to `true`. The default value is `0`, which specifies that the drive is 0 bytes in size and files cannot be uploaded. To initialize the drive, set this parameter to a non-zero value. A value of -1 indicates an unlimited size.', example='1073741824'),
  parentDomainId?: string(name='parent_domain_id', description='The ID of the parent domain. If specified, the domain is a child domain. Otherwise, it is a standard domain.', example='bj1'),
  publishedAppAccessStrategy?: AppAccessStrategy(name='published_app_access_strategy', description='The access policy of applications.'),
  sharable?: boolean(name='sharable', description='Indicates whether sharing is enabled.'),
  sizeQuota?: long(name='size_quota', description='The total quota of all drives in the domain. A value of 0 indicates that the quota is unlimited.', example='1099511627776'),
  sizeQuotaUsed?: long(name='size_quota_used', description='The used quota of all drives.', example='1099511627776'),
  status?: long(name='status', description='The status of the domain. Valid values: 1: enabled. 2: being created. 6: expired.', example='1'),
  storeRedundancyType?: string(name='store_redundancy_type', description='The storage redundancy type.', example='LRS'),
  updatedAt?: string(name='updated_at', description='The time when the domain was last modified. The time is in the ISO 8601 format. Example: 2019-04-08T07:05:18.825Z.', example='2019-08-20T06:51:27.292Z'),
  usedSize?: long(name='used_size', description='The used logical space in bytes.', example='1099511627776'),
  userCountQuota?: long(name='user_count_quota', description='The quota of users.', example='50'),
}

