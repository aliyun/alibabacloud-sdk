  dirSizeInfo?: {
    dirCount?: long(name='dir_count', description='The total number of subfolders in the folder, calculated recursively.', example='1'),
    fileCount?: long(name='file_count', description='The total number of files in the folder, calculated recursively.', example='10'),
  }(name='dir_size_info', description='The statistics information of the folder. This parameter is returned when you call the list file or get file operation and include dir_size in the fields parameter.'),
  domainId?: string(name='domain_id', description='The domain ID.', example='bj1'),
  downloadUrl?: string(name='download_url', description='The download URL. The URL is valid for 15 minutes by default. If the URL expires, call the GetFile operation to obtain a new one.', example='https://data.aliyunpds.com/hz22%2F5d5b986facbec311ef844c25954f96821497b383%2F5d5b986f955410dd991646bb87c6b4e899eff525?Expires=xxx&OSSAccessKeyId=xxx&Signature=xxx'),
  driveId?: string(name='drive_id', description='The drive ID.', example='1'),
  fileExtension?: string(name='file_extension', description='The file name extension.', example='txt'),
  fileId?: string(name='file_id', description='The file ID.', example='5d79206586bb5dd69fb34c349282718146c55da7'),
  hidden?: boolean(name='hidden', description='Indicates whether the file is hidden.', example='false'),
  idPath?: string(name='id_path', description='The path of file IDs.', example='id1/id2'),
  imageMediaMetadata?: ImageMediaMetadata(name='image_media_metadata', description='The image information. This parameter is returned only if the image processing value-added service is enabled.'),
  labels?: [ string ](name='labels', description='The tags.', example='["label1:1", "label2:2"]'),
  localCreatedAt?: string(name='local_created_at', description='The local creation time of the file. This is the local time on the client at the moment of upload, which helps the client identify the local upload time.', example='2019-08-20T06:51:27.292Z'),
  localModifiedAt?: string(name='local_modified_at', description='The local modification time of the file. This is the local time on the client at the moment of upload, which helps the client identify the local update time.', example='2019-08-20T06:51:27.292Z'),
  name?: string(name='name', description='The name.', example='1.mov'),
  namePath?: string(name='name_path', description='The file path.', example='root/f1/f2'),
  parentFileId?: string(name='parent_file_id', description='The ID of the parent folder.', example='3d5b846942cf94fa72324c8a4bda34e81da635a'),
  revisionId?: string(name='revision_id', description='The revision ID. A new revision ID is generated when a file with the same file ID is overwritten.', example='5d5b846942cf94fa72324c14a4bda34e81da635d'),
  size?: long(name='size', description='If the object is a file, this parameter indicates the file size.

If the object is a folder, this parameter indicates the total size of all files within it. The size is calculated recursively. Note: The folder size is returned only when you include dir_size in the fields parameter of a list file or get file request.', example='1024'),
  starred?: boolean(name='starred', description='Indicates whether the file is starred.', example='false'),
  status?: string(name='status', description='The status. Only files and folders in the available state can be accessed. If a file is in the uploading state, the GetFile operation returns a "file not found" error, and the ListFile operation does not return the file.', example='available'),
  thumbnail?: string(name='thumbnail', description='The thumbnail URL. This parameter is deprecated. Use thumbnail_urls instead.', example='https://data.aliyunpds.com/hz22%2F5d5b986facbec311ef844c25954f96821497b383%2F5d5b986f955410dd991646bb87c6b4e899eff525?Expires=xxx&OSSAccessKeyId=xxx&Signature=xxx'),
  thumbnailUrls?: map[string]string(name='thumbnail_urls', description='The returned thumbnail information. The keys in this object correspond to the keys passed in the thumbnail_processes request parameter.'),
  trashedAt?: string(name='trashed_at', description='The time when the file was moved to the recycle bin.', example='2019-08-20T06:51:27.292Z'),
  type?: string(name='type', description='The type.', example='file'),
  updatedAt?: string(name='updated_at', description='The time when the file was last modified.', example='2019-08-20T06:51:27.292Z'),
  uploadId?: string(name='upload_id', description='The upload ID.', example='C9DCFE5A82644AC7A02DB74C30C934A6'),
  userTags?: map[string]string(name='user_tags', description='The custom tags.'),
  videoMediaMetadata?: VideoMediaMetadata(name='video_media_metadata', description='The audio and video information.'),
}

