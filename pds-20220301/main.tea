model IdentityToBenefitPkgMapping {
  benefitPkgComputationRule?: string(name='benefit_pkg_computation_rule', description='The rule for calculating the benefits within the package.

For a user-level benefit package, this parameter is empty. The effective benefit quota is calculated based only on the priority.

For a user-resource benefit package, this parameter can be empty or have a value. If a value is returned, the package is used to append the quota of existing benefits in other packages. This applies only to quota-based benefits. For example, if a user-level benefit package includes 10 GB of user storage capacity, you can define one or more user-resource benefit packages to increase the storage capacity for specific users.

Supported append rules include the following:

sum: If multiple packages have the same benefit, their values are added together.

max: If multiple packages have the same benefit, the maximum value is used.

min: If multiple packages have the same benefit, the minimum value is used.', example='sum'),
  benefitPkgId?: string(name='benefit_pkg_id', description='The ID of the benefit package.', example='40cb7794c9294'),
  benefitPkgName?: string(name='benefit_pkg_name', description='The name of the benefit package.', example='高级会员'),
  benefitPkgOwnerId?: string(name='benefit_pkg_owner_id', description='The ID of the benefit package owner.', example='bj1'),
  benefitPkgPriority?: long(name='benefit_pkg_priority', description='The priority of the benefit package.

For a user-level benefit package, a smaller value indicates a higher priority.', example='1'),
  benefitPkgType?: string(name='benefit_pkg_type', description='The type of the benefit package.

Valid values:

user_identity: A benefit package for user levels.

user_resource: A benefit package for user resources.', example='user_identity'),
  createdAt?: string(name='created_at', description='The time when the entity was associated with the benefit package.', example='2019-08-20T06:51:27.292Z'),
  deliveryInfoList?: [
    BenefitPkgDeliveryInfo
  ](name='delivery_info_list', description='A list of delivery information for the benefit package.'),
  identityId?: string(name='identity_id', description='The ID of the entity.', example='user123'),
  identityType?: string(name='identity_type', description='The type of the entity.', example='user'),
  updatedAt?: string(name='updated_at', description='The time when the association between the entity and the benefit package was last updated.', example='2019-08-20T06:51:27.292Z'),
}

