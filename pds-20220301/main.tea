  localModifiedAt?: string(name='local_modified_at', description='The local modification time of the file. Default value: empty. Format: yyyy-MM-ddTHH:mm:ssZ, in UTC+0 time zone.', example='2023-10-04T14:30:00Z'),
  name?: string(name='name', description='The file name. The name can be up to 1024 bytes in UTF-8 encoding and cannot contain forward slashes (/).

