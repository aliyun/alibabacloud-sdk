model BaseUserResponse {
  avatar?: string(name='avatar', description='The URL of the user\\\\"s avatar.', example='http://a.b.c/ccp.jpg'),
  createdAt?: string(name='created_at', description='The time the user account was created, formatted as a UNIX timestamp in milliseconds.', example='1567407718386'),
  creator?: string(name='creator', description='The entity that created the user account. For example, `system`.', example='system'),
  defaultDriveId?: string(name='default_drive_id', description='The ID of the user\\\\"s default drive.', example='123'),
  defaultLocation?: string(name='default_location', description='The default storage location for the user\\\\"s data.'),
  denyChangePasswordBySelf?: boolean(name='deny_change_password_by_self', description='Specifies if the user is prohibited from changing their own password. If `true`, the user cannot change their password.'),
  description?: string(name='description', description='The user\\\\"s custom description.', example='ccp team user'),
  domainId?: string(name='domain_id', description='The unique ID of the domain to which the user belongs.', example='hz999'),
  email?: string(name='email', description='The user\\\\"s primary email address.', example='123@ccp.com'),
  expiredAt?: long(name='expired_at', description='The time when the user account expires, specified as a UNIX timestamp in milliseconds. A value of `0` indicates the account never expires.', example='0'),
  isSync?: boolean(name='is_sync', description='Specifies if the user account is synchronized from an external source, such as Active Directory.'),
  lastLoginTime?: long(name='last_login_time', description='The time the user last logged in, specified as a UNIX timestamp in milliseconds.'),
  lastRefreshTokenTime?: long(name='last_refresh_token_time', description='The time when the user\\\\"s refresh token was last used, specified as a UNIX timestamp in milliseconds.'),
  needChangePasswordNextLogin?: boolean(name='need_change_password_next_login', description='Specifies if the user must change their password at the next login. If `true`, a password change is required.'),
  nickName?: string(name='nick_name', description='The user\\\\"s display name or nickname.', example='abc'),
  pathStatus?: string(name='path_status', description='The status of the user\\\\"s home directory. For example, `available`.'),
  permission?: map[string]IDPermission(name='permission', description='An array of permission strings for the corresponding key.'),
  phone?: string(name='phone', description='The user\\\\"s mobile phone number.', example='13700000000'),
  phoneRegion?: string(name='phone_region', description='The country calling code for the user\\\\"s mobile phone number. For example, `86` for China.'),
  role?: string(name='role', description='The user\\\\"s role. For example, `user` or `admin`.', example='user'),
  status?: string(name='status', description='The status of the user account. Valid values: `enabled` and `disabled`.', example='enabled'),
  updatedAt?: string(name='updated_at', description='The time the user account was last updated, formatted as a UNIX timestamp in milliseconds.', example='1567407718386'),
  userData?: map[string]any(name='user_data', description='A map of custom key-value pairs for storing additional user data.'),
  userId?: string(name='user_id', description='The user\\\\"s unique ID.', example='ccpuserid'),
  userName?: string(name='user_name', description='The user\\\\"s name.', example='name'),
}

