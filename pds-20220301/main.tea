  expiration?: string(name='expiration', description='The expiration time. The value is in RFC 3339 format, for example, "2020-06-28T11:33:00.000+08:00". An empty string ("") indicates that the share never expires.', example='2020-06-28T11:33:00.000+08:00'),
  expired?: boolean(name='expired', description='Indicates whether the share has expired.', example='false'),
  fileIdList?: [ string ](name='file_id_list', description='The list of file IDs in the shared parent path.', example='["520b217f13adf4fc24f2191991b1664ce045b393"]'),
  officeEditable?: boolean(name='office_editable', description='Specifies whether online editing of shared documents is allowed.', example='true'),
