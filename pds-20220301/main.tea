  saveCount?: long(name='save_count', description='The number of times the share has been saved.', example='2'),
  saveDownloadLimit?: long(name='save_download_limit', description='The maximum total number of times the share can be saved and downloaded.', example='100'),
  saveLimit?: long(name='save_limit', description='The maximum number of times the share can be saved.', example='100'),
  shareAllFiles?: boolean(name='share_all_files', description='Indicates whether all files in the drive are shared.', example='true'),
  shareId?: string(name='share_id', description='The share ID.', example='7JQX1FswpQ8'),
  shareName?: string(name='share_name', description='The share name. By default, the name of the first file is used.', example='video-1.MP4'),
  sharePwd?: string(name='share_pwd', description='The extraction code, which is 0 to 64 characters in length. A length of 0 indicates that no extraction code is set.', example='abcF123x'),
  status?: string(name='status', description='The status of the share. Valid values:
- disabled: Canceled.
- enabled: Active.', example='enabled'),
