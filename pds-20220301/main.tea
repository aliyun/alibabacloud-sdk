/**
 *
 */
import Util;
import GatewayClient;
import OpenApi;
import OpenApiUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @productId = 'pds';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @disableHttp2 = true;
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-zhangjiakou' = 'cn-zhangjiakou.admin.aliyunpds.com',
    'cn-shenzhen' = 'cn-shenzhen.admin.aliyunpds.com',
    'cn-shanghai' = 'cn-shanghai.admin.aliyunpds.com',
    'cn-hongkong' = 'cn-hongkong.admin.aliyunpds.com',
    'cn-hangzhou' = 'cn-hangzhou.admin.aliyunpds.com',
    'cn-guangzhou' = 'cn-guangzhou.admin.aliyunpds.com',
    'cn-beijing' = 'cn-beijing.admin.aliyunpds.com',
    'ap-southeast-5' = 'ap-southeast-5.admin.aliyunpds.com',
    'ap-southeast-1' = 'ap-southeast-1.admin.aliyunpds.com',
    'eu-central-1' = 'eu-central-1.admin.aliyunpds.com',
    'us-west-1' = 'us-west-1.admin.aliyunpds.com',
  };
}

model AccountAccessTokenResponse {
  accessToken?: string(name='access_token'),
  avatar?: string(name='avatar'),
  defaultDriveId?: string(name='default_drive_id'),
  defaultSboxDriveId?: string(name='default_sbox_drive_id'),
  deviceId?: string(name='device_id'),
  deviceName?: string(name='device_name'),
  domainId?: string(name='domain_id'),
  existLink?: [
    LinkInfo
  ](name='exist_link'),
  expireTime?: string(name='expire_time'),
  expiresIn?: long(name='expires_in'),
  isFirstLogin?: boolean(name='is_first_login'),
  needLink?: boolean(name='need_link'),
  needRpVerify?: boolean(name='need_rp_verify'),
  nickName?: string(name='nick_name'),
  pathStatus?: string(name='path_status'),
  pinSetup?: boolean(name='pin_setup'),
  refreshToken?: string(name='refresh_token'),
  role?: string(name='role'),
  state?: string(name='state'),
  status?: string(name='status'),
  tokenType?: string(name='token_type'),
  userData?: map[string]string(name='user_data'),
  userId?: string(name='user_id'),
  userName?: string(name='user_name'),
}

model AccountLinkInfo {
  authenticationType?: string(name='authentication_type', description='The account type. Valid values:

- mobile: mobile phone number
- email: email address
- ding: DingTalk
- ram: Alibaba Cloud RAM user
- wechat: WeCom
- ldap: LDAP account
- custom: custom account', example='mobile'),
  createdAt?: long(name='created_at', description='The time when the account was created. The value is a millisecond-level UNIX timestamp starting from January 1, 1970, 00:00:00.', example='1639762579768'),
  displayName?: string(name='display_name', description='The display name of the account. This name is displayed on the user interface. For example, the unique identifier of an LDAP account is the UID, but the name displayed to the user can be an employee ID or other information.', example='001'),
  domainId?: string(name='domain_id', description='The domain ID.', example='bj1'),
  extra?: string(name='extra', description='The additional information of the account. When the account type is mobile phone number, this field indicates the country code. For example, the country code for the Chinese mainland is 86. Currently, this field is returned only for mobile phone numbers.', example='86'),
  identity?: string(name='identity', description='The unique identifier of the account.', example='136***000'),
  lastLoginTime?: long(name='last_login_time', description='The last time the account was used to log on. The value is a millisecond-level UNIX timestamp starting from January 1, 1970, 00:00:00.', example='1639762579769'),
  status?: string(name='status', description='The account status.', example='normal'),
  userId?: string(name='user_id', description='The user ID that corresponds to the account.', example='00016a587b62b50003deea299a4f5b50'),
}

