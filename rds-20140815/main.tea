  preferredBackupTime?: string(name='PreferredBackupTime', description='The time at which to perform a backup task. Format: <i>HH:mm</i>Z-<i>HH:mm</i>Z (UTC).

> * This parameter is required when **BackupPolicyMode** is set to **DataBackupPolicy**.
> * This parameter takes effect only when **BackupPolicyMode** is set to **DataBackupPolicy**.', example='00:00Z-01:00Z'),
  releasedKeepPolicy?: string(name='ReleasedKeepPolicy', description='The archived backup data retention policy for deleted **MySQL** instances. Valid values:
