      category?: string(name='Category', description='The type of the data cloud disk. Valid values:

- **cloud_efficiency**: ultra cloud disk.
- **cloud_ssd**: standard SSD.
- **cloud_essd** (default): ESSD.
- **cloud_auto**: premium performance disk.', example='cloud_essd'),
