  connectionString?: string(name='ConnectionString', description='The internal endpoint of the instance.', example='rm-uf6wjk5****.mysql.rds.aliyuncs.com'),
  DBInstanceId?: string(name='DBInstanceId', description='The instance ID. If the **Amount** parameter is set to a value greater than **1**, the number of instance IDs returned corresponds to the value, separated by commas.

For example, if the **Amount** parameter is set to **3**, three instance IDs are returned. Example:
`rm-uf6wjk5*****1, rm-uf6wjk5*****2, rm-uf6wjk5*****3`', example='rm-uf6wjk5****'),
  dryRun?: boolean(name='DryRun', description='Indicates whether the current request requires a precheck before creating the instance.

