model ModifyDBProxyEndpointRequest {
  causalConsistReadTimeout?: string(name='CausalConsistReadTimeout', description='The timeout period for read consistency. Unit: milliseconds. Default value: **10**. Valid values: **0** to **60000**.', example='10', position='Query'),
  configDBProxyFeatures?: string(name='ConfigDBProxyFeatures', description='Specifies the proxy features to be enabled for the proxy endpoint. Separate multiple features with semicolons (;). Format: `Feature 1:Status;Feature 2:Status;...`. Do not add a semicolon (;) at the end.

Valid values for features:
* **ReadWriteSpliting**: Read/write splitting.
* **ConnectionPersist**: Connection pool.
* **TransactionReadSqlRouteOptimizeStatus**: Transaction splitting.
* **AZProximityAccess**: Nearest access.
* **CausalConsistRead**: Read consistency.
* **HtapFilter**: Automatic request distribution among row store and column store nodes for HTAP.

Valid values for the status:
* **1**: The feature is enabled.
* **0**: The feature is disabled.

> - ApsaraDB RDS for PostgreSQL supports only **ReadWriteSpliting**.
> - The nearest access feature is supported only by dedicated database proxies for MySQL.', example='ReadWriteSpliting:1;ConnectionPersist:0', position='Query'),
  DBInstanceId: string(name='DBInstanceId', description='The instance ID. You can call the DescribeDBInstances operation to query the ID.

This parameter is required.', example='rm-bp145737x5bi6****', position='Query'),
  DBProxyEndpointId?: string(name='DBProxyEndpointId', description='The ID of the proxy endpoint. You can call the DescribeDBProxyEndpoint operation to query the ID.

> - MySQL: This parameter is required when **DbEndpointOperator** is set to **Delete** or **Modify**.
> - PostgreSQL: This parameter is required when **DbEndpointOperator** is set to **Delete**, **Modify**, or **Create**.', example='gos787jog2wk0y****', position='Query'),
  DBProxyEngineType?: string(name='DBProxyEngineType', description='**[Deprecated]** This parameter is deprecated and does not need to be configured.', example='normal', position='Query'),
  dbEndpointAliases?: string(name='DbEndpointAliases', description='The description of the proxy endpoint.', example='test-proxy', position='Query'),
  dbEndpointCostThresholdForDuckdb?: string(name='DbEndpointCostThresholdForDuckdb', description='The execution cost threshold for SQL statements in automatic request distribution among row store and column store nodes for HTAP.', example='30000', position='Query'),
  dbEndpointMinSlaveCount?: string(name='DbEndpointMinSlaveCount', description='The minimum number of reserved instances.', example='2', position='Query'),
  dbEndpointOperator?: string(name='DbEndpointOperator', description='The operation type. Valid values:
* **Modify**: Modifies the proxy endpoint. This is the default value.
* **Create**: Creates a proxy endpoint.
* **Delete**: Deletes a proxy endpoint.', example='Modify', position='Query'),
  dbEndpointReadWriteMode?: string(name='DbEndpointReadWriteMode', description='The read/write mode. Valid values:
* **ReadWrite**: Connects to the primary instance and can accept write requests.
* **ReadOnly**: Does not connect to the primary instance and cannot accept write requests. This is the default value.

> * This parameter is required when **DbEndpointOperator** is set to **Create**.
> * For an ApsaraDB RDS for MySQL instance, if you change the value of this parameter from **ReadWrite** to **ReadOnly**, the transaction splitting feature is disabled.', example='ReadWrite', position='Query'),
  dbEndpointType?: string(name='DbEndpointType', description='The type of the proxy endpoint. This parameter is reserved and does not need to be specified.', example='RWSplit', position='Query'),
  effectiveSpecificTime?: string(name='EffectiveSpecificTime', description='The specific time when the modification takes effect. Specify the time in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format. The time must be in UTC.
> This parameter is required when **EffectiveTime** is set to **SpecificTime**.', example='2023-05-06T07:08:09Z', position='Query'),
  effectiveTime?: string(name='EffectiveTime', description='The effective period. Valid values:

* **Immediate**: The modification immediately takes effect.
* **MaintainTime**: The modification takes effect within the maintenance window. For more information, see ModifyDBInstanceMaintainTime.
* **SpecificTime**: The modification takes effect at a specified time.

Default value: **MaintainTime**.', example='MaintainTime', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  readOnlyInstanceDistributionType?: string(name='ReadOnlyInstanceDistributionType', description='The read weight allocation pattern. Valid values:

* **Standard**: Automatically allocates read weights based on instance specifications. This is the default value.
* **Custom**: Custom allocated weights.

> This parameter is required only when read/write splitting is enabled. For more information about the read weight allocation pattern, see [Read weight distribution](https://help.aliyun.com/document_detail/96076.html) for MySQL and [Enable and configure the database proxy service](https://help.aliyun.com/document_detail/418272.html) for PostgreSQL.', example='Standard', position='Query'),
  readOnlyInstanceMaxDelayTime?: string(name='ReadOnlyInstanceMaxDelayTime', description='The maximum latency threshold for read-only instances in read/write splitting. If the latency of a read-only instance exceeds this threshold, read traffic is not routed to the instance. Unit: seconds. If you do not specify this parameter, the original value is retained. Valid values: **0** to **3600**.

> - This parameter is required only when read/write splitting is enabled.
> - Default value: **30** when the read/write attribute is set to Read/Write (read/write splitting), and **-1** (disabled) when the read/write attribute is set to Read-only.', example='30', position='Query'),
  readOnlyInstanceWeight?: string(name='ReadOnlyInstanceWeight', description='The custom read weights of the primary and read-only instances. The weight must be a multiple of 100 and cannot exceed 10000. Format:

- Standard instance: `{"Primary instance ID":"Weight","Read-only instance ID":"Weight"...}`

    Example: `{"rm-uf6wjk5****":"500","rr-tfhfgk5xxx":"200"...}`
- ApsaraDB RDS for MySQL Cluster Edition instance: `{"Read-only instance ID":"Weight","DBClusterNode":{"Primary node ID":"Weight","Secondary node ID":"Weight","Secondary node ID":"Weight"...}}`

    Example: `{"rr-tfhfgk5****":"200","DBClusterNode":{"rn-2z****":"0","rn-2z****":"400","rn-2z****":"400"...}}`
    > **DBClusterNode** is a request parameter specific to Cluster Edition instances. It contains the **NodeID** and **Weight** of the primary and secondary nodes.', example='{"rm-uf6wjk5****":"500","rr-tfhfgk5xxx":"200"...}', position='Query'),
  regionId?: string(name='RegionId', description='The region ID. You can call the DescribeRegions operation to query the ID.', example='cn-hangzhou', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  vSwitchId?: string(name='VSwitchId', description='The ID of the vSwitch in the zone of the database proxy endpoint. Default value: the ID of the vSwitch that corresponds to the default endpoint of the proxy instance. You can call the DescribeVSwitches operation to query created vSwitches.', example='vsw-uf6adz52c2p****', position='Query'),
  vpcId?: string(name='VpcId', description='The ID of the VPC in the zone of the database proxy endpoint. Default value: the ID of the VPC that corresponds to the default endpoint of the proxy instance. You can call the DescribeDBInstanceAttribute operation to query the default VPC of the instance.', example='vpc-2zeusejj******', position='Query'),
}

