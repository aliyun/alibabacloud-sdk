model AttachRCDiskRequest {
  deleteWithInstance?: boolean(name='DeleteWithInstance', description='Specifies whether to release the cloud disk when the instance is released. Valid values:

- true: The cloud disk is released.
- false: The cloud disk is not released. The cloud disk is retained and converted to a pay-as-you-go data cloud disk.

Default value: false.

When you configure this parameter, take note of the following items:

If you set DeleteWithInstance to false and the instance is locked for security reasons (the "LockReason" : "security" attribute is included in OperationLocks), the cloud disk is released along with the instance regardless of this parameter setting.

If the cloud disk you want to attach is an elastic ephemeral disk, you must set DeleteWithInstance to true.

This parameter cannot be configured for cloud disks that have the multi-attach feature enabled.', example='false', position='Query'),
  diskId: string(name='DiskId', description='The ID of the cloud disk to be attached. The cloud disk (DiskId) and the instance (InstanceId) must be in the same zone.

This parameter is required.', example='rcd-wz98hnpj2sjo85zc7t2w', position='Query'),
  instanceId: string(name='InstanceId', description='The ID of the destination RDS Custom instance.

This parameter is required.', example='rc-dh2jf9n6j4s14926****', position='Query'),
  regionId?: string(name='RegionId', description='The region ID.', example='cn-hangzhou', position='Query'),
}

model AttachRCDiskResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='C19D1668-70CB-5421-AA91-D6D8EE3AB664'),
}

model AttachRCDiskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachRCDiskResponseBody(name='body'),
}

/**
  * @description When you call this operation, take note of the following items:
  * - The cloud disk must be in the Available state.
  * - When you attach a data cloud disk:
  *   - The destination RDS Custom instance must be in the Running or Stopped state.
  *   - If the cloud disk was purchased separately, its billing method must be pay-as-you-go.
  *   - If a system cloud disk detached from an RDS Custom instance is attached as a data cloud disk, its billing method is not limited.
  *   - Once an elastic ephemeral disk is detached, it can only be reattached to its original instance.
  * - When you attach a system cloud disk:
  *   - The destination RDS Custom instance must be the source instance from which the system cloud disk was detached.
  *   - The destination RDS Custom instance must be in the Stopped state.
  *   - You must configure the instance logon credentials.
  *   - Elastic ephemeral disks cannot be attached as system cloud disks.
  * @param request  the request parameters of AttachRCDisk  AttachRCDiskRequest
  * @return AttachRCDiskResponse
 */
async function attachRCDisk(request: AttachRCDiskRequest): AttachRCDiskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AttachRCDisk', 'POST', '/', 'json', false, 'json', request);
}

model AttachRCInstancesRequest {
