  effectiveTime?: string(name='EffectiveTime', description='The effective period. This parameter is only supported for instances in a dedicated cluster. Valid values:

* **Immediate**: The changes take effect immediately.
* **MaintainTime**: The changes take effect within the maintenance window. For more information, see ModifyDBInstanceMaintainTime.
* **SpecificTime**: The changes take effect at a specified time.

Default value: MaintainTime.', example='Immediate', position='Query'),
  engineVersion?: string(name='EngineVersion', description='The database engine version. This parameter is only supported for instances in a dedicated cluster.', example='5.7', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
