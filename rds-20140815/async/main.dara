  switchTime: string(name='SwitchTime', description='The scheduled switchover time to set. Specify the time in the yyyy-MM-ddTHH:mm:ssZ format (UTC).

> The time cannot be later than the latest operation time. You can call DescribeActiveOperationTasks and check the value of the Deadline response parameter to obtain the latest operation time.

This parameter is required.', example='2019-10-17T18:50:00Z', position='Query'),
}

