  targetDedicatedHostIdForLog?: string(name='TargetDedicatedHostIdForLog', description='**[Deprecated]** This parameter is deprecated and does not need to be specified.', example='dh-bp****', position='Query'),
  targetDedicatedHostIdForMaster?: string(name='TargetDedicatedHostIdForMaster', description='The ID of the destination host for the primary node. This parameter is only supported for instances in a dedicated cluster.

