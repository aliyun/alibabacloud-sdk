  DBInstanceStorageType?: string(name='DBInstanceStorageType', description='The storage type of the destination instance. Valid values:
> We recommend that you keep the storage type consistent with that of the source instance.
<details>
<summary>ApsaraDB RDS for MySQL</summary>

- local_ssd: Premium Local SSD (default)
- cloud_essd: PL1 ESSD
- cloud_essd2: PL2 ESSD
- cloud_essd3: PL3 ESSD
- cloud_ssd: standard SSD (discontinued)
</details>

<details>
<summary>ApsaraDB RDS for SQL Server</summary>

- cloud_essd: PL1 ESSD
- cloud_essd2: PL2 ESSD
- cloud_essd3: PL3 ESSD
- local_ssd: Premium Local SSD (discontinued)
- cloud_ssd: standard SSD (discontinued)

</details>

<details>
<summary>ApsaraDB RDS for PostgreSQL</summary>

- cloud_essd: PL1 ESSD
- cloud_essd2: PL2 ESSD
- cloud_essd3: PL3 ESSD
- local_ssd: Premium Local SSD (discontinued)
- cloud_ssd: standard SSD (discontinued)

</details>', example='local_ssd', position='Query'),
  encryptionKey?: string(name='EncryptionKey', description='The ID of the custom key used for cloud disk encryption of the **SQL Server instance**. If you specify this parameter, cloud disk encryption is enabled and cannot be disabled. You must also specify the **RoleARN** parameter.
You can view service key ID in service key Management Service (KMS) console or [create a key](https://help.aliyun.com/document_detail/181610.html).

> You can also choose not to specify this parameter and only specify the **RoleARN** parameter. This sets the cloud disk encryption type of the instance to the default service customer master key (CMK) managed by ApsaraDB RDS.', example='749c1df7-****-****-****-****', position='Query'),
  engine: string(name='Engine', description='The type of the destination database engine. Valid values:
* **MySQL**
* **SQLServer**
* **PostgreSQL**

This parameter is required.', example='MySQL', position='Query'),
  engineVersion: string(name='EngineVersion', description='The version of the destination database engine. Valid values vary based on the **Engine** parameter:
- MySQL: **5.5/5.6/5.7/8.0**
- SQL Server: **2008r2 (Premium Local SSD, discontinued)/08r2_ent_ha (Cloud disk edition, discontinued)/2012/2012_ent_ha/2012_std_ha/2012_web/2014_std_ha/2016_ent_ha/2016_std_ha/2016_web/2017_std_ha/2017_ent/2019_std_ha/2019_ent**
- PostgreSQL: **10.0/11.0/12.0/13.0/14.0/15.0**

> For SQL Server instances, `_ent` indicates Enterprise Cluster Edition, `_ent_ha` indicates Enterprise Edition, `_std_ha` indicates Standard Edition, and `_web` indicates Web Edition.

This parameter is required.', example='5.6', position='Query'),
  instanceNetworkType?: string(name='InstanceNetworkType', description='The network type of the destination instance. Valid values:

* **VPC**: VPC
* **Classic**: classic network (discontinued)

> If you select **VPC**, you must also specify the **VpcId** and **VSwitchId** parameters.', example='Classic', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  payType: string(name='PayType', description='The billing method of the destination instance. Valid values:
* **Postpaid**: pay-as-you-go
* **Prepaid**: subscription

This parameter is required.', example='Prepaid', position='Query'),
  period?: string(name='Period', description='Specifies the subscription period of the destination instance as yearly or monthly. Valid values:
* **Year**: yearly
* **Month**: monthly

> This parameter is required when the billing method is set to **Prepaid**.', example='Year', position='Query'),
  privateIpAddress?: string(name='PrivateIpAddress', description='The internal IP address of the destination instance. The IP address must be within the CIDR block of the specified vSwitch. By default, the system automatically allocates an IP address based on the **VPCId** and **VSwitchId** parameters.', example='172.XX.XX.69', position='Query'),
  regionId: string(name='RegionId', description='The ID of the destination region. You can call the DescribeRegions operation to query region IDs.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The ID of the resource group.', example='rg-acfmy****', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  restoreTime?: string(name='RestoreTime', description='The point in time to which you want to restore data. The time must be earlier than the current time. Specify the time in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format. The time must be in UTC.
> This parameter is required when **RestoreType** is set to **BackupTime**.', example='2019-05-30T03:29:10Z', position='Query'),
  restoreType: string(name='RestoreType', description='The restoration method. Valid values:

- **BackupSet**: restores data from a backup set to the new instance. You must also specify the **BackupSetId** parameter.
- **BackupTime**: restores data to a specific point in time within the log backup retention period. You must also specify the **RestoreTime**, **SourceRegion**, and **SourceDBInstanceName** parameters.

This parameter is required.', example='BackupSet', position='Query'),
  roleARN?: string(name='RoleARN', description='The Alibaba Cloud Resource Name (ARN) used for the authorization of the Alibaba Cloud account to grant the ApsaraDB RDS service account access to KMS for the **SQL Server instance**. You can call the [CheckCloudResourceAuthorized](https://help.aliyun.com/document_detail/2628797.html) operation to query the ARN.', example='acs:ram::1406****:role/aliyunrdsinstanceencryptiondefaultrole', position='Query'),
  securityIPList: string(name='SecurityIPList', description='The [IP address whitelist](https://help.aliyun.com/document_detail/43185.html) of the destination instance. Separate multiple IP addresses with commas (,). You can add up to 1,000 unique IP addresses. The following formats are supported:
* IP address format. Example: 10.23.12.24.
* CIDR block format. Example: 10.23.12.24/24 (Classless Inter-Domain Routing, where 24 indicates the length of the prefix in the IP address, and the prefix length ranges from 1 to 32).

This parameter is required.', example='127.0.0.1', position='Query'),
  sourceDBInstanceName?: string(name='SourceDBInstanceName', description='The ID of the source instance for point-in-time restoration.
> This parameter is required when **RestoreType** is set to **BackupTime**.', example='rm-uf6wjk5****', position='Query'),
  sourceRegion?: string(name='SourceRegion', description='The ID of the source region for point-in-time restoration.
> This parameter is required when **RestoreType** is set to **BackupTime**.', example='cn-hangzhou', position='Query'),
  systemDBCharset?: string(name='SystemDBCharset', description='The character set of the destination instance. Valid values:
* **utf8**
* **gbk**
* **latin1**
* **utf8mb4**', example='uft8', position='Query'),
  usedTime?: string(name='UsedTime', description='The subscription duration. Valid values:
* If the **Period** parameter is set to **Year**, valid values are **1 to 3**.
* If the **Period** parameter is set to **Month**, valid values are **1 to 9**.

> This parameter is required when the billing method is set to **Prepaid**.', example='2', position='Query'),
  VPCId?: string(name='VPCId', description='The VPC ID of the destination instance.

> - This parameter is required when **InstanceNetworkType** is set to **VPC**.
> - After you specify this parameter, you must also specify the **ZoneId** parameter.', example='vpc-****', position='Query'),
  vSwitchId?: string(name='VSwitchId', description='The vSwitch ID of the destination instance. Separate multiple vSwitch IDs with commas (,).

> - This parameter is required when **InstanceNetworkType** is set to **VPC**.
> - After you specify this parameter, you must also specify the **ZoneId** parameter.', example='vsw-****', position='Query'),
  zoneId?: string(name='ZoneId', description='The zone ID of the destination instance. Separate multiple zone IDs with colons (:).

> If you specify a VPC and a vSwitch, this parameter is required to match the zone of the vSwitch.', example='cn-hangzhou-b', position='Query'),
}

