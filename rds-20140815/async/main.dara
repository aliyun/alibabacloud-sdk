model ImportUserBackupFileRequest {
  backupFile?: string(name='BackupFile', description='The JSON array that describes the information about the backup file in the OSS bucket. Example:
`{"Bucket":"test", "Object":"test/test_db_employees.xb","Location":"ap-southeast-1"}`

Parameters in the array:
* **Bucket**: the name of the OSS bucket where the backup file is stored. You can call the [GetBucket](https://help.aliyun.com/document_detail/31965.html) operation to query the name.
* **Object**: the detailed path of the directory where the backup file is stored. You can call the [GetObject](https://help.aliyun.com/document_detail/31980.html) operation to query the path.
* **Location**: the region ID of the OSS bucket. You can call the [GetBucketLocation](https://help.aliyun.com/document_detail/31967.html) operation to query the region ID.

This parameter is required when **Mode** is set to **oss**. For **Location**, specify the region ID of the OSS bucket. You can call the GetBucketLocation operation to query the region ID.', example='{"Bucket":"test", "Object":"test/test_db_employees.xb","Location":"ap-southeast-1"}', position='Query'),
  bucketRegion?: string(name='BucketRegion', description='The region ID of the OSS bucket where the backup file of the self-managed MySQL 5.7 database is stored. You can call the DescribeRegions operation to query the most recent region list.', example='cn-hangzhou', position='Query'),
  buildReplication?: boolean(name='BuildReplication', description='Specifies whether to automatically set up replication. Valid values:
- true: yes. The MasterInfo parameter is required.
- false: no.

> This parameter takes effect only for native replication instances. You must specify the DBInstanceId parameter when you call this operation.', example='true', position='Query'),
  comment?: string(name='Comment', description='The description of the user backup to be imported.', example='BackupTest', minLength=2, maxLength=256, position='Query'),
  DBInstanceId?: string(name='DBInstanceId', description='The instance ID.', example='rm-uf6wjk5****', position='Query'),
  engineVersion?: string(name='EngineVersion', description='The version of the MySQL database. Valid values: **5.7** and **8.0**.', example='5.7', position='Query'),
  masterInfo?: string(name='MasterInfo', description='The case-sensitive JSON array that provides the master information for setting up MySQL replication. Example:

```
{"masterIp":"172.20.xx.xx","masterPort":"3306","masterUser":"replica","masterPassword":"W33uopkehBQ="}
```

Parameters in the array:
- masterIp: the IP address of the primary database.
- masterPort: the port of the primary database.
- masterUser: the replication account of the primary database.
- masterPassword: the password of the replication account of the primary database. The password must be Base64-encoded.

> This parameter takes effect only for native replication instances. You must specify the DBInstanceId parameter when you call this operation.', example='{"masterIp":"172.20.xx.xx","masterPort":"3306","masterUser":"replica","masterPassword":"W33uopkehBQ="}', position='Query'),
  mode?: string(name='Mode', description='The import mode. Valid values:

- oss: downloads the backup from OSS and imports it.
- stream: imports the backup over the network.', example='oss', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the ApsaraDB RDS instance. You can call the DescribeRegions operation to query the most recent region list.

> * The value of this parameter is the region ID where you want to create the ApsaraDB RDS instance.
> * The value must be the same as the value of the **BucketRegion** parameter.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID. You can call the DescribeDBInstanceAttribute operation to query the resource group ID.', example='rg-acfmy****', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  restoreSize?: int32(name='RestoreSize', description='The storage space required to restore the user backup. Unit: GB.

> * The default value is five times the size of the backup file.
> * The minimum value is 20.', example='20', position='Query'),
  retention?: int32(name='Retention', description='The retention period of the user backup file. Unit: days. The value must be an integer greater than **0**.', example='30', position='Query'),
  sourceInfo?: string(name='SourceInfo', description='The case-sensitive JSON array that provides the source information of the full backup. Example:

```
{"sourceIp":"172.20.xx.xx","sourcePort":"9999"}
```

Parameters in the array:

- sourceIp: the source IP address.

- sourcePort: the port listened by Netcat on the source.

> This parameter takes effect only for native replication instances. You must specify the DBInstanceId parameter when you call this operation.', example='{"sourceIp":"172.20.xx.xx","sourcePort":"9999"}', position='Query'),
  zoneId?: string(name='ZoneId', description='The zone ID. You can call the DescribeRegions operation to query the most recent zone list.

> * After you specify a zone, the system creates a snapshot within seconds in the zone, which significantly reduces the time required to import the backup.
> * When you call the CreateDBInstance operation to create an instance by using the user backup, the instance is created in this zone.', example='cn-hangzhou-b', position='Query'),
}

