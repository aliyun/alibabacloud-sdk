init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'bailian';
  @version = '2023-12-29';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddCategoryRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  workspaceId: string(name='WorkspaceId', description='The workspace ID. The category is created in this workspace. For more information about how to obtain the workspace ID, see [How to use a workspace](https://help.aliyun.com/document_detail/2587495.html). The bailian 2023-12-29 version does not provide an API for listing workspaces. Obtain the workspace ID from the Model Studio console before calling this operation.

This parameter is required.', example='llm-3z7uw7fwz0vxxxx', position='Path'),
  categoryName: string(name='CategoryName', description='The category name. The name must be 1 to 20 characters in length and can contain characters in the Unicode letter category, including letters, Chinese characters, and digits. The name can also contain colons (:), underscores (_), periods (.), or hyphens (-).

This parameter is required.', example='ProductList', position='Body'),
  categoryType: string(name='CategoryType', description='The category type. Valid values:
- UNSTRUCTURED: category.

This parameter is required.', example='UNSTRUCTURED', position='Body'),
  connectorId?: string(name='ConnectorId', description='The instance ID of the data connector (Connector). Obtain this value from the Model Studio console.', example='conn_xxxx', position='Body'),
  parentCategoryId?: string(name='ParentCategoryId', description='The ID of the parent category. The new category is created under this parent category. If this parameter is left empty, a first-level category is created.', example='cate_cdd11b1b79a74e8bbd675c356a91ee3xxxxxxxx', position='Body'),
}

