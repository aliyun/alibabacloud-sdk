type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'CsasEdr';
  @version = '2024-11-22';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CreateClientRuleStrategyRequest {
  actionType: int32(name='ActionType', description='The action of the policy. Valid values:
- **0**: monitor mode.
- **1**: block startup.
- **2**: Block Mode.
Valid values for custom rules of proactive defense (PolicyType=2):
- **0**: add to allowlist and allow.
- **1**: add to blocklist and block.

This parameter is required.', example='1', position='Query'),
  allGroup?: int32(name='AllGroup', description='Specifies whether the policy takes effect for all user groups. Valid values:
- **0**: no.
- **1**: yes.', example='1', position='Query'),
  approvalId?: string(name='ApprovalId', description='The ID of the reporting and approval process.', example='approval-b567d830cd17674c', position='Query'),
  cmdline?: string(name='Cmdline', description='The matched process command line.', example='C:\\\\Windows\\\\System32\\\\RuntimeBroker.exe -Embedding', position='Query'),
  description?: string(name='Description', description='The description of the policy.
> The maximum length is 128 characters.', example='test', position='Query'),
  excludeUserNameList?: [ string ](name='ExcludeUserNameList', description='The list of usernames for which the policy does not take effect.', shrink='json', position='Query'),
  filePath?: string(name='FilePath', description='The matched file path.', example='C:\\\\Program Files\\\\Example\\\\example.exe', position='Query'),
  inSwitch?: boolean(name='InSwitch', description='The inbound network switch.', example='true', position='Query'),
  includeGroupIdList?: [ string ](name='IncludeGroupIdList', description='The list of IDs of the user groups for which the policy takes effect.', shrink='json', position='Query'),
  ip?: string(name='Ip', description='The matched IP address.', example='192.0.2.1', position='Query'),
  mainButtonTextCh?: string(name='MainButtonTextCh', description='The text of the primary button in the Chinese button configuration.', example='test', position='Query'),
  mainButtonTextEn?: string(name='MainButtonTextEn', description='The text of the primary button in the English button configuration.', example='test', position='Query'),
  matchMode?: string(name='MatchMode', description='The effective scope mode. Valid values:
- **UserGroupAll**: all user groups.
- **UserGroupNormal**: specified user groups.
- **DeviceGroupNormal**: specified device groups.
- **DevTagNormal**: specified device tags.', example='UserGroupNormal', position='Query'),
  matchTargetIds?: [ string ](name='MatchTargetIds', description='The list of effective scope targets. The meaning of the targets is determined by MatchMode.', position='Query'),
  md5List?: string(name='Md5List', description='The MD5 match string of the file.', example='d41d8cd98f00b204e9800998ecf8427e', position='Query'),
  minorButtonTextCh?: string(name='MinorButtonTextCh', description='The text of the secondary button in the Chinese button configuration.', example='test', position='Query'),
  minorButtonTextEn?: string(name='MinorButtonTextEn', description='The text of the secondary button in the English button configuration.', example='test', position='Query'),
  name: string(name='Name', description='The Policy Name.
> The maximum length is 128 characters.

This parameter is required.', example='test', position='Query'),
  newFilePath?: string(name='NewFilePath', description='The matched new file path.', example='C:\\\\Program Files\\\\Example\\\\renamed.exe', position='Query'),
  outSwitch?: boolean(name='OutSwitch', description='The outbound network switch.', example='true', position='Query'),
  parentCmdline?: string(name='ParentCmdline', description='The matched parent process command line.', example='C:\\\\Windows\\\\System32\\\\svchost.exe -k DcomLaunch -p', position='Query'),
  parentProcPath?: string(name='ParentProcPath', description='The matched parent process path.', example='C:\\\\Windows\\\\System32\\\\svchost.exe', position='Query'),
  platform?: string(name='Platform', description='The platform to which the rule applies. Valid values:
- **linux**
- **windows**
- **mac**
- **all**: all platforms.', example='windows', position='Query'),
  policyType: int32(name='PolicyType', description='The type of the policy. Valid values:
- **0**: software hardening.
- **1**: firewall.
- **2**: proactive defense.

This parameter is required.', example='0', position='Query'),
  port?: string(name='Port', description='The matched port.', example='443', position='Query'),
  portOnList?: [ string ](name='PortOnList', description='The list of enabled ports.
> This parameter is valid only when the policy type is firewall.', shrink='json', position='Query'),
  priority: int32(name='Priority', description='The policy priority. A smaller value indicates a higher priority. Valid values: greater than 0.

This parameter is required.', example='1', position='Query'),
  procPath?: string(name='ProcPath', description='The matched process path.', example='C:\\\\Windows\\\\System32\\\\RuntimeBroker.exe', position='Query'),
  registryContent?: string(name='RegistryContent', description='The matched registry content.', example='ExampleValue', position='Query'),
  registryKey?: string(name='RegistryKey', description='The matched registry key.', example='HKEY_LOCAL_MACHINE\\\\Software\\\\Example', position='Query'),
  ruleType?: int32(name='RuleType', description='The type of the defense rule. Valid values: 1 to 7.', example='1', position='Query'),
  selectionKey?: string(name='SelectionKey', description='The key of the switch configuration for the rule associated with the policy. This key can be used in ListSystemConfigRules and OperateTargetConfig.', example='a8d64565-ab8b-41a6-bd3d-14d0fc639285', position='Query'),
  softWareOnList?: [ string ](name='SoftWareOnList', description='The list of main process names of the software for which integrity check is enabled. The elements correspond to the Process returned by GetSwitchInfoListByType.', shrink='json', position='Query'),
  status: int32(name='Status', description='The status of the policy. Valid values:
- **0**: disabled.
- **1**: enabled.

This parameter is required.', example='0', position='Query'),
  strategySourceType?: string(name='StrategySourceType', description='The rule source for proactive defense (PolicyType=2). Valid values:
- **SYSTEM**: system rules.
- **CUSTOM**: custom rules.', example='SYSTEM', position='Query'),
  supportsApproval?: int32(name='SupportsApproval', description='Specifies whether reporting and approval are supported. Valid values:
- **0**: not supported.
- **1**: supported.', example='0', position='Query'),
  usContent?: string(name='UsContent', description='The English content in the pop-up prompt configuration.', example='test', position='Query'),
  usTitle?: string(name='UsTitle', description='The English title in the pop-up prompt configuration.', example='test', position='Query'),
  zhContent?: string(name='ZhContent', description='The Chinese content in the pop-up prompt configuration.', example='test', position='Query'),
  zhTitle?: string(name='ZhTitle', description='The Chinese title in the pop-up prompt configuration.', example='test', position='Query'),
}

