  lang?: string(name='Lang', description='The language of the request and response. Default value: **zh**. Valid values:
- **zh**: Chinese.
- **en**: English.', example='zh', position='Query'),
  levels?: string(name='Levels', description='The urgency levels of the alert events to query. Separate multiple urgency levels with commas (,). The urgency levels are listed in descending order. Valid values:
