  sourceIp?: string(name='SourceIp', description='The IP address of the access source.', example='192.168.XX.XX', position='Query'),
  srcIp?: string(name='SrcIp', description='The IP address of the endpoint.', example='111.55.XXX.XXX', position='Query'),
  status?: string(name='Status', description='Further filters alerts by individual alert status within the processing group specified by the Dealed parameter. Status descriptions:

