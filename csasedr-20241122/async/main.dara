    taskId?: long(name='TaskId', description='The ID of the task for handling security alert events.', example='15411'),
  }(name='HandleSecurityEventsResponse', description='The return result of handling security alert events.'),
  requestId?: string(name='RequestId', description='The ID of the request. It is a unique identifier generated by Alibaba Cloud for the request and can be used for troubleshooting.', example='FF0020B9-999F-5DE2-985F-DB282BDA5311'),
}

