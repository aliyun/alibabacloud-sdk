  targetType?: string(name='TargetType', description='The container search target type. Not supported by SASE-EDR.', example='containerId', position='Query'),
  timeEnd?: string(name='TimeEnd', description='The end time of the latest occurrence. Specify a datetime string in the YYYY-MM-DD HH:mm:ss format.', example='2022-07-06 13:50:38', position='Query'),
  timeStart?: string(name='TimeStart', description='The start time of the latest occurrence. Specify a datetime string in the YYYY-MM-DD HH:mm:ss format.', example='2022-07-05 13:50:38', position='Query'),
  uniqueInfo?: string(name='UniqueInfo', description='The unique key of the security alert.', example='73fc06fb175a7405697e402f52864****', position='Query'),
  userName?: string(name='UserName', description='The username of the endpoint.', example='User', position='Query'),
  uuids?: string(name='Uuids', description='The UUIDs of the servers for which you want to query alerts. Separate multiple UUIDs with commas (,).', example='bb5d2484-f10e-450d-8917-3e79667e****,0e7c2fcd-7100-42c7-a21a-db6e4f32****', position='Query'),
}

