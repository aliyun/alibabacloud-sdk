  operateTimeStart?: string(name='OperateTimeStart', description='The start time of the alert processing time. Specify a datetime string in the YYYY-MM-DD HH:mm:ss format.', example='2022-07-05 13:50:38', position='Query'),
  pageSize?: int32(name='PageSize', description='The number of alert events to return on each page in a paging query. Default value: 20. Maximum value: 100.', example='20', minimum=1, maximum=100, position='Query'),
  parentEventTypes?: string(name='ParentEventTypes', description='The internal type identifiers of the alerts. Separate multiple types with commas (,). The valid values are derived from the current alert configurations. You can call the DescribeNsasSuspEventType operation to query the Type field in EventTypes. The Name field is the display name and is not used as a fixed enumeration list.', example='Precision defense', position='Query'),
  remark?: string(name='Remark', description='The alert name or asset information to query.

Note: Fuzzy match is supported. Asset information includes the asset name, public IP address, and private IP address.', example='192.168.XX.XX', position='Query'),
  sortColumn?: string(name='SortColumn', description='The custom sort field. Default value: **operateTime**. Valid values:

- **lastTime**: Latest occurrence time.
- **operateTime**: Processing time.

> This field takes effect only when Dealed is set to Y.', example='operateTime', position='Query'),
  sortType?: string(name='SortType', description='The custom sort order. Default value: **desc**. Valid values:

- **asc**: Ascending order.
- **desc**: Descending order.

> This field takes effect only when Dealed is set to Y.', example='desc', position='Query'),
