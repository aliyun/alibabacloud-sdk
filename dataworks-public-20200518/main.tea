    'cn-hangzhou-test-306' = 'dataworks.aliyuncs.com',
    'cn-hongkong' = 'dataworks.cn-hongkong.aliyuncs.com',
    'cn-hongkong-finance-pop' = 'dataworks.aliyuncs.com',
