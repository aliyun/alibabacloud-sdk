  ignoreParentSkipRunningProperty?: boolean(name='IgnoreParentSkipRunningProperty', description='Specifies whether to skip the dry-run property of upstream nodes in the previous cycle.', example='true'),
  imageId?: string(name='ImageId', description='The ID of the custom image.', example='m-uf6d7npxk1hhek8ng0cb'),
  inputList?: string(name='InputList', description='The output names of the upstream files on which the current file depends. Separate multiple output names with commas (,).

