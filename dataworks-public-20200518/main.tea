model UpdateRemindRequest {
  alertInterval?: int32(name='AlertInterval', description='The alert interval. Unit: seconds. Minimum value: 1200. Default value: 1800.', example='1800'),
  alertMethods?: string(name='AlertMethods', description='The alert methods. Valid values:
- MAIL: email.
- SMS: text message.
- PHONE: phone call. This method is supported only in DataWorks Professional Edition or a higher edition.
- DINGROBOTS: DingTalk chatbot. This method takes effect only after the RobotUrls parameter is configured.
- Webhooks: WeCom or Lark chatbot. This method takes effect only after the Webhooks parameter is configured.

Separate multiple alert methods with commas (,).', example='SMS,MAIL'),
  alertTargets?: string(name='AlertTargets', description='The parameter settings for different alert recipients:
- If AlertUnit is set to OWNER (node task owner), leave this parameter empty.
- If AlertUnit is set to OTHER (specified users), specify their Alibaba Cloud UIDs. Separate multiple UIDs with commas (,). You can specify up to 10 users to receive alerts.', example='9527952795279527'),
  alertUnit?: string(name='AlertUnit', description='The recipients of the alert. Valid values: OWNER (task owner) and OTHER (specified users).', example='OWNER'),
  baselineIds?: string(name='BaselineIds', description='The baseline IDs when the monitored object is a baseline. A single monitoring rule can monitor up to 5 baselines. Separate multiple baseline IDs with commas (,).
This parameter takes effect only when the RemindUnit parameter is set to BASELINE.', example='1,2,3'),
  bizProcessIds?: string(name='BizProcessIds', description='The workflow IDs when the monitored object is a workflow. A single monitoring rule can monitor up to 5 workflows. Separate multiple workflow IDs with commas (,).
This parameter takes effect only when the RemindUnit parameter is set to BIZPROCESS.', example='1,2,3'),
  detail?: string(name='Detail', description='The parameter settings for different trigger conditions:
- If the RemindType (trigger condition) is set to FINISHED, leave the parameter settings empty.
- If the RemindType (trigger condition) is set to UNFINISHED, specify the parameter settings in the {"hour":23,"minu":59} format. Valid values for hour: [0,47]. Valid values for minu: [0,59].
- If the RemindType (trigger condition) is set to ERROR, leave the parameter settings empty.
- If the RemindType (trigger condition) is set to CYCLE_UNFINISHED (unfinished cycle), specify the parameter settings in the {"1":"05:50","2":"06:50","3":"07:50","4":"08:50","5":"09:50","6":"10:50","7":"11:50","8":"12:50","9":"13:50","10":"14:50","11":"15:50","12":"16:50","13":"17:50","14":"18:50","15":"19:50","16":"20:50","17":"21:50","18":"22:50","19":"23:50","20":"24:50","21":"25:50"} format. The key in the JSON string is the cycle number, and the valid values are [1,288]. The value is the unfinished time for the cycle, in the hh:mm format. Valid values for hh: [0,47]. Valid values for mm: [0,59].
- If the RemindType (trigger condition) is set to TIMEOUT, specify the parameter settings in seconds. Example: 1800. This means that an alert is triggered if the instance runs for more than 30 minutes after it starts.', example='{"hour":23,"minu":59}'),
  dndEnd?: string(name='DndEnd', description='The end time of the do-not-disturb period, before which no alerts are sent. Specify the time in the hh:mm format. Valid values for hh: [0,23]. Valid values for mm: [0,59].', example='08:00'),
  maxAlertTimes?: int32(name='MaxAlertTimes', description='The maximum number of alerts. Valid values: [1,10]. Default value: 3.', example='3'),
  nodeIds?: string(name='NodeIds', description='The node IDs when the monitored object is a node. A single monitoring rule can monitor up to 50 nodes. Separate multiple node IDs with commas (,).
This parameter takes effect only when the RemindUnit parameter is set to NODE.', example='1,2,3'),
  projectId?: long(name='ProjectId', description='The workspace ID when the monitored object is a workspace. A single monitoring rule can monitor only one workspace.
This parameter takes effect only when the RemindUnit parameter is set to PROJECT.', example='1234'),
  remindId?: long(name='RemindId', description='The ID of the custom rule.

This parameter is required.', example='1234'),
  remindName?: string(name='RemindName', description='The name of the custom rule. The name cannot exceed 128 characters in length.', example='update_remindname'),
  remindType?: string(name='RemindType', description='The condition that triggers the alert rule. Valid values:
- FINISHED: The system sends an alert when the task runs successfully. The monitoring starts from the time when the instance starts to run.
- UNFINISHED: The system sends an alert if the task is still running at the specified time. The monitoring starts from the time when the instance starts to run.
- ERROR: The system sends an alert when an error occurs during the running of the task. The monitoring starts from the time when the instance starts to run.
- CYCLE_UNFINISHED: The system sends an alert if the instance is still running within the specified cycle. This value is typically used to monitor instances that run on an hourly cycle.
- TIMEOUT: The system sends an alert if the task is still running after the specified running duration. The monitoring starts from the time when the instance starts to run. This value is typically used to monitor the running duration of instances.

For more information about the conditions that trigger alert rules, see [Custom rules](https://help.aliyun.com/document_detail/138172.html).', example='FINISHED'),
  remindUnit?: string(name='RemindUnit', description='The type of the monitored object. Valid values:
- NODE: node
- BASELINE: baseline
- PROJECT: workspace
- BIZPROCESS: workflow', example='NODE'),
  robotUrls?: string(name='RobotUrls', description='The webhook URLs of the DingTalk group chatbot. Separate multiple webhook URLs with commas (,).
If the parameter settings are set to undefined, the system clears the webhook URLs of the DingTalk chatbot.', example='https://oapi.dingtalk.com/robot/send?access_token=******************************'),
  useFlag?: boolean(name='UseFlag', description='Specifies whether to enable the alert rule. Valid values:
- true: The alert rule is enabled.
- false: The alert rule is disabled.', example='true'),
  webhooks?: string(name='Webhooks', description='The webhook URLs of the WeCom or Lark chatbot. Separate multiple webhook URLs with commas (,). The AlertMethods parameter must include the WEBHOOKS alerting method. If the parameter settings are set to undefined, the system clears the webhook URLs.

This parameter is supported only in DataWorks Enterprise Edition.
Available regions: China (Shanghai), China (Chengdu), China (Zhangjiakou), China (Beijing), China (Hangzhou), China (Shenzhen), China (Hong Kong), Germany (Frankfurt), and Singapore.', example='https://open.feishu.cn/open-apis/bot/v2/hook/*******'),
}

