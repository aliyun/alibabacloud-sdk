  requestId?: string(name='RequestId', description='The unique ID of the request. You can use the ID to locate logs and troubleshoot issues when an error occurs.', example='0000-ABCD-EFG'),
  success?: boolean(name='Success', description='Indicates whether the request was successful. Valid values:
