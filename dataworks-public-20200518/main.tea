    'me-central-1' = 'dataworks.me-central-1.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('dataworks-public', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model Cluster {
  clusterBizId?: string(name='ClusterBizId', description='The unique business identifier of the cluster.

This parameter is required.', example='c-d8a7523****'),
  clusterId?: long(name='ClusterId', description='The cluster ID generated by DataWorks.

This parameter is required.', example='1234'),
}

model ClusterConfig {
  configValue?: string(name='ConfigValue', description='The configuration value.', example='{"spark.driver.memory":"1g"}'),
  enableOverwrite?: boolean(name='EnableOverwrite', description='Specifies whether to overwrite the advanced settings of nodes in Data Studio. Valid values:




- true: overwrite.
- false: do not overwrite.', example='false'),
  moduleName?: string(name='ModuleName', description='The module in which the cluster is configured. Valid values:




- ide: Data Studio.
- da: DataAnalysis.
- scheduler.auto: Operation Center - auto triggered instances.
- scheduler.backfill: Operation Center - data backfill instances.
- scheduler.test: Operation Center - test instances.
- scheduler.manual: Operation Center - manually triggered instances.', example='ide'),
}

model Collection {
  collectionType?: string(name='CollectionType', description='The type of the collection. Valid values:

*   **ALBUM**: data album
*   **ALBUM_CATEGORY**: category in a data album', example='album'),
  comment?: string(name='Comment', description='The remarks.', example='comment'),
  createTime?: long(name='CreateTime', description='The creation time.', example='1668600147617'),
  level?: int32(name='Level', description='The level of the collection. This parameter is returned only for collections of the ALBUM_CATEGORY type. Maximum value: 4.', example='1'),
  name?: string(name='Name', description='The name of the collection.', example='collectionName'),
  ownerId?: string(name='OwnerId', description='The ID of the Alibaba Cloud account that is used by the collection owner.', example='1234444'),
  ownerName?: string(name='OwnerName', description='The name of the collection owner.', example='owner'),
  qualifiedName?: string(name='QualifiedName', description='The unique identifier of the collection.', example='album.12334'),
  updateTime?: long(name='UpdateTime', description='The update time.', example='1668600148617'),
}

model Entity {
  entityContent?: map[string]any(name='EntityContent', description='The properties of the entity, including:

*   **entityType**: The type of the entity. Examples: maxcompute-table and emr-table.
*   **name**: the name of the entity.
*   **projectName**: the name of the MaxCompute project.'),
  qualifiedName?: string(name='QualifiedName', description='The unique identifier of the entity. Example: maxcompute-table.projectA.tableB.', example='maxcompute_table.563f0357118d05ef145d6bddf2966cc23e86ca8f2f013f915e565afdf09f7a23'),
  tenantId?: long(name='TenantId', description='The tenant ID.', example='12345'),
}

model LineageEntityVO {
  attributes?: map[string]string(name='Attributes', description='The other attributes.', example='attribute map'),
  detailUrl?: string(name='DetailUrl', description='Detail url of entity', example='http://domain.test.url/entity'),
  entityType?: string(name='EntityType', description='Entity type', example='maxcompute-table'),
  name?: string(name='Name', description='Name of entity', example='tableName'),
  owner?: string(name='Owner', description='Owner', example='owner'),
  parentName?: string(name='ParentName', description='Parent name of entity', example='dbName'),
  qualifiedName?: string(name='QualifiedName', description='Unique identifier of entity', example='maxcompute-table.projectName.tablename'),
}

