model SetDataSourceShareRequest {
  datasourceName?: string(name='DatasourceName', description='The name of the target data source to be shared.

This parameter is required.', example='mysql_name'),
  envType?: string(name='EnvType', description='The environment to which the target data source belongs. Valid values:
- 0: development environment.
- 1: production environment.', example='1'),
  projectId?: long(name='ProjectId', description='The ID of the DataWorks workspace to which the target data source belongs. You can call the [ListProjects](https://help.aliyun.com/document_detail/178393.html) operation to obtain the workspace ID.

This parameter is required.', example='10000'),
  projectPermissions?: string(name='ProjectPermissions', description='The DataWorks workspace with which you want to share the target data source. After the data source is shared, all members of the workspace can view or use the target data source. Use the JSON array format. Example: [{"projectId":1000,"permission":"WRITE","sharedName":"PX_DATAHUB1.shared_name"}].
Parameter description:
- projectId: the ID of the workspace with which you want to share the target data source.
- permission: the permission mode. Valid values: READ and WRITE. READ indicates that all members of the specified workspace can only read data from the target data source but cannot modify the data. WRITE indicates that all members of the specified workspace can modify data in the target data source.
- sharedName: the name of the data source to be shared.', example='[{"projectId":1000,"permission":"WRITE","sharedName":"PX_DATAHUB1.shared_name"}]'),
  userPermissions?: string(name='UserPermissions', description='The users with whom you want to share the target data source. After the data source is shared, the specified users can view or use the target data source. Use the JSON array format. Example: [{"projectId":10000,"users":[{"userId":"276184575345452131","permission":"WRITE"}],"sharedName":"PX_DATAHUB1.shared_name"}].
Parameter description:
- projectId: the ID of the DataWorks workspace. This indicates that the users with whom you want to share the target data source can view or use the target data source only in this workspace.
- userId: the ID of the user with whom you want to share the target data source.
- permission: the permission mode. Valid values: READ and WRITE. READ indicates that the specified user can only read data from the target data source but cannot modify the data. WRITE indicates that the specified user can modify data in the target data source.
- sharedName: the name of the data source to be shared.

If both ProjectPermissions and UserPermissions are empty, this operation does not make any modifications. If neither is empty, both UserPermissions and ProjectPermissions take effect.', example='[{"projectId":10000,"users":[{"userId":"276184575345452131","permission":"WRITE"}],"sharedName":"PX_DATAHUB1.shared_name"}]'),
}

