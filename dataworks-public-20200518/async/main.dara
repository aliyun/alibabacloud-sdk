model GenerateDISyncTaskConfigForCreatingRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  clientToken?: string(name='ClientToken', description='The idempotency token. This parameter prevents duplicate operations caused by repeated calls.', example='ABFUOEUOTRTRJKE', position='Query'),
  projectId: long(name='ProjectId', description='The ID of the DataWorks workspace. You can log on to the [DataWorks console](https://workbench.data.aliyun.com/console) and go to the Workspace Configuration page to obtain the workspace ID.

This parameter specifies the DataWorks workspace for the current API call.

This parameter is required.', example='10000', minimum=1, maximum=10000000000, position='Query'),
  taskParam: string(name='TaskParam', description='The script of the Data Integration synchronization task.
The following types of synchronization tasks can be created: 
- Synchronize data from MySQL to MaxCompute.
- Synchronize data from MySQL to Kafka.
- Synchronize data from MySQL to Hologres.

SelectedTables is used to select synchronization tables in multi-database mode, and Tables is used to select synchronization tables in single-database mode.
- If the script contains the SelectedTables statement, the system uses the table information in the SelectedTables statement for synchronization.
- If the script contains the Tables statement, the system uses the field information of Tables for synchronization.


The following example shows the script for synchronizing data from MySQL to MaxCompute:
```
{
  "type": "realtime",
  "version": "1.0",
  "setting": {
    "resourceGroup": "S_res_group_280749521950784_1623033752022",
    "taskType": "oneclick_to_odps"
  },
  "steps": [
    {
      "stepType": "mysql",
      "parameter": {
        "connection": [
          {
            "datasourceType": "mysql",
            "datasource": "mysql_pub1",
            "selectedTables": [
              {
                "dbName": "mysql_db",
                "schema": [
                  {
                    "tableInfos": [
                      {
                        "table": "molin_di_test_in_pk_v4"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "name": "Reader",
      "category": "reader"
    },
    {
      "stepType": "odps",
      "parameter": {
        "datasource": "odps_source"
      },
      "name": "Writer",
      "category": "writer"
    }
  ]
}
```

The following example shows the script for synchronizing data from MySQL to Kafka:
```
{
  "type": "realtime",
  "version": "1.0",
  "setting": {
    "resourceGroup": "S_res_group_280749521950784_1623033752022",
    "taskType": "oneclick_to_kafka"
  },
  "steps": [
    {
      "stepType": "mysql",
      "parameter": {
        "connection": [
          {
            "datasourceType": "mysql",
            "datasource": "pkset_test",
            "selectedTables": [
              {
                "dbName": "mysql_db",
                "schema": [
                  {
                    "tableInfos": [
                      {
                        "table": "molin_di_test_in_pk_v4"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "name": "Reader",
      "category": "reader"
    },
    {
      "stepType": "kafka",
      "parameter": {
        "datasource": "azn_kafka"
      },
      "name": "Writer",
      "category": "writer"
    }
  ]
}
```

The following example shows the script for synchronizing data from MySQL to Hologres:
```
{
  "type": "realtime",
  "version": "1.0",
  "setting": {
    "resourceGroup": "S_res_group_280749521950784_1623033752022",
    "taskType": "oneclick_to_holo"
  },
  "steps": [
    {
      "stepType": "mysql",
      "parameter": {
        "connection": [
          {
            "datasourceType": "mysql",
            "datasource": "mysql_pub",
            "selectedTables": [
              {
                "dbName": "mysql_db",
                "schema": [
                  {
                    "tableInfos": [
                      {
                        "table": "molin_di_test_in2_pk_v3"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "name": "Reader",
      "category": "reader"
    },
    {
      "stepType": "holo",
      "parameter": {
        "datasource": "holo"
      },
      "name": "Writer",
      "category": "writer"
    }
  ]
}
```

This parameter is required.', example='{  "type": "realtime",  "version": "1.0",  "setting": {  "resourceGroup": "S_res_group_280749521950784_1623033752022",  "taskType": "oneclick_to_odps"  },  "steps": [{ "stepType": "mysql", "parameter": { "connection": [ { "datasourceType": "mysql", "datasource": "mysql_pub1", "selectedTables": [ { "dbName": "mysql_db", "schema": [ { "tableInfos": [ { "table": "molin_di_test_in_pk_v4" }]  }  ]  }  ]  }  ]  },  "name": "Reader",  "category": "reader"  },  {  "stepType": "odps",  "parameter": {  "datasource": "odps_source"  },  "name": "Writer",  "category": "writer"  }  ]  }', position='Query'),
  taskType: string(name='TaskType', description='The type of the Data Integration synchronization task created by using the asynchronous method. Valid values:
- DI_REALTIME: real-time synchronization task
- DI_SOLUTION: other types of synchronization tasks

Only the asynchronous method is supported for generating real-time synchronization tasks and other types of synchronization tasks in Data Integration.

This parameter is required.', example='DI_REALTIME', position='Query'),
}

