model AddRecognizeRuleRequest {
  regionId?: string(name='RegionId', position='Host'),
  accountName: string(name='AccountName', description='The Alibaba Cloud user who creates the sensitive data identification rule. Enter the username.

This parameter is required.', example='dsg-uat', position='Body'),
  colExclude?: string(name='ColExclude', description='The column exclusion setting. The specified columns are excluded from identification.
- Format: ${workspace}.${table}.${column} or ${workspace}.${schema}.${table}.${column}.
- You can use the asterisk (*) as a wildcard. For example, default.table.column1* matches default.table.column10 and other column names starting with column1.', example='default.qujian.*6', position='Body'),
  colScan?: string(name='ColScan', description='The column scan setting. Only the specified columns are identified.
- Format: ${workspace}.${table}.${column} or ${workspace}.${schema}.${table}.${column}.
- You can use the asterisk (*) as a wildcard. For example, default.table.column1* matches default.table.column10 and other column names starting with column1.', example='default.qujian.*', position='Body'),
  commentScan?: string(name='CommentScan', description='The comment scanning configuration. The value is the text of the comment for each field in your data assets. Fuzzy match is supported.', example='test', position='Body'),
  contentScan?: string(name='ContentScan', description='The content recognition configuration. You can call the [QuerySensNodeInfo](https://help.aliyun.com/document_detail/2747189.html) operation and refer to the configuration of the same field in the built-in rules.', example='{"_clazz":"com.alipay.dsgclient.sdk.dsg.fastscan.engine.cond.NationalityCond"}', position='Body'),
  hitThreshold?: int32(name='HitThreshold', description='The hit threshold. If the percentage of sampled data that hits the named entity recognition (NER) model exceeds the threshold, such as 60%, the data is considered to hit the sensitive field. Valid values: an integer from 0 to 100.', example='50', position='Body'),
  level: string(name='Level', description='The sensitivity level of the sensitive field. Select a level defined in the template for the new sensitive field, such as levels 1 to 10.

This parameter is required.', example='1', position='Body'),
  levelName?: string(name='LevelName', description='The name of the sensitivity level. You can call the [QueryDefaultTemplate](https://help.aliyun.com/document_detail/2743948.html) operation to obtain the name of the selected level in the template.

Note: This parameter is required by the current service. If it is omitted, a 400 error (InternalError.Bad.Parameters: levelName not empty) is returned.', example='Confidential', position='Body'),
  nodeId: string(name='NodeId', description='The classification node ID. You can call the [QuerySensClassification](https://help.aliyun.com/document_detail/2746850.html) operation to obtain all node IDs and select a node to create a sensitive field. Enter the ID of the selected node.

This parameter is required.', example='0ce67949-0810-400f-a24a-****', position='Body'),
  nodeParent: string(name='NodeParent', description='The parent node information of the classification node. You can call the [QuerySensClassification](https://help.aliyun.com/document_detail/2746850.html) operation to obtain the information.

This parameter is required.', example='Customer/personal/personal_Natural _Information/personal basic_profile_information', position='Body'),
  operationType: int32(name='OperationType', description='The operation type. Valid values:
- 0: OR
- 1: AND

This parameter is required.', example='0', position='Body'),
  recognizeRules?: string(name='RecognizeRules', description='The content of the sensitive data identification rule. Call [QuerySensNodeInfo](https://help.aliyun.com/document_detail/2747189.html) to see how the same field is configured in a built-in rule.', example='{"contentRule":{"_clazz":"com.alipay.dsgclient.sdk.dsg.fastscan.engine.cond.GenderCond"},"_clazz":"com.alipay.dsg.dal.model.RuleContent"}', position='Body'),
  recognizeRulesType?: string(name='RecognizeRulesType', description='The type of sensitive data identification rule. Valid values:
- 1: regular expression
- 2: built-in rule
- 3: sample library
- 4: self-generated model', example='1', position='Body'),
  sensitiveDescription?: string(name='SensitiveDescription', description='The description of the sensitive field. The value must be a string less than 128 characters in length.', example='This is a sensitive field that identifies the name.', position='Body'),
  sensitiveName: string(name='SensitiveName', description='The custom name of the sensitive field. The value must be a string less than 128 characters in length.

This parameter is required.', example='name', position='Body'),
  status?: int32(name='Status', description='The status of the sensitive field. Valid values:
- 0: draft
- 1: active', example='0', position='Body'),
  templateId: string(name='TemplateId', description='The template ID. You can call the [QueryDefaultTemplate](https://help.aliyun.com/document_detail/2743948.html) operation to obtain the ID of the current default template.

This parameter is required.', example='e1970541-6cf5-4d23-b101-****', position='Body'),
  tenantId: string(name='TenantId', description='The tenant ID. To obtain the tenant ID, log on to the [DataWorks console](https://workbench.data.aliyun.com/console), go to the Data Studio page, click the username in the upper-right corner, and choose Menu > User Info.

This parameter is required.', example='10241024', position='Body'),
}

