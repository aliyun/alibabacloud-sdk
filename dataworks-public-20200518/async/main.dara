    status?: string(name='Status', description='The task status. Valid values: NOT_RUN(1): not run; WAIT_TIME(2): waiting for the scheduled time; WAIT_RESOURCE(3): dispatched to the execution engine and waiting in the resource queue; RUNNING(4): running; CHECKING(7): execution finished and sent to Data Quality for validation; CHECKING_CONDITION(8): execution finished and branch conditions being checked; WAIT_TRIGGER(9): waiting for a trigger, a state entered by trigger-based nodes after waiting for the scheduled time; FAILURE(5): failed; SUCCESS(6): successful.', example='NOT_RUN'),
    taskRerunTime?: int32(name='TaskRerunTime', description='The number of times the instance can still run. This value can be empty or an integer greater than or equal to 0. An empty value indicates that automatic reruns are not configured for the corresponding node. A value of 0 indicates that the instance cannot be rerun. A positive integer n indicates that the instance can still be rerun n times. For example, 1 means one remaining rerun and 2 means two remaining reruns. The initial value is the automatic rerun count configured for the corresponding node plus 1.', example='0'),
