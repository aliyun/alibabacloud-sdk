model CreateFileRequest {
  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  advancedSettings?: string(name='AdvancedSettings', description='The advanced settings of the task.

This parameter corresponds to the **Advanced Settings** section in the right-side navigation pane of the edit page for EMR Spark Streaming and EMR Streaming SQL data development tasks in the [DataWorks console](https://workbench.data.aliyun.com/console).

Currently, only EMR Spark Streaming and EMR Streaming SQL tasks support this parameter, and the value must be in JSON format.', example='{"queue":"default","SPARK_CONF":"--conf spark.driver.memory=2g"}', position='Body'),
  applyScheduleImmediately?: boolean(name='ApplyScheduleImmediately', description='Specifies whether the scheduling configuration takes effect immediately after deployment.', example='true', position='Body'),
