    processId?: long(name='ProcessId', description='The asynchronous thread ID. You must use this ID to call the [QueryDISyncTaskConfigProcessResult](https://help.aliyun.com/document_detail/383465.html) operation to obtain the parameters required for asynchronously generating the configuration of the Data Integration synchronization task, and then use the parameters to create the task.', example='10'),
    status?: string(name='Status', description='The status of generating the asynchronous thread ID. Valid values:
