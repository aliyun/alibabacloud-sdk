  fileName?: string(name='fileName', description='最终生效的文件名（客户端指定或后端默认），已签进 **`download_url`** 的 **`Content-Disposition`**， 浏览器直连下载即按此落盘。', example='test-sbom-cyclonedx.cdx.json'),
  format?: string(name='format', example='cyclonedx-json'),
  mediaType?: string(name='mediaType', description='交付文件 MIME 类型', example='application/vnd.cyclonedx+json'),
  requestId?: string(name='requestId', example='9A1F403F-0A85-5578-8B7C-55E3E9408659'),
  sha256?: string(name='sha256', description='交付文件本身（注入后重算）的摘要，供下载完整性校验；与源制品的 sha256 不同', example='1f8dc54097780e9c32941289d2aff5161df694b5bfb2d0aa3fe87fe72a751363'),
