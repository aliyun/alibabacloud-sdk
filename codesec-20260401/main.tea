import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-southeast-1' = 'codesec.ap-southeast-1.aliyuncs.com',
    'cn-hangzhou' = 'codesec.cn-hangzhou.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('codesec', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model DescribeProjectsRequest {
  maxResults?: int32(name='maxResults', description='The number of entries per page. Default value: 10. Maximum value: 20.', example='20'),
  nextToken?: string(name='nextToken', description='The pagination token. Do not specify this parameter or set it to an empty string for the first page. For subsequent pages, pass the nextToken value from the previous response without any modification. If the nextToken in the response is empty, the last page has been reached.', example='eyJ0IjoiMjAyNi0wNy0xNlQwNzo1MzozOC4wMjFaIiwiaSI6MTAwMDQ0OH0'),
  query?: string(name='query', description='Fuzzy matches projects by project name or prompt.', example='project'),
}

model DescribeProjectsResponseBody = {
  items?: [ 
    {
      configRevision?: long(name='configRevision', description='The project configuration version number.', example='1'),
      createdAt?: string(name='createdAt', description='The creation time.', example='2026-07-28T03:36:31.573Z'),
