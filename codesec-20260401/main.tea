        sast?: boolean(name='sast', description='Indicates whether SAST is supported.', example='true'),
        sca?: boolean(name='sca', description='Indicates whether SCA is supported.', example='true'),
      }(name='engines', description='The engine switches for the project or scan snapshot (SAST and SCA only).'),
      id?: long(name='id', description='The project ID.', example='934'),
