/**
 * @summary Creates a project.
 *
 * @param tmpReq CreateProjectRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateProjectResponse
 */
@context("createProjectWithContext")
async function createProjectWithOptions(tmpReq: CreateProjectRequest, headers: map[string]string, runtime: $RuntimeOptions): CreateProjectResponse {
  tmpReq.validate();
  var request = new CreateProjectShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!$isNull(tmpReq.engines)) {
    request.enginesShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.engines, 'engines', 'json');
  }
  if (!$isNull(tmpReq.source)) {
    request.sourceShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.source, 'source', 'json');
  }
  var query : map[string]any = {};
  if (!$isNull(request.description)) {
    query['description'] = request.description;
  }
  if (!$isNull(request.enginesShrink)) {
    query['engines'] = request.enginesShrink;
  }
  if (!$isNull(request.instructionPrompt)) {
    query['instructionPrompt'] = request.instructionPrompt;
  }
  if (!$isNull(request.name)) {
    query['name'] = request.name;
  }
  if (!$isNull(request.sourceShrink)) {
    query['source'] = request.sourceShrink;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'CreateProject',
    version = '2026-04-01',
    protocol = 'HTTPS',
    pathname = `/v1/projects`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Creates a project.
 *
 * @param request CreateProjectRequest
 * @return CreateProjectResponse
 */
async function createProject(request: CreateProjectRequest): CreateProjectResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return createProjectWithOptions(request, headers, runtime);
}

