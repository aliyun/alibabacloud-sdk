  updatedAt?: string(name='updatedAt', description='The time when the record was last updated.', example='2026-08-27T00:53:46.774Z'),
}

model CompleteCodeBundleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CompleteCodeBundleResponseBody(name='body'),
}

/**
 * @summary Finalizes a code bundle after the client completes an OSS PUT operation. This operation validates the uploaded object and sets the code bundle status to ready. If CI metadata that triggers an automatic scan was provided during creation, a scanId is returned.
 *
 * @param request CompleteCodeBundleRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CompleteCodeBundleResponse
 */
@context("completeCodeBundleWithContext")
async function completeCodeBundleWithOptions(projectId: string, codeBundleId: string, request: CompleteCodeBundleRequest, headers: map[string]string, runtime: $RuntimeOptions): CompleteCodeBundleResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.byteSize)) {
    query['byteSize'] = request.byteSize;
  }
  if (!$isNull(request.contentType)) {
    query['contentType'] = request.contentType;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'CompleteCodeBundle',
    version = '2026-04-01',
    protocol = 'HTTPS',
    pathname = `/v1/projects/${$URL.percentEncode(projectId)}/codeBundles/${$URL.percentEncode(codeBundleId)}/complete`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Finalizes a code bundle after the client completes an OSS PUT operation. This operation validates the uploaded object and sets the code bundle status to ready. If CI metadata that triggers an automatic scan was provided during creation, a scanId is returned.
 *
 * @param request CompleteCodeBundleRequest
 * @return CompleteCodeBundleResponse
 */
async function completeCodeBundle(projectId: string, codeBundleId: string, request: CompleteCodeBundleRequest): CompleteCodeBundleResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return completeCodeBundleWithOptions(projectId, codeBundleId, request, headers, runtime);
}

