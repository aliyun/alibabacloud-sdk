/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('sasclaw', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ChatUserSecAgentRequest {
  agent?: string(name='Agent', example='sec-ops-agent'),
  attachmentStagingId?: string(name='AttachmentStagingId', description='附件暂存 ID', example='stg-6f1d9c8b7a2e4530'),
  attachments?: string(name='Attachments', description='附件列表 JSON 字符串', example='["oss/input.txt","oss/raw.txt"]'),
  channel?: string(name='Channel', description='逻辑渠道名', example='console'),
  executionMode?: string(name='ExecutionMode', description='执行模式: single/team/role', example='single'),
  extraParams?: string(name='ExtraParams', description='扩展参数 JSON 字符串，如 execution_mode、target 等', example='{"execution_mode":"team","target":"team:auto"}'),
  memory?: boolean(name='Memory'),
  model?: string(name='Model', example='qwen-max'),
  prompt?: string(name='Prompt', description='用户提问；新会话时必填，恢复/交互时可空', example='帮我梳理最近 24 小时的高危告警并给出处置建议'),
  responseLanguage?: string(name='ResponseLanguage', example='zh-CN'),
  sessionId?: string(name='SessionId', example='5f2c1b9a8d3e4c7f'),
  skill?: string(name='Skill', example='alert-analysis'),
  stream?: boolean(name='Stream'),
  talkId?: string(name='TalkId', example='9b1e7d2c4a6f8e30'),
  target?: string(name='Target', description='执行目标', example='sec-ops-team-01'),
  timeZone?: string(name='TimeZone', example='Asia/Shanghai'),
  userInputInfo?: string(name='UserInputInfo', description='会话恢复/交互提交信息 JSON 字符串', example='{"sessionId":"session_example","talkId":"talk_example","formId":"interaction_example","formValues":{"q1":{"kind":"selected","optionIds":["q1_o1"]}},"formAction":"submit"}'),
}

model ChatUserSecAgentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: string(name='body'),
}

/**
 * @summary Claw SSE Chat
 *
 * @param request ChatUserSecAgentRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return ChatUserSecAgentResponse
 */
async function chatUserSecAgentWithOptions(request: ChatUserSecAgentRequest, runtime: Util.RuntimeOptions): ChatUserSecAgentResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.agent)) {
    body['Agent'] = request.agent;
  }
  if (!Util.isUnset(request.attachmentStagingId)) {
    body['AttachmentStagingId'] = request.attachmentStagingId;
  }
  if (!Util.isUnset(request.attachments)) {
    body['Attachments'] = request.attachments;
  }
  if (!Util.isUnset(request.channel)) {
    body['Channel'] = request.channel;
  }
  if (!Util.isUnset(request.executionMode)) {
    body['ExecutionMode'] = request.executionMode;
  }
  if (!Util.isUnset(request.extraParams)) {
    body['ExtraParams'] = request.extraParams;
  }
  if (!Util.isUnset(request.memory)) {
    body['Memory'] = request.memory;
  }
  if (!Util.isUnset(request.model)) {
    body['Model'] = request.model;
  }
  if (!Util.isUnset(request.prompt)) {
    body['Prompt'] = request.prompt;
  }
  if (!Util.isUnset(request.responseLanguage)) {
    body['ResponseLanguage'] = request.responseLanguage;
  }
  if (!Util.isUnset(request.sessionId)) {
    body['SessionId'] = request.sessionId;
  }
  if (!Util.isUnset(request.skill)) {
    body['Skill'] = request.skill;
  }
  if (!Util.isUnset(request.stream)) {
    body['Stream'] = request.stream;
  }
  if (!Util.isUnset(request.talkId)) {
    body['TalkId'] = request.talkId;
  }
  if (!Util.isUnset(request.target)) {
    body['Target'] = request.target;
  }
  if (!Util.isUnset(request.timeZone)) {
    body['TimeZone'] = request.timeZone;
  }
  if (!Util.isUnset(request.userInputInfo)) {
    body['UserInputInfo'] = request.userInputInfo;
  }
  var req = new OpenApi.OpenApiRequest{ 
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'ChatUserSecAgent',
    version = '2026-06-26',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'string',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Claw SSE Chat
 *
 * @param request ChatUserSecAgentRequest
 * @return ChatUserSecAgentResponse
 */
async function chatUserSecAgent(request: ChatUserSecAgentRequest): ChatUserSecAgentResponse {
  var runtime = new Util.RuntimeOptions{};
  return chatUserSecAgentWithOptions(request, runtime);
}

