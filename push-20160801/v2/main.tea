    exipreTime?: long(name='ExipreTime', description='The expiration time of the certificate.', example='1470024000000'),
    status?: string(name='Status', description='The certificate status. Valid values:

- **EXPIRED**: The certificate has expired.
- **NOT_CONFIGURED**: The certificate is not configured.
- **NO_PASSWORD**: The password is not configured.
- **OK**: The certificate is normal.
- **REVOKED**: The certificate is revoked.', example='EXPIRED'),
  }(name='DevelopmentCertInfo', description='The certificate information for accessing the development or sandbox environment.'),
  IOS?: boolean(name='IOS', description='Indicates whether the AppKey represents an iOS app:
- true
- false', example='true'),
