    exipreTime?: long(name='ExipreTime', description='The expiration time of the certificate.', example='1764561600000'),
    status?: string(name='Status', description='The certificate status. Valid values:

- **EXPIRED**: The certificate has expired.
- **NOT_CONFIGURED**: The certificate is not configured.
- **NO_PASSWORD**: The password is not configured.
- **OK**: The certificate is normal.
- **REVOKED**: The certificate is revoked.', example='OK'),
  }(name='ProductionCertInfo', description='The certificate information for accessing the production environment.'),
