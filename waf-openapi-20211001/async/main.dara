  requestId?: string(name='RequestId', description='The request ID.', example='12EF3845-CCEB-4B84-AE60-2B49B*****EE5'),
  topMetrics?: [ 
    {
      cnt?: long(name='Cnt', description='The number of attacks.', example='20'),
      country?: string(name='Country', description='The country to which the source IP address of the attack belongs.
> This field returns a meaningful value only when the statistical object (**Metric**) is set to source IP address (**src**).', example='CN'),
      region?: string(name='Region', description='The region to which the source IP address of the attack belongs.
> This field returns a meaningful value only when the statistical object (**Metric**) is set to source IP address (**src**).', example='cn-hangzhou'),
      value?: string(name='Value', description='The attack value. The meaning of this field varies depending on the value of **Metric**.

- If **Metric** is set to **time**, this field indicates the attack time.
- If **Metric** is set to **src**, this field indicates the source IP address of the attack.
- If **Metric** is set to **target**, this field indicates the URL of the attack request.
- If **Metric** is set to **type**, this field indicates the attack type. **dirscan** indicates directory scanning, **webscan** indicates web scanning, and other attack types are described in the **detectType** (detection type) parameter of the **custom regular rule** (**regular_custom**) in the [**CreateDefenseRule**](https://help.aliyun.com/document_detail/461421.html) operation.
- If **Metric** is set to **tools**, this field indicates the attack tool.', example='115.28.209.212'),
    }
  ](name='TopMetrics', description='The list of statistics.'),
}

