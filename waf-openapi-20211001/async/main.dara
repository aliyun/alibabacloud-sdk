  * After completing the preceding steps, invoke this operation to connect the cloud service to WAF in cloud native mode.
  * @param request  the request parameters of CreateCloudResource  CreateCloudResourceRequest
  * @return CreateCloudResourceResponse
 */
async function createCloudResource(request: CreateCloudResourceRequest): CreateCloudResourceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateCloudResource', 'POST', '/', 'json', false, 'json', request);
}

