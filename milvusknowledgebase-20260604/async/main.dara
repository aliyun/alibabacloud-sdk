/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'MilvusKnowledgeBase';
  @version = '2026-06-04';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddDocumentsRequest {
  datasetId?: string(name='datasetId', example='kd-03ec1e2385fcf', position='Path'),
  dedup?: {
    contentDedup?: boolean(name='ContentDedup', example='true'),
    docNameDedup?: boolean(name='DocNameDedup', example='true'),
  }(name='Dedup', position='Body'),
  documents?: [ 
    {
      name?: string(name='Name', example='CHANGELOG.md'),
      path?: string(name='Path', description='本地上传时为预签名上传使用的批次相对路径；不同 ImportType 下含义由导入类型定义。', example='2026_06_23_17_49_52WwGSUezpG2u2iHWxyYGzkf9KtormhkxN/CHANGELOG.md'),
      size?: long(name='Size', example='1024'),
    }
  ](name='Documents', position='Body'),
  importType?: string(name='ImportType', description='当前支持 LOCAL_UPLOAD；OSS_IMPORT 和 PUBLIC_URL 为后续导入方式预留。', example='LOCAL_UPLOAD', position='Body'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', example='kb-3bd02617e9be335f', position='Body'),
  metaFields?: any(name='MetaFields', description='导入时批量设置到本批次所有知识数据的标签键值。Key 必须为知识库已定义标签字段；Value 支持 string、int64、float32、bool、list。', example='{"department":"legal","topics":["policy","contract"],"reviewed":true}', position='Body'),
  strategyId?: string(name='StrategyId', example='kb-strategy-7043984ca395eabd', position='Body'),
  dingTalkConfiguration?: {
    appId?: string(name='appId', example='ignore'),
    appPassword?: string(name='appPassword', example='ignore'),
    dingDocMcpLink?: string(name='dingDocMcpLink', example='ignore'),
    dingTableMcpLink?: string(name='dingTableMcpLink', example='ignore'),
    knowledgeId?: string(name='knowledgeId', example='ignore'),
    knowledgeType?: string(name='knowledgeType', example='ignore'),
    userId?: string(name='userId', example='ignore'),
  }(name='dingTalkConfiguration', position='Body'),
  parentId?: string(name='parentId', description='Defaults to root when omitted.', example='root', position='Body'),
}

model AddDocumentsResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', example='0'),
  data?: {
    documents?: [ 
      {
        chunkCount?: int32(name='chunkCount', example='0'),
        chunkMethod?: string(name='chunkMethod', example='naive'),
        datasetId?: string(name='datasetId', example='kb-123'),
        id?: string(name='id', example='doc-123'),
        location?: string(name='location', example='uploaded/doc-id/example.pdf'),
        name?: string(name='name', example='example.pdf'),
        progress?: float(name='progress', example='0'),
        run?: string(name='run', example='RUNNING'),
        size?: long(name='size', example='1024'),
        suffix?: string(name='suffix', example='pdf'),
        thumbnail?: string(name='thumbnail', example='""'),
        tokenCount?: int32(name='tokenCount', example='0'),
      }
    ](name='documents'),
    errors?: [ string ](name='errors'),
  }(name='data'),
  httpStatusCode?: int32(name='httpStatusCode', example='403'),
  message?: string(name='message', example='success'),
  requestId?: string(name='requestId', example='DDDBE0E5-4314-156F-B7F1-C4BCFD25A509'),
  success?: boolean(name='success', example='true'),
}

model AddDocumentsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDocumentsResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddDocuments  AddDocumentsRequest
  * @return AddDocumentsResponse
 */
async function addDocuments(request: AddDocumentsRequest): AddDocumentsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddDocuments', 'POST', '/api/v1/datasets/{datasetId}/documents/addDocuments', 'json', false, 'json', request);
}

model GetKnowledgeBasePreSignedUrlRequest {
  datasetId?: string(name='datasetId', example='kb-3bd02617e9be335f', position='Path'),
  documents?: [ 
    {
      name?: string(name='Name', example='CHANGELOG.md'),
      path?: string(name='Path', description='本地上传时为预签名上传使用的批次相对路径；不同 ImportType 下含义由导入类型定义。', example='contract-2026.md'),
      size?: long(name='Size', example='1024'),
    }
  ](name='Documents', position='Body'),
  expiresIn?: int32(name='ExpiresIn', example='3600', position='Body'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', example='kb-3bd02617e9be335f', position='Body'),
}

model GetKnowledgeBasePreSignedUrlResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', example='0'),
  data?: {
    bucketName?: string(name='bucketName', example='knowledgebase-fileupload'),
    expiresIn?: int32(name='expiresIn', example='3600'),
    preSignedUrls?: [ string ](name='preSignedUrls'),
  }(name='data'),
  httpStatusCode?: int32(name='httpStatusCode', example='403'),
  success?: boolean(name='success', example='true'),
}

model GetKnowledgeBasePreSignedUrlResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetKnowledgeBasePreSignedUrlResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetKnowledgeBasePreSignedUrl  GetKnowledgeBasePreSignedUrlRequest
  * @return GetKnowledgeBasePreSignedUrlResponse
 */
async function getKnowledgeBasePreSignedUrl(request: GetKnowledgeBasePreSignedUrlRequest): GetKnowledgeBasePreSignedUrlResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetKnowledgeBasePreSignedUrl', 'POST', '/api/v1/datasets/{datasetId}/getKnowledgeBasePreSignedUrl', 'json', false, 'json', request);
}

model SearchKnowledgeBaseRequest {
  knowledgeBaseId?: string(name='knowledgeBaseId', description='待检索的知识库 ID。', example='kd-620ad908ec651', position='Path'),
  documentIds?: [ string ](name='documentIds', description='限定检索的文档；空数组表示检索该知识库下的全部文档。', position='Body'),
  enableKnowledgeGraph?: boolean(name='enableKnowledgeGraph', description='是否在检索中使用知识图谱。', example='false', position='Body'),
  image?: {
    base64?: string(name='base64', example='data:image/png;base64,iVBORw0KGgoAAA...'),
    objectKey?: string(name='objectKey', example='uploaded/invoice.png'),
    url?: string(name='url', example='https://example.com/invoice.png'),
  }(name='image', description='url、base64、objectKey 必须且只能填写一个。', position='Body'),
  pageNumber?: int32(name='pageNumber', description='从 1 开始。', example='1', position='Body'),
  pageSize?: int32(name='pageSize', example='5', position='Body'),
  query?: string(name='query', description='自然语言检索问题。与 image 至少填写一项。', example='发票的税额是多少？', position='Body'),
  rerankModelId?: long(name='rerankModelId', description='租户模型服务中的数字重排模型 ID。未填写 rerankModelName 时生效。', example='123', position='Body'),
  rerankModelName?: string(name='rerankModelName', description='租户已开通的重排模型名称。同时填写 rerankModelId 时，本参数优先生效。', example='qwen3-rerank', position='Body'),
  retrievalConfig?: {
    candidateCount?: int32(name='candidateCount', description='召回阶段候选切片数量，取值范围 1 到 2048。', example='5'),
    enableQueryExpansion?: boolean(name='enableQueryExpansion', description='是否在检索前扩展查询关键词。', example='true'),
    minScore?: float(name='minScore', description='低于该分数的结果会被过滤，取值范围 0 到 1。', example='0.2'),
    semanticWeight?: float(name='semanticWeight', description='语义得分在混合相关度中的权重，取值范围 0 到 1。', example='0.5'),
    translationLanguages?: [ string ](name='translationLanguages', description='需要同时检索的目标语言；空数组表示不做跨语言扩展。'),
  }(name='retrievalConfig', position='Body'),
  tagFilter?: {
    conditions?: [ 
      {
        field?: string(name='field', description='知识库中已配置的标签字段名。', example='category'),
        op?: string(name='op', description='后端实际操作符，例如 =、≠、contains、not contains、in、not in、start with、end with、empty、not empty、>、<、≥、≤。', example='in'),
        value?: any(name='value', description='比较值；in/not in 可填写数组，empty/not empty 可不填写。', example='invoice'),
      }
    ](name='conditions'),
    relation?: string(name='relation', description='多个条件之间的关系，填写 and 或 or。', example='or'),
  }(name='tagFilter', description='按知识库文档标签过滤检索范围。操作符填写后端实际支持值并原样执行。', position='Body'),
  version?: string(name='version', description='填写 DRAFT、LATEST_PUBLISHED 或显示版本号 vN，不填写时检索编辑态。', example='v1', position='Body'),
}

model SearchKnowledgeBaseResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:SearchKnowledgeBase"}'),
  code?: int32(name='code', example='0'),
  httpStatusCode?: int32(name='httpStatusCode', example='0'),
  message?: string(name='message', example='success'),
  pageNumber?: int32(name='pageNumber', example='1'),
  pageSize?: int32(name='pageSize', example='5'),
  queryLabels?: [ string ](name='queryLabels'),
  requestId?: string(name='requestId', example='019FCC42-90DE-56D3-A10D-3C06995DED17'),
  results?: [ 
    {
      chunkId?: string(name='chunkId', example='7f0de3e041322a1d'),
      content?: string(name='content', description='原始可读文本或表格 HTML。', example='税额 1.59'),
      contentType?: string(name='contentType', example='table'),
      documentId?: string(name='documentId', example='539ddb688fe811f182f637422a0713b5'),
      documentName?: string(name='documentName', example='invoice.pdf'),
      images?: [ 
        {
          imageId?: string(name='imageId', example='kd-620ad908ec651-41253795bafd7a1c'),
          url?: string(name='url', description='签名 URL 可能过期，客户端不应持久化。', example='https://example.com/signed-image'),
        }
      ](name='images'),
      knowledgeBaseId?: string(name='knowledgeBaseId', example='kd-xxxxxxxxxx'),
      locations?: [ 
        {
          bottom?: int32(name='bottom', example='364'),
          left?: int32(name='left', example='13'),
          pageNumber?: int32(name='pageNumber', example='1'),
          right?: int32(name='right', example='566'),
          top?: int32(name='top', example='12'),
        }
      ](name='locations'),
      mediaEndMs?: long(name='mediaEndMs', description='音频或视频切片在原始媒体中的结束时间，单位为毫秒；非媒体切片不返回。', example='8400'),
      mediaStartMs?: long(name='mediaStartMs', description='音频或视频切片在原始媒体中的开始时间，单位为毫秒；非媒体切片不返回。', example='1250'),
      mediaTimeline?: [ 
        {
          endMs?: long(name='endMs', example='4200'),
          startMs?: long(name='startMs', example='1250'),
          text?: string(name='text', example='第一句话。'),
        }
      ](name='mediaTimeline', description='切片内逐句或逐段内容在原始媒体中的时间范围；非音频切片不返回。'),
      parentChunkId?: string(name='parentChunkId', description='无父切片时为 null。', example='parent-chunk-id'),
      scalarFields?: any(name='scalarFields', example='{"question":"How do I reset it?","category":"account"}'),
      score?: float(name='score', example='0.26136884'),
      scoreDetails?: {
        keywordScore?: float(name='keywordScore', example='0.0000000014285714'),
        semanticScore?: float(name='semanticScore', example='0.5227377'),
      }(name='scoreDetails'),
      tags?: [ string ](name='tags'),
    }
  ](name='results'),
  success?: boolean(name='success', example='true'),
  totalCount?: long(name='totalCount', example='2'),
}

model SearchKnowledgeBaseResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SearchKnowledgeBaseResponseBody(name='body'),
}

/**
  * @description 按问题或图片检索指定知识库。版本使用 DRAFT、LATEST_PUBLISHED 或 vN 展示名，标签过滤条件按后端实际操作符传入。
  * @param request  the request parameters of SearchKnowledgeBase  SearchKnowledgeBaseRequest
  * @return SearchKnowledgeBaseResponse
 */
async function searchKnowledgeBase(request: SearchKnowledgeBaseRequest): SearchKnowledgeBaseResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'SearchKnowledgeBase', 'POST', '/api/v1/knowledge-bases/{knowledgeBaseId}/search', 'json', false, 'json', request);
}

