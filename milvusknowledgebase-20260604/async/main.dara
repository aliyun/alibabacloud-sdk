This parameter is required.', example='DRAFT'),
        }
      ](name='sourceRefs', description='Required. Always returned. The actually supported sources. Constraints: {"minItems":1,"maxItems":1000}.

This parameter is required.', example='[{"documentId":"doc_manual","chunkId":"chunk_1","sourceRevisionId":"source_rev_7","version":"DRAFT","contentHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]'),
