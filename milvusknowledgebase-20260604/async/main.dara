}

model SearchKnowledgeBaseResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SearchKnowledgeBaseResponseBody(name='body'),
}

/**
  * @description Searches a specified knowledge base by using a query or an image. For the version, use the display name DRAFT, LATEST_PUBLISHED, or vN. Pass tag filter conditions based on the actual operators used by the backend.
  * @param request  the request parameters of SearchKnowledgeBase  SearchKnowledgeBaseRequest
  * @return SearchKnowledgeBaseResponse
 */
async function searchKnowledgeBase(request: SearchKnowledgeBaseRequest): SearchKnowledgeBaseResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'SearchKnowledgeBase', 'POST', '/api/v1/knowledge-bases/{knowledgeBaseId}/search', 'json', false, 'json', request);
}

