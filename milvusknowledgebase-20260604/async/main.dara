          chunkId: string(name='chunkId', description='Required. Always returned. The opaque business ID generated by the server. Validates ownership and does not accept arbitrary paths. Constraints: {"minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}.

This parameter is required.', example='example_value'),
          documentId: string(name='documentId', description='Required. Always returned. The opaque business ID generated by the server. Validates ownership and does not accept arbitrary paths. Constraints: {"minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}.

This parameter is required.', example='example_value'),
          documentName?: string(name='documentName', description='Optional. Conditionally returned. The document name returned only after authorization. Constraints: {"maxLength":1024}.', example='example_value'),
          mediaEndMs?: long(name='mediaEndMs', description='Optional. Conditionally returned. Null is allowed. The semantics of null values follow the field description. Null is allowed. The not-equal-to condition can be omitted. Constraints: {"minimum":0,"maximum":9223372036854775807}.', example='0'),
          mediaStartMs?: long(name='mediaStartMs', description='Optional. Conditionally returned. Null is allowed. The semantics of null values follow the field description. Null is allowed. The not-equal-to condition can be omitted. Constraints: {"minimum":0,"maximum":9223372036854775807}.', example='0'),
          pageNumber?: long(name='pageNumber', description='Optional. Conditionally returned. Null is allowed. The semantics of null values follow the field description. Null is allowed. The not-equal-to condition can be omitted. Constraints: {"minimum":1,"maximum":9223372036854775807}.', example='1'),
          sourceRevisionId: string(name='sourceRevisionId', description='Required. Always returned. The opaque business ID generated by the server. Validates ownership and does not accept arbitrary paths. Constraints: {"minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}.

