      relationId: string(name='relationId', description='Required. Always returned. Null is allowed. The semantics of null values follow the field description. Null is allowed. The not-equal-to condition can be omitted. Constraints: {"minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}.

This parameter is required.', example='null'),
      revisionId: string(name='revisionId', description='Required. Always returned. The opaque business ID generated by the server. Validates ownership and does not accept arbitrary paths. Constraints: {"minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}.

This parameter is required.', example='example_value'),
      score: double(name='score', description='Required. Always returned. The finite numerical value used for unified ranking. For hybrid, it is the relevance of the existing Dealer.rerank. For rerank, it is the text and model hybrid relevance of the existing Dealer.rerank_by_model, along the semanticWeight and rank feature, which is not a relevance probability. The minScore is applied according to the existing unified scoring rules. Can be null for non-ranking fact evidence. Null is allowed. The not-equal-to condition can be omitted.

This parameter is required.', example='0.62'),
      sectionId: string(name='sectionId', description='Required. Always returned. Null is allowed. The semantics of null values follow the field description. Null is allowed. The not-equal-to condition can be omitted. Constraints: {"minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}.

This parameter is required.', example='sec_1'),
      sourceRefCount: long(name='sourceRefCount', description='Required. Always returned. The total number of source chunk references. Authorization is performed on the full set. Constraints: {"minimum":1,"maximum":9223372036854775807}.

This parameter is required.', example='1'),
      sourceRefs: [ 
