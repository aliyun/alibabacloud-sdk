  evidenceNextToken?: string(name='evidenceNextToken', description='Optional. Conditionally returned. Required when includeWiki is set to true. The cursor for the next page of evidence. Null for the last page. Not used for legacy results pagination. Null is allowed. The not-equal-to condition can be omitted. Constraints: {"minLength":1,"maxLength":4096}.', example='example-opaque-next-token'),
  evidenceResults?: [ 
