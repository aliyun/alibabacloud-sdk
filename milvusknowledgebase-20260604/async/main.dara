      locations?: [ 
        {
          bottom?: int32(name='bottom', description='The bottom edge.', example='364'),
          left?: int32(name='left', description='The left edge.', example='13'),
          pageNumber?: int32(name='pageNumber', description='The page number.', example='1'),
          right?: int32(name='right', description='The right edge.', example='566'),
          top?: int32(name='top', description='The top edge.', example='12'),
        }
      ](name='locations', description='The list of document locations.'),
      mediaEndMs?: long(name='mediaEndMs', description='The end time of the audio or video chunk in the original media, in milliseconds. This parameter is not returned for non-media chunks.', example='8400'),
      mediaStartMs?: long(name='mediaStartMs', description='The start time of the audio or video chunk in the original media, in milliseconds. This parameter is not returned for non-media chunks.', example='1250'),
      mediaTimeline?: [ 
        {
          endMs?: long(name='endMs', description='The end time of the segment.', example='4200'),
          startMs?: long(name='startMs', description='The start time of the segment.', example='1250'),
          text?: string(name='text', description='The text of the segment.', example='The first sentence'),
        }
      ](name='mediaTimeline', description='The time range of each sentence or paragraph within the chunk in the original media. This parameter is not returned for non-audio chunks.'),
      parentChunkId?: string(name='parentChunkId', description='The parent chunk ID.', example='parent-chunk-id'),
      scalarFields?: any(name='scalarFields', description='The scalar columns of the structured knowledge base. The columns are returned by their original names and are not used for retrieval.', example='{"question":"How do I reset it?","category":"account"}'),
