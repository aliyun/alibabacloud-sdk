import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'MilvusKnowledgeBase';
  @version = '2026-06-04';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddDocumentsRequest {
  datasetId?: string(name='datasetId', description='The knowledge base ID.', example='kd-03ec1e2385fcf', position='Path'),
  dedup?: {
    contentDedup?: boolean(name='ContentDedup', description='Specifies whether to enable content deduplication.', example='true'),
    docNameDedup?: boolean(name='DocNameDedup', description='Specifies whether to enable document name deduplication.', example='true'),
  }(name='Dedup', description='The deduplication configuration.', position='Body'),
  documents?: [ 
    {
      name?: string(name='Name', description='The document name.', example='CHANGELOG.md'),
      path?: string(name='Path', description='The document path. This is the file name or relative path used during upload, which must be consistent with the pre-signed URL request.', example='2026_06_23_17_49_52WwGSUezpG2u2iHWxyYGzkf9KtormhkxN/CHANGELOG.md'),
      size?: long(name='Size', description='The file size.', example='1024'),
      strategyId?: string(name='StrategyId', description='The processing strategy ID.', example='kb-strategy-7043984ca395eabd'),
    }
  ](name='Documents', description='The list of documents.', position='Body'),
  importType?: string(name='ImportType', description='The import type.', example='LOCAL_UPLOAD', position='Body'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', description='The knowledge base ID.', example='kb-3bd02617e9be335f', position='Body'),
  metaFields?: any(name='MetaFields', description='The batch label configuration. The key must be a label field that is already defined in the knowledge base. The value supports string, int64, float32, bool, and list types.', example='{"department":"legal","topics":["policy","contract"],"reviewed":true}', position='Body'),
  strategyId?: string(name='StrategyId', description='The processing strategy ID.', example='kb-strategy-7043984ca395eabd', position='Body'),
  dingTalkConfiguration?: {
    appId?: string(name='appId', description='Not supported. Ignore this parameter.', example='ignore'),
    appPassword?: string(name='appPassword', description='Not supported. Ignore this parameter.', example='ignore'),
    dingDocMcpLink?: string(name='dingDocMcpLink', description='Not supported. Ignore this parameter.', example='ignore'),
    dingTableMcpLink?: string(name='dingTableMcpLink', description='Not supported. Ignore this parameter.', example='ignore'),
    knowledgeId?: string(name='knowledgeId', description='Not supported. Ignore this parameter.', example='ignore'),
    knowledgeType?: string(name='knowledgeType', description='Not supported. Ignore this parameter.', example='ignore'),
    userId?: string(name='userId', description='Not supported. Ignore this parameter.', example='ignore'),
  }(name='dingTalkConfiguration', description='Not supported. Ignore this parameter.', position='Body'),
  parentId?: string(name='parentId', description='Defaults to root when omitted.', example='root', position='Body'),
}

model AddDocumentsResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the permission verification failure.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', description='The status code.', example='0'),
  data?: {
    documents?: [ 
      {
        chunkCount?: int32(name='chunkCount', description='The chunk count.', example='0'),
        chunkMethod?: string(name='chunkMethod', description='The chunk method.', example='naive'),
        datasetId?: string(name='datasetId', description='The knowledge base ID.', example='kb-123'),
        id?: string(name='id', description='The document ID.', example='doc-123'),
        location?: string(name='location', description='The object path.', example='uploaded/doc-id/example.pdf'),
        name?: string(name='name', description='The document name.', example='example.pdf'),
        progress?: float(name='progress', description='The processing progress.', example='0'),
        run?: string(name='run', description='The processing status.', example='RUNNING'),
        size?: long(name='size', description='The file size.', example='1024'),
        suffix?: string(name='suffix', description='The file extension.', example='pdf'),
        thumbnail?: string(name='thumbnail', description='The thumbnail.', example='""'),
        tokenCount?: int32(name='tokenCount', description='The token count.', example='0'),
      }
    ](name='documents', description='The list of documents.'),
    errors?: [ string ](name='errors', description='The list of errors.'),
  }(name='data', description='The response data.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='403'),
  message?: string(name='message', description='The response message.', example='success'),
  requestId?: string(name='requestId', description='The request ID.', example='DDDBE0E5-4314-156F-B7F1-C4BCFD25A509'),
  success?: boolean(name='success', description='Indicates whether the request was successful.', example='true'),
}

model AddDocumentsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDocumentsResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddDocuments  AddDocumentsRequest
  * @return AddDocumentsResponse
 */
async function addDocuments(request: AddDocumentsRequest): AddDocumentsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddDocuments', 'POST', '/api/v1/datasets/{datasetId}/documents/addDocuments', 'json', false, 'json', request);
}

model GetKnowledgeBasePreSignedUrlRequest {
  datasetId?: string(name='datasetId', description='The knowledge base ID.', example='kb-3bd02617e9be335f', position='Path'),
  documents?: [ 
    {
      name?: string(name='Name', description='The display name of the file. If not specified, the file name from Path is used.', example='CHANGELOG.md'),
      path?: string(name='Path', description='The file name or relative path for local upload scenarios. The value cannot start with `direct_upload/` or `uploaded/`, cannot contain empty segments, `.`, or `..`, and must be 1024 bytes or less.', example='contract-2026.md'),
      size?: long(name='Size', description='The file size in bytes.', example='1024'),
    }
  ](name='Documents', description='The list of files to upload. You can specify 1 to 100 files.', position='Body'),
  expiresIn?: int32(name='ExpiresIn', description='The validity period of the pre-signed URL in seconds. Default value: `3600`.', example='3600', position='Body'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', description='The knowledge base ID. Either this parameter or datasetId must be specified. This parameter takes priority.', example='kb-3bd02617e9be335f', position='Body'),
}

model GetKnowledgeBasePreSignedUrlResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the permission verification failure.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', description='The business status code.', example='0'),
  data?: {
    bucketName?: string(name='bucketName', description='The bucket name.', example='knowledgebase-fileupload'),
    expiresIn?: int32(name='expiresIn', description='The validity period of the pre-signed URL in seconds.', example='3600'),
    preSignedUrls?: [ string ](name='preSignedUrls', description='The list of pre-signed PUT URLs. **The order corresponds one-to-one with the `Documents` in the request.**'),
  }(name='data', description='The response data.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='403'),
  success?: boolean(name='success', description='Indicates whether the request was successful.', example='true'),
}

model GetKnowledgeBasePreSignedUrlResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetKnowledgeBasePreSignedUrlResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetKnowledgeBasePreSignedUrl  GetKnowledgeBasePreSignedUrlRequest
  * @return GetKnowledgeBasePreSignedUrlResponse
 */
async function getKnowledgeBasePreSignedUrl(request: GetKnowledgeBasePreSignedUrlRequest): GetKnowledgeBasePreSignedUrlResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetKnowledgeBasePreSignedUrl', 'POST', '/api/v1/datasets/{datasetId}/getKnowledgeBasePreSignedUrl', 'json', false, 'json', request);
}

model SearchKnowledgeBaseRequest {
  knowledgeBaseId?: string(name='knowledgeBaseId', description='The ID of the knowledge base.', example='kd-620ad908ec651', position='Path'),
  documentIds?: [ string ](name='documentIds', description='The list of document IDs.', position='Body'),
  enableKnowledgeGraph?: boolean(name='enableKnowledgeGraph', description='Specifies whether to enable the knowledge graph.', example='false', position='Body'),
  evidencePageToken?: string(name='evidencePageToken', description='Optional. This parameter is returned conditionally and can be passed only when includeWiki is set to true. Omit this parameter for the first evidence page. For subsequent pages, pass the evidenceNextToken from the previous page as is. The candidate pool, subject, parameters, and page size are fixed and expire after 5 minutes without renewal. If the token expires, a 409 error is returned and no automatic re-search is performed. The pageNumber parameter only controls the legacy results. Constraints: {"minLength":1,"maxLength":4096}.', example='example-opaque-next-token', position='Body'),
  image?: {
    base64?: string(name='base64', description='The Base64-encoded image.', example='data:image/png;base64,iVBORw0KGgoAAA...'),
    objectKey?: string(name='objectKey', description='The object key of the image.', example='uploaded/invoice.png'),
    url?: string(name='url', description='The URL of the image.', example='https://example.com/invoice.png'),
  }(name='image', description='The image search input.', position='Body'),
  includeWiki?: boolean(name='includeWiki', description='Optional. This parameter is returned conditionally and is added for compatibility. Default value: false. If set to true, the unified evidenceResults are additionally returned, and Wiki content is not disguised as original text. Constraints: {"default":false}.', example='true', position='Body'),
  pageNumber?: int32(name='pageNumber', description='The page number.', example='1', position='Body'),
  pageSize?: int32(name='pageSize', description='The number of items per page.', example='5', position='Body'),
  query?: string(name='query', description='The search query.', example='What is the tax amount on the invoice?', position='Body'),
  rerankModelId?: long(name='rerankModelId', description='The ID of the rerank model.', example='123', position='Body'),
  rerankModelName?: string(name='rerankModelName', description='The name of the rerank model activated for the tenant. If both rerankModelId and this parameter are specified, this parameter takes precedence.', example='qwen3-rerank', position='Body'),
  retrievalConfig?: {
    candidateCount?: int32(name='candidateCount', description='The number of recalled candidates.', example='5'),
    enableQueryExpansion?: boolean(name='enableQueryExpansion', description='Specifies whether to enable query expansion.', example='true'),
    minScore?: float(name='minScore', description='The minimum relevance score.', example='0.2'),
    semanticWeight?: float(name='semanticWeight', description='The weight of semantic relevance.', example='0.5'),
    translationLanguages?: [ string ](name='translationLanguages', description='The list of translation languages.'),
  }(name='retrievalConfig', description='The retrieval configuration.', position='Body'),
  tagFilter?: {
    conditions?: [ 
      {
        field?: string(name='field', description='The tag field.', example='category'),
        op?: string(name='op', description='The operator.', example='in'),
        value?: any(name='value', description='The tag value.', example='invoice'),
      }
    ](name='conditions', description='The list of tag conditions.'),
    relation?: string(name='relation', description='The logical relation between conditions.', example='or'),
  }(name='tagFilter', description='The tag filter.', position='Body'),
  version?: string(name='version', description='The version of the knowledge base.', example='v1', position='Body'),
}

