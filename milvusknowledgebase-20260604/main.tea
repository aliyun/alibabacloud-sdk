import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('milvusknowledgebase', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AddDocumentsRequest {
  dedup?: {
    contentDedup?: boolean(name='ContentDedup', example='true'),
    docNameDedup?: boolean(name='DocNameDedup', example='true'),
  }(name='Dedup'),
  documents?: [ 
    {
      name?: string(name='Name', example='CHANGELOG.md'),
      path?: string(name='Path', description='本地上传时为预签名上传使用的批次相对路径；不同 ImportType 下含义由导入类型定义。', example='2026_06_23_17_49_52WwGSUezpG2u2iHWxyYGzkf9KtormhkxN/CHANGELOG.md'),
      size?: long(name='Size', example='1024'),
    }
  ](name='Documents'),
  importType?: string(name='ImportType', description='当前支持 LOCAL_UPLOAD；OSS_IMPORT 和 PUBLIC_URL 为后续导入方式预留。', example='LOCAL_UPLOAD'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', example='kb-3bd02617e9be335f'),
  metaFields?: any(name='MetaFields', description='导入时批量设置到本批次所有知识数据的标签键值。Key 必须为知识库已定义标签字段；Value 支持 string、int64、float32、bool、list。', example='{"department":"legal","topics":["policy","contract"],"reviewed":true}'),
  strategyId?: string(name='StrategyId', example='kb-strategy-7043984ca395eabd'),
  dingTalkConfiguration?: {
    appId?: string(name='appId', example='ignore'),
    appPassword?: string(name='appPassword', example='ignore'),
    dingDocMcpLink?: string(name='dingDocMcpLink', example='ignore'),
    dingTableMcpLink?: string(name='dingTableMcpLink', example='ignore'),
    knowledgeId?: string(name='knowledgeId', example='ignore'),
    knowledgeType?: string(name='knowledgeType', example='ignore'),
    userId?: string(name='userId', example='ignore'),
  }(name='dingTalkConfiguration'),
}

model AddDocumentsResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', example='0'),
  data?: {
    documents?: [ 
      {
        chunkCount?: int32(name='chunkCount', example='0'),
        chunkMethod?: string(name='chunkMethod', example='naive'),
        datasetId?: string(name='datasetId', example='kb-123'),
        id?: string(name='id', example='doc-123'),
        location?: string(name='location', example='uploaded/doc-id/example.pdf'),
        name?: string(name='name', example='example.pdf'),
        progress?: float(name='progress', example='0'),
        run?: string(name='run', example='RUNNING'),
        size?: long(name='size', example='1024'),
        suffix?: string(name='suffix', example='pdf'),
        thumbnail?: string(name='thumbnail', example='""'),
        tokenCount?: int32(name='tokenCount', example='0'),
      }
    ](name='documents'),
    errors?: [ string ](name='errors'),
  }(name='data'),
  httpStatusCode?: int32(name='httpStatusCode', example='403'),
  message?: string(name='message', example='success'),
  requestId?: string(name='requestId', example='DDDBE0E5-4314-156F-B7F1-C4BCFD25A509'),
  success?: boolean(name='success', example='true'),
}

model AddDocumentsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDocumentsResponseBody(name='body'),
}

/**
 * @summary 添加文档到知识库
 *
 * @param request AddDocumentsRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddDocumentsResponse
 */
async function addDocumentsWithOptions(datasetId: string, request: AddDocumentsRequest, headers: map[string]string, runtime: Util.RuntimeOptions): AddDocumentsResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.dedup)) {
    body['Dedup'] = request.dedup;
  }
  if (!Util.isUnset(request.documents)) {
    body['Documents'] = request.documents;
  }
  if (!Util.isUnset(request.importType)) {
    body['ImportType'] = request.importType;
  }
  if (!Util.isUnset(request.knowledgeBaseId)) {
    body['KnowledgeBaseId'] = request.knowledgeBaseId;
  }
  if (!Util.isUnset(request.metaFields)) {
    body['MetaFields'] = request.metaFields;
  }
  if (!Util.isUnset(request.strategyId)) {
    body['StrategyId'] = request.strategyId;
  }
  if (!Util.isUnset(request.dingTalkConfiguration)) {
    body['dingTalkConfiguration'] = request.dingTalkConfiguration;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'AddDocuments',
    version = '2026-06-04',
    protocol = 'HTTPS',
    pathname = `/api/v1/datasets/${OpenApiUtil.getEncodeParam(datasetId)}/documents/addDocuments`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 添加文档到知识库
 *
 * @param request AddDocumentsRequest
 * @return AddDocumentsResponse
 */
async function addDocuments(datasetId: string, request: AddDocumentsRequest): AddDocumentsResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return addDocumentsWithOptions(datasetId, request, headers, runtime);
}

model GetKnowledgeBasePreSignedUrlRequest {
  documents?: [ 
    {
      name?: string(name='Name', example='CHANGELOG.md'),
      path?: string(name='Path', description='本地上传时为预签名上传使用的批次相对路径；不同 ImportType 下含义由导入类型定义。', example='contract-2026.md'),
      size?: long(name='Size', example='1024'),
    }
  ](name='Documents'),
  expiresIn?: int32(name='ExpiresIn', example='3600'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', example='kb-3bd02617e9be335f'),
