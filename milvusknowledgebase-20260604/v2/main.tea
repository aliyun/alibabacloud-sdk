import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('milvusknowledgebase', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AddDocumentsRequest {
  dedup?: {
    contentDedup?: boolean(name='ContentDedup', description='Specifies whether to enable content deduplication.', example='true'),
    docNameDedup?: boolean(name='DocNameDedup', description='Specifies whether to enable document name deduplication.', example='true'),
  }(name='Dedup', description='The deduplication configuration.'),
  documents?: [ 
    {
      name?: string(name='Name', description='The name of the document.', example='CHANGELOG.md'),
      path?: string(name='Path', description='The document path. This is the file name or relative path used during upload, which must be consistent with the pre-signed request.', example='2026_06_23_17_49_52WwGSUezpG2u2iHWxyYGzkf9KtormhkxN/CHANGELOG.md'),
      size?: long(name='Size', description='The size of the file.', example='1024'),
    }
  ](name='Documents', description='The list of documents.'),
  importType?: string(name='ImportType', description='The import type.', example='LOCAL_UPLOAD'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', description='The ID of the knowledge base.', example='kb-3bd02617e9be335f'),
  metaFields?: any(name='MetaFields', description='The batch label configuration. The key must be a label field defined in the knowledge base. The value supports string, int64, float32, bool, and list types.', example='{"department":"legal","topics":["policy","contract"],"reviewed":true}'),
  strategyId?: string(name='StrategyId', description='The ID of the processing strategy.', example='kb-strategy-7043984ca395eabd'),
  dingTalkConfiguration?: {
    appId?: string(name='appId', description='Not supported. Ignore this parameter.', example='ignore'),
    appPassword?: string(name='appPassword', description='Not supported. Ignore this parameter.', example='ignore'),
    dingDocMcpLink?: string(name='dingDocMcpLink', description='Not supported. Ignore this parameter.', example='ignore'),
    dingTableMcpLink?: string(name='dingTableMcpLink', description='Not supported. Ignore this parameter.', example='ignore'),
    knowledgeId?: string(name='knowledgeId', description='Not supported. Ignore this parameter.', example='ignore'),
    knowledgeType?: string(name='knowledgeType', description='Not supported. Ignore this parameter.', example='ignore'),
    userId?: string(name='userId', description='Not supported. Ignore this parameter.', example='ignore'),
  }(name='dingTalkConfiguration', description='Not supported. Ignore this parameter.'),
  parentId?: string(name='parentId', description='Defaults to root when omitted.', example='root'),
}

model AddDocumentsResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the permission verification failure.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', description='The status code.', example='0'),
  data?: {
    documents?: [ 
      {
        chunkCount?: int32(name='chunkCount', description='The chunk count.', example='0'),
        chunkMethod?: string(name='chunkMethod', description='The chunk method.', example='naive'),
        datasetId?: string(name='datasetId', description='The ID of the knowledge base.', example='kb-123'),
        id?: string(name='id', description='The document ID.', example='doc-123'),
        location?: string(name='location', description='The object path.', example='uploaded/doc-id/example.pdf'),
        name?: string(name='name', description='The name of the document.', example='example.pdf'),
        progress?: float(name='progress', description='The processing progress.', example='0'),
        run?: string(name='run', description='The processing status.', example='RUNNING'),
        size?: long(name='size', description='The size of the file.', example='1024'),
        suffix?: string(name='suffix', description='The file extension.', example='pdf'),
        thumbnail?: string(name='thumbnail', description='The thumbnail.', example='""'),
        tokenCount?: int32(name='tokenCount', description='The token count.', example='0'),
      }
    ](name='documents', description='The list of documents.'),
    errors?: [ string ](name='errors', description='The list of errors.'),
  }(name='data', description='The response data.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='403'),
  message?: string(name='message', description='The response message.', example='success'),
  requestId?: string(name='requestId', description='The request ID.', example='DDDBE0E5-4314-156F-B7F1-C4BCFD25A509'),
  success?: boolean(name='success', description='Indicates whether the request was successful.', example='true'),
}

model AddDocumentsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDocumentsResponseBody(name='body'),
}

/**
 * @summary Registers files that are uploaded to the knowledge base storage as knowledge base documents and **automatically triggers parsing** (chunking and embedding). Two import types are supported:
 * - `LOCAL_UPLOAD`: Works with the `GetKnowledgeBasePreSignedUrl` direct upload flow. This operation only registers the file and does not verify whether the file is actually uploaded. Therefore, you must complete the PUT upload before calling this operation.
 * - `OSS_IMPORT`: Imports files from an external OSS bucket. The operation creates an asynchronous import task and returns a `knowledge_import_task_id`. The system downloads and registers the files in the background.
 * A maximum of 100 files can be registered in a single request.
 *
 * @param request AddDocumentsRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddDocumentsResponse
 */
@context("addDocumentsWithContext")
async function addDocumentsWithOptions(datasetId: string, request: AddDocumentsRequest, headers: map[string]string, runtime: $RuntimeOptions): AddDocumentsResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.dedup)) {
    body['Dedup'] = request.dedup;
  }
  if (!$isNull(request.documents)) {
    body['Documents'] = request.documents;
  }
  if (!$isNull(request.importType)) {
    body['ImportType'] = request.importType;
  }
  if (!$isNull(request.knowledgeBaseId)) {
    body['KnowledgeBaseId'] = request.knowledgeBaseId;
  }
  if (!$isNull(request.metaFields)) {
    body['MetaFields'] = request.metaFields;
  }
  if (!$isNull(request.strategyId)) {
    body['StrategyId'] = request.strategyId;
  }
  if (!$isNull(request.dingTalkConfiguration)) {
    body['dingTalkConfiguration'] = request.dingTalkConfiguration;
  }
  if (!$isNull(request.parentId)) {
    body['parentId'] = request.parentId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddDocuments',
    version = '2026-06-04',
    protocol = 'HTTPS',
    pathname = `/api/v1/datasets/${$URL.percentEncode(datasetId)}/documents/addDocuments`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Registers files that are uploaded to the knowledge base storage as knowledge base documents and **automatically triggers parsing** (chunking and embedding). Two import types are supported:
 * - `LOCAL_UPLOAD`: Works with the `GetKnowledgeBasePreSignedUrl` direct upload flow. This operation only registers the file and does not verify whether the file is actually uploaded. Therefore, you must complete the PUT upload before calling this operation.
 * - `OSS_IMPORT`: Imports files from an external OSS bucket. The operation creates an asynchronous import task and returns a `knowledge_import_task_id`. The system downloads and registers the files in the background.
 * A maximum of 100 files can be registered in a single request.
 *
 * @param request AddDocumentsRequest
 * @return AddDocumentsResponse
 */
async function addDocuments(datasetId: string, request: AddDocumentsRequest): AddDocumentsResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return addDocumentsWithOptions(datasetId, request, headers, runtime);
}

model GetKnowledgeBasePreSignedUrlRequest {
  documents?: [ 
    {
      name?: string(name='Name', description='The display name of the file. If not specified, the file name from Path is used.', example='CHANGELOG.md'),
      path?: string(name='Path', description='The file name or relative path for local upload scenarios. The value cannot start with `direct_upload/` or `uploaded/`, cannot contain empty segments, `.`, or `..`, and must be 1024 bytes or less.', example='contract-2026.md'),
      size?: long(name='Size', description='The file size in bytes.', example='1024'),
    }
  ](name='Documents', description='The list of files to upload. You can specify 1 to 100 files.'),
  expiresIn?: int32(name='ExpiresIn', description='The validity period of the pre-signed URL in seconds. Default value: `3600`.', example='3600'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', description='The knowledge base ID. Either this parameter or datasetId must be specified. This parameter takes priority.', example='kb-3bd02617e9be335f'),
}

model GetKnowledgeBasePreSignedUrlResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the permission verification failure.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', description='The business status code.', example='0'),
  data?: {
    bucketName?: string(name='bucketName', description='The bucket name.', example='knowledgebase-fileupload'),
    expiresIn?: int32(name='expiresIn', description='The validity period of the pre-signed URL in seconds.', example='3600'),
    preSignedUrls?: [ string ](name='preSignedUrls', description='The list of pre-signed PUT URLs. **The order corresponds one-to-one with the `Documents` in the request.**'),
  }(name='data', description='The response data.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='403'),
  success?: boolean(name='success', description='Indicates whether the request was successful.', example='true'),
}

model GetKnowledgeBasePreSignedUrlResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetKnowledgeBasePreSignedUrlResponseBody(name='body'),
}

/**
 * @summary Generates an **OSS pre-signed PUT URL** pointing to the knowledge base dedicated storage for each file in `Documents`. The caller uses the URL to upload file content directly to Object Storage Service (OSS), and then calls `AddDocuments` to register the files. A maximum of 100 files can be processed per request.
 *
 * @param request GetKnowledgeBasePreSignedUrlRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return GetKnowledgeBasePreSignedUrlResponse
 */
@context("getKnowledgeBasePreSignedUrlWithContext")
async function getKnowledgeBasePreSignedUrlWithOptions(datasetId: string, request: GetKnowledgeBasePreSignedUrlRequest, headers: map[string]string, runtime: $RuntimeOptions): GetKnowledgeBasePreSignedUrlResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.documents)) {
    body['Documents'] = request.documents;
  }
  if (!$isNull(request.expiresIn)) {
    body['ExpiresIn'] = request.expiresIn;
  }
  if (!$isNull(request.knowledgeBaseId)) {
    body['KnowledgeBaseId'] = request.knowledgeBaseId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'GetKnowledgeBasePreSignedUrl',
    version = '2026-06-04',
    protocol = 'HTTPS',
    pathname = `/api/v1/datasets/${$URL.percentEncode(datasetId)}/getKnowledgeBasePreSignedUrl`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Generates an **OSS pre-signed PUT URL** pointing to the knowledge base dedicated storage for each file in `Documents`. The caller uses the URL to upload file content directly to Object Storage Service (OSS), and then calls `AddDocuments` to register the files. A maximum of 100 files can be processed per request.
 *
 * @param request GetKnowledgeBasePreSignedUrlRequest
 * @return GetKnowledgeBasePreSignedUrlResponse
 */
async function getKnowledgeBasePreSignedUrl(datasetId: string, request: GetKnowledgeBasePreSignedUrlRequest): GetKnowledgeBasePreSignedUrlResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return getKnowledgeBasePreSignedUrlWithOptions(datasetId, request, headers, runtime);
}

model SearchKnowledgeBaseRequest {
  documentIds?: [ string ](name='documentIds', description='The list of document IDs.'),
  enableKnowledgeGraph?: boolean(name='enableKnowledgeGraph', description='Specifies whether to enable the knowledge graph.', example='false'),
  image?: {
    base64?: string(name='base64', description='The Base64-encoded image.', example='data:image/png;base64,iVBORw0KGgoAAA...'),
    objectKey?: string(name='objectKey', description='The object key of the image.', example='uploaded/invoice.png'),
    url?: string(name='url', description='The image URL.', example='https://example.com/invoice.png'),
  }(name='image', description='The image retrieval input.'),
  pageNumber?: int32(name='pageNumber', description='The page number.', example='1'),
  pageSize?: int32(name='pageSize', description='The number of entries per page.', example='5'),
  query?: string(name='query', description='The query for retrieval.', example='What is the tax amount on the invoice?'),
  rerankModelId?: long(name='rerankModelId', description='The rerank model ID.', example='123'),
  rerankModelName?: string(name='rerankModelName', description='The name of the rerank model that the tenant has activated. If both rerankModelName and rerankModelId are specified, this parameter takes precedence.', example='qwen3-rerank'),
  retrievalConfig?: {
    candidateCount?: int32(name='candidateCount', description='The number of candidate results to recall.', example='5'),
    enableQueryExpansion?: boolean(name='enableQueryExpansion', description='Specifies whether to enable query expansion.', example='true'),
    minScore?: float(name='minScore', description='The minimum relevance score.', example='0.2'),
    semanticWeight?: float(name='semanticWeight', description='The weight of semantic relevance.', example='0.5'),
    translationLanguages?: [ string ](name='translationLanguages', description='The list of translation languages.'),
  }(name='retrievalConfig', description='The retrieval configuration.'),
  tagFilter?: {
    conditions?: [ 
      {
        field?: string(name='field', description='The tag field.', example='category'),
        op?: string(name='op', description='The operator.', example='in'),
        value?: any(name='value', description='The tag value.', example='invoice'),
      }
    ](name='conditions', description='The list of tag conditions.'),
    relation?: string(name='relation', description='The logical relation between conditions.', example='or'),
  }(name='tagFilter', description='The tag filter.'),
  version?: string(name='version', description='The knowledge base version.', example='v1'),
}

model SearchKnowledgeBaseResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the permission verification failure.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:SearchKnowledgeBase"}'),
  code?: int32(name='code', description='The status code.', example='0'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='0'),
  message?: string(name='message', description='The returned message.', example='success'),
  pageNumber?: int32(name='pageNumber', description='The page number.', example='1'),
  pageSize?: int32(name='pageSize', description='The number of entries per page.', example='5'),
  queryLabels?: [ string ](name='queryLabels', description='The query labels.'),
  requestId?: string(name='requestId', description='The request ID.', example='019FCC42-90DE-56D3-A10D-3C06995DED17'),
  results?: [ 
    {
      chunkId?: string(name='chunkId', description='The chunk ID.', example='7f0de3e041322a1d'),
      content?: string(name='content', description='The chunk content.', example='Tax amount 1.59'),
      contentType?: string(name='contentType', description='The content type.', example='table'),
      documentId?: string(name='documentId', description='The document ID.', example='539ddb688fe811f182f637422a0713b5'),
      documentName?: string(name='documentName', description='The document name.', example='invoice.pdf'),
      images?: [ 
        {
          imageId?: string(name='imageId', description='The image ID.', example='kd-620ad908ec651-41253795bafd7a1c'),
          url?: string(name='url', description='The temporary access URL.', example='https://example.com/signed-image'),
        }
      ](name='images', description='The list of associated images.'),
      knowledgeBaseId?: string(name='knowledgeBaseId', description='The knowledge base ID.', example='kd-xxxxxxxxxx'),
      locations?: [ 
        {
          bottom?: int32(name='bottom', description='The bottom boundary.', example='364'),
          left?: int32(name='left', description='The left boundary.', example='13'),
          pageNumber?: int32(name='pageNumber', description='The page number.', example='1'),
          right?: int32(name='right', description='The right boundary.', example='566'),
          top?: int32(name='top', description='The top boundary.', example='12'),
        }
      ](name='locations', description='The list of document locations.'),
      parentChunkId?: string(name='parentChunkId', description='The parent chunk ID.', example='parent-chunk-id'),
      scalarFields?: any(name='scalarFields', description='The scalar columns of the structured knowledge base. The columns are returned by their original column names and are not used in retrieval.', example='{"question":"How do I reset it?","category":"account"}'),
      score?: float(name='score', description='The overall relevance score.', example='0.26136884'),
      scoreDetails?: {
        keywordScore?: float(name='keywordScore', description='The keyword relevance score.', example='0.0000000014285714'),
        semanticScore?: float(name='semanticScore', description='The semantic relevance score.', example='0.5227377'),
      }(name='scoreDetails', description='The relevance score details.'),
      tags?: [ string ](name='tags', description='The list of tags.'),
    }
  ](name='results', description='The list of retrieval results.'),
  success?: boolean(name='success', description='Indicates whether the request was successful.', example='true'),
  totalCount?: long(name='totalCount', description='The total number of results.', example='2'),
}

model SearchKnowledgeBaseResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SearchKnowledgeBaseResponseBody(name='body'),
}

/**
 * @summary Retrieves documents from a knowledge base.
 *
 * @description Retrieves documents from a specified knowledge base by question or image. Use DRAFT, LATEST_PUBLISHED, or vN display names for the version. Pass tag filter conditions using the actual backend operators.
 *
 * @param request SearchKnowledgeBaseRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return SearchKnowledgeBaseResponse
 */
@context("searchKnowledgeBaseWithContext")
async function searchKnowledgeBaseWithOptions(knowledgeBaseId: string, request: SearchKnowledgeBaseRequest, headers: map[string]string, runtime: $RuntimeOptions): SearchKnowledgeBaseResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.documentIds)) {
    body['documentIds'] = request.documentIds;
  }
  if (!$isNull(request.enableKnowledgeGraph)) {
    body['enableKnowledgeGraph'] = request.enableKnowledgeGraph;
  }
  if (!$isNull(request.image)) {
    body['image'] = request.image;
  }
  if (!$isNull(request.pageNumber)) {
    body['pageNumber'] = request.pageNumber;
  }
  if (!$isNull(request.pageSize)) {
    body['pageSize'] = request.pageSize;
  }
  if (!$isNull(request.query)) {
    body['query'] = request.query;
  }
  if (!$isNull(request.rerankModelId)) {
    body['rerankModelId'] = request.rerankModelId;
  }
  if (!$isNull(request.rerankModelName)) {
    body['rerankModelName'] = request.rerankModelName;
  }
  if (!$isNull(request.retrievalConfig)) {
    body['retrievalConfig'] = request.retrievalConfig;
  }
  if (!$isNull(request.tagFilter)) {
    body['tagFilter'] = request.tagFilter;
  }
  if (!$isNull(request.version)) {
    body['version'] = request.version;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'SearchKnowledgeBase',
    version = '2026-06-04',
    protocol = 'HTTPS',
    pathname = `/api/v1/knowledge-bases/${$URL.percentEncode(knowledgeBaseId)}/search`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Retrieves documents from a knowledge base.
 *
 * @description Retrieves documents from a specified knowledge base by question or image. Use DRAFT, LATEST_PUBLISHED, or vN display names for the version. Pass tag filter conditions using the actual backend operators.
 *
 * @param request SearchKnowledgeBaseRequest
 * @return SearchKnowledgeBaseResponse
 */
async function searchKnowledgeBase(knowledgeBaseId: string, request: SearchKnowledgeBaseRequest): SearchKnowledgeBaseResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return searchKnowledgeBaseWithOptions(knowledgeBaseId, request, headers, runtime);
}

