  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the access denial.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:SearchKnowledgeBase"}'),
