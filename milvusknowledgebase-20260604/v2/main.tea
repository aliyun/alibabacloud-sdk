/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'MilvusKnowledgeBase';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('milvusknowledgebase', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AddDocumentsRequest {
  dedup?: {
    contentDedup?: boolean(name='ContentDedup', description='Specifies whether to enable content deduplication.', example='true'),
    docNameDedup?: boolean(name='DocNameDedup', description='Specifies whether to enable document name deduplication.', example='true'),
  }(name='Dedup', description='The deduplication configuration.'),
  documents?: [ 
    {
      name?: string(name='Name', description='The name of the document.', example='CHANGELOG.md'),
      path?: string(name='Path', description='The document path, which is the file name or relative path used during upload. It must be consistent with the pre-signed request.', example='2026_06_23_17_49_52WwGSUezpG2u2iHWxyYGzkf9KtormhkxN/CHANGELOG.md'),
      size?: long(name='Size', description='The size of the file.', example='1024'),
      strategyId?: string(name='StrategyId', description='The ID of the processing strategy.', example='kb-strategy-7043984ca395eabd'),
    }
  ](name='Documents', description='The list of documents.'),
  importType?: string(name='ImportType', description='The import type.', example='LOCAL_UPLOAD'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', description='The ID of the knowledge base.', example='kb-3bd02617e9be335f'),
  metaFields?: any(name='MetaFields', description='The batch tag configuration. The key must be a tag field defined in the knowledge base. The value supports the string, int64, float32, bool, and list data types.', example='{"department":"legal","topics":["policy","contract"],"reviewed":true}'),
  strategyId?: string(name='StrategyId', description='The ID of the processing strategy.', example='kb-strategy-7043984ca395eabd'),
  dingTalkConfiguration?: {
    appId?: string(name='appId', description='This parameter is not supported and is ignored.', example='ignore'),
    appPassword?: string(name='appPassword', description='This parameter is not supported and is ignored.', example='ignore'),
    dingDocMcpLink?: string(name='dingDocMcpLink', description='This parameter is not supported and is ignored.', example='ignore'),
    dingTableMcpLink?: string(name='dingTableMcpLink', description='This parameter is not supported and is ignored.', example='ignore'),
    knowledgeId?: string(name='knowledgeId', description='This parameter is not supported and is ignored.', example='ignore'),
    knowledgeType?: string(name='knowledgeType', description='This parameter is not supported and is ignored.', example='ignore'),
    userId?: string(name='userId', description='This parameter is not supported and is ignored.', example='ignore'),
  }(name='dingTalkConfiguration', description='This parameter is not supported and is ignored.'),
  parentId?: string(name='parentId', description='Defaults to root when omitted.', example='root'),
}

model AddDocumentsResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The access denial details.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', description='The response status code.', example='0'),
  data?: {
    documents?: [ 
      {
        chunkCount?: int32(name='chunkCount', description='The number of chunks.', example='0'),
        chunkMethod?: string(name='chunkMethod', description='The chunking method.', example='naive'),
        datasetId?: string(name='datasetId', description='The ID of the knowledge base.', example='kb-123'),
        id?: string(name='id', description='The document ID.', example='doc-123'),
        location?: string(name='location', description='The object path.', example='uploaded/doc-id/example.pdf'),
        name?: string(name='name', description='The name of the document.', example='example.pdf'),
        progress?: float(name='progress', description='The processing progress.', example='0'),
        run?: string(name='run', description='The processing status.', example='RUNNING'),
        size?: long(name='size', description='The size of the file.', example='1024'),
        suffix?: string(name='suffix', description='The file extension.', example='pdf'),
        thumbnail?: string(name='thumbnail', description='The thumbnail.', example='""'),
        tokenCount?: int32(name='tokenCount', description='The number of tokens.', example='0'),
      }
    ](name='documents', description='The list of documents.'),
    errors?: [ string ](name='errors', description='The list of errors.'),
  }(name='data', description='The response data.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='403'),
  message?: string(name='message', description='The response message.', example='success'),
  requestId?: string(name='requestId', description='The request ID.', example='DDDBE0E5-4314-156F-B7F1-C4BCFD25A509'),
  success?: boolean(name='success', description='Indicates whether the request is successful.', example='true'),
}

model AddDocumentsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDocumentsResponseBody(name='body'),
}

/**
 * @summary Registers files that have been uploaded to the knowledge base storage as knowledge base documents and **automatically triggers parsing** (chunking and embedding). Supports two types of import:
 * - `LOCAL_UPLOAD`: Used with the `GetKnowledgeBasePreSignedUrl` direct upload process. This operation only registers the files and does not verify whether the files have been actually uploaded. Therefore, you must complete the PUT upload first.
 * - `OSS_IMPORT`: Imports files from an external OSS bucket. This operation creates an asynchronous import task and returns the `knowledge_import_task_id`. The system downloads and registers the files in the background.
 * A maximum of 100 files can be processed at a time.
 *
 * @param request AddDocumentsRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddDocumentsResponse
 */
@context("addDocumentsWithContext")
async function addDocumentsWithOptions(datasetId: string, request: AddDocumentsRequest, headers: map[string]string, runtime: $RuntimeOptions): AddDocumentsResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.dedup)) {
    body['Dedup'] = request.dedup;
  }
  if (!$isNull(request.documents)) {
    body['Documents'] = request.documents;
  }
  if (!$isNull(request.importType)) {
    body['ImportType'] = request.importType;
  }
  if (!$isNull(request.knowledgeBaseId)) {
    body['KnowledgeBaseId'] = request.knowledgeBaseId;
  }
  if (!$isNull(request.metaFields)) {
    body['MetaFields'] = request.metaFields;
  }
  if (!$isNull(request.strategyId)) {
    body['StrategyId'] = request.strategyId;
  }
  if (!$isNull(request.dingTalkConfiguration)) {
    body['dingTalkConfiguration'] = request.dingTalkConfiguration;
  }
  if (!$isNull(request.parentId)) {
    body['parentId'] = request.parentId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddDocuments',
    version = '2026-06-04',
    protocol = 'HTTPS',
    pathname = `/api/v1/datasets/${$URL.percentEncode(datasetId)}/documents/addDocuments`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Registers files that have been uploaded to the knowledge base storage as knowledge base documents and **automatically triggers parsing** (chunking and embedding). Supports two types of import:
 * - `LOCAL_UPLOAD`: Used with the `GetKnowledgeBasePreSignedUrl` direct upload process. This operation only registers the files and does not verify whether the files have been actually uploaded. Therefore, you must complete the PUT upload first.
 * - `OSS_IMPORT`: Imports files from an external OSS bucket. This operation creates an asynchronous import task and returns the `knowledge_import_task_id`. The system downloads and registers the files in the background.
 * A maximum of 100 files can be processed at a time.
 *
 * @param request AddDocumentsRequest
 * @return AddDocumentsResponse
 */
async function addDocuments(datasetId: string, request: AddDocumentsRequest): AddDocumentsResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return addDocumentsWithOptions(datasetId, request, headers, runtime);
}

model GetKnowledgeBasePreSignedUrlRequest {
  documents?: [ 
    {
      name?: string(name='Name', description='The display name of the file. If not specified, the file name from Path is used by default.', example='CHANGELOG.md'),
      path?: string(name='Path', description='The **file name or relative path** for local upload scenarios. The path cannot start with `direct_upload/` or `uploaded/`, cannot contain empty segments, `.`, or `..`, and must be less than or equal to 1,024 bytes in length.', example='contract-2026.md'),
      size?: long(name='Size', description='The size of the file in bytes.', example='1024'),
    }
  ](name='Documents', description='The list of files to be uploaded. You can specify 1 to 100 files.'),
  expiresIn?: int32(name='ExpiresIn', description='The validity period of the pre-signed URL in seconds. Default value: `3600`.', example='3600'),
  knowledgeBaseId?: string(name='KnowledgeBaseId', description='The ID of the knowledge base. This parameter and datasetId are mutually exclusive. If both are specified, this parameter takes precedence.', example='kb-3bd02617e9be335f'),
}

model GetKnowledgeBasePreSignedUrlResponseBody = {
  accessDeniedDetail?: string(name='accessDeniedDetail', description='The details of the access denial.', example='{"PolicyType":"AccountLevelIdentityBasedPolicy","AuthPrincipalOwnerId":"1234567890123456","AuthPrincipalType":"SubUser","AuthPrincipalDisplayName":"1234567890123456","NoPermissionType":"ImplicitDeny","AuthAction":"milvusknowledgebase:ListDatasets"}'),
  code?: int32(name='code', description='The business status code.', example='0'),
  data?: {
    bucketName?: string(name='bucketName', description='The name of the bucket.', example='knowledgebase-fileupload'),
    expiresIn?: int32(name='expiresIn', description='The validity period of the pre-signed URL in seconds.', example='3600'),
    preSignedUrls?: [ string ](name='preSignedUrls', description='The list of pre-signed PUT URLs. **The order corresponds one-to-one with the `Documents` in the request**.'),
  }(name='data', description='The response data.'),
  httpStatusCode?: int32(name='httpStatusCode', description='The HTTP status code.', example='403'),
  success?: boolean(name='success', description='Indicates whether the request is successful.', example='true'),
}

model GetKnowledgeBasePreSignedUrlResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetKnowledgeBasePreSignedUrlResponseBody(name='body'),
}

/**
 * @summary Generates an **Object Storage Service (OSS) pre-signed PUT URL** pointing to the dedicated storage of the knowledge base for each file in `Documents`. Callers use the URL to upload file content directly to OSS and then call `AddDocuments` to complete the registration. A maximum of 100 files can be processed at a time.
 *
 * @param request GetKnowledgeBasePreSignedUrlRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return GetKnowledgeBasePreSignedUrlResponse
 */
@context("getKnowledgeBasePreSignedUrlWithContext")
async function getKnowledgeBasePreSignedUrlWithOptions(datasetId: string, request: GetKnowledgeBasePreSignedUrlRequest, headers: map[string]string, runtime: $RuntimeOptions): GetKnowledgeBasePreSignedUrlResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.documents)) {
    body['Documents'] = request.documents;
  }
  if (!$isNull(request.expiresIn)) {
    body['ExpiresIn'] = request.expiresIn;
  }
  if (!$isNull(request.knowledgeBaseId)) {
    body['KnowledgeBaseId'] = request.knowledgeBaseId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'GetKnowledgeBasePreSignedUrl',
    version = '2026-06-04',
    protocol = 'HTTPS',
    pathname = `/api/v1/datasets/${$URL.percentEncode(datasetId)}/getKnowledgeBasePreSignedUrl`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Generates an **Object Storage Service (OSS) pre-signed PUT URL** pointing to the dedicated storage of the knowledge base for each file in `Documents`. Callers use the URL to upload file content directly to OSS and then call `AddDocuments` to complete the registration. A maximum of 100 files can be processed at a time.
 *
 * @param request GetKnowledgeBasePreSignedUrlRequest
 * @return GetKnowledgeBasePreSignedUrlResponse
 */
async function getKnowledgeBasePreSignedUrl(datasetId: string, request: GetKnowledgeBasePreSignedUrlRequest): GetKnowledgeBasePreSignedUrlResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return getKnowledgeBasePreSignedUrlWithOptions(datasetId, request, headers, runtime);
}

model SearchKnowledgeBaseRequest {
  documentIds?: [ string ](name='documentIds', description='The list of document IDs.'),
  enableKnowledgeGraph?: boolean(name='enableKnowledgeGraph', description='Specifies whether to enable the knowledge graph.', example='false'),
  evidencePageToken?: string(name='evidencePageToken', description='The evidence page token. This parameter is optional and conditionally returned. It can only be passed when includeWiki is set to true. Omit this parameter for the first evidence page, and pass the evidenceNextToken from the previous page as is for subsequent pages. The candidate pool, subject, parameters, and page size are fixed, and the token expires in 5 minutes without renewal. An expired token returns a 409 error and does not trigger an automatic re-search. The pageNumber parameter only controls the legacy results. Constraint: {"minLength":1,"maxLength":4096}.', example='example-opaque-next-token'),
  image?: {
    base64?: string(name='base64', description='The Base64-encoded image.', example='data:image/png;base64,iVBORw0KGgoAAA...'),
    objectKey?: string(name='objectKey', description='The object key of the image.', example='uploaded/invoice.png'),
    url?: string(name='url', description='The image URL.', example='https://example.com/invoice.png'),
  }(name='image', description='The image search input.'),
  includeWiki?: boolean(name='includeWiki', description='Specifies whether to use Wiki evidence. This parameter is optional and conditionally returned, and is added for backward compatibility. Default value: false. If set to true, a unified evidenceResults field is additionally returned without disguising Wiki content as original text. Constraint: {"default":false}.', example='true'),
  pageNumber?: int32(name='pageNumber', description='The page number.', example='1'),
  pageSize?: int32(name='pageSize', description='The number of items per page.', example='5'),
  query?: string(name='query', description='The search query.', example='What is the tax amount on the invoice?'),
  rerankModelId?: long(name='rerankModelId', description='The rerank model ID.', example='123'),
  rerankModelName?: string(name='rerankModelName', description='The name of the rerank model activated for the tenant. If both rerankModelId and this parameter are specified, this parameter takes precedence.', example='qwen3-rerank'),
  retrievalConfig?: {
    candidateCount?: int32(name='candidateCount', description='The number of candidates to recall.', example='5'),
    enableEvidenceCompletion?: boolean(name='enableEvidenceCompletion', description='Specifies whether to enable multi-hop evidence completion. Default value: false. For pilot knowledge bases, this feature can be used on the first page of DRAFT text retrieval. The pageSize can be 5, 10, or 20, which requires a minimum candidateCount of 40, 48, or 64, respectively. When enabled, results are returned by document.', example='true'),
    enableQueryExpansion?: boolean(name='enableQueryExpansion', description='Specifies whether to enable query expansion.', example='true'),
    minScore?: float(name='minScore', description='The minimum relevance score.', example='0.2'),
    semanticWeight?: float(name='semanticWeight', description='The weight for semantic relevance.', example='0.5'),
    translationLanguages?: [ string ](name='translationLanguages', description='The list of translation languages.'),
  }(name='retrievalConfig', description='The retrieval configuration.'),
  tagFilter?: {
    conditions?: [ 
      {
        field?: string(name='field', description='The tag field.', example='category'),
        op?: string(name='op', description='The operator.', example='in'),
        value?: any(name='value', description='The tag value.', example='invoice'),
      }
    ](name='conditions', description='The list of tag conditions.'),
    relation?: string(name='relation', description='The condition relation.', example='or'),
  }(name='tagFilter', description='The tag filter.'),
  version?: string(name='version', description='The knowledge base version.', example='v1'),
}

