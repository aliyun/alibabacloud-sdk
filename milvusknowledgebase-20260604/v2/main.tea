          mediaEndMs?: long(name='mediaEndMs', description='Optional or conditionally returned. Null is allowed. The semantics of null values follow the field description. Null is allowed and can be omitted. Constraints: {"minimum":0,"maximum":9223372036854775807}.', example='0'),
