  codecTag?: string(name='CodecTag', description='The tag of the codec.', example='0x67337874'),
  codecTagString?: string(name='CodecTagString', description='The description of the codec tag.', example='tx3g'),
  content?: string(name='Content', description='The subtitle content.', example='欢迎'),
  duration?: double(name='Duration', description='The duration of the subtitle stream in seconds.', example='71.378'),
  height?: long(name='Height', description='The height of the subtitles. Unit: pixels.', example='30'),
  index?: long(name='Index', description='The index number of the subtitle stream.', example='2'),
  language?: string(name='Language', description='The subtitle language in the BCP 47 standard.', example='en'),
  startTime?: double(name='StartTime', description='The start time of the subtitle stream in seconds.', example='0.000000'),
  width?: long(name='Width', description='The width of the subtitles. Unit: pixels.', example='600'),
}

