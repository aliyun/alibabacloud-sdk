/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'imm';
  @version = '2020-09-30';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing-gov-1' = 'imm-vpc.cn-beijing-gov-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model Address {
  addressLine?: string(name='AddressLine', description='The full address.', example='中国浙江省杭州市余杭区文一西路969号'),
  city?: string(name='City', description='The city.', example='杭州市'),
  country?: string(name='Country', description='The country or region.', example='中国'),
  district?: string(name='District', description='The district.', example='余杭区'),
  language?: string(name='Language', description='The BCP 47 language code.', example='zh-hans'),
  province?: string(name='Province', description='The province.', example='浙江省'),
  township?: string(name='Township', description='The street.', example='文一西路'),
}

model AddressForStory {
  city?: string(name='City', description='The city.', example='杭州市'),
  country?: string(name='Country', description='The country.', example='中国'),
  district?: string(name='District', description='The district.', example='滨江区'),
  province?: string(name='Province', description='The province.', example='浙江省'),
  township?: string(name='Township', description='The township.', example='长河街道'),
}

model AlgorithmDefinition {
  algorithmDefinitionId?: string(name='AlgorithmDefinitionId', description='The ID of the algorithm definition.', example='8fc6e718-8d19-495f-a510-bcee3c598588'),
  createTime?: string(name='CreateTime', description='The creation time.', example='2023-05-31T10:19:40.572325888+08:00'),
  customLabels?: [ map[string]string ](name='CustomLabels', description='Custom labels.'),
  description?: string(name='Description', description='The description.', example='test'),
  name?: string(name='Name', description='The name of the algorithm.', example='algoName'),
  ownerId?: string(name='OwnerId', description='The ID of the Alibaba Cloud account.', example='user1'),
  projectName?: string(name='ProjectName', description='The name of the project.', example='traningtest'),
  trainingSpecification?: TrainingSpecification(name='TrainingSpecification', description='The model training parameters.'),
  updateTime?: string(name='UpdateTime', description='The update time.', example='2023-05-31T10:19:40.572325888+08:00'),
}

model Answer {
  content?: string(name='Content', description='The answer.', example='你好'),
  references?: [
    ReferenceFile
  ](name='References', description='The reference sources of the answer.'),
}

model App {
  appDescription?: string(name='AppDescription', description='AppDescription', example='中国最大的电商购物商城'),
  appId?: string(name='AppId', description='AppId', example='1234567890'),
  appKey?: string(name='AppKey', description='AppKey', example='ryBOBW0Z6NnQ3fV9'),
  appName?: string(name='AppName', description='AppName', example='淘宝'),
  appRegion?: long(name='AppRegion', description='AppRegion', example='0'),
  appType?: long(name='AppType', description='AppType', example='0'),
  englishName?: string(name='EnglishName', description='EnglishName', example='Taobao'),
  ownerId?: string(name='OwnerId', description='OwnerId', example='1023210024677934'),
  packageName?: string(name='PackageName', description='PackageName', example='ThisIsAPackageName'),
}

model AssumeRoleChain {
  chain?: [
    AssumeRoleChainNode
  ](name='Chain', description='The authorization chains.'),
  policy?: string(name='Policy', description='The policy.', example='test'),
}

model AssumeRoleChainNode {
  ownerId: string(name='OwnerId', description='The UID of the account.

This parameter is required.', example='10232100********'),
  role: string(name='Role', description='The role.

This parameter is required.', example='test-role'),
  type: string(name='Type', description='The type of the account. Valid values:

*   user: Alibaba Cloud account.
*   service: Alibaba Cloud service.

This parameter is required.', example='user'),
}

model AudioStream {
  bitrate?: long(name='Bitrate', description='The bitrate. Unit: bit/s.', example='320087'),
  channelLayout?: string(name='ChannelLayout', description='The sound channel layout.', example='stereo'),
  channels?: long(name='Channels', description='The number of sound channels.', example='2'),
  codecLongName?: string(name='CodecLongName', description='The full name of the codec.', example='AAC (Advanced Audio Coding)'),
  codecName?: string(name='CodecName', description='The abbreviated name of the codec.', example='aac'),
  codecTag?: string(name='CodecTag', description='The tag of the codec.', example='0x6134706d'),
  codecTagString?: string(name='CodecTagString', description='The description of the codec tag.', example='mp4a'),
  codecTimeBase?: string(name='CodecTimeBase', description='The time base of the codec.', example='1/44100'),
  duration?: double(name='Duration', description='The duration of the audio stream in seconds.', example='3.690667'),
  frameCount?: long(name='FrameCount', description='The number of frames.', example='173'),
  index?: long(name='Index', description='The index number of the audio stream.', example='1'),
  language?: string(name='Language', description='The audio language in the BCP 47 standard.', example='en'),
  lyric?: string(name='Lyric', description='The lyric.', example='test'),
  sampleFormat?: string(name='SampleFormat', description='The sample format.', example='fltp'),
  sampleRate?: long(name='SampleRate', description='The sampling rate. Unit: Hz.', example='48000'),
  startTime?: double(name='StartTime', description='The start time of the audio stream in seconds.', example='0.0235'),
  timeBase?: string(name='TimeBase', description='The time base.', example='1/48000'),
}

model Binding {
  createTime?: string(name='CreateTime', description='The timestamp when the binding between the dataset and the OSS bucket was created. The format is RFC3339Nano.', example='2021-06-29T14:50:13.011643661+08:00'),
  datasetName?: string(name='DatasetName', description='The name of the dataset.', example='dataset001'),
  phase?: string(name='Phase', description='The scan type. Valid values:

- FullScanning: A full scan is in progress.

- IncrementalScanning: An incremental scan is in progress.', example='FullScanning'),
  projectName?: string(name='ProjectName', description='The name of the project.', example='immtest'),
  reason?: string(name='Reason', description='Reason', example='pause usage'),
  state?: string(name='State', description='The state of the binding between the dataset and the OSS bucket. Valid values:

- Ready: The binding is being prepared after it is created.

- Stopped: The binding is paused.

- Running: The binding is running.

- Retrying: The binding is being retried after it is created.

- Failed: The binding failed to be created.

- Deleted: The binding is deleted.', example='Running'),
  URI?: string(name='URI', description='The URI of the Object Storage Service (OSS) bucket attached to the dataset.

The format of an OSS bucket URI is `oss://${bucketname}`. The `bucketname` is the name of an OSS bucket that is in the same region as the current project.', example='oss://examplebucket'),
  updateTime?: string(name='UpdateTime', description='The timestamp when the binding between the dataset and the OSS bucket was last modified. The format is RFC3339Nano.

> After a binding is created, if the binding has not been paused or restarted, this timestamp is the same as the creation timestamp.', example='2021-06-29T14:50:13.011643661+08:00'),
}

model Body {
  boundary?: Boundary(name='Boundary', description='The boundary of the human body.'),
  confidence?: float(name='Confidence', description='The confidence level of the result. A higher value indicates greater confidence. Specifically, a value exceeding 0.8 signifies a high degree of confidence in the result.', example='0.75'),
}

model Boundary {
  height?: long(name='Height', description='The height. Unit: pixel.', example='300'),
  left?: long(name='Left', description='The distance from the X-coordinate of the vertex to the left edge.', example='10'),
  polygon?: [
    PointInt64
  ](name='Polygon', description='The polygon formed by a number of points. This parameter takes effect only when the boundary describes a polygon rather than a rectangle.

>  This parameter is mutually exclusive to the following parameters that form a rectangle: Width, Height, Left, and Top. A boundary describes only a rectangle or a polygon.'),
  top?: long(name='Top', description='The distance from the Y-coordinate of the vertex to the top.', example='30'),
  width?: long(name='Width', description='The width. Unit: pixel.', example='200'),
}

model Car {
  boundary?: Boundary(name='Boundary', description='The boundary information.'),
  carColor?: string(name='CarColor', description='The vehicle color. Valid values

*   white
*   grey
*   yellow
*   red
*   green
*   blue
*   black
*   purple
*   brown', example='white'),
  carColorConfidence?: double(name='CarColorConfidence', description='The confidence level of the vehicle color. Valid values: 0 to 1. The value 0 indicates the lowest confidence level. The value 1 indicates the highest confidence level.', example='0.604'),
  carType?: string(name='CarType', description='The vehicle type. Valid values:

*   car
*   bus
*   truck
*   van', example='van'),
  carTypeConfidence?: double(name='CarTypeConfidence', description='The confidence level of the vehicle type. Valid values: 0 to 1. The value 0 indicates the lowest confidence level. The value 1 indicates the highest confidence level.', example='0.516'),
  confidence?: double(name='Confidence', description='The confidence level of the vehicle detection result. Valid values: 0 to 1. The value 0 indicates the lowest confidence level. The value 1 indicates the highest confidence level.', example='0.999'),
  licensePlates?: [
    LicensePlate
  ](name='LicensePlates', description='The license plates.'),
}

model ChapterSummary {
  pageNumber?: int32(name='PageNumber'),
  summary?: [
    Summary
  ](name='Summary'),
  timeRange?: [ long ](name='TimeRange'),
  title?: string(name='Title'),
  titleID?: string(name='TitleID'),
}

model Clip {
  timeRange?: [ long ](name='TimeRange', description='The time range of the event clip'),
}

model ClusterForReq {
  cover?: {
    figures?: [ 
      {
        figureId?: string(name='FigureId', description='The person ID.', example='2cb3c51e-b406-4b0c-af1b-897d88e1****'),
      }
    ](name='Figures', description='The persons.'),
  }(name='Cover', description='The cover.'),
  customId?: string(name='CustomId', description='The custom ID.', example='abc'),
  customLabels?: map[string]any(name='CustomLabels', description='The custom labels.', example='{"Bucket": "examplebucket"}'),
  name?: string(name='Name', description='The name of the cluster.', example='abc'),
  objectId?: string(name='ObjectId', description='The ID of the cluster.', example='Cluster-99b1c333-86dc-45da-8c6****'),
}

model Codes {
  boundary?: Boundary(name='Boundary', description='The boundary of the code.'),
  confidence?: float(name='Confidence', description='The confidence level of the code. A greater value indicates a higher confidence level. A value exceeding 0.8 signifies a high degree of confidence in the result.', example='0.9'),
  content?: string(name='Content', description='The content of the code.', example='https://www.example.com'),
  type?: string(name='Type', description='The type of the code.

Enumerated values:

*   qrcode
*   barcode', example='qrcode'),
}

model ContextualFile {
  contentType?: string(name='ContentType', description='The Multipurpose Internet Mail Extensions (MIME) type of the file.', example='text/x-imm-faq'),
  datasetName?: string(name='DatasetName', description='The dataset name.', example='test-dataset'),
  elements?: [
    Element
  ](name='Elements', description='Elements.'),
  mediaType?: string(name='MediaType', description='The media type of the file.', example='document'),
  OSSURI?: string(name='OSSURI', description='The URI path of the OSS file. This parameter is used only when the URI is a PDS address.', example='oss://test-bucket/test-object.jpg'),
  objectId?: string(name='ObjectId', description='The identifier of the file in the dataset.', example='0939d7ed-73fa-4009-bbe6-fbbe07b92b2e'),
  ownerId?: string(name='OwnerId', description='The user ID.', example='1482910009923706'),
  projectName?: string(name='ProjectName', description='The project name.', example='test-project'),
  URI?: string(name='URI', description='The URI of the file.
The format of an OSS URI is oss\\\\://${bucketname}/${objectname}. ${bucketname} is the name of an OSS bucket in the same region as the current project. ${objectname} is the file path.
The format of a PDS URI is pds\\\\://domains/${domain}/drives/${drive}/files/${file}/revisions/${revision}.', example='oss://test-bucket'),
}

model ContextualMessage {
  content?: string(name='Content', description='The message content.', example='你好'),
  files?: [
    ContextualFile
  ](name='Files', description='The files involved in the dialogue.'),
  role?: string(name='Role', description='The role in the dialogue.', example='user'),
}

model CredentialConfig {
  chain?: [ 
    {
      assumeRoleFor?: string(name='AssumeRoleFor', description='The ID of the account that you use to grant permissions.', example='10232100246xxxxx'),
      role?: string(name='Role', description='The RAM role that can be assumed.', example='AliyunOSSRole'),
      roleType?: string(name='RoleType', description='The role type. Valid values:

*   user: Alibaba Cloud account.
*   service: Alibaba Cloud service.', example='user'),
    }
  ](name='Chain', description='The authorization chains. All roles in the array must have the `sts:AssumeRole` permission. You need to only grant other permissions, such as read and write permissions on OSS, to the last role in the array. You can grant permissions in the RAM console.'),
  policy?: string(name='Policy', description='The policy that is attached to the role specified by the ServiceRole parameter. For example, the policy allows access to OSS. This parameter is optional.', example='{"Statement": [{"Action": "oss:*","Effect": "Allow","Resource": "*"}],"Version": "1"}'),
  serviceRole?: string(name='ServiceRole', description='The service role in the account that is used to call an IMM API operation. The role must have the `sts:AssumeRole` permission. You can configure permissions for the role in the Resource Access Management (RAM) console.', example='AliyunSTSAssumeForIMMServiceRole'),
}

model CroppingSuggestion {
  aspectRatio?: string(name='AspectRatio', description='The aspect ratio.', example='2:3'),
  boundary?: Boundary(name='Boundary', description='The boundary of the cropping.'),
  confidence?: float(name='Confidence', description='The confidence score. Valid values: 0 to 1. A higher score indicates greater confidence in the result.', example='0.7079545259475708'),
}

model CustomParams {
  name?: string(name='Name', description='The name of the parameter.', example='Normalize'),
  properties?: [
    Property
  ](name='Properties', description='The properties.'),
}

model CustomPrompt {
  roleDefinition?: string(name='RoleDefinition'),
}

model DataIngestion {
  actions?: [ 
    {
      fastFailPolicy?: FastFailPolicy(name='FastFailPolicy', description='The configuration of the fast-fail policy for data processing.'),
      name?: string(name='Name', description='The template name.', example='doc/convert'),
      parameters?: [ string ](name='Parameters', description='The template parameters.'),
    }
  ](name='Actions', description='A list of processing templates.'),
  createTime?: string(name='CreateTime', description='The time when the task was created.', example='2020-11-10T03:50:28Z'),
  error?: string(name='Error', description='The error message.', example='api returns error: SDKError: StatusCode: 404 Code: ResourceNotFound'),
  id?: string(name='Id', description='The unique ID of the data ingestion.', example='trigger-9f72636a-0f0c-4baf-ae78-38b27bfe****'),
  input?: Input(name='Input', description='The data source information.'),
  marker?: string(name='Marker', description='The task execution position.', example='MTIzNDU2Nzg6aW1tdGVzdDpleGFtcGxlYnVja2V0OmRhdGFzZXQwMDE6b3NzOi8vZXhhbXBsZWJ1Y2tldC9zYW1wbGVvYmplY3QxLmpw****'),
  notification?: {
    endpoint?: string(name='Endpoint', description='The MNS Endpoint.', example='http://1111111111.mns.cn-hangzhou.aliyuncs.com'),
    MNS?: MNS(name='MNS', description='MNS'),
    rocketMQ?: RocketMQ(name='RocketMQ', description='RocketMQ'),
    topic?: string(name='Topic', description='The MNS topic.', example='topic1'),
  }(name='Notification', description='The notification for task completion.'),
  phase?: string(name='Phase', description='The scanning phase.', example='IncrementalScanning'),
  serviceRole?: string(name='ServiceRole', description='The service authorization role.', example='AliyunIMMBatchTriggerRole'),
  state?: string(name='State', description='The state of the batch processing task:

- Ready: The task is ready. A newly created task is in the Ready state.

- Running: The task is running. This is the state of a task that is executing normally.

- Failed: The task failed. An error occurred during task execution, and the task cannot be automatically recovered.

- Suspended: The task is paused.

- Succeeded: The task is complete.', example='Succeeded'),
  statistic?: {
    skipFiles?: long(name='SkipFiles', description='The number of skipped files.', example='0'),
    submitFailure?: long(name='SubmitFailure', description='The number of failed submissions.', example='1'),
    submitSuccess?: long(name='SubmitSuccess', description='The number of successful submissions.', example='10'),
  }(name='Statistic', description='The statistics information.'),
  tags?: map[string]any(name='Tags', description='The task tags.'),
  updateTime?: string(name='UpdateTime', description='The time when the task was last updated.', example='2021-12-18T07:40:29Z'),
}

model Dataset {
  bindCount?: long(name='BindCount', description='The number of OSS buckets currently bound to the dataset.', example='2'),
  createTime?: string(name='CreateTime', description='The timestamp when the dataset was created, in RFC3339Nano format.', example='2021-06-29T14:50:13.011643661+08:00'),
  datasetMaxBindCount?: long(name='DatasetMaxBindCount', description='The maximum number of bindings allowed for each dataset.', example='10'),
  datasetMaxEntityCount?: long(name='DatasetMaxEntityCount', description='The maximum number of metadata entities allowed in the dataset.', example='10000000000'),
  datasetMaxFileCount?: long(name='DatasetMaxFileCount', description='The maximum number of files allowed in the dataset.', example='100000000'),
  datasetMaxRelationCount?: long(name='DatasetMaxRelationCount', description='The maximum number of metadata relationships allowed in the dataset.', example='100000000000'),
  datasetMaxTotalFileSize?: long(name='DatasetMaxTotalFileSize', description='The maximum total file size allowed in the dataset, in bytes.', example='90000000000000000'),
  datasetName?: string(name='DatasetName', description='The dataset name.', example='dataset001'),
  description?: string(name='Description', description='The description of the dataset.', example='测试数据集'),
  fileCount?: long(name='FileCount', description='The current number of files in the dataset.', example='10'),
  projectName?: string(name='ProjectName', description='The project name.', example='immtest'),
  templateId?: string(name='TemplateId', description='The workflow template ID.', example='DefaultId'),
  totalFileSize?: long(name='TotalFileSize', description='The total file size in the dataset, in bytes.', example='100000'),
  updateTime?: string(name='UpdateTime', description='The timestamp when the dataset was last modified, in RFC3339Nano format.

>If the dataset has not been updated since it was created, this timestamp is the same as the creation timestamp.', example='2021-06-29T14:50:13.011643661+08:00'),
  workflowParameters?: [
    WorkflowParameter
  ](name='WorkflowParameters', description='The custom parameters.', deprecated='true'),
}

model DatasetConfig {
  insights?: InsightsConfig(name='Insights', description='The content awareness configuration.'),
  reverseImage?: ReverseImageConfig(name='ReverseImage', description='The reverse image search configuration.'),
  smartCluster?: SmartClusterConfig(name='SmartCluster', description='The intelligent clustering configuration.'),
}

model DatasetTaskStatus {
  lastSucceededTime?: string(name='LastSucceededTime', description='The time of the last completion.', example='2024-06-29T14:50:13.011643661+08:00'),
  startTime?: string(name='StartTime', description='The start time of the task.', example='2024-06-29T14:50:13.011643661+08:00'),
  status?: string(name='Status', description='The status of the task.', example='Succeeded'),
}

model DocumentChapterSummarizeOption {
  limit?: int32(name='Limit', description='The number of section-by-section summaries. If neither Marker nor Index is specified, the entire article is summarized by default. Marker and Index must either both be specified or both be omitted.', example='5'),
  marker?: int32(name='Marker', description='The start position for section-by-section summarization.', example='0'),
  version?: string(name='Version', description='The version of section-by-section summarization.', example='v1'),
}

model DocumentChapterSummary {
  data?: [
    ChapterSummary
  ](name='Data'),
  nextMarker?: int32(name='NextMarker'),
  version?: string(name='Version'),
}

model DocumentParseKeywordOption {
  count?: int32(name='Count', description='The number of keywords to extract. The value must be an integer from 0 to 10.', example='1'),
  extract?: boolean(name='Extract', description='Specifies whether to extract keywords.'),
}

model DocumentParseNarratorOption {
  narrate?: boolean(name='Narrate', description='The article reading guide.'),
}

model DocumentParseOption {
  keyword?: DocumentParseKeywordOption(name='Keyword', description='Document parsing keyword extraction options'),
  narrator?: DocumentParseNarratorOption(name='Narrator', description='Document parsing guidance options'),
  question?: DocumentParseQuestionOption(name='Question', description='Document parsing question generation options'),
  summary?: DocumentParseSummaryOption(name='Summary', description='Document parsing summary options'),
}

model DocumentParseQuestionOption {
  count?: int32(name='Count', description='Number of questions (range: 0 to 10)', example='1'),
  extract?: boolean(name='Extract', description='Whether to extract'),
}

model DocumentParseSummaryOption {
  chapterSummarize?: boolean(name='ChapterSummarize', description='Document chapter summary'),
  summarize?: boolean(name='Summarize', description='Article summary'),
}

model DocumentReadKeywordOption {
  count?: int32(name='Count', description='The number of keywords. Valid values: 0 to 10.', example='1'),
  extract?: boolean(name='Extract', description='Specifies whether to extract keywords.', example='true'),
}

model DocumentReadNarratorOption {
  narrate?: boolean(name='Narrate', description='Specifies whether to fetch.', example='true'),
}

model DocumentReadOption {
  keyword?: DocumentReadKeywordOption(name='Keyword', description='The document intensive reading keyword extraction options.'),
  narrator?: DocumentReadNarratorOption(name='Narrator', description='The document intensive reading guide options.'),
  question?: DocumentReadQuestionOption(name='Question', description='The document intensive reading question guide options.'),
  summary?: DocumentReadSummaryOption(name='Summary', description='The document intensive reading summary options.'),
}

model DocumentReadQuestionOption {
  count?: int32(name='Count'),
  extract?: boolean(name='Extract'),
}

model DocumentReadSummaryOption {
  chapterSummarize?: boolean(name='ChapterSummarize', description='Specifies whether to extract the chapter-level summary of the article.', example='true'),
  chapterSummarizeOption?: DocumentChapterSummarizeOption(name='ChapterSummarizeOption', description='The chapter-level summary options for the article.'),
  summarize?: boolean(name='Summarize', description='Specifies whether to extract the article summary.', example='true'),
}

model Element {
  elementContents?: [
    ElementContent
  ](name='ElementContents', description='The element contents.'),
  elementRelations?: [
    ElementRelation
  ](name='ElementRelations', description='The relationships between the current element and other elements.'),
  elementType?: string(name='ElementType', description='The element type.', example='title - 标题； image - 图片 ； table - 表格 ； narrative-text - 正文'),
  objectId?: string(name='ObjectId', description='The unique ID of the element.', example='id1'),
  semanticSimilarity?: float(name='SemanticSimilarity', description='The similarity between the current file and its extracted semantics.', example='0.8'),
}

model ElementContent {
  content?: string(name='Content', description='The content of the element.

If the value of the Type parameter is image or link, this parameter indicates the placeholder text.', example='文本片段'),
  timeRange?: [ long ](name='TimeRange', description='The time range. The array length is fixed to 2. One element indicates the start time and the other one indicates the end time. Unit: milliseconds.'),
  type?: string(name='Type', description='The type of the element content.

Valid values:

*   text
*   image
*   link', example='text'),
  URL?: string(name='URL', description='The link to the element content. This parameter takes effect only if the Type parameter is set to image or link.', example='http://aliyun.com'),
}

model ElementRelation {
  objectId?: string(name='ObjectId', description='The ID of the element.', example='id1'),
  type?: string(name='Type', description='The type.', example='child，parent'),
}

model FastFailPolicy {
  action?: string(name='Action', description='The action when the batch processor or trigger encounters an error.

Enumerated values:

*   abort: stops running.
*   ignore: ignores the error and keeps running.', example='abort'),
}

model Figure {
  age?: long(name='Age', description='The age.', example='29'),
  ageSD?: float(name='AgeSD', description='The age standard deviation.', example='5'),
  attractive?: float(name='Attractive', description='The face attractiveness score. A higher score indicates greater attractiveness. Valid values: 0 to 1.', example='0.96'),
  beard?: string(name='Beard', description='Indicates whether the person has a beard.', example='none'),
  beardConfidence?: float(name='BeardConfidence', description='The confidence score for whether the person has a beard. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  boundary?: Boundary(name='Boundary', description='The face boundary information.'),
  emotion?: string(name='Emotion', description='The emotion.', example='happiness'),
  emotionConfidence?: float(name='EmotionConfidence', description='The emotion confidence score. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='0.707845687866210'),
  faceQuality?: float(name='FaceQuality', description='The face quality score, which evaluates whether the image quality is suitable for face recognition. A higher score indicates better quality. Valid values: 0 to 1.', example='0.960875928401947'),
  figureClusterConfidence?: float(name='FigureClusterConfidence', description='The clustering confidence score. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  figureClusterId?: string(name='FigureClusterId', description='The figure cluster ID. The following reserved special cluster ID names are included:

- figure-cluster-id-independent: The face does not currently belong to any suitable group. After new images are added to the dataset and face clustering is performed, the face may be assigned to a group.

- figure-cluster-id-unavailable: The face has not been clustered yet. This means that after new images were added to the dataset, face clustering has not been performed.', example='Cluster-dbe72fec-b84c-4ab6-885b-3678e64****'),
  figureConfidence?: float(name='FigureConfidence', description='The confidence score of the figure object. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  figureId?: string(name='FigureId', description='The ID of the figure object.', example='868a9e74-cde5-4c7a-9013-28bb984****'),
  figureType?: string(name='FigureType', description='The figure type.', example='face'),
  gender?: string(name='Gender', description='The gender.', example='female'),
  genderConfidence?: float(name='GenderConfidence', description='The gender confidence score. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  glasses?: string(name='Glasses', description='Indicates whether the person is wearing glasses.', example='none'),
  glassesConfidence?: float(name='GlassesConfidence', description='The confidence score for whether the person is wearing glasses. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='0.8'),
  hat?: string(name='Hat', description='Indicates whether the person is wearing a hat.', example='none'),
  hatConfidence?: float(name='HatConfidence', description='The confidence score for whether the person is wearing a hat. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  headPose?: HeadPose(name='HeadPose', description='The head pose information.'),
  mask?: string(name='Mask', description='Indicates whether the person is wearing a mask.', example='none'),
  maskConfidence?: float(name='MaskConfidence', description='The confidence score for whether the person is wearing a mask. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  mouth?: string(name='Mouth', description='Indicates whether the mouth is open.', example='close'),
  mouthConfidence?: float(name='MouthConfidence', description='The confidence score for whether the mouth is open. Valid values: 0 (lowest confidence) to 1 (highest confidence).', example='1'),
  sharpness?: float(name='Sharpness', description='The sharpness score. A higher score indicates a clearer face. Valid values: 0 to 1.', example='0.7'),
