  ](name='Subtitles', description='The array of subtitle streams.'),
  title?: string(name='Title', description='The title of the media file.', example='test'),
  videoHeight?: long(name='VideoHeight', description='The height of the video frame in the media file, in pixels.', example='1920'),
  videoStreams?: [
    VideoStream
