  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GenerateVideoPlaylist', 'POST', '/', 'json', false, 'json', request);
}

model GenerateWebofficeTokenRequest {
  regionId?: string(name='RegionId', example='区域', position='Host'),
