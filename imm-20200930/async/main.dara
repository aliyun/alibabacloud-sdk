  customId?: string(name='CustomId', description='The custom ID.', example='test'),
  customLabels?: map[string]any(name='CustomLabels', description='The custom labels.', example='{"key": "val"}'),
  datasetName?: string(name='DatasetName', description='The name of the dataset.', example='dataset001'),
  figureClusterIds?: [ string ](name='FigureClusterIds', description='The fluster IDs.'),
  files?: [
    File
  ](name='Files', description='The story files.'),
  objectId?: string(name='ObjectId', description='The ID of the story object.', example='id1'),
  objectType?: string(name='ObjectType', description='The type of the object.', example='story'),
  ownerId?: string(name='OwnerId', description='The ID of the owner to which the story belongs.', example='102321002****'),
  projectName?: string(name='ProjectName', description='The name of the project.', example='immtest'),
  storyEndTime?: string(name='StoryEndTime', description='The time when the story ends.', example='2022-01-14T10:17:18.102700407+08:00'),
  storyName?: string(name='StoryName', description='The name of the story.', example='name1'),
  storyStartTime?: string(name='StoryStartTime', description='The time when the story starts.', example='2022-01-14T10:17:18.102700407+08:00'),
  storySubType?: string(name='StorySubType', description='The subtype of the story.', example='ImportantPerson'),
  storyType?: string(name='StoryType', description='The story type.', example='PeopleMemory'),
  updateTime?: string(name='UpdateTime', description='The time when the story was updated.', example='2022-01-14T10:17:18.102700407+08:00'),
}

