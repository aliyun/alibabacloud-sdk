/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'starops.cn-beijing.aliyuncs.com',
    'ap-southeast-1' = 'starops.ap-southeast-1.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('starops', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model Tag {
  key?: string(name='key', description='The key for the tag.', example='test-key'),
  value?: string(name='value', description='The value for the tag.', example='test-value'),
}

model CreateArtifactUploadTokenRequest {
  artifactPath?: string(name='artifactPath', description='The artifact upload directory, relative to the digital human artifact root directory. The value can only be empty or a directory under upload/. If not specified, upload/{YYYY-MM-DD}/ is used by default.', example='upload/2026-05-25/'),
}

model CreateArtifactUploadTokenResponseBody = {
  accessId?: string(name='accessId', description='The AccessKey ID used for OSS uploads.', example='LTAI******'),
  artifactPath?: string(name='artifactPath', description='The normalized logical upload directory on the server side, relative to the digital human artifact root directory.', example='upload/2026-05-25/'),
  dir?: string(name='dir', description='The allowed OSS object prefix for uploads.', example='agents/123/sample-agent/home/starops/upload/2026-05-25/'),
  expire?: long(name='expire', description='The expiration time of the upload credential. The value is a UNIX timestamp in seconds.', example='1770000000'),
  host?: string(name='host', description='The OSS form upload URL.', example='https://example-bucket.oss-cn-shanghai.aliyuncs.com'),
  maxSize?: long(name='maxSize', description='The maximum size of a single file upload, in bytes.', example='104857600'),
  policy?: string(name='policy', description='The Base64-encoded OSS Post Policy.', example='eyJleHBpcmF0aW9uIjoiMjAyNi0wNS0yMVQwODowMDowMFoifQ=='),
  requestId?: string(name='requestId', description='The request ID.', example='0A1B2C3D-4E5F-6789-ABCD-1234567890AB'),
  signature?: string(name='signature', description='The OSS Post Policy signature.', example='abc123signature'),
  successActionStatus?: string(name='successActionStatus', description='The status code returned upon a successful OSS upload.', example='200'),
}

model CreateArtifactUploadTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateArtifactUploadTokenResponseBody(name='body'),
}

/**
 * @summary Creates an artifact upload credential.
 *
 * @description Obtains the link required to upload content. This operation is applicable to large files.
 *
 * @param request CreateArtifactUploadTokenRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateArtifactUploadTokenResponse
 */
@context("createArtifactUploadTokenWithContext")
async function createArtifactUploadTokenWithOptions(name: string, request: CreateArtifactUploadTokenRequest, headers: map[string]string, runtime: $RuntimeOptions): CreateArtifactUploadTokenResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.artifactPath)) {
    query['artifactPath'] = request.artifactPath;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'CreateArtifactUploadToken',
    version = '2026-04-28',
    protocol = 'HTTPS',
    pathname = `/digitalEmployee/${$URL.percentEncode(name)}/artifacts/uploadToken`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Creates an artifact upload credential.
 *
 * @description Obtains the link required to upload content. This operation is applicable to large files.
 *
 * @param request CreateArtifactUploadTokenRequest
 * @return CreateArtifactUploadTokenResponse
 */
async function createArtifactUploadToken(name: string, request: CreateArtifactUploadTokenRequest): CreateArtifactUploadTokenResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return createArtifactUploadTokenWithOptions(name, request, headers, runtime);
}

