model AppInfoDTO {
  appName?: string(name='AppName', description='The application name.', example='vod-demo-app'),
  appType?: int32(name='AppType', description='The application type. Valid values:

- 1: Common application.
- 2: Embedded SDK.', example='1'),
  creationTime?: string(name='CreationTime', description='The creation time.', example='2026-01-02T03:04:05Z'),
  gmtCreate?: string(name='GmtCreate', description='The creation time.', example='2026-01-02 03:04:05'),
  gmtModified?: string(name='GmtModified', description='The update time.', example='2026-01-02 03:04:05'),
  itemId?: string(name='ItemId', description='The application ID.', example='3ba9c7d21f4e6a80'),
  modificationTime?: string(name='ModificationTime', description='The update time.', example='2026-01-02T03:04:05Z'),
  platforms?: [ 
    {
      itemId?: string(name='ItemId', description='The platform ID.', example='3ba9c7d21f4e6a81'),
      licenseItemIds?: [ string ](name='LicenseItemIds', description='The authorization list.'),
      pkgName?: string(name='PkgName', description='The package name.', example='com.example.vodapp'),
      pkgSignature?: string(name='PkgSignature', description='The package signature.', example='8e610rzjg613h0u58v8473d029h7'),
      platformType?: long(name='PlatformType', description='The platform type.', example='2'),
      type?: long(name='Type', description='The platform type.', example='2'),
    }
  ](name='Platforms', description='The list of platform information included in the application.'),
  userId?: long(name='UserId', description='The user ID.', example='2544469002080159'),
}

