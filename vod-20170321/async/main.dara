/**
  * @description - This operation only supports querying the upload details of audio and video files.
  * - If the audio or video file is uploaded through the ApsaraVideo VOD console, you can obtain information such as the upload ratio by calling this operation. If the audio or video file is uploaded by using an SDK, you can obtain the upload details only if the [upload SDK](https://help.aliyun.com/document_detail/52200.html) meets the following requirements.
  * > Only server-the upload SDKs support this operation. Client-the upload SDKs do not support this operation. The server-the upload SDK versions that support this operation are as follows:
  * > - Java upload SDK: 1.4.4 or later
  * > - C++ upload SDK: 1.0.0 or later
  * > - PHP upload SDK: 1.0.2 or later
  * > - Python upload SDK: 1.3.0 or later
  * ### QPS limit
  * The QPS limit for a single user is 100 calls per second. If the number of calls per second exceeds the limit, throttling is triggered, which may affect your business. Call this operation at a reasonable frequency. For more information, see [QPS limits](https://help.aliyun.com/document_detail/342790.html).
  * @param request  the request parameters of GetUploadDetails  GetUploadDetailsRequest
  * @return GetUploadDetailsResponse
 */
async function getUploadDetails(request: GetUploadDetailsRequest): GetUploadDetailsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetUploadDetails', 'POST', '/', 'json', false, 'json', request);
}

model GetVideoInfoRequest {
  referenceId?: string(name='ReferenceId', description='The custom ID. The ID must be 6 to 64 characters in length and can contain only lowercase letters, uppercase letters, digits, hyphens, and underscores. The ID must be unique per user.', example='123-123', position='Query'),
  videoId?: string(name='VideoId', description='The audio or video ID. Only one audio or video ID is supported. You can obtain the ID by using one of the following methods:
- For videos uploaded through the console, log on to the [ApsaraVideo VOD console](https://vod.console.aliyun.com) and choose **Media Assets** > **Audio/Video** to view the audio or video ID.
- When you call the [CreateUploadVideo](https://help.aliyun.com/document_detail/55407.html) operation to obtain the upload URL and credential, the audio or video ID is the value of the VideoId response parameter.
- After the audio or video file is uploaded, you can call the [SearchMedia](https://help.aliyun.com/document_detail/86044.html) operation to query the audio or video ID, which is the value of the VideoId response parameter.', example='9b73864d75f1d231e9001cd5f8****', position='Query'),
}

