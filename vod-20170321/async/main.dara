  description?: string(name='Description', description='The media asset description. Rules:

- The length cannot exceed 1,024 bytes.
- The description must be encoded in UTF-8.', example='uploadTest', position='Query'),
  fileName?: string(name='FileName', description='The source file URL of the auxiliary media asset to be uploaded.
> The file name extension is optional. If a file name extension is included and it is different from the file name extension specified in MediaExt, the value of MediaExt prevails.', example='D:\\\\test.png', position='Query'),
  fileSize?: string(name='FileSize', description='The file size. Unit: bytes.', example='123', position='Query'),
  mediaExt?: string(name='MediaExt', description='The file name extension of the resource file of the auxiliary media asset to be uploaded. Valid values:

- Watermark: **png, gif, apng, and mov**
- Subtitle: **srt, ass, stl, ttml, and vtt**
- Material: **jpg, gif, png, mp4, mat, zip, and apk**', example='png', position='Query'),
  storageLocation?: string(name='StorageLocation', description='The storage address. You can obtain it by using the following method:

Log on to the [ApsaraVideo VOD console](https://vod.console.aliyun.com) and choose **Configuration Management** > **Media Asset Management Configuration** > **Storage Management** to view the storage address.

> If you do not specify this parameter, the auxiliary media asset is uploaded to the default storage address. If you specify this parameter, the auxiliary media asset is uploaded to the specified storage address.', example='out-****.oss-cn-shanghai.aliyuncs.com', position='Query'),
  tags?: string(name='Tags', description='The tags. Rules:

- A maximum of 16 tags can be set.
- Separate multiple tags with commas (,).
- A single tag cannot exceed 32 characters.
- The tags must be encoded in UTF-8.', example='tag1,tag2', position='Query'),
  title?: string(name='Title', description='The title of the auxiliary media asset. Rules:

- The length cannot exceed 128 bytes.
- The title must be encoded in UTF-8.', example='Test', position='Query'),
  userData?: string(name='UserData', description='The custom settings. The value is a JSON string that supports settings such as message callback and upload acceleration. For more information, see [UserData](~~86952#section-6fg-qll-v3w~~).

> - To use the message callback feature in this parameter, you must configure an HTTP callback URL in the console and select the corresponding callback event type. Otherwise, the callback settings do not take effect. For more information about how to configure HTTP callbacks in the console, see [Callback settings](https://help.aliyun.com/document_detail/86071.html).
> - To use the upload acceleration feature, submit a ticket to apply for activation. For more information, see [Upload instructions](https://help.aliyun.com/document_detail/55396.html). For more information about how to submit a ticket, see [Contact us](https://help.aliyun.com/document_detail/464625.html).', example='{"MessageCallback":{"CallbackURL":"http://example.aliyundoc.com"},"Extend":{"localId":"xxx","test":"www"}}', position='Query'),
}

