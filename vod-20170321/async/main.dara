        transcodeFileRegular?: string(name='TranscodeFileRegular', description='The custom output path for transcoding.', example='{MediaId}/transcoce_1'),
        transcodeTemplateId?: string(name='TranscodeTemplateId', description='The ID of the transcoding template.', example='696d29a11erc057*****a3acc398d02f4'),
        type?: string(name='Type', description='The templatetype. Valid values:

- **Normal** (default): A standard transcoding template. You cannot configure the Settings for the PackageSetting parameter for this type of template.
- **VideoPackage**: A video stream packaging template. This type of template transcodes the video stream first and then builds an adaptive bitrate stream. You must configure the Settings for the PackageSetting parameter.
- **SubtitlePackage**: A subtitle packaging template. This type of template does not transcode the video stream. It only builds the corresponding subtitle information into the adaptive bitrate output file. You must configure the Settings for the PackageSetting parameter. This type of template cannot exist independently in a template group and must be configured together with a VideoPackage template. You can configure only one SubtitlePackage template in a template group.', example='Normal'),
        video?: string(name='Video', description='The transcoding configuration parameters for the video stream. The value is a JSON string.', example='{"Codec":"H.264","Bitrate":"900","Width":"960","Remove":"false","Fps":"30"}'),
