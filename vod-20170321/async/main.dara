	"Content": "Test copyright watermark text"
}'),
        definition?: string(name='Definition', description='The definition tags for standard transcoding templates:

- **LD** (Smooth)
- **SD** (Standard definition)
- **HD** (High definition)
- **FHD** (Full high definition)
- **OD** (Original definition, which means container format conversion)
- **2K**
- **4K**
- **SQ** (Standard sound quality)
- **HQ** (High sound quality)

The definition tags for built-in Narrowband HD™ 1.0 transcoding templates:

- **LD-NBV1** (Smooth)
- **SD-NBV1** (Standard definition)
- **HD-NBV1** (High definition)
- **FHD-NBV1** (Full high definition)
- **2K-NBV1**
- **4K-NBV1**

> - You cannot modify the definition tags of transcoding templates.
> - The audio and video resolutions, bitrates, and other parameters of Narrowband HD™ 1.0 transcoding templates are built-in and cannot be modified.
> - Narrowband HD™ 1.0 transcoding templates support only the FLV, M3U8 (HLS), and MP4 formats.', example='SD'),
        encryptSetting?: string(name='EncryptSetting', description='The encryption configuration information for transcoding.', example='"EncryptType":"Private"'),
        muxConfig?: string(name='MuxConfig', description='The segment settings for transcoding. This parameter is required for HLS. The value is a JSON string.', example='"Segment": { "Duration":"6" }'),
        packageSetting?: string(name='PackageSetting', description='The packaging configuration. Only HLS adaptive bitrate streaming packaging and DASH packaging are supported. The value is a JSON string.', example='"PackageType":"HLSPackage","PackageConfig":{   "BandWidth":"900000"  }'),
        rotate?: string(name='Rotate', description='The video rotation parameter. This parameter controls the rotation angle of the video image. For example, if you set this parameter to 180, the video image is upside down. Valid values: `[0,360]`.', example='90'),
        subtitleList?: string(name='SubtitleList', description='The subtitle configuration. The value is a JSON string.', example='[{"SubtitleUrl":"http://outin-test.oss-cn-shanghai.aliyuncs.com/subtitles/c737fece-14f1-4364-b107-d5f7f8edde0e.ass","CharEncode":"utf-8"}]'),
        templateName?: string(name='TemplateName', description='The name of the transcoding template.', example='test'),
        traceMark?: string(name='TraceMark', description='The tracing watermark information.', example='{
	"Enable": true
}'),
