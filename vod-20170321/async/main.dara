  userData?: string(name='UserData', description='The custom pass-through data.', example='{"remark":"add-french-remove-english"}', position='Query'),
  videoId: string(name='VideoId', description='**The target video ID**, used for authentication isolation and consistency verification.

This parameter is required.', example='2cd8a4f4a67cb7fb8e1236f847f4****', position='Query'),
  videoTracks?: string(name='VideoTracks', description='The list of video tracks to be added. The value is a JSON string array. Each element contains the following fields:
