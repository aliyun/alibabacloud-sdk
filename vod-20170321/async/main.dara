model GetURLUploadInfosRequest {
  jobIds?: string(name='JobIds', description='The list of upload task IDs (JobIds). It consists of one or more JobIds. A JobId is the value of the JobId response parameter returned when you call the [UploadMediaByURL](https://help.aliyun.com/document_detail/86311.html) operation.
- A maximum of 10 IDs are supported.
- Separate multiple IDs with commas (,).

> You must specify either JobIds or UploadURLs. If both are specified, only JobIds is processed.', example='86c1925fba0****,7afb201e7fa****,2cc4997378****', position='Query'),
