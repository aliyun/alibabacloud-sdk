    referenceId?: string(name='ReferenceId', description='The custom ID. The ID must be 6 to 64 characters in length and can contain only lowercase letters, uppercase letters, digits, hyphens, and underscores. The ID must be unique per user.', example='123-123'),
    regionId?: string(name='RegionId', description='The region where the audio or video file is stored.', example='cn-shanghai'),
