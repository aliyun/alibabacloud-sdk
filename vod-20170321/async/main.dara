Purge tasks (at URL granularity) submitted for the same domain name within the same second are merged into a single RefreshTaskId.
If purge tasks (at URL granularity) submitted for the same domain name within the same second exceed 2,000, they are merged into one RefreshTaskId per 2,000 tasks.', example='70422*****2904'),
  requestId?: string(name='RequestId', description='The request ID.', example='D61E4801-EAFF-4A63-****-FBF6CE1CFD1C'),
}

model RefreshVodObjectCachesResponse = {
