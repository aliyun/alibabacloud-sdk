/**
  * @description - Retrieves URL upload information by using the JobId returned during URL upload or the URL used for upload. The information includes the URL upload status, UserData, creation time, and completion time.
  * - **This operation only supports querying upload task data within the last year.**
  * - This operation is currently available only in the following regions: **China (Shanghai)** and **Singapore**.
  * - After you call the [UploadMediaByURL](~~UploadMediaByURL~~) operation to upload media files to ApsaraVideo VOD, you can call this operation to query the upload information of specified media files by using the URL pull upload task IDs (JobIds) or the media source file URLs (UploadURLs).
  * - When you call this operation, you must specify either JobIds or UploadURLs. If both are specified, only JobIds is processed.
  * - If a media file fails to be uploaded, you can call this operation to view the error code and error message. If a media file is uploaded, you can call this operation to view the corresponding media ID.
  * @param request  the request parameters of GetURLUploadInfos  GetURLUploadInfosRequest
  * @return GetURLUploadInfosResponse
 */
async function getURLUploadInfos(request: GetURLUploadInfosRequest): GetURLUploadInfosResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetURLUploadInfos', 'POST', '/', 'json', false, 'json', request);
}

model GetUploadDetailsRequest {
  mediaIds: string(name='MediaIds', description='The media IDs, which are the audio or video IDs (VideoId). Separate multiple IDs with commas (,). You can specify up to 20 IDs. You can obtain the IDs by using one of the following methods:
- For audio or video files uploaded through the console, log on to the [ApsaraVideo VOD console](https://vod.console.aliyun.com) and choose **Media Library** > **Audio and Video** to view the audio or video IDs.
- When you call the [Create upload URLs and credentials for audio and video files](https://help.aliyun.com/document_detail/55407.html) operation to obtain the upload URL and credential, the value of the VideoId response parameter is the media ID.
- After an audio or video file is uploaded, you can call the [Search for media information](https://help.aliyun.com/document_detail/86044.html) operation to query the media ID. The value of the VideoId response parameter is the media ID.

This parameter is required.', example='61ccbdb06fa83012be4d8083f6****,7d2fbc380b0e08e55f****', position='Query'),
