model AddCategoryRequest {
  cateName?: string(name='CateName', description='The category name.
- It can be up to 64 bytes in length.
- It is encoded in UTF-8.

This parameter is required.', example='Comedy'),
  parentId?: long(name='ParentId', description='The ID of the parent category.

Log on to the [ApsaraVideo VOD console](https://vod.console.aliyun.com) and choose **Configuration Management** > **Media Asset Management Configuration** > **Category Management** > **Audio/Video/Image Categories** or **Short Video Material Categories** to view the category ID.

> - If you specify this parameter, a subcategory is created under the specified parent category. If you do not specify this parameter, a level-1 category is created.
> - All level-1 categories for short video materials are built-in and cannot be modified, added, or deleted. You can only create subcategories under level-1 categories. Therefore, this parameter is required when `Type` is set to `material`.', example='100012****'),
  type?: string(name='Type', description='The category type. Valid values:

- **default**: audio, video, and image categories. This is the default value.
- **material**: short video material categories.', example='default'),
}

model AddCategoryResponseBody = {
  category?: {
    cateId?: long(name='CateId', description='The category ID. You can use it as a request parameter for the [UpdateCategory](~~UpdateCategory~~), [DeleteCategory](~~DeleteCategory~~), and [GetCategories](~~GetCategories~~) operations.', example='10020'),
    cateName?: string(name='CateName', description='The category name.', example='Comedy'),
    level?: long(name='Level', description='The category level. Valid values:
- **0**: level-1 category.
- **1**: level-2 category.
- **2**: level-3 category.', example='1'),
    parentId?: long(name='ParentId', description='The ID of the parent category.', example='100012'),
    type?: string(name='Type', description='The category type. Valid values:

- **default**: audio, video, and image categories.
- **material**: short video material categories.', example='default'),
  }(name='Category', description='The media asset category information.'),
  requestId?: string(name='RequestId', description='The request ID.', example='25818875-5F78-4AF6-D7393642CA58****'),
}

model AddCategoryResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddCategoryResponseBody(name='body'),
}

/**
 * @summary Creates a category to classify audio, video, image, and short video materials stored in ApsaraVideo VOD, making resource search and management more efficient.
 *
 * @description - Audio and video/image categories (`Type` set to `default`) support up to three levels of categories, with a maximum of 100 subcategories per level. Short video material categories (`Type` set to `material`) support up to two levels of categories, with a maximum of 100 subcategories per level.
 * - After creating a category, you can classify media assets during or after upload. For more information, see [Media asset categories](https://help.aliyun.com/document_detail/86070.html).
 *
 * @param request AddCategoryRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddCategoryResponse
 */
@context("addCategoryWithContext")
async function addCategoryWithOptions(request: AddCategoryRequest, runtime: $RuntimeOptions): AddCategoryResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.cateName)) {
    query['CateName'] = request.cateName;
  }
  if (!$isNull(request.parentId)) {
    query['ParentId'] = request.parentId;
  }
  if (!$isNull(request.type)) {
    query['Type'] = request.type;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddCategory',
    version = '2017-03-21',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Creates a category to classify audio, video, image, and short video materials stored in ApsaraVideo VOD, making resource search and management more efficient.
 *
 * @description - Audio and video/image categories (`Type` set to `default`) support up to three levels of categories, with a maximum of 100 subcategories per level. Short video material categories (`Type` set to `material`) support up to two levels of categories, with a maximum of 100 subcategories per level.
 * - After creating a category, you can classify media assets during or after upload. For more information, see [Media asset categories](https://help.aliyun.com/document_detail/86070.html).
 *
 * @param request AddCategoryRequest
 * @return AddCategoryResponse
 */
async function addCategory(request: AddCategoryRequest): AddCategoryResponse {
  var runtime = new $RuntimeOptions{};
  return addCategoryWithOptions(request, runtime);
}

