/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'AiContent';
  @version = '20240611';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-shanghai' = 'aicontent.aliyuncs.com',
    'public' = 'aicontent.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model AliyunConsoleServiceInfoDTO {
  buyUrl?: string(name='buyUrl', description='The URL to activate the service.', example='https://www.aliyun.com/product/ai-algorithm'),
  documentUrl?: string(name='documentUrl', description='The URL of the service documentation.', example='https://www.aliyun.com/product/ai-algorithm'),
  freeConcurrencyCount?: int32(name='freeConcurrencyCount', description='The maximum number of concurrent requests allowed for the free trial.', example='10'),
  freeCount?: int32(name='freeCount', description='The number of free API calls available.', example='100'),
  serviceCode?: string(name='serviceCode', description='The unique code for the service.', example='online_ai_algorithm_personalized_text_to_image_call_count'),
  serviceName?: string(name='serviceName', description='The display name of the service.', example='AI算法模型-个性化文生图-在线按量调用'),
}

model ApiKeyCreateCmd {
  clientId?: long(name='clientId', description='The customer ID. A value of null indicates the default customer.', example='1'),
}

model ApiKeyDTO {
  client?: ClientDTO(name='client'),
  clientId?: long(name='clientId', example='1'),
  deleteTag?: int32(name='deleteTag', example='0'),
  gmtCreate?: string(name='gmtCreate', example='2024-01-01T00:00:00Z'),
  gmtModified?: string(name='gmtModified', example='2024-01-01T00:00:00Z'),
  id?: long(name='id', example='1'),
  key?: string(name='key', example='key'),
  keyPreview?: string(name='keyPreview', example='sk-xxx****xxx'),
  memberUserId?: long(name='memberUserId', example='30001'),
  memberUserName?: string(name='memberUserName', example='Zhang San'),
  name?: string(name='name', example='MyApiKey'),
}

model ApiKeyDecryptedDTO {
  client?: ClientDTO(name='client', description='The associated client information.'),
  clientId?: long(name='clientId', description='The client ID.', example='1'),
  deleteTag?: int32(name='deleteTag', description='The deletion tag. A value of 0 indicates enabled, and a non-zero value indicates disabled.', example='0'),
  gmtCreate?: string(name='gmtCreate', description='The creation time.', example='2024-01-01T00:00:00Z'),
  gmtModified?: string(name='gmtModified', description='The update time.', example='2024-01-01T00:00:00Z'),
  id?: long(name='id', description='ID', example='1'),
  key?: string(name='key', description='The full key.', example='sk-xxxxxxxxxxxxxxxxxxx'),
  keyPreview?: string(name='keyPreview', description='The key preview.', example='sk-xxx****xxx'),
  name?: string(name='name', description='The key name.', example='MyApiKey'),
}

model ApiKeyListQry {
  clientId?: long(name='clientId', description='The client ID filter.', example='1'),
  keyword?: string(name='keyword', description='The search keyword.'),
  page?: int32(name='page', description='The page number.', example='1'),
  pageSize?: int32(name='pageSize', description='The number of items per page.', example='20'),
  status?: int32(name='status', description='The status filter.', example='1'),
}

model ApiKeyUpdateCmd {
  name?: string(name='name', example='MyApiKey'),
  status?: int32(name='status', example='1'),
}

model BalanceOrderDTO {
  amount?: double(name='amount', description='The change amount.', example='100.00'),
  balanceAfter?: double(name='balanceAfter', description='The pool balance after the change.', example='600.00'),
  balanceBefore?: double(name='balanceBefore', description='The pool balance before the change.', example='500.00'),
  balanceType?: string(name='balanceType', description='The balance type (permanent: Permanent / monthly: Monthly).', example='permanent'),
  createTime?: string(name='createTime', description='The creation time.', example='2024-07-15T10:30:00+08:00'),
  direction?: string(name='direction', description='The direction (in: Income / out: Expense).', example='in'),
  modelCode?: string(name='modelCode', description='The associated model code (available for deduction types).', example='qwen-max'),
  operatorId?: string(name='operatorId', description='The operator ID.', example='12345'),
  orderId?: string(name='orderId', description='The unique identifier of the change record.', example='ord_20240715_abc123'),
  orderType?: string(name='orderType', description='The change type (recharge: Recharge / periodic_recharge: Periodic recharge / deduct: Deduction / manual_deduct: Manual deduction / transfer_out: Transfer out / transfer_in: Transfer in / return_out: Refund out / return_in: Refund in / write_off: Write-off / monthly_expire: Monthly expiration / deficit_writeoff: Deficit write-off).', example='recharge'),
  remark?: string(name='remark', description='The remark.', example='Manual recharge by administrator'),
  source?: string(name='source', description='The source identifier.', example='console'),
  totalAfter?: double(name='totalAfter', description='The total balance after the change (permanent + monthly).', example='1600.00'),
  totalBefore?: double(name='totalBefore', description='The total balance before the change (permanent + monthly).', example='1500.00'),
}

model BalancePoolSummaryDTO {
  allocated?: double(name='allocated', description='The balance allocated to users equals the sum of the sub-wallet balances of all members in the department.', example='40.00'),
  available?: double(name='available', description='The available department balance equals the sub-wallet balance of the department.', example='60.00'),
  total?: double(name='total', description='The total amount equals the available department balance plus the balance allocated to users.', example='100.00'),
}

model BatchCreateModelItemDTO {
  description?: string(name='description', description='The model description.', example='Qwen Max'),
  extensions?: string(name='extensions', description='The extension configuration parameters in JSON string format.', example='{}'),
  inOut?: string(name='inOut', description='The supported input and output data types, separated by commas.', example='text'),
  maxInputLength?: string(name='maxInputLength', description='The maximum input length in tokens.', example='128000'),
  maxOutputLength?: string(name='maxOutputLength', description='The maximum output length in tokens.', example='8192'),
  modelId: string(name='modelId', description='The model identifier. This parameter is required and corresponds to the model ID on the vendor side. If the identifier is duplicated, the backend automatically increments the version by using v1 or v2.

This parameter is required.', example='qwen-max'),
  modelType: string(name='modelType', description='The model type. This parameter is required. Valid values: Chat, Embedding, Rerank, Image, Audio, and Video.

This parameter is required.', example='Chat'),
  name: string(name='name', description='The model name. This parameter is required. If the identifier is duplicated, add -v1 or -v2 to distinguish the models.

This parameter is required.', example='qwen-max'),
  tags?: string(name='tags', description='The tags, separated by commas.', example='chat,NLP'),
}

model BatchFailedItemDTO {
  reason?: string(name='reason', description='The reason for failure.', example='Missing member node'),
  userId?: long(name='userId', description='The user ID of the failed member.', example='1'),
}

model BatchModelErrorDTO {
  errorMsg?: string(name='errorMsg', description='The failure cause.', example='The model type cannot be empty'),
  modelId?: string(name='modelId', description='The model ID.', example='qwen-max'),
  name?: string(name='name', description='The model name.', example='qwen-max'),
}

model BatchOpResultDTO {
  failed?: [
    BatchFailedItemDTO
  ](name='failed', description='The list of failed items.', example='[]'),
  succeeded?: [ long ](name='succeeded', description='The list of successful member user IDs.', example='[]'),
}

