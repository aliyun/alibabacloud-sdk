  apiKeyName?: string(name='apiKeyName', description='The name of the API key.', example='Default key'),
  cacheCreationTokens?: double(name='cacheCreationTokens', description='The number of cache creation tokens for explicit cache writes.', example='0'),
  cachedTokens?: double(name='cachedTokens', description='The number of cache hit tokens.', example='256'),
  clientId?: long(name='clientId', description='The department ID. A value of 0 indicates that the request does not belong to any department.', example='1'),
  clientName?: string(name='clientName', description='The department name.', example='R&D Department'),
  discount?: double(name='discount', description='The discount factor. A value of 1.0 indicates no discount.', example='1.0'),
  inputTokens?: double(name='inputTokens', description='The number of input tokens, including cached tokens and cache creation tokens.', example='1024'),
  memberUserId?: long(name='memberUserId', description='The user ID of the member. For department rows, the value is 0.', example='30001'),
  memberUserName?: string(name='memberUserName', description='The name of the member. For department rows, the value is empty.', example='John Doe'),
  metrics?: string(name='metrics', description='The JSON containing other metering field mappings, such as video duration and number of images. Fields with a value of 0 are not returned.', example='{}'),
  modelCode?: string(name='modelCode', description='The model identifier.', example='qwen-plus'),
  modelId?: long(name='modelId', description='The model ID.', example='1'),
  modelName?: string(name='modelName', description='The model name.', example='Qwen-Plus'),
  modelSymbol?: string(name='modelSymbol', description='The model symbol, which is the vendor identifier.', example='qwen'),
  modelType?: string(name='modelType', description='The model type.', example='Chat'),
  modelVersion?: int32(name='modelVersion', description='The model version number.', example='1'),
  outputTokens?: double(name='outputTokens', description='The number of output tokens.', example='512'),
  reasoningTokens?: double(name='reasoningTokens', description='The number of reasoning tokens.', example='128'),
  requestId?: string(name='requestId', description='The unique identifier of the request.', example='chatcmpl-abc123def456'),
  requestTime?: long(name='requestTime', description='The request time as a UNIX timestamp in seconds.', example='1700000000'),
  totalTokens?: double(name='totalTokens', description='The total number of tokens.', example='1536'),
  usageDetail?: string(name='usageDetail', description='The raw JSON of usage details.', example='{"input_tokens": 1024, "output_tokens": 512}'),
}

