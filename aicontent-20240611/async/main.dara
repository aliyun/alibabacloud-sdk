  memberUserId?: long(name='memberUserId', description='The member user ID for a member row. The value is 0 for a department row.', example='30001'),
  memberUserName?: string(name='memberUserName', description='The member name for a member row. The value is empty for a department row.', example='John'),
  metrics?: string(name='metrics', description='The JSON of other metering field mapping, such as video duration and image count. Fields with a value of 0 are not included in the output.', example='{}'),
  modelCode?: string(name='modelCode', description='The model identifier.', example='qwen-plus'),
  modelId?: long(name='modelId', description='The model ID.', example='1'),
  modelName?: string(name='modelName', description='The model name.', example='Qwen-Plus'),
  modelSymbol?: string(name='modelSymbol', description='The model symbol (provider identifier).', example='qwen'),
  modelType?: string(name='modelType', description='The model type.', example='Chat'),
  modelVersion?: int32(name='modelVersion', description='The model version number.', example='1'),
  outputTokens?: double(name='outputTokens', description='The number of output tokens.', example='512'),
  reasoningTokens?: double(name='reasoningTokens', description='The number of reasoning tokens.', example='128'),
  requestId?: string(name='requestId', description='The unique request ID.', example='chatcmpl-abc123def456'),
  requestTime?: long(name='requestTime', description='The request time as a UNIX timestamp in seconds.', example='1700000000'),
  totalTokens?: double(name='totalTokens', description='The total number of tokens.', example='1536'),
  usageDetail?: string(name='usageDetail', description='The raw JSON of the usage details.', example='{"input_tokens": 1024, "output_tokens": 512}'),
}

