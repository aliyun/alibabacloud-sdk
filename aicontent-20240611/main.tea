  expiresAt?: string(name='expiresAt', description='The expiration time of the download URL, in RFC 3339 format.', example='2026-08-28T12:00:00Z'),
  method?: string(name='method', description='The download request method. The value is fixed to GET.', example='GET'),
  sourceId?: string(name='sourceId', description='The unique identifier of the source file.', example='3f2a1b9c8d7e4f60a1b2c3d4e5f6a7b8'),
}

model MiguSourceUploadDTO {
