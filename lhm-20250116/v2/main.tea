    body['basicMetricRules'] = request.basicMetricRules;
  }
  if (!$isNull(request.checkType)) {
    body['checkType'] = request.checkType;
  }
  if (!$isNull(request.complexMetricRules)) {
    body['complexMetricRules'] = request.complexMetricRules;
  }
  if (!$isNull(request.dsEngineRels)) {
    body['dsEngineRels'] = request.dsEngineRels;
  }
  if (!$isNull(request.fulltextRule)) {
    body['fulltextRule'] = request.fulltextRule;
  }
  if (!$isNull(request.metricRules)) {
    body['metricRules'] = request.metricRules;
  }
  if (!$isNull(request.nullRules)) {
    body['nullRules'] = request.nullRules;
  }
  if (!$isNull(request.requestId)) {
    body['requestId'] = request.requestId;
  }
  if (!$isNull(request.templateDesc)) {
    body['templateDesc'] = request.templateDesc;
  }
  if (!$isNull(request.templateName)) {
    body['templateName'] = request.templateName;
  }
  if (!$isNull(request.tenantId)) {
    body['tenantId'] = request.tenantId;
  }
  if (!$isNull(request.weakContentRule)) {
    body['weakContentRule'] = request.weakContentRule;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddDataCheckTemplate',
    version = '2025-01-16',
    protocol = 'HTTPS',
    pathname = `/dataCheck/template/v3/create`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

