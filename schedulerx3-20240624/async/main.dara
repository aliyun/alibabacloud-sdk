model CreateJobRequest {
  regionId?: string(name='RegionId', example='cn-hangzhou', position='Host'),
  appName: string(name='AppName', description='The application name.

This parameter is required.', example='test-app', position='Body'),
  attemptInterval?: int32(name='AttemptInterval', description='The retry interval for errors. Unit: seconds. Default value: 30.', example='3', position='Body'),
  calendar?: string(name='Calendar', description='The custom calendar. You can specify a custom calendar for the cron type.', example='workday', position='Body'),
  childJobId?: string(name='ChildJobId', description='The IDs of child jobs. Separate multiple IDs with commas.', example='1,2', position='Body'),
  clusterId: string(name='ClusterId', description='The cluster ID.

This parameter is required.', example='xxljob-b6ec1xxxx', position='Body'),
  coordinate?: {
    height?: float(name='Height', description='The height.', example='50.0'),
    width?: float(name='Width', description='The width.', example='100.0'),
    x?: float(name='X', description='The X-coordinate.', example='100.0'),
    y?: float(name='Y', description='The Y-coordinate.', example='100.0'),
  }(name='Coordinate', description='The coordinates of the node in the workflow.', shrink='json', position='Body'),
  dependentStrategy?: int32(name='DependentStrategy', description='The dependency strategy.', example='1', position='Body'),
  description?: string(name='Description', description='The job description.', example='test', maxLength=300, position='Body'),
  executorBlockStrategy?: int32(name='ExecutorBlockStrategy', description='The client blocking strategy. Valid values:
- 1: serial execution on a single machine
- 2: ignore subsequent scheduling
- 3: overwrite previous scheduling', example='1', position='Body'),
  jobHandler?: string(name='JobHandler', description='The name of the job handler.', example='testJobVoidHandler', position='Body'),
  jobType: string(name='JobType', description='The job type.

This parameter is required.', example='xxljob', position='Body'),
  label?: string(name='Label', description='The job label information.', example='{key:value}', position='Body'),
  maxAttempt?: int32(name='MaxAttempt', description='The maximum number of retries for errors. Set this parameter based on your business requirements.', example='3', position='Body'),
  maxConcurrency?: int32(name='MaxConcurrency', description='The maximum concurrency.', example='1', minimum=1, maximum=200, position='Body'),
  name: string(name='Name', description='The job name.

This parameter is required.', example='test-job', minLength=1, maxLength=200, position='Body'),
  noticeConfig?: {
    endEarly?: int32(name='EndEarly', description='The early completion threshold. Unit: seconds.', example='30'),
    endEarlyEnable?: boolean(name='EndEarlyEnable', description='Specifies whether to enable the early completion alert.'),
    failEnable?: boolean(name='FailEnable', description='Specifies whether to enable failure alerts. Valid values:

- **true**: enables failure alerts.
- **false**: disables failure alerts.', example='true'),
    failLimitTimes?: int32(name='FailLimitTimes', description='The number of consecutive failures.
> An alert is triggered only when the number of consecutive failures exceeds the specified value.', example='1'),
    missWorkerEnable?: boolean(name='MissWorkerEnable', description='Specifies whether to enable alerts for unavailable workers. Valid values:
- **true**: enables alerts for unavailable workers.
- **false**: disables alerts for unavailable workers.', example='true'),
    sendChannel?: string(name='SendChannel', description='The notification channels. Valid values:
- sms: SMS
- phone: phone call
- mail: email
- webhook: webhook
> Separate multiple notification channels with commas.', example='mail'),
    successNotice?: boolean(name='SuccessNotice', description='Specifies whether to enable success notifications. Valid values:

- true: enables success notifications.
- false: disables success notifications.', example='true'),
    timeout?: long(name='Timeout', description='The timeout period. Unit: seconds.', example='30'),
    timeoutEnable?: boolean(name='TimeoutEnable', description='Specifies whether to enable the timeout alert. Valid values:

- **true**: enabled

- **false**: disabled', example='true'),
    timeoutKillEnable?: boolean(name='TimeoutKillEnable', description='Specifies whether to enable the timeout termination feature. Valid values:

- **true**: enables the timeout termination feature.
- **false**: disables the timeout termination feature.', example='true'),
  }(name='NoticeConfig', description='The notification configuration.', shrink='json', position='Body'),
  noticeContacts?: [ 
    {
      contactType?: int32(name='ContactType', description='The notification recipient type. Valid values:

- 1: alert contact

- 2: alert contact group', example='1'),
      name?: string(name='Name', description='The name of the alert contact or alert contact group.', example='xiaoming'),
    }
  ](name='NoticeContacts', description='The notification contact configuration.', shrink='json', position='Body'),
  parameters?: string(name='Parameters', description='The job parameters.', example='test', position='Body'),
  priority?: int32(name='Priority', description='The priority. Valid values:
- 1: low
- 5: medium
- 10: high
- 15: very high', example='5', minimum=1, position='Body'),
  routeStrategy?: int32(name='RouteStrategy', description='The routing strategy. Valid values:
- 1: round-robin
- 2: random
- 3: first
- 4: last
