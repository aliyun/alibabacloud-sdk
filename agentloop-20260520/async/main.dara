model CreatePipelineRequest {
  agentSpace?: string(name='agentSpace', description='The name of the AgentSpace. The pipeline will be created under this AgentSpace.', example='my-agent-space', position='Path'),
  description?: string(name='description', description='The description of the pipeline. Maximum length: 256 characters.', example='Collect trace data from SLS and perform data cleaning into a dataset', position='Body'),
  executePolicy?: {
    continuous?: {
      fromTime?: long(name='fromTime', description='The bootstrap start time in UNIX seconds. It has the same precision as runOnce or scheduled fromTime. Millisecond values greater than or equal to 1e12 are automatically converted. The cursor starts from this time aligned to the grid and catches up window by window. After catching up, it switches to minute intervals. By default, it starts from the current time and processes only incremental data.', example='1735660800'),
    }(name='continuous', description='The continuous execution configuration. This is used when the type is trace. The processing frequency is a fixed value managed by the server.', example='{"fromTime":1735660800}'),
    mode?: string(name='mode', description='The scheduling mode. Valid values: RunOnce (single execution) and Scheduled (periodic scheduling).', example='RunOnce'),
    runOnce?: {
      fromTime?: long(name='fromTime', description='The start time of the data processing window in UNIX seconds. The value must be less than the toTime value.', example='1735660800'),
      toTime?: long(name='toTime', description='The end time of the data processing window in UNIX seconds. The value must be greater than the fromTime value.', example='1735747200'),
    }(name='runOnce', description='The single execution configuration. This parameter is required only when the mode is RunOnce.', example='{"fromTime":1735660800,"toTime":1735664400}'),
    scheduled?: {
      fromTime?: long(name='fromTime', description='The start time of the scheduling in UNIX milliseconds.', example='1735660800000'),
      interval?: string(name='interval', description='The scheduling interval. Valid values: 1h, 6h, 12h, and 1d.', example='1h'),
    }(name='scheduled', description='The periodic scheduling configuration. This parameter is required only when the mode is Scheduled.', example='{"interval":"1h","fromTime":1735660800}'),
  }(name='executePolicy', description='The scheduling method.', example='{"mode":"RunOnce","runOnce":{"fromTime":1735660800,"toTime":1735664400}}', position='Body'),
  pipeline?: {
    nodes?: [ 
      {
        id?: string(name='id', description='The ID of the node.', example='node-1'),
        parameters?: map[string]any(name='parameters', description='The parameters of the node. This is a key-value structure and varies based on the node type.'),
        type?: string(name='type', description='The type of the node.', example='transform'),
      }
    ](name='nodes', description='The list of nodes.', example='[{"id":"select-fields","type":"project","parameters":{}}]'),
  }(name='pipeline', description='The pipeline configuration, including node orchestration.', example='{"nodes":[{"id":"select-fields","type":"project","parameters":{"question":"user_query"}}]}', position='Body'),
  pipelineName?: string(name='pipelineName', description='The name of the pipeline. The name must be 3 to 63 characters in length and can contain only lowercase letters, digits, and hyphens (-).', example='my-pipeline', position='Body'),
  sink?: {
    condition?: {
      defaultSink?: {
        dataset?: {
          agentSpace?: string(name='agentSpace', description='The name of the agent space to which the default destination dataset belongs.', example='my-agent-space'),
          dataset?: string(name='dataset', description='The name of the default destination dataset.', example='other-result'),
        }(name='dataset', description='The default destination dataset.'),
        type?: string(name='type', description='The default destination type. Currently, only dataset is supported.', example='dataset'),
      }(name='defaultSink', description='The default write destination used when no conditional route is matched.'),
      matchMode?: string(name='matchMode', description='The route matching mode. Currently, only all is supported.', example='all'),
      routes?: [ 
        {
          expression?: string(name='expression', description='The route expression in Search Processing Language (SPL). Only where, project, and extend are supported.', example='* | where intent = \\\\"refund\\\\"'),
          id?: string(name='id', description='The route ID.', example='refund'),
          sink?: {
            dataset?: {
              agentSpace?: string(name='agentSpace', description='The name of the agent space to which the destination dataset belongs.', example='my-agent-space'),
              dataset?: string(name='dataset', description='The name of the destination dataset.', example='refund-result'),
            }(name='dataset', description='The destination dataset for the route.'),
            type?: string(name='type', description='The destination type for the route. Currently, only dataset is supported.', example='dataset'),
          }(name='sink', description='The write destination for the route.'),
        }
      ](name='routes', description='The list of conditional routes.'),
    }(name='condition', description='The conditional routing configuration. This is used only when sink.type is set to condition.'),
    dataset?: {
      agentSpace?: string(name='agentSpace', description='The name of the agent space to which the destination dataset belongs.', example='my-agent-space'),
      dataset?: string(name='dataset', description='The name of the destination dataset.', example='my-dataset'),
    }(name='dataset', description='The destination dataset configuration for the dataset sink. This is used only when sink.type is set to dataset.'),
    type?: string(name='type', description='The destination type. Currently, dataset is supported.', example='Dataset'),
  }(name='sink', description='The pipeline sink, which is the data write destination.', position='Body'),
  source?: {
    dataset?: {
      dataset?: string(name='dataset', description='The name of the source dataset.', example='my-dataset'),
      filter?: string(name='filter', description='The data filter condition for the dataset.', example='status = \\\\"pending\\\\"'),
    }(name='dataset', description='The dataset datasource config under the current agent space.', example='{"dataset":"my-dataset","filter":"status = \\\\"pending\\\\""}'),
    inputFields?: [ 
      {
        name?: string(name='name', description='The name of the field.', example='question'),
        type?: string(name='type', description='The data type of the field. Valid values: text, long, double, and json.', example='text'),
      }
    ](name='inputFields', description='The input fields and their data types. This applies to all data source types.', example='[{"name":"question","type":"text"}]'),
    logstore?: {
      logstore?: string(name='logstore', description='The name of the Simple Log Service Logstore.', example='my-sls-logstore'),
      project?: string(name='project', description='The name of the Simple Log Service project.', example='my-sls-project'),
      query?: string(name='query', description='The data filtered query statement, which uses the Simple Log Service query and analysis syntax.', example='* | SELECT *'),
    }(name='logstore', description='The Simple Log Service Logstore datasource config.', example='{"project":"my-sls-project","logstore":"agent-logs"}'),
    trajectory?: {
      enrich?: {
        columns?: [ string ](name='columns', description='The list of enrichment columns. This parameter is retained for backward compatibility. The current implementation outputs only the fixed agent_trajectory column, and this parameter no longer affects the output.', example='["input","output","session_id"]'),
        enabled?: boolean(name='enabled', description='Specifies whether to enable trajectory enrichment.', example='false'),
      }(name='enrich', description='The trajectory enrichment configuration. It mounts trajectory data into the scrubbing results based on the trace_id. When writing to a dataset, the data is stored in the fixed agent_trajectory column, where the column value is the trajectory JSON content.', example='{"enabled":true,"columns":["input","output"]}'),
    }(name='trajectory', description='The trajectory data configuration. This is optional and takes effect only when the type is set to trace. It retrieves ATIF standard trajectory data from the trajectory scrubbing service and extends it based on features.', example='{"enrich":{"enabled":true,"columns":["input","output"]}}'),
    type?: string(name='type', description='The data source type. Currently, Simple Log Service is supported.', example='SLS'),
  }(name='source', description='The data source for the pipeline.', example='{"type":"logstore","logstore":{"project":"my-sls-project","logstore":"agent-logs"},"inputFields":[{"name":"question","type":"text"}]}', position='Body'),
  clientToken?: string(name='clientToken', description='The idempotency token. This is a unique string generated by the client to ensure the idempotency of the create operation.', example='a1b2c3d4-1234-5678-90ab-cdef12345678', position='Query'),
}

