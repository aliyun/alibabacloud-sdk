model UpdatePipelineRequest {
  agentSpace?: string(name='agentSpace', description='The name of the AgentSpace where the pipeline to be updated is located.', example='my-agent-space', position='Path'),
  pipelineName?: string(name='pipelineName', description='The name of the pipeline to be updated.', example='my-pipeline', position='Path'),
  description?: string(name='description', description='The description of the pipeline, which helps business users understand its purpose.', example='My pipeline', position='Body'),
  executePolicy?: {
    continuous?: {
      fromTime?: long(name='fromTime', description='The bootstrap start time, specified as a UNIX timestamp in seconds. The precision is the same as that of runOnce or scheduled.fromTime. Millisecond values greater than or equal to 1e12 are automatically converted to seconds. The cursor starts from this time aligned to the grid and catches up window by window. After catching up, it switches to minute intervals. By default, the cursor starts from the current time and processes only incremental data.', example='1735660800'),
    }(name='continuous', description='The continuous execution configuration. This parameter is used when the type is trace. The processing frequency is a fixed value managed by the server.', example='{"fromTime":1735660800}'),
    mode?: string(name='mode', description='The scheduling mode. Valid values: RunOnce (single execution), Scheduled (periodic execution), and Continuous (continuous execution, applicable only to trace data sources). For Continuous mode, the processing frequency is a fixed value managed by the server, and data is automatically processed at minute intervals after the trace is completed.', example='Scheduled'),
    runOnce?: {
      fromTime?: long(name='fromTime', description='The start time of the data processing window, specified as a UNIX timestamp in seconds. The value must be less than the value of toTime.', example='1735660800'),
      toTime?: long(name='toTime', description='The end time of the data processing window, specified as a UNIX timestamp in seconds. The value must be greater than the value of fromTime.', example='1735747200'),
    }(name='runOnce', description='The single execution configuration. This parameter is required only when the mode is set to RunOnce.', example='{"fromTime":1735660800,"toTime":1735664400}'),
    scheduled?: {
      fromTime?: long(name='fromTime', description='The scheduling start time, specified as a UNIX timestamp in seconds. The precision is the same as that of runOnce.fromTime. Millisecond values greater than or equal to 1e12 are automatically converted to seconds.', example='1735660800'),
      interval?: string(name='interval', description='The scheduling interval. Valid values: 1h, 6h, 12h, and 1d.', example='1h'),
    }(name='scheduled', description='The periodic scheduling configuration. This parameter is required only when the mode is set to Scheduled.', example='{"interval":"1h","fromTime":1735660800}'),
  }(name='executePolicy', description='The scheduling policy. If this parameter is specified, the existing policy is completely overwritten.', example='{"mode":"RunOnce","runOnce":{"fromTime":1735660800,"toTime":1735664400}}', position='Body'),
  pipeline?: {
    nodes?: [ 
      {
        id?: string(name='id', description='The ID of the node.', example='node-1'),
        parameters?: map[string]any(name='parameters', description='The parameters of the node. The parameters use a key-value structure and vary based on the node type.'),
        type?: string(name='type', description='The type of the node.', example='transform'),
      }
    ](name='nodes', description='The list of nodes.', example='[{"id":"select-fields","type":"project","parameters":{}}]'),
  }(name='pipeline', description='The pipeline configuration, which defines node orchestration. If this parameter is specified, the existing configuration is completely overwritten.', position='Body'),
  sink?: {
    condition?: {
      defaultSink?: {
        dataset?: {
          agentSpace?: string(name='agentSpace', description='The name of the AgentSpace to which the default destination dataset belongs.', example='my-agent-space'),
          dataset?: string(name='dataset', description='The name of the default destination dataset.', example='other-result'),
        }(name='dataset', description='The default destination dataset.'),
        type?: string(name='type', description='The default destination type. Currently, only dataset is supported.', example='dataset'),
      }(name='defaultSink', description='The default sink used when no conditional route is matched.'),
      matchMode?: string(name='matchMode', description='The route matching mode. Currently, only all is supported.', example='all'),
      routes?: [ 
        {
          expression?: string(name='expression', description='The route expression in Search Processing Language (SPL). Only where, project, and extend are supported.', example='* | where intent = \\\\"refund\\\\"'),
          id?: string(name='id', description='The route ID.', example='refund'),
          sink?: {
            dataset?: {
              agentSpace?: string(name='agentSpace', description='The name of the AgentSpace to which the destination dataset belongs.', example='my-agent-space'),
              dataset?: string(name='dataset', description='The name of the destination dataset.', example='refund-result'),
            }(name='dataset', description='The destination dataset for the route.'),
            type?: string(name='type', description='The route destination type. Currently, only dataset is supported.', example='dataset'),
          }(name='sink', description='The sink for the route.'),
        }
      ](name='routes', description='The list of conditional routes.'),
    }(name='condition', description='The conditional routing configuration. This parameter is used only when sink.type is set to condition.'),
    dataset?: {
      agentSpace?: string(name='agentSpace', description='The name of the AgentSpace to which the destination dataset belongs.', example='my-agent-space'),
      dataset?: string(name='dataset', description='The name of the destination dataset.', example='my-dataset'),
    }(name='dataset', description='The destination dataset configuration for the dataset sink. This parameter is used only when sink.type is set to dataset.'),
    type?: string(name='type', description='The destination type. Valid values: dataset and condition.', example='condition'),
  }(name='sink', description='The pipeline sink (data write destination). Passing this parameter overwrites the entire configuration.', position='Body'),
  source?: {
    dataset?: {
      dataset?: string(name='dataset', description='The name of the source dataset.', example='my-dataset'),
      filter?: string(name='filter', description='The data filter condition for the dataset.', example='status = \\\\"pending\\\\"'),
    }(name='dataset', description='The dataset datasource config in the current AgentSpace.', example='{"dataset":"my-dataset","filter":"status = \\\\"pending\\\\""}'),
    inputFields?: [ 
      {
        name?: string(name='name', description='The name of the field.', example='question'),
        type?: string(name='type', description='The type of the field. Valid values: text, long, double, and json.', example='text'),
      }
    ](name='inputFields', description='The input fields and their types. This parameter applies to all data source types.', example='[{"name":"question","type":"text"}]'),
    logstore?: {
      logstore?: string(name='logstore', description='The name of the SLS Logstore.', example='my-sls-logstore'),
      project?: string(name='project', description='The name of the SLS project.', example='my-sls-project'),
      query?: string(name='query', description='The filtered query statement in SLS query and analysis syntax.', example='* | SELECT *'),
    }(name='logstore', description='The Simple Log Service (SLS) Logstore datasource config.', example='{"project":"my-sls-project","logstore":"agent-logs"}'),
    trajectory?: {
      enrich?: {
        columns?: [ string ](name='columns', description='The list of enrichment columns. This parameter is retained for compatibility. The current implementation outputs a single fixed column agent_trajectory, and this parameter no longer affects the output.', example='["input","output","session_id"]'),
        enabled?: boolean(name='enabled', description='Specifies whether to enable trajectory enrichment.', example='false'),
      }(name='enrich', description='The trajectory enrichment. It mounts trajectory data into the scrubbing result by trace_id. When writing to a dataset, the data is carried in the fixed column agent_trajectory, where the column value is the trajectory JSON content.', example='{"enabled":true,"columns":["input","output"]}'),
    }(name='trajectory', description='The trajectory data configuration. This parameter is optional and takes effect only when type is set to trace. It obtains ATIF standard trajectory data from the trajectory scrubbing service and extends it by feature.', example='{"enrich":{"enabled":true,"columns":["input","output"]}}'),
    type?: string(name='type', description='The data source type. Valid values: logstore, dataset, and trace. The trace value indicates a trajectory signal-driven processing mode. The validity of the enum values is verified by the server.', example='dataset'),
  }(name='source', description='The pipeline data source. Passing this parameter overwrites the entire configuration.', example='{"type":"logstore","logstore":{"project":"my-sls-project","logstore":"agent-logs"},"inputFields":[{"name":"question","type":"text"}]}', position='Body'),
  clientToken?: string(name='clientToken', description='The idempotency token. It is a unique string generated by the client to ensure the idempotence of the update operation.', example='a1b2c3d4-1234-5678-90ab-cdef12345678', position='Query'),
}

