This parameter is required.', example='my-context-store', minLength=2, maxLength=64, position='Path'),
  changeNote?: string(name='changeNote', description='The description of the policy change. A new policy version is created when policy fields in the configuration are modified.', example='Relax similarity threshold', position='Body'),
  config?: {
    audit?: {
      droppedCandidates?: boolean(name='droppedCandidates', description='Specifies whether to write item events for dropped recall candidates. Default value: false.', example='false'),
      queryMode?: string(name='queryMode', description='The recording mode for recall queries. Valid values: raw (plaintext) and hash (HMAC only). Default value: raw.', example='raw'),
      retentionDays?: int32(name='retentionDays', description='The number of days to retain audit logs. Valid values: 1 to 180. Default value: 30.', example='30'),
    }(name='audit', description='The audit configuration.'),
