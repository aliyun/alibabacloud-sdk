      categories?: [ string ](name='categories', description='The list of memory categories.', example='["preference","profile"]'),
      customInstructions?: string(name='customInstructions', description='The custom extraction instructions. This parameter is required when preset is set to custom. Length: 1 to 8000 characters.', example='Extract only user product preferences'),
      excludeRules?: [ string ](name='excludeRules', description='The list of exclusion rules. Content that matches these rules is not extracted.', example='["Password","ID number"]'),
      model?: {
        name?: string(name='name', description='The name of the extraction model. Currently, only qwen3.8-flash is supported, which uses internal platform credentials.', example='qwen3.8-flash'),
      }(name='model', description='The extraction model configuration.'),
      preset?: string(name='preset', description='The preset policy. Valid values: fact, toc-profile, tob-digital-twin, and custom. Default value: fact.', example='fact'),
    }(name='extractionPolicy', description='The extraction policy for the memory type.'),
    metadataField?: map[string]string(name='metadataField', description='The metadata field mapping. The key is the business field, and the value is the storage field.', example='{"userId":"user_id","sessionId":"session_id"}'),
    scopePolicy?: {
      requiredAnyOf?: [ string ](name='requiredAnyOf', description='The list of scope fields where at least one must be non-empty. Valid element values: userId, agentId, appId, and runId.', example='["userId"]'),
    }(name='scopePolicy', description='The scope constraint policy.'),
    source?: {
      agentSpace?: string(name='agentSpace', description='The AgentSpace where the trace data source is located. Cross-AgentSpace is not supported in the current phase. If provided, it must be equal to the path AgentSpace. Otherwise, a 400 parameter error is returned. The AgentSpace cannot be changed after creation.', example='my-agent-space'),
      dataset?: {
        customFields?: [ 
          {
            description?: string(name='description', description='The description of the field. This parameter is required when usage is set to extraction-input.', example='Customer tier'),
            sensitive?: boolean(name='sensitive', description='Specifies whether the field is a sensitive field.', example='false'),
            sourceField?: string(name='sourceField', description='The name of the source field.', example='customerTier'),
            target?: string(name='target', description='The target write path, such as metadata.customerTier.', example='metadata.customerTier'),
            usage?: string(name='usage', description='The usage of the field. Valid values: extraction-input (participates in extraction) and ignore (ignored).', example='extraction-input'),
          }
        ](name='customFields', description='The list of custom field declarations. If provided, it fully overwrites the existing declarations.'),
        filter?: {
          where?: string(name='where', description='The subset of the Pipeline where clause, which is pushed down to SQL.', example='appId = \\\\"crm-service\\\\"'),
        }(name='filter', description='The row filter conditions.'),
        pollIntervalSeconds?: int32(name='pollIntervalSeconds', description='The polling interval in seconds. Valid values: 60 to 3600.', example='300'),
      }(name='dataset', description='The updatable items for the Dataset data source. The datasetName cannot be changed after creation.'),
      startTime?: string(name='startTime', description='The start time for data backfill, in ISO 8601 UTC format.', example='2026-01-01T00:00:00Z'),
      trajectory?: {
        filter?: {
          agentNames?: [ string ](name='agentNames', description='The list of agent names. An explicitly empty list returns a 400 error.', example='["sales-copilot"]'),
          excludeDegraded?: boolean(name='excludeDegraded', description='Specifies whether to exclude degraded trajectories. Default value: false (degraded trajectories are included).', example='false'),
          minStepCount?: int32(name='minStepCount', description='The minimum number of steps, which must be greater than or equal to 0.', example='2'),
          query?: string(name='query', description='The native SLS query statement. This statement is combined with the preceding conditions by using the AND operator.', example='tool_names:"search_order"'),
          serviceNames?: [ string ](name='serviceNames', description='The list of service names. A single trailing asterisk (*) is supported. Specifying an explicitly empty list returns a 400 error.', example='["crm-service","app-*"]'),
        }(name='filter', description='The trajectory filter conditions. Conditions are combined with AND, while items within a list are combined with OR.'),
        logstore?: string(name='logstore', description='The name of the trajectory Logstore. Default value: agent-trajectory. This parameter cannot be modified after creation.', example='agent-trajectory'),
        pollIntervalSeconds?: int32(name='pollIntervalSeconds', description='The polling interval in seconds. Valid values: 60 to 3600.', example='300'),
        scopeMapping?: {
          agentId?: string(name='agentId', description='The JSONPath expression for the agentId field. Default value: $.agent_name.', example='$.agent_name'),
          appId?: string(name='appId', description='The JSONPath expression for the appId field. Default value: $.service_names[0].', example='$.service_names[0]'),
          runId?: string(name='runId', description='The JSONPath expression for the runId field. Default value: $.trajectory_id.', example='$.trajectory_id'),
          userId?: string(name='userId', description='The JSONPath expression for the userId field. By default, this field is not mapped.', example='$.trajectory_extensions.user_id'),
        }(name='scopeMapping', description='The scope field mapping. The value must be a JSONPath expression. Only the $.a.b and $.a[0] formats are supported.'),
      }(name='trajectory', description='The updatable items for the trajectory data source. The source.type cannot be changed after creation.'),
    }(name='source', description='The datasource config, which serves only as the root identity for the data source.'),
    storagePolicy?: {
      allowedActions?: [ string ](name='allowedActions', description='The allowed storage actions. By default, all actions are allowed: ADD, UPDATE, MERGE, and DELETE.', example='["ADD","UPDATE","MERGE","DELETE"]'),
      dedupe?: boolean(name='dedupe', description='Specifies whether to deduplicate events in event mode. Default value: true.', example='true'),
      humanEditProtection?: boolean(name='humanEditProtection', description='Specifies whether to enable human edit protection. Default value: true. When this feature is enabled, automatic extraction does not overwrite manually modified memories.', example='true'),
      mergeKey?: string(name='mergeKey', description='The merge key for upsert operations. Valid values: factKey, semantic, and both. Default value: semantic.', example='semantic'),
      mode?: string(name='mode', description='The storage mode. Valid values: event (append events) and upsert (merge and update). Default value: upsert.', example='upsert'),
      similarityThreshold?: double(name='similarityThreshold', description='The similarity threshold for semantic merging. Valid values: 0 to 1. Default value: 0.4.', example='0.4'),
      ttlDays?: int32(name='ttlDays', description='The number of days before the memory expires. A value of 0 indicates that the memory never expires.', example='0'),
    }(name='storagePolicy', description='The storage policy for the memory type.'),
  }(name='config', description='The context library configuration. If provided, it fully overwrites the existing configuration. If omitted, the original configuration is retained.', position='Body'),
  contextType?: string(name='contextType', description='The context library type. This field is typically immutable after creation and is provided only for exception correction.', example='experience', position='Body'),
  description?: string(name='description', description='The description of the context library, which helps business users understand its purpose.', example='My context library', position='Body'),
  status?: string(name='status', description='The running status. For the memory type, valid values are Active (running) and Paused (data source consumption and extraction paused). For the experience type, it indicates the mining status of the experience library. The specific valid values and combination constraints are defined by the server.', example='Active', position='Body'),
  clientToken?: string(name='clientToken', description='The idempotency token. It is a unique string generated by the client to ensure the idempotence of the update operation.', example='a1b2c3d4-1234-5678-90ab-cdef12345678', position='Query'),
}

