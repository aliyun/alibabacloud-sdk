  }(name='meta', description='The query metadata.'),
  requestId?: string(name='requestId', description='The request ID. You can use this ID to locate the request when you troubleshoot issues.', example='9ACFB10A-1B2C-3D4E-5F6G-7H8I9J0K1L2M'),
