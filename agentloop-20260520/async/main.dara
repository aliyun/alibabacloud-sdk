model CreateOptimizeRunRequest {
  agentSpace?: string(name='agentSpace', description='The AgentSpace name.', example='my-agent-space', position='Path'),
  optimizeTaskName?: string(name='optimizeTaskName', description='The name of the optimization task.', example='experience-mining', position='Path'),
  input: any(name='input', description='The JSON input defined by the task type, preserving the original object or array structure. ExperienceMining accepts a start/end/processTimeMaxNS object. SkillOptimize accepts an inline input array, a skills/window object for SLS, or a skills/records object for ATIF or xTrace. The server validates the input based on the task type and configuration. Memory extraction continues to use the original ContextStore API.

