/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('agentloop', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AnalysisTask {
  completedAt?: long(name='completedAt', description='The task completion time as a UNIX timestamp in milliseconds.', example='1789747260000'),
  createdAt?: long(name='createdAt', description='The task creation time as a UNIX timestamp in milliseconds.', example='1789747200000'),
  errorCode?: string(name='errorCode', description='The error code for the task failure.', example='NO_VALID_ATTRIBUTION_LABEL'),
  errorMessage?: string(name='errorMessage', description='The error message for the task failure.', example='No valid attribution label was found'),
  report?: map[string]any(name='report', description='The generated analysis report. This field is typically not returned by list operations.'),
  selectedCount?: int32(name='selectedCount', description='The number of evaluation details selected by the user.', example='20'),
  status?: string(name='status', description='The task status. Valid values: PENDING, RUNNING, SUCCEEDED, PARTIAL_SUCCEEDED, and FAILED.', example='SUCCEEDED'),
  taskId?: string(name='taskId', description='The analysis task ID.', example='analysis-task-8b36f2e2b1f94f9c91ce7a4b0f6d9c25'),
  taskName?: string(name='taskName', description='The analysis task name.', example='Low-score sample attribution analysis'),
  taskType?: string(name='taskType', description='The analysis task type.', example='ATTRIBUTION_SUMMARY'),
}

model AuditTaskState {
  enabled?: boolean(name='enabled', description='The current expected sharing switch for the task.'),
  runtimeError?: {
    code?: string(name='code', description='The error code, such as task_status_query_failed.', example='task_status_query_failed'),
    message?: string(name='message', description='The error description.', example='error'),
    requestId?: string(name='requestId', description='The ID of the status query request.', example='GUID'),
  }(name='runtimeError', description='The runtime error, which is returned only when runtimeStatus is error.'),
  runtimeStatus?: string(name='runtimeStatus', description='The runtime status, which appears only when includeRuntimeStatus=true is requested. Valid values: pending, starting, stopping, running, stopped, missing, drifted, and error. The list and get operations do not return deleting.', example='running'),
  runtimeStatusCheckedAt?: string(name='runtimeStatusCheckedAt', description='The time when the remote status is checked. This field appears together with runtimeStatus.', example='1'),
  task?: map[string]any(name='task', description='The task details in JSON format.'),
  taskId?: string(name='taskId', description='The stable ID of the task, which must be equal to task.taskId.', example='custom_host_intrusion_audit'),
  version?: long(name='version', description='The current execution configuration version of the task. The minimum value is 1. Starting or stopping the task does not increment this version.', example='7'),
}

model BackfillStrategy {
  enabled?: boolean(name='enabled', description='Specifies whether the backfill policy is enabled. If this parameter is not specified or is set to true, the policy is enabled. If this parameter is set to false, the policy is disabled but the configuration is retained.', example='true'),
  endTime?: long(name='endTime', description='The end of the backfill time range, in UNIX millisecond timestamp. Provide a complete time range when you need to manually start a backfill.', example='1782902400000'),
  startTime?: long(name='startTime', description='The start of the backfill time range, in UNIX millisecond timestamp. Provide a complete time range when you need to manually start a backfill.', example='1782816000000'),
}

model BatchGroup {
  batchId?: string(name='batchId'),
  records?: [
    ExperimentRecord
  ](name='records'),
}

model ConnectorProperties {
  channelType?: string(name='channelType', description='The channel type. Valid values: custom and apig. This parameter is optional for model_service. Default value: custom.', example='custom'),
  dryRunRequestBody?: string(name='dryRunRequestBody', description='Specifies the sample request body provided by the user to verify endpoint connectivity. This parameter is required when dryRun is set to All and type is set to agent_app. The request body is not persisted.', example='{"input":"Hello"}'),
  maxRetries?: string(name='maxRetries', description='The number of retry attempts after a failed service invocation when you invoke the synthetic monitoring registration service. Valid values: 0 to 10. Default value: 3.', example='3'),
  modelList?: string(name='modelList', description='The list of supported models in comma-separated format. This parameter is required for model_service.', example='qwen-max'),
  network?: string(name='network', description='The network type. Valid values: internet and aliyun-vpc.', example='internet'),
  protocol?: string(name='protocol', description='The protocol type. Valid values: openai, openai-compatible, and anthropic. This parameter is required for model_service.', example='openai-compatible'),
  qpsLimit?: string(name='qpsLimit', description='The queries per second (QPS) limit for the dial test registration service. A value of 0 indicates no throttling. Otherwise, valid values are 0.1 to 1000. Default value: 20 for agent_app and 100 for model_service.', example='20'),
  region?: string(name='region', description='The region. This parameter is required when the network type is aliyun-vpc.', example='cn-hangzhou'),
  responseBodyPath?: string(name='responseBodyPath', description='The JSONPath extraction path for the response body. This parameter is optional for agent_app.', example='$.choices[0].message.content'),
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group. This parameter is optional for agent_app.'),
  timeoutMs?: string(name='timeoutMs', description='The timeout period for a single call in milliseconds. Valid values: 1000 to 1800000. Default value: 300000.', example='30000'),
  vSwitchId?: string(name='vSwitchId', description='The ID of the vSwitch. This parameter is optional for agent_app.'),
  vpcId?: string(name='vpcId', description='The ID of the virtual private cloud (VPC). This parameter is optional for agent_app.'),
}

model ContinuousStrategy {
  dataDelayMinutes?: int32(name='dataDelayMinutes', description='The data arrival delay in minutes. After a window ends, the system waits for this duration before creating a run to allow data to arrive completely. Default value: 0.', example='5'),
  enabled?: boolean(name='enabled', description='Specifies whether to enable continuous evaluation. If this parameter is not specified or is set to true, continuous evaluation is enabled. If this parameter is set to false, continuous evaluation is disabled but the configuration is retained.', example='true'),
  intervalUnit?: string(name='intervalUnit', description='The unit of the continuous evaluation window interval. This field is required for the current polling implementation.', example='HOUR'),
  intervalValue?: int32(name='intervalValue', description='The size of the continuous evaluation window interval. This parameter is used together with intervalUnit. The value must be greater than 0.', example='1'),
}

model DataFilter {
  maxRecords?: int32(name='maxRecords', description='The maximum number of evaluation records. This parameter takes effect for both backfill and continuous runs. If this parameter is not specified, the backend does not apply an additional default value.', example='10'),
  provided?: map[string]any(name='provided', description='The single-shot input content for temporary evaluation, which is primarily used for one-shot tasks. Values are saved as strings. Object or array values are serialized into JSON strings.', example='{"input":"User queries order status","output":"Order status queried"}'),
  query?: string(name='query', description='The data query filter conditions that take effect together with the evaluator-level filters.query. For trace scenarios, you can specify filter expressions such as service name, environment, and tags.', example='serviceName=\\\\"checkout-service\\\\"'),
  samplingRate?: int32(name='samplingRate', description='The sampling rate percentage. Valid values: 0 to 100. A value of 0 or an unspecified value indicates no sampling. A value of 100 indicates full sampling. If the value is less than 100, random sampling is performed first, and then the maxRecords limit is applied.', example='100'),
  serviceNames?: [ string ](name='serviceNames', description='The list of service names used to restrict the services involved in data filtering.', example='["checkout-service"]'),
}

model Evaluator {
  config?: map[string]any(name='config', description='The runtime configuration of the evaluator. For inline LLM evaluators, this must include configurations such as prompt. When referencing an existing evaluator, this parameter is typically not required and should only be specified when runtime parameters such as version need to be set.', example='{"version":"1.0.0"}'),
  evaluatorRef?: string(name='evaluatorRef', description='The reference name of a registered evaluator. When specified, the evaluator definition is loaded by this reference with higher priority. Both built-in evaluators and custom evaluators are supported.', example='Builtin.agent_task_completion'),
  filters?: map[string]any(name='filters', description='The evaluator-level data filter conditions. These take effect together with the task-level dataFilter.query.', example='{"query":"serviceName=\\\\"checkout-service\\\\""}'),
  name?: string(name='name', description='The evaluator name. Required for inline evaluators when evaluatorRef is not specified. The evaluatorRef or name must be unique within the same task.', example='agent_task_completion'),
  resultName?: string(name='resultName', description='The field name for the evaluation result. Required for inline evaluators. When referencing an existing evaluator, the metricName defined in the evaluator definition is used if this parameter is not specified.', example='agent_task_completion'),
  resultType?: string(name='resultType', description='The evaluation result type. Required for inline evaluators. When referencing an existing evaluator, defaults to score if not specified.', example='score'),
  type?: string(name='type', description='The evaluator type. Defaults to LLM if not specified. Inline CODE evaluators are not currently supported. For the CODE type, reference a previously created evaluator by using evaluatorRef.', example='AGENT'),
  variableExtractorMapping?: map[string]EvaluatorVariableExtractorMappingValue(name='variableExtractorMapping', description='The variable extraction rule mapping that maps evaluator variables to a portion of the content within an evaluation data field. This is applicable when the variable value is not the entire field but a subset of the field content. This parameter shares the same variable name key space as variableMapping. Each variable can use only one of the two. Duplicate configurations cause an error. When referencing an existing evaluator, the variable names must exist in the evaluator definition. Call ListTraceFieldExtractionsPreview to perform a trial run for validation before saving.'),
  variableMapping?: map[string]string(name='variableMapping', description='The variable mapping that maps evaluator variables to evaluation data fields. Required for LLM/AGENT inline evaluators. When referencing an existing evaluator, the variable names must exist in the evaluator definition.', example='{"input":"trace.input","output":"trace.output","agent_trajectory":"trace.agent_trajectory"}'),
}

model ExperimentConfig {
  endpointConnectorId?: string(name='endpointConnectorId', description='The endpoint connector ID, which is required in user or agent mode.'),
  label?: string(name='label', description='The experiment label (A, B, C, D, or E).', example='A'),
  modelName?: string(name='modelName', description='The model name, which can be set to agent for agent scenarios.', example='qwen-max'),
  modelParameters?: ModelParameters(name='modelParameters', description='The model parameters.'),
  modelProvider?: string(name='modelProvider', description='The model provider. Valid values: dashscope (default), user, and agent.', example='dashscope'),
  name?: string(name='name', description='The experiment name.', example='baseline'),
  promptTemplate?: [
    PromptTemplateItem
  ](name='promptTemplate', description='The prompt message template, which supports {{variable name}} placeholders.', example='[{"role":"user","content":"Please answer: {{question}}"}]'),
  requestBodyTemplate?: string(name='requestBodyTemplate', description='The agent request body template, which is required in agent mode and supports {{variable name}} placeholders.', example='{"input":"{{question}}"}'),
  requestHeaderTemplate?: string(name='requestHeaderTemplate', description='The agent request header template, which is optional in agent mode and supports {{variable name}} placeholders.', example='{"Content-Type: application/json" }'),
  requestMethod?: string(name='requestMethod', description='The agent request method. Valid values: POST (default) and GET.', example='POST'),
}

model ExperimentPlanData {
  createdAt?: long(name='createdAt', description='The creation time, in milliseconds.', example='1767225600000'),
  datasetId?: string(name='datasetId', description='The ID of the associated dataset.', example='dataset-123456'),
  description?: string(name='description', description='The description.', example='Customer service Q&A offline evaluation plan'),
  experimentCount?: int32(name='experimentCount', description='The number of experiment executions under this plan.', example='3'),
  experimentType?: string(name='experimentType', description='The experiment type: offline (offline experiment) or online (online experiment).', example='offline'),
  pipelineName?: string(name='pipelineName', description='The name of the associated data processing pipeline. This field is empty if no pipeline is associated. After a pipeline is associated, when an experiment under this plan completes and writes experiment results to the Logstore, the system filters by the traceId of the current experiment trace and calls PreviewPipeline to write the results processed by the pipeline.', example='trace-process-pipeline'),
  planId?: string(name='planId', description='The experiment plan ID.', example='exp-plan-e95bff54685a4ae29ff3a834c1008a71'),
  planName?: string(name='planName', description='The experiment plan name.', example='customer-service-eval'),
  querySql?: string(name='querySql', description='The custom query SQL clause in dataset-partial mode.', example='level > 2'),
  status?: string(name='status', description='The status: pending, running, or stopped.', example='pending'),
  updatedAt?: long(name='updatedAt', description='The update time, in milliseconds.', example='1767229200000'),
}

model ExperimentRecord {
  completedAt?: long(name='completedAt', description='The completion timestamp in milliseconds.', example='1767229200000'),
  completedTasks?: int32(name='completedTasks', description='The number of completed tasks.', example='5'),
  dataSourceType?: string(name='dataSourceType', description='The data source type. Valid values: simple, dataset-full, and dataset-partial.', example='dataset-full'),
  datasetId?: string(name='datasetId', description='The dataset ID.', example='dataset-123456'),
  datasetProject?: string(name='datasetProject', description='The Simple Log Service (SLS) project where the dataset is located.', example='agentspace-project'),
  errorMessage?: string(name='errorMessage', description='The error message.', example='Model invocation timeout'),
  evaluationTaskId?: string(name='evaluationTaskId', description='The ID of the associated evaluation task.', example='eval-task-6bec93bfa03740dd86ce2bf1496e65fb'),
  evaluators?: [
    Evaluator
  ](name='evaluators', description='The list of evaluators.', example='[{"name":"Builtin.agent_correctness"}]'),
  executedAt?: long(name='executedAt', description='The execution timestamp in milliseconds.', example='1767225600000'),
  experimentConfig?: [
    ExperimentConfig
  ](name='experimentConfig', description='The list of experiment configurations.', example='[{"label":"A","name":"baseline","modelName":"qwen-max"}]'),
  experimentPlanId?: string(name='experimentPlanId', description='The ID of the associated experiment plan.', example='exp-plan-0242d983f5d340fd8479cf2c19eb279e'),
  failedTasks?: int32(name='failedTasks', description='The number of failed tasks.', example='1'),
  input?: map[string]any(name='input', description='The single-line input in SIMPLE mode.', example='{"test":"test","test2":1}'),
  modelNames?: [ string ](name='modelNames', description='The list of model names used.', example='["qwen-max"]'),
  planName?: string(name='planName', description='The name of the associated experiment plan.', example='customer-service-eval'),
  progress?: float(name='progress', description='The execution progress, ranging from 0 to 1.', example='0.5'),
  querySql?: string(name='querySql', description='The custom query SQL clause in dataset-partial mode.', example='level > 2'),
  recordId?: string(name='recordId', description='The experiment record ID.', example='exp-run-f6d419b0ed3d43a7b585948a55efc07b'),
  recordName?: string(name='recordName', description='The experiment record name.', example='baseline-run'),
  selectedItemIds?: [ string ](name='selectedItemIds', description='The list of selected data item IDs in dataset-partial mode.', example='["item-123456"]'),
  status?: string(name='status', description='The status. Valid values: pending, running, completed, and failed.', example='running'),
  totalTasks?: int32(name='totalTasks', description='The total number of tasks.', example='10'),
}

model IndexJsonKey {
  chn?: boolean(name='chn', description='Specifies whether Chinese characters are included. This parameter is required only when the **type** parameter is set to **text**. Valid values:
  - true: Chinese characters are included.
  - false: Chinese characters are not included.', example='false'),
  type?: string(name='type', description='The type.', example='text'),
}

model IndexKey {
  chn?: boolean(name='chn', description='Specifies whether the field contains Chinese characters. This parameter is required only when the **type** parameter is set to **text**. Valid values:
- true: The field contains Chinese characters.
- false: The field does not contain Chinese characters.', example='true'),
  description?: string(name='description', description='The field description.', example='test'),
  embedding?: string(name='embedding', description='The embedding type of the field.', example='agentloop-embedding-v4'),
  jsonKeys?: map[string]IndexJsonKey(name='jsonKeys', description='The JSON subfields. This property takes effect only when the type is set to json.', example='{"content":{"type":"text","chn":true}}'),
  type?: string(name='type', description='The field type.', example='text'),
}

model ModelParameters {
  frequencyPenalty?: float(name='frequencyPenalty', description='The frequency penalty. Positive values reduce repetition. Valid values: -2.0 to 2.0.', example='0.2'),
  maxTokens?: long(name='maxTokens', description='The maximum number of output tokens.', example='1024'),
  presencePenalty?: float(name='presencePenalty', description='The presence penalty. Positive values encourage new topics. Valid values: -2.0 to 2.0.', example='0.1'),
  stopSequences?: [ string ](name='stopSequences', description='The stop sequences. Generation stops immediately when any of these sequences is encountered.', example='["END"]'),
  temperature?: float(name='temperature', description='The temperature parameter that controls the randomness of the output. Valid values: 0 to 2.', example='0.7'),
  topK?: int32(name='topK', description='The top-k sampling parameter. Valid values: 1 to 100.', example='50'),
  topP?: float(name='topP', description='The top-p sampling parameter. Valid values: 0 to 1.', example='0.9'),
}

model OfflineExperimentConfig {
  desc?: string(name='desc', description='The experiment description.', example='Baseline experiment'),
  label?: string(name='label', description='The experiment label.', example='A'),
  name?: string(name='name', description='The experiment name.', example='baseline'),
}

model PromptTemplateItem {
  content?: string(name='content', description='The content, which supports {{variable name}} placeholders.', example='Please answer: {{question}}'),
  role?: string(name='role', description='The role: system/user/assistant.', example='user'),
}

model RunStrategies {
  backfill?: BackfillStrategy(name='backfill', description='The historical batch backfill policy. Backfill is enabled when the object exists and enabled is not explicitly set to false.', example='{"enabled":true,"startTime":1782816000000,"endTime":1782902400000,"immediate":false}'),
  continuous?: ContinuousStrategy(name='continuous', description='The continuous evaluation policy. Continuous evaluation is enabled when the object exists and enabled is not explicitly set to false.', example='{"enabled":true,"intervalUnit":"HOUR","intervalValue":1,"dataDelayMinutes":5}'),
}

model EvaluatorVariableExtractorMappingValue = {
  originField?: string(name='originField', description='The evaluation data field from which content is extracted. The extraction expression is applied to the content of this field. Required when saving with the evaluation task. For the trial run API, this parameter can be omitted and the backend derives it from the expression. Multiple variables can share the same source field.', example='trace.output'),
  type?: string(name='type', description='The extraction method. jsonpath extracts values from the JSON content of the field by using JSONPath. regex performs regular expression matching on the full text of the field. When capturing groups are present, the first capturing group is returned. When no capturing group is present, the entire match is returned.', example='jsonpath'),
  expression?: string(name='expression', description='The extraction expression. Its meaning is determined by type. When type is jsonpath, specify a JSONPath expression. You can use either a relative path relative to originField (such as $.order.expected) or an absolute path from the root (such as $trace.output.order.expected). When type is regex, specify a regular expression. Note that backslashes must be escaped in JSON. The expression syntax is validated upon saving. For regular expressions, RE2 compatibility is additionally validated. Patterns such as lookahead assertions, lookbehind assertions, backreferences, named groups, atomic groups, and possessive quantifiers are rejected.', example='$.order.expected'),
}

model MetaSchemaValue = {
  type?: string(name='type', description='The dataset field types. Valid values: text, long, double, and json.', example='text'),
}

model AddDatasetDataRequest {
  dataArray?: [ map[string]any ](name='dataArray', description='The array of data rows to append. The array cannot be empty. The server reads the data in streaming mode. The maximum request body size is 100 MB by default. All rows in a single request are committed in an all-or-nothing transaction.'),
  clientToken?: string(name='clientToken', description='The idempotency token. This is a unique string generated by the client to ensure the idempotence of the create operation.', example='a1b2c3d4-1234-5678-90ab-cdef12345678'),
}

model AddDatasetDataResponseBody = {
  affectedRows?: int32(name='affectedRows', description='The number of log rows scanned or processed.', example='100'),
  requestId?: string(name='requestId', description='Id of the request', example='D0173835-9E0F-508F-8BFA-9F556E59C302'),
}

model AddDatasetDataResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDatasetDataResponseBody(name='body'),
}

/**
 * @summary Appends structured data rows to a specified dataset without requiring the client to construct SQL statements.
 *
 * @param request AddDatasetDataRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddDatasetDataResponse
 */
@context("addDatasetDataWithContext")
async function addDatasetDataWithOptions(agentSpace: string, datasetName: string, request: AddDatasetDataRequest, headers: map[string]string, runtime: $RuntimeOptions): AddDatasetDataResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.clientToken)) {
    query['clientToken'] = request.clientToken;
  }

  var body : map[string]any = {};
  if (!$isNull(request.dataArray)) {
    body['dataArray'] = request.dataArray;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddDatasetData',
    version = '2026-05-20',
    protocol = 'HTTPS',
    pathname = `/agentspace/${$URL.percentEncode(agentSpace)}/dataset/${$URL.percentEncode(datasetName)}/rows`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Appends structured data rows to a specified dataset without requiring the client to construct SQL statements.
 *
 * @param request AddDatasetDataRequest
 * @return AddDatasetDataResponse
 */
async function addDatasetData(agentSpace: string, datasetName: string, request: AddDatasetDataRequest): AddDatasetDataResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return addDatasetDataWithOptions(agentSpace, datasetName, request, headers, runtime);
}

