        }(name='dataset', description='The default destination dataset.'),
        type?: string(name='type', description='The default destination type. Currently, only dataset is supported.', example='dataset'),
      }(name='defaultSink', description='The default sink used when no conditional route is matched.'),
      matchMode?: string(name='matchMode', description='The route matching mode. Currently, only all is supported.', example='all'),
      routes?: [ 
        {
          expression?: string(name='expression', description='The route expression in Search Processing Language (SPL). Only where, project, and extend are supported.', example='* | where intent = \\\\"refund\\\\"'),
          id?: string(name='id', description='The route ID.', example='refund'),
          sink?: {
            dataset?: {
              agentSpace?: string(name='agentSpace', description='The name of the AgentSpace to which the destination dataset belongs.', example='my-agent-space'),
              dataset?: string(name='dataset', description='The name of the destination dataset.', example='refund-result'),
            }(name='dataset', description='The destination dataset for the route.'),
            type?: string(name='type', description='The route destination type. Currently, only dataset is supported.', example='dataset'),
          }(name='sink', description='The sink for the route.'),
        }
      ](name='routes', description='The list of conditional routes.'),
    }(name='condition', description='The conditional routing configuration. This parameter is used only when sink.type is set to condition.'),
    dataset?: {
      agentSpace?: string(name='agentSpace', description='The name of the AgentSpace to which the destination dataset belongs.', example='my-agent-space'),
      dataset?: string(name='dataset', description='The name of the destination dataset.', example='my-dataset'),
    }(name='dataset', description='The destination dataset configuration for the dataset sink. This parameter is used only when sink.type is set to dataset.'),
    type?: string(name='type', description='The destination type. Valid values: dataset and condition.', example='condition'),
  }(name='sink', description='The pipeline sink (data write destination). Passing this parameter overwrites the entire configuration.'),
  source?: {
    dataset?: {
      dataset?: string(name='dataset', description='The name of the source dataset.', example='my-dataset'),
      filter?: string(name='filter', description='The data filter condition for the dataset.', example='status = \\\\"pending\\\\"'),
    }(name='dataset', description='The dataset datasource config in the current AgentSpace.', example='{"dataset":"my-dataset","filter":"status = \\\\"pending\\\\""}'),
    inputFields?: [ 
