        type?: string(name='type', description='The type of the node.', example='transform'),
      }
    ](name='nodes', description='The list of nodes.', example='[{"id":"select-fields","type":"project","parameters":{}}]'),
  }(name='pipeline', description='The pipeline configuration, which defines node orchestration. If this parameter is specified, the existing configuration is completely overwritten.'),
  sink?: {
