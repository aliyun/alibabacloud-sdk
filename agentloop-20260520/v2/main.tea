model CreateAgentSpaceRequest {
  agentSpace?: string(name='agentSpace', description='The AgentSpace name.

This parameter is required.', example='test-agent-space'),
  cmsWorkspace?: string(name='cmsWorkspace', description='The CMS workspace.', example='test-cms-workspace'),
  description?: string(name='description', description='The description.', example='test'),
  mseNamespaceId?: string(name='mseNamespaceId', description='The MSE namespace ID.', example='test-mse-namespace-Id'),
  trajectoryStoreEnabled?: boolean(name='trajectoryStoreEnabled', description='Specifies whether to enable trajectory cleaning.'),
  clientToken?: string(name='clientToken', description='The idempotency token. A unique string generated by the client to ensure the idempotence of the create operation.', example='a1b2c3d4-1234-5678-90ab-cdef12345678'),
}

model CreateAgentSpaceResponseBody = {
  requestId?: string(name='requestId', description='The request ID.', example='AA689779-61AB-5077-BD91-9F7EA1205D68'),
}

model CreateAgentSpaceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateAgentSpaceResponseBody(name='body'),
}

/**
 * @summary Creates an AgentSpace.
 *
 * @param request CreateAgentSpaceRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateAgentSpaceResponse
 */
@context("createAgentSpaceWithContext")
async function createAgentSpaceWithOptions(request: CreateAgentSpaceRequest, headers: map[string]string, runtime: $RuntimeOptions): CreateAgentSpaceResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.clientToken)) {
    query['clientToken'] = request.clientToken;
  }

  var body : map[string]any = {};
  if (!$isNull(request.agentSpace)) {
    body['agentSpace'] = request.agentSpace;
  }
  if (!$isNull(request.cmsWorkspace)) {
    body['cmsWorkspace'] = request.cmsWorkspace;
  }
  if (!$isNull(request.description)) {
    body['description'] = request.description;
  }
  if (!$isNull(request.mseNamespaceId)) {
    body['mseNamespaceId'] = request.mseNamespaceId;
  }
  if (!$isNull(request.trajectoryStoreEnabled)) {
    body['trajectoryStoreEnabled'] = request.trajectoryStoreEnabled;
  }

