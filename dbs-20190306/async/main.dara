extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Dbs';
  @version = '2019-03-06';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-qingdao' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-beijing' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-chengdu' = 'dbs-api.cn-chengdu.aliyuncs.com',
    'cn-zhangjiakou' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-huhehaote' = 'dbs-api.cn-huhehaote.aliyuncs.com',
    'cn-hangzhou' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shanghai' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shenzhen' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-hongkong' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'ap-southeast-1' = 'dbs-api.ap-southeast-1.aliyuncs.com',
    'ap-southeast-2' = 'dbs-api.ap-southeast-2.aliyuncs.com',
    'ap-southeast-3' = 'dbs-api.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'dbs-api.ap-southeast-5.aliyuncs.com',
    'ap-northeast-1' = 'dbs-api.ap-northeast-1.aliyuncs.com',
    'us-west-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'us-east-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'eu-central-1' = 'dbs-api.eu-central-1.aliyuncs.com',
    'cn-hangzhou-finance' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shanghai-finance-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'ap-south-1' = 'dbs-api.ap-south-1.aliyuncs.com',
    'eu-west-1' = 'dbs-api.eu-west-1.aliyuncs.com',
    'me-east-1' = 'dbs-api.me-east-1.aliyuncs.com',
    'cn-wulanchabu' = 'dbs-api.cn-wulanchabu.aliyuncs.com',
    'cn-guangzhou' = 'dbs-api.cn-guangzhou.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model ConfigureBackupPlanRequest {
  regionId?: string(name='RegionId', position='Host'),
  autoStartBackup?: boolean(name='AutoStartBackup', description='Specifies whether to enable automatic backup. Valid values:

- **true**: enables automatic backup
- **false**: disables automatic backup', example='false', position='Query'),
  backupGatewayId?: long(name='BackupGatewayId', description='The ID of the backup gateway. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpointInstanceType** is set to **agent**.', example='23313123312', position='Query'),
  backupLogIntervalSeconds?: int32(name='BackupLogIntervalSeconds', description='The interval for incremental backup, in seconds.
> This parameter is supported only for physical backup.', example='1000', position='Query'),
  backupObjects?: string(name='BackupObjects', description='The objects to be backed up. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.', example='[     {         "DBName":"DatabaseToBackUp",         "SchemaName":"SchemaToBackUp",         "TableIncludes":[{             "TableName":"TableToBackUp"         }],         "TableExcludes":[{             "TableName":"TableToExclude"         }]     } ]', position='Query'),
  backupPeriod?: string(name='BackupPeriod', description='The full backup cycle. Valid values:
- **Monday**: Monday
- **Tuesday**: Tuesday
- **Wednesday**: Wednesday
- **Thursday**: Thursday
- **Friday**: Friday
- **Saturday**: Saturday
- **Sunday**: Sunday', example='Monday', position='Query'),
  backupPlanId: string(name='BackupPlanId', description='The ID of the backup plan. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

This parameter is required.', example='dbstooi0*******', position='Query'),
  backupPlanName: string(name='BackupPlanName', description='The custom name of the backup plan. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

This parameter is required.', example='dbstooi0*******', position='Query'),
  backupRateLimit?: long(name='BackupRateLimit', description='The network bandwidth throttling. Unit: KB/s. Maximum value: 10 GB.
> This parameter takes effect only for MySQL physical backup.', example='262144', position='Query'),
  backupRetentionPeriod?: int32(name='BackupRetentionPeriod', description='The retention period of backup data. Valid values: 0 to 1825. Default value: 730. Unit: days.', example='730', position='Query'),
  backupSpeedLimit?: long(name='BackupSpeedLimit', description='The disk I/O limit. Unit: KB/s.
> This parameter takes effect only for MySQL physical backup.', example='262144', position='Query'),
  backupStartTime?: string(name='BackupStartTime', description='The start time of the full backup. The time is in the <i>HH:mm</i>Z format and displayed in UTC. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.', example='14:22', position='Query'),
  backupStorageEncryptMethod?: string(name='BackupStorageEncryptMethod', description='The encryption method for backup storage.', example='encrypted', position='Query'),
  backupStorageType?: string(name='BackupStorageType', description='The built-in storage type. Valid values:
- Empty string (default): Backup data is stored in your OSS bucket.
- system: Backup data is stored in the built-in OSS bucket of DBS.', example='None', position='Query'),
  backupStrategyType?: string(name='BackupStrategyType', description='The full backup epoch. Valid values:
- **simple**: periodic backup, which is used together with BackupPeriod and BackupStartTime
- **manual**: manual backup

> Default value: **simple**.', example='simple', position='Query'),
  clientToken?: string(name='ClientToken', description='The client token that is used to ensure the idempotence of the request and prevent duplicate submissions. You can use the client to generate the value, and you must ensure that the value is unique among different requests. The value can be up to 64 ASCII characters in length and cannot contain non-ASCII characters.', example='ETnLKlblzczshOTUbOCzxxxxxxx', position='Query'),
  crossAliyunId?: string(name='CrossAliyunId', description='The UID of the Alibaba Cloud account for cross-account backup. You can call the [DescribeRestoreTaskList](https://help.aliyun.com/document_detail/2869838.html) operation to query the value of this parameter.', example='2xxx7778xxxxxxxxxx', position='Query'),
  crossRoleName?: string(name='CrossRoleName', description='The name of the RAM role for cross-account backup. You can call the [DescribeRestoreTaskList](https://help.aliyun.com/document_detail/2869838.html) operation to query the value of this parameter.', example='test123', position='Query'),
  duplicationArchivePeriod?: int32(name='DuplicationArchivePeriod', description='The period after which backup data is transitioned to Archive storage. Default value: 365. Unit: days.', example='365', position='Query'),
  duplicationInfrequentAccessPeriod?: int32(name='DuplicationInfrequentAccessPeriod', description='The period after which backup data is transitioned to Infrequent Access (IA) storage. Default value: 180. Unit: days.', example='180', position='Query'),
  enableBackupLog?: boolean(name='EnableBackupLog', description='Specifies whether to enable incremental log backup. Valid values:
- **true**: enables incremental log backup
- **false**: disables incremental log backup', example='true', position='Query'),
  enableMysqlPhysicalBackupBinlog?: string(name='EnableMysqlPhysicalBackupBinlog', description='Specifies whether to enable log backup for MySQL physical backup.', example='true', position='Query'),
  enableSourceEndpointSsl?: string(name='EnableSourceEndpointSsl', description='Specifies whether to enable an SSL-encrypted connection to the source database instance.', example='true', position='Query'),
  OSSBucketName?: string(name='OSSBucketName', description='The name of the OSS bucket.

> By default, the system automatically generates a new name.', example='TestOssBucket', position='Query'),
  ownerId?: string(name='OwnerId', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The ID of the resource group.', example='rg-aekzecovzti****', position='Query'),
  sourceEndpointDatabaseName?: string(name='SourceEndpointDatabaseName', description='The name of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when the database engine is **PostgreSQL** or **MongoDB**.', example='testRDS', position='Query'),
  sourceEndpointIP?: string(name='SourceEndpointIP', description='The database connection address. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpointInstanceType** is set to **express**, **agent**, or **other**.', example='rm-uf6wjk5*******.mysql.rds.aliyuncs.com', position='Query'),
  sourceEndpointInstanceID?: string(name='SourceEndpointInstanceID', description='The database instance ID. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpoint**.**InstanceType** is set to **RDS**, **ECS**, **DDS**, or **Express**.', example='rm-uf6wjk5*********', position='Query'),
  sourceEndpointInstanceType: string(name='SourceEndpointInstanceType', description='The location of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter. Valid values:

- **RDS**
- **ECS**
- **Express**: databases connected over Express Connect circuits, VPN gateways, or Smart Access Gateway (SAG)
- **Agent**: databases connected over backup gateways
- **DDS**: ApsaraDB for MongoDB
- **Other**: databases connected by using IP addresses and port numbers

This parameter is required.', example='RDS', position='Query'),
  sourceEndpointOracleHome?: string(name='SourceEndpointOracleHome', description='Oracle Home', example='/home/test', position='Query'),
  sourceEndpointOracleSID?: string(name='SourceEndpointOracleSID', description='The Oracle system identifier (SID).

> This parameter is required when the database engine is Oracle.', example='test', position='Query'),
  sourceEndpointPassword?: string(name='SourceEndpointPassword', description='The password of the database account.

> This parameter is not required when the database engine is **Redis**, or when the database is connected over a backup gateway (**agent**) and the database engine is **SQL Server**. This parameter is required in other scenarios.', example='testPassword', position='Query'),
  sourceEndpointPort?: int32(name='SourceEndpointPort', description='The port number of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpoint**.**InstanceType** is set to **express**, **agent**, **other**, or **ECS**.', example='3306', position='Query'),
  sourceEndpointRegion?: string(name='SourceEndpointRegion', description='The region of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpointInstanceType** is set to RDS, ECS, DDS, Express, or Agent.', example='cn-hangzhou', position='Query'),
  sourceEndpointUserName?: string(name='SourceEndpointUserName', description='The username of the database account.

> This parameter is not required when the database engine is **Redis**, or when the database is connected over a backup gateway (**agent**) and the database engine is **SQL Server**. This parameter is required in other scenarios.', example='testRDS', position='Query'),
  sslCaPem?: string(name='SslCaPem', description='The PEM certificate for the SSL-encrypted connection to the source database.', example='-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----', position='Query'),
}

model ConfigureBackupPlanResponseBody = {
  backupPlanId?: string(name='BackupPlanId', description='The ID of the backup plan.', example='dbstooi01ex****'),
