import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'Dbs';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-qingdao' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-beijing' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-chengdu' = 'dbs-api.cn-chengdu.aliyuncs.com',
    'cn-zhangjiakou' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-huhehaote' = 'dbs-api.cn-huhehaote.aliyuncs.com',
    'cn-hangzhou' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shanghai' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shenzhen' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-hongkong' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'ap-southeast-1' = 'dbs-api.ap-southeast-1.aliyuncs.com',
    'ap-southeast-2' = 'dbs-api.ap-southeast-2.aliyuncs.com',
    'ap-southeast-3' = 'dbs-api.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'dbs-api.ap-southeast-5.aliyuncs.com',
    'ap-northeast-1' = 'dbs-api.ap-northeast-1.aliyuncs.com',
    'us-west-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'us-east-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'eu-central-1' = 'dbs-api.eu-central-1.aliyuncs.com',
    'cn-hangzhou-finance' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shanghai-finance-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'dbs-api.cn-hangzhou.aliyuncs.com',
    'ap-south-1' = 'dbs-api.ap-south-1.aliyuncs.com',
    'eu-west-1' = 'dbs-api.eu-west-1.aliyuncs.com',
    'me-east-1' = 'dbs-api.me-east-1.aliyuncs.com',
    'cn-wulanchabu' = 'dbs-api.cn-wulanchabu.aliyuncs.com',
    'cn-guangzhou' = 'dbs-api.cn-guangzhou.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('dbs', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ConfigureBackupPlanRequest {
  autoStartBackup?: boolean(name='AutoStartBackup', description='Specifies whether to enable automatic backup. Valid values:

- **true**: enables automatic backup
- **false**: disables automatic backup', example='false'),
  backupGatewayId?: long(name='BackupGatewayId', description='The ID of the backup gateway. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpointInstanceType** is set to **agent**.', example='23313123312'),
  backupLogIntervalSeconds?: int32(name='BackupLogIntervalSeconds', description='The interval for incremental backup, in seconds.
> This parameter is supported only for physical backup.', example='1000'),
  backupObjects?: string(name='BackupObjects', description='The objects to be backed up. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.', example='[     {         "DBName":"DatabaseToBackUp",         "SchemaName":"SchemaToBackUp",         "TableIncludes":[{             "TableName":"TableToBackUp"         }],         "TableExcludes":[{             "TableName":"TableToExclude"         }]     } ]'),
  backupPeriod?: string(name='BackupPeriod', description='The full backup cycle. Valid values:
- **Monday**: Monday
- **Tuesday**: Tuesday
- **Wednesday**: Wednesday
- **Thursday**: Thursday
- **Friday**: Friday
- **Saturday**: Saturday
- **Sunday**: Sunday', example='Monday'),
  backupPlanId?: string(name='BackupPlanId', description='The ID of the backup plan. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

This parameter is required.', example='dbstooi0*******'),
  backupPlanName?: string(name='BackupPlanName', description='The custom name of the backup plan. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

This parameter is required.', example='dbstooi0*******'),
  backupRateLimit?: long(name='BackupRateLimit', description='The network bandwidth throttling. Unit: KB/s. Maximum value: 10 GB.
> This parameter takes effect only for MySQL physical backup.', example='262144'),
  backupRetentionPeriod?: int32(name='BackupRetentionPeriod', description='The retention period of backup data. Valid values: 0 to 1825. Default value: 730. Unit: days.', example='730'),
  backupSpeedLimit?: long(name='BackupSpeedLimit', description='The disk I/O limit. Unit: KB/s.
> This parameter takes effect only for MySQL physical backup.', example='262144'),
  backupStartTime?: string(name='BackupStartTime', description='The start time of the full backup. The time is in the <i>HH:mm</i>Z format and displayed in UTC. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.', example='14:22'),
  backupStorageEncryptMethod?: string(name='BackupStorageEncryptMethod', description='The encryption method for backup storage.', example='encrypted'),
  backupStorageType?: string(name='BackupStorageType', description='The built-in storage type. Valid values:
- Empty string (default): Backup data is stored in your OSS bucket.
- system: Backup data is stored in the built-in OSS bucket of DBS.', example='None'),
  backupStrategyType?: string(name='BackupStrategyType', description='The full backup epoch. Valid values:
- **simple**: periodic backup, which is used together with BackupPeriod and BackupStartTime
- **manual**: manual backup

> Default value: **simple**.', example='simple'),
  clientToken?: string(name='ClientToken', description='The client token that is used to ensure the idempotence of the request and prevent duplicate submissions. You can use the client to generate the value, and you must ensure that the value is unique among different requests. The value can be up to 64 ASCII characters in length and cannot contain non-ASCII characters.', example='ETnLKlblzczshOTUbOCzxxxxxxx'),
  crossAliyunId?: string(name='CrossAliyunId', description='The UID of the Alibaba Cloud account for cross-account backup. You can call the [DescribeRestoreTaskList](https://help.aliyun.com/document_detail/2869838.html) operation to query the value of this parameter.', example='2xxx7778xxxxxxxxxx'),
  crossRoleName?: string(name='CrossRoleName', description='The name of the RAM role for cross-account backup. You can call the [DescribeRestoreTaskList](https://help.aliyun.com/document_detail/2869838.html) operation to query the value of this parameter.', example='test123'),
  duplicationArchivePeriod?: int32(name='DuplicationArchivePeriod', description='The period after which backup data is transitioned to Archive storage. Default value: 365. Unit: days.', example='365'),
  duplicationInfrequentAccessPeriod?: int32(name='DuplicationInfrequentAccessPeriod', description='The period after which backup data is transitioned to Infrequent Access (IA) storage. Default value: 180. Unit: days.', example='180'),
  enableBackupLog?: boolean(name='EnableBackupLog', description='Specifies whether to enable incremental log backup. Valid values:
- **true**: enables incremental log backup
- **false**: disables incremental log backup', example='true'),
  enableMysqlPhysicalBackupBinlog?: string(name='EnableMysqlPhysicalBackupBinlog', description='Specifies whether to enable log backup for MySQL physical backup.', example='true'),
  enableSourceEndpointSsl?: string(name='EnableSourceEndpointSsl', description='Specifies whether to enable an SSL-encrypted connection to the source database instance.', example='true'),
  OSSBucketName?: string(name='OSSBucketName', description='The name of the OSS bucket.

> By default, the system automatically generates a new name.', example='TestOssBucket'),
  ownerId?: string(name='OwnerId'),
  resourceGroupId?: string(name='ResourceGroupId', description='The ID of the resource group.', example='rg-aekzecovzti****'),
  sourceEndpointDatabaseName?: string(name='SourceEndpointDatabaseName', description='The name of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when the database engine is **PostgreSQL** or **MongoDB**.', example='testRDS'),
  sourceEndpointIP?: string(name='SourceEndpointIP', description='The database connection address. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpointInstanceType** is set to **express**, **agent**, or **other**.', example='rm-uf6wjk5*******.mysql.rds.aliyuncs.com'),
  sourceEndpointInstanceID?: string(name='SourceEndpointInstanceID', description='The database instance ID. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpoint**.**InstanceType** is set to **RDS**, **ECS**, **DDS**, or **Express**.', example='rm-uf6wjk5*********'),
  sourceEndpointInstanceType?: string(name='SourceEndpointInstanceType', description='The location of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter. Valid values:

- **RDS**
- **ECS**
- **Express**: databases connected over Express Connect circuits, VPN gateways, or Smart Access Gateway (SAG)
- **Agent**: databases connected over backup gateways
- **DDS**: ApsaraDB for MongoDB
- **Other**: databases connected by using IP addresses and port numbers

This parameter is required.', example='RDS'),
  sourceEndpointOracleHome?: string(name='SourceEndpointOracleHome', description='Oracle Home', example='/home/test'),
  sourceEndpointOracleSID?: string(name='SourceEndpointOracleSID', description='The Oracle system identifier (SID).

> This parameter is required when the database engine is Oracle.', example='test'),
  sourceEndpointPassword?: string(name='SourceEndpointPassword', description='The password of the database account.

> This parameter is not required when the database engine is **Redis**, or when the database is connected over a backup gateway (**agent**) and the database engine is **SQL Server**. This parameter is required in other scenarios.', example='testPassword'),
  sourceEndpointPort?: int32(name='SourceEndpointPort', description='The port number of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpoint**.**InstanceType** is set to **express**, **agent**, **other**, or **ECS**.', example='3306'),
  sourceEndpointRegion?: string(name='SourceEndpointRegion', description='The region of the database. You can call the [DescribeBackupPlanList](https://help.aliyun.com/document_detail/2869825.html) operation to query the value of this parameter.

> This parameter is required when **SourceEndpointInstanceType** is set to RDS, ECS, DDS, Express, or Agent.', example='cn-hangzhou'),
  sourceEndpointUserName?: string(name='SourceEndpointUserName', description='The username of the database account.

> This parameter is not required when the database engine is **Redis**, or when the database is connected over a backup gateway (**agent**) and the database engine is **SQL Server**. This parameter is required in other scenarios.', example='testRDS'),
  sslCaPem?: string(name='SslCaPem', description='The PEM certificate for the SSL-encrypted connection to the source database.', example='-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----'),
}

