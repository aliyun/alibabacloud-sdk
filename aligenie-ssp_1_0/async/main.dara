}

model AddAndRemoveFavoriteContentRequest {
  deviceInfo: {
    encodeKey: string(name='EncodeKey', description='Value corresponding to the encoding type

When the encoding type is `SKILL_ID`, the value is the Skill ID of the application. When the encoding type is `PACKAGE_NAME`, the value is the packageName of the corresponding client app.

This parameter is required.', example='123'),
    encodeType: string(name='EncodeType', description='Encoding type. There are multiple ways to obtain the device ID for Tmall Genie, and each method corresponds to a different encoding type.

`PACKAGE_NAME`: APK package name, used for the Android application customer link. `SKILL_ID`: Skill ID, used for the cloud-based link.

This parameter is required.', example='PROJECT_ID'),
    id: string(name='Id', description='Device ID, set to deviceOpenId or deviceUnionId.

This parameter is required.', example='rV/XSgPuxZjx/hN3iw8U+e8ouRjKOX95tn1a0kwb2+Ao6Q1CAxASJUZDWtlk1r43LWcVW6fvY1Rr4sEPFodpnA=='),
    idType: string(name='IdType', description='Type of device ID

`OPEN_ID`: Default device ID identifier. `UNION_ID`: Device ID identifier at the organization dimension. This value is available only after an organization has been registered on the Tmall Genie Skill Application Open Platform.

This parameter is required.', example='OPEN_ID'),
    organizationId?: string(name='OrganizationId', description='Organization ID. Required if IdType is UNION_ID.', example='123'),
  }(name='DeviceInfo', description='Device identification information

This parameter is required.', shrink='json', position='Query'),
  openAddAndRemoveFavoriteContentRequest: {
    favoriteCmd: string(name='FavoriteCmd', description='Operation Type

ADD for collect; REMOVE for remove from favorites

This parameter is required.', example='ADD'),
    openSourceRawIdPair: {
      extendInfo?: map[string]any(name='ExtendInfo', description='Extension information'),
      rawId: string(name='RawId', description='Third-party ID

This parameter is required.', example='2105818057'),
      source: string(name='Source', description='Source

This parameter is required.', example='xiami'),
    }(name='OpenSourceRawIdPair', description='Object to collect or remove from favorites

This parameter is required.'),
    packageType: string(name='PackageType', description='Content type

Content: CONTENT; Album: ALBUM; Playlist: COLLECT.

This parameter is required.', example='CONTENT'),
  }(name='OpenAddAndRemoveFavoriteContentRequest', description='Business parameters

This parameter is required.', shrink='json', position='Body'),
  userInfo: {
    encodeKey: string(name='EncodeKey', description='The value corresponding to the encoding type.

When the encoding type is `SKILL_ID`, the value is the Skill ID of the application. When the encoding type is `PACKAGE_NAME`, the value is the packageName of the corresponding client app.

This parameter is required.', example='123'),
    encodeType: string(name='EncodeType', description='Encoding type. There are multiple ways to obtain the user identifier for Tmall Genie, and each method corresponds to a different encoding type.

`PACKAGE_NAME`: APK package name, used for the Android application customer link. `SKILL_ID`: Skill ID, used for the cloud-based link.

This parameter is required.', example='PROJECT_ID'),
    id: string(name='Id', description='User Identifier, set to userOpenId or userUnionId.

This parameter is required.', example='rV/XSgPuxZjx/hN3iw8U+e8ouRjKOX95tn1a0kwb2+Ao6Q1CAxASJUZDWtlk1r43LWcVW6fvY1Rr4sEPFodpnA=='),
    idType: string(name='IdType', description='The type of User ID.

`OPEN_ID`: The default User ID identity. `UNION_ID`: The organization-dimension User ID identity. This value is available only after an organization has been requested on the Tmall Genie Skills Open Platform.

This parameter is required.', example='OPEN_ID'),
    organizationId?: string(name='OrganizationId', description='Organization ID. Required when IdType is UNION_ID.', example='123'),
  }(name='UserInfo', description='User identification information

This parameter is required.', shrink='json', position='Query'),
}

