  maintenanceWindow?: MaintenanceWindow(name='maintenance_window', description='The cluster O&M window.'),
  masterAutoRenew?: boolean(name='master_auto_renew', description='**[Deprecated]** For cluster control plane configuration, use the `auto_renew` parameter under `control_plane_config` instead.

