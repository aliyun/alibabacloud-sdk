  nodepoolInfo?: {
    created?: string(name='created', description='The time when the node pool was created.', example='2025-04-10T14:25:37.285530433+08:00'),
    isDefault?: boolean(name='is_default', description='Specifies whether the node pool is the default node pool. Typically, a cluster has only one default node pool. Valid values:
