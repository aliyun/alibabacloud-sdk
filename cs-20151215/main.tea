  }(name='eflo_node_group', description='The Lingjun node group information.'),
  hostNetwork?: boolean(name='host_network', description='Specifies whether pods in the node pool use the host network mode. Valid values:
- `true`: host network. Pods directly use the network stack of the host and share the IP address and ports with the host.
- `false`: container network. Pods have independent network stacks and do not occupy host network ports.', example='true'),
  interconnectConfig?: {
    bandwidth?: long(name='bandwidth', description='**[Deprecated]** The network bandwidth of the edge-enhanced node pool. Unit: Mbit/s.', example='10'),
    ccnId?: string(name='ccn_id', description='**[Deprecated]** The instance ID of the Cloud Connect Network (CCN) attached to the edge-enhanced node pool.', example='ccn-qm5i0i0q9yi*******'),
    ccnRegionId?: string(name='ccn_region_id', description='**[Deprecated]** The region of the CCN instance associated with the edge-enhanced node pool.', example='cn-shanghai'),
    cenId?: string(name='cen_id', description='**[Deprecated]** The instance ID of the Cloud Enterprise Network (CEN) attached to the edge-enhanced node pool.', example='cen-ey9k9nfhz0f*******'),
    improvedPeriod?: string(name='improved_period', description='**[Deprecated]** The subscription duration of the edge-enhanced node pool. Unit: months.', example='1'),
  }(name='interconnect_config', description='**[Deprecated]** The network configuration related to the edge node pool. This parameter is valid only for node pools whose type is edge.'),
  interconnectMode?: string(name='interconnect_mode', description='The network type of the edge node pool. This parameter takes effect only when `type` is set to `edge`. Valid values:

- `basic`: Internet. Nodes in cloud node pool interact with cloud nodes over the Internet. Applications in cloud node pool cannot directly access the internal network of the cloud VPC.
- `private`: private network. Nodes in cloud node pool connect the cloud and on-premises networks through Express Connect circuits, VPNs, or CEN. This provides higher cloud-edge communication quality and more effective security protection.', example='basic'),
  intranet?: boolean(name='intranet', description='Specifies whether Layer 3 network connectivity is enabled among nodes in the edge node pool. Valid values:
- `true`: enabled. Layer 3 network connectivity is enabled among all nodes in the node pool.
- `false`: disabled. Layer 3 network connectivity is disabled among all hosts in the node pool.', example='true'),
  kubernetesConfig?: {
    cmsEnabled?: boolean(name='cms_enabled', description='Specifies whether to install the CloudMonitor agent on ECS nodes. After the agent is installed, you can view the monitoring information of the created ECS instances in the CloudMonitor console. Valid values:

- `true`: installs the CloudMonitor agent on ECS nodes.
- `false`: does not install the CloudMonitor agent on ECS nodes.', example='true'),
    cpuPolicy?: string(name='cpu_policy', description='The CPU management policy for nodes. The following two policies are supported when the cluster version is 1.12.6 or later:

- `static`: allows you to enhance the CPU affinity and exclusivity for pods with specific resource characteristics on the node.
- `none`: indicates that the existing default CPU affinity scheme is used.', example='none'),
    labels?: [
      Tag
    ](name='labels', description='The node labels.'),
    nodeNameMode?: string(name='node_name_mode', description='The custom node name.

A node name consists of three parts: prefix + node IP address substring + suffix:
 
- The prefix and suffix can each consist of one or more parts separated by periods (.). Each part can contain lowercase letters, digits, and hyphens (-). The node name must start and end with a lowercase letter or a digit.
- The IP address substring length refers to the number of digits truncated from the end of the node IP address. Valid values: 5 to 12.
 
For example, if the node IP address is 192.168.0.55, the specified prefix is aliyun.com, the IP address substring length is 5, and the suffix is test, the node name is aliyun.com00055test.', example='aliyun.com192.XX.YY.55test'),
    preUserData?: string(name='pre_user_data', description='The pre-custom data of the node pool, which is the script that runs before node initialization. For more information, see [Generate instance user data](https://help.aliyun.com/document_detail/49121.html).', example='dGhpcyBpcyBhIGV4YW1wbGU'),
    runtime?: string(name='runtime', description='The name of the container runtime. ACK supports the following three container runtimes:

- containerd: recommended. Supported by all cluster versions.
- Sandboxed-Container.runv: sandboxed container. Provides higher isolation. Supported by clusters of version 1.31 and earlier.
- docker: no longer maintained. Supported by clusters of version 1.22 and earlier.', example='containerd'),
    runtimeVersion?: string(name='runtime_version', description='The container runtime version.', example='1.6.38'),
    taints?: [
      Taint
    ](name='taints', description='The node taint information. Taints and tolerations work together to prevent pods from being scheduled onto inappropriate nodes. For more information, see [taint-and-toleration](https://kubernetes.io/zh/docs/concepts/scheduling-eviction/taint-and-toleration/).'),
    unschedulable?: boolean(name='unschedulable', description='Specifies whether nodes are unschedulable after a scale-out. Valid values:

- true: The nodes are unschedulable.

- false: The nodes are schedulable.', example='true'),
    userData?: string(name='user_data', description='The custom data of the node pool, which is the script that runs after node initialization. For more information, see [Generate instance user data](https://help.aliyun.com/document_detail/49121.html).', example='IyEvYmluL3NoCmVjaG8gIkhlbGxvIEFDSyEi'),
  }(name='kubernetes_config', description='The cluster-related configurations.'),
  management?: {
    autoFaultDiagnosis?: boolean(name='auto_fault_diagnosis', description='Specifies whether to enable ECS fault detection for node self-healing.'),
    autoRepair?: boolean(name='auto_repair', description='The auto repair feature. This feature takes effect only when `enable` is set to `true`. Valid values:

- `true`: enables auto repair.
- `false`: disables auto repair.', example='true'),
    autoRepairPolicy?: {
      approvalRequired?: boolean(name='approval_required', description='Specifies whether manual approval is required for node repair.', example='false'),
      autoRepairPolicyId?: string(name='auto_repair_policy_id', description='The ID of the auto-repair policy.', example='r-xxxxxxxxxx'),
      maxParallelRepairingNodes?: string(name='max_parallel_repairing_nodes', description='The maximum number or percentage of nodes that can be repaired simultaneously when a large number of abnormal nodes exist in the node pool.', example='1'),
      maxUnhealthyNodesThreshold?: string(name='max_unhealthy_nodes_threshold', description='The circuit breaker threshold for auto-repair. When the number or percentage of failed nodes exceeds this threshold, the auto-repair process enters the circuit breaker state and stops initiating new repair actions.', example='10%'),
      restartNode?: boolean(name='restart_node', description='Specifies whether to allow node restarts. This parameter takes effect only when auto_repair is set to true. Valid values:
- true: Node restarts are allowed.
- false: Node restarts are not allowed.', example='true'),
    }(name='auto_repair_policy', description='The auto-repair policy for nodes.'),
    autoUpgrade?: boolean(name='auto_upgrade', description='Specifies whether to automatically upgrade nodes. This parameter takes effect only when enable is set to true. Valid values:
- true: Auto-upgrade is enabled.
- false: Auto-upgrade is disabled.', example='true'),
    autoUpgradePolicy?: {
      autoUpgradeKubelet?: boolean(name='auto_upgrade_kubelet', description='Specifies whether to allow automatic kubelet upgrades. This parameter takes effect only when auto_upgrade is set to true. Valid values:
- true: Automatic kubelet upgrades are allowed.
- false: Automatic kubelet upgrades are not allowed.', example='true'),
    }(name='auto_upgrade_policy', description='The auto-upgrade policy.'),
    autoVulFix?: boolean(name='auto_vul_fix', description='Specifies whether to automatically fix CVEs. This parameter takes effect only when enable is set to true. Valid values:
- true: Automatic CVE fixes are allowed.
- false: Automatic CVE fixes are not allowed.', example='true'),
    autoVulFixPolicy?: {
      excludePackages?: string(name='exclude_packages', description='The packages to be excluded during vulnerability fixes.', example='kernel'),
      restartNode?: boolean(name='restart_node', description='Specifies whether to allow node restarts. This parameter takes effect only when auto_vul_fix is set to true. Valid values:
- true: Node restarts are allowed.
- false: Node restarts are not allowed.', example='true'),
      vulLevel?: string(name='vul_level', description='The vulnerability levels that are allowed for automatic fixes, separated by commas. Valid values:
- asap: high
- later: medium
- nntf: low', example='asap,nntf'),
    }(name='auto_vul_fix_policy', description='The automatic CVE fix policy.'),
    driftEnabled?: boolean(name='drift_enabled', description='Specifies whether to enable the node rotation capability. This feature is supported only by intelligent managed node pools and is enabled by default. Common node pools do not support this feature.'),
    enable?: boolean(name='enable', description='Specifies whether to enable the managed node pool. Valid values:
- true: The managed node pool is enabled.
- false: The managed node pool is disabled. Other related configurations take effect only when enable is set to true.', example='true'),
    upgradeConfig?: {
      autoUpgrade?: boolean(name='auto_upgrade', description='Specifies whether to enable auto-upgrade. Valid values:
- true: Auto-upgrade is enabled.
- false: Auto-upgrade is disabled.', example='true'),
      maxUnavailable?: long(name='max_unavailable', description='The maximum number of unavailable nodes. Valid values: 1 to 1000.

Default value: 1.', example='1'),
      surge?: long(name='surge', description='The number of surge nodes. This parameter and surge_percentage are mutually exclusive.', example='5'),
      surgePercentage?: long(name='surge_percentage', description='The percentage of surge nodes. This parameter and surge are mutually exclusive.

The number of surge nodes is calculated by multiplying the surge node percentage by the total number of nodes. For example, if the surge node percentage is set to 50% and the total number of nodes is 6, the number of surge nodes generated is 50% × 6 = 3.', example='50'),
    }(name='upgrade_config', description='The auto-upgrade configuration. This parameter takes effect only when enable is set to true.'),
  }(name='management', description='The managed node pool configuration.'),
  maxNodes?: long(name='max_nodes', description='**[Deprecated]** The maximum number of nodes that an edge node pool can accommodate.', example='10'),
