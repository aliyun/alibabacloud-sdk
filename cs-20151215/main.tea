model CreateAutoscalingConfigRequest {
  coolDownDuration?: string(name='cool_down_duration', description='The scale-in trigger delay, which is the time interval between when a scale-in need is detected (the scale-in threshold is reached) and when the scale-in operation (reducing the number of Pods) is actually performed.

Valid values: [1,60]. Unit: minutes.

Default value: 10.', example='10'),
  daemonsetEvictionForNodes?: boolean(name='daemonset_eviction_for_nodes', description='Specifies whether cluster-autoscaler evicts DaemonSet Pods on a node during scale-in. Valid values:
