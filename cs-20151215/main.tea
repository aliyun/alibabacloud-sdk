/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-northeast-2-pop' = 'cs.aliyuncs.com',
    'cn-beijing-finance-pop' = 'cs.aliyuncs.com',
    'cn-beijing-gov-1' = 'cs.aliyuncs.com',
    'cn-beijing-nu16-b01' = 'cs.aliyuncs.com',
    'cn-edge-1' = 'cs.aliyuncs.com',
    'cn-fujian' = 'cs.aliyuncs.com',
    'cn-haidian-cm12-c01' = 'cs.aliyuncs.com',
    'cn-hangzhou-bj-b01' = 'cs.aliyuncs.com',
    'cn-hangzhou-internal-prod-1' = 'cs.aliyuncs.com',
    'cn-hangzhou-internal-test-1' = 'cs.aliyuncs.com',
    'cn-hangzhou-internal-test-2' = 'cs.aliyuncs.com',
    'cn-hangzhou-internal-test-3' = 'cs.aliyuncs.com',
    'cn-hangzhou-test-306' = 'cs.aliyuncs.com',
    'cn-hongkong-finance-pop' = 'cs.aliyuncs.com',
    'cn-qingdao-nebula' = 'cs.aliyuncs.com',
    'cn-shanghai-et15-b01' = 'cs.aliyuncs.com',
    'cn-shanghai-et2-b01' = 'cs.aliyuncs.com',
    'cn-shanghai-inner' = 'cs.aliyuncs.com',
    'cn-shanghai-internal-test-1' = 'cs.aliyuncs.com',
    'cn-shenzhen-inner' = 'cs.aliyuncs.com',
    'cn-shenzhen-st4-d01' = 'cs.aliyuncs.com',
    'cn-shenzhen-su18-b01' = 'cs.aliyuncs.com',
    'cn-wuhan' = 'cs.aliyuncs.com',
    'cn-yushanfang' = 'cs.aliyuncs.com',
    'cn-zhangbei' = 'cs.aliyuncs.com',
    'cn-zhangbei-na61-b01' = 'cs.aliyuncs.com',
    'cn-zhangjiakou-na62-a01' = 'cs.aliyuncs.com',
    'cn-zhengzhou-nebula-1' = 'cs.aliyuncs.com',
    'eu-west-1-oxs' = 'cs.aliyuncs.com',
    'rus-west-1-pop' = 'cs.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('cs', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model DiskInit {
  diskName?: string(name='disk_name', description='The unique identifier for a disk in the node pool.
- When local_disk is set to false, the value must match one of the disk_name values in scaling_group.data_disks.
- When local_disk is set to true, the value must be different from all disk_name values in scaling_group.data_disks.

This parameter is required.', example='disk0'),
  localDisk?: boolean(name='local_disk', description='Specifies whether this configuration applies to a local disk. When this parameter is set to true:
- If the disk cannot be matched by using the ECS DiskName and symbolic links, the local disk can be matched.
- If the disk is detected as uninitialized during boot, it is reinitialized.
- Both mount_target and mkfs_type must be set or left empty at the same time.
- When used in combination with mount_for_runtime, if the local disk is reinitialized, the node must be removed from and then re-added to the node pool.'),
  mkfsType?: string(name='mkfs_type', description='The type of the file system for automatic formatting. An empty value indicates that the disk is not formatted.', example='ext4'),
  mountForRuntime?: boolean(name='mount_for_runtime', description='Specifies whether container runtime data is stored on the disk.'),
  mountTarget?: string(name='mount_target', description='The mount directory. An empty value indicates that the disk is not mounted.', example='/mnt/disk0'),
}

model Hugepage {
  khugepagedAllocSleepMillisecs?: long(name='khugepagedAllocSleepMillisecs'),
  khugepagedDefrag?: long(name='khugepagedDefrag'),
  khugepagedPagesToScan?: long(name='khugepagedPagesToScan'),
  khugepagedScanSleepMillisecs?: long(name='khugepagedScanSleepMillisecs'),
  transparentDefrag?: string(name='transparentDefrag'),
  transparentEnabled?: string(name='transparentEnabled'),
}

model InstanceMetadataOptions {
  httpTokens?: string(name='http_tokens', description='The ECS instance metadata access mode configuration. Valid values:

* `optional`: Compatible with both normal mode and hardened mode.
* `required`: Enables hardened mode only (IMDSv2). After this mode is enabled, applications in the node cannot access ECS instance metadata in normal mode.

Default value: `optional`.

>Notice: 

* This parameter is currently available only by whitelist. To use this parameter, submit a ticket.
* Only ACK managed clusters of version 1.28 and later support this parameter.



> For more information about instance metadata access modes, see [Instance metadata access modes](https://help.aliyun.com/document_detail/108460.html).', example='optional'),
}

model Addon {
  config?: string(name='config', description='The component configuration.', example='{\\\\"IngressSlbNetworkType\\\\":\\\\"internet\\\\"}'),
  disabled?: boolean(name='disabled', description='Specifies whether to disable default installation. When a cluster is created, in addition to required components, additional components such as log components are installed by default. You can disable this default behavior and install these components later by calling the component installation API or through the console. Valid values:
- `true`: Disables default installation.
- `false`: Allows default installation.', example='false'),
  name?: string(name='name', description='The component name.', example='nginx-ingress-controller'),
  version?: string(name='version', description='The component version.', example='v1.9.3-aliyun.1'),
}

model ContainerdConfig {
  ignoreImageDefinedVolume?: boolean(name='ignoreImageDefinedVolume', description='Whether to ignore volumes defined in the image.'),
  insecureRegistries?: [ string ](name='insecureRegistries', description='A list of insecure registries that skip TLS certificate verification.'),
  limitCore?: long(name='limitCore', description='Maximum core dump size in bytes.'),
  limitMemLock?: long(name='limitMemLock', description='Maximum locked memory in bytes.'),
  limitNoFile?: long(name='limitNoFile', description='Maximum number of open file handles.'),
  maxConcurrentDownloads?: long(name='maxConcurrentDownloads', description='The maximum number of concurrent image layer downloads.'),
  registryMirrors?: [ string ](name='registryMirrors', description='A list of registry mirrors to accelerate image pulls.'),
}

model DataDisk {
  autoFormat?: boolean(name='auto_format', description='Specifies whether to automatically mount the data disk.', example='true', deprecated=true),
  autoSnapshotPolicyId?: string(name='auto_snapshot_policy_id', description='The ID of the automatic snapshot policy. The system performs automatic backup for a cloud disk based on the specified automatic snapshot policy.

By default, this parameter is empty, which indicates that automatic backup is disabled.', example='sp-2zej1nogjvovnz4z****'),
  burstingEnabled?: boolean(name='bursting_enabled', description='Specifies whether to enable the burst feature for the data disk. Valid values:

*   `true`: enables the burst feature.
*   `false`: disables the burst feature for the data disk.

This parameter is available only if `DiskCategory` is set to `cloud_auto`. For more information, see [ESSD AutoPL disks](https://help.aliyun.com/document_detail/368372.html).', example='true'),
  category?: string(name='category', description='The category of data disk. Valid values:

*   `cloud`: basic disk.
*   `cloud_efficiency`: ultra disk
*   `cloud_ssd`: standard SSD.
*   `cloud_essd`: Enterprise ESSD (ESSD).
*   `cloud_auto`: ESSD AutoPL disk.
*   `cloud_essd_entry`: ESSD Entry disk.
*   `elastic_ephemeral_disk_premium`: premium elastic ephemeral disk.
*   `elastic_ephemeral_disk_standard`: standard elastic ephemeral disk.

Default value: `cloud_efficiency`.', example='cloud_ssd'),
  device?: string(name='device', description='The mount target of the data disk. If you do not specify this parameter, the system automatically assigns a mount target when you create an Elastic Compute Service (ECS) instance. Valid values: /dev/xvdb to /dev/xvdz.', example='/dev/xvdb'),
  diskName?: string(name='disk_name', description='The data disk name. The name must be 2 to 128 characters in length. It must start with a letter and cannot start with http:// or https://. The name can contain letters, digits, colons (:), underscores (_), and hyphens (-).', example='DataDiskName'),
  encrypted?: string(name='encrypted', description='Specifies whether to encrypt the data disk. Valid values:

*   `true`: encrypts the data disk.
*   `false`: does not encrypt the data disk.

Default value: `false`.', example='true'),
  fileSystem?: string(name='file_system', description='The file system that is mounted. This parameter takes effect only if auto_format is set to true. Valid values: ext4 and xfs.', example='ext4', deprecated=true),
  kmsKeyId?: string(name='kms_key_id', description='The ID of the Key Management Service (KMS) key that is used to encrypt the data disk.', example='0e478b7a-4262-4802-b8cb-00d3fb40****'),
  mountTarget?: string(name='mount_target', description='The path to which the data disk is mounted. You must specify a valid path.', example='/mnt/path1', deprecated=true),
  performanceLevel?: string(name='performance_level', description='The performance level (PL) of the data disk. This parameter takes effect only for an ESSD. This parameter is related to the disk size. For more information, see [ESSDs](https://help.aliyun.com/document_detail/122389.html).', example='PL1'),
  provisionedIops?: long(name='provisioned_iops', description='The preset IOPS of the data disk. Valid values: 0 to min{50,000, 1,000 × Capacity - Baseline IOPS}. Baseline IOPS = min{1,800 + 50 × Capacity, 50,000}.

This parameter is available only if `DiskCategory` is set to `cloud_auto`. For more information, see [ESSD AutoPL disks](https://help.aliyun.com/document_detail/368372.html).', example='1000'),
  size?: long(name='size', description='The size of the data disk. Unit: GiB.

Valid values: 40 to 32768.

Default value: `120`.', example='40'),
  snapshotId?: string(name='snapshot_id', description='The ID of the snapshot that you want to use to create the data disk. If this parameter is specified, the specified size of the data disk is ignored. The size of the disk equals the size of the specified snapshot. If the snapshot was created on or before July 15, 2013, the API request is rejected and the InvalidSnapshot.TooOld message is returned.', example='s-280s7****'),
}

model InstancePatterns {
  architectures?: [ string ](name='architectures', description='[This parameter is deprecated and replaced by cpu_architectures] The architectures of instance types.', deprecated=true),
  burstPerformanceOption?: string(name='burst_performance_option', description='[This parameter is deprecated] Specifies whether to include burstable instance types.', example='Exclude', deprecated=true),
  core?: long(name='core', description='[This parameter is deprecated and replaced by cores] The number of vCores provided by the instance type.', example='4', deprecated=true),
  cores?: long(name='cores', description='The number of vCPU cores for the instance type.', example='4'),
  cpuArchitectures?: [ string ](name='cpu_architectures', description='The CPU architecture of the instance type.'),
  excludedInstanceTypes?: [ string ](name='excluded_instance_types', description='The instance type that you want to exclude.'),
  instanceCategories?: [ string ](name='instance_categories', description='The type of the instance.'),
  instanceFamilyLevel?: string(name='instance_family_level', description='The instance family level.', example='EnterpriseLevel'),
  instanceTypeFamilies?: [ string ](name='instance_type_families', description='The specified instance family.'),
  maxCpuCores?: long(name='max_cpu_cores', description='The maximum vCPU cores allowed for the instance type.', example='8'),
  maxMemorySize?: float(name='max_memory_size', description='The maximum allowed memory size. Unit: GiB.', example='16'),
  maxPrice?: float(name='max_price', description='[This parameter is deprecated] The maximum hourly price of the instance.', example='2', deprecated=true),
  maximumGpuAmount?: long(name='maximum_gpu_amount', description='The maximum allowed number of GPUs per instance.', example='8'),
  memory?: float(name='memory', description='The memory size of the instance type. Unit: GiB.', example='8'),
  minCpuCores?: long(name='min_cpu_cores', description='The minimum vCPU cores required for the instance type.', example='4'),
  minMemorySize?: float(name='min_memory_size', description='The minimum required memory size. Unit: GiB.', example='8'),
  minimumEniIpv6AddressQuantity?: long(name='minimum_eni_ipv6_address_quantity', description='The minimum required number of IPv6 addresses per ENI.', example='1'),
  minimumEniPrivateIpAddressQuantity?: long(name='minimum_eni_private_ip_address_quantity', description='The minimum required number of IPv4 addresses per ENI.', example='10'),
  minimumEniQuantity?: long(name='minimum_eni_quantity', description='The minimum required number of elastic network interfaces (ENIs) per instance.', example='3'),
}

model KubeletConfig {
  allowedUnsafeSysctls?: [ string ](name='allowedUnsafeSysctls', description='The whitelist of allowed unsafe sysctl patterns.'),
  clusterDNS?: [ string ](name='clusterDNS', description='The list of IP addresses for the cluster DNS servers.'),
  containerLogMaxFiles?: long(name='containerLogMaxFiles', description='The maximum number of log files that can exist per container.', example='5'),
  containerLogMaxSize?: string(name='containerLogMaxSize', description='The maximum size a log file can reach before log rotation is performed.', example='10Mi'),
  containerLogMaxWorkers?: int32(name='containerLogMaxWorkers', description='The maximum number of concurrent workers for log rotation operations.', example='1'),
  containerLogMonitorInterval?: string(name='containerLogMonitorInterval', description='The interval for monitoring container logs to perform log rotation.', example='10s'),
  cpuCFSQuota?: boolean(name='cpuCFSQuota', description='Specifies whether to enable CPU CFS quota enforcement.', example='true'),
  cpuCFSQuotaPeriod?: string(name='cpuCFSQuotaPeriod', description='The CPU CFS quota period value.', example='100ms'),
  cpuManagerPolicy?: string(name='cpuManagerPolicy', description='The CPU manager policy.', example='none'),
  eventBurst?: long(name='eventBurst', description='The maximum burst size for event records.', example='10'),
  eventRecordQPS?: long(name='eventRecordQPS', description='The maximum number of events that can be generated per second.', example='5'),
  evictionHard?: map[string]any(name='evictionHard', description='The set of hard eviction thresholds that trigger pod eviction.'),
  evictionSoft?: map[string]any(name='evictionSoft', description='The set of soft eviction thresholds.'),
  evictionSoftGracePeriod?: map[string]any(name='evictionSoftGracePeriod', description='The set of eviction grace periods.'),
  featureGates?: map[string]any(name='featureGates', description='The feature gates configuration used to enable experimental features.'),
  imageGCHighThresholdPercent?: int32(name='imageGCHighThresholdPercent', description='The threshold above which image garbage collection runs continuously.', example='85'),
  imageGCLowThresholdPercent?: int32(name='imageGCLowThresholdPercent', description='The threshold below which image garbage collection is not performed.', example='80'),
  kubeAPIBurst?: long(name='kubeAPIBurst', description='The maximum number of burst requests sent to the API server per second.', example='10'),
  kubeAPIQPS?: long(name='kubeAPIQPS', description='The number of queries per second when communicating with the API server.', example='5'),
  kubeReserved?: map[string]any(name='kubeReserved', description='The resource configuration reserved for Kubernetes system components.'),
  maxPods?: long(name='maxPods', description='The maximum number of pods that can run on the node.', example='110'),
  memoryManagerPolicy?: string(name='memoryManagerPolicy', description='The policy used by the memory management manager.', example='none'),
  podPidsLimit?: long(name='podPidsLimit', description='The maximum number of PIDs that can be used in a pod.', example='-1'),
  readOnlyPort?: long(name='readOnlyPort', description='The read-only port number.', example='0'),
  registryBurst?: long(name='registryBurst', description='The maximum number of burst image pulls.', example='10'),
  registryPullQPS?: long(name='registryPullQPS', description='The QPS limit for the image registry.', example='5'),
  reservedMemory?: [ 
    {
      limits?: map[string]any(name='limits', description='The memory resources limit.', example='{"memory": "1Gi"}'),
      numaNode?: int32(name='numaNode', description='The NUMA node.', example='0'),
    }
  ](name='reservedMemory', description='The memory reserved for NUMA nodes.'),
  serializeImagePulls?: boolean(name='serializeImagePulls', description='Specifies whether to pull images one at a time.', example='true'),
  serverTLSBootstrap?: boolean(name='serverTLSBootstrap', description='Enables automatic issuance and rotation of kubelet server certificates. When enabled, you must also set "RotateKubeletServerCertificate": true in the kubelet featureGates configuration.

> - Available only for clusters running version 1.30 or later.
> - For clusters running version 1.30 to v1.33, submit a ticket to apply for this feature.', example='true'),
  systemReserved?: map[string]any(name='systemReserved', description='The resource configuration reserved for the system.'),
  topologyManagerPolicy?: string(name='topologyManagerPolicy', description='The Policy Name of the topology management manager to use.', example='restricted'),
  tracing?: {
    endpoint?: string(name='endpoint', description='The endpoint of the collector.', example='localhost:4317'),
    samplingRatePerMillion?: int32(name='samplingRatePerMillion', description='The number of samples to collect per million spans.', example='200000'),
  }(name='tracing', description='The versioned configuration for the OpenTelemetry tracing client.'),
}

model MaintenanceWindow {
  duration?: string(name='duration', description='The maintenance duration. Valid values: 1 to 24. Unit: hours.

Default value: 3h.', example='3h'),
  enable?: boolean(name='enable', description='Specifies whether to enable the maintenance window. Valid values:
- `true`: Enables the maintenance window.
- `false`: Does not enable the maintenance window.

Default value: `false`.', example='false'),
  exclusions?: [ 
    {
      description?: string(name='description', description='The description of the exclusion. The description can be up to 128 characters in length and does not support 4-byte characters such as emojis.', example='No changes are allowed during the change freeze period'),
      endTime?: string(name='end_time', description='The end time of the exclusion. The time must be in the RFC 3339 standard format, later than the start_time, and later than the current time. Maximum duration for a single exclusion: 30 days for NoOperations, NoUpgrades, and NoCVEPatch, and 180 days for NoMinorUpgrades.', example='2026-11-15T00:00:00+08:00'),
      name?: string(name='name', description='The name of the exclusion. The name must be 1 to 63 characters in length and can contain digits, underscores (_), and hyphens (-). It must start with an uppercase or lowercase letter, a Chinese character, or a digit. The name must be unique within the same maintenance window. If you do not specify this parameter, a default name in the format of exclusion-{random string} is generated.', example='exclusion-holiday'),
      scope?: string(name='scope', description='The scope of the exclusion, which specifies the proactive O&M types that are prohibited during this time period. Valid values (case-sensitive):
- NoOperations: Prohibits all proactive O&M operations, including cluster upgrades, component upgrades, CVE patching, and OS image updates.
- NoUpgrades: Prohibits cluster upgrades and component upgrades, but still allows CVE patching and responses to scheduled ECS events.
- NoMinorUpgrades: Prohibits only minor version upgrades for clusters, but still allows patch upgrades, component upgrades, and CVE patching.
- NoCVEPatch: Prohibits automatic CVE patching.', example='NoOperations'),
      startTime?: string(name='start_time', description='The start time of the exclusion. The time must be in the RFC 3339 standard format and use the same time zone offset as the end_time and maintenance_time.', example='2026-11-01T00:00:00+08:00'),
    }
  ](name='exclusions', description='The list of exclusions for the maintenance window. A maximum of 10 exclusions are supported. Exclusions take precedence over the maintenance window. If an active exclusion covers an O&M type, the O&M operation is not performed even if the current time is within the maintenance window. If multiple exclusions are active at the same time, the union of the exclusions is applied. The total number of NoOperations and NoUpgrades exclusions cannot exceed 3. Only one-time periods are supported. Periodic configurations are not supported.'),
  maintenanceTime?: string(name='maintenance_time', description='The start time of the maintenance window. The time must be in the RFC 3339 standard format.', example='2020-10-15T12:31:00.000+08:00'),
  recurrence?: string(name='recurrence', description='The recurrence rule for the maintenance window, defined by using the RFC 5545 Recurrence Rule syntax. Only FREQ=WEEKLY is supported. COUNT and UNTIL are not supported.', example='FREQ=WEEKLY;INTERVAL=4;BYDAY=MO,TU'),
  weeklyPeriod?: string(name='weekly_period', description='The weekly maintenance period. Separate multiple values with commas (,). Valid values: Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, and Sunday.

Default value: `Thursday`.', example='Monday,Thursday'),
}

model Nodepool {
  autoScaling?: {
    eipBandwidth?: long(name='eip_bandwidth', description='**[Deprecated]** The peak bandwidth of the elastic IP address (EIP). Unit: Mbit/s.', example='5', deprecated=true),
    eipInternetChargeType?: string(name='eip_internet_charge_type', description='**[Deprecated]** The billing method of the EIP. Valid values:
- PayByBandwidth: pay-by-bandwidth.
- PayByTraffic: pay-by-data-transfer.
Default value: PayByBandwidth.', example='PayByBandwidth', deprecated=true),
    enable?: boolean(name='enable', description='Specifies whether to enable auto scaling. Valid values:
- true: enables auto scaling for the node pool.
- false: disables auto scaling. If this parameter is set to false, other configuration parameters in auto_scaling do not take effect.
Default value: false.

This parameter is required.', example='true'),
    isBondEip?: boolean(name='is_bond_eip', description='**[Deprecated]** Specifies whether to associate an EIP. Valid values:
- true: associates an EIP.
- false: does not associate an EIP.
Default value: false.', example='true', deprecated=true),
    maxInstances?: long(name='max_instances', description='The maximum number of instances in the auto-scaling group.

This parameter is required.', example='10'),
    minInstances?: long(name='min_instances', description='The minimum number of instances in the auto-scaling group.

This parameter is required.', example='0'),
    type?: string(name='type', description='The auto-scaling type, which is classified by the instance type used for auto scaling. Valid values:
- cpu: regular instance.
- gpu: GPU-accelerated instance.
- gpushare: shared GPU instance.
- spot: spot instance.
Default value: cpu.', example='cpu'),
  }(name='auto_scaling', description='The auto-scaling node pool configuration.'),
  count?: long(name='count', description='**[Deprecated]** Use desired_size instead. The number of nodes in the node pool.', example='1', deprecated=true),
  interconnectConfig?: {
    bandwidth?: long(name='bandwidth', description='**[Deprecated]** The network bandwidth of the edge-optimized node pool. Unit: Mbit/s.', example='10', deprecated=true),
    ccnId?: string(name='ccn_id', description='**[Deprecated]** The instance ID of the Cloud Connect Network (CCN) attached to the edge-optimized node pool.', example='ccn-qm5i0i0q9yi*******', deprecated=true),
    ccnRegionId?: string(name='ccn_region_id', description='**[Deprecated]** The region of the CCN instance associated with the edge-optimized node pool.', example='cn-shanghai', deprecated=true),
    cenId?: string(name='cen_id', description='**[Deprecated]** The instance ID of the Cloud Enterprise Network (CEN) attached to the edge-optimized node pool.', example='cen-ey9k9nfhz0f*******', deprecated=true),
    improvedPeriod?: string(name='improved_period', description='**[Deprecated]** The subscription duration of the edge-optimized node pool. Unit: months.', example='1', deprecated=true),
  }(name='interconnect_config', description='**[Deprecated]** The configuration of the edge node pool.', deprecated=true),
  interconnectMode?: string(name='interconnect_mode', description='The network type of the edge node pool. This parameter is valid only when type is set to edge. Valid values:
- basic: basic.
- private: dedicated. Supported in Kubernetes 1.22 and later.', example='basic'),
  kubernetesConfig?: {
    cmsEnabled?: boolean(name='cms_enabled', description='Specifies whether to install CloudMonitor on ECS nodes. After installation, you can view the monitoring information of the created ECS instances in the CloudMonitor console. Enabling this feature is recommended. Valid values:
- true: installs CloudMonitor on ECS nodes.
- false: does not install CloudMonitor on ECS nodes.
Default value: false.', example='true'),
    cpuPolicy?: string(name='cpu_policy', description='The CPU management policy for nodes. The following two policies are supported when the cluster version is 1.12.6 or later:
- static: allows you to enhance CPU affinity and exclusivity for pods with specific resource characteristics on the node.
- none: uses the default CPU affinity scheme.
Default value: none.', example='none'),
    labels?: [
      Tag
    ](name='labels', description='The node labels, which are added to the nodes in the Kubernetes cluster.'),
    nodeNameMode?: string(name='node_name_mode', description='The node name consists of three parts: prefix + node IP address + suffix.
- The prefix and suffix can each consist of one or more parts separated by periods (.). Each part can contain lowercase letters, digits, and hyphens (-). The node name must start and end with a lowercase letter or a digit.
- The node IP address is the complete private IP address of the node.
The parameter value contains four parts separated by commas. For example, if the parameter is set to the "customized,aliyun,ip,com" string (where "customized" and "ip" are fixed strings, "aliyun" is the prefix, and "com" is the suffix), the node name is aliyun.192.168.xxx.xxx.com.', example='customized,aliyun,ip,com'),
    runtime?: string(name='runtime', description='The container runtime. Valid values:
- containerd: recommended. Supported by all cluster versions.
- Sandboxed-Container.runv: sandboxed container. Provides higher isolation. Supported by clusters of Kubernetes 1.24 and earlier.
- docker: supported by clusters of Kubernetes 1.22 and earlier.
Default value: containerd.

This parameter is required.', example='containerd'),
    runtimeVersion?: string(name='runtime_version', description='The container runtime version.

This parameter is required.', example='1.6.20'),
    taints?: [
      Taint
    ](name='taints', description='The taint configuration.'),
    userData?: string(name='user_data', description='The custom data of the node.', example='MXM='),
  }(name='kubernetes_config', description='The cluster-related configuration.'),
  management?: {
    autoFaultDiagnosis?: boolean(name='auto_fault_diagnosis', description='Specifies whether to enable ECS fault detection for node self-healing.'),
    autoRepair?: boolean(name='auto_repair', description='Specifies whether to enable auto-repair. This parameter takes effect only when enable is set to true. Valid values:
- true: enables auto-repair.
- false: disables auto-repair.', example='false'),
    autoRepairPolicy?: {
      maxParallelRepairingNodes?: string(name='max_parallel_repairing_nodes', description='The maximum number of parallel repairs. When a large number of abnormal nodes exist in the node pool, this parameter specifies the maximum number or percentage of nodes that can be repaired at the same time. You can specify a number (such as 5, valid values: 1 to 100000) or a percentage (such as 10%, valid values: 1% to 100%). Default value: 1.', example='5'),
      maxUnhealthyNodesThreshold?: string(name='max_unhealthy_nodes_threshold', description='The circuit breaker threshold for self-healing. When the number or percentage of faulty nodes exceeds this threshold, self-healing enters the circuit breaker state and stops initiating new self-healing actions. You can specify a number (such as 10, valid values: 1 to 100000) or a percentage (such as 20%, valid values: 1% to 100%). Default value: 100%.', example='20%'),
      restartNode?: boolean(name='restart_node', description='Specifies whether to allow node restarts.', example='true'),
    }(name='auto_repair_policy', description='The auto-repair policy for nodes.'),
    autoUpgrade?: boolean(name='auto_upgrade', description='Specifies whether to enable auto upgrade.', example='true'),
    autoUpgradePolicy?: {
      autoUpgradeKubelet?: boolean(name='auto_upgrade_kubelet', description='Specifies whether to allow automatic kubelet upgrades.', example='true'),
    }(name='auto_upgrade_policy', description='The auto upgrade policy.'),
    autoVulFix?: boolean(name='auto_vul_fix', description='Specifies whether to automatically repair Common Vulnerabilities and Exposures (CVE).', example='true'),
    autoVulFixPolicy?: {
      restartNode?: boolean(name='restart_node', description='Specifies whether to allow node restarts.', example='true'),
      vulLevel?: string(name='vul_level', description='The vulnerability levels that are allowed for automatic repair, separated by commas.', example='asap,nntf'),
    }(name='auto_vul_fix_policy', description='The policy for automatic CVE repair.'),
    driftEnabled?: boolean(name='drift_enabled', description='Specifies whether to enable the node drift capability. This feature is only supported by smart managed node pools and is enabled by default. Regular node pools do not support this feature.'),
    enable?: boolean(name='enable', description='Specifies whether to enable the managed node pool. Valid values:
- true: Enables the managed node pool.
- false: Does not enable the managed node pool. Other related configurations take effect only when enable is set to true.', example='false'),
    upgradeConfig?: {
      autoUpgrade?: boolean(name='auto_upgrade', description='Specifies whether to enable auto upgrade. Valid values:
- true: Enables auto upgrade.
- false: Disables auto upgrade.', example='false'),
      maxUnavailable?: long(name='max_unavailable', description='The maximum number of unavailable nodes. Valid values: 1 to 1000.

Default value: 1.', example='0'),
      surge?: long(name='surge', description='The number of surge nodes.', example='0'),
      surgePercentage?: long(name='surge_percentage', description='The percentage of surge nodes. This parameter and surge are mutually exclusive.', example='0'),
    }(name='upgrade_config', description='The auto upgrade configuration. This configuration takes effect only when enable is set to true.', deprecated=true),
  }(name='management', description='The managed node pool configuration.'),
  maxNodes?: long(name='max_nodes', description='The maximum number of nodes that the edge node pool can accommodate. The value must be greater than or equal to 0. A value of 0 indicates no extra limit, meaning the node pool is only limited by the maximum number of nodes that the entire cluster can accommodate. This value is usually greater than 0 for edge node pools. For ess node pools and default edge node pools, this value is 0.', example='10'),
  nodeComponents?: [ 
    {
      config?: {
        customConfig?: map[string]any(name='custom_config', description='The custom node component configuration.', example='{"cpuManagerPolicy":"static"}'),
        envs?: [ 
          {
            name?: string(name='name', description='The name of the environment variable.', example='LOG_LEVEL'),
            value?: string(name='value', description='The value of the environment variable.', example='info'),
          }
        ](name='envs', description='The environment variables for the node component.'),
      }(name='config', description='The node component configuration.'),
      name?: string(name='name', description='The name of the node component.', example='kubelet'),
      version?: string(name='version', description='The version of the node component.', example='1.33.3-aliyun.1'),
    }
  ](name='node_components', description='The list of node components.'),
  nodeConfig?: {
    kubeletConfiguration?: KubeletConfig(name='kubelet_configuration', description='The Kubelet parameter settings.'),
  }(name='node_config', description='The node configuration.'),
  nodepoolInfo?: {
    name?: string(name='name', description='The name of the node pool.

This parameter is required.', example='np-test'),
    resourceGroupId?: string(name='resource_group_id', description='The ID of the resource group to which the node pool belongs.', example='rg-acfmyvw3wjm****'),
    type?: string(name='type', description='The type of the node pool. Valid values:
- ess: Node pool.
- edge: Edge node pool.', example='ess'),
  }(name='nodepool_info', description='The node pool configuration.'),
  scalingGroup?: {
    autoRenew?: boolean(name='auto_renew', description='Specifies whether to enable auto-renewal for the node pool. This parameter takes effect only when instance_charge_type is set to PrePaid. Valid values:
- true: Enables auto-renewal.
- false: Disables auto-renewal.

Default value: true.', example='false'),
    autoRenewPeriod?: long(name='auto_renew_period', description='The auto-renewal epoch for the node pool. This parameter is required and takes effect only when `instance_charge_type` is set to `PrePaid`.

If `PeriodUnit` is set to `Month`, valid values are 1, 2, 3, 6, and 12.

Default value: 1.', example='0'),
    compensateWithOnDemand?: boolean(name='compensate_with_on_demand', description='Specifies whether to automatically create pay-as-you-go instances to meet the required number of ECS instances when multi_az_policy is set to COST_OPTIMIZED and sufficient spot instances cannot be created due to price or inventory constraints. Valid values:
- true: Allows automatic creation of pay-as-you-go instances to meet the required number of ECS instances.
- false: Does not allow automatic creation of pay-as-you-go instances to meet the required number of ECS instances.', example='true'),
    cpuOptions?: {
      nestedVirtualization?: string(name='nested_virtualization', description='Specifies whether to enable nested virtualization. Valid values:
- disabled: Disables nested virtualization.
- enabled: Enables nested virtualization.', example='enabled'),
    }(name='cpu_options', description='The CPU configuration options.'),
    dataDisks?: [
      DataDisk
    ](name='data_disks', description='The data cloud disk configuration for the nodes in the node pool.'),
    deploymentsetId?: string(name='deploymentset_id', description='The ID of the deployment set.', example='ds-bp1d19mmbsv3jf6xxxxx'),
    desiredSize?: long(name='desired_size', description='The expected number of nodes in the node pool.', example='2'),
    diskInit?: [
      DiskInit
    ](name='disk_init', description='The block device initialization configuration.'),
    imageId?: string(name='image_id', description='The ID of the custom image. By default, the system-provided image is used.', example='aliyun_2_1903_x64_20G_alibase_20200904.vhd'),
    imageType?: string(name='image_type', description='The type of the operating system image. This parameter and platform are mutually exclusive. Valid values:
- AliyunLinux: Alinux2 image.
- AliyunLinux3: Alinux3 image.
- AliyunLinux3Arm64: Alinux3 ARM image.
- AliyunLinuxUEFI: Alinux2 UEFI image.
- CentOS: CentOS image.
- Windows: Windows image.
- WindowsCore: Windows Core image.
- ContainerOS: Container-optimized image.', example='AliyunLinux'),
    instanceChargeType?: string(name='instance_charge_type', description='The billing method of the nodes in the node pool. Valid values:
- PrePaid: Subscription.
- PostPaid: Pay-as-you-go.

Default value: PostPaid.

This parameter is required.', example='PostPaid'),
    instanceMetadataOptions?: InstanceMetadataOptions(name='instance_metadata_options', description='The metadata access configuration for the ECS instance. This parameter is currently available only to whitelisted users. To use this parameter, submit a ticket.'),
    instancePatterns?: [
      InstancePatterns
    ](name='instance_patterns', description='The instance properties.'),
    instanceTypes?: [ string ](name='instance_types', description='The instance types.

This parameter is required.'),
    internetChargeType?: string(name='internet_charge_type', description='The billing method for public IP addresses. Valid values:

- `PayByBandwidth`: pay-by-bandwidth.
- `PayByTraffic`: pay-by-traffic.', example='PayByBandwidth'),
    internetMaxBandwidthOut?: long(name='internet_max_bandwidth_out', description='The maximum outbound bandwidth for a public IP address of a node. Unit: Mbit/s. Valid values: 1 to 100.', example='10'),
    keyPair?: string(name='key_pair', description='The name of the key pair. You must specify this parameter or `login_password`.

> If you create a managed node pool, only `key_pair` is supported.', example='np-key'),
    loginAsNonRoot?: boolean(name='login_as_non_root', description='Specifies whether to log on to the created ECS instances as a non-root user.'),
    loginPassword?: string(name='login_password', description='The SSH logon password. You must specify this parameter or `key_pair`. The password must be 8 to 30 characters in length and contain at least three of the following character types: uppercase letters, lowercase letters, digits, and special characters.', example='Hello1234'),
    multiAzPolicy?: string(name='multi_az_policy', description='The scaling policy for ECS instances in a multi-zone scaling group. Valid values:

- `PRIORITY`: scales ECS instances based on the priorities of vSwitches that you specify in VSwitchIds.N. If an ECS instance cannot be created in the zone of the highest-priority vSwitch, the system automatically uses the next highest-priority vSwitch to create the ECS instance.

- `COST_OPTIMIZED`: creates ECS instances based on the unit prices of vCPUs in ascending order. If the scaling configuration settings specify multiple instance types and the billing method for spot instances, the system preferentially creates the corresponding spot instances. You can use the `CompensateWithOnDemand` parameter to specify whether the system automatically creates pay-as-you-go instances when spot instances cannot be created due to insufficient resources.

  > `COST_OPTIMIZED` takes effect only when the scaling configuration settings specify multiple instance types or spot instances are selected.

- `BALANCE`: evenly distributes ECS instances across the zones specified in the scaling group. If the instances are unevenly distributed across zones due to insufficient resources, you can call the RebalanceInstances operation to balance the resources. For more information, see [RebalanceInstances](https://help.aliyun.com/document_detail/71516.html).

Default value: `PRIORITY`.', example='COST_OPTIMIZED'),
    onDemandBaseCapacity?: long(name='on_demand_base_capacity', description='The minimum number of pay-as-you-go instances required in the scaling group. Valid values: 0 to 1000. If the number of pay-as-you-go instances is less than this value, the system preferentially creates pay-as-you-go instances.', example='0'),
    onDemandPercentageAboveBaseCapacity?: long(name='on_demand_percentage_above_base_capacity', description='The percentage of pay-as-you-go instances among the extra instances that exceed the minimum number of pay-as-you-go instances specified by `on_demand_base_capacity`. Valid values: 0 to 100.', example='20'),
    period?: long(name='period', description='The subscription duration of nodes in the node pool. This parameter is required and takes effect only when `instance_charge_type` is set to `PrePaid`. When `period_unit` is set to Month, valid values of `period` are 1, 2, 3, 6, and 12.

Default value: 1.', example='0'),
    periodUnit?: string(name='period_unit', description='The subscription period of nodes in the node pool. You must specify this parameter when `instance_charge_type` is set to `PrePaid`.

`Month`: only months are supported.', example='Month'),
    platform?: string(name='platform', description='The operating system distribution. Valid values:

- `CentOS`
- `AliyunLinux`
- `Windows`
- `WindowsCore`

Default value: `AliyunLinux`.', example='AliyunLinux', deprecated=true),
    privatePoolOptions?: {
      id?: string(name='id', description='The ID of the private pool.', example='eap-bp67acfmxazb4****'),
      matchCriteria?: string(name='match_criteria', description='The type of the private pool, which specifies the capacity options of the private pool for instance startup. After an elasticity assurance or capacity reservation takes effect, a private pool is generated for you to select when you start instances. Valid values:

- `Open`: open mode. The system automatically matches an open private pool. If no matching open private pool is found, the system uses resources from the public pool.

- `Target`: targeted mode. The system uses the specified private pool to start instances. If the specified private pool is unavailable, the instances fail to start.

- `None`: no private pool. The system does not use private pools to start instances.', example='Open'),
    }(name='private_pool_options', description='The private pool options.'),
    ramRoleName?: string(name='ram_role_name', description='The name of the RAM role for worker nodes.
>Notice: Only ACK managed clusters of version 1.22 and later support configuring this parameter when you create a node pool.</notice>', example='example-role'),
    rdsInstances?: [ string ](name='rds_instances', description='The list of ApsaraDB RDS instances.'),
    resourcePoolOptions?: {
      privatePoolIds?: [ string ](name='private_pool_ids', description='The list of private pool IDs, which are the IDs of elasticity assurances or capacity reservations. You can only specify the IDs of private pools in Target mode. Valid values of N: 1 to 20.'),
      strategy?: string(name='strategy', description='The resource pool policy used to create instances. Resource pools include private pools generated after elasticity assurances or capacity reservations take effect, as well as the public pool. You can select a resource pool when you start instances. Valid values:
PrivatePoolFirst: private pools take precedence. If you select this policy and specify resource_pool_options.private_pool_ids, the specified private pools are preferentially used. If no private pool is specified or the specified private pools have insufficient capacity, the system automatically matches an open private pool. If no matching private pool is found, the system uses the public pool to create instances.
PrivatePoolOnly: only private pools are used. If you select this policy, you must specify resource_pool_options.private_pool_ids. If the specified private pools have insufficient capacity, the instances fail to start.
None: no resource pool policy is used.
Default value: None.', example='PrivatePoolFirst'),
    }(name='resource_pool_options', description='The resource pool and resource pool policy used to create instances. Take note of the following items when you configure this parameter:
This parameter takes effect only when you create pay-as-you-go instances.
This parameter cannot be configured together with private_pool_options.match_criteria or private_pool_options.id.'),
    scalingPolicy?: string(name='scaling_policy', description='The scaling group mode. Valid values:

- `release`: standard pattern. The scaling group scales instances by creating and releasing ECS instances based on the usage of the requested resources.
- `recycle`: swift pattern. The scaling group scales instances by creating, stopping, and starting ECS instances to accelerate subsequent scaling operations. When an instance is stopped, you are not charged for compute resources, but you are still charged for storage resources, except for instances with local disks.

Default value: `release`.', example='release'),
    securityGroupId?: string(name='security_group_id', description='The ID of the security group to which the node pool belongs. You must specify this parameter or `security_group_ids`. We recommend that you specify `security_group_ids`.', example='sg-2zeihch86ooz9io4****'),
    securityGroupIds?: [ string ](name='security_group_ids', description='The list of security group IDs. You must specify this parameter or `security_group_id`. We recommend that you specify `security_group_ids`. If you specify both `security_group_id` and `security_group_ids`, `security_group_ids` takes precedence.'),
    spotInstancePools?: long(name='spot_instance_pools', description='The number of active instance types. The scaling group evenly creates spot instances based on the most cost-effective instance types. Valid values: 1 to 10.', example='5'),
    spotInstanceRemedy?: boolean(name='spot_instance_remedy', description='Specifies whether to enable spot instance replenishment. After this feature is enabled, when the scaling group receives a system message indicating that a spot instance will be reclaimed, the scaling group attempts to create a new instance to replace the spot instance to be reclaimed. Valid values:

- `true`: enables spot instance replenishment.
- `false`: disables spot instance replenishment.', example='false'),
    spotPriceLimit?: [ 
      {
        instanceType?: string(name='instance_type', description='The instance type of the spot instance.', example='ecs.c6.large'),
        priceLimit?: string(name='price_limit', description='The maximum price for a single instance.', example='0.39'),
      }
    ](name='spot_price_limit', description='The maximum price configuration for a single spot instance of a specific instance type in the current marketplace.'),
    spotStrategy?: string(name='spot_strategy', description='The type of spot instance. Valid values:
- NoSpot: non-spot instance.
- SpotWithPriceLimit: spot instance with a maximum price.
- SpotAsPriceGo: spot instance whose price is automatically set by the system based on the current market price.

For more information, see [Spot instances](https://help.aliyun.com/document_detail/157759.html).', example='NoSpot'),
    systemDiskBurstingEnabled?: boolean(name='system_disk_bursting_enabled', description='Specifies whether to enable bursting for the system disk of the node. Valid values:

- true: yes.
- false: no.

This parameter is supported only when `SystemDiskCategory` is set to `cloud_auto`. For more information, see [ESSD AutoPL cloud disks](https://help.aliyun.com/document_detail/368372.html).', example='true'),
    systemDiskCategories?: [ string ](name='system_disk_categories', description='The categories of the system disk. If the system disk cannot be created by using the disk category with the highest priority, the system automatically tries the next disk category. Valid values:

- cloud: basic cloud disk.
- cloud_efficiency: ultra disk.
- cloud_ssd: standard SSD.
- cloud_essd: ESSD.'),
    systemDiskCategory?: string(name='system_disk_category', description='The category of the system disk. Valid values:

- `cloud_efficiency`: ultra disk.
- `cloud_ssd`: standard SSD.
- `cloud_essd`: ESSD.
- `cloud_auto`: ESSD AutoPL cloud disk.
- `cloud_essd_entry`: ESSD Entry disk.

Default value: `cloud_efficiency`.', example='cloud_efficiency'),
    systemDiskEncryptAlgorithm?: string(name='system_disk_encrypt_algorithm', description='The encryption algorithm used for the system disk. Valid value: aes-256.', example='aes-256'),
    systemDiskEncrypted?: boolean(name='system_disk_encrypted', description='Specifies whether to encrypt the system disk. Valid values:
- true: encrypts the system disk.
- false: does not encrypt the system disk.'),
    systemDiskKmsKeyId?: string(name='system_disk_kms_key_id', description='The ID of the KMS key used for the system disk.', example='0e478b7a-4262-4802-b8cb-00d3fb40****'),
    systemDiskPerformanceLevel?: string(name='system_disk_performance_level', description='The performance level of the system disk. This parameter takes effect only for ESSDs. Valid values:

- PL0: delivers medium maximum concurrent I/O performance and relatively stable read/write latency.
- PL1: delivers medium maximum concurrent I/O performance and relatively stable read/write latency.
- PL2: delivers high maximum concurrent I/O performance and stable read/write latency.
- PL3: delivers ultra-high maximum concurrent I/O performance and extremely stable read/write latency.', example='PL1'),
    systemDiskProvisionedIops?: long(name='system_disk_provisioned_iops', description='The provisioned read and write IOPS for the system cloud disk of the node. Valid values: 0 to min{50,000, 1000 × Capacity - Baseline performance}. Baseline performance = min{1,800 + 50 × Capacity, 50,000}. This parameter is supported only when `SystemDiskCategory` is set to `cloud_auto`. For more information, see [ESSD AutoPL cloud disks](https://help.aliyun.com/document_detail/368372.html).', example='1000'),
    systemDiskSize?: long(name='system_disk_size', description='The size of the system cloud disk for the node. Unit: GiB. Valid values: 40 to 500.', example='120'),
    tags?: [ 
      {
        key?: string(name='key', description='The tag key.', example='key'),
        value?: string(name='value', description='The tag value.', example='value'),
      }
    ](name='tags', description='The tags to add to ECS instances only. Tag keys must be unique and can be up to 128 characters in length. Neither tag keys nor tag values can start with "aliyun" or "acs:", or contain "https://" or "http://".'),
    vswitchIds?: [ string ](name='vswitch_ids', description='The vSwitch IDs.

This parameter is required.'),
  }(name='scaling_group', description='The scaling group configuration of the node pool.'),
  teeConfig?: {
    teeEnable?: boolean(name='tee_enable', description='Specifies whether the node pool is a confidential computing node pool.

This parameter is required.', example='false'),
  }(name='tee_config', description='The configuration of the confidential computing node pool.'),
}

model Runtime {
  name?: string(name='name', description='Specifies the container runtime. Valid values:

- `containerd`: Recommended. Supported in version 1.20 and later.
- `Sandboxed-Container.runv`: Sandboxed container that provides higher isolation. Supported in version 1.16 and later.
- `docker`: Supported in clusters of version 1.22 and earlier.

Default value: `containerd`.', example='containerd'),
  version?: string(name='version', description='The container runtime version. By default, the latest version is used. For more information about the release notes, see [Container runtime release notes](https://help.aliyun.com/document_detail/207829.html).', example='1.6.20'),
}

model Tag {
  key?: string(name='key', description='The tag `key`.', example='env'),
  value?: string(name='value', description='The tag `value`.', example='prod'),
}

model Taint {
  effect?: string(name='effect', description='The scheduling policy. Valid values:

- `NoSchedule`: Not tolerated. This affects only the scheduling process. Already scheduled pods are not affected. This applies only to newly added pods.

- `NoExecute`: Not tolerated. When the taint changes, the pod is evicted.

- `PreferNoSchedule`: Soft constraint. Existing pods on the node are not affected. The scheduler tries to avoid scheduling pods that do not tolerate the taint to the node.

Default value: `NoSchedule`.', example='NoSchedule'),
  key?: string(name='key', description='The key of the taint.', example='key'),
  value?: string(name='value', description='The value of the taint.', example='value'),
}

model StandardComponentsValue = {
  name?: string(name='name', description='The name of the component.', example='ack-arena'),
  version?: string(name='version', description='The version of the component.', example='0.5.0'),
  description?: string(name='description', description='The description of the component features.', example='***'),
  required?: string(name='required', description='Specifies whether the component is required for the cluster. Valid values:

- true: The component is required and must be installed when the cluster is created.

- false: The component is not required. You can install it in the Components module after the cluster is created.', example='false'),
  disabled?: boolean(name='disabled', description='Specifies whether to disable the default installation of the component. When a cluster is created, components required for the cluster are installed. In addition, some components related to logs or routing, such as Ingress, are installed by default. If you do not want to install these components by default, you can set this parameter to disable the default installation. Valid values:

- true: disables the default installation.
- false: enables the default installation.', example='false'),
}

model QuotasValue = {
  quota?: string(name='quota', description='The quota value. If the quota is exceeded, [submit an application in Quota Center](https://quotas.console.aliyun.com/products/csk/quotas) to increase the quota.', example='1'),
  operationCode?: string(name='operation_code', description='The quota code.', example='q_Kubernetes_Cluster'),
  adjustable?: boolean(name='adjustable', description='Indicates whether the quota can be adjusted.', example='true'),
  unit?: string(name='unit', description='The unit.', example='Cluster'),
}

model AttachInstancesRequest {
  cpuPolicy?: string(name='cpu_policy', description='The CPU management policy for the node. The following two policies are supported when the cluster version is 1.12.6 or later:

- `static`: allows you to enhance CPU affinity and exclusivity for pods with specific resource characteristics on the node.
- `none`: uses the existing default CPU affinity policy.

Default value: `none`.

> This parameter is not supported if nodepool_id is specified.', example='none'),
  formatDisk?: boolean(name='format_disk', description='Specifies whether to store container data and images on a data cloud disk. Valid values:

- `true`: stores container data and images on a data cloud disk.
- `false`: does not store container data and images on a data cloud disk.

Default value: `false`.

Data cloud disk mounting rules:

- If the ECS instance has data cloud disks attached and the file system of the last data cloud disk is not initialized, the system automatically formats the data cloud disk to EXT4 to store the /var/lib/docker and /var/lib/kubelet directories, which are the default data directories for the Docker container runtime and kubelet component.
- If the ECS instance does not have data cloud disks attached, no new data cloud disk is attached.
> If you choose to store data on a data cloud disk and the ECS instance already has data cloud disks attached, the existing data on the data cloud disks will be lost. Back up your data first.', example='false'),
  imageId?: string(name='image_id', description='The custom image ID.

- If you specify a custom image ID, the system cloud disk image of the instance is replaced with the custom image.
- If you do not specify this parameter, the default system image is used.

> This parameter is not supported if nodepool_id is specified.', example='aliyun_2_1903_x64_20G_alibase_20200529.vhd'),
  instances?: [ string ](name='instances', description='The list of ECS instances to be added.

This parameter is required.'),
  isEdgeWorker?: boolean(name='is_edge_worker', description='Specifies whether the node to be added is an edge node, namely an ENS node. Valid values:

- `true`: The node to be added is an edge node.
- `false`: The node to be added is not an edge node.

Default value: `false`.

> If the node is an edge node, you must set this parameter to `true` to identify the node type as an ENS node.', example='false'),
  keepInstanceName?: boolean(name='keep_instance_name', description='Specifies whether to retain the original instance name. Valid values:

- `true`: retains the instance name.
- `false`: does not retain the instance name.

Default value: `false`.', example='false'),
  keyPair?: string(name='key_pair', description='The name of the key pair for the instances to be added. You can specify either the key_pair or password parameter, or leave both empty.
> This parameter is not supported if nodepool_id is specified.', example='security-key'),
  nodepoolId?: string(name='nodepool_id', description='The node pool ID. If you do not specify this parameter, the node is added to the default node pool.', example='np615c0e0966124216a0412e10afe0****'),
  password?: string(name='password', description='The SSH logon password for the instances to be added. You can specify either the key_pair or password parameter, or leave both empty.

The password must meet the following requirements:
- The password must be 8 to 30 characters in length.
- The password must contain uppercase letters, lowercase letters, digits, and special characters.
- The password cannot contain backslashes (\\\\) or double quotation marks (").

For security purposes, the password is encrypted during transmission.', example='Hello1234'),
  rdsInstances?: [ string ](name='rds_instances', description='The list of ApsaraDB RDS instances.'),
  runtime?: Runtime(name='runtime', description='The container runtime.
> This parameter is not supported if nodepool_id is specified.

name: the name of the container runtime. ACK supports the following three container runtimes:

- containerd: recommended. Supported by all cluster versions.
- Sandboxed-Container.runv: sandboxed container. Provides higher isolation. Supported by clusters runtime version 1.24 and earlier.
- docker: supported by clusters runtime version 1.22 and earlier.

Default value: containerd.

containerd: the version of the container runtime. The default value is the latest version.

For more information about the changes to the sandboxed container runtime, see [Sandboxed container runtime release notes](https://help.aliyun.com/document_detail/160312.html).'),
  tags?: [
    Tag
  ](name='tags', description='The node labels. Label definition rules:

- A label is a case-sensitive key-value pair. You can configure up to 20 labels.
- Label keys must be unique and can be up to 64 characters in length.
- Label values can be empty and can be up to 128 characters in length.
- Label keys and values cannot start with `aliyun`, `acs:`, `https://`, or `http://`.

For more information, see [Labels and Selectors](https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/#syntax-and-character-set).
> This parameter is not supported if nodepool_id is specified.'),
  userData?: string(name='user_data', description='The custom data for the node. For more information, see [Generate instance user data](https://help.aliyun.com/document_detail/49121.html).

> This parameter is not supported if nodepool_id is specified.', example='IyEvdXNyL2Jpbi9iYXNoCmVjaG8gIkhlbGxvIEFDSyEi'),
}

model AttachInstancesResponseBody = {
  list?: [ 
    {
      code?: string(name='code', description='The status code of the node addition result.', example='200'),
      instanceId?: string(name='instanceId', description='The ECS instance ID.', example='i-2ze0lgm3y6iylcbt****'),
      message?: string(name='message', description='The description of the node addition result.', example='successful'),
