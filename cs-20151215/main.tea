  regionId?: string(name='region_id', description='The ID of the region where the cluster is deployed. For details, see [Regions supported by container service](https://help.aliyun.com/document_detail/216938.html).

This parameter is required.', example='cn-beijing'),
  resourceGroupId?: string(name='resource_group_id', description='The ID of the resource group to which the cluster belongs. Use this parameter to isolate different resources.', example='rg-acfm3mkrure****'),
  rrsaConfig?: {
    enabled?: boolean(name='enabled', description='Specifies whether to enable the RRSA feature.

- true: Enabled.

- false: Not enabled.', example='true'),
