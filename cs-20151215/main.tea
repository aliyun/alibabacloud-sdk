    regionId?: string(name='region_id', description='The region ID.', example='cn-beijing'),
    resourceGroupId?: string(name='resource_group_id', description='The resource group ID.', example='rg-acfmyvw3wjmb****'),
    type?: string(name='type', description='The node pool type. Valid values:
- `ess`: standard node pool (includes managed and automatic scaling features).
- `edge`: edge node pool.
- `lingjun`: Lingjun node pool.', example='ess'),
    updated?: string(name='updated', description='The time when the node pool was updated.', example='2025-04-15T15:39:45.41+08:00'),
  }(name='nodepool_info', description='The node pool configuration.'),
  scalingGroup?: {
    autoRenew?: boolean(name='auto_renew', description='Specifies whether auto-renewal is enabled for nodes. This parameter takes effect only when `instance_charge_type` is set to `PrePaid`. Valid values:
