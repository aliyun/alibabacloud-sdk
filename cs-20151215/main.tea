        periodUnit?: string(name='period_unit', description='The billing cycle of the node. This parameter is required when instance_charge_type is set to PrePaid. Valid values:
- `Month`: uses month as the billing unit.
- `Week`: uses week as the billing unit.', example='Month'),
        platform?: string(name='platform', description='**[Deprecated]** The operating system distribution. Valid values:
