    scalingPolicy?: string(name='scaling_policy', description='The scaling group mode. Valid values:
- release: Standard mode. Instances are scaled by creating and releasing ECS instances based on the requested resource usage.
- recycle: Swift mode. Instances are scaled by creating, stopping, and starting instances to improve the speed of subsequent scaling operations. When an instance is stopped, you are not charged for compute resources, but you are still charged for storage resources, except for instances with local disks.
Default value: release.', example='release'),
    securityGroupId?: string(name='security_group_id', description='The security group ID of the node pool. You can specify this parameter or security_group_ids. We recommend that you use security_group_ids.', example='sg-wz9a8g2mt6x5llu0****', deprecated='true'),
    securityGroupIds?: [ string ](name='security_group_ids', description='The list of security group IDs. You can specify this parameter or security_group_id. We recommend that you use security_group_ids. If you specify both security_group_id and security_group_ids, security_group_ids takes precedence.'),
    securityHardeningOs?: boolean(name='security_hardening_os', description='Specifies whether to enable Alibaba Cloud OS security hardening. Valid values:
- true: enables Alibaba Cloud OS security hardening.
- false: does not enable Alibaba Cloud OS security hardening.
Default value: false.', example='false'),
    socEnabled?: boolean(name='soc_enabled', description='Specifies whether to enable MLPS 2.0 security hardening. You can enable this feature for nodes only when the system image is Alibaba Cloud Linux 2 or Alibaba Cloud Linux 3. Alibaba Cloud provides classified protection compliance baseline check standards and scanning programs for Alibaba Cloud Linux 2 and Alibaba Cloud Linux 3 MLPS 2.0 Level 3 images.', example='false'),
    spotInstancePools?: long(name='spot_instance_pools', description='The number of available instance types. The scaling group evenly creates spot instances across multiple instance types with the lowest costs. Valid values: 1 to 10.', example='5'),
    spotInstanceRemedy?: boolean(name='spot_instance_remedy', description='Specifies whether to enable spot instance replenishment. After this feature is enabled, when the scaling group receives a system message that a spot instance is to be reclaimed, the scaling group attempts to create a new instance to replace the spot instance to be reclaimed. Valid values:
