> If you create a managed node pool, only key_pair is supported.', example='np-key'),
    loginAsNonRoot?: boolean(name='login_as_non_root', description='Specifies whether to log on to the created ECS instances as a non-root user.'),
    loginPassword?: string(name='login_password', description='The SSH logon password. You must specify this parameter or key_pair. The password must be 8 to 30 characters in length and must contain at least three of the following character types: uppercase letters, lowercase letters, digits, and special characters.', example='Hello1234'),
    multiAzPolicy?: string(name='multi_az_policy', description='The multi-zone scaling policy for ECS instances in the scaling group. Valid values:

- PRIORITY: Scales based on the vSwitches (VSwitchIds.N) you define. If an ECS instance cannot be created in the zone of a higher-priority vSwitch, the system automatically uses the next-priority vSwitch to create the ECS instance.

- COST_OPTIMIZED: Tries to create instances in ascending order of vCPU unit price. If the scaling configuration specifies the spot billing method for multiple instance types, the system preferentially creates spot instances. You can use the CompensateWithOnDemand parameter to specify whether to automatically try to create pay-as-you-go instances when spot instances cannot be created due to insufficient inventory or other reasons.

  > COST_OPTIMIZED takes effect only when the scaling configuration specifies multiple instance types or uses spot instances.

- BALANCE: Evenly allocates ECS instances across the zones specified in the scaling group. If the instances are unevenly distributed across zones due to insufficient inventory or other reasons, you can call the RebalanceInstances API operation to balance the resources. For more information, see [RebalanceInstances](https://help.aliyun.com/document_detail/71516.html).

Default value: PRIORITY.', example='COST_OPTIMIZED'),
    onDemandBaseCapacity?: long(name='on_demand_base_capacity', description='The minimum number of pay-as-you-go instances required by the scaling group. Valid values: 0 to 1000. If the number of pay-as-you-go instances is less than this value, the system preferentially creates pay-as-you-go instances.', example='0'),
    onDemandPercentageAboveBaseCapacity?: long(name='on_demand_percentage_above_base_capacity', description='The percentage of pay-as-you-go instances among the excess instances after the scaling group meets the minimum number of pay-as-you-go instances (on_demand_base_capacity). Valid values: 0 to 100.', example='20'),
    period?: long(name='period', description='The subscription duration for the nodes in the node pool. This parameter takes effect and is required only when instance_charge_type is set to `PrePaid`. When period_unit is set to `Month`, valid values are 1, 2, 3, 6, and 12.

Default value: 1.', example='0'),
    periodUnit?: string(name='period_unit', description='The subscription period unit for the nodes in the node pool. This parameter is required when instance_charge_type is set to `PrePaid`.

`Month`: Currently, only month is supported.', example='Month'),
    platform?: string(name='platform', description='The operating system distribution. Valid values:

- `CentOS`
- `AliyunLinux`
- `Windows`
- `WindowsCore`

Default value: `AliyunLinux`.', example='AliyunLinux', deprecated='true'),
    privatePoolOptions?: {
      id?: string(name='id', description='The ID of the private pool.', example='eap-bp67acfmxazb4****'),
      matchCriteria?: string(name='match_criteria', description='The match criteria for the private pool. This parameter specifies the private pool capacity option for instance startup. After an elasticity assurance or capacity reservation takes effect, a private pool is generated for you to select when you start an instance. Valid values:

- Open: Open mode. The system automatically matches an open private pool. If no eligible private pool is available, the system uses the public pool to start the instance.

- Target: Target mode. The system uses the specified private pool to start the instance. If the specified private pool is unavailable, the instance fails to start.

- None: None mode. The system does not use a private pool to start the instance.', example='Open'),
    }(name='private_pool_options', description='The private pool options.'),
    ramRoleName?: string(name='ram_role_name', description='The name of the worker RAM role.
>Notice: This parameter is supported only when you create a node pool in an ACK managed cluster of Kubernetes 1.22 or later.</notice>', example='example-role'),
    rdsInstances?: [ string ](name='rds_instances', description='The list of ApsaraDB RDS instances.'),
    resourcePoolOptions?: {
      privatePoolIds?: [ string ](name='private_pool_ids', description='The list of private pool IDs, which are the IDs of elasticity assurances or capacity reservations. You can specify only the IDs of private pools in Target mode. Valid values of N: 1 to 20.'),
      strategy?: string(name='strategy', description='The resource pool strategy for instance creation. Resource pools include private pools generated after an elasticity assurance or capacity reservation takes effect, as well as the public pool. You can select a resource pool when you start an instance. Valid values:
PrivatePoolFirst: Uses the private pool first. If you select this strategy and specify resource_pool_options.private_pool_ids, the system preferentially uses the specified private pools. If no private pool is specified or the specified private pools have insufficient capacity, the system automatically matches an open private pool. If no eligible private pool is available, the system uses the public pool to create the instance.
PrivatePoolOnly: Uses only the private pool. If you select this strategy, you must specify resource_pool_options.private_pool_ids. If the specified private pools have insufficient capacity, the instance fails to start.
None: Does not use a resource pool strategy.
Default value: None.', example='PrivatePoolFirst'),
    }(name='resource_pool_options', description='The resource pool and resource pool strategy for instance creation. When you configure this parameter, note the following items:
This parameter takes effect only when you create pay-as-you-go instances.
This parameter cannot be configured at the same time as private_pool_options.match_criteria and private_pool_options.id.'),
    scalingPolicy?: string(name='scaling_policy', description='The scaling group mode. Valid values:

- release: Standard mode. Scales by creating and releasing ECS instances based on the requested resource usage.
- recycle: Swift mode. Scales by creating, stopping, and starting instances to improve scaling speed. When an instance is stopped, you are not charged for compute resources, but you are still charged for storage resources, except for instances with local disks.

Default value: release.', example='release'),
    securityGroupId?: string(name='security_group_id', description='The ID of the security group for the node pool. Specify either this parameter or security_group_ids. The security_group_ids parameter is recommended.', example='sg-2zeihch86ooz9io4****'),
    securityGroupIds?: [ string ](name='security_group_ids', description='The list of security group IDs. Specify either this parameter or security_group_id. The security_group_ids parameter is recommended. If both security_group_id and security_group_ids are specified, security_group_ids takes precedence.'),
    spotInstancePools?: long(name='spot_instance_pools', description='The number of available instance types. The scaling group evenly creates spot instances based on the most cost-effective instance types. Valid values: 1 to 10.', example='5'),
    spotInstanceRemedy?: boolean(name='spot_instance_remedy', description='Specifies whether to enable spot instance replenishment. After this feature is enabled, when the scaling group receives a system message that a spot instance will be reclaimed, the scaling group tries to create a new instance to replace the spot instance to be reclaimed. Valid values:

- true: Enables spot instance replenishment.
- false: Disables spot instance replenishment.', example='false'),
    spotPriceLimit?: [ 
      {
        instanceType?: string(name='instance_type', description='The spot instance type.', example='ecs.c6.large'),
        priceLimit?: string(name='price_limit', description='The maximum price for a single instance.', example='0.39'),
      }
    ](name='spot_price_limit', description='The market price range configuration for a single spot instance type.'),
    spotStrategy?: string(name='spot_strategy', description='The spot instance type. Valid values:
- NoSpot: Pay-as-you-go instance.
- SpotWithPriceLimit: Sets the maximum price for spot instances.
- SpotAsPriceGo: The system automatically bids based on the current market price.

For more information, see [Spot instances](https://help.aliyun.com/document_detail/157759.html).', example='NoSpot'),
    systemDiskBurstingEnabled?: boolean(name='system_disk_bursting_enabled', description='Specifies whether to enable burst for the system cloud disk. Valid values:

- true: Enables burst.
- false: Disables burst.

This parameter is supported only when SystemDiskCategory is set to cloud_auto. For more information, see [ESSD AutoPL disks](https://help.aliyun.com/document_detail/368372.html).', example='true'),
    systemDiskCategories?: [ string ](name='system_disk_categories', description='The multiple system cloud disk types. If a high-priority disk type is unavailable, the system automatically tries the next priority disk type to create the system cloud disk. Valid values:

- cloud: basic disk.
- cloud_efficiency: ultra disk.
- cloud_ssd: standard SSD.
- cloud_essd: ESSD.'),
    systemDiskCategory?: string(name='system_disk_category', description='The system cloud disk type of the node. Valid values:

- cloud_efficiency: ultra disk.
- cloud_ssd: standard SSD.
- cloud_essd: ESSD.
- cloud_auto: ESSD AutoPL disk.
- cloud_essd_entry: ESSD Entry disk.

Default value: cloud_efficiency.', example='cloud_efficiency'),
    systemDiskEncryptAlgorithm?: string(name='system_disk_encrypt_algorithm', description='The encryption algorithm used for the system cloud disk. Valid value: aes-256.', example='aes-256'),
    systemDiskEncrypted?: boolean(name='system_disk_encrypted', description='Specifies whether to encrypt the system cloud disk. Valid values:
- true: Encrypts the system cloud disk.
- false: Does not encrypt the system cloud disk.'),
    systemDiskKmsKeyId?: string(name='system_disk_kms_key_id', description='The ID of the KMS key used for the system cloud disk.', example='0e478b7a-4262-4802-b8cb-00d3fb40****'),
    systemDiskPerformanceLevel?: string(name='system_disk_performance_level', description='The performance level of the system cloud disk. This parameter takes effect only for ESSDs. Valid values:

- PL0: Delivers medium concurrent I/O performance and relatively stable read/write latency.
- PL1: Delivers medium concurrent I/O performance and relatively stable read/write latency.
- PL2: Delivers high concurrent I/O performance and stable read/write latency.
- PL3: Delivers ultra-high concurrent I/O performance and highly stable read/write latency.', example='PL1'),
    systemDiskProvisionedIops?: long(name='system_disk_provisioned_iops', description='The provisioned read/write IOPS for the system cloud disk. Valid values: 0 to min{50,000, 1000 × Capacity - Baseline performance}. Baseline performance = min{1,800 + 50 × Capacity, 50,000}.

This parameter is supported only when SystemDiskCategory is set to cloud_auto. For more information, see [ESSD AutoPL disks](https://help.aliyun.com/document_detail/368372.html).', example='1000'),
    systemDiskSize?: long(name='system_disk_size', description='The size of the system cloud disk. Unit: GiB.

Valid values: 40 to 500.', example='120'),
    tags?: [ 
      {
        key?: string(name='key', description='The tag key.', example='key'),
        value?: string(name='value', description='The tag value.', example='value'),
      }
    ](name='tags', description='Adds tags only to ECS instances.

Tag keys must be unique and can be up to 128 characters in length. Neither tag keys nor tag values can start with "aliyun" or "acs:", or contain "https://" or "http://".'),
    vswitchIds: [ string ](name='vswitch_ids', description='The vSwitch IDs.

This parameter is required.'),
  }(name='scaling_group', description='The scaling group configuration of the node pool.'),
  teeConfig?: {
    teeEnable: boolean(name='tee_enable', description='Specifies whether the node pool is a confidential computing node pool.

This parameter is required.', example='false'),
  }(name='tee_config', description='The confidential computing node pool configuration.'),
}

model Runtime {
  name?: string(name='name', description='Specifies the container runtime. Valid values:

- `containerd`: Recommended. Supported in version 1.20 and later.
- `Sandboxed-Container.runv`: Sandboxed container that provides higher isolation. Supported in version 1.16 and later.
- `docker`: Supported in clusters of version 1.22 and earlier.

Default value: `containerd`.', example='containerd'),
  version?: string(name='version', description='The container runtime version. By default, the latest version is used. For more information about the release notes, see [Container runtime release notes](https://help.aliyun.com/document_detail/207829.html).', example='1.6.20'),
}

model Tag {
  key?: string(name='key', description='The tag `key`.', example='env'),
  value?: string(name='value', description='The tag `value`.', example='prod'),
}

model Taint {
  effect?: string(name='effect', description='The scheduling policy. Valid values:

- `NoSchedule`: Not tolerated. This affects only the scheduling process. Already scheduled pods are not affected. This applies only to newly added pods.

- `NoExecute`: Not tolerated. When the taint changes, the pod is evicted.

- `PreferNoSchedule`: Soft constraint. Existing pods on the node are not affected. The scheduler tries to avoid scheduling pods that do not tolerate the taint to the node.

Default value: `NoSchedule`.', example='NoSchedule'),
  key?: string(name='key', description='The key of the taint.', example='key'),
  value?: string(name='value', description='The value of the taint.', example='value'),
}

model AttachInstancesRequest {
  clusterId: string(name='ClusterId', description='The cluster ID.

This parameter is required.', example='c106f377e16f34eb1808d6b9362c9****', position='Path'),
  cpuPolicy?: string(name='cpu_policy', description='The CPU management policy for the node. The following two policies are supported when the cluster version is 1.12.6 or later:

- `static`: allows you to enhance CPU affinity and exclusivity for pods with specific resource characteristics on the node.
- `none`: uses the existing default CPU affinity policy.

Default value: `none`.

> This parameter is not supported if nodepool_id is specified.', example='none', position='Body'),
  formatDisk?: boolean(name='format_disk', description='Specifies whether to store container data and images on a data cloud disk. Valid values:

- `true`: stores container data and images on a data cloud disk.
- `false`: does not store container data and images on a data cloud disk.

Default value: `false`.

Data cloud disk mounting rules:

- If the ECS instance has data cloud disks attached and the file system of the last data cloud disk is not initialized, the system automatically formats the data cloud disk to EXT4 to store the /var/lib/docker and /var/lib/kubelet directories, which are the default data directories for the Docker container runtime and kubelet component.
- If the ECS instance does not have data cloud disks attached, no new data cloud disk is attached.
> If you choose to store data on a data cloud disk and the ECS instance already has data cloud disks attached, the existing data on the data cloud disks will be lost. Back up your data first.', example='false', position='Body'),
  imageId?: string(name='image_id', description='The custom image ID.

- If you specify a custom image ID, the system cloud disk image of the instance is replaced with the custom image.
- If you do not specify this parameter, the default system image is used.

> This parameter is not supported if nodepool_id is specified.', example='aliyun_2_1903_x64_20G_alibase_20200529.vhd', position='Body'),
  instances: [ string ](name='instances', description='The list of ECS instances to be added.

This parameter is required.', position='Body'),
  isEdgeWorker?: boolean(name='is_edge_worker', description='Specifies whether the node to be added is an edge node, namely an ENS node. Valid values:

- `true`: The node to be added is an edge node.
- `false`: The node to be added is not an edge node.

Default value: `false`.

> If the node is an edge node, you must set this parameter to `true` to identify the node type as an ENS node.', example='false', position='Body'),
  keepInstanceName?: boolean(name='keep_instance_name', description='Specifies whether to retain the original instance name. Valid values:

- `true`: retains the instance name.
- `false`: does not retain the instance name.

Default value: `false`.', example='false', position='Body'),
  keyPair?: string(name='key_pair', description='The name of the key pair for the instances to be added. You can specify either the key_pair or password parameter, or leave both empty.
> This parameter is not supported if nodepool_id is specified.', example='security-key', position='Body'),
  nodepoolId?: string(name='nodepool_id', description='The node pool ID. If you do not specify this parameter, the node is added to the default node pool.', example='np615c0e0966124216a0412e10afe0****', position='Body'),
  password?: string(name='password', description='The SSH logon password for the instances to be added. You can specify either the key_pair or password parameter, or leave both empty.

The password must meet the following requirements:
- The password must be 8 to 30 characters in length.
- The password must contain uppercase letters, lowercase letters, digits, and special characters.
- The password cannot contain backslashes (\\\\) or double quotation marks (").

For security purposes, the password is encrypted during transmission.', example='Hello1234', position='Body'),
  rdsInstances?: [ string ](name='rds_instances', description='The list of ApsaraDB RDS instances.', position='Body'),
  runtime?: Runtime(name='runtime', description='The container runtime.
> This parameter is not supported if nodepool_id is specified.

name: the name of the container runtime. ACK supports the following three container runtimes:

- containerd: recommended. Supported by all cluster versions.
- Sandboxed-Container.runv: sandboxed container. Provides higher isolation. Supported by clusters runtime version 1.24 and earlier.
- docker: supported by clusters runtime version 1.22 and earlier.

Default value: containerd.

containerd: the version of the container runtime. The default value is the latest version.

For more information about the changes to the sandboxed container runtime, see [Sandboxed container runtime release notes](https://help.aliyun.com/document_detail/160312.html).', position='Body'),
  tags?: [
    Tag
  ](name='tags', description='The node labels. Label definition rules:

- A label is a case-sensitive key-value pair. You can configure up to 20 labels.
- Label keys must be unique and can be up to 64 characters in length.
- Label values can be empty and can be up to 128 characters in length.
- Label keys and values cannot start with `aliyun`, `acs:`, `https://`, or `http://`.

For more information, see [Labels and Selectors](https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/#syntax-and-character-set).
> This parameter is not supported if nodepool_id is specified.', position='Body'),
  userData?: string(name='user_data', description='The custom data for the node. For more information, see [Generate instance user data](https://help.aliyun.com/document_detail/49121.html).

> This parameter is not supported if nodepool_id is specified.', example='IyEvdXNyL2Jpbi9iYXNoCmVjaG8gIkhlbGxvIEFDSyEi', position='Body'),
}

model AttachInstancesResponseBody = {
  list?: [ 
    {
      code?: string(name='code', description='The status code of the node addition result.', example='200'),
      instanceId?: string(name='instanceId', description='The ECS instance ID.', example='i-2ze0lgm3y6iylcbt****'),
      message?: string(name='message', description='The description of the node addition result.', example='successful'),
    }
  ](name='list', description='The list of node addition information.'),
  taskId?: string(name='task_id', description='The task ID.', example='T-5a544aff80282e39ea00****'),
}

model AttachInstancesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachInstancesResponseBody(name='body'),
}

/**
  * @description Read [Limits](https://help.aliyun.com/document_detail/86919.html) before calling this operation to ensure that the ECS instances to be added meet the requirements.
  * @param request  the request parameters of AttachInstances  AttachInstancesRequest
  * @return AttachInstancesResponse
 */
async function attachInstances(request: AttachInstancesRequest): AttachInstancesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AttachInstances', 'POST', '/clusters/{ClusterId}/attach', 'json', false, 'json', request);
}

model AttachInstancesToNodePoolRequest {
