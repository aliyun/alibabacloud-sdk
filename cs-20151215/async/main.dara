model CreateClusterNodePoolRequest {
  clusterId: string(name='ClusterId', description='The cluster ID.

This parameter is required.', example='c61da77e8bfbc4c4c999af2b51b65****', position='Path'),
  autoMode?: {
    enable?: boolean(name='enable', description='Specifies whether to enable auto mode. Valid values:
- true: enables auto mode. This value is valid only when auto mode is enabled for the cluster.
- false: disables auto mode.', example='true'),
  }(name='auto_mode', description='The auto mode configuration of the node pool.', position='Body'),
  autoScaling?: {
    eipBandwidth?: long(name='eip_bandwidth', description='**[Deprecated]** Use internet_charge_type and internet_max_bandwidth_out instead. The peak bandwidth of the EIP. Unit: Mbit/s.', example='null', deprecated='true'),
    eipInternetChargeType?: string(name='eip_internet_charge_type', description='**[Deprecated]** Use internet_charge_type and internet_max_bandwidth_out instead. The billing method of the EIP. Valid values:
- PayByBandwidth: pay-by-bandwidth.
- PayByTraffic: pay-by-data-transfer.
Default value: PayByBandwidth.', example='null', deprecated='true'),
    enable?: boolean(name='enable', description='Specifies whether to enable auto scaling. Valid values:
- true: enables auto scaling for the node pool. When the capacity planning of the cluster cannot meet the scheduling requirements of application pods, ACK automatically scales the node resources based on the configured minimum and maximum numbers of instances. For clusters running Kubernetes 1.24 or later, instant node elasticity is enabled by default. For clusters running Kubernetes versions earlier than 1.24, node auto scaling is enabled by default. For more information, see [Node auto scaling](https://help.aliyun.com/document_detail/2746785.html).
- false: disables auto scaling. ACK adjusts the number of nodes in the node pool based on the configured expected number of nodes and always maintains the number of nodes at the expected value.
When this parameter is set to false, other configuration parameters in auto_scaling do not take effect.
Default value: false.', example='false'),
    isBondEip?: boolean(name='is_bond_eip', description='**[Deprecated]** Use internet_charge_type and internet_max_bandwidth_out instead. Specifies whether to bind an EIP. Valid values:
- true: binds an EIP.
- false: does not bind an EIP.
Default value: false.', example='null', deprecated='true'),
    maxInstances?: long(name='max_instances', description='The maximum number of scalable instances in the node pool, excluding existing instances. This parameter takes effect only when enable is set to true.
Valid values: [min_instances, 2000]. Default value: 0.', example='10'),
    minInstances?: long(name='min_instances', description='The minimum number of scalable instances in the node pool, excluding your existing instances. This parameter takes effect only when `enable=true`.

Valid values: [0, max_instances]. Default value: 0.

> - If the minimum number of instances is not 0, the automatic creation of the corresponding number of ECS instances is triggered after the scaling group takes effect.
> - We recommend that you set the maximum number of instances to a value no less than the current number of nodes in the node pool. Otherwise, the nodes in the node pool are scaled in immediately after the elastic scaling feature takes effect.', example='1'),
    type?: string(name='type', description='The instance type for elastic scaling. This parameter takes effect only when `enable=true`. Valid values:

- `cpu`: regular instance.

- `gpu`: GPU-accelerated instance.

- `gpushare`: shared GPU instance.

- `spot`: spot instance.

Default value: `cpu`.
>Notice: This field cannot be modified after the node pool is created.</notice>', example='cpu'),
  }(name='auto_scaling', description='The elastic scaling configuration.', position='Body'),
  count?: long(name='count', description='**[Deprecated]** Use desired_size instead. The number of nodes in the node pool.', example='null', deprecated='true', position='Body'),
  efloNodeGroup?: {
    autoAttachEnabled?: boolean(name='auto_attach_enabled', description='Specifies whether to enable automatic addition to the Lingjun node pool.'),
    clusterId?: string(name='cluster_id', description='The ID of the Lingjun cluster to associate when you create the Lingjun node pool.', example='i1169130516633730****'),
    groupId?: string(name='group_id', description='The ID of the Lingjun group in the Lingjun cluster to associate when you create the Lingjun node pool.', example='ng-ec3c96ff0aa****'),
    workerRamRoleName?: string(name='worker_ram_role_name', description='The worker RAM role used by the Lingjun node pool.'),
  }(name='eflo_node_group', description='The Lingjun node pool configuration.', position='Body'),
  hostNetwork?: boolean(name='host_network', description='Specifies whether pods in the edge node pool use the host network mode. Valid values:
- true: host network. Pods directly use the network stack of the host and share the IP address and ports with the host.
- false: container network. Pods have independent network stacks and do not occupy the network ports of the host.', example='true', position='Body'),
  interconnectConfig?: {
    bandwidth?: long(name='bandwidth', description='**[Deprecated]** The network bandwidth of the enhanced edge node pool. Unit: Mbit/s.', example='null'),
    ccnId?: string(name='ccn_id', description='**[Deprecated]**

The Cloud Connect Network (CCN) instance ID attached to the enhanced edge node pool.', example='null'),
    ccnRegionId?: string(name='ccn_region_id', description='**[Deprecated]** The region of the CCN instance bound to the enhanced edge node pool.', example='null'),
    cenId?: string(name='cen_id', description='**[Deprecated]**

The Cloud Enterprise Network (CEN) instance ID attached to the enhanced edge node pool.', example='null'),
    improvedPeriod?: string(name='improved_period', description='**[Deprecated]** The subscription duration of the enhanced edge node pool. Unit: months.', example='null'),
  }(name='interconnect_config', description='**[Deprecated]** The configuration of the edge node pool.', deprecated='true', position='Body'),
  interconnectMode?: string(name='interconnect_mode', description='The network type of the edge node pool. This parameter takes effect only when type is set to edge. Valid values:
- basic: public network. Nodes in cloud node pool interact with cloud nodes over the public network. Applications in cloud node pool cannot directly access the internal network of the cloud VPC.
- private: private network. Nodes in cloud node pool connect to the cloud network over Express Connect circuits, VPNs, or CEN. This provides higher cloud-edge communication quality and more effective security protection.', example='basic', position='Body'),
  intranet?: boolean(name='intranet', description='Specifies whether Layer 3 network connectivity is enabled between nodes in the edge node pool. Valid values:
- true: enabled. Layer 3 network connectivity is enabled between all nodes in the node pool.
- false: disabled. Layer 3 network connectivity is disabled between all hosts in the node pool.', example='true', position='Body'),
  kubernetesConfig?: {
    cmsEnabled?: boolean(name='cms_enabled', description='Specifies whether to install CloudMonitor on Elastic Compute Service (ECS) nodes. After installation, you can view the monitoring information of the created ECS instances in the CloudMonitor console. Enabling this feature is recommended. Valid values:

- `true`: installs CloudMonitor on ECS nodes.

- `false`: does not install CloudMonitor on ECS nodes.

Default value: `false`.', example='false'),
    cpuPolicy?: string(name='cpu_policy', description='The CPU management policy for nodes. The following two policies are supported when the cluster version is 1.12.6 or later:

- `static`: allows you to enhance CPU affinity and exclusivity for pods with specific resource characteristics on the node.
- `none`: enables the existing default CPU affinity scheme.

Default value: `none`.', example='none'),
    labels?: [
      Tag
    ](name='labels', description='The labels added to the nodes in the Kubernetes cluster.'),
    nodeNameMode?: string(name='node_name_mode', description='The custom node name. After you customize the node name, the node name, ECS instance name, and ECS instance hostname are changed at the same time.
> For Windows instances with custom node names enabled, the hostname is fixed to the IP address, with hyphens (-) replacing dots (.) in the IP address, and does not include prefixes or suffixes. 

The node name consists of three parts: a prefix, the node IP address, and a suffix:

- The total length is 2 to 64 characters. The node name must start and end with a lowercase letter or a digit.

- The prefix and suffix can contain uppercase and lowercase letters, digits, hyphens (-), and dots (.). They must start with a letter and cannot start or end with a hyphen (-) or a dot (.). Consecutive hyphens (-) or dots (.) are not allowed.
- The prefix is required (due to ECS limits), and the suffix is optional.
- The node IP address is the complete private IP address of the node.

For example, if the node IP address is 192.XX.YY.55, the specified prefix is aliyun.com, and the suffix is test:

- If the node is a Linux node, the node name, ECS instance name, and ECS instance hostname are all aliyun.com192.XX.YY.55test.

- If the node is a Windows node, the ECS instance hostname is 192-XX-YY-55, and both the node name and ECS instance name are aliyun.com192.XX.YY.55test.', example='aliyun.com192.XX.YY.55test'),
    preUserData?: string(name='pre_user_data', description='The pre-custom data of the instance. Before the node joins the cluster, the specified pre-custom data script is run. For more information, see [User data scripts](https://help.aliyun.com/document_detail/49121.html).', example='dGhpcyBpcyBhIGV4YW1wbGU'),
    runtime?: string(name='runtime', description='The name of the container runtime. Container Service for Kubernetes (ACK) supports the following three container runtimes:

- containerd: recommended. Supported by all cluster versions.
- Sandboxed-Container.runv: secure sandboxed containers that provide higher isolation. Supported by clusters of version 1.31 and earlier.
- docker: no longer maintained. Supported by clusters of version 1.22 and earlier.

Default value: containerd.', example='containerd'),
    runtimeVersion?: string(name='runtime_version', description='The container runtime version.', example='1.6.38'),
    taints?: [
      Taint
    ](name='taints', description='The taint configurations.'),
    unschedulable?: boolean(name='unschedulable', description='Specifies whether the scaled-out nodes are unschedulable.

- true: unschedulable.

- false: schedulable.', example='true'),
    userData?: string(name='user_data', description='The instance user data. After a node joins the cluster, the specified instance user data script runs. For more information, see [User data scripts](https://help.aliyun.com/document_detail/49121.html).', example='dGhpcyBpcyBhIGV4YW1wbGU='),
  }(name='kubernetes_config', description='The cluster configurations.', position='Body'),
  management?: {
    autoFaultDiagnosis?: boolean(name='auto_fault_diagnosis', description='Specifies whether to enable ECS fault detection for node auto-healing.'),
    autoRepair?: boolean(name='auto_repair', description='Specifies whether to automatically repair nodes. This parameter takes effect only when `enable` is set to `true`.

- `true`: automatically repairs nodes.

- `false`: does not automatically repair nodes.

Default value: `true`.', example='true'),
    autoRepairPolicy?: {
      approvalRequired?: boolean(name='approval_required', description='Specifies whether manual approval is required for node repair.'),
      maxParallelRepairingNodes?: string(name='max_parallel_repairing_nodes', description='The maximum number of parallel repairs. When a large number of abnormal nodes exist in the node pool, this parameter specifies the maximum number or percentage of nodes that can be repaired at the same time. You can specify a number (such as 5, valid values: 1 to 100000) or a percentage (such as 10%, valid values: 1% to 100%). Default value on the backend: 1.', example='5'),
      maxUnhealthyNodesThreshold?: string(name='max_unhealthy_nodes_threshold', description='The circuit breaker condition for auto-healing. When the number or percentage of faulty nodes exceeds this threshold, auto-healing enters the circuit breaker state and stops initiating new auto-healing repair actions. You can specify a number (such as 10, valid values: 1 to 100000) or a percentage (such as 20%, valid values: 1% to 100%). Default circuit breaker condition on the backend: 100%.', example='20%'),
      restartNode?: boolean(name='restart_node', description='Specifies whether to allow node restarts. This parameter takes effect only when `auto_repair` is set to `true`. Valid values:

- `true`: allows node restarts.
- `false`: does not allow node restarts.

Default value: `true`.', example='true'),
    }(name='auto_repair_policy', description='The auto-repair policy for nodes.'),
    autoUpgrade?: boolean(name='auto_upgrade', description='Specifies whether to automatically upgrade nodes. This parameter takes effect only when `enable` is set to `true`.
- `true`: enables auto-upgrade.
- `false`: disables auto-upgrade.

Default value: `true`.', example='true'),
    autoUpgradePolicy?: {
      autoUpgradeKubelet?: boolean(name='auto_upgrade_kubelet', description='Specifies whether to allow automatic kubelet upgrades. This parameter takes effect only when `auto_upgrade` is set to `true`. Valid values:
- `true`: allows automatic kubelet upgrades.
- `false`: does not allow automatic kubelet upgrades.

Default value: `true`.', example='true'),
      autoUpgradeOs?: boolean(name='auto_upgrade_os', description='Specifies whether to allow automatic operating system upgrades. This parameter takes effect only when `auto_upgrade` is set to `true`. Valid values:
- `true`: allows automatic operating system upgrades.
- `false`: does not allow automatic operating system upgrades.

Default value: `false`.', example='false'),
      autoUpgradeRuntime?: boolean(name='auto_upgrade_runtime', description='Specifies whether to allow automatic runtime upgrades. This parameter takes effect only when `auto_upgrade` is set to `true`. Valid values:
- `true`: allows automatic runtime upgrades.
- `false`: does not allow automatic runtime upgrades.

Default value: `true`.', example='false'),
    }(name='auto_upgrade_policy', description='The auto-upgrade policy for nodes.'),
    autoVulFix?: boolean(name='auto_vul_fix', description='Specifies whether to automatically repair Common Vulnerabilities and Exposures (CVE) vulnerabilities. This parameter takes effect only when `enable` is set to `true`.

- `true`: allows automatic CVE repairs.
- `false`: does not allow automatic CVE repairs.

Default value: `true`.', example='true'),
    autoVulFixPolicy?: {
      excludePackages?: string(name='exclude_packages', description='The packages to be excluded during vulnerability repair.

Default value: `kernel`.', example='kernel'),
      restartNode?: boolean(name='restart_node', description='Specifies whether to allow node restarts. This parameter takes effect only when `auto_vul_fix` is set to `true`. Valid values:
- `true`: allows node restarts.
- `false`: does not allow node restarts.

Default value: `true`.', example='false'),
      vulLevel?: string(name='vul_level', description='The vulnerability levels that are allowed for auto-repair, separated by commas. Example: `asap,later`. Supported vulnerability levels:

- `asap`: high.
- `later`: medium.
- `nntf`: low.

Default value: `asap`.', example='asap,nntf'),
    }(name='auto_vul_fix_policy', description='The CVE auto-repair policy.'),
    driftEnabled?: boolean(name='drift_enabled', description='Specifies whether to enable the node rotation capability. This feature is supported only by intelligent managed node pools and is enabled by default. It is not supported by regular node pools.'),
    enable?: boolean(name='enable', description='Specifies whether to enable the managed feature for the node pool. Valid values:

- `true`: enables the managed feature.

- `false`: disables the managed feature. Other related configurations take effect only when `enable` is set to `true`.

Default value: `false`.', example='false'),
    upgradeConfig?: {
      autoUpgrade?: boolean(name='auto_upgrade', description='**[Deprecated]** Use the upper-level `auto_upgrade` parameter instead.

Specifies whether to enable auto-upgrade. Valid values:

- `true`: enables auto-upgrade.

- `false`: disables auto-upgrade.', example='null', deprecated='true'),
      maxUnavailable?: long(name='max_unavailable', description='The maximum number of unavailable nodes.
Valid values: [1, 1000].

Default value: 1.', example='1'),
      surge?: long(name='surge', description='The number of extra nodes. This parameter and `surge_percentage` are mutually exclusive.

Nodes become unavailable during upgrades. You can create extra nodes to compensate for the cluster load.

> Do not create more extra nodes than the current number of nodes.', example='0'),
      surgePercentage?: long(name='surge_percentage', description='The percentage of extra nodes. This parameter and `surge` are mutually exclusive.

Number of extra nodes = Percentage of extra nodes × Number of nodes. For example, if the percentage of extra nodes is set to 50% and the number of existing nodes is 6, the number of extra nodes generated is 50% × 6 = 3.', example='0'),
    }(name='upgrade_config', description='**[Deprecated]** Use the upper-level `auto_upgrade` parameter instead.

The auto-upgrade configurations. This parameter takes effect only when `enable` is set to `true`.', deprecated='true'),
