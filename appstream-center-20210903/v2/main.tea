    body['ResourceId'] = request.resourceId;
  }
  if (!$isNull(request.sessionId)) {
    body['SessionId'] = request.sessionId;
  }
  if (!$isNull(request.taskId)) {
    body['TaskId'] = request.taskId;
  }
