import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'foasconsole';
  @version = '2021-10-28';
  @endpointRule = 'central';
  @endpointMap = {
    'cn-wulanchabu' = 'foasconsole.cn-wulanchabu.aliyuncs.com',
    'cn-beijing' = 'foasconsole.cn-beijing.aliyuncs.com',
    'cn-qingdao' = 'foasconsole.cn-qingdao.aliyuncs.com',
    'cn-shanghai' = 'foasconsole.cn-shanghai.aliyuncs.com',
    'cn-hongkong' = 'foasconsole.cn-hongkong.aliyuncs.com',
    'cn-zhangjiakou' = 'foasconsole.cn-zhangjiakou.aliyuncs.com',
    'cn-shenzhen' = 'foasconsole.cn-shenzhen.aliyuncs.com',
    'ap-northeast-1' = 'foasconsole.ap-northeast-1.aliyuncs.com',
    'ap-southeast-1' = 'foasconsole.ap-southeast-1.aliyuncs.com',
    'ap-southeast-3' = 'foasconsole.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'foasconsole.ap-southeast-5.aliyuncs.com',
    'cn-hangzhou' = 'foasconsole.cn-hangzhou.aliyuncs.com',
    'us-east-1' = 'foasconsole.us-east-1.aliyuncs.com',
    'eu-west-1' = 'foasconsole.eu-west-1.aliyuncs.com',
    'us-west-1' = 'foasconsole.us-west-1.aliyuncs.com',
    'eu-central-1' = 'foasconsole.eu-central-1.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'foasconsole.cn-shenzhen-finance-1.aliyuncs.com',
    'cn-shanghai-finance-1' = 'foasconsole.cn-shanghai-finance-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model ClusterStage {
  currentStage?: int32(name='CurrentStage', description='The ordinal number of the current execution stage.', example='0'),
  message?: string(name='Message', description='The execution information of the current stage.', example='Creating resources'),
  status?: string(name='Status', description='The execution status of the current stage.', example='CREATING'),
  totalStageWithWeight?: [
    StageWithWeight
  ](name='TotalStageWithWeight', description='The list of execution stages and their weights.'),
}

model ClusterState {
  clusterStage?: ClusterStage(name='ClusterStage', description='The stage progress information for cluster operations.'),
  status?: string(name='Status', description='The cluster running status.', example='RUNNING'),
  subStatus?: string(name='SubStatus', description='The cluster running sub-status.', example='RUNNING'),
}

model FlussInstance {
  clusterState?: ClusterState(name='ClusterState', description='The running state information of the cluster.'),
  clusterStatus?: string(name='ClusterStatus', description='The status of the Fluss cluster.', example='RUNNING'),
  consoleUrl?: string(name='ConsoleUrl', description='The console access URL of the Fluss instance.'),
  diskSize?: long(name='DiskSize', description='The disk size of a single TabletServer node, in GiB.', example='900'),
  ha?: boolean(name='Ha', description='Specifies whether multi-zone high availability is enabled.'),
  instanceId?: string(name='InstanceId', description='The ID of the Fluss instance.', example='f-cn-zvp2q0z****'),
  instanceName?: string(name='InstanceName', description='The name of the Fluss instance.', example='fluss-test'),
  orderState?: string(name='OrderState', description='The order status of the instance.', example='NORMAL'),
  regionId?: string(name='RegionId', description='The ID of the region where the instance resides.', example='cn-beijing'),
  resourceCreateTime?: long(name='ResourceCreateTime', description='The creation time of the instance, represented as a UNIX timestamp in milliseconds.', example='1629879567394'),
  resourceExpiredTime?: long(name='ResourceExpiredTime', description='The time when the instance expires, represented as a UNIX timestamp in milliseconds.', example='1637337600000'),
  tabletServerModel?: string(name='TabletServerModel', description='The TabletServer node specifications.', example='4 RCU'),
  tabletServerNum?: long(name='TabletServerNum', description='The number of TabletServer nodes.', example='3'),
  tabletServerType?: string(name='TabletServerType', description='The type of TabletServer node specifications.', example='4 RCU'),
  tieringPostCu?: long(name='TieringPostCu', description='The upper limit of elastic compute resources for the lake-stream synchronization service, in CUs.', example='100'),
  tieringPreCu?: long(name='TieringPreCu', description='The base compute resource count for the lake-stream synchronization service, in CUs.'),
  uid?: string(name='Uid', description='The UID of the Alibaba Cloud account to which the instance belongs.', example='183899668736****'),
  vSwitches?: [
    FlussVswitch
  ](name='VSwitches', description='The list of zone and vSwitch configurations used by the instance.'),
  vpcId?: string(name='VpcId', description='The ID of the VPC to which the instance belongs.', example='vpc-2ze9*******nxfmfcdi'),
}

model FlussResourceSpec {
  diskSizeInGB?: long(name='DiskSizeInGB', description='The disk capacity of a single TabletServer node, in GiB.', example='900'),
  slaveModel?: string(name='SlaveModel', description='The node specifications of the TabletServer.', example='4 RCU'),
  slaveNum?: long(name='SlaveNum', description='The number of TabletServer nodes.', example='3'),
  tieringPostCu?: long(name='TieringPostCu', description='The maximum number of elastic compute resources for the lake-stream synchronization service, in CUs.', example='100'),
  tieringPreCu?: long(name='TieringPreCu', description='The baseline resource count of the lake-stream synchronization service, in CUs.'),
}

model FlussVswitch {
  vSwitchIds?: [ string ](name='VSwitchIds', description='The list of vSwitch IDs in the zone.'),
  zoneId?: string(name='ZoneId', description='The ID of the zone to which the vSwitch belongs.', example='cn-beijing-g'),
}

model StageWithWeight {
  stepIndex?: int32(name='StepIndex', description='The ordinal number of the execution stage.', example='0'),
  stepName?: string(name='StepName', description='The name of the execution stage.'),
  weight?: int32(name='Weight', description='The weight of the stage in the overall progress.', example='0'),
}

