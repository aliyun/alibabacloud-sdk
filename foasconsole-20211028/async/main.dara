import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'foasconsole';
  @version = '2021-10-28';
  @endpointRule = 'central';
  @endpointMap = {
    'cn-wulanchabu' = 'foasconsole.cn-wulanchabu.aliyuncs.com',
    'cn-beijing' = 'foasconsole.cn-beijing.aliyuncs.com',
    'cn-qingdao' = 'foasconsole.cn-qingdao.aliyuncs.com',
    'cn-shanghai' = 'foasconsole.cn-shanghai.aliyuncs.com',
    'cn-hongkong' = 'foasconsole.cn-hongkong.aliyuncs.com',
    'cn-zhangjiakou' = 'foasconsole.cn-zhangjiakou.aliyuncs.com',
    'cn-shenzhen' = 'foasconsole.cn-shenzhen.aliyuncs.com',
    'ap-northeast-1' = 'foasconsole.ap-northeast-1.aliyuncs.com',
    'ap-southeast-1' = 'foasconsole.ap-southeast-1.aliyuncs.com',
    'ap-southeast-3' = 'foasconsole.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'foasconsole.ap-southeast-5.aliyuncs.com',
    'cn-hangzhou' = 'foasconsole.cn-hangzhou.aliyuncs.com',
    'us-east-1' = 'foasconsole.us-east-1.aliyuncs.com',
    'eu-west-1' = 'foasconsole.eu-west-1.aliyuncs.com',
    'us-west-1' = 'foasconsole.us-west-1.aliyuncs.com',
    'eu-central-1' = 'foasconsole.eu-central-1.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'foasconsole.cn-shenzhen-finance-1.aliyuncs.com',
    'cn-shanghai-finance-1' = 'foasconsole.cn-shanghai-finance-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model ClusterStage {
  currentStage?: int32(name='CurrentStage'),
  message?: string(name='Message'),
  status?: string(name='Status'),
  totalStageWithWeight?: [
    StageWithWeight
  ](name='TotalStageWithWeight'),
}

model ClusterState {
  clusterStage?: ClusterStage(name='ClusterStage'),
  status?: string(name='Status'),
  subStatus?: string(name='SubStatus'),
}

model FlussInstance {
  clusterState?: ClusterState(name='ClusterState'),
  clusterStatus?: string(name='ClusterStatus', description='The cluster status.'),
  consoleUrl?: string(name='ConsoleUrl', description='The URL of the instance management console.'),
  diskSize?: long(name='DiskSize', description='The disk size, in GB.'),
  ha?: boolean(name='Ha', description='Specifies whether high availability (HA) is enabled.'),
  instanceId?: string(name='InstanceId', description='The instance ID.'),
  instanceName?: string(name='InstanceName', description='The instance name.'),
  orderState?: string(name='OrderState', description='The order state.'),
  regionId?: string(name='RegionId', description='The ID of the region.'),
  resourceCreateTime?: long(name='ResourceCreateTime', description='The creation time of the resource, as a UNIX timestamp in milliseconds.'),
  resourceExpiredTime?: long(name='ResourceExpiredTime', description='The expiration time of the resource, as a UNIX timestamp in milliseconds.'),
  tabletServerModel?: string(name='TabletServerModel', description='The tablet server model.'),
  tabletServerNum?: long(name='TabletServerNum', description='The number of tablet servers.'),
  tabletServerType?: string(name='TabletServerType', description='The tablet server type.'),
  tieringPostCu?: long(name='TieringPostCu', description='The number of compute units (CUs) for post-tiering.'),
  tieringPreCu?: long(name='TieringPreCu', description='The number of compute units (CUs) for pre-tiering.'),
  uid?: string(name='Uid', description='The Alibaba Cloud account ID (UID).'),
  vSwitches?: [
    FlussVswitch
  ](name='VSwitches', description='The VSwitch details.'),
  vpcId?: string(name='VpcId', description='The VPC ID.'),
}

model FlussResourceSpec {
  diskSizeInGB?: long(name='DiskSizeInGB', description='Disk size per node, in GB.'),
  slaveModel?: string(name='SlaveModel', description='Instance type of the slave nodes.'),
  slaveNum?: long(name='SlaveNum', description='Number of slave nodes.'),
  tieringPostCu?: long(name='TieringPostCu', description='Number of CUs for the post-tiering stage.'),
  tieringPreCu?: long(name='TieringPreCu', description='Number of compute units (CUs) for the pre-tiering stage.'),
}

model FlussVswitch {
  vSwitchIds?: [ string ](name='VSwitchIds'),
  zoneId?: string(name='ZoneId'),
}

model StageWithWeight {
  stepIndex?: int32(name='StepIndex'),
  stepName?: string(name='StepName'),
  weight?: int32(name='Weight'),
}

