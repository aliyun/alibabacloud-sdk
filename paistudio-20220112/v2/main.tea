  maxLength?: long(name='MaxLength', description='Maximum length.', example='30'),
  maximum?: string(name='Maximum', description='Maximum value.', example='10'),
  minLength?: long(name='MinLength', description='Minimum length.', example='1'),
  minimum?: string(name='Minimum', description='Minimum value.', example='0'),
  pattern?: string(name='Pattern', description='Regular expression.', example='^\\\\+?[1-9][0-9]*$'),
}

model JobSettings {
  advancedSettings?: map[string]any(name='AdvancedSettings', description='Additional advanced parameter settings.'),
  businessUserId?: string(name='BusinessUserId', description='User ID associated with the job.', example='166924'),
  caller?: string(name='Caller', description='Caller.', example='SilkFlow'),
  driver?: string(name='Driver', description='NVIDIA driver configuration.', example='535.54.03'),
  enableErrorMonitoringInAIMaster?: boolean(name='EnableErrorMonitoringInAIMaster', description='Enable job fault tolerance monitoring.', example='false'),
  enableOssAppend?: boolean(name='EnableOssAppend', description='Enable OSS append writes.', example='true'),
  enableRDMA?: boolean(name='EnableRDMA', description='Enable the job to use RDMA.', example='true'),
  enableSanityCheck?: boolean(name='EnableSanityCheck', description='Enable computing power health check for the job.', example='true'),
  enableTideResource?: boolean(name='EnableTideResource', description='Enable the job to use tide resources.', example='true'),
  errorMonitoringArgs?: string(name='ErrorMonitoringArgs', description='Specify configuration parameters for fault tolerance monitoring, such as whether to enable log hang-based detection.', example='--enable-log-hang-detection true'),
  jobReservedMinutes?: int32(name='JobReservedMinutes', description='Duration in minutes to retain the job after completion.', example='30'),
  jobReservedPolicy?: string(name='JobReservedPolicy', description='Policy for retaining the job after completion.', example='Always'),
  oversoldType?: string(name='OversoldType', description='Job\\\\"s oversold resource usage method (not accepted, accepted, or only accepted).', example='AcceptQuotaOverSold'),
  pipelineId?: string(name='PipelineId', description='Workflow ID.', example='pid-123456'),
  sanityCheckArgs?: string(name='SanityCheckArgs', description='Configuration parameters for computing power health check.', example='--sanity-check-timing=AfterJobFaultTolerant --sanity-check-timeout-ops=MarkJobFai'),
  tags?: map[string]string(name='Tags', description='Custom tags.'),
}

