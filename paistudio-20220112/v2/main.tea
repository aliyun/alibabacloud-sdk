/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'pai.cn-beijing.aliyuncs.com',
    'cn-hangzhou' = 'pai.cn-hangzhou.data.aliyun.com',
    'cn-shanghai' = 'pai.cn-shanghai.aliyuncs.com',
    'cn-shenzhen' = 'pai.cn-shenzhen.aliyuncs.com',
    'cn-hongkong' = 'pai.cn-hongkong.aliyuncs.com',
    'ap-southeast-1' = 'pai.ap-southeast-1.aliyuncs.com',
    'ap-southeast-2' = 'pai.ap-southeast-2.aliyuncs.com',
    'ap-southeast-3' = 'pai.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'pai.ap-southeast-5.aliyuncs.com',
    'us-east-1' = 'pai.us-east-1.aliyuncs.com',
    'us-west-1' = 'pai.us-west-1.aliyuncs.com',
    'eu-central-1' = 'pai.eu-central-1.aliyuncs.com',
    'ap-south-1' = 'pai.ap-south-1.aliyuncs.com',
    'me-east-1' = 'pai.me-east-1.aliyuncs.com',
    'ap-northeast-1' = 'pai.ap-northeast-1.aliyuncs.com',
    'cn-qingdao' = 'pai.cn-qingdao.aliyuncs.com',
    'cn-shanghai-finance-1' = 'pai.cn-shanghai-finance-1.aliyuncs.com',
    'cn-wulanchabu' = 'pai.cn-wulanchabu.aliyuncs.com',
    'cn-zhangjiakou' = 'pai.cn-zhangjiakou.aliyuncs.com',
    'us-southeast-1' = 'pai.us-southeast-1.aliyuncs.com',
    'cn-zhongwei' = 'pai.cn-zhongwei.aliyuncs.com',
    'cn-guangzhou' = 'pai.cn-guangzhou.aliyuncs.com',
    'ap-southeast-8' = 'pai.ap-southeast-8.aliyuncs.com',
    'ap-northeast-2' = 'pai.ap-northeast-2.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('paistudio', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ACS {
  ACSQuotaId?: string(name='ACSQuotaId', description='ACS resource ID.', example='rq-3kbt2gtimmyw7fgfgothocvh'),
  associatedProducts?: [ string ](name='AssociatedProducts', description='Product codes that can use the ACS Quota.

Constraints:  
You can select multiple sub-products, but some sub-products are mutually exclusive. The following combinations can be selected simultaneously:  
- PAI-DLC, PAI-DSW  
- PAI-EAS'),
}

model Action {
  actionType?: string(name='ActionType'),
}

model AlgorithmSpec {
  codeDir?: Location(name='CodeDir', description='The custom code configuration.'),
  command?: [ string ](name='Command', description='The list of commands to run the training task.

This parameter is required.'),
  computeResource?: {
    policy?: {
      value?: string(name='Value', description='Policy content, serialized from a JSON array.

This parameter is required.', example='[{\\\\"MinTotalCount\\\\":1,\\\\"MaxTotalCount\\\\":4,\\\\"RolePolicies\\\\":{\\\\"chief\\\\":{\\\\"Count\\\\":1},\\\\"ps\\\\":{\\\\"Count\\\\":1},\\\\"worker\\\\":{\\\\"Percentage\\\\":100}}},{\\\\"MinTotalCount\\\\":5,\\\\"MaxTotalCount\\\\":10,\\\\"RolePolicies\\\\":{\\\\"chief\\\\":{\\\\"Count\\\\":1},\\\\"ps\\\\":{\\\\"Percentage\\\\":20},\\\\"worker\\\\":{\\\\"Percentage\\\\":80}}},{\\\\"MinTotalCount\\\\":11,\\\\"RolePolicies\\\\":{\\\\"chief\\\\":{\\\\"Count\\\\":1},\\\\"ps\\\\":{\\\\"Percentage\\\\":40},\\\\"worker\\\\":{\\\\"Percentage\\\\":60}}}]'),
      version?: string(name='Version', description='Policy version.

This parameter is required.', example='V1'),
    }(name='Policy', description='Computing resource configuration policy for the algorithm.

This parameter is required.'),
  }(name='ComputeResource', description='The compute resource definition.'),
  customization?: {
    codeDir?: boolean(name='CodeDir', description='Indicates whether custom-mounted code is used.', example='true'),
  }(name='Customization', description='The custom configuration.'),
  hyperParameters?: [
    HyperParameterDefinition
  ](name='HyperParameters', description='The list of hyperparameter definitions.'),
  image?: string(name='Image', description='The training runtime image.

This parameter is required.', example='registry.cn-shanghai.aliyuncs.com/pai-training/kmeans:v1.0.0'),
  inputChannels?: [
    Channel
  ](name='InputChannels', description='The list of input channels for the algorithm.'),
  jobType?: string(name='JobType', description='The job type.

This parameter is required.', example='TFJob'),
  metricDefinitions?: [
    MetricDefinition
  ](name='MetricDefinitions', description='The list of metric definitions for the training task.'),
  outputChannels?: [
    Channel
  ](name='OutputChannels', description='The list of output channels for the algorithm.'),
  progressDefinitions?: {
    overallProgress?: {
      description?: string(name='Description', description='The description of the monitoring definition.', example='training progress'),
      regex?: string(name='Regex', description='The regular expression for monitoring.', example='^[0-9]+([.][0-9]+){0,1}$'),
    }(name='OverallProgress', description='Monitors training progress.'),
    remainingTime?: {
      description?: string(name='Description', description='The description of the monitoring definition.', example='training remaining time'),
      regex?: string(name='Regex', description='The regular expression for monitoring.', example='^[0-9]+([.][0-9]+){0,1}$'),
    }(name='RemainingTime', description='The definition for monitoring the remaining training time.'),
  }(name='ProgressDefinitions', description='You can use this feature to monitor the training progress.'),
  resourceRequirements?: [
    ConditionExpression
  ](name='ResourceRequirements', description='The resource requirements.'),
  supportedInstanceTypes?: [ string ](name='SupportedInstanceTypes', description='The list of supported elastic computing instance types for training.'),
  supportsDistributedTraining?: boolean(name='SupportsDistributedTraining', description='Indicates whether distributed training is supported.', example='true'),
}

