}

model EcsSpec {
  acceleratorType?: string(name='AcceleratorType', description='The accelerator type.', example='CPU'),
  cpu?: int32(name='Cpu', description='The number of CPU cores.', example='12'),
  ecsImageId?: string(name='EcsImageId', description='The ECS image ID.', example='m-bp1g7004ksh0oeuc****'),
  eriQuantity?: int32(name='EriQuantity', description='The number of Elastic RDMA Interface (ERI) network interface controllers.', example='0'),
  gpu?: int32(name='Gpu', description='The number of GPUs.', example='1'),
  gpuGUSpec?: string(name='GpuGUSpec', description='The GPU computing unit specifications.'),
  gpuMemory?: int32(name='GpuMemory', description='The GPU memory size.', example='80'),
  gpuType?: string(name='GpuType', example='A100'),
  gpuTypeAlias?: string(name='GpuTypeAlias', description='The GPU type alias.', example='A100'),
  instanceType?: string(name='InstanceType', description='The instance type.', example='ml.gu7xf.8xlarge-gu108'),
  machineModel?: string(name='MachineModel', description='The machine model.'),
  memory?: int32(name='Memory', description='The memory resources.', example='92'),
  networkMode?: string(name='NetworkMode', description='The network mode.'),
  plannedCpu?: int32(name='PlannedCpu', description='The planned number of CPU cores.', example='12'),
  plannedMemory?: int32(name='PlannedMemory', description='The planned memory size.'),
  resourceType?: string(name='ResourceType', description='The resource type.', example='ECS'),
  supportGPUShare?: boolean(name='SupportGPUShare', description='Specifies whether GPU sharing is supported.'),
  supportRDMA?: boolean(name='SupportRDMA'),
  supportSetNetworkCardIndex?: boolean(name='SupportSetNetworkCardIndex', description='Specifies whether setting the network interface controller index is supported.'),
}

model EniCacheConfig {
  cachePoolSize?: int32(name='CachePoolSize', description='The size of the cache pool.', example='0', maximum=255),
  enabled?: boolean(name='Enabled', description='Specifies whether it is enabled.'),
}

model Event {
  content?: string(name='Content', description='The event content.', example='{}'),
  eventId?: string(name='EventId', description='The event ID.', example='eventxxx'),
  eventType?: string(name='EventType', description='The event type.', example='CreateQuota'),
  function?: string(name='Function', description='The reserved field.', example='Empty'),
  isTruncated?: boolean(name='IsTruncated', description='Indicates whether the content is truncated.', example='false'),
  objectId?: string(name='ObjectId', description='Object ID', example='quotaxxx'),
  objectType?: string(name='ObjectType', description='The object type.', example='Quota'),
  triggerTenantId?: string(name='TriggerTenantId', description='The Alibaba Cloud account.', example='1234'),
  triggerTime?: string(name='TriggerTime', description='The trigger time.', example='2026-01-01T00:00:00Z'),
  triggerUserId?: string(name='TriggerUserId', description='The RAM user.', example='1234567'),
