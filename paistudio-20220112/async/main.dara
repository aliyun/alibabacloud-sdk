  jobType?: string(name='JobType', description='The job type, such as DLC or DSW.', example='TFJob'),
  memoryUsageRate?: string(name='MemoryUsageRate', description='The memory utilization.', example='20'),
  networkInputRate?: string(name='NetworkInputRate', description='The network inbound rate.', example='1'),
  networkOutputRate?: string(name='NetworkOutputRate', description='The network outbound rate.', example='1'),
  nodeNames?: [ string ](name='NodeNames', description='The node list.'),
  requestCPU?: int32(name='RequestCPU', description='The number of requested CPU cores.', example='100'),
  requestGPU?: int32(name='RequestGPU', description='The number of requested GPUs.', example='10'),
  requestMemory?: long(name='RequestMemory', description='The requested memory in KB.', example='102400000'),
  totalCPU?: int32(name='TotalCPU', description='The total number of CPU cores.', example='1000'),
  totalGPU?: int32(name='TotalGPU', description='The total number of GPUs.', example='1'),
