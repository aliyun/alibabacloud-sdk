model UpdateQuotaRequest {
  quotaId?: string(name='QuotaId', description='The quota ID.', example='quota-20210126170216-mtl37ge7gkvdz', position='Path'),
  clusterSpec?: {
    clusterType?: string(name='ClusterType', description='The cluster type. Currently, only RayCluster is supported.', example='RayCluster'),
    dataSources?: [ string ](name='DataSources', description='The list of data sources mounted to the cluster. This parameter uses the overall replacement semantics: if it is not passed, the current state is maintained; if an empty array is passed, the list is cleared. Each element is a JSON object string that contains DataSourceId or Uri (one of them is required and they are mutually exclusive) and an optional MountPath.'),
    image?: string(name='Image', description='The container image used by the Ray cluster. If this parameter is explicitly passed, the system switches to this image. If it is left empty and the data sources remain unchanged, and GetQuota returns UpgradeAvailable=true, this update is considered an upgrade to the platform default image. To keep the current image, explicitly pass the current value.', example='dsw-registry-vpc.ap-southeast-1.cr.aliyuncs.com/pai-common/ray-runtime'),
  }(name='ClusterSpec', description='The configurations of the compute cluster bound to the quota (RNQ Ray cluster). This parameter is only available for RNQ quotas and will be rejected for common quotas. It can only be modified when no operations are in progress on the quota. Unpassed sub-fields retain the current effective configurations.', position='Body'),
  description?: string(name='Description', description='The description of the resource quota.', example='this is a test quota', position='Body'),
  enableGracefulUpgrade?: boolean(name='EnableGracefulUpgrade', description='Specifies whether to execute the current ClusterSpec change as a rolling upgrade (draining and migrating nodes one by one to the new cluster) instead of the default stop-and-rebuild method.', example='true', position='Body'),
  gracefulUpgradeConfig?: {
    drainTimeoutSeconds?: long(name='DrainTimeoutSeconds', description='The timeout limit for Ray draining of a single node. After the timeout, the node is still directly scaled down, which does not cause the upgrade to fail.', example='3600'),
    maxUnavailable?: string(name='MaxUnavailable', description='The migration window width, which is the maximum number of workers in the old cluster that are simultaneously in an unavailable state (draining or drained and pending removal), that is, the number of nodes migrated in parallel.', example='25%'),
    taskDrainReserveWorkers?: long(name='TaskDrainReserveWorkers', description='The number of workers in the old cluster that are kept in a schedulable state while waiting for the remaining Ray tasks in the old cluster to complete.', example='5'),
  }(name='GracefulUpgradeConfig', description='The tuning parameters for the migration process. This parameter is only allowed when EnableGracefulUpgrade is set to true.', position='Body'),
  labels?: [
    Label
  ](name='Labels', description='The list of user-defined labels.
This is a full update.', position='Body'),
  propagateDefaultGPUDriver?: boolean(name='PropagateDefaultGPUDriver', description='Specifies whether to pass the default GPU driver configuration to child quotas.', position='Body'),
  queueStrategy?: string(name='QueueStrategy', description='The queuing strategy for tasks on the quota.', example='PaiStrategyIntelligent', position='Body'),
  quotaConfig?: QuotaConfig(name='QuotaConfig', description='The resource quota configuration.', position='Body'),
  quotaName?: string(name='QuotaName', description='The name of the resource quota.', example='test', position='Body'),
}

model UpdateQuotaResponseBody = {
  quotaId?: string(name='QuotaId', description='The quota ID.', example='quota-20210126170216-mtl37ge7gkvdz'),
  requestId?: string(name='RequestId', description='The request ID.', example='96496E6E-00B4-5F55-80F6-1844FA9E92DC'),
}

model UpdateQuotaResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateQuotaResponseBody(name='body'),
}

