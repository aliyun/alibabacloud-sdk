  operationId?: string(name='OperationId', description='The resource change ID.', example='operation-123'),
  operationSpecJson?: string(name='OperationSpecJson', description='The details of the resource change.', example='{"ScaleQuota":{"Min":{"NodeSpecs":[{"Type":"ecs.gn6i-c8g1.2xlarge","Count":20,"IncludeNodes":["A","B","C"],"ExcludeNodes":["D"]}]}}}'),
  operationType?: string(name='OperationType', description='The type of the resource change.', example='ScaleQuota'),
