model QuotaDetails {
  actualMinQuota?: ResourceAmount(name='ActualMinQuota', description='The total MinQuota actually allocated. For example, if the user configured 10 nodes but only 8 nodes are actually bound, this value returns the total resources of the 8 nodes.'),
  allocatableQuota?: ResourceAmount(name='AllocatableQuota', description='The user-allocatable quota amount. For general computing resources, each node has system-reserved resources. This value represents the quota resources that user workloads can occupy.
ActualMin = AllocatableQuota + SystemReservedQuota.'),
  allocatedQuota?: ResourceAmount(name='AllocatedQuota', description='The total quota usage information, which is the total resources occupied by workloads after scheduling to nodes.'),
  ancestorsAllocatedQuota?: ResourceAmount(name='AncestorsAllocatedQuota', description='The ancestor quota usage information, which is the total resources of workloads submitted using ancestor quotas after they are scheduled to nodes.'),
  descendantsAllocatedQuota?: ResourceAmount(name='DescendantsAllocatedQuota', description='The descendant quota usage information, which is the total resources of workloads submitted using descendant quotas after they are scheduled to nodes.'),
  desiredMinQuota?: ResourceAmount(name='DesiredMinQuota', description='The total MinQuota desired by the user.'),
  nodeStatistics?: QuotaNodeStatistics(name='NodeStatistics', description='The statistics information of nodes within the quota.'),
  requestedQuota?: ResourceAmount(name='RequestedQuota', description='The quota requested amount, which is the total resources occupied by workloads after they are dequeued.'),
  selfAllocatedQuota?: ResourceAmount(name='SelfAllocatedQuota', description='The current-level quota usage information, which is the total resources of workloads submitted using this quota after they are scheduled to nodes.'),
  selfSubmittedQuota?: ResourceAmount(name='SelfSubmittedQuota', description='The amount submitted to this quota, which is the total resources of workloads submitted to this quota, including workloads that are queued.'),
  systemReservedQuota?: ResourceAmount(name='SystemReservedQuota', description='The system-reserved quota amount.'),
  usedQuota?: ResourceAmount(name='UsedQuota', description='The quota used amount. This field is deprecating. Use AllocatedQuota instead.'),
}

model QuotaIdName {
  quotaId?: string(name='QuotaId', description='Resource quota ID', example='quota12345'),
  quotaName?: string(name='QuotaName', description='Resource quota name', example='dlc-quota'),
}

