  natGatewayId?: string(name='NatGatewayId', description='NAT Gateway ID', example='nat-7j4mka9wguxj'),
}

model GPUInfo {
  count?: long(name='count', description='Quantity', example='1'),
  type?: string(name='type', description='Type', example='T4'),
}

model GPUMetric {
  index?: long(name='Index', description='The GPU index.', example='0'),
  model?: string(name='Model', description='The GPU model.', example='NVIDIA V100'),
  status?: long(name='Status', description='The card status.', example='0：异常；1：正常'),
  usageRate?: float(name='UsageRate', description='The GPU utilization.', example='0'),
}

model GlobalSpotPriceItem {
  effectiveAt?: string(name='effectiveAt', description='The effective period.', example='2026-08-20T06:45:00Z'),
  instanceType?: string(name='instanceType', description='The instance type.', example='ml.gp7vf.16.40xlarge'),
  spotDiscount?: string(name='spotDiscount', description='The current market price.', example='0.1'),
}

model HyperParameterDefinition {
  defaultValue?: string(name='DefaultValue', description='The default value of the hyperparameter.', example='0'),
  description?: string(name='Description', description='The description of the hyperparameter.', example='参数定义了训练的batch_size。'),
  displayName?: string(name='DisplayName', description='The display name of the parameter.', example='Batch Size'),
  name: string(name='Name', description='The name of the parameter.

This parameter is required.', example='batch_size'),
  range?: HyperParameterRange(name='Range', description='The value range of the parameter.'),
  required?: boolean(name='Required', description='Specifies whether the parameter is required.', example='true'),
  type: string(name='Type', description='The type of the hyperparameter.

This parameter is required.', example='Integer'),
}

model HyperParameterRange {
  enum?: [ string ](name='Enum', description='Hyperparameter enumeration list.'),
  exclusiveMaximum?: boolean(name='ExclusiveMaximum', description='Whether the maximum value is exclusive.', example='true'),
  exclusiveMinimum?: boolean(name='ExclusiveMinimum', description='Whether the minimum value is exclusive.', example='true'),
  maxLength?: long(name='MaxLength', description='Maximum length.', example='30'),
  maximum?: string(name='Maximum', description='Maximum value.', example='10'),
  minLength?: long(name='MinLength', description='Minimum length.', example='1'),
  minimum?: string(name='Minimum', description='Minimum value.', example='0'),
  pattern?: string(name='Pattern', description='Regular expression.', example='^\\\\+?[1-9][0-9]*$'),
}

model JobSettings {
  advancedSettings?: map[string]any(name='AdvancedSettings', description='The additional advanced parameter settings.'),
  businessUserId?: string(name='BusinessUserId', description='The ID of the user associated with the job.', example='166924'),
  caller?: string(name='Caller', description='The caller.', example='SilkFlow'),
  driver?: string(name='Driver', description='The NVIDIA driver configuration.', example='535.54.03'),
  enableErrorMonitoringInAIMaster?: boolean(name='EnableErrorMonitoringInAIMaster', description='Specifies whether to enable fault tolerance monitoring for the job.', example='false'),
  enableOssAppend?: boolean(name='EnableOssAppend', description='Specifies whether to enable OSS append writing.', example='true'),
  enableRDMA?: boolean(name='EnableRDMA', description='Specifies whether to allow the job to use RDMA.', example='true'),
  enableSanityCheck?: boolean(name='EnableSanityCheck', description='Specifies whether to enable computing power health checks for the job.', example='true'),
  enableTideResource?: boolean(name='EnableTideResource', description='Specifies whether to allow the job to use tide resources.', example='true'),
  errorMonitoringArgs?: string(name='ErrorMonitoringArgs', description='The user-specified configuration parameters for fault tolerance monitoring, such as whether to enable log hang-based detection.', example='--enable-log-hang-detection true'),
  jobReservedMinutes?: int32(name='JobReservedMinutes', description='The retention duration after the job ends, in minutes.', example='30'),
  jobReservedPolicy?: string(name='JobReservedPolicy', description='The retention policy after the job ends.', example='Always'),
  oversoldType?: string(name='OversoldType', description='The oversold resource usage type for the job, which can be not accepted, accepted, or only accepted.', example='AcceptQuotaOverSold'),
  pipelineId?: string(name='PipelineId', description='The pipeline ID.', example='pid-123456'),
  sanityCheckArgs?: string(name='SanityCheckArgs', description='The configuration parameters for computing power health checks.', example='--sanity-check-timing=AfterJobFaultTolerant --sanity-check-timeout-ops=MarkJobFai'),
  tags?: map[string]string(name='Tags', description='The custom labels.'),
}

