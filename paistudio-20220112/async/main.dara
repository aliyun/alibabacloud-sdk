  totalCPU?: int32(name='TotalCPU', description='The total number of CPU cores.', example='1000'),
  totalGPU?: int32(name='TotalGPU', description='The total number of GPU cards.', example='1'),
  totalMemory?: long(name='TotalMemory', description='The total memory in KB.', example='10240'),
  userId?: string(name='UserId', description='The user ID.', example='123456789'),
}

model Label {
  key?: string(name='Key', description='The key of the label.', example='testAccTag'),
  value?: string(name='Value', description='The value of the label.', example='nihao'),
