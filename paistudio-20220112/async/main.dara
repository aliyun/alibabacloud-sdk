/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'PaiStudio';
  @version = '2022-01-12';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'pai.cn-beijing.aliyuncs.com',
    'cn-hangzhou' = 'pai.cn-hangzhou.data.aliyun.com',
    'cn-shanghai' = 'pai.cn-shanghai.aliyuncs.com',
    'cn-shenzhen' = 'pai.cn-shenzhen.aliyuncs.com',
    'cn-hongkong' = 'pai.cn-hongkong.aliyuncs.com',
    'ap-southeast-1' = 'pai.ap-southeast-1.aliyuncs.com',
    'ap-southeast-2' = 'pai.ap-southeast-2.aliyuncs.com',
    'ap-southeast-3' = 'pai.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'pai.ap-southeast-5.aliyuncs.com',
    'us-east-1' = 'pai.us-east-1.aliyuncs.com',
    'us-west-1' = 'pai.us-west-1.aliyuncs.com',
    'eu-central-1' = 'pai.eu-central-1.aliyuncs.com',
    'ap-south-1' = 'pai.ap-south-1.aliyuncs.com',
    'me-east-1' = 'pai.me-east-1.aliyuncs.com',
    'ap-northeast-1' = 'pai.ap-northeast-1.aliyuncs.com',
    'cn-qingdao' = 'pai.cn-qingdao.aliyuncs.com',
    'cn-shanghai-finance-1' = 'pai.cn-shanghai-finance-1.aliyuncs.com',
    'cn-wulanchabu' = 'pai.cn-wulanchabu.aliyuncs.com',
    'cn-zhangjiakou' = 'pai.cn-zhangjiakou.aliyuncs.com',
    'cn-zhongwei' = 'pai.cn-zhongwei.aliyuncs.com',
    'ap-northeast-2' = 'pai.ap-northeast-2.aliyuncs.com',
    'cn-guangzhou' = 'pai.cn-guangzhou.aliyuncs.com',
    'ap-southeast-8' = 'pai.ap-southeast-8.aliyuncs.com',
    'us-southeast-1' = 'pai.us-southeast-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model ACS {
  ACSQuotaId?: string(name='ACSQuotaId', description='ACS resource ID.', example='rq-3kbt2gtimmyw7fgfgothocvh'),
  associatedProducts?: [ string ](name='AssociatedProducts', description='Product codes that can use the ACS Quota.

Constraints:  
You can select multiple sub-products, but some sub-products are mutually exclusive. The following combinations can be selected simultaneously:  
- PAI-DLC, PAI-DSW  
- PAI-EAS'),
}

model Action {
  actionType?: string(name='ActionType', description='The operation type.', example='Defrag'),
}

model AlgorithmSpec {
  codeDir?: Location(name='CodeDir', description='The custom code configuration.'),
  command: [ string ](name='Command', description='The list of commands to run the training task.

This parameter is required.'),
  computeResource?: {
    policy: {
      value: string(name='Value', description='Policy content, serialized from a JSON array.

This parameter is required.', example='[{\\\\"MinTotalCount\\\\":1,\\\\"MaxTotalCount\\\\":4,\\\\"RolePolicies\\\\":{\\\\"chief\\\\":{\\\\"Count\\\\":1},\\\\"ps\\\\":{\\\\"Count\\\\":1},\\\\"worker\\\\":{\\\\"Percentage\\\\":100}}},{\\\\"MinTotalCount\\\\":5,\\\\"MaxTotalCount\\\\":10,\\\\"RolePolicies\\\\":{\\\\"chief\\\\":{\\\\"Count\\\\":1},\\\\"ps\\\\":{\\\\"Percentage\\\\":20},\\\\"worker\\\\":{\\\\"Percentage\\\\":80}}},{\\\\"MinTotalCount\\\\":11,\\\\"RolePolicies\\\\":{\\\\"chief\\\\":{\\\\"Count\\\\":1},\\\\"ps\\\\":{\\\\"Percentage\\\\":40},\\\\"worker\\\\":{\\\\"Percentage\\\\":60}}}]'),
      version: string(name='Version', description='Policy version.

This parameter is required.', example='V1'),
    }(name='Policy', description='Computing resource configuration policy for the algorithm.

This parameter is required.'),
  }(name='ComputeResource', description='The compute resource definition.'),
  customization?: {
    codeDir?: boolean(name='CodeDir', description='Indicates whether custom-mounted code is used.', example='true'),
  }(name='Customization', description='The custom configuration.'),
  hyperParameters?: [
    HyperParameterDefinition
  ](name='HyperParameters', description='The list of hyperparameter definitions.'),
  image: string(name='Image', description='The training runtime image.

This parameter is required.', example='registry.cn-shanghai.aliyuncs.com/pai-training/kmeans:v1.0.0'),
  inputChannels?: [
    Channel
  ](name='InputChannels', description='The list of input channels for the algorithm.'),
  jobType: string(name='JobType', description='The job type.

This parameter is required.', example='TFJob'),
  metricDefinitions?: [
    MetricDefinition
  ](name='MetricDefinitions', description='The list of metric definitions for the training task.'),
  outputChannels?: [
    Channel
  ](name='OutputChannels', description='The list of output channels for the algorithm.'),
  progressDefinitions?: {
    overallProgress?: {
      description?: string(name='Description', description='The description of the monitoring definition.', example='training progress'),
      regex?: string(name='Regex', description='The regular expression for monitoring.', example='^[0-9]+([.][0-9]+){0,1}$'),
    }(name='OverallProgress', description='Monitors training progress.'),
    remainingTime?: {
      description?: string(name='Description', description='The description of the monitoring definition.', example='training remaining time'),
      regex?: string(name='Regex', description='The regular expression for monitoring.', example='^[0-9]+([.][0-9]+){0,1}$'),
    }(name='RemainingTime', description='The definition for monitoring the remaining training time.'),
  }(name='ProgressDefinitions', description='You can use this feature to monitor the training progress.'),
  resourceRequirements?: [
    ConditionExpression
  ](name='ResourceRequirements', description='The resource requirements.'),
  supportedInstanceTypes?: [ string ](name='SupportedInstanceTypes', description='The list of supported elastic computing instance types for training.'),
  supportsDistributedTraining?: boolean(name='SupportsDistributedTraining', description='Indicates whether distributed training is supported.', example='true'),
}

model AllocateStrategySpec {
  nodeSpecs?: [
    NodeSpec
  ](name='NodeSpecs'),
}

model AllocatedHyperNodeDetail {
  allocatedNodeNum?: long(name='AllocatedNodeNum', description='The number of allocated nodes.', example='0'),
  emptyNodeNum?: long(name='EmptyNodeNum', description='The number of idle nodes.', example='0'),
  hyperNodeName?: string(name='HyperNodeName', description='The name of the hypernode.', example='mg123456'),
  totalNodeNum?: long(name='TotalNodeNum', description='The total number of nodes.', example='0'),
}

model AssignNodeSpec {
  antiAffinityNodeNames?: string(name='AntiAffinityNodeNames', description='The anti-affinity node names.', example='node3'),
  enableAssignNode?: boolean(name='EnableAssignNode', description='Specifies whether to enable the specified node.'),
  nodeNames?: string(name='NodeNames', description='The node names.', example='lingjxxxx'),
}

model AssumeUserInfo {
  accessKeyId?: string(name='AccessKeyId', description='The AccessKey ID of the temporary access credential.', example='STS.L4aBSCSJVMuKg5U1****'),
  id?: string(name='Id', description='The ID of the assumed user.'),
  securityToken?: string(name='SecurityToken', description='The temporary security token.', example='********'),
  type?: string(name='Type', description='The identity type of the assumed user.'),
}

model BindingPolicy {
  excludeNodes?: [ string ](name='ExcludeNodes', description='A list of node IDs to exclude from scheduling.'),
  includeNodes?: [ string ](name='IncludeNodes', description='A list of node IDs to include in the scheduling.'),
  nodeSpecCount?: long(name='NodeSpecCount', description='The number of nodes to be selected by the scheduler.', example='5'),
}

model CacheInfo {
  mountPoint?: string(name='MountPoint', description='The mount point address of the datasource for service registration in the cache service, such as an OSS Bucket path or a CPFS path.', example='oss://your-bucket.oss-cn-wulanchabu-internal.aliyuncs.com/'),
  port?: string(name='Port', description='The port number that the cache service provides for external access to the datasource. The client must access cached data through this port.', example='10080'),
}

model CacheService {
  cacheInfos?: [
    CacheInfo
  ](name='CacheInfos', description='The list of connected data source cache information for the cache service, where each element corresponds to a data source and its access port.'),
  cacheServiceId?: string(name='CacheServiceId', description='The ID of the cache service, which is the unique identifier of the cache service.', example='cachea1b2c3d4e5f'),
  clusterId?: string(name='ClusterId', description='The ID of the cluster where the cache service is located.', example='c1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6'),
  createdBy?: string(name='CreatedBy', description='The ID of the resource quota that created the cache service.', example='quota1a2b3c4d5e6'),
  gmtCreated?: string(name='GmtCreated', description='The time when the cache service was created, in UTC and ISO 8601 format.', example='2026-08-10T03:17:31Z'),
  isSharded?: boolean(name='IsSharded', description='Indicates whether the service discovery of the cache service uses the shard mode.'),
  networkType?: string(name='NetworkType', description='The type of RDMA network interface controller (NIC) used by the cache service. This parameter is returned only when SupportRDMA is true. Valid values: eic: EIC NIC. mlx: Mellanox NIC. If RDMA is not enabled, this parameter is empty.', example='eic'),
  quotaId?: string(name='QuotaId', description='The ID of the resource quota to which the cache service belongs.', example='quota1a2b3c4d5e6'),
  status?: string(name='Status', description='The current status of the cache service.', example='Running'),
  supportRDMA?: string(name='SupportRDMA', description='Indicates whether the cache service supports access over an RDMA network.', example='true'),
  supportedClientQuotaIds?: [ string ](name='SupportedClientQuotaIds', description='The list of client quota IDs that are allowed to access the cache service.'),
  tenantId?: string(name='TenantId', description='The ID of the tenant to which the cache service belongs, which is the Alibaba Cloud account ID.', example='1234567890123456'),
  userId?: string(name='UserId', description='The ID of the user who created the cache service.', example='123456789012345678'),
  userVpc?: UserVpc(name='UserVpc', description='The user VPC network information of the cache service, including configurations such as the VPC, vSwitch, and security group.'),
}

model CapacityLock {
  availableCount?: int32(name='availableCount', description='The number of available instances.', example='3'),
  crsReservationId?: string(name='crsReservationId', description='The ID of the capacity reservation.'),
  description?: string(name='description', description='The description of the capacity reservation.', example='Test capacity reservation'),
  expireTime?: string(name='expireTime', description='The expiration time of the capacity reservation.'),
  gmtCreated?: string(name='gmtCreated', description='The creation time.'),
  gmtModified?: string(name='gmtModified', description='The modification time.'),
  id?: string(name='id', description='The ID of the capacity reservation lock record.'),
  instanceType?: string(name='instanceType', description='The instance type.', example='ml.gp7vf.16.40xlarge'),
  lastReconcileAttemptTime?: string(name='lastReconcileAttemptTime', description='The time of the last reconciliation attempt.'),
  lastSyncTime?: string(name='lastSyncTime', description='The last synchronization time.'),
  lockProvider?: string(name='lockProvider', description='The lock service provider.'),
  lockedCount?: int32(name='lockedCount', description='The number of locked instances.', example='4'),
  operator?: string(name='operator', description='The operator.'),
  paymentType?: string(name='paymentType', description='The billing method.'),
  privatePoolId?: string(name='privatePoolId', description='The ID of the private pool.'),
  requestedCount?: int32(name='requestedCount', description='The number of requested instances.', example='4'),
  status?: string(name='status', description='The status.'),
  tenantId?: string(name='tenantId', description='The ID of the tenant.'),
  usedCount?: int32(name='usedCount', description='The number of used instances.', example='1'),
  zoneId?: string(name='zoneId', description='The zone ID.', example='cn-wulanchabu-a'),
}

model Channel {
  description?: string(name='Description', description='Channel description.', example='模型输出。'),
  name: string(name='Name', description='Channel name.

This parameter is required.', example='Model'),
  properties?: map[string]any(name='Properties', description='Storage configuration of the channel.', example='{}'),
  required?: boolean(name='Required', description='Indicates whether the channel must be configured.', example='true'),
  supportedChannelTypes?: [ string ](name='SupportedChannelTypes', description='List of storage classes supported by the channel.'),
}

model ChannelProperty {
  name: string(name='Name', description='This parameter is required.', example='SKlearn'),
  value: string(name='Value', description='This parameter is required.', example='Framework'),
}

model ClusterSpec {
  clusterType?: string(name='ClusterType', description='The cluster type.', example='RayCluster'),
  dataSources?: [
    DataSource
  ](name='DataSources', description='The datasource config.'),
  image?: string(name='Image', description='The container image address.', example='registry.cn-shanghai.aliyuncs.com/pai-training/kmeans:v1.0.0'),
}

model ComponentSpec {
  codeDir?: Location(name='CodeDir', description='The code directory configuration.'),
  command: string(name='Command', description='The command used for submit the job.

This parameter is required.'),
  hyperParameters?: [
    HyperParameterDefinition
  ](name='HyperParameters', description='The hype parameter used by the algorithm.'),
  image: string(name='Image', description='The docker image used by the job of this algorithm.

This parameter is required.', example='registry.cn-shanghai.aliyuncs.com/pai-training/kmeans:v1.0.0'),
  inputChannels?: [
    Channel
  ](name='InputChannels', description='The input for the algorithm.'),
  jobType: string(name='JobType', description='Job type of the training job while running the algorithm.

This parameter is required.', example='TFJob'),
  metricDefinitions?: [
    MetricDefinition
  ](name='MetricDefinitions', description='The output metrics of the algorithm.'),
  outputChannels?: [
    Channel
  ](name='OutputChannels', description='The outputs of the algorithm.'),
  resourceRequirements?: [
    ConditionExpression
  ](name='ResourceRequirements', description='Resource requirements.'),
}

model ConditionExpression {
  key: string(name='Key', description='The type of required resource.

This parameter is required.', example='SupportedMachineTypes'),
  operator: string(name='Operator', description='The criterion for evaluation.

This parameter is required.', example='in'),
  values: [ string ](name='Values', description='List of resource values.

This parameter is required.'),
}

model CredentialConfig {
  aliyunEnvRoleKey?: string(name='AliyunEnvRoleKey', description='The Alibaba Cloud environment role identifier.', example='0'),
  credentialConfigItems?: [
    CredentialConfigItem
  ](name='CredentialConfigItems', description='The credential configuration items.'),
  enableCredentialInject?: boolean(name='EnableCredentialInject', description='Specifies whether credential injection is enabled.'),
}

model CredentialConfigItem {
  key?: string(name='Key', description='The configuration key.', example='0'),
  roles?: [
    CredentialRole
  ](name='Roles', description='The role configuration.'),
  type?: string(name='Type', description='The credential configuration type.', example='Role'),
}

model CredentialRole {
  assumeRoleFor?: string(name='AssumeRoleFor', description='The entity that uses the role credentials.'),
  assumeUserInfo?: AssumeUserInfo(name='AssumeUserInfo', description='The user information for role assumption.'),
  policy?: string(name='Policy', description='The access policy.'),
  roleArn?: string(name='RoleArn', description='The ARN of the RAM role.', example='acs:ram::1157703270994901:role/aliyunserviceroleforpaiworkspace'),
  roleType?: string(name='RoleType', description='The role type.', example='user'),
}

model DataSource {
  dataSourceId?: string(name='DataSourceId', description='The data source ID.', example='data-source-1'),
  mountPath?: string(name='MountPath', description='The mount path of the data source.', example='/mnt/data/'),
