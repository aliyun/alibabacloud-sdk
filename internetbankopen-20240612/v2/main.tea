/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'InternetBankOpen';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'internetbankopen.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('internetbankopen', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model GetAiReportRequest {
  callId?: string(name='callId', example='call-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
  reportId?: string(name='reportId', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
}

model GetAiReportResponseBody = {
  data?: {
    report?: {
      contentExpiresAt?: string(name='ContentExpiresAt', example='2026-12-12T06:20:00Z'),
      downloadUrl?: string(name='DownloadUrl', example='https://reports.example.com/report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a.pdf'),
      reportId?: string(name='ReportId', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
      urlExpiresAt?: string(name='UrlExpiresAt', example='2026-11-12T06:25:00Z'),
    }(name='Report'),
    reportStatus?: string(name='ReportStatus', example='AVAILABLE'),
  }(name='Data'),
  requestId?: string(name='RequestId', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model GetAiReportResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetAiReportResponseBody(name='body'),
}

/**
 * @summary 查询AI报告
 *
 * @description 查询数据产品附带的 AI 报告状态，并在报告可用时返回临时下载地址。本接口是只读查询，不会再次调用数据服务方，也不会启动或重新生成报告。
 * callId 与 reportId 必须且只能提供一个，参数名大小写以本页定义为准。按次报告：先调用 InvokeDataProduct 获取 callId，再用 callId 查询；报告状态为 AVAILABLE 时，从 Report 获取下载地址。周期报告：先调用 ListProductReports 获取 ReportId，再将该编号作为 reportId 查询；按周期商品的 callId 查询始终返回 WAITING_PERIOD，即使对应周期报告已经生成，也不会返回下载地址。内部任务编号不是本接口的查询键。
 * 查询范围限定为当前云账号（主账号）所属的调用和报告；编号不存在或不属于该账号时，均返回 ReportNotFound（HTTP 404），不区分两种原因。使用 RAM 身份调用时，由网关校验 internetbank:GetAiReport 操作权限。
 * 仅 ReportStatus 为 AVAILABLE 时返回 Report 对象。DownloadUrl 为临时签名下载地址，签发有效期不超过 300 秒，且不晚于 ContentExpiresAt；应在 UrlExpiresAt 前使用，不要公开分享。链接到期而报告内容仍在保留期内时，可以再次查询获取新链接。报告过期或被暂停交付时不返回下载地址；对象核验或签名等交付异常返回 ReportDeliveryFailed（HTTP 500）。参数不合法返回对应的 InvalidParameter 类错误（HTTP 400）。
 *
 * @param request GetAiReportRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return GetAiReportResponse
 */
@context("getAiReportWithContext")
async function getAiReportWithOptions(request: GetAiReportRequest, headers: map[string]string, runtime: $RuntimeOptions): GetAiReportResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.callId)) {
    query['callId'] = request.callId;
  }
  if (!$isNull(request.reportId)) {
    query['reportId'] = request.reportId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'GetAiReport',
    version = '2024-06-12',
    protocol = 'HTTPS',
    pathname = `/pop/api/v1/ai-report`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 查询AI报告
 *
 * @description 查询数据产品附带的 AI 报告状态，并在报告可用时返回临时下载地址。本接口是只读查询，不会再次调用数据服务方，也不会启动或重新生成报告。
 * callId 与 reportId 必须且只能提供一个，参数名大小写以本页定义为准。按次报告：先调用 InvokeDataProduct 获取 callId，再用 callId 查询；报告状态为 AVAILABLE 时，从 Report 获取下载地址。周期报告：先调用 ListProductReports 获取 ReportId，再将该编号作为 reportId 查询；按周期商品的 callId 查询始终返回 WAITING_PERIOD，即使对应周期报告已经生成，也不会返回下载地址。内部任务编号不是本接口的查询键。
