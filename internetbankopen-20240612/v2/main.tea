 * 仅 ReportStatus 为 AVAILABLE 时返回 Report 对象。DownloadUrl 为临时签名下载地址，签发有效期不超过 300 秒，且不晚于 ContentExpiresAt；应在 UrlExpiresAt 前使用，不要公开分享。链接到期而报告内容仍在保留期内时，可以再次查询获取新链接。报告过期或被暂停交付时不返回下载地址；对象核验或签名等交付异常返回 ReportDeliveryFailed（HTTP 500）。参数不合法返回对应的 InvalidParameter 类错误（HTTP 400）。
 *
 * @param request GetAiReportRequest
 * @return GetAiReportResponse
 */
async function getAiReport(request: GetAiReportRequest): GetAiReportResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return getAiReportWithOptions(request, headers, runtime);
}

model InvokeDataProductRequest {
  clientToken?: string(name='clientToken', description='The customer transaction serial number used for idempotence. This parameter is required for business purposes. If it is missing, MissingParameter.ClientToken is returned. Only 1 to 64 ASCII letters, digits, periods (.), underscores (_), or hyphens (-) are allowed. It is case-sensitive and leading and trailing spaces are not trimmed. If the format is invalid, InvalidParameter.ClientToken is returned. The ClientToken is globally unique under the same Alibaba Cloud account and is not product-specific. When you retry with the same parameters, the result of the first call and the original CallId are returned, and the data service provider is not called again. If the first request is still being processed, RequestInProgress (HTTP 409) is returned. Retry with the original parameters later. If the same ClientToken is used with a different ProductCode or ServiceParameters, IdempotentParameterMismatch is returned. Use a new serial number. If the result is not obtained due to a network interruption, retry with the original ClientToken and do not change the serial number.', example='a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d'),
  productCode?: string(name='productCode', description='The commodity code of the data product, used to identify the data product invoked in this call. The gateway uses this code to complete product authorization and route the request to the corresponding data service provider. This parameter is required for business purposes. If it is missing, MissingParameter.ProductCode is returned. If the code is not registered or is deactivated, InvalidParameter.ProductCode is returned. If the current account has not activated the product, Forbidden.ProductNotAuthorized is returned.', example='cloudsec.demo.v1'),
  serviceParameters?: string(name='serviceParameters', description='The business element package, which must be a JSON object serialized as a string. It carries the business parameters required for this data product invocation. This parameter is required for business purposes. If it is missing, MissingParameter.ServiceParameters is returned. For sensitive information such as mobile phone numbers and ID card numbers, only digests are passed, and plaintext is not allowed. If plaintext fields such as mobile or certNo are passed, InvalidParameter.ServiceParameters is returned. Fields ending with Sha256 must be 64-character hexadecimal strings, and fields ending with Md5 must be 32-character hexadecimal strings. Uppercase letters are automatically converted to lowercase. The specific required elements are determined by the product corresponding to the ProductCode. For example, some products require at least one of mobileSha256 and mobileMd5. If required elements are missing, the JSON is invalid, or the digest format is incorrect, InvalidParameter.ServiceParameters is returned.', example='{"mobileMd5":"25f9e794323b453885f5181f1b624d0b","certNoSha256":"a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3"}'),
}

model InvokeDataProductResponseBody = {
  data?: string(name='data', description='The business result of this invocation, which is a JSON object. If the invocation is successful, it contains: contractVersion (the contract version, fixed as PRODUCT_CALL_V1), callId (the invocation ID, in the format of call- followed by a UUID, used for querying AI reports and troubleshooting), dataStatus (FOUND indicates that data is found, and NOT_FOUND indicates that no data is found), extend (the business result returned by the data service provider, passed through as is. The specific structure depends on the data product and may not be returned if no data is found), and reportMode (the product report mode: NONE indicates no report, PER_CALL indicates that a report is generated for each invocation, and WEEKLY indicates that a report is generated on a weekly basis). If the invocation fails or the first request is still being processed, contractVersion and callId are still returned if an invocation ID has been assigned, to facilitate retrying with the original ClientToken.', example='{"contractVersion":"PRODUCT_CALL_V1","callId":"call-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a","dataStatus":"FOUND","extend":"{\\\\"score\\\\":\\\\"650\\\\"}","reportMode":"NONE"}'),
  requestId?: string(name='requestId', description='The unique identity of this request, generated by the gateway (obtained from x-acs-req-uuid). It is used for troubleshooting and Tracing Analysis.', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model InvokeDataProductResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: InvokeDataProductResponseBody(name='body'),
}

/**
 * @summary Provides a unified entry point to invoke data products.
 *
 * @description Provides a unified entry point to invoke data products. After the gateway completes identity parsing, RAM authentication, and product authorization, it forwards the request to the data service provider corresponding to the data product and returns the business data. If the invocation is successful, HTTP 200 is returned, and the response body contains RequestId and Data. If the invocation fails, the corresponding HTTP status code is returned (400 for parameter errors, 403 for no permissions or inactive products, 409 if the first request with the same ClientToken is still being processed, 429 for throttled requests, 503 for temporarily unavailable services, and 500 for internal errors), and the response body includes Code and Message to explain the cause.
 * This operation accepts only three business parameters: ClientToken, ProductCode, and ServiceParameters. It does not accept TaskId, Operation, parameters starting with Ai, or EnableAiArtifact (including when set to false). If these are passed, an InvalidParameter error is returned. Whether a product includes an AI report is determined by the product configuration corresponding to the ProductCode. For products that include reports, you can call ListProductReports to query the report list, and use GetAiReport to retrieve the report by CallId or ReportId.
 * Prerequisites for invocation: When calling this operation with a RAM user, you must first grant the RAM user the operation permissions for this operation in RAM. Set Action to internetbank:InvokeDataProduct and Resource to acs:internetbank:*:<your Alibaba Cloud account UID>:*. No additional authorization is required when calling this operation directly with the AccessKey of an Alibaba Cloud account.
 * Service-linked role: After the preceding authorization is completed, the system performs automatic creation of the service-linked role (SLR) AliyunServiceRoleForInternetBankPredict under your Alibaba Cloud account. This role is used to invoke the corresponding data service provider on behalf of the customer as a service. You can view the invocation records that associate with your account in ActionTrail.
 *
 * @param request InvokeDataProductRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return InvokeDataProductResponse
 */
@context("invokeDataProductWithContext")
async function invokeDataProductWithOptions(request: InvokeDataProductRequest, headers: map[string]string, runtime: $RuntimeOptions): InvokeDataProductResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.clientToken)) {
    query['clientToken'] = request.clientToken;
  }
  if (!$isNull(request.productCode)) {
    query['productCode'] = request.productCode;
  }
  if (!$isNull(request.serviceParameters)) {
    query['serviceParameters'] = request.serviceParameters;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'InvokeDataProduct',
    version = '2024-06-12',
    protocol = 'HTTPS',
    pathname = `/pop/api/v1/rpc`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Provides a unified entry point to invoke data products.
 *
 * @description Provides a unified entry point to invoke data products. After the gateway completes identity parsing, RAM authentication, and product authorization, it forwards the request to the data service provider corresponding to the data product and returns the business data. If the invocation is successful, HTTP 200 is returned, and the response body contains RequestId and Data. If the invocation fails, the corresponding HTTP status code is returned (400 for parameter errors, 403 for no permissions or inactive products, 409 if the first request with the same ClientToken is still being processed, 429 for throttled requests, 503 for temporarily unavailable services, and 500 for internal errors), and the response body includes Code and Message to explain the cause.
 * This operation accepts only three business parameters: ClientToken, ProductCode, and ServiceParameters. It does not accept TaskId, Operation, parameters starting with Ai, or EnableAiArtifact (including when set to false). If these are passed, an InvalidParameter error is returned. Whether a product includes an AI report is determined by the product configuration corresponding to the ProductCode. For products that include reports, you can call ListProductReports to query the report list, and use GetAiReport to retrieve the report by CallId or ReportId.
 * Prerequisites for invocation: When calling this operation with a RAM user, you must first grant the RAM user the operation permissions for this operation in RAM. Set Action to internetbank:InvokeDataProduct and Resource to acs:internetbank:*:<your Alibaba Cloud account UID>:*. No additional authorization is required when calling this operation directly with the AccessKey of an Alibaba Cloud account.
 * Service-linked role: After the preceding authorization is completed, the system performs automatic creation of the service-linked role (SLR) AliyunServiceRoleForInternetBankPredict under your Alibaba Cloud account. This role is used to invoke the corresponding data service provider on behalf of the customer as a service. You can view the invocation records that associate with your account in ActionTrail.
 *
