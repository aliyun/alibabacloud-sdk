}

model ListProductReportsRequest {
  latestOnly?: boolean(name='LatestOnly'),
  productCode?: string(name='ProductCode', description='This parameter is required.', example='cloudsec.demo.v1'),
}

model ListProductReportsResponseBody = {
  data?: {
    reports?: [ 
      {
        periodEnd?: string(name='PeriodEnd', example='2026-11-08T16:00:00Z'),
        periodStart?: string(name='PeriodStart', example='2026-11-01T16:00:00Z'),
        productCode?: string(name='ProductCode', example='cloudsec.demo.v1'),
        reportId?: string(name='ReportId', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
      }
    ](name='Reports'),
  }(name='Data'),
  requestId?: string(name='RequestId', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model ListProductReportsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListProductReportsResponseBody(name='body'),
}

/**
 * @summary 查询商品周期报告列表
 *
 * @description 查询当前云账号（主账号）下指定商品已经生成的可用周期报告。列表只用于发现报告编号和所属周期，不返回下载地址；取得 ReportId 后，调用 GetAiReport，并将该编号作为 reportId 获取最新状态及下载地址。本接口不会调用数据服务方，也不会触发报告生成。
 * LatestOnly 省略或为 false 时，在最近十个已结束的北京时间自然周范围内查询，按周期从新到旧返回，最多十条报告记录；没有报告的周不会补空记录，不保证返回十份报告。LatestOnly 为 true 时，从所有已结束的历史周期中查找最近一条可用报告，最多返回一条，不受最近十周范围限制。
 * 自然周按北京时间（Asia/Shanghai）计算，从周一 00:00:00 到下一周周一 00:00:00，区间左闭右开，不包含当前尚未结束的自然周。PeriodStart 与 PeriodEnd 使用 UTC RFC 3339 格式输出。一个自然周可能对应多条报告记录，因此两条记录的周期起止相同不表示重复，使用 ReportId 区分。
 * 列表依据已发布报告的资产记录判断可用性，不返回已过期或被暂停交付的报告；实际下载状态以 GetAiReport 查询结果为准。没有可用报告时，成功返回空 Reports 数组，不返回 ReportNotFound。本接口只提供 ProductCode 和 LatestOnly 两个业务参数，不支持分页及自定义周期过滤；传入 PeriodStart、PageSize 或 NextToken 时返回对应的 InvalidParameter 类错误（HTTP 400）。
 * 使用 RAM 身份调用时，由网关校验 internetbank:ListProductReports 操作权限。查询只读取当前账号的既有报告，不再次检查商品商业开通状态。参数错误返回对应的 InvalidParameter 类错误（HTTP 400）；报告资产记录不一致或查询异常返回 ReportDeliveryFailed（HTTP 500）。
 *
 * @param request ListProductReportsRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ListProductReportsResponse
 */
@context("listProductReportsWithContext")
async function listProductReportsWithOptions(request: ListProductReportsRequest, headers: map[string]string, runtime: $RuntimeOptions): ListProductReportsResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.latestOnly)) {
    query['LatestOnly'] = request.latestOnly;
  }
  if (!$isNull(request.productCode)) {
    query['ProductCode'] = request.productCode;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'ListProductReports',
    version = '2024-06-12',
    protocol = 'HTTPS',
    pathname = `/pop/api/v1/product-reports`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 查询商品周期报告列表
 *
 * @description 查询当前云账号（主账号）下指定商品已经生成的可用周期报告。列表只用于发现报告编号和所属周期，不返回下载地址；取得 ReportId 后，调用 GetAiReport，并将该编号作为 reportId 获取最新状态及下载地址。本接口不会调用数据服务方，也不会触发报告生成。
