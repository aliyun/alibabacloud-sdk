/**
 *
 */
import GatewayClient;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @productId = 'InternetBankOpen';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'internetbankopen.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('internetbankopen', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model GetAiReportRequest {
  callId?: string(name='callId', description='The data call ID, which is obtained from the callId returned by InvokeDataProduct. You must specify either this parameter or reportId. You cannot specify both or leave both empty. The value must start with call- and be 1 to 64 characters in length. It can contain only ASCII letters, digits, underscores (_), and hyphens (-). The value is case-sensitive, and leading and trailing spaces are not trimmed. If the format is invalid, InvalidParameter.CallId is returned. If both parameters are specified or left empty, InvalidParameter.ReportReference is returned. This parameter is used to query the status of per-use reports. If you use this ID to query a periodic report, WAITING_PERIOD is always returned. Use the ReportId from the list instead.', example='call-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
  reportId?: string(name='reportId', description='The report ID, which is obtained from the ReportId returned by ListProductReports or the Report.ReportId in the previous available result of GetAiReport. You must specify either this parameter or callId. You cannot specify both or leave both empty. The value must start with report- and be 1 to 64 characters in length. It can contain only ASCII letters, digits, underscores (_), and hyphens (-). The value is case-sensitive, and leading and trailing spaces are not trimmed. If the format is invalid, InvalidParameter.ReportId is returned. If both parameters are specified or left empty, InvalidParameter.ReportReference is returned. You can only query reports that belong to the current Alibaba Cloud account.', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
}

model GetAiReportResponseBody = {
  data?: {
    report?: {
      contentExpiresAt?: string(name='ContentExpiresAt', description='The expiration time of the report content retention period. The time is in UTC RFC 3339 format, ends with Z, and may contain fractional seconds. No download URL is issued after this time. If the delivery is not suspended, EXPIRED is returned. If the delivery is also suspended, UNAVAILABLE is returned preferentially. This is the content expiration time, not the expiration time of a single URL.', example='2026-12-12T06:20:00Z'),
      downloadUrl?: string(name='DownloadUrl', description='The temporary signed download URL. Use the URL before UrlExpiresAt. The validity period of the signed URL does not exceed 300 seconds and is no later than ContentExpiresAt. If the URL expires but the content has not expired, you can query again to obtain a new URL. The example only shows the URL format and is not a real downloadable link. Use the complete URL in the actual response. Do not concatenate the URL yourself or share it publicly.', example='https://reports.example.com/report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a.pdf'),
      reportId?: string(name='ReportId', description='The unique ID of the report. You can use this ID as the reportId parameter to query the report again. This is the report asset ID, not an internal task ID.', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
      urlExpiresAt?: string(name='UrlExpiresAt', description='The expiration time of the current DownloadUrl. The time is in UTC RFC 3339 format, ends with Z, and may contain fractional seconds. You cannot use the URL after it expires, and this time is no later than ContentExpiresAt.', example='2026-11-12T06:25:00Z'),
    }(name='Report', description='The download information of the available report, which is returned only when ReportStatus is AVAILABLE. The report ownership and the corresponding object version are verified before the download.'),
    reportStatus?: string(name='ReportStatus', description='The report status. Valid values:
- NOT_APPLICABLE: The product does not include a report.
- WAITING_DATA: The data call result is not determined.
- NO_DATA: No data is found, and no per-use report is generated.
- WAITING_PERIOD: The query result for the callId of a periodic product. You must obtain the ReportId by calling ListProductReports and then query the report.
- QUEUED: The report task is queued.
- RUNNING: The report task is being processed.
- AVAILABLE: The report is available, and the Report object is returned in this response.
- FAILED: The data call or report generation failed.
- EXPIRED: The report content has expired.
- UNAVAILABLE: The delivery of the report is suspended.

You can query again later by using the same ID when the status is WAITING_DATA, QUEUED, or RUNNING. Repeated queries do not regenerate the report when the status is FAILED. The Report object is not returned unless the status is AVAILABLE.', example='AVAILABLE'),
  }(name='Data', description='The report query result, which contains ReportStatus. The Report object is included only when the report is available.'),
  requestId?: string(name='RequestId', description='The unique identity of the request, which is used for Tracing Analysis and troubleshooting. Provide this ID when you troubleshoot exceptions.', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model GetAiReportResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetAiReportResponseBody(name='body'),
}

/**
 * @summary Queries the report status and retrieves a temporary download URL for available reports.
 *
 * @description Queries the status of the AI report attached to a data product and returns a temporary download URL when the report is available. This operation is a read-only query. It does not call the data service provider again, nor does it start or regenerate the report.
 * You must specify either callId or reportId, but not both. The parameter names are case-sensitive as defined on this page. For per-use reports: first call InvokeDataProduct to obtain the callId, and then use the callId to query. When the report status is AVAILABLE, obtain the download URL from Report. For periodic reports: first call ListProductReports to obtain the ReportId, and then use this ID as reportId to query. Querying by the callId of a periodic product always returns WAITING_PERIOD. Even if the corresponding periodic report has been generated, no download URL is returned. Internal task IDs are not query keys for this operation.
 * The query scope is limited to the calls and reports that belong to the current Alibaba Cloud account. If the ID does not exist or does not belong to the account, ReportNotFound (HTTP 404) is returned without distinguishing between the two causes. When you call this operation as a RAM user, the gateway verifies the internetbank:GetAiReport operation permission.
 * The Report object is returned only when ReportStatus is AVAILABLE. DownloadUrl is a temporary signed download URL. The validity period of the signed URL does not exceed 300 seconds and is no later than ContentExpiresAt. Use the URL before UrlExpiresAt and do not share it publicly. If the URL expires but the report content is still within the retention period, you can query again to obtain a new URL. No download URL is returned when the report expires or its delivery is suspended. Delivery exceptions such as object verification or signing failures return ReportDeliveryFailed (HTTP 500). Invalid parameters return the corresponding InvalidParameter errors (HTTP 400).
 *
 * @param request GetAiReportRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return GetAiReportResponse
 */
@context("getAiReportWithContext")
async function getAiReportWithOptions(request: GetAiReportRequest, headers: map[string]string, runtime: $RuntimeOptions): GetAiReportResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.callId)) {
    query['callId'] = request.callId;
  }
  if (!$isNull(request.reportId)) {
    query['reportId'] = request.reportId;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'GetAiReport',
    version = '2024-06-12',
    protocol = 'HTTPS',
    pathname = `/pop/api/v1/ai-report`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Queries the report status and retrieves a temporary download URL for available reports.
 *
 * @description Queries the status of the AI report attached to a data product and returns a temporary download URL when the report is available. This operation is a read-only query. It does not call the data service provider again, nor does it start or regenerate the report.
 * You must specify either callId or reportId, but not both. The parameter names are case-sensitive as defined on this page. For per-use reports: first call InvokeDataProduct to obtain the callId, and then use the callId to query. When the report status is AVAILABLE, obtain the download URL from Report. For periodic reports: first call ListProductReports to obtain the ReportId, and then use this ID as reportId to query. Querying by the callId of a periodic product always returns WAITING_PERIOD. Even if the corresponding periodic report has been generated, no download URL is returned. Internal task IDs are not query keys for this operation.
 * The query scope is limited to the calls and reports that belong to the current Alibaba Cloud account. If the ID does not exist or does not belong to the account, ReportNotFound (HTTP 404) is returned without distinguishing between the two causes. When you call this operation as a RAM user, the gateway verifies the internetbank:GetAiReport operation permission.
 * The Report object is returned only when ReportStatus is AVAILABLE. DownloadUrl is a temporary signed download URL. The validity period of the signed URL does not exceed 300 seconds and is no later than ContentExpiresAt. Use the URL before UrlExpiresAt and do not share it publicly. If the URL expires but the report content is still within the retention period, you can query again to obtain a new URL. No download URL is returned when the report expires or its delivery is suspended. Delivery exceptions such as object verification or signing failures return ReportDeliveryFailed (HTTP 500). Invalid parameters return the corresponding InvalidParameter errors (HTTP 400).
 *
 * @param request GetAiReportRequest
 * @return GetAiReportResponse
 */
async function getAiReport(request: GetAiReportRequest): GetAiReportResponse {
  var runtime = new $RuntimeOptions{};
  var headers : map[string]string = {};
  return getAiReportWithOptions(request, headers, runtime);
}

model InvokeDataProductRequest {
  clientToken?: string(name='clientToken', description='The customer transaction serial number, used for idempotence. This parameter is required for business purposes. If it is missing, a MissingParameter.ClientToken error is returned. Only 1 to 64 ASCII letters, digits, periods (.), underscores (_), or hyphens (-) are allowed. It is case-sensitive and leading and trailing spaces are not trimmed. If the format is invalid, an InvalidParameter.ClientToken error is returned. The ClientToken is globally unique under the same Alibaba Cloud account, regardless of the product. When you retry with the same parameters, the result of the initial call and the original CallId are returned, and the data service provider is not called again. If the initial request is still being processed, a RequestInProgress error (HTTP 409) is returned. Retry with the original parameters later. If the same ClientToken is used with a different ProductCode or ServiceParameters, an IdempotentParameterMismatch error is returned. Use a new serial number. If the result is not obtained due to a network interruption, retry with the original ClientToken and do not change the serial number.', example='a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d'),
  productCode?: string(name='productCode', description='The commodity code of the data product, used to identify the data product invoked in this call. The gateway uses this code to complete product authorization and route the request to the corresponding data service provider. This parameter is required for business purposes. If it is missing, a MissingParameter.ProductCode error is returned. If the code is not registered or has been deactivated, an InvalidParameter.ProductCode error is returned. If the current account has not activated the product, a Forbidden.ProductNotAuthorized error is returned.', example='cloudsec.demo.v1'),
  serviceParameters?: string(name='serviceParameters', description='The complete package of business elements, which must be a JSON object serialized as a string. It carries the business parameters required for this data product call. This parameter is required for business purposes. If it is missing, a MissingParameter.ServiceParameters error is returned. For sensitive information such as mobile phone numbers and ID card numbers, only digests are passed, and plaintext is not allowed. If plaintext fields such as mobile or certNo are passed, an InvalidParameter.ServiceParameters error is returned. Fields ending with Sha256 must be 64-character hexadecimal strings, and fields ending with Md5 must be 32-character hexadecimal strings. Uppercase letters are automatically converted to lowercase. The specific required elements are determined by the product corresponding to the ProductCode. For example, some products require at least one of mobileSha256 and mobileMd5. If required elements are missing, the JSON is invalid, or the digest format is incorrect, an InvalidParameter.ServiceParameters error is returned.', example='{"mobileMd5":"25f9e794323b453885f5181f1b624d0b","certNoSha256":"a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3"}'),
}

model InvokeDataProductResponseBody = {
  data?: string(name='data', description='The business result of this call, which is a JSON object. A successful call includes: contractVersion (the contract version, fixed as PRODUCT_CALL_V1), callId (the call ID, in the format of call- followed by a UUID, used for querying AI reports and troubleshooting), dataStatus (FOUND indicates that data is found, and NOT_FOUND indicates that no data is found), extend (the business result returned by the data service provider, passed through as is. The specific structure depends on the data product and may not be returned if no data is found), and reportMode (the product report mode: NONE indicates no report, PER_CALL indicates that a report is generated for each call, and WEEKLY indicates that a report is generated on a weekly basis). If the call fails or the initial request is still being processed, contractVersion and callId are still returned if a call ID has been assigned, to facilitate retrying with the original ClientToken.', example='{"contractVersion":"PRODUCT_CALL_V1","callId":"call-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a","dataStatus":"FOUND","extend":"{\\\\"score\\\\":\\\\"650\\\\"}","reportMode":"NONE"}'),
  requestId?: string(name='requestId', description='The unique identity of the request, generated by the gateway (obtained from x-acs-req-uuid). It is used for troubleshooting and Tracing Analysis.', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model InvokeDataProductResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: InvokeDataProductResponseBody(name='body'),
}

/**
 * @summary Provides a unified entry point for invoking data products.
 *
 * @description Provides a unified entry point for invoking data products. After the gateway completes identity parsing, RAM authentication, and product authorization, it forwards the request to the data service provider corresponding to the data product and returns the business data. A successful call returns an HTTP 200 status code, and the response body contains RequestId and Data. A failed call returns the corresponding HTTP status code (400 for parameter errors, 403 for no permissions or unactivated services, 409 if the initial request with the same ClientToken is still being processed, 429 for throttled requests, 503 for temporarily unavailable services, and 500 for internal errors), and the response body uses Code and Message to explain the cause.
 * This operation accepts only three business parameters: ClientToken, ProductCode, and ServiceParameters. It does not accept TaskId, Operation, parameters starting with Ai, or EnableAiArtifact (including when set to false). Passing these parameters returns an InvalidParameter error. Whether a product includes an AI report is determined by the product configuration corresponding to the ProductCode. For products that include reports, you can call ListProductReports to query the report list, and use GetAiReport to retrieve the report by CallId or ReportId.
 * Authorization prerequisites: When calling this operation with a RAM user, you must first grant the RAM user the operation permissions for this operation in RAM. Set Action to internetbank:InvokeDataProduct and Resource to acs:internetbank:*:<your Alibaba Cloud account UID>:*. No additional authorization is required when calling this operation directly with the AccessKey of an Alibaba Cloud account.
 * Service-linked role: After the preceding authorization is completed, the system automatically creates the service-linked role (SLR) AliyunServiceRoleForInternetBankPredict under your Alibaba Cloud account. This role is used to invoke the corresponding data service provider on behalf of the customer as a service identity. You can view the related invocation records in ActionTrail of your account.
 *
 * @param request InvokeDataProductRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return InvokeDataProductResponse
 */
@context("invokeDataProductWithContext")
async function invokeDataProductWithOptions(request: InvokeDataProductRequest, headers: map[string]string, runtime: $RuntimeOptions): InvokeDataProductResponse {
  request.validate();
  var query : map[string]any = {};
  if (!$isNull(request.clientToken)) {
    query['clientToken'] = request.clientToken;
  }
  if (!$isNull(request.productCode)) {
    query['productCode'] = request.productCode;
  }
  if (!$isNull(request.serviceParameters)) {
    query['serviceParameters'] = request.serviceParameters;
  }

  var req = new OpenApiUtil.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'InvokeDataProduct',
    version = '2024-06-12',
    protocol = 'HTTPS',
    pathname = `/pop/api/v1/rpc`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Provides a unified entry point for invoking data products.
