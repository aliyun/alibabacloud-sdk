/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'InternetBankOpen';
  @version = '2024-06-12';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'internetbankopen.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model GetAiReportRequest {
  callId?: string(name='callId', description='The data call ID, which is obtained from the callId returned by InvokeDataProduct. You must specify either this parameter or reportId. You cannot specify both or leave both empty. The value must start with call- and be 1 to 64 characters in length. It can contain only ASCII letters, digits, underscores (_), and hyphens (-). The value is case-sensitive and leading and trailing spaces are not trimmed. If the format is invalid, InvalidParameter.CallId is returned. If both parameters are specified or left empty, InvalidParameter.ReportReference is returned. This parameter is used to query the status of per-use reports. Querying the status of periodic reports by this ID always returns WAITING_PERIOD. Use the ReportId from the list instead.', example='call-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a', position='Query'),
  reportId?: string(name='reportId', description='The report ID, which is obtained from the ReportId returned by ListProductReports or the Report.ReportId in the previous available result of GetAiReport. You must specify either this parameter or callId. You cannot specify both or leave both empty. The value must start with report- and be 1 to 64 characters in length. It can contain only ASCII letters, digits, underscores (_), and hyphens (-). The value is case-sensitive and leading and trailing spaces are not trimmed. If the format is invalid, InvalidParameter.ReportId is returned. If both parameters are specified or left empty, InvalidParameter.ReportReference is returned. You can only query reports that belong to the current Alibaba Cloud account.', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a', position='Query'),
}

model GetAiReportResponseBody = {
  data?: {
    report?: {
      contentExpiresAt?: string(name='ContentExpiresAt', description='The expiration time of the report content retention period. The time is in UTC RFC 3339 format, ends with Z, and may contain fractional seconds. No download URL is issued after this time. If the delivery is not suspended, EXPIRED is returned. If the delivery is also suspended, UNAVAILABLE is returned preferentially. This is the content expiration time, not the single-link expiration time.', example='2026-12-12T06:20:00Z'),
      downloadUrl?: string(name='DownloadUrl', description='The temporary signed download URL. Use the URL before UrlExpiresAt. The validity period of the signed URL does not exceed 300 seconds and is no later than ContentExpiresAt. If the URL expires but the content has not expired, you can query again to obtain a new URL. The example only shows the URL format and is not a real downloadable link. Use the complete URL in the actual response. Do not concatenate the URL yourself or share it publicly.', example='https://reports.example.com/report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a.pdf'),
      reportId?: string(name='ReportId', description='The unique ID of the report. You can use this ID as the reportId parameter to query the report again. This is the report asset ID, not an internal task ID.', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
      urlExpiresAt?: string(name='UrlExpiresAt', description='The expiration time of the current DownloadUrl. The time is in UTC RFC 3339 format, ends with Z, and may contain fractional seconds. You cannot continue to use the URL after it expires, and this time is no later than ContentExpiresAt.', example='2026-11-12T06:25:00Z'),
    }(name='Report', description='The download information of the available report, which is returned only when ReportStatus is AVAILABLE. The report ownership and the corresponding object version are verified before the download.'),
    reportStatus?: string(name='ReportStatus', description='The report status. Valid values:
- NOT_APPLICABLE: The product does not include a report.
- WAITING_DATA: The data call result is not yet determined.
- NO_DATA: No data is found, and no per-use report is generated.
- WAITING_PERIOD: The query result for the callId of a periodic product. You must obtain the ReportId by calling ListProductReports and then query the status.
- QUEUED: The report task is queued.
- RUNNING: The report task is being processed.
- AVAILABLE: The report is available, and the Report object is returned in this response.
- FAILED: The data call or report generation failed.
- EXPIRED: The report content has expired.
- UNAVAILABLE: The delivery of the report is suspended.

You can query again later by using the same ID when the status is WAITING_DATA, QUEUED, or RUNNING. Repeated queries do not regenerate the report when the status is FAILED. The Report object is not returned unless the status is AVAILABLE.', example='AVAILABLE'),
  }(name='Data', description='The report query result, which includes ReportStatus. The Report object is included only when the report is available.'),
  requestId?: string(name='RequestId', description='The unique identity of the request, which is used for Tracing Analysis and troubleshooting. Provide this identity when you troubleshoot exceptions.', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model GetAiReportResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetAiReportResponseBody(name='body'),
}

/**
  * @description Queries the status of the AI report attached to a data product and returns a temporary download URL when the report is available. This operation is a read-only query. It does not call the data service provider again, nor does it initiate or regenerate the report.
  * You must provide either callId or reportId, but not both. The parameter names are case-sensitive as defined on this page. For per-use reports: call InvokeDataProduct to obtain the callId, and then use the callId to query the status. When the report status is AVAILABLE, obtain the download URL from Report. For periodic reports: call ListProductReports to obtain the ReportId, and then use the ID as reportId to query the status. Querying by the callId of a periodic product always returns WAITING_PERIOD. Even if the corresponding periodic report has been generated, no download URL is returned. Internal task IDs are not query keys for this operation.
  * The query scope is limited to the calls and reports that belong to the current Alibaba Cloud account. If the ID does not exist or does not belong to the account, ReportNotFound (HTTP 404) is returned without distinguishing between the two causes. When you call this operation as a RAM user, the gateway verifies the internetbank:GetAiReport permission.
  * The Report object is returned only when ReportStatus is AVAILABLE. DownloadUrl is a temporary signed download URL. The validity period of the signed URL does not exceed 300 seconds and is no later than ContentExpiresAt. Use the URL before UrlExpiresAt and do not share it publicly. If the URL expires but the report content is still within the retention period, you can query again to obtain a new URL. No download URL is returned when the report expires or its delivery is suspended. Delivery exceptions such as object verification or signing failures return ReportDeliveryFailed (HTTP 500). Invalid parameters return the corresponding InvalidParameter errors (HTTP 400).
  * @param request  the request parameters of GetAiReport  GetAiReportRequest
  * @return GetAiReportResponse
 */
async function getAiReport(request: GetAiReportRequest): GetAiReportResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetAiReport', 'POST', '/pop/api/v1/ai-report', 'json', false, 'json', request);
}

model InvokeDataProductRequest {
  clientToken?: string(name='clientToken', description='The customer transaction serial number used for idempotence. This parameter is required for business purposes. If it is missing, MissingParameter.ClientToken is returned. Only 1 to 64 ASCII letters, digits, periods (.), underscores (_), or hyphens (-) are allowed. It is case-sensitive and leading and trailing spaces are not trimmed. If the format is invalid, InvalidParameter.ClientToken is returned. The ClientToken is globally unique under the same Alibaba Cloud account and is not product-specific. When you retry with the same parameters, the result of the first call and the original CallId are returned, and the data service provider is not called again. If the first request is still being processed, RequestInProgress (HTTP 409) is returned. Retry with the original parameters later. If the same ClientToken is used with a different ProductCode or ServiceParameters, IdempotentParameterMismatch is returned. Use a new serial number. If the result is not obtained due to a network interruption, retry with the original ClientToken and do not change the serial number.', example='a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d', position='Query'),
  productCode?: string(name='productCode', description='The commodity code of the data product, used to identify the data product invoked in this call. The gateway uses this code to complete product authorization and route the request to the corresponding data service provider. This parameter is required for business purposes. If it is missing, MissingParameter.ProductCode is returned. If the code is not registered or is deactivated, InvalidParameter.ProductCode is returned. If the current account has not activated the product, Forbidden.ProductNotAuthorized is returned.', example='cloudsec.demo.v1', position='Query'),
  serviceParameters?: string(name='serviceParameters', description='The business element package, which must be a JSON object serialized as a string. It carries the business parameters required for this data product invocation. This parameter is required for business purposes. If it is missing, MissingParameter.ServiceParameters is returned. For sensitive information such as mobile phone numbers and ID card numbers, only digests are passed, and plaintext is not allowed. If plaintext fields such as mobile or certNo are passed, InvalidParameter.ServiceParameters is returned. Fields ending with Sha256 must be 64-character hexadecimal strings, and fields ending with Md5 must be 32-character hexadecimal strings. Uppercase letters are automatically converted to lowercase. The specific required elements are determined by the product corresponding to the ProductCode. For example, some products require at least one of mobileSha256 and mobileMd5. If required elements are missing, the JSON is invalid, or the digest format is incorrect, InvalidParameter.ServiceParameters is returned.', example='{"mobileMd5":"25f9e794323b453885f5181f1b624d0b","certNoSha256":"a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3"}', position='Query'),
}

model InvokeDataProductResponseBody = {
  data?: string(name='data', description='The business result of this invocation, which is a JSON object. If the invocation is successful, it contains: contractVersion (the contract version, fixed as PRODUCT_CALL_V1), callId (the invocation ID, in the format of call- followed by a UUID, used for querying AI reports and troubleshooting), dataStatus (FOUND indicates that data is found, and NOT_FOUND indicates that no data is found), extend (the business result returned by the data service provider, passed through as is. The specific structure depends on the data product and may not be returned if no data is found), and reportMode (the product report mode: NONE indicates no report, PER_CALL indicates that a report is generated for each invocation, and WEEKLY indicates that a report is generated on a weekly basis). If the invocation fails or the first request is still being processed, contractVersion and callId are still returned if an invocation ID has been assigned, to facilitate retrying with the original ClientToken.', example='{"contractVersion":"PRODUCT_CALL_V1","callId":"call-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a","dataStatus":"FOUND","extend":"{\\\\"score\\\\":\\\\"650\\\\"}","reportMode":"NONE"}'),
  requestId?: string(name='requestId', description='The unique identity of this request, generated by the gateway (obtained from x-acs-req-uuid). It is used for troubleshooting and Tracing Analysis.', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model InvokeDataProductResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: InvokeDataProductResponseBody(name='body'),
}

/**
  * @description Provides a unified entry point to invoke data products. After the gateway completes identity parsing, RAM authentication, and product authorization, it forwards the request to the data service provider corresponding to the data product and returns the business data. If the invocation is successful, HTTP 200 is returned, and the response body contains RequestId and Data. If the invocation fails, the corresponding HTTP status code is returned (400 for parameter errors, 403 for no permissions or inactive products, 409 if the first request with the same ClientToken is still being processed, 429 for throttled requests, 503 for temporarily unavailable services, and 500 for internal errors), and the response body includes Code and Message to explain the cause.
  * This operation accepts only three business parameters: ClientToken, ProductCode, and ServiceParameters. It does not accept TaskId, Operation, parameters starting with Ai, or EnableAiArtifact (including when set to false). If these are passed, an InvalidParameter error is returned. Whether a product includes an AI report is determined by the product configuration corresponding to the ProductCode. For products that include reports, you can call ListProductReports to query the report list, and use GetAiReport to retrieve the report by CallId or ReportId.
  * Prerequisites for invocation: When calling this operation with a RAM user, you must first grant the RAM user the operation permissions for this operation in RAM. Set Action to internetbank:InvokeDataProduct and Resource to acs:internetbank:*:<your Alibaba Cloud account UID>:*. No additional authorization is required when calling this operation directly with the AccessKey of an Alibaba Cloud account.
  * Service-linked role: After the preceding authorization is completed, the system performs automatic creation of the service-linked role (SLR) AliyunServiceRoleForInternetBankPredict under your Alibaba Cloud account. This role is used to invoke the corresponding data service provider on behalf of the customer as a service. You can view the invocation records that associate with your account in ActionTrail.
  * @param request  the request parameters of InvokeDataProduct  InvokeDataProductRequest
  * @return InvokeDataProductResponse
 */
async function invokeDataProduct(request: InvokeDataProductRequest): InvokeDataProductResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'InvokeDataProduct', 'POST', '/pop/api/v1/rpc', 'json', false, 'json', request);
}

model ListProductReportsRequest {
  latestOnly?: boolean(name='LatestOnly', description='Specifies whether to return only the most recent active epoch report. If this parameter is omitted or set to false, the operation returns active reports within the last ten completed natural weeks in UTC+8, up to ten records. If set to true, the operation queries the most recent active report from all completed historical epochs, returning at most one record without the ten-week limit. Only true or false is accepted. If a string is passed, it must strictly use the lowercase characters true or false. Other values return InvalidParameter.LatestOnly. This operation does not support paging.', position='Query'),
  productCode: string(name='ProductCode', description='The product code of the data product for which to query periodic reports. This must be consistent with the product code used when calling InvokeDataProduct. This parameter is required and allows only 1 to 128 ASCII letters, digits, periods (.), underscores (_), or hyphens (-). Leading and trailing spaces are not trimmed. If this parameter is missing or incorrectly formatted, InvalidParameter.ProductCode is returned. The query is limited to reports belonging to the current Alibaba Cloud account. If no available reports exist, an empty Reports array is returned.

This parameter is required.', example='cloudsec.demo.v1', position='Query'),
}

model ListProductReportsResponseBody = {
  data?: {
    reports?: [ 
      {
        periodEnd?: string(name='PeriodEnd', description='The end time of the natural week to which the report belongs, exclusive. The natural week ends at 00:00:00 on the following Monday in UTC+8 (Asia/Shanghai). This field is transformed to UTC RFC 3339 format and ends with Z. The example corresponds to 00:00:00 on Monday, November 9, 2026, UTC+8.', example='2026-11-08T16:00:00Z'),
        periodStart?: string(name='PeriodStart', description='The start time of the natural week to which the report belongs, inclusive. The natural week is calculated based on UTC+8 (Asia/Shanghai) and starts at 00:00:00 on Monday. This field is transformed to UTC RFC 3339 format and ends with Z. The example corresponds to 00:00:00 on Monday, November 2, 2026, UTC+8.', example='2026-11-01T16:00:00Z'),
        productCode?: string(name='ProductCode', description='The product code of the data product to which the report belongs. This is consistent with the ProductCode of the current request.', example='cloudsec.demo.v1'),
        reportId?: string(name='ReportId', description='The unique ID of the periodic report. Pass this value as the reportId parameter to GetAiReport to query the current status of the report and obtain the download URL when it is available.', example='report-3f2b8c1e-6d4a-4b7e-9a1c-2e5f7d8b9c0a'),
      }
    ](name='Reports', description='The available report records sorted by period from newest to oldest. By default, up to ten records are returned. If LatestOnly is set to true, at most one record is returned. The array is empty if no reports exist. A single natural week may have multiple report records. Use ReportId to distinguish them. The list does not contain download URLs. The actual download status is subject to the result of GetAiReport.'),
  }(name='Data', description='The query result of the periodic report list, which contains the Reports array. The array is empty if no available reports exist.'),
  requestId?: string(name='RequestId', description='The unique identity of the request, which is used for Tracing Analysis and troubleshooting. Provide this ID when troubleshooting exceptions.', example='9634F2B3-B59C-5475-BA9F-96D95271882C'),
}

model ListProductReportsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListProductReportsResponseBody(name='body'),
}

/**
  * @description Queries the available periodic reports generated for a specified product under the current Alibaba Cloud account. The list is used only to discover report IDs and their corresponding periods, and does not return download URLs. After obtaining a ReportId, call GetAiReport and pass the ID as the reportId parameter to retrieve the latest status and download URL. This operation does not call the data service provider or trigger report generation.
  * If LatestOnly is omitted or set to false, the operation queries reports within the last ten completed natural weeks in UTC+8 and returns up to ten report records sorted by epoch from newest to oldest. Empty records are not padded for weeks without reports, and ten reports are not guaranteed to be returned. If LatestOnly is set to true, the operation searches all completed historical epochs for the most recent active report and returns at most one record, without being limited to the last ten weeks.
  * A natural week is calculated based on UTC+8 (Asia/Shanghai), starting from 00:00:00 on Monday to 00:00:00 on the following Monday. The interval is left-closed and right-open, and does not include the current uncompleted natural week. PeriodStart and PeriodEnd are output in UTC RFC 3339 format. A single natural week may correspond to multiple report records. Therefore, identical epoch start and end times for two records do not indicate duplication. Use ReportId to distinguish them.
  * The list determines availability based on the asset records of published reports and does not return expired or suspended reports. The actual download status is subject to the query result of GetAiReport. If no available reports exist, an empty Reports array is returned successfully, and ReportNotFound is not returned. This operation provides only two business parameters, ProductCode and LatestOnly, and does not support pagination or custom period filtering. Passing PeriodStart, PageSize, or NextToken returns a corresponding InvalidParameter error (HTTP 400).
  * When called with a Resource Access Management (RAM) identity, the gateway verifies the internetbank:ListProductReports operation permission. The query only reads existing reports of the current account and does not recheck the commercial activation status of the product. Parameter errors return a corresponding InvalidParameter error (HTTP 400). Inconsistent report asset records or query exceptions return ReportDeliveryFailed (HTTP 500).
  * @param request  the request parameters of ListProductReports  ListProductReportsRequest
  * @return ListProductReportsResponse
 */
async function listProductReports(request: ListProductReportsRequest): ListProductReportsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ListProductReports', 'POST', '/pop/api/v1/product-reports', 'json', false, 'json', request);
}

