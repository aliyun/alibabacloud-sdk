model CreateLindormInstanceRequest {
  arbiterVSwitchId?: string(name='ArbiterVSwitchId', description='The vSwitch ID of the arbiter zone for a multi-zone instance. The vSwitch must be in the zone specified by ArbiterZoneId. **To create a multi-zone instance, this parameter is required.**', example='vsw-uf6664pqjawb87k36****', position='Query'),
  arbiterZoneId?: string(name='ArbiterZoneId', description='The zone ID of the arbiter zone for a multi-zone instance. **To create a multi-zone instance, this parameter is required.**', example='cn-shanghai-g', position='Query'),
  archVersion?: string(name='ArchVersion', description='The deployment architecture. Valid values:

- **1.0**: single-zone.
- **2.0**: multi-zone.

If this parameter is not specified, the default value is 1.0. To create a multi-zone instance, set this parameter to 2.0. **To create a multi-zone instance, this parameter is required.**', example='2.0', position='Query'),
  autoRenewDuration?: string(name='AutoRenewDuration', description='The auto-renewal duration. Unit: months.

Valid values: **1** to **12**.

> This parameter takes effect only when **AutoRenewal** is set to **true**.', example='1', position='Query'),
  autoRenewal?: boolean(name='AutoRenewal', description='Specifies whether to enable auto-renewal for the instance. Valid values:
- **true**: Auto-renewal is enabled.
- **false**: Auto-renewal is disabled.

Default value: false.

> This parameter takes effect only when **PayType** is set to **PREPAY** (subscription).', example='false', position='Query'),
  coldStorage?: int32(name='ColdStorage', description='The capacity cloud storage capacity of the instance. Unit: GB. If this parameter is not specified, capacity cloud storage is not enabled. Valid values: **800** to **1000000**.', example='800', position='Query'),
  coreSingleStorage?: int32(name='CoreSingleStorage', description='The storage capacity per core node for a multi-zone instance. Valid values: 400 to 64000. Unit: GB. **To create a multi-zone instance, this parameter is required.**', example='400', position='Query'),
  coreSpec?: string(name='CoreSpec', description='The node specifications for local disk type of the instance.

When the local storage type is local_ssd_pro, valid values are as follows. I3 instance types currently support only subscription:

- **lindorm.i4.xlarge**: 4 cores, 32 GB (I4).
- **lindorm.i4.2xlarge**: 8 cores, 64 GB (I4).
- **lindorm.i4.4xlarge**: 16 cores, 128 GB (I4).
- **lindorm.i4.8xlarge**: 32 cores, 256 GB (I4).
- **lindorm.i3.xlarge**: 4 cores, 32 GB (I3).
- **lindorm.i3.2xlarge**: 8 cores, 64 GB (I3).
- **lindorm.i3.4xlarge**: 16 cores, 128 GB (I3).
- **lindorm.i3.8xlarge**: 32 cores, 256 GB (I3).
- **lindorm.i2.xlarge**: 4 cores, 32 GB (I2).
- **lindorm.i2.2xlarge**: 8 cores, 64 GB (I2).
- **lindorm.i2.4xlarge**: 16 cores, 128 GB (I2).
- **lindorm.i2.8xlarge**: 32 cores, 256 GB (I2).

When the local storage type is local_hdd_pro, valid values are as follows:

- **lindorm.sd3c.3xlarge**: 14 cores, 56 GB (D3C PRO).
- **lindorm.sd3c.7xlarge**: 28 cores, 112 GB (D3C PRO).
- **lindorm.sd3c.14xlarge**: 56 cores, 224 GB (D3C PRO).
- **lindorm.d2c.6xlarge**: 24 cores, 88 GB (D2C).
- **lindorm.d2c.12xlarge**: 48 cores, 176 GB (D2C).
- **lindorm.d2c.24xlarge**: 96 cores, 352 GB (D2C).
- **lindorm.d2s.5xlarge**: 20 cores, 88 GB (D2S).
- **lindorm.d2s.10xlarge**: 40 cores, 176 GB (D2S).
- **lindorm.d1.2xlarge**: 8 cores, 32 GB (D1NE).
- **lindorm.d1.4xlarge**: 16 cores, 64 GB (D1NE).
- **lindorm.d1.6xlarge**: 24 cores, 96 GB (D1NE).', example='lindorm.i2.xlarge', position='Query'),
  diskCategory: string(name='DiskCategory', description='The storage type of the instance. Valid values:

- **cloud_efficiency**: standard cloud storage.
- **cloud_ssd**: performance cloud storage.
- **cloud_essd**: enhanced performance cloud storage.
- **cloud_essd_pl0**: performance cloud storage PL0.
- **capacity_cloud_storage**: capacity cloud storage (not supported for multi-zone instances).
- **local_ssd_pro**: local SSD (not supported for multi-zone instances).
- **local_hdd_pro**: local HDD (not supported for multi-zone instances).

This parameter is required.', example='cloud_efficiency', position='Query'),
  duration?: string(name='Duration', description='The subscription duration of the instance. Valid values:

- If PricingCycle is set to **Month**, valid values are **1** to **9**.
- If PricingCycle is set to **Year**, valid values are **1** to **3**.

> This parameter is available and required when PayType is set to **PREPAY**.', example='1', position='Query'),
  filestoreNum?: int32(name='FilestoreNum', description='The number of file engine nodes of the instance. Valid values:
- If the billing method of the instance is **PREPAY**, valid values are **0** to **60**.
- If the billing method of the instance is **POSTPAY**, valid values are **0** to **8**.', example='2', position='Query'),
  filestoreSpec?: string(name='FilestoreSpec', description='The file engine node specifications of the instance. Valid values:

- **lindorm.c.xlarge**: 4 cores, 8 GB (standard).', example='lindorm.c.xlarge', position='Query'),
  instanceAlias?: string(name='InstanceAlias', description='The name of the instance.', example='lindorm_test', position='Query'),
  instanceStorage?: string(name='InstanceStorage', description='The storage capacity of the instance. Unit: GB.', example='480', position='Query'),
  lindormNum?: int32(name='LindormNum', description='The number of LindormTable engine nodes of the instance.

To create a single-zone instance, valid values are **0** to **90**.

**To create a multi-zone instance, this parameter is required.** For instances with non-local disk storage types, valid values are **4** to **400**. For instances with local disk storage types, valid values are **6** to **400**.', example='2', position='Query'),
  lindormSpec?: string(name='LindormSpec', description='The LindormTable engine node specifications of the instance. Valid values:

- **lindorm.g.xlarge**: 4 cores, 16 GB (dedicated).
- **lindorm.c.2xlarge**: 8 cores, 16 GB (dedicated).
- **lindorm.g.2xlarge**: 8 cores, 32 GB (dedicated).
- **lindorm.c.4xlarge**: 16 cores, 32 GB (dedicated).
- **lindorm.g.4xlarge**: 16 cores, 64 GB (dedicated).
- **lindorm.c.8xlarge**: 32 cores, 64 GB (dedicated).
- **lindorm.g.8xlarge**: 32 cores, 128 GB (dedicated).', example='lindorm.g.4xlarge', position='Query'),
  logDiskCategory?: string(name='LogDiskCategory', description='The disk type of log nodes for a multi-zone instance. Valid values:

- **cloud_efficiency**: standard cloud storage.
- **cloud_ssd**: performance cloud storage.

**To create a multi-zone instance, this parameter is required.**', example='cloud_ssd', position='Query'),
  logNum?: int32(name='LogNum', description='The number of log nodes for a multi-zone instance. Valid values: 4 to 400. **To create a multi-zone instance, this parameter is required.**', example='4', position='Query'),
  logSingleStorage?: int32(name='LogSingleStorage', description='The storage capacity per log node for a multi-zone instance. Valid values: 400 to 64000. Unit: GB. **To create a multi-zone instance, this parameter is required.**', example='400', position='Query'),
  logSpec?: string(name='LogSpec', description='The log node specifications for a multi-zone instance. Valid values:
- **lindorm.sn1.large**: 4 cores, 8 GB (dedicated).
- **lindorm.sn1.2xlarge**: 8 cores, 16 GB (dedicated).

**To create a multi-zone instance, this parameter is required and active.**', example='lindorm.sn1.large', position='Query'),
  ltsNum?: string(name='LtsNum', description='The number of LTS engine nodes of the instance. Valid values: **0** to **60**.', example='2', position='Query'),
  ltsSpec?: string(name='LtsSpec', description='The LTS engine node specifications of the instance. Valid values:

- **lindorm.c.xlarge**: 4 cores, 8 GB (dedicated).
- **lindorm.g.xlarge**: 4 cores, 16 GB (dedicated).
- **lindorm.c.2xlarge**: 8 cores, 16 GB (dedicated).
- **lindorm.g.2xlarge**: 8 cores, 32 GB (dedicated).
- **lindorm.c.4xlarge**: 16 cores, 32 GB (dedicated).
- **lindorm.g.4xlarge**: 16 cores, 64 GB (dedicated).
- **lindorm.c.8xlarge**: 32 cores, 64 GB (dedicated).
- **lindorm.g.8xlarge**: 32 cores, 128 GB (dedicated).', example='lindorm.g.xlarge', position='Query'),
  multiZoneCombination?: string(name='MultiZoneCombination', description='The multi-zone combination. You can check the supported zone combinations on the buy page.

- **ap-southeast-5abc-aliyun**: Indonesia (Jakarta) A+B+C.
- **cn-hangzhou-ehi-aliyun**: China (Hangzhou) E+H+I.
- **cn-beijing-acd-aliyun**: China (Beijing) A+C+D.
- **ap-southeast-1-abc-aliyun**: Singapore A+B+C.
- **cn-zhangjiakou-abc-aliyun**: China (Zhangjiakou) A+B+C.
- **cn-shanghai-efg-aliyun**: China (Shanghai) E+F+G.
- **cn-shanghai-abd-aliyun**: China (Shanghai) A+B+D.
- **cn-hangzhou-bef-aliyun**: China (Hangzhou) B+E+F.
- **cn-hangzhou-bce-aliyun**: China (Hangzhou) B+C+E.
- **cn-beijing-fgh-aliyun**: China (Beijing) F+G+H.
- **cn-shenzhen-abc-aliyun**: China (Shenzhen) A+B+C.

**To create a multi-zone instance, this parameter is required.**', example='cn-shanghai-efg-aliyun', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', minimum=1, maximum=9223372036854775807, position='Query'),
  payType: string(name='PayType', description='The billing method of the instance. Valid values:

- **PREPAY**: subscription.
- **POSTPAY**: pay-as-you-go.

This parameter is required.', example='POSTPAY', position='Query'),
  pricingCycle?: string(name='PricingCycle', description='The billing cycle of the instance. Valid values:

- **Month**: monthly billing.
- **Year**: yearly billing.

> This parameter is available and required when PayType is set to **PREPAY**.', example='Month', position='Query'),
  primaryVSwitchId?: string(name='PrimaryVSwitchId', description='The vSwitch ID of the primary zone for a multi-zone instance. The vSwitch must be in the zone specified by PrimaryZoneId. **To create a multi-zone instance, this parameter is required.**', example='vsw-uf6fdqa7c0pipnqzq****', position='Query'),
  primaryZoneId?: string(name='PrimaryZoneId', description='The zone ID of the primary zone for a multi-zone instance. **To create a multi-zone instance, this parameter is required.**', example='cn-shanghai-e', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the instance. You can call [DescribeRegions](https://help.aliyun.com/document_detail/426062.html) to query available regions. Use this parameter to specify the region in which to create the instance.

This parameter is required.', example='cn-shanghai', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-aek2i6weeb4nfii', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', minimum=1, maximum=9223372036854775807, position='Query'),
  securityToken?: string(name='SecurityToken', position='Query'),
