> Before you add BGP configurations, we recommend that you understand the working mechanism and limits of BGP dynamic routing. For more information, see [Configure BGP dynamic routing](https://help.aliyun.com/document_detail/445767.html).', example='false', nullable=true),
  healthCheckConfig?: string(name='HealthCheckConfig', description='This parameter is supported when you modify a single-tunnel IPsec-VPN connection.', example='{"enable":"true","dip":"192.168.1.1","sip":"10.1.1.1","interval":"3","retry":"3","Policy": "revoke_route"}'),
