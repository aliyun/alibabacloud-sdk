      costAfterDiscount?: float(name='costAfterDiscount'),
      invoiceDiscount?: float(name='invoiceDiscount', description='The discount amount for this module. The value is calculated as invoiceDiscount = originalCost - costAfterDiscount and is precisely provided by the upstream BSS. Manual subtraction in tax-inclusive scenarios may cause precision loss.'),
      moduleCode?: string(name='moduleCode'),
      originalCost?: float(name='originalCost'),
      quantityUsedForQuote?: float(name='quantityUsedForQuote', description='The estimated usage used for pricing this module. This field has a value only when the caller passes a usage greater than 1 through PricingContext. In this case, costAfterDiscount is the total cost for this usage rather than the unit price. Refer to usageCharges[].pricePerUnit for the normalized unit price. This field is empty when no estimated usage is passed.'),
      unitPrice?: float(name='unitPrice', description='The unit price of this module per billing unit, such as CNY/hour, CNY/month, or CNY/unit. This is used to explain the composition of costAfterDiscount in multi-quantity or multi-period scenarios.'),
      usageUnit?: string(name='usageUnit', description='The usage unit, such as GB or CU. This field has a value when billingMode is \\\\"usage\\\\" and indicates the dimension of costAfterDiscount.'),
    }
  ](name='modules'),
  originalPrice?: float(name='originalPrice', description='The total original price before discounts for this pricing inquiry. When originalPrice differs from tradePrice or moduleSum, it indicates that a discount was applied, such as a first-purchase discount or a promotional campaign.'),
  pricingUnit?: string(name='pricingUnit', description='The billing cycle unit, such as \\\\"Hour\\\\", \\\\"1 Month\\\\", \\\\"12 Month\\\\", or \\\\"GB·Month\\\\", which indicates the time dimension of moduleSum. This field is not returned in the BSS response and must be explicitly declared by the mapping maintainer in pricingTarget.pricingUnit. It is optional for subscription scenarios because the CLI infers it from Period and PeriodUnit. However, it is required for pay-as-you-go scenarios in the mapping; otherwise, the amount has no dimension.'),
  quantity?: float(name='quantity', description='The pricing quantity from OpenAPI input parameters, such as Amount in ECS RunInstances. The moduleSum is the unit price per instance, and effectiveModuleSum = moduleSum × quantity is the total price. The caller should present the actual total price for N instances to the user based on this value to avoid mistaking the unit price for the total price.'),
  tradePrice?: float(name='tradePrice'),
  usageCharges?: [ 
    {
      assumedQuantity?: float(name='assumedQuantity', description='The estimated usage passed by the caller through PricingContext. This field has a value only when it is greater than 1. In this case, this entry also provides the assumedQuantityCost calculated based on this assumed usage.'),
      assumedQuantityCost?: float(name='assumedQuantityCost', description='The module cost calculated based on assumedQuantity, which equals pricePerUnit × assumedQuantity. This cost is not included in totalAmount because it is based on the assumed usage reported by the caller and is not a cost necessarily incurred by this call.'),
      moduleCode?: string(name='moduleCode', description='The billing module code, such as TrafficOut or NatCu. This corresponds to the moduleCode in modules.'),
      originalPricePerUnit?: float(name='originalPricePerUnit', description='The original unit price before discounts, in CNY/unit, which is also normalized. This field is empty when not provided by the upstream. The difference between this value and pricePerUnit is the unit price discount for this module.'),
      pricePerUnit?: float(name='pricePerUnit', description='The discounted unit price, in CNY/unit. The actual cost equals pricePerUnit × actual usage. Because the usage is unknown during pricing, it is not included in totalAmount. If the caller passed an estimated usage, the total returned by the upstream is normalized back to the unit price based on that usage.'),
      unit?: string(name='unit', description='The usage unit, such as GB, CU, or 10,000 requests. This comes from the module-level billing.unit annotation in the mapping. The dimension of pricePerUnit is CNY/unit.'),
    }
  ](name='usageCharges', description='The list of unit prices for pay-as-you-go, usage-based modules, such as CNY/GB or CNY/CU. The amounts for these modules are not included in moduleSum or effectiveModuleSum. This field is empty when there are no usage-based modules.'),
}

