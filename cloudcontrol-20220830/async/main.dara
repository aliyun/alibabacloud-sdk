import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'cloudcontrol';
  @version = '2022-08-30';
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-northeast-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-northeast-2' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-southeast-2' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-southeast-3' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-southeast-5' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-southeast-6' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-southeast-7' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'cn-beijing' = 'cloudcontrol.aliyuncs.com',
    'cn-chengdu' = 'cloudcontrol.aliyuncs.com',
    'cn-fuzhou' = 'cloudcontrol.aliyuncs.com',
    'cn-guangzhou' = 'cloudcontrol.aliyuncs.com',
    'cn-hangzhou' = 'cloudcontrol.aliyuncs.com',
    'cn-heyuan' = 'cloudcontrol.aliyuncs.com',
    'cn-hongkong' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'cn-huhehaote' = 'cloudcontrol.aliyuncs.com',
    'cn-nanjing' = 'cloudcontrol.aliyuncs.com',
    'cn-qingdao' = 'cloudcontrol.aliyuncs.com',
    'cn-shanghai' = 'cloudcontrol.aliyuncs.com',
    'cn-shenzhen' = 'cloudcontrol.aliyuncs.com',
    'cn-wulanchabu' = 'cloudcontrol.aliyuncs.com',
    'cn-zhangjiakou' = 'cloudcontrol.aliyuncs.com',
    'us-west-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'us-east-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'eu-west-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'eu-central-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'me-east-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'me-central-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
    'ap-south-1' = 'cloudcontrol.ap-southeast-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model CancelTaskRequest {
  taskId: string(name='taskId', description='The ID of the task.

This parameter is required.', example='task-433aead756057fff2913e7ce5****', position='Path'),
}

model CancelTaskResponseBody = {
  requestId?: string(name='requestId', description='The ID of a request.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
}

model CancelTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CancelTaskResponseBody(name='body'),
}

/**
  * @description Only tasks that are in the Pending or Running state can be canceled.
  * You can call the CancelTask operation to cancel a Cloud Control API task, but the tasks that have been started in the downstream Alibaba Cloud services cannot be canceled.
  * @param request  the request parameters of CancelTask  CancelTaskRequest
  * @return CancelTaskResponse
 */
async function cancelTask(request: CancelTaskRequest): CancelTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CancelTask', 'PUT', '/api/v1/tasks/{taskId}/operation/cancel', 'json', false, 'json', request);
}

model CreateResourceRequest {
  requestPath?: string(name='requestPath', description='The request path. Specify this parameter in the following format: /api/v1/providers/{provider}/products/{product}/resources/{resourceType}

Variables in the request path:

provider: the Cloud service provider. Only Aliyun is supported.

product: the code of the service.

resourceType: the type of resources. If parent resource is specified, the format is {parent resource type code}/parent resource ID/{resource type code}.', position='Path'),
  body?: map[string]any(name='body', description='The request body. The property of the resource, which is specified in JSON format.', example='{
     "AccountName": "cctest",
     "AccountPassword": "Aa1234****"
}', position='Body'),
  clientToken?: string(name='clientToken', description='The client token that is used to ensure the idempotence of the request. If a cloud service supports idempotence, the parameter takes effect.', example='1e810dfe1468721d0664a49b9d9f74f4', position='Query'),
  regionId?: string(name='regionId', description='The region ID. This parameter is required if a cloud service is a regionalized.', example='cn-beijing', position='Query'),
}

model CreateResourceResponseBody = {
  requestId?: string(name='requestId', description='The ID of a request.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
  resourceId?: string(name='resourceId', description='The ID of the resource.', example='cctest'),
  resourcePath?: string(name='resourcePath', description='The path of the resources. The relative resource ID. The resource path contains the complete resource location (parent resource/child resource).', example='Instance/r-8vbf5abe31c9c4d4/Account/cctest'),
  taskId?: string(name='taskId', description='The ID of the asynchronous task. If the operation is asynchronous, this field is returned. In this case, the HTTP status code 202 is returned.', example='task-433aead756057fff8189a7ce5****'),
}

model CreateResourceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateResourceResponseBody(name='body'),
}

/**
  * @description You can go to [OpenAPI Explorer](https://next.api.aliyun.com/cloudcontrol) to view the documentation and try out Cloud Control API.
  * @param request  the request parameters of CreateResource  CreateResourceRequest
  * @return CreateResourceResponse
 */
async function createResource(request: CreateResourceRequest): CreateResourceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateResource', 'POST', '{requestPath}', 'json', false, 'json', request);
}

model DeleteResourceRequest {
  requestPath?: string(name='requestPath', description='The URI of the request. The format is: /api/v1/providers/{provider}/products/{product}/resources/{resourceType}/{resourceId}

The variables in the request URI are described as follows:

provider: The cloud provider. Currently, only Aliyun is supported.

product: The product code.

resourceType: The resource type. If a parent resource exists, the format is `{parent resource type code}/{parent resource ID}/{resource type code}`.

resourceId: The resource ID.', position='Path'),
  clientToken?: string(name='clientToken', description='A client token to ensure idempotence. This parameter works only if the cloud product supports idempotence.', example='1e810dfe1468721d0664a49b9d9f74f4', position='Query'),
  filter?: map[string]any(name='filter', shrink='json', position='Query'),
  regionId?: string(name='regionId', description='The region ID. This parameter is required if the cloud product is region-specific.', example='cn-beijing', position='Query'),
}

model DeleteResourceResponseBody = {
  requestId?: string(name='requestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
  taskId?: string(name='taskId', description='The ID of the asynchronous task. The system returns this parameter for asynchronous operations. For these operations, the HTTP status code is 202.', example='task-433aead756057fff8189a7ce5****'),
}

model DeleteResourceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DeleteResourceResponseBody(name='body'),
}

/**
  * @description You can go to [OpenAPI Explorer](https://next.api.aliyun.com/cloudcontrol) to view resource documentation and try Cloud Control API.
  * @param request  the request parameters of DeleteResource  DeleteResourceRequest
  * @return DeleteResourceResponse
 */
async function deleteResource(request: DeleteResourceRequest): DeleteResourceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'DeleteResource', 'DELETE', '{requestPath}', 'json', false, 'json', request);
}

model GetApiPriceRequest {
  body?: map[string]any(name='body', description='The pricing request body, including popCode, popVersion, apiName, and parameters. All calls return a unified pricing envelope. The language parameter specifies the server-side message language, such as en or zh. Target resource operations are not executed for cost-irrelevant or unsupported pricing queries.', example='{"popCode":"ecs","popVersion":"2014-05-26","apiName":"CreateDisk","parameters":{"RegionId":"cn-hangzhou","ZoneId":"cn-hangzhou-i","DiskCategory":"cloud_essd","Size":40},"language":"zh"}', position='Body'),
}

model GetApiPriceResponseBody = {
  code?: string(name='code', description='The pricing result code. Valid values: Success, PricingNotRequired, PricingNotSupported, or an upstream pricing failure code.', example='Success'),
  message?: string(name='message', description='The server-side pricing result description. The language is specified by the language parameter in the request body and defaults to Chinese.', example='Pricing succeeded'),
  price?: {
    billingUnit?: string(name='billingUnit', description='The common billing dimension for fixed fees, including totalAmount, originalAmount, and discountAmount. This is a canonical field, such as \\\\"Hour\\\\" or \\\\"1 Month\\\\", derived from the pricingUnit declared in the mapping. It is empty if not declared. This field describes only the dimension for fixed fees. The pay-as-you-go billing method components each have their own unit (see usageCharges[].unit).'),
    calculatedAmount?: float(name='calculatedAmount'),
    chargeComposition?: string(name='chargeComposition', description='The billing composition. This is a canonical field. Valid values: recurring_only (all time-based fees), usage_only (all usage-based fees, where a totalAmount of 0 indicates no fixed fees rather than free of charge, and actual costs depend on the unit price and actual usage in usageCharges), or mixed (both, which should be displayed separately as \\\\"X CNY/hour + Y CNY/GB\\\\"). This allows the caller to choose the display text without iterating through modules to determine the composition.'),
    components?: map[string]PriceComponentsValue(name='components', description='The details of each pricing call in composite or delta mode. The key is the priceCall ID, such as prepaid, postpaid, or a custom ID. This field is empty in single mode. The calculatedAmount is the aggregated result of each component based on the priceCalculation expression. The components field exposes the line items so that the caller can view the composition, such as instance fees versus storage fees.'),
    currency?: string(name='currency'),
    discountAmount?: float(name='discountAmount', description='The total discount amount for fixed fees. This is a canonical field calculated as originalAmount - totalAmount. It includes only discounts for fixed fees and excludes the pay-as-you-go billing method. The value is 0 when there is no discount and empty when the original price is missing.'),
    errorCode?: string(name='errorCode', description='The error code when upstream pricing fails, such as InvalidParameter or COMMODITY.INVALID_COMPONENT. This field is empty when success is true.'),
    errorMessage?: string(name='errorMessage', description='The error description when upstream pricing fails. This facilitates self-troubleshooting of specific parameter issues by the caller. This field is empty when success is true.'),
    originalAmount?: float(name='originalAmount', description='The total original price before discounts for fixed fees. This is a canonical field with the same scope as totalAmount. It includes only fixed fees and excludes the pay-as-you-go billing method. Refer to usageCharges[].originalPricePerUnit for the pre-discount unit price of the pay-as-you-go billing method. The difference between this value and totalAmount is the total discount for this inquiry. This field is empty when the upstream does not provide original price information.'),
    priceSummary?: {
      chargeComposition?: string(name='chargeComposition', description='The billing composition. Valid values: recurring_only (all time-based fees), usage_only (all usage-based fees, where a totalAmount of 0 indicates no fixed fees rather than free of charge, and actual costs depend on the unit price and actual usage in usageCharges), or mixed (both, which should be displayed separately). This allows the caller to choose the display text without iterating through modules to determine the composition.'),
      currency?: string(name='currency'),
      effectiveModuleSum?: float(name='effectiveModuleSum'),
      moduleSum?: float(name='moduleSum'),
      modules?: [ 
        {
          billingMode?: string(name='billingMode', description='The billing dimension of this module, which is always explicitly output. Valid values: \\\\"recurring\\\\" for time-based fees, which are included in moduleSum and totalAmount; \\\\"usage\\\\" for usage-based fees, where costAfterDiscount is the usage unit price (CNY/usageUnit) and is not included in moduleSum, and the unit price is also provided in usageCharges.'),
          costAfterDiscount?: float(name='costAfterDiscount'),
          invoiceDiscount?: float(name='invoiceDiscount', description='The discount amount for this module. The value is calculated as invoiceDiscount = originalCost - costAfterDiscount and is precisely provided by the upstream BSS. Manual subtraction in tax-inclusive scenarios may cause precision loss.'),
          moduleCode?: string(name='moduleCode'),
          originalCost?: float(name='originalCost'),
          quantityUsedForQuote?: float(name='quantityUsedForQuote', description='The estimated usage used for pricing this module. This field has a value only when the caller passes a usage greater than 1 through PricingContext. In this case, costAfterDiscount is the total cost for this usage rather than the unit price. Refer to usageCharges[].pricePerUnit for the normalized unit price. This field is empty when no estimated usage is passed.'),
          unitPrice?: float(name='unitPrice', description='The unit price of this module per billing unit, such as CNY/hour, CNY/month, or CNY/unit. This is used to explain the composition of costAfterDiscount in multi-quantity or multi-period scenarios.'),
          usageUnit?: string(name='usageUnit', description='The usage unit, such as GB or CU. This field has a value when billingMode is \\\\"usage\\\\" and indicates the dimension of costAfterDiscount.'),
        }
      ](name='modules'),
      originalPrice?: float(name='originalPrice', description='The total original price before discounts for this pricing inquiry. When originalPrice differs from tradePrice or moduleSum, it indicates that a discount was applied, such as a first-purchase discount or a promotional campaign.'),
      pricingUnit?: string(name='pricingUnit', description='The billing cycle unit, such as \\\\"Hour\\\\", \\\\"1 Month\\\\", \\\\"12 Month\\\\", or \\\\"GB·Month\\\\", which indicates the time dimension of moduleSum. This field is not returned in the BSS response and must be explicitly declared by the mapping maintainer in pricingTarget.pricingUnit. It is optional for subscription scenarios because the CLI infers it from Period and PeriodUnit. However, it is required for pay-as-you-go scenarios in the mapping; otherwise, the amount has no dimension.'),
      quantity?: float(name='quantity', description='The pricing quantity from OpenAPI input parameters, such as Amount in ECS RunInstances. The moduleSum is the unit price per instance, and effectiveModuleSum = moduleSum × quantity is the total price. The caller should present the actual total price for N instances to the user based on this value to avoid mistaking the unit price for the total price.'),
      tradePrice?: float(name='tradePrice'),
      usageCharges?: [ 
        {
          assumedQuantity?: float(name='assumedQuantity', description='The estimated usage passed by the caller through PricingContext. This field has a value only when it is greater than 1. In this case, this entry also provides the assumedQuantityCost calculated based on this assumed usage.'),
          assumedQuantityCost?: float(name='assumedQuantityCost', description='The module cost calculated based on assumedQuantity, which equals pricePerUnit × assumedQuantity. This cost is not included in totalAmount because it is based on the assumed usage reported by the caller and is not a cost necessarily incurred by this call.'),
          moduleCode?: string(name='moduleCode', description='The billing module code, such as TrafficOut or NatCu. This corresponds to the moduleCode in modules.'),
          originalPricePerUnit?: float(name='originalPricePerUnit', description='The original unit price before discounts, in CNY/unit, which is also normalized. This field is empty when not provided by the upstream. The difference between this value and pricePerUnit is the unit price discount for this module.'),
          pricePerUnit?: float(name='pricePerUnit', description='The discounted unit price, in CNY/unit. The actual cost equals pricePerUnit × actual usage. Because the usage is unknown during pricing, it is not included in totalAmount. If the caller passed an estimated usage, the total returned by the upstream is normalized back to the unit price based on that usage.'),
          unit?: string(name='unit', description='The usage unit, such as GB, CU, or 10,000 requests. This comes from the module-level billing.unit annotation in the mapping. The dimension of pricePerUnit is CNY/unit.'),
        }
      ](name='usageCharges', description='The list of unit prices for pay-as-you-go, usage-based modules, such as CNY/GB or CNY/CU. The amounts for these modules are not included in moduleSum or effectiveModuleSum. This field is empty when there are no usage-based modules.'),
    }(name='priceSummary'),
    pricingMode?: string(name='pricingMode'),
    success?: boolean(name='success'),
    totalAmount?: float(name='totalAmount', description='The periodic payable amount for fixed fees in this pricing inquiry (canonical field). For the unit of measurement, see billingUnit. **This field includes only fixed fees**. Usage-based charges (such as traffic in CNY/GB or CUs in CNY/CU) have different units of measurement and cannot be added to this field. For the unit prices of usage-based charges, see usageCharges. To check whether both types of charges exist, see chargeComposition. In single mode, this value is derived from priceSummary.effectiveModuleSum (falling back to tradePrice if missing). In composite or delta mode, this value is derived from calculatedAmount. This field always has a value when success is true.'),
    upstreamRequestId?: string(name='upstreamRequestId', description='The request ID of the upstream pricing API (such as the RequestId of BSS GetSubscriptionPrice). This field is populated regardless of whether the request succeeds or fails, and is used for audit reconciliation and upstream log tracing.'),
    usageCharges?: [ 
      {
        assumedQuantity?: float(name='assumedQuantity', description='The estimated usage passed by the caller through PricingContext. This field has a value only when it is greater than 1. In this case, this entry also provides the assumedQuantityCost calculated based on this assumed usage.'),
        assumedQuantityCost?: float(name='assumedQuantityCost', description='The module cost calculated based on assumedQuantity, which equals pricePerUnit × assumedQuantity. This cost is not included in totalAmount because it is based on the assumed usage reported by the caller and is not a cost necessarily incurred by this call.'),
        moduleCode?: string(name='moduleCode', description='The billing module code, such as TrafficOut or NatCu. This corresponds to the moduleCode in modules.'),
        originalPricePerUnit?: float(name='originalPricePerUnit', description='The original unit price before discounts, in CNY/unit, which is also normalized. This field is empty when not provided by the upstream. The difference between this value and pricePerUnit is the unit price discount for this module.'),
        pricePerUnit?: float(name='pricePerUnit', description='The discounted unit price, in CNY/unit. The actual cost equals pricePerUnit × actual usage. Because the usage is unknown during pricing, it is not included in totalAmount. If the caller passed an estimated usage, the total returned by the upstream is normalized back to the unit price based on that usage.'),
        unit?: string(name='unit', description='The usage unit, such as GB, CU, or 10,000 requests. This comes from the module-level billing.unit annotation in the mapping. The dimension of pricePerUnit is CNY/unit.'),
      }
    ](name='usageCharges', description='The list of unit prices for usage-based billing modules (canonical field). Modules billed by actual usage, such as traffic and NAT CUs, have different units of measurement (such as CNY/GB or CNY/CU) from billingUnit and are not included in totalAmount. This field provides the unit price for each item. In single mode, the values are derived from priceSummary. In composite or delta mode, the values are concatenated from each component in the order of priceCall. This field is empty when the mapping contains no usage-based modules.'),
  }(name='price', description='The pricing data. This field is omitted for PricingNotRequired and PricingNotSupported results that do not include pricing.'),
  requestId?: string(name='requestId', description='Id of the request'),
  success?: boolean(name='success', description='Indicates whether a valid pricing result is obtained. The value is true for normal pricing and when no pricing inquiry is required, and false when pricing is not supported or the pricing inquiry fails.'),
}

model GetApiPriceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetApiPriceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetApiPrice  GetApiPriceRequest
  * @return GetApiPriceResponse
 */
async function getApiPrice(request: GetApiPriceRequest): GetApiPriceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetApiPrice', 'POST', '/api/v1/price/quote', 'json', false, 'json', request);
}

model GetPriceRequest {
  requestPath?: string(name='requestPath', description='The request path. Format: /api/v1/providers/{provider}/products/{product}/price/{resourceType}

The variables in the request path:

provider: the cloud service provider. Currently, only Aliyun is supported.

product: the code of the product.

resourceType: the type of the resource. For example, the resourceType of Redis Account is DBInstance/Account.

The resources that support price inquiry:

Redis DBInstance: /api/v1/providers/aliyun/products/Redis/price/DBInstance

ECS Instance: /api/v1/providers/aliyun/products/ECS/price/Instance

RDS DBInstance: /api/v1/providers/aliyun/products/RDS/price/DBInstance

SLB LoadBalancer: /api/v1/providers/aliyun/products/SLB/price/LoadBalancer

ClickHouse DBCluster: /api/v1/providers/aliyun/products/ClickHouse/price/DBCluster

AliKafka Instance: /api/v1/providers/aliyun/products/AliKafka/price/Instance', example='/api/v1/providers/aliyun/products/SLB/price/LoadBalancer', position='Path'),
  regionId?: string(name='regionId', description='The region ID. This parameter is required if the cloud product is deployed in a region.', example='cn-beijing', position='Query'),
  resourceAttributes?: map[string]any(name='resourceAttributes', description='The attributes based on which the price is queried (in JSON format).', example='{
        "LoadBalancerName": "cc-test",
        "LoadBalancerSpec": "slb.s3.small",
        "InternetChargeType": "paybybandwidth",
        "AddressType": "internet",
        "PaymentType": "PayAsYouGo",
        "Bandwidth": 6
      }', shrink='json', position='Query'),
}

model GetPriceResponseBody = {
  price?: {
    currency?: string(name='currency', description='The currency type. Valid values: CNY: Chinese Yuan. USD: US dollar. JPY: Japanese Yen.', example='CNY'),
    discountPrice?: float(name='discountPrice', description='The discount.', example='0.0'),
    moduleDetails?: [ 
      {
        costAfterDiscount?: float(name='costAfterDiscount', description='The discount price.', example='0.02'),
        invoiceDiscount?: float(name='invoiceDiscount', description='The discount.', example='0.0'),
        moduleCode?: string(name='moduleCode', description='The code of the pricing module.', example='InstanceRent'),
        moduleName?: string(name='moduleName', description='The name of the pricing module.', example='InstanceRent'),
        originalCost?: float(name='originalCost', description='The original price.', example='1000.0'),
        priceType?: string(name='priceType', description='The price type.', example='1.0'),
      }
    ](name='moduleDetails', description='The order details of the pricing module.'),
    originalPrice?: float(name='originalPrice', description='The original price.', example='760.0'),
    promotionDetails?: [ 
      {
        promotionDesc?: string(name='promotionDesc', description='The description of the promotion.', example='37284'),
        promotionId?: long(name='promotionId', description='The ID of the promotion.', example='数据盘享8.5折'),
        promotionName?: string(name='promotionName', description='The name of the promotion.', example='数据盘享8.5折'),
      }
    ](name='promotionDetails', description='The details of the promotion.'),
    tradePrice?: float(name='tradePrice', description='The discount price.', example='0.0'),
  }(name='price', description='The price.'),
  requestId?: string(name='requestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
}

model GetPriceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetPriceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetPrice  GetPriceRequest
  * @return GetPriceResponse
 */
async function getPrice(request: GetPriceRequest): GetPriceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'GetPrice', 'GET', '{requestPath}', 'json', false, 'json', request);
}

model GetResourceTypeRequest {
  requestPath?: string(name='requestPath', description='The request path. Format:
/api/v1/providers/{provider}/products/{product}/resourceTypes/{resourceType}

Description of variables in the request path:

provider: The cloud provider. Currently, only Aliyun is supported.

product: The product code.

resourceType: The resource type. If a parent resource exists, the format is {parentResourceTypeCode}/{resourceTypeCode}.', example='No parent resource: /api/v1/providers/Aliyun/products/Redis/resourceTypes/DBInstance

Has parent resource: /api/v1/providers/Aliyun/products/Redis/resourceTypes/DBInstance/Account', position='Path'),
  xAcsAcceptLanguage?: string(name='x-acs-accept-language', description='The language in which the product information is returned. Valid values:

zh_CH: Chinese (default)

en_US: English.', example='zh_CH', position='Header'),
}

model GetResourceTypeResponseBody = {
  requestId?: string(name='requestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
  resourceType?: {
    createOnlyProperties?: [ string ](name='createOnlyProperties', description='The properties exclusive to the create operation. These properties are not returned in resource query operations but are required as input parameters for the create operation.'),
    deleteOnlyProperties?: [ string ](name='deleteOnlyProperties', description='The properties exclusive to the delete operation. These properties are not returned in resource query operations but are required as input parameters for the delete operation.'),
    filterProperties?: [ string ](name='filterProperties', description='The properties that can be used as filter parameters in the list operation.'),
    getOnlyProperties?: [ string ](name='getOnlyProperties', description='The properties exclusive to the get operation. These properties are not returned in resource query operations but are required as input parameters for the get operation.'),
    getResponseProperties?: [ string ](name='getResponseProperties', description='The properties returned by the get operation.'),
    handlers?: {
      create?: {
        permissions?: [ string ](name='permissions', description='The required RAM permissions.'),
      }(name='create', description='The information associated with the create operation.'),
      delete?: {
        permissions?: [ string ](name='permissions', description='The required RAM permissions.'),
      }(name='delete', description='The information associated with the delete operation.'),
      get?: {
        permissions?: [ string ](name='permissions', description='The required RAM permissions.'),
      }(name='get', description='The information associated with the get operation.'),
      list?: {
        permissions?: [ string ](name='permissions', description='The required RAM permissions.'),
      }(name='list', description='The information associated with the list operation.'),
      update?: {
        permissions?: [ string ](name='permissions', description='The required RAM permissions.'),
      }(name='update', description='The information associated with the update operation.'),
    }(name='handlers', description='The supported resource operations, including RAM permissions.'),
    info?: {
      chargeType?: string(name='chargeType', description='The billing method. Valid values:

paid: paid.

free: free.', example='paid'),
      deliveryScope?: string(name='deliveryScope', description='The delivery scope. Valid values: 

center: centralized deployment.

region: region-level deployment.

zone: zone-level deployment.', example='region'),
      description?: string(name='description', description='The description of the resource type.', example='An ECS instance is equivalent to a virtual machine, including the most basic computing components such as CPU, memory, operating system, network, and disk. You can easily customize and change the configuration of the instance. You have full control over the virtual machine.'),
