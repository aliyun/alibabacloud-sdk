  quantity?: float(name='quantity'),
  pricingUnit?: string(name='pricingUnit'),
  modules?: [ 
    {
      moduleCode?: string(name='moduleCode'),
      costAfterDiscount?: float(name='costAfterDiscount'),
      originalCost?: float(name='originalCost'),
      invoiceDiscount?: float(name='invoiceDiscount'),
      unitPrice?: float(name='unitPrice'),
      billingMode?: string(name='billingMode'),
      usageUnit?: string(name='usageUnit'),
      quantityUsedForQuote?: float(name='quantityUsedForQuote'),
    }
  ](name='modules'),
  usageCharges?: [ 
    {
      moduleCode?: string(name='moduleCode'),
      unit?: string(name='unit'),
      pricePerUnit?: float(name='pricePerUnit'),
      originalPricePerUnit?: float(name='originalPricePerUnit'),
      assumedQuantity?: float(name='assumedQuantity'),
      assumedQuantityCost?: float(name='assumedQuantityCost'),
    }
  ](name='usageCharges'),
  chargeComposition?: string(name='chargeComposition'),
}

