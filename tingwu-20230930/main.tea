/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('tingwu', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CreateTaskRequest {
  appKey?: string(name='AppKey', description='The AppKey of the project created in the console.', example='JV1sRTisRMi****'),
  input?: {
    audioChannelMode?: string(name='AudioChannelMode', description='The multi-channel audio and video processing mode.'),
    fileUrl?: string(name='FileUrl', description='The HTTP or HTTPS URL of the original audio or video file. This parameter is required when you create an offline transcription task.', example='http://xxx.com/zzz/1.wav'),
    format?: string(name='Format', description='The encoding format of the audio stream data when you create a real-time meeting, such as pcm. Valid values:

- **pcm**
- **opus**
- **aac**
- **speex**
- **mp3**', example='pcm'),
    languageHints?: [ string ](name='LanguageHints', description='The preferred languages. This parameter takes effect only when SourceLanguage is set to "multilingual". It restricts the output languages of the model.'),
    multipleStreamsEnabled?: boolean(name='MultipleStreamsEnabled', description='Specifies whether to enable multi-channel audio stream recognition. This parameter needs to be set only in real-time recording scenarios. Default value: false.', example='false'),
    outputPath?: string(name='OutputPath', description='After configuring OSS information in the console, you can specify an OSS write path to save results directly to your custom OSS bucket.'),
    progressiveCallbacksEnabled?: boolean(name='ProgressiveCallbacksEnabled', description='Specifies whether to enable the callback feature.
To enable the callback feature, configure the callback type and address in the console, and set this parameter to true when creating a task.', example='false'),
    sampleRate?: int32(name='SampleRate', description='The sample rate of the audio stream data when you create a real-time meeting. Valid values: 8000 and 16000.

- **8000**: telephone customer service scenarios.
- **16000**: real-time meeting audio capture scenarios.', example='16000'),
    sourceLanguage?: string(name='SourceLanguage', description='The language model used for audio transcription. Valid values:

- **cn**: Chinese
- **en**: English
- **fspk**: Chinese-English free speaking
- **ja**: Japanese
- **yue**: Cantonese

This parameter is required.', example='cn'),
    taskId?: string(name='TaskId', description='The TaskId returned when you create a real-time recording. You can use this ID to end the real-time recording. Set this parameter only when ending a real-time recording. Do not set it at other times.', example='9922c84c087044eda18659c128b56c84'),
    taskKey?: string(name='TaskKey', description='The custom identifier set by the user to associate with this task.', example='task_tingwu_123'),
  }(name='Input', description='The basic parameters set when creating a task. The required parameters vary depending on the task type.

- When type=offline (offline task), you must set the SourceLanguage and FileUrl parameters.

- When type=realtime (real-time meeting task), you must additionally set the SourceLanguage, Format, and SampleRate parameters.'),
  parameters?: {
    autoChapters?: {
      chapterGranularity?: string(name='ChapterGranularity'),
    }(name='AutoChapters'),
    autoChaptersEnabled?: boolean(name='AutoChaptersEnabled', description='Specifies whether to enable the chapter overview feature. When enabled, chapter titles and chapter summaries are generated.', example='true'),
    contentExtraction?: {
      extractionContents?: [ 
        {
          content?: string(name='Content', description='The extraction dimension definition for conversation content extraction.'),
          identity?: string(name='Identity'),
          title?: string(name='Title', description='The extraction dimension name for conversation content extraction.'),
        }
      ](name='ExtractionContents', description='The list of extraction dimensions for conversation content extraction, including the name and definition of each extraction item.'),
      sceneIntroduction?: string(name='SceneIntroduction', description='The scene description for conversation content extraction.'),
      speakerMap?: map[string]any(name='SpeakerMap'),
    }(name='ContentExtraction', description='The conversation content extraction parameter object.'),
    contentExtractionEnabled?: boolean(name='ContentExtractionEnabled', description='The business user ID.'),
    customPrompt?: {
      contents?: [ 
        {
          model?: string(name='Model', description='The model specified for the prompt.', example='tingwu-turbo'),
          name?: string(name='Name', description='The custom name of the prompt, used to match output results.

This parameter is required.', example='summary-demo'),
          prompt?: string(name='Prompt', description='The custom content of the prompt.

This parameter is required.', example='Summarize the following conversation:{Transcription}'),
          transType?: string(name='TransType', description='The format of the {Transcription} tag.', example='default'),
        }
      ](name='Contents', description='The list of custom prompt parameters.'),
    }(name='CustomPrompt', description='The custom prompt control parameter object.'),
    customPromptEnabled?: boolean(name='CustomPromptEnabled', description='Specifies whether to enable the custom prompt feature. When enabled, you can enter a personalized custom prompt.', example='false'),
    extraParams?: {
      domainEducationEnabled?: boolean(name='DomainEducationEnabled'),
      fullTextSummaryFormat?: string(name='FullTextSummaryFormat', description='The return format of the full-text summary.'),
      maxKeywords?: int32(name='MaxKeywords', description='The number of keywords to extract.'),
      nfixEnabled?: boolean(name='NfixEnabled', description='Specifies whether to enable Nfix. In most cases, you do not need to set this parameter.', example='true'),
      ocrAuxiliaryEnabled?: boolean(name='OcrAuxiliaryEnabled'),
      translateLlmSceneEnabled?: boolean(name='TranslateLlmSceneEnabled'),
      translationHotwordMap?: {
        bizType?: string(name='bizType', description='The business scenario type.'),
        bizUserId?: string(name='bizUserId'),
      }(name='TranslationHotwordMap', description='The translation hotword configuration.'),
    }(name='ExtraParams', description='The extra parameters. In most cases, you do not need to set this parameter.'),
    identityRecognition?: {
      identityContents?: [ 
        {
          description?: string(name='Description', description='The identity description.'),
          name?: string(name='Name', description='The identity name.'),
        }
      ](name='IdentityContents', description='The list of identity contents for identity recognition, including the identity name and description.'),
      sceneIntroduction?: string(name='SceneIntroduction', description='The scene description for identity recognition.'),
    }(name='IdentityRecognition', description='The identity recognition parameter object.'),
    identityRecognitionEnabled?: boolean(name='IdentityRecognitionEnabled', description='Specifies whether to enable the identity recognition feature.'),
    llmOutputLanguage?: string(name='LlmOutputLanguage'),
    meetingAssistance?: {
      types?: [ string ](name='Types', description='When the intelligent meeting notes feature is enabled, pass in the expected feature parameter types. Supported types: action items (Actions) and key information (KeyInformation). Key information includes keywords and key content (key sentences).'),
    }(name='MeetingAssistance', description='The control parameters for the intelligent meeting notes feature, which supports algorithm processing for action items, keywords, and key content. If you enable MeetingAssistanceEnabled but do not specify algorithm types through MeetingAssistance, all types are called and returned by default.'),
    meetingAssistanceEnabled?: boolean(name='MeetingAssistanceEnabled', description='Specifies whether to enable the intelligent meeting notes feature. When enabled, results such as keywords, key content, and action items are generated.', example='false'),
    model?: string(name='Model'),
    pptExtractionEnabled?: boolean(name='PptExtractionEnabled', description='Specifies whether to enable PPT extraction and PPT summarization. When enabled, PPT frames are extracted from the video file and corresponding summaries are generated. Enable this parameter only for offline transcription when the source file is a video file. Results cannot be generated in real-time recording scenarios or offline transcription scenarios where the source file is audio only.', example='false'),
    serviceInspection?: {
      inspectionContents?: [ 
        {
          content?: string(name='Content', description='The inspection dimension definition for service inspection.'),
          title?: string(name='Title', description='The inspection dimension name for service inspection.'),
        }
      ](name='InspectionContents', description='The list of inspection dimensions for service inspection, including the dimension name and definition. The definition specifies the criteria that the large language model uses to determine whether a dimension is matched.'),
      inspectionIntroduction?: string(name='InspectionIntroduction', description='The description of the inspection target and focus for service inspection.'),
      sceneIntroduction?: string(name='SceneIntroduction', description='The conversation scene description for service inspection.'),
      speakerMap?: map[string]any(name='SpeakerMap'),
    }(name='ServiceInspection', description='The service inspection parameter object.'),
    serviceInspectionEnabled?: boolean(name='ServiceInspectionEnabled', description='Specifies whether to enable the service inspection feature. Default value: false.'),
    summarization?: {
      types?: [ string ](name='Types', description='When the summarization feature is enabled, pass in the expected summarization types. Supported types: full-text summary (Paragraph), speaker summary (Conversational), and Q&A review summary (QuestionsAnswering).', example='Paragraph'),
    }(name='Summarization', description='The summarization control parameters.'),
    summarizationEnabled?: boolean(name='SummarizationEnabled', description='Specifies whether to enable the summarization feature. When enabled, results such as full-text summaries and speaker summaries can be generated.', example='false'),
    textPolishEnabled?: boolean(name='TextPolishEnabled', description='Specifies whether to enable the spoken-to-written text conversion feature.', example='false'),
    transcoding?: {
      spectrumEnabled?: boolean(name='SpectrumEnabled', description='Specifies whether to generate an audio waveform from the original audio/video file or audio stream and save it. Currently, only MP3 format is supported. This parameter is optional when creating offline file transcription or real-time meetings.', example='false'),
      targetAudioFormat?: string(name='TargetAudioFormat', description='Specifies whether to convert the original audio/video file or audio stream to MP3 format for storage. Currently, only MP3 format is supported. This parameter is optional when creating offline file transcription or real-time meetings.', example='mp3'),
      targetVideoFormat?: string(name='TargetVideoFormat', description='Specifies whether to convert the original video file to MP4 format for storage. Currently, only MP4 format is supported. This parameter is meaningful only when creating offline file transcription and the original file is in video format. Typically, you do not need to set this parameter.', example='mp4'),
      videoThumbnailEnabled?: boolean(name='VideoThumbnailEnabled', description='Specifies whether to extract video thumbnails from the original video file and save them. This parameter is meaningful only when creating offline file transcription and the original file is in video format. Typically, you do not need to set this parameter.', example='false'),
    }(name='Transcoding', description='The audio/video or audio stream transcoding module.'),
    transcription?: {
      additionalStreamOutputLevel?: int32(name='AdditionalStreamOutputLevel', description='Sets the output level for speech recognition results of the active speaker in real-time recording scenarios.

- **1**: Returns results when a complete sentence is recognized.

- **2**: Returns results for both intermediate results and complete sentences.

Set this parameter as needed only in real-time recording scenarios when MultipleStreamsEnabled is set to true. This parameter does not need to be set for offline transcription scenarios.', example='1'),
      audioEventDetectionEnabled?: boolean(name='AudioEventDetectionEnabled', description='Specifies whether to enable audio event detection during speech transcription to determine whether events such as music exist in the audio.', example='false'),
      diarization?: {
        speakerCount?: int32(name='SpeakerCount', description='Sets the speaker diarization parameter.

If not set: speaker role differentiation is not used. 

0: the number of speakers is undetermined.

2: the number of speakers is 2.', example='2'),
      }(name='Diarization', description='The speaker diarization parameters.'),
      diarizationEnabled?: boolean(name='DiarizationEnabled', description='Specifies whether to enable speaker diarization.', example='false'),
      disfluencyEnabled?: boolean(name='DisfluencyEnabled', description='Specifies whether to enable disfluency removal during speech transcription. Enabled by default.'),
      model?: string(name='Model', description='Sets the speech transcription model to improve transcription accuracy in specific domains.'),
      outputLevel?: int32(name='OutputLevel', description='Sets the output level for speech recognition results. Default value: 1.

- **1**: Returns results when a complete sentence is recognized.

- **2**: Returns results for both intermediate results and complete sentences.', example='2'),
      phrase?: map[string]any(name='Phrase'),
      phraseId?: string(name='PhraseId', description='The vocabulary ID of the hot words.', example='ce9c2a34b6d847bf92a77d0a196f****'),
      profanityFilterEnabled?: boolean(name='ProfanityFilterEnabled', description='Specifies whether to enable profanity filtering during speech transcription. Enabled by default.'),
      realtimeDiarizationEnabled?: boolean(name='RealtimeDiarizationEnabled'),
    }(name='Transcription', description='The speech transcription control parameters.'),
    translation?: {
      additionalStreamOutputLevel?: int32(name='AdditionalStreamOutputLevel', description='Sets the output level for translation results of the active speaker in real-time recording scenarios.

- **1**: Returns results when a complete sentence is recognized.
- **2**: Returns results for both intermediate results and complete sentences.

Set this parameter as needed only in real-time recording scenarios when MultipleStreamsEnabled is set to true. This parameter does not need to be set for offline transcription scenarios.', example='1'),
      outputLevel?: int32(name='OutputLevel', description='Sets the output level for real-time translation results. Default value: 1.

- **1**: Returns results when a complete sentence is recognized.
- **2**: Returns results for both intermediate results and complete sentences.

Set this parameter as needed only in real-time recording scenarios. This parameter does not need to be set for offline transcription scenarios.', example='2'),
      targetLanguages?: [ string ](name='TargetLanguages', description='The target languages to set when the translation feature is enabled. Chinese, English, and Japanese are supported.'),
      translateLlmSceneEnabled?: boolean(name='TranslateLlmSceneEnabled', description='Specifies whether to use large language model-based translation. Default value: false.'),
    }(name='Translation', description='The translation control parameters.'),
    translationEnabled?: boolean(name='TranslationEnabled', description='Specifies whether to enable the translation feature.', example='false'),
  }(name='Parameters', description='The algorithm-related parameters set when creating a task. You can set these as needed.'),
  operation?: string(name='operation', description='The operation. Valid values:

- start: creates a task. This is the default value. In most cases, you do not need to explicitly set this parameter.
- stop: stops a real-time meeting task. This value is used in real-time meeting scenarios. After a meeting ends, set this parameter to stop and trigger the call.

> Note: When ending a real-time recording, you must set this parameter to stop.', example='stop'),
  type?: string(name='type', description='The task type. Valid values:
- **offline**: offline task, such as offline transcription.
- **realtime**: real-time task, such as creating a real-time recording.

This parameter is required.', example='offline'),
}

model CreateTaskResponseBody = {
  code?: string(name='Code', description='The status code.', example='0'),
  data?: {
    meetingJoinUrl?: string(name='MeetingJoinUrl', description='The audio stream push URL generated in the real-time recording scenario. You can use this URL for subsequent real-time audio stream recognition.', example='wss://tingwu-realtime-cn-beijing.aliyuncs.com/api/ws/v1?mc=****'),
    taskId?: string(name='TaskId', description='The task ID.', example='c5394c6ee0fb474899d42215a3925c7e'),
    taskKey?: string(name='TaskKey', description='The custom identifier set by the user when creating the task.', example='task_tingwu_123'),
    taskStatus?: string(name='TaskStatus', description='The task status.', example='ONGOING'),
  }(name='Data', description='The response object.'),
  message?: string(name='Message', description='The status description.', example='Success.'),
  requestId?: string(name='RequestId', description='The request ID, used only for troubleshooting.', example='35124E1C-AE99-5D6C-A52E-BD689D8D****'),
}

model CreateTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateTaskResponseBody(name='body'),
}

/**
 * @summary Creates a Tingwu task, including offline transcription tasks and real-time meeting tasks.
 *
 * @param request CreateTaskRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateTaskResponse
 */
async function createTaskWithOptions(request: CreateTaskRequest, headers: map[string]string, runtime: Util.RuntimeOptions): CreateTaskResponse {
  Util.validateModel(request);
  var query : map[string]any = {};
  if (!Util.isUnset(request.operation)) {
    query['operation'] = request.operation;
  }
  if (!Util.isUnset(request.type)) {
    query['type'] = request.type;
  }

  var body : map[string]any = {};
  if (!Util.isUnset(request.appKey)) {
    body['AppKey'] = request.appKey;
  }
  if (!Util.isUnset(request.input)) {
    body['Input'] = request.input;
  }
  if (!Util.isUnset(request.parameters)) {
    body['Parameters'] = request.parameters;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CreateTask',
    version = '2023-09-30',
    protocol = 'HTTPS',
    pathname = `/openapi/tingwu/v2/tasks`,
    method = 'PUT',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Creates a Tingwu task, including offline transcription tasks and real-time meeting tasks.
 *
 * @param request CreateTaskRequest
 * @return CreateTaskResponse
 */
async function createTask(request: CreateTaskRequest): CreateTaskResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return createTaskWithOptions(request, headers, runtime);
}

