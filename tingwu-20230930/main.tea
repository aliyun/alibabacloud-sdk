      summarization?: string(name='Summarization', description='Link to the result of LLM-based summarization.', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_Summarization_20231222101215.json?Expires=1706064016'),
      textPolish?: string(name='TextPolish', description='Link to the result of spoken-to-written text conversion', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_TextPolish_20231222101215.json?Expires=1706064016'),
      transcription?: string(name='Transcription', description='Link to the result of speech transcription.', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_Transcription_20231222101008.json?Expires=1706064016'),
      translation?: string(name='Translation', description='URL link to the result of text translation', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_Translation_20231222101215.json?Expires=1706064016'),
    }(name='Result', description='A collection of results from various algorithm processing tasks. The result is returned as an HTTP link, which the user can use to parse the native result.'),
    taskId?: string(name='TaskId', description='Job ID.', example='c5394c6ee0fb474899d42215a3925c7e'),
    taskKey?: string(name='TaskKey', description='The custom ID set by the user when creating the job.', example='task_tingwu_123'),
    taskStatus?: string(name='TaskStatus', description='Task Status.

- ONGOING: The job is in progress.
- COMPLETED: The job is completed.
- FAILED: The job has failed.
- INVALID: The job is invalid.', example='COMPLETED'),
  }(name='Data', description='Returned object.'),
  message?: string(name='Message', description='Status description.', example='Success.'),
