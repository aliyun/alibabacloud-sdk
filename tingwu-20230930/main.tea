/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'tingwu.cn-beijing.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('tingwu', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CreateTaskRequest {
  appKey?: string(name='AppKey', description='The AppKey of the project that you created in the console.', example='JV1sRTisRMi****'),
  input?: {
    audioChannelMode?: string(name='AudioChannelMode', description='Multi-channel audio or video processing mode.'),
    fileUrl?: string(name='FileUrl', description='The HTTP or HTTPS URL of the source audio or video file. This parameter is required when you create an offline transcription task.', example='http://xxx.com/zzz/1.wav'),
    format?: string(name='Format', description='The encoding format of the audio stream data. This parameter is required when you create a real-time recording task. The following values are supported:

- **pcm**

- **opus**

- **aac**

- **speex**

- **mp3**', example='pcm'),
    languageHints?: [ string ](name='LanguageHints', description='Preferred languages. This applies only when SourceLanguage is multilingual. It restricts the output language of the model.'),
    multipleStreamsEnabled?: boolean(name='MultipleStreamsEnabled', description='Specifies whether to enable multi-channel audio stream recognition. This parameter applies only to real-time recording scenarios. The default value is `false`.', example='false'),
    outputPath?: string(name='OutputPath', description='After you configure OSS settings in the console, specify an OSS path to save results directly to your OSS bucket.'),
    progressiveCallbacksEnabled?: boolean(name='ProgressiveCallbacksEnabled', description='Specifies whether to enable callbacks. To receive callbacks, you must configure the callback type and URL in the console and set this parameter to `true`.', example='false'),
    sampleRate?: int32(name='SampleRate', description='The sample rate of the audio stream data. This parameter is required when you create a real-time recording task. The supported values are 8000 and 16000.

- **8000**: Suitable for telephony and customer service scenarios.

- **16000**: Suitable for real-time meeting audio capture scenarios.', example='16000'),
    sourceLanguage?: string(name='SourceLanguage', description='The language model for speech transcription. The following values are supported:

- **cn**: Chinese

- **en**: English

- **fspk**: Chinese-English code-switching

- **ja**: Japanese

- **yue**: Cantonese

This parameter is required.', example='cn'),
    taskId?: string(name='TaskId', description='The task ID that is returned when you create a real-time recording. This ID is required to stop the recording. Specify this parameter only when stopping a real-time recording.', example='9922c84c087044eda18659c128b56c84'),
    taskKey?: string(name='TaskKey', description='A custom identifier that you can set for the task.', example='task_tingwu_123'),
  }(name='Input', description='The basic input parameters for creating a task. The required parameters vary based on the task type.

- For an offline task (`type="offline"`), you must specify the `SourceLanguage` and `FileUrl` parameters.

- For a real-time task (`type="realtime"`), you must also specify the `SourceLanguage`, `Format`, and `SampleRate` parameters.'),
  parameters?: {
    autoChapters?: {
      chapterGranularity?: string(name='ChapterGranularity'),
    }(name='AutoChapters'),
    autoChaptersEnabled?: boolean(name='AutoChaptersEnabled', description='Specifies whether to generate a chapter summary, which includes chapter titles and summaries for each chapter.', example='true'),
    contentExtraction?: {
      extractionContents?: [ 
        {
          content?: string(name='Content', description='Definition of the content extraction dimension.'),
          identity?: string(name='Identity'),
          title?: string(name='Title', description='Name of the content extraction dimension.'),
        }
      ](name='ExtractionContents', description='List of content extraction dimensions. Each dimension includes a name and definition.'),
      sceneIntroduction?: string(name='SceneIntroduction', description='Description of the conversation scenario for content extraction.'),
      speakerMap?: map[string]any(name='SpeakerMap'),
    }(name='ContentExtraction', description='Conversation content extraction parameters.'),
    contentExtractionEnabled?: boolean(name='ContentExtractionEnabled'),
    customPrompt?: {
      contents?: [ 
        {
          model?: string(name='Model', description='The model to use for the prompt.', example='tingwu-turbo'),
          name?: string(name='Name', description='A custom name for the prompt, used to identify the corresponding output.

This parameter is required.', example='summary-demo'),
          prompt?: string(name='Prompt', description='The content of the custom prompt.

This parameter is required.', example='总结一下下面的对话内容:{Transcription}'),
          transType?: string(name='TransType', description='Specifies the format for the `{Transcription}` tag.', example='default'),
        }
      ](name='Contents', description='A list of custom prompt parameters.'),
    }(name='CustomPrompt', description='Parameters to control the custom prompt feature.'),
    customPromptEnabled?: boolean(name='CustomPromptEnabled', description='Specifies whether to enable the custom prompt feature.', example='false'),
    extraParams?: {
      domainEducationEnabled?: boolean(name='DomainEducationEnabled'),
      fullTextSummaryFormat?: string(name='FullTextSummaryFormat', description='Full-text summary format.'),
      maxKeywords?: int32(name='MaxKeywords', description='Maximum number of keywords.'),
      nfixEnabled?: boolean(name='NfixEnabled', description='Specifies whether to enable nfix. You do not typically need to configure this parameter.', example='true'),
      ocrAuxiliaryEnabled?: boolean(name='OcrAuxiliaryEnabled'),
      translateLlmSceneEnabled?: boolean(name='TranslateLlmSceneEnabled'),
      translationHotwordMap?: {
        bizType?: string(name='bizType'),
        bizUserId?: string(name='bizUserId'),
      }(name='TranslationHotwordMap'),
    }(name='ExtraParams', description='Extended parameters for advanced use cases. You do not typically need to configure these parameters.'),
    identityRecognition?: {
      identityContents?: [ 
        {
          description?: string(name='Description', description='Identity description.'),
          name?: string(name='Name', description='Identity name.'),
        }
      ](name='IdentityContents', description='List of identities, including identity name and description.'),
      sceneIntroduction?: string(name='SceneIntroduction', description='Description of the scenario for identity recognition.'),
    }(name='IdentityRecognition', description='Identity recognition parameters.'),
    identityRecognitionEnabled?: boolean(name='IdentityRecognitionEnabled', description='Enable identity recognition.'),
    llmOutputLanguage?: string(name='LlmOutputLanguage'),
    meetingAssistance?: {
      types?: [ string ](name='Types', description='The types of analysis to perform when the intelligent minutes feature is enabled. Supported values: `Actions` (action items) and `KeyInformation` (key information, including keywords and key points).'),
    }(name='MeetingAssistance', description='Parameters for the intelligent minutes feature, which supports processing for action items, keywords, and key points. If `MeetingAssistanceEnabled` is set to `true` but you do not specify this object, all analysis types are enabled by default.'),
    meetingAssistanceEnabled?: boolean(name='MeetingAssistanceEnabled', description='Specifies whether to generate intelligent minutes, which include keywords, key points, and action items.', example='false'),
    model?: string(name='Model'),
    pptExtractionEnabled?: boolean(name='PptExtractionEnabled', description='Specifies whether to enable PPT extraction. If enabled, the service extracts slides from the video file and generates corresponding summaries. This feature applies only to offline transcription tasks with a video source file and has no effect on other task types.', example='false'),
    serviceInspection?: {
      inspectionContents?: [ 
        {
          content?: string(name='Content', description='Definition of the inspection dimension.'),
          title?: string(name='Title', description='Name of the inspection dimension.'),
        }
      ](name='InspectionContents', description='List of inspection dimensions for service quality inspection. Each dimension includes a name and definition, which tells the Large Language Model how to evaluate whether the dimension is met.'),
      inspectionIntroduction?: string(name='InspectionIntroduction', description='Description of the inspection goals and focus areas for service quality inspection.'),
      sceneIntroduction?: string(name='SceneIntroduction', description='Description of the conversation scenario for service quality inspection.'),
      speakerMap?: map[string]any(name='SpeakerMap'),
    }(name='ServiceInspection', description='Service quality inspection parameters.'),
    serviceInspectionEnabled?: boolean(name='ServiceInspectionEnabled', description='Enable service quality inspection. Default is false.'),
    summarization?: {
      types?: [ string ](name='Types', description='The types of summaries to generate. This parameter is required when summarization is enabled. Supported types include `Paragraph` (full-text summary), `Conversational` (speaker summary), and `QuestionsAnswering` (Q\\\\&A summary).', example='Paragraph'),
    }(name='Summarization', description='Parameters for the summarization feature.'),
    summarizationEnabled?: boolean(name='SummarizationEnabled', description='Specifies whether to enable the summarization feature, which can generate results such as a full-text summary and a speaker summary.', example='false'),
    textPolishEnabled?: boolean(name='TextPolishEnabled', description='Specifies whether to enable the spoken-to-written conversion feature.', example='false'),
    transcoding?: {
      spectrumEnabled?: boolean(name='SpectrumEnabled', description='Specifies whether to generate and save an audio waveform from the source audio/video file or audio stream. This parameter is optional for offline transcription and real-time recording tasks.', example='false'),
      targetAudioFormat?: string(name='TargetAudioFormat', description='Specifies the target format for the transcoded audio. Set to `mp3` to transcode the source audio into MP3 format for storage. This parameter is optional for offline transcription and real-time recording tasks.', example='mp3'),
      targetVideoFormat?: string(name='TargetVideoFormat', description='Specifies the target format for the transcoded video. Set to `mp4` to transcode the source video into MP4 format for storage. This parameter applies only to offline transcription tasks with a video source file.', example='mp4'),
      videoThumbnailEnabled?: boolean(name='VideoThumbnailEnabled', description='Specifies whether to extract and save video thumbnails from the source video file. This parameter applies only to offline transcription tasks with a video source file.', example='false'),
    }(name='Transcoding', description='Parameters for transcoding source audio/video files or audio streams.'),
    transcription?: {
      additionalStreamOutputLevel?: int32(name='AdditionalStreamOutputLevel', description='Specifies the level of detail for speech transcription results for the active speaker in a real-time recording scenario.

- **1**: Returns results only when a complete sentence is recognized.

- **2**: Returns both intermediate and final results as they are recognized.

This parameter applies only to real-time recordings when `MultipleStreamsEnabled` is set to `true`.', example='1'),
      audioEventDetectionEnabled?: boolean(name='AudioEventDetectionEnabled', description='Specifies whether to enable sound event detection, which identifies non-speech events in the audio, such as music.', example='false'),
      diarization?: {
        speakerCount?: int32(name='SpeakerCount', description='Specifies the number of speakers to identify.

If this parameter is not set, speakers are not differentiated in the transcript.

Set the value to `0` to identify an unknown number of speakers.

Set the value to `2` to identify two speakers.', example='2'),
      }(name='Diarization', description='Parameters for the speaker diarization feature.'),
      diarizationEnabled?: boolean(name='DiarizationEnabled', description='Specifies whether to enable speaker diarization.', example='false'),
      disfluencyEnabled?: boolean(name='DisfluencyEnabled'),
      model?: string(name='Model', description='Set the speech transcription model to improve accuracy for specific domains.'),
      outputLevel?: int32(name='OutputLevel', description='Specifies the level of detail for the speech transcription results. Default value: `1`.

- **1**: Returns results only when a complete sentence is recognized.

- **2**: Returns both intermediate and final results as they are recognized.', example='2'),
      phraseId?: string(name='PhraseId', description='The ID of the hotword list.', example='ce9c2a34b6d847bf92a77d0a196f****'),
      profanityFilterEnabled?: boolean(name='ProfanityFilterEnabled', description='Enable sensitive word filtering during speech transcription. Enabled by default.'),
      realtimeDiarizationEnabled?: boolean(name='RealtimeDiarizationEnabled'),
    }(name='Transcription', description='Parameters to control the speech transcription process.'),
    translation?: {
      additionalStreamOutputLevel?: int32(name='AdditionalStreamOutputLevel', description='Specifies the level of detail for real-time translation results for the active speaker.

- **1**: Returns results only for complete sentences.

- **2**: Returns both intermediate and final results.

This parameter applies only to real-time recordings when `MultipleStreamsEnabled` is set to `true`.', example='1'),
      outputLevel?: int32(name='OutputLevel', description='Specifies the level of detail for real-time translation results. Default value: `1`.

- **1**: Returns results only for complete sentences.

- **2**: Returns both intermediate and final results.

This parameter applies only to real-time recordings.', example='2'),
      targetLanguages?: [ string ](name='TargetLanguages', description='The target languages for translation. This parameter is required if translation is enabled. Supported languages include Chinese, English, and Japanese.'),
      translateLlmSceneEnabled?: boolean(name='TranslateLlmSceneEnabled'),
    }(name='Translation', description='Parameters to control the translation feature.'),
    translationEnabled?: boolean(name='TranslationEnabled', description='Specifies whether to enable the translation feature.', example='false'),
  }(name='Parameters', description='Algorithm-related parameters for customizing task processing.'),
  operation?: string(name='operation', description='The operation to perform. Valid values:

- **start**: Creates a task. This is the default value and does not typically need to be set.

- **stop**: Stops a real-time recording task. This value is used only for real-time tasks. To end the recording, set this parameter to `stop`.', example='stop'),
  type?: string(name='type', description='The type of the task. Valid values:

- **offline**: An offline task, such as an offline transcription.

- **realtime**: A real-time task, such as a real-time recording.

This parameter is required.', example='offline'),
}

model CreateTaskResponseBody = {
  code?: string(name='Code', description='The status code.', example='0'),
  data?: {
    meetingJoinUrl?: string(name='MeetingJoinUrl', description='The stream ingestion URL. Push audio streams to this URL for real-time transcription.', example='wss://tingwu-realtime-cn-beijing.aliyuncs.com/api/ws/v1?mc=****'),
    taskId?: string(name='TaskId', description='The task ID.', example='c5394c6ee0fb474899d42215a3925c7e'),
    taskKey?: string(name='TaskKey', description='The custom identifier specified during task creation.', example='task_tingwu_123'),
    taskStatus?: string(name='TaskStatus', description='The task status.', example='ONGOING'),
  }(name='Data', description='The response data.'),
  message?: string(name='Message', description='The status message.', example='Success.'),
  requestId?: string(name='RequestId', description='The request ID, used for troubleshooting only.', example='35124E1C-AE99-5D6C-A52E-BD689D8D****'),
}

model CreateTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateTaskResponseBody(name='body'),
}

/**
 * @summary Create offline transcription and real-time meeting tasks in Tingwu.
 *
 * @param request CreateTaskRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateTaskResponse
 */
async function createTaskWithOptions(request: CreateTaskRequest, headers: map[string]string, runtime: Util.RuntimeOptions): CreateTaskResponse {
  Util.validateModel(request);
  var query : map[string]any = {};
  if (!Util.isUnset(request.operation)) {
    query['operation'] = request.operation;
  }
  if (!Util.isUnset(request.type)) {
    query['type'] = request.type;
  }

  var body : map[string]any = {};
  if (!Util.isUnset(request.appKey)) {
    body['AppKey'] = request.appKey;
  }
  if (!Util.isUnset(request.input)) {
    body['Input'] = request.input;
  }
  if (!Util.isUnset(request.parameters)) {
    body['Parameters'] = request.parameters;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CreateTask',
    version = '2023-09-30',
    protocol = 'HTTPS',
    pathname = `/openapi/tingwu/v2/tasks`,
    method = 'PUT',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Create offline transcription and real-time meeting tasks in Tingwu.
 *
 * @param request CreateTaskRequest
 * @return CreateTaskResponse
 */
async function createTask(request: CreateTaskRequest): CreateTaskResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers : map[string]string = {};
  return createTaskWithOptions(request, headers, runtime);
}

