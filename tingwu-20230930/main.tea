model GetTaskInfoResponseBody = {
  code?: string(name='Code', description='The status code.', example='0'),
  data?: {
    errorCode?: string(name='ErrorCode', description='Error code', example='TSC.AudioFormat'),
    errorMessage?: string(name='ErrorMessage', description='Error message', example='Audio format invalid.'),
    outputMp3Path?: string(name='OutputMp3Path', description='URL link to the MP3 conversion result', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_20231222101008.mp3?Expires=1706064016'),
    outputMp4Path?: string(name='OutputMp4Path', description='URL link to the MP4 conversion result', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_20231222101008.mp4?Expires=1706064016'),
    outputSpectrumPath?: string(name='OutputSpectrumPath', description='URL link to the audio waveform graph', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_20231222101008.spectrum?Expires=1706064016'),
    outputThumbnailPath?: string(name='OutputThumbnailPath', description='URL link to the video thumbnail', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_20231222101008.png?Expires=1706064016'),
    result?: {
      autoChapters?: string(name='AutoChapters', description='Link to the result of the Auto Chapters feature.', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_AutoChapters_20231222101215.json?Expires=1706064016'),
      contentExtraction?: string(name='ContentExtraction', description='URL link to the result of conversation content extraction', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_ ContentExtraction_20231222101215.json?Expires=1706064016'),
      customPrompt?: string(name='CustomPrompt', description='Link to the result of the Custom prompt', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_ CustomPrompt_20231222101215.json?Expires=1706064016'),
      identityRecognition?: string(name='IdentityRecognition', description='The URL link to the identity recognition result.', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_ IdentityRecognition_20231222101215.json?Expires=1706064016'),
      meetingAssistance?: string(name='MeetingAssistance', description='URL link to the result of Intelligent Meeting Summary', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_MeetingAssistance_20231222101112.json?Expires=1706064016'),
      pptExtraction?: string(name='PptExtraction', description='URL link to the result of video PPT extraction and summarization', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_PptExtraction_20231222101215.json?Expires=1706064016'),
      serviceInspection?: string(name='ServiceInspection', description='Link to the result of service inspection', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_ ServiceInspection_20231222101215.json?Expires=1706064016'),
      summarization?: string(name='Summarization', description='Link to the result of LLM-based summarization.', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_Summarization_20231222101215.json?Expires=1706064016'),
      textPolish?: string(name='TextPolish', description='Link to the result of spoken-to-written text conversion', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_TextPolish_20231222101215.json?Expires=1706064016'),
      transcription?: string(name='Transcription', description='Link to the result of speech transcription.', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_Transcription_20231222101008.json?Expires=1706064016'),
      translation?: string(name='Translation', description='URL link to the result of text translation', example='http://xxxx.com/tingwu/output/1738248324/094e964bf0e04e39/094e964bf0e04e39_Translation_20231222101215.json?Expires=1706064016'),
