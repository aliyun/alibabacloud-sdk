import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Notifications';
  @version = '2024-12-25';
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-southeast-1' = 'notifications-intl.aliyuncs.com',
    'cn-zhangjiakou' = 'notifications.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model CreateWebhookContactRequest {
  acceptLanguage?: string(name='AcceptLanguage', description='The language.', example='zh-CN', position='Body'),
  appName?: string(name='AppName', description='The application name of the caller.', example='yunge-user', position='Body'),
  bizName?: string(name='BizName', description='The business line of the caller.', example='/', position='Body'),
  botSecurityToken?: string(name='BotSecurityToken', description='The webhook security signature token.', example='xxxx', position='Body'),
  callerProtocol?: string(name='CallerProtocol', description='The request protocol type.', example='/', position='Body'),
  clientSource?: string(name='ClientSource', description='The source of the operation terminal.', example='/', position='Body'),
  contactName?: string(name='ContactName', description='The name of the webhook contact.', example='test', position='Body'),
  cookies?: string(name='Cookies', description='The user cookies.', example='/', position='Body'),
  securityToken?: string(name='SecurityToken', deprecated='true', position='Body'),
  serverUrl?: string(name='ServerUrl', description='The DingTalk group chatbot URL.', example='https://oapi.dingtalk.com/robot/send?access_token=xxxxxxx', position='Body'),
  srcUrl?: string(name='SrcUrl', description='The URL of the source page.', example='/', position='Body'),
  templateCode?: string(name='TemplateCode', description='The template code.', example='lark', position='Body'),
  tenantCode?: string(name='TenantCode', description='The tenant information.', example='/', position='Body'),
  uidType?: string(name='UidType', description='The user type.', example='/', position='Body'),
  verificationCode?: string(name='VerificationCode', description='The verification code.', example='352036', position='Body'),
  webhookType?: string(name='WebhookType', description='The webhook type.', example='dingtalk', position='Body'),
}

model CreateWebhookContactResponseBody = {
  code?: string(name='Code', description='The error code returned if the call failed. For more information, see error codes.', example='SUCCESS'),
  message?: string(name='Message', description='The message returned if the call failed.', example='Successful'),
  requestId?: string(name='RequestId', description='The request ID.', example='A5F62766-1C2F-1F56-A39D-63E3D30F0633'),
  success?: boolean(name='Success', description='Indicates whether the call was successful. Valid values:
- true: The call was successful.
- false: The call failed.', example='true'),
}

model CreateWebhookContactResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateWebhookContactResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateWebhookContact  CreateWebhookContactRequest
  * @return CreateWebhookContactResponse
 */
async function createWebhookContact(request: CreateWebhookContactRequest): CreateWebhookContactResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateWebhookContact', 'POST', '/', 'json', true, 'form', request);
}

