  orderByField?: string(name='OrderByField', description='The sort field.

- FileCountLimit: The file count limit of the quota.
- SizeLimit: The capacity limit of the quota.
- FileCountUsage: The file count usage.
- SpaceUsage: The capacity usage.', example='FileCountLimit', position='Query'),
  sortOrder?: string(name='SortOrder', description='The sort order.

- asc (default): Ascending order. Results are sorted from smallest to largest.
- desc: Descending order. Results are sorted from largest to smallest.
> This parameter takes effect only when the OrderByField parameter is specified.', example='asc', position='Query'),
}

