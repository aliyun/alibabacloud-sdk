    'cn-hangzhou-test-306' = 'nas.aliyuncs.com',
    'cn-hongkong-finance-pop' = 'nas.aliyuncs.com',
    'cn-qingdao-nebula' = 'nas.aliyuncs.com',
    'cn-shanghai-et15-b01' = 'nas.aliyuncs.com',
