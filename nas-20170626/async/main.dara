  securityGroupId?: string(name='SecurityGroupId', description='The security group ID.', example='sg-bp1fg655nh68xyz9****', position='Query'),
  vSwitchId?: string(name='VSwitchId', description='The vSwitch ID.

This parameter is required and valid when the network type is VPC.
For example:
If NetworkType is set to VPC, VSwitchId is required.', example='vsw-2zevmwkwyztjuoffg****', position='Query'),
  vpcId?: string(name='VpcId', description='The VPC ID.

This parameter is required and valid when the network type is VPC.
For example:
If NetworkType is set to VPC, VpcId is required.', example='vpc-2zesj9afh3y518k9o****', position='Query'),
}

