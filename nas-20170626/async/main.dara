model ApplyAutoSnapshotPolicyRequest {
  autoSnapshotPolicyId: string(name='AutoSnapshotPolicyId', description='The ID of the destination automatic snapshot policy.

This parameter is required.', example='sp-extreme-233e6****', position='Query'),
  fileSystemIds: string(name='FileSystemIds', description='The IDs of the destination Advanced Extreme NAS file systems.

You can specify up to 100 file system IDs in a single call. To apply the automatic snapshot policy to multiple file systems, separate the file system IDs with commas (,).

This parameter is required.', example='extreme-233e6****,extreme-23vbp****,extreme-23vas****', position='Query'),
}

model ApplyAutoSnapshotPolicyResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3****'),
}

model ApplyAutoSnapshotPolicyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ApplyAutoSnapshotPolicyResponseBody(name='body'),
}

/**
  * @description **Before you begin**
  * This operation is supported only by Advanced Extreme NAS file systems. Before you call this operation, complete the following preparations:
  * - An Advanced Extreme NAS file system is created. When you invoke the [CreateFileSystem](https://www.alibabacloud.com/help/en/nas/developer-reference/api-nas-2017-06-26-createfilesystem) operation to create the file system, you must configure the following parameter Settings:
  *   - FileSystemType: extreme
  *   - StorageType: advance
  * - An automatic snapshot policy is created. For more information, see [CreateAutoSnapshotPolicy](https://www.alibabacloud.com/help/en/nas/developer-reference/api-nas-2017-06-26-createautosnapshotpolicy).
  * - You have completed the console authorization for AliyunNASManageENIRole. Before you create an Extreme NAS file system, you must grant authorization to the NAS service-linked role AliyunNASManageENIRole to allow NAS to associate and manage elastic network interfaces (ENIs) and the network interface controller (NIC). For more information, see [Manage the service-linked role for NAS](https://help.aliyun.com/document_detail/208530.html).
  * **Usage notes**
  * <props="china">
  * - This feature is in free public preview. During the public preview, the [File Storage NAS Service-Level Agreement (SLA) protocol](https://terms.aliyun.com/legal-agreement/terms/suit_bu1_ali_cloud/suit_bu1_ali_cloud201803061139_99860.html?spm=a2c4g.11186623.0.0.5c895ff2YPLrwe) is not guaranteed.
  * - You can apply only one automatic snapshot policy to a file system.
  * - You can apply an automatic snapshot policy to multiple file systems.
  * - If an automatic snapshot policy is already applied to the destination file system, you can invoke the ApplyAutoSnapshotPolicy operation to replace the current automatic snapshot policy.
  * <props="intl">
  * - This feature is in free public preview.
  * - You can apply only one automatic snapshot policy to a file system.
  * - You can apply an automatic snapshot policy to multiple file systems.
  * - If an automatic snapshot policy is already applied to the destination file system, you can call the ApplyAutoSnapshotPolicy operation to replace the current automatic snapshot policy.
  * @param request  the request parameters of ApplyAutoSnapshotPolicy  ApplyAutoSnapshotPolicyRequest
  * @return ApplyAutoSnapshotPolicyResponse
 */
async function applyAutoSnapshotPolicy(request: ApplyAutoSnapshotPolicyRequest): ApplyAutoSnapshotPolicyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ApplyAutoSnapshotPolicy', 'POST', '/', 'json', false, 'json', request);
}

model ApplyDataFlowAutoRefreshRequest {
  autoRefreshInterval?: long(name='AutoRefreshInterval', description='The auto-refresh interval. At each interval, CPFS checks whether data in the directory is updated. If data updates exist, CPFS starts an auto-refresh task. Unit: minutes.

Valid values: 10 to 525600. Default value: 10.', example='10', minimum=5, maximum=525600, position='Query'),
  autoRefreshPolicy?: string(name='AutoRefreshPolicy', description='The auto-refresh policy. This policy specifies how data updates in the source are imported into CPFS after the source data is updated. Valid values:

- None: Data updates in the source are not automatically imported into CPFS. You can use a data flow task to import data updates from the source.
- ImportChanged: Data updates in the source are automatically imported into CPFS.', example='None', position='Query'),
  autoRefreshs: [ 
    {
      refreshPath: string(name='RefreshPath', description='The auto-refresh directory. CPFS automatically checks only whether source data in this directory is updated and automatically imports the updated data.

Limits:

- The value must be 2 to 1024 characters in length.
- The value must be encoded in UTF-8.
- The value must start and end with a forward slash (/).

> The directory must be an existing directory on CPFS and must be located in a Fileset for which data flow is enabled.

This parameter is required.', example='/prefix1/prefix2/', minLength=2, maxLength=1024),
    }
  ](name='AutoRefreshs', description='The auto-refresh configurations.

This parameter is required.', position='Query'),
  clientToken?: string(name='ClientToken', description='The client token that is used to ensure the idempotence of the request. You can generate a value from your client to ensure that the value is unique among different requests.

The ClientToken parameter supports only ASCII characters and cannot exceed 64 characters in length. For more information, see [How to ensure idempotence](https://help.aliyun.com/document_detail/25693.html).

> If you do not specify this parameter, the system automatically uses the RequestId of the API request as the ClientToken. The RequestId may be different for each API request.', example='123e4567-e89b-12d3-a456-42665544****', minLength=1, maxLength=64, position='Query'),
  dataFlowId: string(name='DataFlowId', description='The data flow ID.

This parameter is required.', example='df-194433a5be31****', position='Query'),
  dryRun?: boolean(name='DryRun', description='Specifies whether to perform a dry run on this creation request.

A dry run checks parameter validity and inventory. It does not actually create an instance or incur fees.

Valid values:

- true: Sends a check request and does not create an instance. Check items include whether required parameters are specified, the request format, service limits, and NAS inventory. If the check fails, the system returns the corresponding error. If the check succeeds, the system returns HTTP status code 200, but FileSystemId is empty.
- false (default): Sends a normal request. After the check succeeds, the system creates the instance.', example='false', position='Query'),
  fileSystemId: string(name='FileSystemId', description='The file system ID.

This parameter is required.', example='cpfs-099394bd928c****', position='Query'),
}

model ApplyDataFlowAutoRefreshResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='98696EF0-1607-4E9D-B01D-F20930B6****'),
}

model ApplyDataFlowAutoRefreshResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ApplyDataFlowAutoRefreshResponseBody(name='body'),
}

/**
  * @description - This operation applies only to CPFS file systems.
  * - Only CPFS 2.2.0 and later support data flows. You can view the version information on the file system details page in the console.
  * - You can add an auto-refresh configuration only to data flows in the `Running` (normal) state.
  * - You can add up to five auto-refresh configurations to a data flow.
  * - Creating an auto-refresh configuration usually takes 2 to 5 minutes. You can call [DescribeDataFlows](https://help.aliyun.com/document_detail/336901.html) to query the data flow status.
  * - Auto-refresh relies on EventBridge to collect object modification events from the source OSS bucket. You must first [activate EventBridge](https://help.aliyun.com/document_detail/182246.html).
  *   > The event buses and event rules that CPFS creates in EventBridge have the description `Create for cpfs auto refresh`. Do not modify or delete the event buses or event rules. Otherwise, auto-refresh cannot work properly.
  * - Auto-refresh applies to a prefix specified by the RefreshPath parameter. When you configure auto-refresh for a prefix in a CPFS data stream, the system creates an event bus in your account and creates an event rule for the prefix of the source OSS bucket. After an object in the prefix of the source OSS bucket is modified, EventBridge generates an OSS event, and the CPFS data stream processes the event.
  * - After you configure auto-refresh (AutoRefresh), when data in the source storage changes, automatic synchronization of the changed metadata to the CPFS file system is performed. The changed data is loaded on demand when you access files, or you can start a data stream node to load the data.
  * - The auto-refresh interval (AutoRefreshInterval) specifies how often CPFS checks whether data in the prefix of the source OSS bucket is updated. If updates exist, CPFS starts an auto-refresh node. If the frequency of object modification events in the source OSS bucket exceeds the processing capacity of the CPFS data stream, auto-refresh nodes accumulate, metadata updates are delayed, and the data stream status becomes Misconfigured. To resolve this issue, upgrade the data stream specification or reduce the OSS modification frequency.
  * @param request  the request parameters of ApplyDataFlowAutoRefresh  ApplyDataFlowAutoRefreshRequest
  * @return ApplyDataFlowAutoRefreshResponse
 */
async function applyDataFlowAutoRefresh(request: ApplyDataFlowAutoRefreshRequest): ApplyDataFlowAutoRefreshResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ApplyDataFlowAutoRefresh', 'POST', '/', 'json', false, 'json', request);
}

