  requestId?: string(name='RequestId', description='The request ID.', example='728C5E01-ABF6-5AA8-B9FC-B3BA05DECC77'),
}

model ChangeRecallManagementServiceVersionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ChangeRecallManagementServiceVersionResponseBody(name='body'),
}

/**
  * @description ## Request
  * Use this API to change the version of a recall management service. Ensure that the provided `RecallManagementServiceId`, `InstanceId`, and target `RecallManagementServiceVersionId` are valid, and that you have the required permissions for these resources.
  * - **RecallManagementServiceId**: The unique identifier of the recall management service.
  * - **InstanceId**: The instance ID associated with the recall management service.
  * - **RecallManagementServiceVersionId**: The target version ID to switch to.
  * Note: Before changing the version, confirm that the new version is fully tested and ready for production.
  * @param request  the request parameters of ChangeRecallManagementServiceVersion  ChangeRecallManagementServiceVersionRequest
  * @return ChangeRecallManagementServiceVersionResponse
 */
async function changeRecallManagementServiceVersion(request: ChangeRecallManagementServiceVersionRequest): ChangeRecallManagementServiceVersionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ChangeRecallManagementServiceVersion', 'POST', '/api/v1/recallmanagementservices/{RecallManagementServiceId}/action/changeversion', 'json', false, 'json', request);
}

model ChatConversationRequest {
  regionId?: string(name='RegionId', position='Host'),
  config?: string(name='Config', description='The additional information input in JSON format.', example='{}', position='Body'),
  content: string(name='Content', description='The message content.

This parameter is required.', example='校验引擎配置', position='Body'),
  conversationId?: string(name='ConversationId', description='The session ID. If this parameter is not specified, a new session is created. If this parameter is specified, the conversation continues in the context of the existing session.', example='e47cfae9-c0cc-42e1-91e2-e67cdb0e7b96', position='Body'),
  instanceId: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='learn-pairec-xxx', position='Body'),
}

model ChatConversationResponseBody = {
  answer?: string(name='Answer', description='The reply content.', example='FeatureDB近7天读写量为xxx'),
  callId?: string(name='CallId', description='The call ID.', example='""'),
  conversationId?: string(name='ConversationId', description='The session ID.', example='e47cfae9-c0cc-42e1-91e2-e67cdb0e7b96'),
  errorCode?: string(name='ErrorCode', description='The error code.', example='SERVER_ERROR'),
  errorMessage?: string(name='ErrorMessage', description='The error message.', example='connection failed'),
  event?: string(name='Event', description='The event.', example='message'),
  func?: string(name='Func', description='The function name.', example='""'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The creation time.', example='2021-12-15T23:24:33.132+08:00'),
  messageId?: string(name='MessageId', description='The message ID.', example='chat-abcdefg'),
  requestId?: string(name='RequestId', description='The request ID.', example='728C5E01-ABF6-5AA8-B9FC-B3BA05DECC77'),
  skillName?: string(name='SkillName', description='The skill name.', example='""'),
}

model ChatConversationResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ChatConversationResponseBody(name='body'),
}

/**
  * @description ## Operation description
  * - Call this API operation to send a conversation message to an agent. Server-Sent Events (SSE) is supported.
  * - If the `ConversationId` parameter is specified, the conversation continues in the context of the specified existing session. If this parameter is not specified, automatic creation of a new session is performed.
  * - The `Config` field allows you to pass additional information input. The value must be in JSON format.
  * - If the request succeeds, the response includes the message ID, reply content, and other information for this conversation. If a fault occurs, the corresponding error code and error message are returned.
  * @param request  the request parameters of ChatConversation  ChatConversationRequest
  * @return ChatConversationResponse
 */
async function chatConversation(request: ChatConversationRequest): ChatConversationResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ChatConversation', 'POST', '/api/v1/conversations/chat', 'json', false, 'json', request);
}

function chatConversationWithResponseIterable(request: ChatConversationRequest): iterator[ChatConversationResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'ChatConversation', 'POST', '/api/v1/conversations/chat', 'json', false, 'json', request);
}

