model ChangeRecallManagementServiceVersionRequest {
  recallManagementServiceId?: string(name='RecallManagementServiceId', description='The recall management service ID.', example='2', position='Path'),
  regionId?: string(name='RegionId', position='Host'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='pairec-cn-test123', position='Body'),
