/**
 * @summary 提交单页作业图片，返回任务ID及初步检测结果。
 *
 * @description ## 请求说明
 * - 该接口用于提交单页作业图片进行批改，支持通过图片URL或Base64编码的图片数据。
 * - 提交后会立即返回任务ID、矫正图及题目检测结果，但不包含具体的批改结论。
 * - 需要通过查询接口轮询获取最终的批改结果。
 * - 支持对图片进行透视矫正，默认开启。
 * - 图片要求：支持多种格式（JPEG, PNG, GIF等），推荐体积不超过1MB，最大支持15MB（Base64编码后）。
 * - 每次请求仅处理一张图片，多张图片需分别提交。
 * - `request_id`字段建议由调用方生成并传递，以便于问题排查和对账。
 *
 * @param request CreateEduHomeworkCorrectSubmitRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateEduHomeworkCorrectSubmitResponse
 */
async function createEduHomeworkCorrectSubmitWithOptions(request: CreateEduHomeworkCorrectSubmitRequest, headers: map[string]string, runtime: Util.RuntimeOptions): CreateEduHomeworkCorrectSubmitResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.dewarp)) {
    body['dewarp'] = request.dewarp;
  }
  if (!Util.isUnset(request.imageBase64)) {
    body['imageBase64'] = request.imageBase64;
  }
  if (!Util.isUnset(request.imageUrl)) {
    body['imageUrl'] = request.imageUrl;
  }
  if (!Util.isUnset(request.requestId)) {
    body['requestId'] = request.requestId;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CreateEduHomeworkCorrectSubmit',
    version = '2026-11-02',
    protocol = 'HTTPS',
    pathname = `/v1/homework/correct/submit`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

