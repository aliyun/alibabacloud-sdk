model CreateEduProblemSolveRequest {
  query?: {
    image?: {
      base64?: string(name='base64'),
      format?: string(name='format', description='This parameter is required.'),
      url?: string(name='url'),
    }(name='image'),
  }(name='query', description='This parameter is required.'),
  requestId?: string(name='requestId', example='019F593F-D6EE-5F44-819A-6CDA127D1637'),
}

model CreateEduProblemSolveShrinkRequest {
  queryShrink?: string(name='query', description='This parameter is required.'),
  requestId?: string(name='requestId', example='019F593F-D6EE-5F44-819A-6CDA127D1637'),
}

model CreateEduProblemSolveResponseBody = {
  data?: {
    code?: string(name='code', example='change_batch'),
    finished?: boolean(name='finished'),
    items?: [ 
      {
        content?: string(name='content', example='{}'),
        imageUrl?: string(name='imageUrl'),
        questionId?: string(name='questionId'),
        status?: string(name='status', example='200'),
        thinking?: {
          content?: string(name='content', example='8ci7nsj9WPYXvQb9MJfA'),
          status?: string(name='status', example='200'),
        }(name='thinking'),
      }
    ](name='items'),
    message?: string(name='message', example='ok'),
    requestId?: string(name='requestId', example='098E23F7-A74C-5584-87A1-39734D5B83CE'),
    resultType?: string(name='resultType'),
    retryable?: boolean(name='retryable'),
    usage?: {
      completionTokens?: int32(name='completionTokens'),
      promptTokens?: int32(name='promptTokens'),
    }(name='usage'),
  }(name='data'),
  event?: string(name='event', example='message'),
}

model CreateEduProblemSolveResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateEduProblemSolveResponseBody(name='body'),
}

/**
 * @summary 通过图片URL或Base64编码接收题目，返回解题过程和结果。
 *
 * @description ## 请求说明
 * - 本接口支持通过单张题目图片的URL或Base64编码进行解题请求。
 * - 支持处理JPEG、JPG、PNG格式的图片，且图片大小不超过10MB，像素总数不超过260万。
 * - 请求必须携带`request_id`字段，用于链路关联和对账；建议使用UUID以保证唯一性。
 * - `Authorization`头部需包含有效的`appKey`，采用`Bearer <appKey>`格式。
 * - 接口响应为SSE流式数据，客户端应逐事件读取并解析，不得等待连接关闭后整体读取。
 * - 成功响应包括`message`（过程态全量解题快照）和`complete`（最终完整结果）两种事件类型。
 * - 错误处理分为建流前与建流后两个阶段，根据错误码及`retryable`字段决定是否重试。
 * - 客户端超时设置建议不低于3分钟，并确保代理层不会缓存SSE响应或提前关闭长连接。
 *
 * @param tmpReq CreateEduProblemSolveRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateEduProblemSolveResponse
 */
async function createEduProblemSolveWithOptions(tmpReq: CreateEduProblemSolveRequest, headers: map[string]string, runtime: Util.RuntimeOptions): CreateEduProblemSolveResponse {
  Util.validateModel(tmpReq);
  var request = new CreateEduProblemSolveShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!Util.isUnset(tmpReq.query)) {
    request.queryShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.query, 'query', 'json');
  }
  var body : map[string]any = {};
  if (!Util.isUnset(request.queryShrink)) {
    body['query'] = request.queryShrink;
  }
  if (!Util.isUnset(request.requestId)) {
    body['requestId'] = request.requestId;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CreateEduProblemSolve',
    version = '2026-11-02',
    protocol = 'HTTPS',
    pathname = `/v1/problem/solve/stream`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

