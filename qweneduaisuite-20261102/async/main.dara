model CreateEduHomeworkCorrectSubmitRequest {
  dewarp?: boolean(name='dewarp', position='Body'),
  imageBase64?: string(name='imageBase64', position='Body'),
  imageUrl?: string(name='imageUrl', position='Body'),
  requestId?: string(name='requestId', position='Body'),
}

model CreateEduHomeworkCorrectSubmitResponseBody = {
  code?: string(name='code', example='OK'),
  data?: {
    angle?: long(name='angle'),
    dewarpUrl?: string(name='dewarpUrl'),
    questionResults?: [ 
      {
        answerResults?: [ 
          {
            answerPoints?: [ 
              {
                x?: long(name='x', example='0.0'),
                y?: long(name='y', example='0.03'),
              }
            ](name='answerPoints'),
            checkPoint?: {
              x?: long(name='x', example='0.0'),
              y?: long(name='y', example='0.90'),
            }(name='checkPoint'),
            checkResult?: string(name='checkResult'),
            standardAnswer?: string(name='standardAnswer'),
            userAnswer?: string(name='userAnswer'),
          }
        ](name='answerResults'),
        finish?: boolean(name='finish', example='True'),
        questionContent?: string(name='questionContent'),
        questionId?: string(name='questionId'),
        questionPoints?: [[ 
          {
            x?: long(name='x', example='0.0'),
            y?: long(name='y', example='0.0'),
          }
        ]        ](name='questionPoints'),
        questionType?: string(name='questionType'),
        solution?: string(name='solution', example='已处理：接口耗时已恢复低于阈值（09:53后分钟平均约1.8s～3.3s）'),
      }
    ](name='questionResults'),
    status?: string(name='status', example='OK'),
    taskId?: string(name='taskId'),
  }(name='data'),
  message?: string(name='message', example='success'),
  requestId?: string(name='requestId'),
}

model CreateEduHomeworkCorrectSubmitResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateEduHomeworkCorrectSubmitResponseBody(name='body'),
}

/**
  * @description ## 请求说明
  * - 该接口用于提交单页作业图片进行批改，支持通过图片URL或Base64编码的图片数据。
  * - 提交后会立即返回任务ID、矫正图及题目检测结果，但不包含具体的批改结论。
  * - 需要通过查询接口轮询获取最终的批改结果。
  * - 支持对图片进行透视矫正，默认开启。
  * - 图片要求：支持多种格式（JPEG, PNG, GIF等），推荐体积不超过1MB，最大支持15MB（Base64编码后）。
  * - 每次请求仅处理一张图片，多张图片需分别提交。
  * - `request_id`字段建议由调用方生成并传递，以便于问题排查和对账。
  * @param request  the request parameters of CreateEduHomeworkCorrectSubmit  CreateEduHomeworkCorrectSubmitRequest
  * @return CreateEduHomeworkCorrectSubmitResponse
 */
async function createEduHomeworkCorrectSubmit(request: CreateEduHomeworkCorrectSubmitRequest): CreateEduHomeworkCorrectSubmitResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateEduHomeworkCorrectSubmit', 'POST', '/v1/homework/correct/submit', 'json', true, 'form', request);
}

model CreateEduProblemSolveRequest {
  query: {
    image?: {
      base64?: string(name='base64'),
      format: string(name='format', description='This parameter is required.'),
      url?: string(name='url'),
    }(name='image'),
  }(name='query', description='This parameter is required.', shrink='json', position='Body'),
  requestId?: string(name='requestId', example='019F593F-D6EE-5F44-819A-6CDA127D1637', position='Body'),
}

model CreateEduProblemSolveResponseBody = {
  data?: {
    code?: string(name='code', example='change_batch'),
    finished?: boolean(name='finished'),
    items?: [ 
      {
        content?: string(name='content', example='{}'),
        imageUrl?: string(name='imageUrl'),
        questionId?: string(name='questionId'),
        status?: string(name='status', example='200'),
        thinking?: {
          content?: string(name='content', example='8ci7nsj9WPYXvQb9MJfA'),
          status?: string(name='status', example='200'),
        }(name='thinking'),
      }
    ](name='items'),
    message?: string(name='message', example='ok'),
    requestId?: string(name='requestId', example='098E23F7-A74C-5584-87A1-39734D5B83CE'),
    resultType?: string(name='resultType'),
    retryable?: boolean(name='retryable'),
    usage?: {
      completionTokens?: int32(name='completionTokens'),
      promptTokens?: int32(name='promptTokens'),
    }(name='usage'),
  }(name='data'),
  event?: string(name='event', example='message'),
}

model CreateEduProblemSolveResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateEduProblemSolveResponseBody(name='body'),
}

/**
  * @description ## 请求说明
  * - 本接口支持通过单张题目图片的URL或Base64编码进行解题请求。
  * - 支持处理JPEG、JPG、PNG格式的图片，且图片大小不超过10MB，像素总数不超过260万。
  * - 请求必须携带`request_id`字段，用于链路关联和对账；建议使用UUID以保证唯一性。
  * - `Authorization`头部需包含有效的`appKey`，采用`Bearer <appKey>`格式。
  * - 接口响应为SSE流式数据，客户端应逐事件读取并解析，不得等待连接关闭后整体读取。
  * - 成功响应包括`message`（过程态全量解题快照）和`complete`（最终完整结果）两种事件类型。
  * - 错误处理分为建流前与建流后两个阶段，根据错误码及`retryable`字段决定是否重试。
  * - 客户端超时设置建议不低于3分钟，并确保代理层不会缓存SSE响应或提前关闭长连接。
  * @param request  the request parameters of CreateEduProblemSolve  CreateEduProblemSolveRequest
  * @return CreateEduProblemSolveResponse
 */
async function createEduProblemSolve(request: CreateEduProblemSolveRequest): CreateEduProblemSolveResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateEduProblemSolve', 'POST', '/v1/problem/solve/stream', 'json', true, 'form', request);
}

function createEduProblemSolveWithResponseIterable(request: CreateEduProblemSolveRequest): iterator[CreateEduProblemSolveResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'CreateEduProblemSolve', 'POST', '/v1/problem/solve/stream', 'json', true, 'form', request);
}

