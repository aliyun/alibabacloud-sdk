import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'FCSandbox';
  @version = '2026-05-09';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AgenticBucketVolumeConfig {
  agenticBucket?: string(name='agenticBucket', example='absx9f61c8a-1311999136518149-cn-hangzhou-ab-apsr'),
  bucketName?: string(name='bucketName', example='bs429pop1-1311999136518149-cn-hangzhou-bs-apsr'),
  bucketPath?: string(name='bucketPath', example='/test/'),
  endpoint?: string(name='endpoint', example='https://oss-cn-hangzhou-internal.aliyuncs.com"'),
  readOnly?: boolean(name='readOnly', example='false'),
}

model AgenticFSVolumeConfig {
  groupID?: int32(name='groupID'),
  serverAddr?: string(name='serverAddr'),
  userID?: int32(name='userID'),
}

model ApiKey {
  apiKeyID?: string(name='apiKeyID', description='The unique identifier of the API key.', example='34f6a4c4-499f-4bbd-baa0-0e699f53abcd'),
  apiKeyMask?: string(name='apiKeyMask', description='The masked display value of the API key.', example='e2b_xxxx****xxxx'),
  apiKeyName?: string(name='apiKeyName', description='The name of the API key.', example='dev'),
  apiKeyValue?: string(name='apiKeyValue', description='The value of the API key.', example='e2b_xxxxxx79cd777ef8exxxxxx4ad6f1b567cxxxxxx'),
  createdTime?: string(name='createdTime', description='The time when the API key was created.', example='2023-09-13T08:27:20Z'),
  expireTime?: string(name='expireTime', description='The expiration time.', example='2023-10-13T08:27:20Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist'),
  lastUsedTime?: string(name='lastUsedTime', description='The time when the API key was last used.', example='2023-09-14T08:27:20Z'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-acfmwxqyrgwabcd'),
  source?: string(name='source'),
  status?: string(name='status', description='The status. Valid values:
- active
- inactive', example='active'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='70d1c834-0383-58d8-97ac-5336eb91abcd'),
  teamName?: string(name='teamName', description='The name of the team.', example='Development Team'),
  teamPlan?: string(name='teamPlan'),
  userID?: string(name='userID', description='The UID of the creator.', example='12345'),
  username?: string(name='username', description='The creator.', example='user1'),
}

model CertConfig {
  certName?: string(name='certName'),
  certificate?: string(name='certificate'),
  privateKey?: string(name='privateKey'),
}

model ContainerConfiguration {
  acrInstanceId?: string(name='acrInstanceId'),
  image?: string(name='image'),
  registryCredential?: {
    password?: string(name='password'),
    username?: string(name='username'),
  }(name='registryCredential'),
}

model CreateApiKeyInput {
  apiKeyName?: string(name='apiKeyName', description='The API key name.', example='dev'),
  expireTime?: string(name='expireTime', description='The expiration time.', example='2026-07-24T16:00:00.000Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='70d1c834-0383-58d8-97ac-5336eb91abcd'),
}

model CreateCustomDomainInput {
  certConfig?: CertConfig(name='certConfig'),
  description?: string(name='description'),
  domainName?: string(name='domainName'),
  tlsConfig?: TLSConfig(name='tlsConfig'),
}

model CreateTeamInput {
  description?: string(name='description', description='The description.', example='Development only'),
  plan?: string(name='plan'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-acfmwxqyrgwabcd'),
  teamName?: string(name='teamName', description='The team name.', example='dev'),
}

model CreateTemplateBuildConfig {
  copy?: CreateTemplateCopyAction(name='copy', description='The image copy build action.'),
  envdInject?: CreateTemplateEnvdInjectAction(name='envdInject', description='The envd injection build action.'),
}

model CreateTemplateCopyAction {
  acrInstanceId?: string(name='acrInstanceId', description='The ID of the ACR Enterprise instance where the source image resides.', example='cri-abcd1234efgh'),
  enabled?: boolean(name='enabled', description='Specifies whether to enable image replication.'),
  image?: string(name='image', description='The source image address.', example='registry.cn-hangzhou.aliyuncs.com/demo/nginx:latest'),
  registryConfig?: CreateTemplateRegistryConfig(name='registryConfig', description='The source image repository configuration.'),
  registryType?: string(name='registryType', description='The source image repository type.', example='acr'),
}

model CreateTemplateEnvdInjectAction {
  enabled?: boolean(name='enabled', description='Specifies whether to enable envd injection.'),
}

model CreateTemplateInput {
  buildConfig?: CreateTemplateBuildConfig(name='buildConfig', description='The template build configuration.'),
  name?: string(name='name', description='The template name.', example='my-template'),
  runtimeConfig?: CreateTemplateRuntimeConfig(name='runtimeConfig', description='The template runtime configuration.'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='70d1c834-0383-58d8-97ac-5336eb91abcd'),
}

model CreateTemplateLogConfig {
  logstore?: string(name='logstore', description='The name of the SLS Logstore.', example='my-logstore'),
  project?: string(name='project', description='The name of the Simple Log Service (SLS) project.', example='my-sls-project'),
}

model CreateTemplateRegistryAuthConfig {
  password?: string(name='password', description='The password of the image repository.', example='******'),
  userName?: string(name='userName', description='The username of the image repository.', example='my-user'),
}

model CreateTemplateRegistryCertConfig {
  insecure?: boolean(name='insecure', description='Specifies whether to skip certificate verification.'),
}

model CreateTemplateRegistryConfig {
  authConfig?: CreateTemplateRegistryAuthConfig(name='authConfig', description='The image repository authentication configuration.'),
  certConfig?: CreateTemplateRegistryCertConfig(name='certConfig', description='The image repository certificate configuration.'),
  networkConfig?: CreateTemplateRegistryNetworkConfig(name='networkConfig', description='The image repository network configuration.'),
}

model CreateTemplateRegistryNetworkConfig {
  securityGroupId?: string(name='securityGroupId', description='The ID of the security group where the image repository resides.', example='sg-bp1gx7yj8ud5mabcde'),
  vSwitchId?: string(name='vSwitchId', description='The ID of the vSwitch where the image repository resides.', example='vsw-bp1s5fnlk4jl2abcde'),
  vpcId?: string(name='vpcId', description='The ID of the VPC where the image repository resides.', example='vpc-bp1mwrqm3wkq7abcde'),
}

model CreateTemplateRuntimeConfig {
  cpu?: float(name='cpu', description='The number of CPU cores.', example='1'),
  diskSize?: int32(name='diskSize', description='The disk size. Unit: GB.', example='10'),
  internetAccess?: boolean(name='internetAccess', description='Specifies whether to allow access to the Internet.'),
  logConfig?: CreateTemplateLogConfig(name='logConfig', description='The log configuration.'),
  memorySize?: int32(name='memorySize', description='The memory size. Unit: MB.', example='2048'),
  sandboxConfig?: CreateTemplateSandboxConfig(name='sandboxConfig', description='The sandbox configuration.'),
  vpcConfig?: CreateTemplateVPCConfig(name='vpcConfig', description='The VPC configuration.'),
}

model CreateTemplateSandboxConfig {
  acrInstanceId?: string(name='acrInstanceId', description='The Container Registry Enterprise instance ID.', example='cri-abcd1234efgh'),
  generation?: int32(name='generation', description='The sandbox generation. A value of 1 indicates the first-generation sandbox. A value of 2 indicates the second-generation sandbox.', example='2'),
  image?: string(name='image', description='The image address.', example='registry.cn-hangzhou.aliyuncs.com/demo/nginx:latest'),
  osType?: string(name='osType', description='The operating system type.', example='linux'),
  readyCommand?: string(name='readyCommand', description='The sandbox readiness probe command.', example='curl -sf http://127.0.0.1:8080/healthz'),
  registryConfig?: CreateTemplateRegistryConfig(name='registryConfig', description='The image repository configuration.'),
  registryType?: string(name='registryType', description='The image repository type.', example='acr'),
  startCommand?: string(name='startCommand', description='The sandbox startup command.', example='sleep infinity'),
  steps?: [
    CreateTemplateStep
  ](name='steps', description='The list of custom build steps.'),
}

model CreateTemplateStep {
  args?: [ string ](name='args', description='The list of step parameters.'),
  type?: string(name='type', description='The step type.', example='RUN'),
}

model CreateTemplateVPCConfig {
  role?: string(name='role', description='The VPC authorization role name.', example='AliyunFCSandboxDefaultRole'),
  securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-bp1gx7yj8ud5mabcde'),
  vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitch IDs.'),
  vpcId?: string(name='vpcId', description='VPC ID', example='vpc-bp1mwrqm3wkq7abcde'),
}

model CreateVolumeInput {
  agenticBucketVolumeConfig?: AgenticBucketVolumeConfig(name='agenticBucketVolumeConfig'),
  agenticFSVolumeConfig?: AgenticFSVolumeConfig(name='agenticFSVolumeConfig', description='The AgenticFS configuration.'),
  mountConfig?: {
    role?: string(name='role', description='The RAM role that the user grants to the cloud sandbox. After this role is set, the cloud sandbox assumes the role to generate temporary access credentials. You can use the temporary access credentials of this role to mount storage in the cloud sandbox, such as OSS and AgenticFS.', example='acs:ram::1338904783509062:role/aliyunfcdefaultrole'),
    vpcConfig?: {
      securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-xxxxxxx'),
      vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitches.'),
      vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-8vbq8hbepimf6lr7uyqub'),
    }(name='vpcConfig', description='The VPC configuration.'),
  }(name='mountConfig', description='The mount configuration.'),
  ossVolumeConfig?: OSSVolumeConfig(name='ossVolumeConfig', description='The OSS configuration.'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='70d1c834-0383-58d8-97ac-5336eb91abcd'),
  volumeName?: string(name='volumeName', description='The name, which must be unique within the team.', example='workspace'),
}

