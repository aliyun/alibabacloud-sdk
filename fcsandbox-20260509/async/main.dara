model E2BVolume {
  agenticBucketVolumeConfig?: AgenticBucketVolumeConfig(name='agenticBucketVolumeConfig'),
  agenticFSVolumeConfig?: AgenticFSVolumeConfig(name='agenticFSVolumeConfig', description='The AgenticFS configuration.'),
  createdAt?: string(name='createdAt', description='The time when the volume was created.', example='2026-07-10T11:05:55Z'),
  mountConfig?: {
    role?: string(name='role', description='The RAM role that the user grants to the sandboxed container. After this role is set, the sandboxed container assumes the role to generate temporary access credentials. You can use the temporary access credentials of this role to mount storage in the sandboxed container, such as OSS and AgenticFS.', example='acs:ram::1673427197867277:role/aliyunfcdefaultrole'),
    vpcConfig?: {
      securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-xxxxxx'),
      vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitches.'),
      vpcId?: string(name='vpcId', description='The virtual private cloud (VPC) ID.', example='vpc-2ze4l2vyhej6a6dwapm4q'),
    }(name='vpcConfig', description='The virtual private cloud (VPC) ID.'),
  }(name='mountConfig', description='The mount configuration.'),
  ossVolumeConfig?: OSSVolumeConfig(name='ossVolumeConfig', description='The OSS configuration.'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-acfmwxqyrgwabcd'),
  status?: string(name='status', description='The status. Valid values:
- CREATING
- AVAILABLE
- ERROR
- DELETING', example='CREATING'),
  statusReason?: string(name='statusReason', description='The reason for the status.', example='OK'),
  storageClass?: string(name='storageClass', description='The storage type. Valid values:
- OSS
- AGENTIC_FS', example='OSS'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='88a4c762-b0ce-4661-9413-578b2309e60f'),
  updatedAt?: string(name='updatedAt', description='The time when the volume was last updated.', example='2026-07-10T11:05:55Z'),
  userID?: string(name='userID', description='The UID of the creator.', example='2190856988355929'),
  volumeID?: string(name='volumeID', description='The unique identifier of the volume.', example='82c8c42e-cf7a-46d0-8b58-9024409c1579'),
  volumeName?: string(name='volumeName', description='The name, which is unique within the team.', example='workspace'),
}

