model E2BVolume {
  agenticBucketVolumeConfig?: AgenticBucketVolumeConfig(name='agenticBucketVolumeConfig', description='The AgenticBucket configuration.'),
  agenticFSVolumeConfig?: AgenticFSVolumeConfig(name='agenticFSVolumeConfig', description='The AgenticFS configuration.'),
  createdAt?: string(name='createdAt', description='The creation time.', example='2026-07-10T11:05:55Z'),
  mountConfig?: {
    role?: string(name='role', description='The RAM role that the user grants to the cloud sandbox. After this role is set, the cloud sandbox assumes the role to generate temporary access credentials. You can use the temporary access credentials of this role to mount storage in the cloud sandbox, such as OSS and AgenticFS.', example='acs:ram::1673427197867277:role/aliyunfcdefaultrole'),
    vpcConfig?: {
      securityGroupId?: string(name='securityGroupId', description='The security group ID.', example='sg-xxxxxx'),
      vSwitchIds?: [ string ](name='vSwitchIds', description='The list of vSwitches.'),
      vpcId?: string(name='vpcId', description='The VPC ID.', example='vpc-2ze4l2vyhej6a6dwapm4q'),
    }(name='vpcConfig', description='The VPC ID.'),
  }(name='mountConfig', description='The mount configuration.'),
  ossVolumeConfig?: OSSVolumeConfig(name='ossVolumeConfig', description='The OSS configuration.'),
