  readyCommand?: string(name='readyCommand', description='The sandbox readiness probe command.', example='curl -sf http://127.0.0.1:8080/healthz'),
  registryConfig?: PublicTemplateRegistryConfig(name='registryConfig', description='The image repository configuration.'),
  startCommand?: string(name='startCommand', description='The sandbox startup command.', example='sleep infinity'),
}

model PublicTemplateStatus {
  finishedAt?: string(name='finishedAt', description='The time when the build is completed.', example='2026-08-28T12:00:00.000Z'),
  reason?: PublicTemplateStatusReason(name='reason', description='The reason for the build failure.'),
  state?: string(name='state', description='The build status.', example='ready'),
}

model PublicTemplateStatusReason {
  message?: string(name='message', description='The details of the failure reason.', example='pull image failed: timeout'),
