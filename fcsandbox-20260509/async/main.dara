  status?: string(name='status', description='The status. Valid values:
- CREATING
- AVAILABLE
- ERROR
- DELETING', example='CREATING'),
  statusReason?: string(name='statusReason', description='The status reason.', example='OK'),
  storageClass?: string(name='storageClass', description='The storage type. Valid values:
- OSS
- AGENTIC_FS', example='OSS'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='88a4c762-b0ce-4661-9413-578b2309e60f'),
  updatedAt?: string(name='updatedAt', description='The update time.', example='2026-07-10T11:05:55Z'),
  userID?: string(name='userID', description='The UID of the creator.', example='2190856988355929'),
  volumeID?: string(name='volumeID', description='The unique identifier of the volume.', example='82c8c42e-cf7a-46d0-8b58-9024409c1579'),
