  userID?: int32(name='userID'),
}

model ApiKey {
  apiKeyID?: string(name='apiKeyID', description='The unique identifier of the API key.', example='34f6a4c4-499f-4bbd-baa0-0e699f53abcd'),
  apiKeyMask?: string(name='apiKeyMask', description='The masked display value of the API key.', example='e2b_xxxx****xxxx'),
  apiKeyName?: string(name='apiKeyName', description='The name of the API key.', example='dev'),
  apiKeyValue?: string(name='apiKeyValue', description='The value of the API key.', example='e2b_xxxxxx79cd777ef8exxxxxx4ad6f1b567cxxxxxx'),
  createdTime?: string(name='createdTime', description='The time when the API key was created.', example='2023-09-13T08:27:20Z'),
  expireTime?: string(name='expireTime', description='The expiration time.', example='2023-10-13T08:27:20Z'),
  ipBlacklist?: [
    IPConfig
  ](name='ipBlacklist'),
  ipWhitelist?: [
    IPConfig
  ](name='ipWhitelist'),
  lastUsedTime?: string(name='lastUsedTime', description='The time when the API key was last used.', example='2023-09-14T08:27:20Z'),
  resourceGroupID?: string(name='resourceGroupID', description='The resource group ID.', example='rg-acfmwxqyrgwabcd'),
  source?: string(name='source'),
  status?: string(name='status', description='The status. Valid values:
- active
- inactive', example='active'),
  teamID?: string(name='teamID', description='The unique identifier of the team.', example='70d1c834-0383-58d8-97ac-5336eb91abcd'),
  teamName?: string(name='teamName', description='The name of the team.', example='Development Team'),
  teamPlan?: string(name='teamPlan'),
  userID?: string(name='userID', description='The UID of the creator.', example='12345'),
  username?: string(name='username', description='The creator.', example='user1'),
}

