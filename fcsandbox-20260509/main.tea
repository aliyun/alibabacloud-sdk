  };
  var params = new OpenApi.Params{
    action = 'CreateApiKey',
    version = '2026-05-09',
    protocol = 'HTTPS',
    pathname = `/pop/2026-05-09/api-keys`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

