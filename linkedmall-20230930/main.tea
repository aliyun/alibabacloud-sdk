    'cn-qingdao' = 'linkedmall.aliyuncs.com',
    'cn-qingdao-nebula' = 'linkedmall.aliyuncs.com',
    'cn-shanghai-et15-b01' = 'linkedmall.aliyuncs.com',
    'cn-shanghai-et2-b01' = 'linkedmall.aliyuncs.com',
