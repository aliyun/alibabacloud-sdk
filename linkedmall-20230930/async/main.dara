  dxPrice?: long(name='dxPrice', description='The consignment supply price.'),
  hasCredit?: boolean(name='hasCredit', description='Specifies whether credit periods are supported.'),
  hasInvoice?: boolean(name='hasInvoice', description='Specifies whether invoicing is supported.'),
  jxPrice?: long(name='jxPrice', description='The distribution supply price.'),
  picUrl?: string(name='picUrl', description='The image.', example='https://example.com/images/product.png'),
  quantity?: int32(name='quantity', description='The inventory.', example='100'),
  skuId?: string(name='skuId', description='sku id', example='660460842235822082'),
  skuStatus?: string(name='skuStatus', description='The status.'),
  taxCode?: string(name='taxCode', description='The tax code.'),
  taxRate?: int32(name='taxRate', description='The tax rate.'),
  title?: string(name='title', description='The name.', example='示例商品名称'),
}

model Division {
