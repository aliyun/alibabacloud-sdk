/**
  * @description Performs a paged query on the product list based on the page number and paging size.
  * @param request  the request parameters of SearchProducts  SearchProductsRequest
  * @return SearchProductsResponse
 */
async function searchProducts(request: SearchProductsRequest): SearchProductsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'SearchProducts', 'POST', '/opensaas-s2b/opensaas-s2b-biz-trade/v2/selectionPool/selection-group/product/command/searchProduct', 'json', false, 'json', request);
}

