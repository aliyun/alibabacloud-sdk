model DistributionProduct {
  categoryChain?: string(name='categoryChain', description='The category chain name.'),
  categoryLeafId?: long(name='categoryLeafId', description='The leaf category ID.', example='50016422'),
  categoryLeafName?: string(name='categoryLeafName', description='The leaf category name.', example='示例类目'),
