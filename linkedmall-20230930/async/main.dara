model EticketInfo {
  availableNum?: long(name='availableNum', description='The number of unredeemed voucher electronic credentials.', example='0'),
  code?: string(name='code', description='The code of the voucher electronic credential.', example='taobao******tpg'),
  codeStatus?: long(name='codeStatus', description='The status of the voucher electronic credential.
> Valid values:
> - 1: valid
> - -1: redeemed
> - -2: expired
> - 100: locked', example='-1'),
  endTime?: string(name='endTime', description='The end time of the validity period for the voucher electronic credential.', example='2026-08-02T23:59:59.000+08:00'),
  lockNum?: long(name='lockNum', description='The number of voucher electronic credentials in locked status.', example='0'),
  qrcodeUrl?: string(name='qrcodeUrl', description='The URL of the QR code image for the voucher electronic credential.', example='http://qrcode.alicdn.com/img.jpg'),
  startTime?: string(name='startTime', description='The start time of the validity period for the voucher electronic credential.', example='2026-02-04T00:00:00.000+08:00'),
  useTime?: string(name='useTime', description='The redemption time of the voucher electronic credential.', example='2026-02-04T15:07:59.000+08:00'),
  usedNum?: long(name='usedNum', description='The number of redeemed voucher electronic credentials.', example='1'),
}

