  skus?: [
    DistributionSku
  ](name='skus', description='The SKU list.'),
  title?: string(name='title', description='The long product title.', example='示例商品名称'),
  whiteBackgroundPicUrl?: string(name='whiteBackgroundPicUrl', description='The white background image.', example='https://example.com/images/product-white.png'),
}

model DistributionSku {
