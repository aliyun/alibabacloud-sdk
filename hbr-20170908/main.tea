model AddDataSourceRequest {
  clusterId?: string(name='ClusterId', description='The ID of the client group used to access the data source.', example='cl-0004i0nlngorvgjpl7ck'),
  connectionInfo?: string(name='ConnectionInfo', description='The connection information for the data source. Examples:

- Local NAS data source:
  {
  "dataServerAddresses": [
  {
  "host": "123.123.123.123",
  "port": "8080"
  }
  ],
  "sharePath": "/share",
  "mountOptions": "vers=3",
  "fileSystemType": "nfs"
  }

- CPFS AI-Computing Edition data source:
  {"vpcMountTarget":"cpfs-010wn\\\\*\\\\*\\\\*wy-vpc-ta\\\\*\\\\*\\\\*8.cn-shanghai.cpfs.aliyuncs.com","sharePath":"/"}

- Other large-scale file system data source:
  {"path":"/mnt"}', example='{
    "dataServerAddresses": [
        {
            "host": "123.123.123.123",
            "port": "8080"
        }
    ],
    "sharePath": "/share",
    "mountOptions": "vers=3",
    "fileSystemType": "nfs"
}'),
  credential?: string(name='Credential', description='The access credential for the data source. This parameter is required for local NAS (SMB) data sources and for OSS- or S3-compatible data sources. Examples:

- Local NAS data source (SMB protocol):
  {
  "mountUsername": "\\\\*\\\\*\\\\*\\\\*\\\\*",
  "mountPassword": "\\\\*\\\\*\\\\*\\\\*\\\\*"
  }

- OSS-compatible or S3-compatible data source:
  {
  "accessKeyId": "\\\\*\\\\*\\\\*\\\\*\\\\*",
  "accessKeySecret": "\\\\*\\\\*\\\\*\\\\*\\\\*"
  }', example='{
    "mountUsername": "*****",
    "mountPassword": "*****"
}'),
  dataSourceName?: string(name='DataSourceName', description='The name of the data source.

This parameter is required.', example='MyLocalNas'),
  dataSourceType?: string(name='DataSourceType', description='The type of the data source.

This parameter is required.', example='COMMON_NAS'),
  exclude?: string(name='Exclude', description='A filter that specifies the files to exclude. This parameter applies only to data source analysis with the archive feature.', example='["/home/alice/log"]'),
  include?: string(name='Include', description='A filter that specifies the files to include. This parameter applies only to data source analysis with the archive feature.', example='["/home/alice", "/home/bob"]'),
  indexLevel?: string(name='IndexLevel', description='The index level. This parameter applies only to data source analysis with the archive feature.

- `OFF`: No index is created.

- `META`: A metadata index is created.

- `ALL`: A full-text index is created. (Deprecated)', example='META'),
  options?: string(name='Options', description='The options for data source analysis. This parameter applies only to data source analysis with the archive feature.', example='{}'),
  path?: [ string ](name='Path', description='A list of paths for data source analysis. This parameter applies only to data source analysis with the archive feature.'),
  schedule?: string(name='Schedule', description='The execution schedule. This parameter applies only to data source analysis with the archive feature. The format `I|{startTime}|{interval}` specifies a task that runs at a defined interval starting from `{startTime}`. `{interval}` is an ISO 8601 duration. For example, `PT1H` specifies a one-hour interval, and `P1D` specifies a one-day interval.', example='I|1729493847|P1D'),
  speedLimit?: string(name='SpeedLimit', description='The rate limiting settings. This parameter applies only to data source analysis with the archive feature.', example='6:21:10240'),
}

model AddDataSourceResponseBody = {
  code?: string(name='Code', description='The HTTP status code.', example='200'),
  dataSourceId?: string(name='DataSourceId', description='The data source ID.', example='ds-000*******xzj'),
  message?: string(name='Message', description='The response message.', example='successful'),
  requestId?: string(name='RequestId', description='The request ID.', example='53167AD3-****-****-92C7-CF69A000BA45'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='true'),
}

model AddDataSourceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddDataSourceResponseBody(name='body'),
}

/**
 * @summary Creates a data source.
 *
 * @description - The local NAS backup feature supports the local NAS (`COMMON_NAS`) data source type.
 * - The CPFS backup feature supports the following data source types: CPFS (`CPFS`), CPFS AI-Computing Edition (`BMCPFS`), and other large-scale file system (`COMMON_FILE_SYSTEM`).
 * - The archive feature supports the following data source types: local NAS (`COMMON_NAS`), HDFS (`HDFS`), and S3 (`S3`).
 *
 * @param request AddDataSourceRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddDataSourceResponse
 */
async function addDataSourceWithOptions(request: AddDataSourceRequest, runtime: Util.RuntimeOptions): AddDataSourceResponse {
  Util.validateModel(request);
  var query = {};
  if (!Util.isUnset(request.clusterId)) {
    query['ClusterId'] = request.clusterId;
  }
  if (!Util.isUnset(request.connectionInfo)) {
    query['ConnectionInfo'] = request.connectionInfo;
  }
  if (!Util.isUnset(request.credential)) {
    query['Credential'] = request.credential;
  }
  if (!Util.isUnset(request.dataSourceName)) {
    query['DataSourceName'] = request.dataSourceName;
  }
  if (!Util.isUnset(request.dataSourceType)) {
    query['DataSourceType'] = request.dataSourceType;
  }
  if (!Util.isUnset(request.exclude)) {
    query['Exclude'] = request.exclude;
  }
  if (!Util.isUnset(request.include)) {
    query['Include'] = request.include;
  }
  if (!Util.isUnset(request.indexLevel)) {
    query['IndexLevel'] = request.indexLevel;
  }
  if (!Util.isUnset(request.options)) {
    query['Options'] = request.options;
  }
  if (!Util.isUnset(request.path)) {
    query['Path'] = request.path;
  }
  if (!Util.isUnset(request.schedule)) {
    query['Schedule'] = request.schedule;
  }
  if (!Util.isUnset(request.speedLimit)) {
    query['SpeedLimit'] = request.speedLimit;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'AddDataSource',
    version = '2017-09-08',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Creates a data source.
 *
 * @description - The local NAS backup feature supports the local NAS (`COMMON_NAS`) data source type.
 * - The CPFS backup feature supports the following data source types: CPFS (`CPFS`), CPFS AI-Computing Edition (`BMCPFS`), and other large-scale file system (`COMMON_FILE_SYSTEM`).
 * - The archive feature supports the following data source types: local NAS (`COMMON_NAS`), HDFS (`HDFS`), and S3 (`S3`).
 *
 * @param request AddDataSourceRequest
 * @return AddDataSourceResponse
 */
async function addDataSource(request: AddDataSourceRequest): AddDataSourceResponse {
  var runtime = new Util.RuntimeOptions{};
  return addDataSourceWithOptions(request, runtime);
}

model BrowseFilesRequest {
  absolutePath?: string(name='AbsolutePath', description='The absolute path of the directory. Specify `/` to browse the root directory of the backup.', example='/data/'),
  clientId?: string(name='ClientId', description='The backup client ID.', example='c-000***o48'),
  edition?: string(name='Edition', description='The Cloud Backup edition. Valid values:

- **STANDARD**: Standard Edition. This is the default value.

- **BASIC**: Basic Edition. Only ECS file backup is supported in Basic Edition.', example='STANDARD'),
  maxResults?: int32(name='MaxResults', description='The maximum number of results to return per request.

Valid values: 10 to 100. Default value: 10.', example='10'),
  nextToken?: string(name='NextToken', description='The token that is required to retrieve the next page of results. If this parameter is not specified, the first page of results is returned.', example='eyJ***Q=='),
  pageNumber?: int32(name='PageNumber', description='Deprecated. Use MaxResults and NextToken for pagination instead.', example='1'),
  pageSize?: int32(name='PageSize', description='Deprecated. Use MaxResults and NextToken for pagination instead.', example='10'),
  path?: string(name='Path', description='The hash value of the directory. If this parameter is not specified, the root directory of the backup is browsed.', example='ef6***46a'),
  restoreId?: string(name='RestoreId', description='Deprecated.', example='r-000***oy9'),
  securityToken?: string(name='SecurityToken'),
  snapshotHash?: string(name='SnapshotHash', description='The hash value of the backup snapshot.', example='971***e9d'),
  storageClass?: string(name='StorageClass', description='The storage class of the backup data. Valid values:

- **STANDARD**: Standard.

- **ARCHIVE**: Archive.', example='STANDARD'),
  token?: string(name='Token', description='Deprecated. Do not use.', example='***'),
  vaultId?: string(name='VaultId', description='The backup vault ID.', example='v-000***jtz'),
}

model BrowseFilesResponseBody = {
  code?: string(name='Code', description='The HTTP status code. A value of 200 indicates that the request was successful.', example='200'),
  maxResults?: int32(name='MaxResults', description='The maximum number of entries returned per page.', example='10'),
  message?: string(name='Message', description='The response message. The value `successful` is returned if the request was successful. An error message is returned if the request failed.', example='successful'),
  nextToken?: string(name='NextToken', description='The pagination token for the next page of results. An empty value indicates that no more pages are available.', example='eyJ***Q=='),
  nodes?: {
    node?: [ 
    {
      name?: string(name='Name'),
      size?: long(name='Size'),
      subtree?: string(name='Subtree'),
      type?: string(name='Type'),
    }
  ](name='Node')
  }(name='Nodes'),
