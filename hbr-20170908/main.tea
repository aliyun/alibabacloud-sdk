  include?: string(name='Include', description='This parameter is valid only when **SourceType** is set to **ECS_FILE**, **File**, **NAS**, **COMMON_NAS**, or **COMMON_FILE_SYSTEM**. Specifies the file types to back up. All files of these types are backed up. The value can be up to 255 characters in length.', example='[\\\\"*.doc\\\\",\\\\"*.xltm\\\\"]'),
