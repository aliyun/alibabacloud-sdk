      snapshotGroup?: boolean(name='SnapshotGroup', description='Specifies whether to create a snapshot-consistent group. Snapshot-consistent groups are supported only when all cloud disk types are ESSD.', example='true'),
      timeoutInSeconds?: long(name='TimeoutInSeconds', description='This parameter is required only when **AppConsistent** is set to **true**. The I/O freeze timeout period. Unit: seconds. Default value: 30.', example='30'),
