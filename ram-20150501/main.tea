model ChangePasswordRequest {
  newPassword?: string(name='NewPassword', description='The new console logon password of the Resource Access Management (RAM) user.

The password must meet the password strength requirements. For more information, see [SetPasswordPolicy](https://help.aliyun.com/document_detail/28739.html).', example='aw$2****'),
  oldPassword?: string(name='OldPassword', description='The old console logon password of the Resource Access Management (RAM) user.', example='12****'),
}

model ChangePasswordResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='04F0F334-1335-436C-A1D7-6C044FE73368'),
