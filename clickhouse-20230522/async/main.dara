model AttachWhitelistTemplateToInstanceRequest {
  DBInstanceId: string(name='DBInstanceId', description='The database instance IDs. Separate multiple IDs with commas. You can associate or disassociate up to 20 instances at a time.

This parameter is required.', example='cc-nkhdbf1d,cc-nkhdbf1s', position='Query'),
  regionId: string(name='RegionId', description='RegionId

This parameter is required.', example='cn-hangzhou', position='Query'),
  templateId: string(name='TemplateId', description='The whitelist template ID.

This parameter is required.', example='98a6d3db05984dca', position='Query'),
}

model AttachWhitelistTemplateToInstanceResponseBody = {
  data?: {
    attachFailList?: [ 
      {
        DBInstanceId?: string(name='DBInstanceId', description='The instance name.', example='my-database'),
        reason?: string(name='Reason', description='The reason for the disassociation failure.', example='Processing exception'),
      }
    ](name='AttachFailList', description='The instances that failed to be disassociated.'),
    attachSuccessedList?: [ 
      {
        DBInstanceId?: string(name='DBInstanceId', description='The instance name.', example='my-database'),
        templates?: [ 
          {
            dbInstances?: [ 
              {
                DBInstanceId?: string(name='DBInstanceId', description='The instance ID.', example='asdfwef'),
              }
            ](name='DbInstances', description='The associated instances.'),
            securityIPList?: string(name='SecurityIPList', description='The IP whitelists.', example='192.168.1.1,10.0.0.1'),
            templateId?: string(name='TemplateId', description='The whitelist template ID.', example='g-asdfwem'),
            templateName?: string(name='TemplateName', description='The whitelist template name.', example='demo_template'),
          }
        ](name='Templates', description='The whitelist templates.'),
      }
    ](name='AttachSuccessedList', description='The templates that were successfully associated.'),
    status?: string(name='Status', description='The operation status.', example='ok'),
  }(name='Data', description='The returned data.'),
  requestId?: string(name='RequestId', description='Id of the request', example='1234567890'),
}

model AttachWhitelistTemplateToInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachWhitelistTemplateToInstanceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AttachWhitelistTemplateToInstance  AttachWhitelistTemplateToInstanceRequest
  * @return AttachWhitelistTemplateToInstanceResponse
 */
async function attachWhitelistTemplateToInstance(request: AttachWhitelistTemplateToInstanceRequest): AttachWhitelistTemplateToInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AttachWhitelistTemplateToInstance', 'POST', '/', 'json', false, 'json', request);
}

