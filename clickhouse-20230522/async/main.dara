model CreateDBInstanceRequest {
  backupSetId?: string(name='BackupSetId', description='The backup set ID.', example='1', position='Query'),
  category?: string(name='Category', description='The cluster edition. Valid values:

- enterprise: Enterprise Edition.', example='enterprise', position='Query'),
  clientToken?: string(name='ClientToken', description='Ensures the idempotence of the request and prevents duplicate submissions. The value is generated by the client and must be unique across different requests. The value can be up to 64 ASCII characters in length and cannot contain non-ASCII characters.', example='AB', position='Query'),
  DBInstanceDescription?: string(name='DBInstanceDescription', description='The description of the cluster.', example='Cluster test', position='Query'),
  DBTimeZone?: string(name='DBTimeZone', description='The time zone setting for the database kernel. The value must be an IANA time zone identifier.', example='Asia/Shanghai', position='Query'),
  deploySchema?: string(name='DeploySchema', description='The cluster zone deployment status.', example='multi_az', position='Query'),
  engine?: string(name='Engine', description='The engine type.', example='clickhouse', position='Query'),
  engineVersion?: string(name='EngineVersion', description='The database engine version.', example='23.8', position='Query'),
  multiZone?: [ 
    {
      vSwitchIds?: [ string ](name='VSwitchIds', description='The vSwitch ID.'),
      zoneId?: string(name='ZoneId', description='The zone ID.', example='cn-hangzhou-h'),
    }
  ](name='MultiZone', description='The multi-zone configuration.', shrink='json', position='Query'),
  nodeCount?: int32(name='NodeCount', description='The number of nodes. Valid values: 2 to 16. This parameter is required when you use NodeScaleMin and NodeScaleMax to configure the scaling range.', example='2', minimum=2, maximum=64, position='Query'),
  nodeScaleMax?: int32(name='NodeScaleMax', description='The maximum number of serverless nodes for elastic scaling. Valid values: 4 to 32. The value must be greater than the minimum value.', example='4', minimum=4, maximum=128, position='Query'),
  nodeScaleMin?: int32(name='NodeScaleMin', description='The minimum number of serverless nodes for elastic scaling. Valid values: 4 to 32.', example='32', minimum=4, maximum=128, position='Query'),
  regionId: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The ID of the resource group to which the cluster belongs.', example='rg-*****', position='Query'),
  scaleMax?: string(name='ScaleMax', description='The maximum value for serverless elastic scaling. This parameter is deprecated. Use NodeCount, NodeScaleMin, and NodeScaleMax to configure the scaling capabilities instead.', example='32', position='Query'),
  scaleMin?: string(name='ScaleMin', description='The minimum value for serverless elastic scaling. This parameter is deprecated. Use NodeCount, NodeScaleMin, and NodeScaleMax to configure the scaling capabilities instead.', example='8', position='Query'),
  sourceDBInstanceId?: string(name='SourceDBInstanceId', description='The source cluster instance ID. This parameter is required when you recover from a backup.', example='cc-2ze1*********', position='Query'),
  storageQuota?: long(name='StorageQuota', example='100', minimum=0, position='Query'),
  storageType?: string(name='StorageType', example='OSS', position='Query'),
  tags?: [ 
    {
      key?: string(name='Key', description='The key of the instance tag label.', example='user_123'),
      value?: string(name='Value', description='The value of the instance tag label.', example='example string'),
    }
  ](name='Tags', description='The list of tags.', position='Query'),
  vpcId?: string(name='VpcId', description='The VPC ID.', example='vpc-uf6xmupdn7v6ui9f****', position='Query'),
  vswitchId?: string(name='VswitchId', description='The vSwitch ID.', example='vsw-uf632qye9oqt4x4sr****', position='Query'),
  zoneId?: string(name='ZoneId', description='The zone ID.', example='cn-hangzhou-h', position='Query'),
}

