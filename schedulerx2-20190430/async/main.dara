  timeoutKillEnable?: boolean(name='TimeoutKillEnable', description='Specifies whether to enable the timeout termination for the current trigger. Valid values:

- **true**: enables the timeout termination.
- **false**: disables the timeout termination.', example='true', position='Body'),
