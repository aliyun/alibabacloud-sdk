  clusterId?: string(name='ClusterId', description='The cluster ID.', example='i15dfa12e8f27c44f4a006c2c8bb', position='Body'),
  ignoreFailedNodeTasks?: boolean(name='IgnoreFailedNodeTasks', description='Specifies whether to skip failed nodes. Default value: False.', example='false', position='Body'),
  nodes?: [ 
    {
