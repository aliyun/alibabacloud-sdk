model CreateNetTestTaskRequest {
  regionId?: string(name='RegionId', position='Host'),
  clusterId?: string(name='ClusterId', description='The cluster ID.', example='i119982311660892626523', position='Body'),
  clusterName?: string(name='ClusterName', description='The cluster name.', example='Eflo-YJ-Test-Cluster', position='Body'),
  commTest?: {
    GPUNum?: long(name='GPUNum', description='The number of GPUs.', example='1'),
    hosts?: [ 
      {
        ip?: string(name='IP', description='The IP address.', example='169.253.253.15'),
        nodeId?: string(name='NodeId', description='The node ID.', example='e01-tw-bqisacl3z6l'),
        resourceId?: string(name='ResourceId', description='The resource ID.', example='i111670831721110797708'),
        serverName?: string(name='ServerName', description='The service name.', example='VBw'),
      }
    ](name='Hosts', description='The hosts.'),
    model?: string(name='Model', description='The communication library model.', example='intention_v4'),
    type?: string(name='Type', description='The type of communication library test. Valid values: ACCL and NCCL.', example='ACCL'),
  }(name='CommTest', description='Specify this parameter if NetTestType is set to CommTest.', shrink='json', position='Body'),
  delayTest?: {
    hosts?: [ 
      {
        bond?: string(name='Bond', description='The bonded NIC port.', example='bond1'),
        ip?: string(name='IP', description='The IP address of the node.', example='125.210.225.48'),
        nodeId?: string(name='NodeId', description='The node ID.', example='e01-cn-fou43an0a05'),
        resourceId?: string(name='ResourceId', description='The resource ID.', example='e01-cn-bcd3u1aee06'),
        serverName?: string(name='ServerName', description='The service name.', example='NQU'),
      }
    ](name='Hosts', description='The hosts of the test nodes.'),
  }(name='DelayTest', description='Specify this parameter if NetTestType is set to DelayTest.', shrink='json', position='Body'),
  netTestType?: string(name='NetTestType', description='The type of network test. Valid values: DelayTest, TrafficTest, and CommTest.', example='DelayTest', position='Body'),
  networkMode?: string(name='NetworkMode', description='The network mode.', example='2', position='Body'),
  port?: string(name='Port', description='The test port number.', example='23604', position='Body'),
  trafficTest?: {
    clients?: [ 
      {
        bond?: string(name='Bond', description='The bonded port of the network interface card (NIC).', example='bond1'),
        ip?: string(name='IP', description='The IP address of the node.', example='192.168.1.1'),
        nodeId?: string(name='NodeId', description='The node ID.', example='e01-tw-w5elqg7pw18'),
        resourceId?: string(name='ResourceId', description='The resource ID.', example='e01-cn-20s41p6cx01'),
        serverName?: string(name='ServerName', description='The service name.', example='xMv'),
      }
    ](name='Clients', description='The client resources.'),
    duration?: long(name='Duration', description='The runtime duration of the flow task, in seconds.', example='1'),
    GDR?: boolean(name='GDR', description='If Protocol is set to RDMA, specify True or False. This field is empty if Protocol is set to TCP.', example='False'),
    protocol?: string(name='Protocol', description='The network protocol. Valid values: RDMA and TCP.', example='TCP'),
    qp?: long(name='QP', description='If Protocol is set to TCP, specify the number of concurrent connections for the test. If Protocol is set to RDMA, specify the QP value.', example='1'),
    servers?: [ 
