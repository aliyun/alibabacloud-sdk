        size?: int32(name='Size', description='The size of the cloud disk. Unit: GB.', example='9999'),
      }(name='SystemDisk', description='The system cloud disk information.'),
      userData?: string(name='UserData', description='The custom executable shell script. The script must be encoded in Base64. The maximum size of the raw data is 16 KB.', example='ZWNobyBoZWxsbyBlY3Mh'),
