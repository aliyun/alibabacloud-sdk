async function changeNodeGroupWithOptions(tmpReq: ChangeNodeGroupRequest, runtime: Util.RuntimeOptions): ChangeNodeGroupResponse {
  Util.validateModel(tmpReq);
  var request = new ChangeNodeGroupShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!Util.isUnset(tmpReq.nodes)) {
    request.nodesShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.nodes, 'Nodes', 'json');
  }
