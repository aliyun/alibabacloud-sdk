import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Cloudfw';
  @version = '2017-12-07';
  @endpointRule = 'central';
  @endpointMap = {
    'ap-southeast-1' = 'cloudfw.ap-southeast-1.aliyuncs.com',
    'cn-hangzhou' = 'cloudfw.cn-hangzhou.aliyuncs.com',
    'ap-southeast-3' = 'cloudfw.ap-southeast-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model AddAclBackupDataRequest {
  backUpTime: string(name='BackUpTime', description='The backup time, specified as a Unix timestamp (the number of seconds that have elapsed since 00:00:00 UTC on January 1, 1970).

This parameter is required.', example='1743683400', position='Query'),
  description?: string(name='Description', description='The description of the backup data.', example='bj-001', position='Query'),
  lang?: string(name='Lang', description='The language of the request and response.', example='zh', position='Query'),
  sourceIp?: string(name='SourceIp', description='The source IP address of the request.', example='115.194.124.XXX', position='Query'),
}

model AddAclBackupDataResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='244EA37C-D2AB-54A7-B6E3-7ED0E9A1****'),
}

model AddAclBackupDataResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddAclBackupDataResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddAclBackupData  AddAclBackupDataRequest
  * @return AddAclBackupDataResponse
 */
async function addAclBackupData(request: AddAclBackupDataRequest): AddAclBackupDataResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddAclBackupData', 'POST', '/', 'json', false, 'json', request);
}

model AddAddressBookRequest {
  ackClusterConnectorId?: string(name='AckClusterConnectorId', description='The ACK cluster connector ID. You can obtain the value from the following operation:
- [DescribeAckClusterConnectors](~~DescribeAckClusterConnectors~~): Lists ACK cluster connectors.', example='ac-7c1bad6c3cc84c33baab1', position='Query'),
  ackLabels?: [ 
    {
      key?: string(name='Key', description='The key of the ACK cluster pod label.', example='app'),
      value?: string(name='Value', description='The value of the ACK cluster pod label.', example='storage-operator'),
    }
  ](name='AckLabels', description='The list of ACK cluster pod labels.

> A maximum of 10 labels are supported.', position='Query'),
  ackNamespaces?: [ string ](name='AckNamespaces', description='The list of ACK cluster pod namespaces.
> A maximum of 10 namespaces are supported.', position='Query'),
  addressList?: string(name='AddressList', description='The addresses in the address book. Separate multiple addresses with commas (,). Use a space to separate an address from its description within a single address element.

> This parameter is required when GroupType is set to `ip`, `port`, or `domain`.

- When GroupType is set to `ip`, enter IP addresses in the address list. Example: 192.0.XX.XX/32 Development CIDR block,10.0.0.X/24,192.0.XX.XX/24 Test CIDR block.

- When GroupType is set to `port`, enter ports or port ranges in the address list. Example: 80 HTTP port,100/200,3306 Database port.

- When GroupType is set to `domain`, enter domain names in the address list. Example: example.com Test domain name,aliyundoc.com,www.aliyun.com Alibaba Cloud official website.', example='192.0.XX.XX/32 ,192.0.XX.XX/24', position='Query'),
  assetMemberUids?: [ long ](name='AssetMemberUids', description='The list of member accounts for the asset address book.', shrink='json', position='Query'),
  assetRegionResourceTypes?: [ 
    {
      assetRegionId?: string(name='AssetRegionId', description='The region ID of the asset.', example='all'),
      resourceType?: {
        ipv4?: {
          aiGatewayEIP?: boolean(name='AiGatewayEIP', description='The asset type: AIGatewayEIP.', example='false'),
          albEIP?: boolean(name='AlbEIP', description='The asset type: AlbEIP.', example='false'),
          apiGatewayEIP?: boolean(name='ApiGatewayEIP', description='The asset type: ApigEIP.', example='false'),
          bastionHostEgressIP?: boolean(name='BastionHostEgressIP', description='The asset type: BastionHostEgressIP.', example='false'),
          bastionHostIP?: boolean(name='BastionHostIP', description='The asset type: BastionHostIP.', example='false'),
          bastionHostIngressIP?: boolean(name='BastionHostIngressIP', description='The asset type: BastionHostIngressIP.', example='false'),
          EIP?: boolean(name='EIP', description='The asset type: EIP.', example='false'),
          ecsEIP?: boolean(name='EcsEIP', description='The asset type: EcsEIP.', example='false'),
          ecsPublicIP?: boolean(name='EcsPublicIP', description='The asset type: EcsPublicIP.', example='false'),
          eniEIP?: boolean(name='EniEIP', description='The asset type: EniEIP.', example='false'),
          gaEIP?: boolean(name='GaEIP', description='The asset type: GaEIP.', example='false'),
          HAVIP?: boolean(name='HAVIP', description='The asset type: HAVIP.', example='false'),
          natEIP?: boolean(name='NatEIP', description='The asset type: NatEIP.', example='false'),
          natPublicIP?: boolean(name='NatPublicIP', description='The asset type: NatPublicIP.', example='false'),
          nlbEIP?: boolean(name='NlbEIP', description='The asset type: NlbEIP.', example='false'),
          slbEIP?: boolean(name='SlbEIP', description='The asset type: SlbEIP.', example='true'),
          slbPublicIP?: boolean(name='SlbPublicIP', description='The asset type: SlbPublicIP.', example='false'),
        }(name='Ipv4', description='The IPv4 asset type.'),
        ipv6?: {
          aiGatewayEIPv6?: boolean(name='AiGatewayEIPv6', description='The asset type: AIGatewayEIPv6.', example='false'),
          albIPv6?: boolean(name='AlbIPv6', description='The asset type: AlbIPv6.', example='false'),
          apiGatewayEIPv6?: boolean(name='ApiGatewayEIPv6', description='The asset type: ApigEIPv6.', example='false'),
          ecsIPv6?: boolean(name='EcsIPv6', description='The asset type: EcsIPv6.', example='false'),
          eniEIPv6?: boolean(name='EniEIPv6', description='The asset type: EniEIPv6.', example='false'),
          gaEIPv6?: boolean(name='GaEIPv6', description='The asset type: GaEIPv6.', example='false'),
          nlbIPv6?: boolean(name='NlbIPv6', description='The asset type: NlbIPv6.', example='false'),
          slbIPv6?: boolean(name='SlbIPv6', description='The asset type: SlbIPv6.', example='false'),
        }(name='Ipv6', description='The IPv6 asset type.'),
      }(name='ResourceType', description='The asset type.'),
    }
  ](name='AssetRegionResourceTypes', description='The list of regions and resource types for the asset address book.', shrink='json', position='Query'),
  autoAddTagEcs?: string(name='AutoAddTagEcs', description='Indicates whether to automatically add the public IP addresses of Elastic Compute Service (ECS) instances that match the specified tags to the address book.', example='1', position='Query'),
  description: string(name='Description', description='The description of the address book.

This parameter is required.', example='sz-001', minLength=2, maxLength=256, position='Query'),
  groupName: string(name='GroupName', description='The name of the address book.

This parameter is required.', example='sz-001', minLength=2, maxLength=128, position='Query'),
  groupType: string(name='GroupType', description='The type of the address book.

This parameter is required.', example='ip', position='Query'),
  lang?: string(name='Lang', description='The language type of the address book description.', example='zh', position='Query'),
  sourceIp?: string(name='SourceIp', description='The source IP address of the request.', example='192.0.XX.XX', deprecated='true', position='Query'),
  tagList?: [ 
    {
      tagKey?: string(name='TagKey', description='The key of the ECS tag.', example='TXY'),
      tagValue?: string(name='TagValue', description='The value of the ECS tag.', example='1'),
    }
  ](name='TagList', description='The ECS tag list.', position='Query'),
  tagRelation?: string(name='TagRelation', description='The logical relationship among multiple ECS tags to match.', example='and', position='Query'),
