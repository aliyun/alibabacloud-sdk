  regionId?: string(name='RegionId', description='This parameter is required.', position='Host'),
  pipelineRunId: string(name='PipelineRunId', description='The ID of the cross-workspace publish flow.

This parameter is required.', example='fcfd4160-e2ff-4603-9719-09128fe733df', position='Body'),
