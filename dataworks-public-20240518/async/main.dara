  tableMappings?: [ 
    {
      sourceObjectSelectionRules?: [ 
        {
          action?: string(name='Action', description='The selection action. Valid values: Include and Exclude.', example='Include'),
          expression?: string(name='Expression', description='The expression.', example='mysql_table_1'),
