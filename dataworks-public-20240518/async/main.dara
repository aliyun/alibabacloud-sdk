  }(name='Data', description='The saved semantic job definition. Use Data.Name to call RunSemanticJob, DeleteSemanticJob, ListSemanticJobRuns, and DownloadSemanticResults.'),
  requestId?: string(name='RequestId', description='The request ID. Used for locating logs and troubleshooting issues.', example='676271D6-53B4-57BE-89FA-72F7AE1418DF'),
