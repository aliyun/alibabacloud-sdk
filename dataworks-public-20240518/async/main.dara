  * @return CreateDIJobResponse
 */
async function createDIJob(request: CreateDIJobRequest): CreateDIJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateDIJob', 'POST', '/', 'json', true, 'form', request);
}

