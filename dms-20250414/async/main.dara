model AgenticTableBaseInfo {
  catalogType?: string(name='CatalogType'),
  databaseQualifiedName?: string(name='DatabaseQualifiedName'),
  databaseUuid?: string(name='DatabaseUuid'),
  description?: string(name='Description'),
  engineMeta?: AgenticTableEngineMeta(name='EngineMeta'),
  name?: string(name='Name'),
  qualifiedName?: string(name='QualifiedName'),
  tableType?: string(name='TableType'),
}

model AgenticTableColumn {
  columnName?: string(name='ColumnName', description='The name of the column.'),
  columnType?: string(name='ColumnType', description='The data type of the column.'),
  description?: string(name='Description', description='The description of the column.'),
  engineMeta?: AgenticTableColumnEngineMeta(name='EngineMeta', description='Engine-specific metadata for the column.'),
  position?: int32(name='Position', description='The 1-based ordinal position of the column within the table.'),
}

model AgenticTableColumnEngineMeta {
  autoIncrement?: boolean(name='AutoIncrement', description='Indicates whether the column uses auto-increment.'),
  dataLength?: long(name='DataLength', description='The data length of the column. This parameter typically applies to string and binary data types.'),
  dataPrecision?: int32(name='DataPrecision', description='The data precision of the column, which is the total number of digits in a numeric type.'),
  dataScale?: int32(name='DataScale', description='The data scale of the column, which is the number of digits to the right of the decimal point in a numeric type.'),
  defaultValue?: string(name='DefaultValue', description='The default value of the column.'),
  encoding?: string(name='Encoding', description='The character encoding of the column.'),
  extra?: string(name='Extra', description='Engine-specific attributes or flags for the column.'),
  generationColumn?: boolean(name='GenerationColumn', description='Indicates whether the column is a generated column.'),
  generationExpression?: string(name='GenerationExpression', description='The expression used to generate the column\\\\"s value. Applies only if `GenerationColumn` is `true`.'),
  nullable?: boolean(name='Nullable', description='Indicates whether the column is nullable.'),
}

model AgenticTableEngineMeta {
  checksum?: string(name='Checksum', description='A checksum to verify the table\\\\"s data integrity.'),
  createTime?: string(name='CreateTime', description='The time the table was created, in UTC format (`YYYY-MM-DDThh:mm:ssZ`).'),
  dataBytes?: long(name='DataBytes', description='The total size of the table\\\\"s data, in bytes.'),
  encoding?: string(name='Encoding', description='The character encoding of the table.'),
  engine?: string(name='Engine', description='The table\\\\"s storage engine, such as `InnoDB`.'),
  fullChecksum?: string(name='FullChecksum', description='A checksum of the table\\\\"s data and indexes.'),
  indexBytes?: long(name='IndexBytes', description='The total size of the table\\\\"s indexes, in bytes.'),
  lastDdlTime?: string(name='LastDdlTime', description='The timestamp of the last DDL (Data Definition Language) operation, in UTC format (`YYYY-MM-DDThh:mm:ssZ`).'),
  numRows?: long(name='NumRows', description='The number of rows in the table.'),
  refInfo?: string(name='RefInfo', description='The table\\\\"s reference information.'),
  storageCapacity?: long(name='StorageCapacity', description='The table\\\\"s total storage capacity, in bytes.'),
  tableSchemaName?: string(name='TableSchemaName', description='The name of the table schema.'),
}

model AgenticTableIndex {
  columnNames?: [ string ](name='ColumnNames', description='An array of column names included in the index.'),
  description?: string(name='Description', description='An optional, user-defined description for the index.'),
  indexName?: string(name='IndexName', description='The unique name of the index within the table.'),
  indexType?: string(name='IndexType', description='The type of the index, such as PRIMARY, UNIQUE, or NORMAL.'),
  primary?: boolean(name='Primary', description='Specifies if the index is the primary key. A table can have only one primary key.'),
  realColumnNames?: [ string ](name='RealColumnNames', description='An array of physical column names from the database. Use this parameter when the names in ColumnNames are aliases or logical names.'),
  unique?: boolean(name='Unique', description='Specifies if the index enforces a unique constraint, requiring all its values to be unique across rows.'),
}

model DLCatalog {
  description?: string(name='Description', example='init default catalog'),
  location?: string(name='Location', example='oss://xxxx'),
  name?: string(name='Name', example='hive'),
}

model DLColumn {
  comment?: string(name='Comment', description='The comment of the column.', example='from deserializer'),
  name?: string(name='Name', description='The name of the column.', example='col'),
  type?: string(name='Type', description='The data type of the column. Valid values: array, bigint, binary, boolean, char, date, decimal, double, float, int, interval, map, set, smallint, string, struct, timestamp, tinyint, union, and varchar.', example='string'),
}

model DLDatabase {
  catalogName?: string(name='CatalogName', description='The name of the data catalog.', example='hive'),
  dbId?: long(name='DbId', description='The database ID.', example='19'),
  description?: string(name='Description', description='The description of the database.', example='Default database for catalog hive'),
  location?: string(name='Location', description='The storage path of the database.', example='oss://xxx'),
  name?: string(name='Name', description='The name of the database.', example='default'),
  parameters?: map[string]any(name='Parameters', description='The parameters of the database.', example='key/value'),
}

model DLFunction {
  catalogName?: string(name='CatalogName', description='The name of the data catalog.', example='hive'),
  className?: string(name='ClassName', description='The Java class that contains the function code.', example='com.example.hive.MyCustomUDF'),
  createTime?: int32(name='CreateTime', description='The time when the function was created.', example='1731586286'),
  creatorId?: long(name='CreatorId', description='The ID of the user who created the function.', example='12****'),
  dbName?: string(name='DbName', description='The name of the database.', example='default'),
  functionName?: string(name='FunctionName', description='The name of the function.', example='my_funciton'),
  functionType?: string(name='FunctionType', description='The type of the function.', example='JAVA'),
  modifierId?: long(name='ModifierId', description='The ID of the user who modified the function.', example='26****'),
  ownerName?: string(name='OwnerName', description='The owner of the function.', example='zhangsan'),
  ownerType?: string(name='OwnerType', description='The type of the owner. Valid values:

- ROLE

- GROUP

- USER', example='USER'),
  resourceUris?: [
    DLResourceUri
  ](name='ResourceUris', description='The resource URIs of the function. This parameter cannot be modified after the function is created.'),
}

model DLFunctionInput {
  className?: string(name='ClassName', description='The Java class that contains the function code.', example='com.example.hive.MyCustomUDF'),
  createTime?: int32(name='CreateTime', description='The time when the function was created.', example='1731586286'),
  creatorId?: long(name='CreatorId', description='The ID of the user who created the function.', example='12****'),
  functionName?: string(name='FunctionName', description='The function name.', example='my_funciton'),
  functionType?: string(name='FunctionType', description='The function type.', example='JAVA'),
  modifierId?: long(name='ModifierId', description='The ID of the user who modified the function.', example='26****'),
  ownerName?: string(name='OwnerName', description='The owner of the function.', example='zhangsan'),
  ownerType?: string(name='OwnerType', description='The type of the owner. Valid values:

- ROLE

- GROUP

- USER', example='USER'),
  resourceUris?: [
    DLResourceUri
  ](name='ResourceUris', description='The resource URIs of the function. This parameter cannot be modified after the function is created.'),
}

model DLOrder {
  col?: string(name='Col', description='The name of the column.', example='col1'),
  order?: int32(name='Order', description='The position of the column in the sort.', example='1'),
}

model DLPartition {
  catalogName?: string(name='CatalogName', description='The name of the data catalog.', example='hive'),
  createTime?: int32(name='CreateTime', description='The time when the partition was created. The time is a UNIX timestamp in seconds.', example='1735109884'),
  dbName?: string(name='DbName', description='The name of the database.', example='default'),
  lastAccessTime?: int32(name='LastAccessTime', description='The time when the partition was last accessed.', example='1608707407'),
  parameters?: map[string]string(name='Parameters', description='The key-value pairs for the partition.'),
  sd?: DLStorageDescriptor(name='Sd', description='The data storage description.'),
  tableName?: string(name='TableName', description='The table name.', example='table_name'),
  values?: [ string ](name='Values', description='The partition values.'),
}

model DLPartitionInput {
  createTime?: int32(name='CreateTime', description='The time when the partition was created. This is a UNIX timestamp in seconds.', example='1735109884'),
  lastAccessTime?: int32(name='LastAccessTime', description='The time when the partition was last accessed. This is a UNIX timestamp in seconds.', example='1735109884'),
  parameters?: map[string]string(name='Parameters', description='The key-value pair parameters for the partition.'),
  storageDescriptor?: DLStorageDescriptor(name='StorageDescriptor', description='The data storage information of the data lakehouse table.'),
  values?: [ string ](name='Values', description='The partition values.'),
}

model DLResourceUri {
  resourceType?: string(name='ResourceType', description='The type of the resource. Valid values:
- ARCHIVE
- JAR
- FILE', example='JAR'),
  uri?: string(name='Uri', description='The URL used to access the resource.', example='hdfs://name****.example.com:8020/user/hive/udfs/my_***.jar'),
}

model DLSerdeInfo {
  description?: string(name='Description', description='The description of the serialization.', example='"serialize"'),
  deserializerClass?: string(name='DeserializerClass', description='The name of the class used for deserialization.', example='org.apache.hadoop.hive.serde2.OpenCSVSerde'),
  name?: string(name='Name', description='The name of the serialization.', example='name'),
  parameters?: map[string]any(name='Parameters', description='The key-value pairs of parameters related to serialization.', example='{
  "serialization.format": "1"
}'),
  serdeType?: int32(name='SerdeType', description='The type of serialization.', example='0'),
  serializationLib?: string(name='SerializationLib', description='The class name of the serialization library.', example='org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe'),
  serializerClass?: string(name='SerializerClass', description='The name of the class used for serialization.', example='org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe'),
}

model DLSkewedInfo {
  skewedColNames?: [ string ](name='SkewedColNames', description='A list of skewed column names.'),
  skewedColValueLocationMaps?: map[string]any(name='SkewedColValueLocationMaps', description='A mapping of skewed column values to their locations.', example='{“col1”:"val1"}'),
  skewedColValues?: [[ string ]  ](name='SkewedColValues', description='A list of skewed column values. Each list provides a set of associated values.'),
}

model DLStorageDescriptor {
  bucketCols?: [ string ](name='BucketCols', description='A list of bucket column names that determine the hash distribution of the data.'),
  columns?: [
    DLColumn
  ](name='Columns', description='The description of the data columns in the table.'),
  inputFormat?: string(name='InputFormat', description='The name of the input format class used to read data.', example='org.apache.hadoop.mapred.SequenceFileInputFormat'),
  isCompressed?: boolean(name='IsCompressed', description='Specifies whether the data is compressed.', example='false'),
  location?: string(name='Location', description='The specific location of the data storage.', example='oss://xxx'),
  numBuckets?: int32(name='NumBuckets', description='The number of buckets.', example='-1'),
  originalColumns?: [
    DLColumn
  ](name='OriginalColumns', description='The description of the original columns.'),
  outputFormat?: string(name='OutputFormat', description='The name of the output format class used to write data.', example='org.apache.hadoop.hive.ql.io.HiveSequenceFileOutputFormat'),
  parameters?: map[string]any(name='Parameters', description='Other parameter mappings for data storage.', example='key/value'),
  serdeInfo?: DLSerdeInfo(name='SerdeInfo', description='The serialization and deserialization information.'),
  skewedInfo?: DLSkewedInfo(name='SkewedInfo', description='The data structure that stores information about skewed columns.'),
  sortCols?: [
    DLOrder
  ](name='SortCols', description='The description of the sorted columns.'),
}

model DLTable {
  catalogName?: string(name='CatalogName', description='The name of the data catalog.', example='hive'),
  createTime?: int32(name='CreateTime', description='The time when the table was created.', example='1731586286'),
  creatorId?: long(name='CreatorId', description='The ID of the table creator.', example='8****'),
  dbId?: long(name='DbId', description='The ID of the database to which the table belongs.', example='19'),
  dbName?: string(name='DbName', description='The name of the database to which the table belongs.', example='default'),
  description?: string(name='Description', description='The description of the table.', example='test'),
  lastAccessTime?: int32(name='LastAccessTime', description='The time when the table was last accessed.', example='1608707407'),
  location?: string(name='Location', description='The storage path of the table.', example='oss://xxx'),
  modifierId?: long(name='ModifierId', description='The user who last modified the table.', example='1410769'),
  name?: string(name='Name', description='The name of the table.', example='100g_customer'),
  owner?: string(name='Owner', description='The name of the table owner.', example='zhangsan'),
  ownerType?: string(name='OwnerType', description='The type of the owner. Valid values: USER, ROLE, and GROUP.', example='USER'),
  parameters?: map[string]any(name='Parameters', description='The key-value pairs of the parameters.', example='{
      "EXTERNAL": "TRUE",
      "delta.minReaderVersion": "1"}'),
  partitionKeys?: [
    DLColumn
  ](name='PartitionKeys', description='The list of partition keys.'),
  retention?: int32(name='Retention', description='The retention period of the table.', example='300'),
  storageDescriptor?: DLStorageDescriptor(name='StorageDescriptor', description='The storage description, including the storage features and format details of the table.'),
  tableType?: string(name='TableType', description='The type of the metadata table, such as MANAGED_TABLE, EXTERNAL_TABLE, VIRTUAL_VIEW, INDEX_TABLE, or MATERIALIZED_VIEW.', example='EXTERNAL_TABLE'),
  viewExpandedText?: string(name='ViewExpandedText', description='The expanded text of the view if the table is a view.', example='""'),
  viewOriginalText?: string(name='ViewOriginalText', description='The original text of the view if the table is a view.', example='""'),
}

