import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Dms';
  @version = '2025-04-14';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AgentServiceOrderSummaryVO {
  agentService?: string(name='AgentService', description='The name of the agent service.'),
  deepResearchQuota?: long(name='DeepResearchQuota', description='The deep research quota for the service.'),
  modelCallQuota?: long(name='ModelCallQuota', description='The model call quota for the service.'),
  orderCount?: int32(name='OrderCount', description='The order count for the agent service.'),
  serviceNumTotal?: int32(name='ServiceNumTotal', description='The total number of services.'),
  skillPlanCallQuota?: long(name='SkillPlanCallQuota', description='The skill plan call quota for the service.'),
}

model AgentServiceOrderVO {
  agentService?: string(name='AgentService', description='The agent service.'),
  deepResearchQuota?: int32(name='DeepResearchQuota', description='The deep research quota.'),
  deepResearchUsed?: int32(name='DeepResearchUsed', description='The quantity of deep research used.'),
  expireTime?: string(name='ExpireTime', description='The service expiration time, specified in UTC.'),
  gmtCreate?: string(name='GmtCreate', description='The order creation time, specified in UTC.'),
  gmtModified?: string(name='GmtModified', description='The order modification time, specified in UTC.'),
  modelCallQuota?: int32(name='ModelCallQuota', description='The model call quota.'),
  modelCallUsed?: int32(name='ModelCallUsed', description='The number of model calls used.'),
  orderInstanceId?: string(name='OrderInstanceId', description='The order instance ID.'),
  serviceNum?: int32(name='ServiceNum', description='The number of services.'),
  skillPlanCallQuota?: int32(name='SkillPlanCallQuota', description='The skill plan call quota.'),
  skillPlanCallUsed?: int32(name='SkillPlanCallUsed', description='The number of skill plan calls used.'),
  status?: string(name='Status', description='The order status.'),
}

model AgenticCatalog {
  catalogBizAttrs?: map[string]any(name='CatalogBizAttrs'),
  catalogType?: string(name='CatalogType'),
  catalogUuid?: string(name='CatalogUuid'),
  dataSourceUuid?: string(name='DataSourceUuid'),
  dbType?: string(name='DbType'),
  description?: string(name='Description'),
  name?: string(name='Name'),
  properties?: map[string]any(name='Properties'),
  regionId?: string(name='RegionId'),
  state?: int32(name='State'),
  storageLocation?: string(name='StorageLocation'),
}

model AgenticDatabase {
  catalogName?: string(name='CatalogName', description='The name of the catalog.'),
  catalogType?: string(name='CatalogType', description='The type of the catalog.'),
  catalogUuid?: string(name='CatalogUuid', description='The unique identifier of the catalog.'),
  databaseBizAttrs?: map[string]any(name='DatabaseBizAttrs', description='The database\\\\"s business attributes.'),
  databaseUuid?: string(name='DatabaseUuid', description='The unique identifier of the database.'),
  dbType?: string(name='DbType'),
  description?: string(name='Description', description='The database description.'),
  engineMeta?: AgenticDatabaseEngineMeta(name='EngineMeta', description='The metadata for the database engine.'),
  name?: string(name='Name', description='The name of the database.'),
  properties?: map[string]any(name='Properties', description='The database\\\\"s extended properties.'),
  qualifiedName?: string(name='QualifiedName', description='The fully qualified name of the database.'),
  regionId?: string(name='RegionId', description='The region ID of the database.'),
  searchName?: string(name='SearchName', description='The name used to search the database.'),
  state?: int32(name='State', description='The database state.'),
  storageLocation?: string(name='StorageLocation', description='The database storage location.'),
}

model AgenticDatabaseEngineMeta {
  catalogName?: string(name='CatalogName', description='The name of the database catalog.'),
  encoding?: string(name='Encoding', description='The character encoding for the database.'),
  schemaName?: string(name='SchemaName', description='The name of the database schema.'),
  storageCapacity?: long(name='StorageCapacity', description='The storage capacity of the database, in GB.'),
}

model AgenticDatabaseObject {
  databaseQualifiedName?: string(name='DatabaseQualifiedName', description='The fully qualified name of the database. This name uniquely identifies the database within the system.'),
  databaseUuid?: string(name='DatabaseUuid', description='The unique identifier (UUID) of the database that contains the object.'),
  ddlSql?: string(name='DdlSql', description='The Data Definition Language (DDL) SQL statement that defines the object\\\\"s structure.'),
  objectName?: string(name='ObjectName', description='The name of the database object, such as a table, view, or index.'),
  objectQualifiedName?: string(name='ObjectQualifiedName', description='The fully qualified name that uniquely identifies the object, typically formatted as <database>.<schema>.<object>.'),
  objectType?: string(name='ObjectType', description='The type of the database object. For example, `TABLE`, `VIEW`, or `INDEX`.'),
}

