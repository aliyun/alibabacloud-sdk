      knowledgeUuid?: string(name='KnowledgeUuid'),
      type?: string(name='Type'),
    }
  ](name='KnowledgeSemanticConfigList', shrink='json', position='Query'),
  name?: string(name='Name', description='The name of the custom agent.', example='AgentTestName', position='Query'),
  relatedSessionId?: string(name='RelatedSessionId', description='The ID of the referenced historical session.', position='Query'),
  scheduleTaskConfig?: {
