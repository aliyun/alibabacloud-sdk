      vendor?: string(name='Vendor', description='The service provider. Example: aliyun for Model Studio.', example='aliyun'),
      voice?: string(name='Voice', description='The voice. If you select the Alibaba Cloud cosyvoice-v1 model, the default voice is longxiaoxia.
