- zh: Chinese, including Mandarin and dialects such as Shanghainese, Wu, Minnan, Northeastern, Gansu, Guizhou, Henan, Hubei, Hunan, Jiangxi, Ningxia, Shanxi, Shaanxi, Shandong, Sichuan, Tianjin, Yunnan, and Cantonese.
- en: English.
- ja: Japanese.
- yue: Cantonese.
- ko: Korean.'),
      maxSentenceSilence?: int32(name='MaxSentenceSilence', description='The voice segmentation detection threshold. Default value: 800. Unit: milliseconds. Recommended range: 200 to 6000.', example='800'),
