extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'rtc';
  @version = '2018-01-11';
  @endpointRule = 'central';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddRecordTemplateRequest {
  appId: string(name='AppId', description='The application ID. You can create and query the ID in the console. Only a single ID is supported.

This parameter is required.', example='yourAppId', position='Query'),
  backgroundColor?: int32(name='BackgroundColor', description='The background color in RGB format. Default value: 0 (black). The calculation formula is R + G × 256 + B × 65536. Valid values for R (red), G (green), and B (blue): **0** to **255**.', example='0', position='Query'),
  backgrounds?: [ 
    {
      display?: int32(name='Display', description='Specifies whether to display the background image. Valid values:

- **0** (None): Not displayed.
- **1** (Always): Always displayed.', example='0'),
      height?: float(name='Height', description='The height of the background image pane, as a normalized percentage.', example='0.2456'),
      url?: string(name='Url', description='The HTTP or HTTPS URL of the background image.', example='https://www.example.com/image.jpg'),
      width?: float(name='Width', description='The width of the background image pane, as a normalized percentage.', example='0.2456'),
      x?: float(name='X', description='The X-coordinate of the background image, as a normalized percentage.', example='0.7576'),
      y?: float(name='Y', description='The Y-coordinate of the background image, as a normalized percentage.', example='0.7576'),
      zOrder?: int32(name='ZOrder', description='The Z-order of the background image. A value of 0 indicates the bottom layer. A value of 1 indicates the layer above 0, and so on.', example='0'),
    }
  ](name='Backgrounds', description='The list of background images.', position='Query'),
  clockWidgets?: [ 
    {
      fontColor?: int32(name='FontColor', description='The text color of the clock in RGB format.

The calculation formula is `R + G × 256 + B × 65536`. Valid values for R (red), G (green), and B (blue): **0** to **255**.', example='0'),
      fontSize?: int32(name='FontSize', description='The font size of the clock. Valid values: **(0, 72]**.', example='1'),
      fontType?: int32(name='FontType', description='The font type of the clock. Valid values:

- **0** (default): NOTO_SERIF_CJKSC_REGULAR.
- **1**: ALIBABA_PUHUITI_REGULAR.
- **2**: ALIBABA_PUHUITI_BOLD.
- **3**: ALIBABA_PUHUITI_Heavy.
- **4**: ALIBABA_PUHUITI_LIGHT.
- **5**: ALIBABA_PUHUITI_MEDIUM.', example='0'),
      x?: float(name='X', description='The X-coordinate of the clock, as a normalized percentage.', example='0.7576'),
      y?: float(name='Y', description='The Y-coordinate of the clock, as a normalized percentage.', example='0.7576'),
      zOrder?: int32(name='ZOrder', description='The Z-order of the clock. A value of 0 indicates the bottom layer. A value of 1 indicates the layer above 0, and so on.', example='0'),
    }
  ](name='ClockWidgets', description='The list of clocks.', position='Query'),
  delayStopTime?: int32(name='DelayStopTime', description='The delay time before stopping the recording. Unit: seconds. Default value: **180**.', example='180', minimum=5, maximum=86400, position='Query'),
  enableM3u8DateTime?: boolean(name='EnableM3u8DateTime', description='Specifies whether to add the timestamp of the TS file to the recorded M3U8 file.', example='false', position='Query'),
  fileSplitInterval: int32(name='FileSplitInterval', description='The splitting duration of the recording file. The value must be greater than or equal to 1800. Unit: seconds.

This parameter is required.', example='1800', position='Query'),
  formats: [ string ](name='Formats', description='The list of recording file formats.

This parameter is required.', example='mp4', position='Query'),
  httpCallbackUrl?: string(name='HttpCallbackUrl', description='The HTTP callback URL for recording events.
> You must specify either this parameter or MnsQueue. You cannot specify both or neither.', example='http://example.com/callback', position='Query'),
  layoutIds: [ long ](name='LayoutIds', description='The list of layout IDs.

This parameter is required.', example='2', position='Query'),
  mediaEncode: int32(name='MediaEncode', description='The encoding option. For more information, see the MediaEncode enum values below.

This parameter is required.', example='20', position='Query'),
  mnsQueue?: string(name='MnsQueue', description='The MSMQ for recording event callbacks.

> You must specify either this parameter or HttpCallbackUrl. You cannot specify both or neither.', example='record-callback-queue', position='Query'),
  name: string(name='Name', description='The name of the recording configuration template.

This parameter is required.', example='Recording template', position='Query'),
  ossBucket: string(name='OssBucket', description='The OSS bucket where the recording files are stored.

> Only OSS buckets in the China (Shanghai) region are supported.

This parameter is required.', example='rtc-record-oss', position='Query'),
  ossEndpoint?: string(name='OssEndpoint', description='The OSS endpoint of the region where the recording files are stored.', example='oss-cn-shanghai.aliyuncs.com', position='Query'),
  ossFilePrefix: string(name='OssFilePrefix', description='The naming rule for recording files.

> To ensure the uniqueness of recording file names, the naming rule is record/{AppId}/{ChannelId_TaskId}/{EscapedStartTime}_{EscapedEndTime}.

This parameter is required.', example='record/{AppId}/{ChannelId_TaskId}/{EscapedStartTime}_{EscapedEndTime}', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  taskProfile: string(name='TaskProfile', description='The billing configuration of the task. You are charged based on your settings. For more information, see the TaskProfile enum values below.

> - The resolution of the MediaEncode encoding option must be less than or equal to the resolution of TaskProfile.
- The maximum number of layout panes must be less than or equal to the number of input channels of TaskProfile.

This parameter is required.', example='4IN_1080P', position='Query'),
  watermarks?: [ 
    {
      alpha?: float(name='Alpha', description='The transparency of the watermark. A value of 0.0 indicates fully transparent, and a value of 1.0 indicates fully opaque.', example='0'),
      display?: int32(name='Display', description='Specifies whether to display the watermark. Valid values:

- **0** (None): Not displayed.
- **1** (Always): Always displayed.', example='0'),
      height?: float(name='Height', description='The height of the watermark pane, as a normalized percentage.', example='0.2456'),
      url?: string(name='Url', description='The HTTP or HTTPS URL of the watermark.', example='https://www.example.com/image.jpg'),
      width?: float(name='Width', description='The width of the watermark pane, as a normalized percentage.', example='0.2456'),
      x?: float(name='X', description='The X-coordinate of the watermark, as a normalized percentage.', example='0.7576'),
      y?: float(name='Y', description='The Y-coordinate of the watermark, as a normalized percentage.', example='0.7576'),
      zOrder?: int32(name='ZOrder', description='The Z-order of the watermark. A value of 0 indicates the bottom layer. A value of 1 indicates the layer above 0, and so on.', example='0'),
    }
  ](name='Watermarks', description='The list of watermarks.', position='Query'),
}

