      appId?: string(name='AppId', description='The agent application ID. You must specify either Model or AppId. If both are specified, AppId takes precedence.', example='e****'),
      bizParams?: any(name='BizParams', description='The custom parameters.'),
      historyDepth?: int32(name='HistoryDepth', description='The number of historical conversation turns provided to the LLM.
Default value: 3.', example='3'),
      maxToken?: int32(name='MaxToken', description='The maximum number of tokens for the output text.
