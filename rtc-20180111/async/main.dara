/**
  * @description # Usage notes
  * This operation adds a recording configuration template. For example, when you add a recording configuration template, you can configure parameters such as recording specifications and encoding options.
  * # QPS limits
  * The QPS limit for a single user is 100 calls per second. If the limit is exceeded, API calls are throttled, which may affect your business. Make API calls at a reasonable rate. For more information, see [QPS limits](https://help.aliyun.com/document_detail/341645.html).
  * @param request  the request parameters of AddRecordTemplate  AddRecordTemplateRequest
  * @return AddRecordTemplateResponse
 */
async function addRecordTemplate(request: AddRecordTemplateRequest): AddRecordTemplateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddRecordTemplate', 'POST', '/', 'json', false, 'json', request);
}

model CreateAppAgentTemplateRequest {
  agentSilenceConfig?: {
    alertTimeout?: int32(name='AlertTimeout', description='The timeout period for silence alerts, in seconds. This alert can be triggered multiple times. If the agent remains silent after the timeout period elapses, the alert is triggered again upon the next timeout. Valid values: 5 to 600. Default value: 0. A value of 0 indicates that no alert is triggered.', example='30'),
    content?: string(name='Content', description='The content of the silence prompt message.', example='Hello, please try again later?', maxLength=2500),
    strategy?: int32(name='Strategy', description='The handling strategy for silence timeout. Valid values:
- 1: Broadcasts the prompt message specified by Content to the user via voice.
- 2: Sends the prompt message specified by Content and the conversation history to the LLM, and broadcasts the reply generated by the model.
Default value: 1.', example='2', minimum=1, maximum=2),
    webhookTriggerTimeout?: int32(name='WebhookTriggerTimeout', description='The timeout period for triggering the webhook upon agent silence, in seconds. This webhook can be triggered multiple times. If the agent remains silent after the webhook timeout period elapses, the webhook is triggered again upon the next timeout. Valid values: 10 to 600. Default value: 0. A value of 0 indicates that the webhook is not triggered.', example='30'),
  }(name='AgentSilenceConfig', description='The agent silence configuration.', shrink='json', position='Query'),
  ambientSoundConfig?: {
    soundId?: string(name='SoundId', description='The default ambient sounds provided by the agent. Valid values:
- white_noise 
- office', example='white_noise', maxLength=30),
    volume?: int32(name='Volume', description='The volume level.', example='100', minimum=0, maximum=100),
  }(name='AmbientSoundConfig', description='The ambient environment configuration for the agent. If this parameter is not specified, the ambient environment configuration is not used.', shrink='json', position='Query'),
  appId: string(name='AppId', description='The application ID. You can create and query the ID in the console. Only a single ID is supported.

This parameter is required.', example='ac7N****', position='Query'),
  asrConfig?: {
    maxSentenceSilence?: int32(name='MaxSentenceSilence', description='The sentence silence detection threshold. Default value: 500 ms. Valid values: 200 to 6000.', example='300'),
    name: string(name='Name', description='The name.

This parameter is required.', example='STT', minLength=1, maxLength=128),
    vadConfig?: {
      interruptSpeechDuration?: int32(name='InterruptSpeechDuration', description='The minimum duration of continuous voice signals in milliseconds to avoid false interruptions. Default value: 300. Valid values: 0 to 3000.', example='1000', minimum=0, maximum=3000),
    }(name='VadConfig', description='The voice activity detection (VAD) configuration.'),
    wordWeights?: [ 
      {
        lang?: string(name='Lang', description='The language code. This parameter is optional. The large language model automatically identifies the language. Valid values:
- zh: Chinese.
- en: English.', example='zh'),
        weight: int32(name='Weight', description='The hot word weight. Valid values: integers from 1 to 5. Common value: 4. If the effect is not obvious, you can increase the weight. However, a large weight may cause negative effects and lead to inaccurate recognition of other words.

This parameter is required.', example='4'),
        word: string(name='Word', description='The hot word text. Each word can be up to 10 Chinese characters or English words in length.

This parameter is required.', example='Apple'),
      }
    ](name='WordWeights', description='The hot words. Each vocabulary can contain up to 500 hot words, and each hot word can be up to 10 Chinese characters in length. Hot words must be UTF-8 encoded and cannot contain punctuation marks or special characters. Otherwise, the hot words do not take effect.'),
  }(name='AsrConfig', description='The speech-to-text settings.', shrink='json', position='Query'),
  backChannelConfig?: {
    userTurnEnd?: boolean(name='UserTurnEnd', description='Specifies whether to enable backchanneling.'),
  }(name='BackChannelConfig', description='The agent backchannel configuration.', shrink='json', position='Query'),
  chatMode?: int32(name='ChatMode', description='The conversation mode. Valid values:
- 1: Natural conversation mode (default).
- 2: Walkie-talkie mode.', example='2', position='Query'),
  enableVideoUnderstanding?: boolean(name='EnableVideoUnderstanding', description='Specifies whether to enable video understanding. If enabled, the LLM must support multimodal data.', position='Query'),
  greeting?: string(name='Greeting', description='The greeting message. The maximum length is 500 characters.', example='Good morning, my friend!', position='Query'),
  interruptConfig?: {
    semanticsInterrupt?: boolean(name='SemanticsInterrupt', description='The semantic interruption configuration.'),
  }(name='InterruptConfig', description='The agent interruption configuration.', shrink='json', position='Query'),
  interruptMode?: int32(name='InterruptMode', description='The interruption mode. Valid values:
- 1: Interruption allowed (default).
- 2: Interruption disabled.', example='2', position='Query'),
  llmConfig?: {
    agentAppId?: string(name='AgentAppId', description='The ID of the Model Studio agent.', maxLength=500),
    apiKey: string(name='ApiKey', description='The API key required by the large language model service provider.

This parameter is required.', example='ak-1213123123132123131', minLength=1, maxLength=200),
    historyDepth?: int32(name='HistoryDepth', description='The number of historical conversation turns provided to the large language model. Maximum value: 100. Default value: 50.', example='5'),
    maxToken?: int32(name='MaxToken', description='The maximum number of tokens for the output text. Default value: 8192.', example='1024'),
    name: string(name='Name', description='The name.

This parameter is required.', example='llm', minLength=1, maxLength=128),
    prompt?: string(name='Prompt', description='The prompt for the large language model. The maximum length is 5,000 characters.', example='You are a senior psychiatrist'),
    temperature?: float(name='Temperature', description='The sampling temperature. Default value: 0.7. Valid values: [0, 2).', example='0.9'),
    topP?: float(name='TopP', description='The top-P sampling range. Default value: 0.8. Valid values: (0, 1].', example='0.8'),
    url?: string(name='Url', description='The endpoint URL for connecting to a third-party large language model.', example='https://llm.example.aliyuns.com', maxLength=100),
    vendor: string(name='Vendor', description='The provider. Alibaba Cloud Model Studio and third-party configurations that comply with OpenAI API specifications are supported.

This parameter is required.', example='thirdparty'),
  }(name='LlmConfig', description='The large language model settings.', shrink='json', position='Query'),
  name: string(name='Name', description='The template name.

This parameter is required.', example='Agent template', minLength=1, maxLength=128, position='Query'),
  preferVideo?: int32(name='PreferVideo', description='The preferred video stream for the agent to process when visual understanding is enabled. The agent can process only one video stream at a time. When both the camera stream and the screen sharing stream are pushed simultaneously, this parameter specifies the preferred stream. Valid values:
- 1: The agent preferentially processes the camera stream.
- 2: The agent preferentially processes the screen sharing stream.
Default value: 1.', example='1', position='Query'),
  ttsConfig?: {
    apiKey: string(name='ApiKey', description='The API key required by the large language model service provider.

This parameter is required.', example='ak-1213123123132123131', minLength=1, maxLength=200),
    filterBrackets?: [ int32 ](name='FilterBrackets', description='The filter settings. Valid values:
- 1: Chinese parentheses （）
- 2: English parentheses ()
- 3: Chinese square brackets 【】
- 4: English square brackets []
- 5: English curly braces {}'),
    name: string(name='Name', description='The name.

This parameter is required.', example='Tts', minLength=1, maxLength=128),
    pitch?: float(name='Pitch', description='The pitch. Default value: 1.0. Valid values: 0.5 to 2.0.', example='0.8'),
    rate?: float(name='Rate', description='The speech rate. Default value: 1.0. Valid values: 0.5 to 2.0.', example='0.8'),
    vendor?: string(name='Vendor', description='The provider. Alibaba Cloud Model Studio is supported.', example='aliyun'),
    voice?: string(name='Voice', description='The voice. Default value: longxiaoxia. Valid values:
- longwan
- longcheng
- longhua
- longxiaochun
- longxiaoxia
- longxiaocheng
- longxiaobai
- longlaotie
- longshu
- longshuo
- longjing
- longmiao
- longyue
- longyuan
- longfei
- longjielidou
- longtong
- longxiang
- loongstella
- loongbella', example='longcheng'),
    volume?: int32(name='Volume', description='The volume. Default value: 50. Valid values: 0 to 100.', example='70'),
  }(name='TtsConfig', description='The text-to-speech settings.', shrink='json', position='Query'),
  type?: int32(name='Type', description='The agent type. Valid values:
- 1: Voice call (default).', example='1', position='Query'),
}

