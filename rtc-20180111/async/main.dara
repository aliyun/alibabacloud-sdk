model CreateCloudNotePhrasesRequest {
  appId: string(name='AppId', description='The application ID. You can create and query application IDs in the console. Only a single ID is supported.

This parameter is required.', example='ac7N****', position='Query'),
  phrase: {
    description?: string(name='Description', description='The description. The description must be encoded in UTF-8 and be 1 to 200 characters in length.', example='Fruit description', minLength=1, maxLength=200),
    name: string(name='Name', description='The name of the hotword table. The name must be encoded in UTF-8 and be 1 to 30 characters in length.

This parameter is required.', example='Fruits', minLength=1, maxLength=30),
    wordWeights: [ 
      {
        weight: int32(name='Weight', description='The weight must be an integer in the range of [-6, 5].
- A value greater than 0 increases the probability of the word being recognized, and a value less than 0 decreases the probability.
- A value of -6 indicates that the word should not be recognized if possible.
- A value of 2 is a common value.
If the effect is not obvious, you can increase the weight. However, a large weight may cause negative effects and lead to inaccurate recognition of other words.

This parameter is required.', example='0'),
        word: string(name='Word', description='The hotword.

This parameter is required.', example='Apple'),
      }
    ](name='WordWeights', description='Each hotword table can contain up to 300 hotwords, and each hotword can be up to 10 Chinese characters in length.

Hotwords must be encoded in UTF-8 and cannot contain punctuation marks or special characters. Otherwise, the hotwords do not take effect.

The weight of a hotword must be an integer in the range of [-6, 5].

Numbers in the text must be replaced with the corresponding Chinese characters based on their pronunciation. For example, "59.9元" must be replaced with "五十九点九元".

This parameter is required.'),
  }(name='Phrase', description='The hotword parameter.

This parameter is required.', shrink='json', position='Query'),
}

