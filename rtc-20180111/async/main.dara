          x?: float(name='X', description='The X-coordinate, as a normalized percentage.', example='0.7576'),
          y?: float(name='Y', description='The Y-coordinate, as a normalized percentage.', example='0.7576'),
          zOrder?: int32(name='ZOrder', description='The Z-order. 0 indicates the bottom layer, 1 indicates the layer above 0, and so on.', example='0'),
        }
