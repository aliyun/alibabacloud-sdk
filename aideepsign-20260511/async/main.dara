  code?: string(name='Code', description='The business error code. "OK" is returned if the request is successful.', example='OK'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code. 200 is returned if the request is successful.', example='200'),
  message?: string(name='Message', description='The additional information. "success" is returned if the request is successful.', example='success'),
  objectKey?: string(name='ObjectKey', description='The ObjectKey of the signed image in OSS. You can use this value for subsequent API calls.', example='deepsign/123456789/signed/abc12345-def6-7890-abcd-ef1234567890.png'),
  requestId?: string(name='RequestId', description='The request ID.', example='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'),
