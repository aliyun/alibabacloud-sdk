model CancelC2paBucketSignTaskRequest {
  taskId: string(name='TaskId', description='The parent task ID of the bucket returned by CreateC2paBucketSignTask.

This parameter is required.', example='047b8305-9572-4eed-b7fb-8588b989b6e5', position='Query'),
}

model CancelC2paBucketSignTaskResponseBody = {
  code?: string(name='Code', description='The return code.', example='OK'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The response message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='01A03DCE-4091-1A91-9810-692C3D783877'),
  status?: string(name='Status', description='The stop processing status. CANCELING indicates that the stop process is being finalized. Repeated requests may return the completed CANCELED status.', example='CANCELING'),
  success?: boolean(name='Success', description='Indicates whether the request was successful.', example='true'),
  taskId?: string(name='TaskId', description='The ID of the bucket batch signing task.', example='047b8305-9572-4eed-b7fb-8588b989b6e5'),
}

model CancelC2paBucketSignTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CancelC2paBucketSignTaskResponseBody(name='body'),
}

/**
  * @description ## Operation description
  * - This operation stops a batch trusted signing task for a bucket owned by the currently authenticated account. TaskId is the parent task ID of the bucket returned by CreateC2paBucketSignTask.
  * - When the returned Status is `CANCELING`, the task is completing the stop process. Repeated requests may return the completed `CANCELED` status.
  * - Call GetC2paSignResult to query the task status and final result.
  * @param request  the request parameters of CancelC2paBucketSignTask  CancelC2paBucketSignTaskRequest
  * @return CancelC2paBucketSignTaskResponse
 */
async function cancelC2paBucketSignTask(request: CancelC2paBucketSignTaskRequest): CancelC2paBucketSignTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CancelC2paBucketSignTask', 'POST', '/', 'json', false, 'json', request);
}

model CreateC2paBucketSignTaskRequest {
  bucketName: string(name='BucketName', description='The name of the OSS bucket. The value must be 3 to 63 characters in length. Before you call this operation, you must authorize the `AliyunServiceRoleForAIDeepSign` service-linked role to read the source files, and access and write the signing results and reports.

This parameter is required.', example='example-bucket', position='Query'),
  bucketRegionId: string(name='BucketRegionId', description='The region of the OSS bucket. The value can be up to 64 characters in length and must match the actual region of the bucket. Example: `cn-hangzhou`.

This parameter is required.', example='cn-hangzhou', position='Query'),
  customAssertions?: string(name='CustomAssertions', description='The optional list of custom assertions. Pass a JSON array string. The original JSON text can be up to 4,096 UTF-8 bytes in length and contain up to 64 assertions. Each item must and can only contain `label` and `data`. `data` supports any JSON value. Objects and arrays can be nested up to 5 levels deep, and JSON integers must be within the signed 64-bit range. The assertions are written into the manifest of the signature file and can be read and authenticated for integrity by `label`. Each file in the same batch uses the same set of assertions. The content saved during creation is retained after the task is paused and resumed. For detailed formats, limits, and examples, see the supplementary description of request parameters.', example='[{"label":"com.shein.internal","data":{"meta_id":"emp001","generation":{"modelVersion":"2.1","count":3},"tags":["AI-generated","E-commerce"],"enabled":true,"optional":null}}]', maxLength=4096, position='Query'),
  softwareAgent?: string(name='SoftwareAgent', description='The optional name of the software that generated or processed the content. The value can be up to 128 characters in length. Example: `Example Studio 1.0`. This software information is written into the content credential of the signature file. Each file in the same batch uses the value saved when the task is created. The original value is retained after the task is paused and resumed.', example='Adobe Photoshop 25.0', position='Query'),
  sourcePrefix: string(name='SourcePrefix', description='The prefix of the objects to be processed. The value can be up to 1,023 UTF-8 bytes in length and must be `ai-deepsign/` or its subdirectory. If the trailing `/` is missing, the service automatically appends it, and the completed prefix must also meet the length limit. The service recursively processes non-directory objects under this prefix and supports `.jpg`, `.jpeg`, `.png`, `.mp4`, `.flac`, `.m4a`, `.mp3`, and `.wav` extensions, which are case-insensitive. Scanning the root directory of the bucket is not allowed, and the prefix cannot overlap with the output prefix `ai-deepsign-signed/`.

This parameter is required.', example='ai-deepsign/images/', position='Query'),
  sourceType?: string(name='SourceType', description='The optional content source type. The value can be up to 128 characters in length. It supports 19 short names and their corresponding full HTTP URIs, which are case-sensitive. Examples: `digitalCapture` and `trainedAlgorithmicMedia`. The source declaration is written into the content credential of the signature file. Each file in the same batch uses the value saved when the task is created. If this parameter is left empty, no additional declaration is made. The service will deny invalid values during the creation phase. For the complete enumeration and URIs, see the supplementary description of request parameters.', example='digitalCapture', maxLength=128, position='Query'),
}

model CreateC2paBucketSignTaskResponseBody = {
  code?: string(name='Code', description='The return code.', example='OK'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The returned message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='01A03DCE-4091-1A91-9810-692C3D783877'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='true'),
  taskId?: string(name='TaskId', description='The ID of the batch signing task for the bucket. You can use this ID to query, pause, resume, or stop the task.', example='047b8305-9572-4eed-b7fb-8588b989b6e5'),
}

model CreateC2paBucketSignTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateC2paBucketSignTaskResponseBody(name='body'),
}

/**
  * @description Creates a batch standard C2PA content credential signing task for an OSS bucket. The service recursively scans non-directory objects under `SourcePrefix` and supports JPEG/JPG, PNG, MP4, and audio formats including FLAC, M4A, MP3, and WAV. By default, a single task includes up to 20,000 non-directory objects, and the size of a single file cannot exceed 800 MiB.
  * Before you call this operation, make sure that the `AliyunServiceRoleForAIDeepSign` service-linked role has been granted the OSS List and Get permissions on the source prefix, and the Get and Put permissions on the output prefix. `SourceType`, `SoftwareAgent`, and `CustomAssertions` are optional parameters. The values specified during creation are applied to each file in the batch.
  * A successful creation only indicates that the task has been accepted. Save the returned `TaskId` and call `GetC2paSignResult` to query the status and statistics. You can use `PauseC2paBucketSignTask`, `ResumeC2paBucketSignTask`, and `CancelC2paBucketSignTask` to control the task.
  * The signature files are written to `ai-deepsign-signed/<TaskId>/<folder of the object relative to SourcePrefix>/<original file name>_signed.<extension>` in the same bucket, preserving the relative subdirectory and source file extensions. The final JSON report is saved as `ai-deepsign-signed/<TaskId>/c2pa_report.json`.
  * This operation is metered based on the number of successfully signed files. The same account can create multiple tasks for the same bucket and prefix, and each task uses an independent output directory. Duplicate creations may result in duplicate signing and metering.
  * @param request  the request parameters of CreateC2paBucketSignTask  CreateC2paBucketSignTaskRequest
  * @return CreateC2paBucketSignTaskResponse
 */
async function createC2paBucketSignTask(request: CreateC2paBucketSignTaskRequest): CreateC2paBucketSignTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateC2paBucketSignTask', 'POST', '/', 'json', false, 'json', request);
}

model CreateC2paSignTaskRequest {
  allowOverwrite?: boolean(name='AllowOverwrite', description='Specifies whether to allow overwriting when the target object already exists. Default value: false. If the target object exists and this parameter is set to false, the creation is rejected. If this parameter is set to true, existing objects can be overwritten, which supports in-place signing where the target object key can be the same as the source object key.', example='false', position='Query'),
  bucketName?: string(name='BucketName', description='The name of the user\\\\"s OSS bucket where the source file is located. This parameter, together with BucketRegionId and ObjectKey, forms the bucket source. Either this parameter or FileUrl is required.', example='example-bucket', position='Query'),
  bucketRegionId?: string(name='BucketRegionId', description='The region ID of the user\\\\"s OSS bucket where the source file is located. This parameter, together with BucketName and ObjectKey, forms the bucket source. Either this parameter or FileUrl is required. Example: cn-hangzhou.', example='cn-hangzhou', position='Query'),
  customAssertions?: string(name='CustomAssertions', description='The optional list of custom assertions. Pass a JSON array string. The original JSON text can be up to 4,096 UTF-8 bytes in length and contain up to 64 assertions. Each item must and can only contain label and data. data supports any JSON value. Objects and arrays can be nested up to 5 levels deep. JSON integers must be within the signed 64-bit range. The assertions are written into the manifest of the signed file and can be read and authenticated for integrity by label. For detailed formats, limits, and examples, refer to the supplementary description of request parameters.', example='[{"label":"com.shein.internal","data":{"meta_id":"emp001","generation":{"modelVersion":"2.1","count":3},"tags":["AI-generated","E-commerce"],"enabled":true,"optional":null}}]', maxLength=4096, position='Query'),
  fileUrl?: string(name='FileUrl', description='The absolute HTTP or HTTPS URL of signature file to be signed. The URL can be up to 4,096 characters in length and cannot contain URL user info. The URL path must end with a .jpg, .jpeg, .png, .mp4, .flac, .m4a, .mp3, or .wav file name. Signature file extension is case-insensitive. The URL query is not used for file name identification. The source URL must be accessible by the service and directly return an HTTP 200 status code. Redirection is not supported. The size of a single file cannot exceed 800 MiB.', example='https://example.com/images/photo.png?token=xxx', position='Query'),
  objectKey?: string(name='ObjectKey', description='The object key of the source file in the user\\\\"s OSS bucket. This parameter, together with BucketRegionId and BucketName, forms the bucket source. Either this parameter or FileUrl is required.', example='ai-deepsign/example.png', position='Query'),
  softwareAgent?: string(name='SoftwareAgent', description='The optional name of the software that generated or processed the content. The value can be up to 128 characters in length, such as Example Studio 1.0. This software information is written into the content credentials of the signed file and is independent of SourceType and CustomAssertions.', example='Alibaba Cloud Qwen ImageGen', position='Query'),
  sourceType?: string(name='SourceType', description='The optional content source type. The value can be up to 128 characters in length. It supports 19 short names and their corresponding full HTTP URIs, and is case-sensitive. Examples include digitalCapture and trainedAlgorithmicMedia. The source declaration is written into the content credentials of the signed file. If this parameter is not specified, no additional source type is declared. The service denies invalid values during the creation phase. For the complete enumeration and URIs, refer to the supplementary description of request parameters.', example='trainedAlgorithmicMedia', maxLength=128, position='Query'),
  targetBucketName?: string(name='TargetBucketName', description='The optional name of the user\\\\"s OSS bucket to which the signing result is written. If this parameter is empty, the result is written to an internal bucket of the service and returned through SignedFileUrl.', example='example-target-bucket', position='Query'),
  targetBucketRegion?: string(name='TargetBucketRegion', description='The optional region ID of the user\\\\"s OSS bucket to which the signing result is written. If this parameter is empty, the source BucketRegionId is reused for same-region writes. For cross-region writes, this parameter must be explicitly specified.', example='cn-shanghai', position='Query'),
  targetObjectKey?: string(name='TargetObjectKey', description='The optional full object key of the signed artifact written to the user\\\\"s bucket. This parameter must be provided together with TargetBucketName. It must start with ai-deepsign-signed/ and be a full object name with an extension, not a directory prefix. The server does not append the _signed suffix or a trailing slash.', example='ai-deepsign-signed/2026/photo.png', position='Query'),
}

model CreateC2paSignTaskResponseBody = {
  code?: string(name='Code', description='The business error code. If the request is successful, OK is returned.', example='OK'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code. If the request is successful, 200 is returned.', example='200'),
  message?: string(name='Message', description='The additional information. If the request is successful, success is returned.', example='success'),
  requestId?: string(name='RequestId', description='The request ID of this OpenAPI call.', example='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='True'),
  taskId?: string(name='TaskId', description='The opaque task ID generated by the service, which is used to call GetC2paSignResult.', example='7093c29e-f472-4e1e-91c6-a43df7c7382e'),
}

model CreateC2paSignTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateC2paSignTaskResponseBody(name='body'),
}

/**
  * @description Adds standard C2PA content credentials to a single JPEG/JPG, PNG, MP4, FLAC, M4A, MP3, or WAV file. The operation receives an accessible absolute HTTP or HTTPS file URL, asynchronously retrieves and signs the file, and returns a TaskId for querying the result. The size of a single file cannot exceed 800 MiB.
  * You can declare the content source, software name, and custom business data by using the optional SourceType, SoftwareAgent, and CustomAssertions parameters. This information is written into the content credentials of the signed file.
  * A successful creation only indicates that the request has been accepted. Save the returned TaskId and call GetC2paSignResult to query the final status and signing result.
  * This operation is independent of the synchronous SignUserImage operation. It only supports creating tasks through file URLs and does not accept file content, buckets, object keys, caller-specified TaskIds, or idempotency keys. This operation is metered based on the number of successfully signed files. Repeated calls create different tasks. Do not create tasks repeatedly before confirming the task result to avoid duplicate signing and metering.
  * @param request  the request parameters of CreateC2paSignTask  CreateC2paSignTaskRequest
  * @return CreateC2paSignTaskResponse
 */
async function createC2paSignTask(request: CreateC2paSignTaskRequest): CreateC2paSignTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateC2paSignTask', 'POST', '/', 'json', false, 'json', request);
}

