  signedImageUrl?: string(name='SignedImageUrl', description='The pre-signed download URL of the signed image.', example='https://bucket.oss-cn-hangzhou.aliyuncs.com/deepsign/123456789/signed/abc12345.png?Expires=1718700000&OSSAccessKeyId=...'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.'),
}

model SignUserImageResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SignUserImageResponseBody(name='body'),
}

/**
  * @description ## Signature types
  * - **Basic signature**: Signs with a platform-owned certificate and supports content integrity verification.
  * - **Trusted signature**: In addition to integrity verification, the signing certificate chain can be verified through the C2PA official trust list.
  * This operation provides basic signing. For trusted signing, call `CreateC2paSignTask` to create a task and call `GetC2paSignResult` to query the result.
  * ## Request description
  * - `ImageUrl` is required and must be a publicly accessible HTTP/HTTPS URL.
  * - External image URLs are not currently supported. Only image URLs that are publicly accessible within the Chinese mainland are supported. Upload the image to an Alibaba Cloud OSS bucket in a region within the Chinese mainland first, and then use the pre-signed URL of the image as the input parameter of this operation. References: [How to obtain the URL of a single file or the URLs of multiple files](https://www.alibabacloud.com/help/en/oss/user-guide/how-to-obtain-the-url-of-a-single-object-or-the-urls-of-multiple-objects).
  * - Supported image formats: JPEG and PNG. Unsupported formats return the C2PA_FORMAT_UNSUPPORTED fault.
  * @param request  the request parameters of SignUserImage  SignUserImageRequest
  * @return SignUserImageResponse
 */
async function signUserImage(request: SignUserImageRequest): SignUserImageResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'SignUserImage', 'POST', '/', 'json', false, 'json', request);
}

model VerifyImageSignatureRequest {
  imageUrl?: string(name='ImageUrl', description='The URL of the image to verify. Specify either `ImageUrl` or `ObjectKey`. At least one of them is required.', example='https://example.com/signed-photo.jpg', position='Query'),
}

model VerifyImageSignatureResponseBody = {
  code?: string(name='Code', description='The business error code. The value "OK" is returned if the request is successful.', example='OK'),
  httpStatusCode?: long(name='HttpStatusCode', description='The HTTP status code. The value `200` is returned if the request is successful.', example='200'),
  issuer?: {
    commonName?: string(name='CommonName', description='The common name (CN) of the issuer.', example='AIDeepSign User Certificate'),
    organization?: string(name='Organization', description='The organization name (O) of the issuer.', example='Alibaba Cloud'),
  }(name='Issuer', description='The issuer information.'),
  issuerTrusted?: boolean(name='IssuerTrusted', description='Indicates whether the issuer is trusted. A value of true indicates that the issuer certificate is issued by a trusted certification authority (CA).'),
  manifest?: {
    assertions?: [ 
      {
        data?: string(name='Data', description='The assertion data, which is detailed metadata in JSON format.', example='{"actions":[{"action":"c2pa.created"}]}'),
        label?: string(name='Label', description='The assertion label, such as c2pa.actions or stds.exif.', example='c2pa.actions'),
      }
    ](name='Assertions', description='The list of assertions, which contains metadata such as the provenance and editing history of the image.'),
    signatureInfo?: {
      alg?: string(name='Alg', description='The signature algorithm, such as `ps256` or `es256`.', example='ps256'),
      issuer?: string(name='Issuer', description='The distinguished name (DN) of the signing certificate issuer.', example='CN=AIDeepSign CA,O=Alibaba Cloud'),
      time?: string(name='Time', description='The signing time in ISO 8601 format.', example='2026-06-18T10:30:00Z'),
    }(name='SignatureInfo', description='The signature details.'),
  }(name='Manifest', description='The content credentials manifest information. This parameter is returned only when the image contains a C2PA signature.'),
  message?: string(name='Message', description='The additional information. The value `success` is returned if the request is successful.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.'),
  verificationState?: string(name='VerificationState', description='The signature verification status. Valid values:
- Unsigned: The image does not contain C2PA data.
- Invalid: The signature, data hash, or C2PA structure is invalid.
- Valid: The signature and data hash are valid, but the issuer is not necessarily trusted.
- Trusted: The signature is valid and the issuer certificate is trusted.', example='Valid'),
}

model VerifyImageSignatureResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: VerifyImageSignatureResponseBody(name='body'),
}

/**
  * @description ## Signature types
  * - **Basic signature**: Uses the platform\\"s own certificate for signing. Supports content integrity verification.
  * - **Trusted signature**: In addition to integrity verification, the signing certificate chain can be verified through the C2PA official trust list.
  * ## Verification result description
  * - Content integrity verification checks whether the image and its signature-protected provenance information remain consistent with the state at the time of signing. It does not indicate that the visual content itself is authentic.
  * - `VerificationState=Valid` indicates that the signature and data hash are valid and content integrity verification has passed. This alone cannot be used to determine that the signature is a trusted signature.
  * - `VerificationState=Trusted` and `IssuerTrusted` present the certificate trust verification results. Whether a signature qualifies as a trusted signature as defined in this topic depends on whether the signing certificate chain can be verified through the C2PA official trust list, not solely on the certificate issuer name.
  * ## Request description
  * - This operation verifies the C2PA (Coalition for Content Provenance and Authenticity) digital signature embedded in a specified image.
  * - `ImageUrl` **does not currently support images from external networks. Only image URLs accessible over the China public network are supported. Upload the image to an Alibaba Cloud OSS bucket in a China region first, and then use the presigned URL of the image as the input parameter for this operation.** References: [How do I obtain the URL of one or more objects?](https://www.alibabacloud.com/help/en/oss/user-guide/how-to-obtain-the-url-of-a-single-object-or-the-urls-of-multiple-objects)
  * @param request  the request parameters of VerifyImageSignature  VerifyImageSignatureRequest
  * @return VerifyImageSignatureResponse
 */
async function verifyImageSignature(request: VerifyImageSignatureRequest): VerifyImageSignatureResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'VerifyImageSignature', 'POST', '/', 'json', false, 'json', request);
}

