  promptExtend?: boolean(name='PromptExtend', description='Specifies whether to enable intelligent rewriting for the prompt. Default value: true.', position='Query'),
  seed?: int32(name='Seed', description='The random seed. Valid values: 0 to 2147483647. A value of 0 indicates a random seed.', example='42', position='Query'),
  size?: string(name='Size', description='The size of the image in the format of width*height. Default value: `2048*2048`.', example='1024*1024', position='Query'),
}

