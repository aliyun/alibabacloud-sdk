import Util;
import GatewayClient;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @productId = 'AlikafkaStreaming';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('alikafkastreaming', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CheckSqlContentRequest {
  instanceId?: string(name='InstanceId', description='The compute instance ID.

This parameter is required.', example='alikafka_streaming-cn-a1b2c3d4'),
  jobName?: string(name='JobName', description='The compute job name.

This parameter is required.', example='order_enrichment'),
  regionId?: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou'),
  sqlContent?: string(name='SqlContent', description='The Flink SQL statement to be validated.

This parameter is required.', example='INSERT INTO sink_table SELECT * FROM source_table;'),
}

