model CheckSqlContentRequest {
  instanceId: string(name='InstanceId', description='The compute instance ID.

This parameter is required.', example='alikafka_streaming-cn-a1b2c3d4', position='Query'),
  jobName: string(name='JobName', description='The compute job name.

This parameter is required.', example='order_enrichment', position='Query'),
  regionId: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-hangzhou', position='Query'),
  sqlContent: string(name='SqlContent', description='The Flink SQL statement to be validated.

This parameter is required.', example='INSERT INTO sink_table SELECT * FROM source_table;', position='Query'),
}

model CheckSqlContentResponseBody = {
  code?: long(name='Code', description='The return code.', example='200'),
  data?: {
    errorList?: [ 
      {
        codeSnippet?: string(name='CodeSnippet', description='The SQL snippet where the error occurred.', example='SELECT FROM source_table'),
        columnNumber?: int32(name='ColumnNumber', description='The starting column number of the error.', example='8'),
        endColumnNumber?: int32(name='EndColumnNumber', description='The ending column number of the error.', example='12'),
        endLineNumber?: int32(name='EndLineNumber', description='The ending line number of the error.', example='1'),
        errorType?: string(name='ErrorType', description='The error type.', example='SYNTAX_ERROR'),
        lineNumber?: int32(name='LineNumber', description='The starting line number of the error.', example='1'),
        message?: string(name='Message', description='The error message.', example='SQL parse failed near FROM'),
      }
    ](name='ErrorList', description='The list of SQL validation errors.'),
    valid?: boolean(name='Valid', description='Indicates whether the SQL statement passed the validation.', example='false'),
  }(name='Data', description='The returned data.'),
  requestId?: string(name='RequestId', description='The request ID.', example='062D8E8B-8D47-5DCC-BB12-5A1D93C3A66B'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='true'),
}

model CheckSqlContentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CheckSqlContentResponseBody(name='body'),
}

/**
  * @description ## Operation description
  * - You can invoke this operation by using the GET or POST method.
  * - You must specify the `InstanceId`, `JobName`, and `SqlContent` parameters. The `SqlContent` parameter specifies the Flink SQL statement to be validated.
  * - In the response, the `Data.Valid` field indicates whether the SQL statement passed the validation. If the validation fails, the fault details are returned in the `Data.ErrorList` field.
  * - The current version requires both the instance ID (`InstanceId`) and the job name (`JobName`) to build the job context.
  * - A successful response only indicates that the system starts to execute the validation flow. It does not directly indicate whether the SQL statement is valid. Check the `Data.Valid` field to determine whether the SQL statement is valid.
  * - For error codes and exception handling, refer to the Error codes section in the References.
  * @param request  the request parameters of CheckSqlContent  CheckSqlContentRequest
  * @return CheckSqlContentResponse
 */
async function checkSqlContent(request: CheckSqlContentRequest): CheckSqlContentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CheckSqlContent', 'POST', '/', 'json', false, 'json', request);
}

