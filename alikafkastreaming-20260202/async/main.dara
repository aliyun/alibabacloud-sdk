  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateComputeJobResponseBody(name='body'),
}

/**
  * @description ## 请求说明
  * - 该API用于在指定的运行中的计算实例上创建一个新的Flink SQL作业。
  * - 创建后的作业将处于`INIT`状态。
  * - 用户可以通过设置`CuLimit`和`CuReserved`来控制作业的资源使用情况。
  * - `Remark`字段允许用户为作业添加备注信息，便于管理和识别。
  * - 确保提供的`RegionId`、`InstanceId`以及`JobName`参数准确无误，否则可能导致请求失败。
  * - 如果尝试创建同名作业，则会返回错误提示。
  * - 计算实例必须处于运行状态才能成功创建作业。
  * @param request  the request parameters of CreateComputeJob  CreateComputeJobRequest
  * @return CreateComputeJobResponse
 */
async function createComputeJob(request: CreateComputeJobRequest): CreateComputeJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateComputeJob', 'POST', '/', 'json', false, 'json', request);
}

