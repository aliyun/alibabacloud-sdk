- false: The allocation failed.', example='true'),
    toUnitId?: long(name='ToUnitId', description='The ID of the destination financial unit.', example='32857346527'),
    toUnitUserId?: long(name='ToUnitUserId', description='The ID of the owner of the destination financial unit.', example='34857693874'),
  }(name='Data', description='The returned data.'),
  message?: string(name='Message', description='The error message.', example='Successful！'),
  requestId?: string(name='RequestId', description='The request ID.', example='845C629F-47A7-4F46-A470-ED5047C4C250'),
