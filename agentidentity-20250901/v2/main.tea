model AttachPolicySetToGatewayRequest {
  enforcementMode?: string(name='EnforcementMode', description='The policy enforcement mode. Valid values: ENFORCE (blocks non-compliant requests and allows compliant requests) and LOG_ONLY (records non-compliant requests but does not block them).', example='ENFORCE'),
  gatewayArn?: string(name='GatewayArn', description='The ARN of the target gateway.', example='acs:agentidentity:cn-beijing:123456:gateway/my-gateway'),
  gatewayType?: string(name='GatewayType', description='The gateway type. Valid values:

- AIGateway: Alibaba Cloud AI gateway.
- AgentRunMCP: AgentRun MCP tool.

Default value: AIGateway.', example='AIGateway'),
  policySetName?: string(name='PolicySetName', description='The name of the policy set. The name must be unique within the current Alibaba Cloud account.', example='default-policy-set'),
}

model AttachPolicySetToGatewayResponseBody = {
  requestId?: string(name='RequestId', description='The unique identifier of the request.', example='2A48EB1D-D645-5758-91AF-EDF8E36E257B'),
}

model AttachPolicySetToGatewayResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachPolicySetToGatewayResponseBody(name='body'),
}

/**
 * @summary Attaches a policy set to a gateway.
 *
 * @description Attaches a policy set to a target gateway.
 * The attachment relationship is 1:1. A gateway can have only one policy set attached at a time. If you attach a policy set multiple times, the latest attachment takes effect. You can specify the policy enforcement mode by using the EnforcementMode parameter. Valid values: ENFORCE (blocks non-compliant requests) and LOG_ONLY (records non-compliant requests but allows them, which is commonly used for canary release observation).
 *
 * @param request AttachPolicySetToGatewayRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AttachPolicySetToGatewayResponse
 */
@context("attachPolicySetToGatewayWithContext")
async function attachPolicySetToGatewayWithOptions(request: AttachPolicySetToGatewayRequest, runtime: $RuntimeOptions): AttachPolicySetToGatewayResponse {
  request.validate();
  var body : map[string]any = {};
  if (!$isNull(request.enforcementMode)) {
    body['EnforcementMode'] = request.enforcementMode;
  }
  if (!$isNull(request.gatewayArn)) {
    body['GatewayArn'] = request.gatewayArn;
  }
  if (!$isNull(request.gatewayType)) {
    body['GatewayType'] = request.gatewayType;
  }
  if (!$isNull(request.policySetName)) {
    body['PolicySetName'] = request.policySetName;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'AttachPolicySetToGateway',
    version = '2025-09-01',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Attaches a policy set to a gateway.
 *
 * @description Attaches a policy set to a target gateway.
 * The attachment relationship is 1:1. A gateway can have only one policy set attached at a time. If you attach a policy set multiple times, the latest attachment takes effect. You can specify the policy enforcement mode by using the EnforcementMode parameter. Valid values: ENFORCE (blocks non-compliant requests) and LOG_ONLY (records non-compliant requests but allows them, which is commonly used for canary release observation).
 *
 * @param request AttachPolicySetToGatewayRequest
 * @return AttachPolicySetToGatewayResponse
 */
async function attachPolicySetToGateway(request: AttachPolicySetToGatewayRequest): AttachPolicySetToGatewayResponse {
  var runtime = new $RuntimeOptions{};
  return attachPolicySetToGatewayWithOptions(request, runtime);
}

