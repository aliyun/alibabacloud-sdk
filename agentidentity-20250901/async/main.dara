    callbackURL?: string(name='CallbackURL', description='The unique callback URL assigned to the provider. You must configure this URL in the list of allowed callback URLs of the identity provider.', example='https://agentidentitydata.cn-beijing.aliyuncs.com/oauth2/callback/d51171bc-0dae-3219-8e65-6b4cdafa3beb'),
    createTime?: string(name='CreateTime', description='The creation time.', example='2025-12-18T06:19:17Z'),
    credentialProviderArn?: string(name='CredentialProviderArn', description='The ARN of the newly created credential provider.', example='acs:agentidentity:cn-beijing:123456:tokenvault/default/oauth2credentialprovider/oauth-provider-aliyun'),
    credentialProviderVendor?: string(name='CredentialProviderVendor', description='The vendor of the provider.', example='AliyunOAuth2'),
    description?: string(name='Description', description='The description of the OAuth 2.0 credential provider.', example='example provider'),
    oAuth2CredentialProviderName?: string(name='OAuth2CredentialProviderName', description='The name of the credential provider.', example='oauth-provider-aliyun'),
    oAuth2ProviderConfig?: OAuth2ProviderConfig(name='OAuth2ProviderConfig', description='The object that contains provider-specific configurations, such as clientId and clientSecret.'),
    oAuthType?: string(name='OAuthType'),
