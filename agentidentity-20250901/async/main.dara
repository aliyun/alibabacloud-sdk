  generateRandomPassword?: boolean(name='GenerateRandomPassword', description='Specifies whether to generate a random password. If this parameter is set to true, the system automatically generates a random password that complies with the password policy. This parameter is mutually exclusive with Password.', example='false', position='Body'),
  password?: string(name='Password', description='The password of the user. The password must comply with the password policy of the user pool and is mutually exclusive with GenerateRandomPassword.', example='P@ssw0rd!2026', position='Body'),
