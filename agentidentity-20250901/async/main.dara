/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'AgentIdentity';
  @version = '2025-09-01';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AuthorizationRequest {
  endpoint?: string(name='Endpoint'),
}

model AuthorizationServerMetadata {
  authorizationRequest?: AuthorizationRequest(name='AuthorizationRequest'),
  issuer?: string(name='Issuer'),
  PKCE?: PKCE(name='PKCE'),
  tokenRequest?: TokenReqeust(name='TokenRequest'),
}

model CustomOAuth2ProviderConfig {
  clientId?: string(name='ClientId'),
  clientSecret?: string(name='ClientSecret'),
  oAuth2Discovery?: OAuth2Discovery(name='OAuth2Discovery'),
}

model Definition {
  cedar?: {
    statement?: string(name='Statement'),
  }(name='Cedar'),
}

model EncryptionConfig {
  keyType?: string(name='KeyType'),
  kmsKeyArn?: string(name='KmsKeyArn'),
}

model IncludedOAuth2ProviderConfig {
  authorizationEndpoint?: string(name='AuthorizationEndpoint'),
  clientId?: string(name='ClientId'),
  clientSecret?: string(name='ClientSecret'),
  tokenEndpoint?: string(name='TokenEndpoint'),
}

model OAuth2Discovery {
  authorizationServerMetadata?: AuthorizationServerMetadata(name='AuthorizationServerMetadata'),
  discoveryURL?: string(name='DiscoveryURL'),
}

model OAuth2ProviderConfig {
  customOAuth2ProviderConfig?: CustomOAuth2ProviderConfig(name='CustomOAuth2ProviderConfig'),
  includedOAuth2ProviderConfig?: IncludedOAuth2ProviderConfig(name='IncludedOAuth2ProviderConfig'),
}

model PKCE {
  enabled?: boolean(name='Enabled'),
}

model TokenReqeust {
  endpoint?: string(name='Endpoint'),
}

model AddSAMLIdentityProviderCertificateRequest {
  userPoolName?: string(name='UserPoolName', example='my-agent-userpool', position='Body'),
  x509Certificate?: string(name='X509Certificate', example='-----BEGIN CERTIFICATE-----
MIIDdz...
-----END CERTIFICATE-----', position='Body'),
}

model AddSAMLIdentityProviderCertificateResponseBody = {
  requestId?: string(name='RequestId', example='AABD6E03-4B3A-5687-88FF-72232670ED0C'),
}

model AddSAMLIdentityProviderCertificateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddSAMLIdentityProviderCertificateResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddSAMLIdentityProviderCertificate  AddSAMLIdentityProviderCertificateRequest
  * @return AddSAMLIdentityProviderCertificateResponse
 */
async function addSAMLIdentityProviderCertificate(request: AddSAMLIdentityProviderCertificateRequest): AddSAMLIdentityProviderCertificateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddSAMLIdentityProviderCertificate', 'POST', '/', 'json', true, 'form', request);
}

model AttachPolicySetToGatewayRequest {
  enforcementMode?: string(name='EnforcementMode', description='The policy enforcement mode. Valid values: ENFORCE (blocks non-compliant requests and allows compliant requests) and LOG_ONLY (records non-compliant requests but does not block them).', example='ENFORCE', position='Body'),
  gatewayArn?: string(name='GatewayArn', description='The ARN of the target gateway.', example='acs:agentidentity:cn-beijing:123456:gateway/my-gateway', position='Body'),
  gatewayType?: string(name='GatewayType', description='The gateway type. Valid values:

- AIGateway: Alibaba Cloud AI gateway.
- AgentRunMCP: AgentRun MCP tool.

Default value: AIGateway.', example='AIGateway', position='Body'),
  policySetName?: string(name='PolicySetName', description='The name of the policy set. The name must be unique within the current Alibaba Cloud account.', example='default-policy-set', position='Body'),
}

model AttachPolicySetToGatewayResponseBody = {
  requestId?: string(name='RequestId', description='The unique identifier of the request.', example='2A48EB1D-D645-5758-91AF-EDF8E36E257B'),
}

model AttachPolicySetToGatewayResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AttachPolicySetToGatewayResponseBody(name='body'),
}

/**
  * @description Attaches a policy set to a target gateway.
  * The attachment relationship is 1:1. A gateway can have only one policy set attached at a time. If you attach a policy set multiple times, the latest attachment takes effect. You can specify the policy enforcement mode by using the EnforcementMode parameter. Valid values: ENFORCE (blocks non-compliant requests) and LOG_ONLY (records non-compliant requests but allows them, which is commonly used for canary release observation).
  * @param request  the request parameters of AttachPolicySetToGateway  AttachPolicySetToGatewayRequest
  * @return AttachPolicySetToGatewayResponse
 */
async function attachPolicySetToGateway(request: AttachPolicySetToGatewayRequest): AttachPolicySetToGatewayResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AttachPolicySetToGateway', 'POST', '/', 'json', true, 'form', request);
}

