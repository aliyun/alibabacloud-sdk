  * @description Calls CreatePolicySet to create a policy set in the current account. A policy set is a container for a group of policies. After a policy set is mounted to a gateway, all policies in the set evaluate requests to the gateway as a whole.
  * @param request  the request parameters of CreatePolicySet  CreatePolicySetRequest
  * @return CreatePolicySetResponse
 */
async function createPolicySet(request: CreatePolicySetRequest): CreatePolicySetResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreatePolicySet', 'POST', '/', 'json', true, 'form', request);
}

model CreateRoleRequest {
  description?: string(name='Description', description='The description of the role. The description must be 0 to 128 characters in length.', example='Data analyst role', position='Body'),
  roleName?: string(name='RoleName', description='The name of the role. The name must be unique within the user pool and must be 3 to 64 characters in length.', example='Analyst', position='Body'),
  userPoolName?: string(name='UserPoolName', description='The name of the user pool.', example='my-agent-userpool', position='Body'),
}

model CreateRoleResponseBody = {
  requestId?: string(name='RequestId', description='The ID of the request.', example='AABD6E03-4B3A-5687-88FF-72232670ED0C'),
  role?: {
    createTime?: string(name='CreateTime', description='The time when the role was created. The time is displayed in ISO 8601 format (UTC).', example='2026-05-07T06:19:17Z'),
    description?: string(name='Description', description='The description of the role.', example='Data analyst role'),
    roleId?: string(name='RoleId', description='The ID of the role.', example='role_xxxxxxxxxxxxxxxxxxxx'),
    roleName?: string(name='RoleName', description='The name of the role.', example='Analyst'),
    type?: string(name='Type', description='The type of the role. Valid values:
- Default: the default role that is automatically provisioned when the user pool is created
- Manual: a custom role that is manually created by calling an API operation', example='Manual'),
    updateTime?: string(name='UpdateTime', description='The time when the role was updated. The time is displayed in ISO 8601 format (UTC).', example='2026-05-07T06:19:17Z'),
  }(name='Role', description='The role information.'),
}

model CreateRoleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateRoleResponseBody(name='body'),
}

/**
  * @description Users in a user pool can be allocated roles to enable quick authorization. Administrators can specify permissions for roles in an access policy.
  * When a user pool is created, the platform automatically provisions a default role, and newly created users are automatically allocated this default role. This operation creates a custom role of the Manual type, which must be explicitly allocated to users by calling CreateRoleAssignment.
  * @param request  the request parameters of CreateRole  CreateRoleRequest
  * @return CreateRoleResponse
 */
async function createRole(request: CreateRoleRequest): CreateRoleResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateRole', 'POST', '/', 'json', true, 'form', request);
}

model CreateRoleAssignmentRequest {
  principalName?: string(name='PrincipalName', description='The name of the principal. When PrincipalType is set to User, specify the username.', example='alice', position='Body'),
  principalType?: string(name='PrincipalType', description='The type of the principal. Valid values:
- User: User. Only this value is currently supported.', example='User', position='Body'),
  roleName?: string(name='RoleName', description='The name of the role to assign.', example='Analyst', position='Body'),
  userPoolName?: string(name='UserPoolName', description='The name of the user pool.', example='my-agent-userpool', position='Body'),
}

model CreateRoleAssignmentResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='AABD6E03-4B3A-5687-88FF-72232670ED0C'),
  roleAssignment?: {
    createTime?: string(name='CreateTime', description='The time when the role assignment was created, in ISO 8601 format (UTC).', example='2026-05-07T06:19:17Z'),
    principalId?: string(name='PrincipalId', description='The ID of the principal. When PrincipalType is User, this is the user ID.', example='user_xxxxxxxxxxxxxxxxxxxx'),
    principalName?: string(name='PrincipalName', description='The name of the principal. When PrincipalType is User, this is the username.', example='alice'),
    principalType?: string(name='PrincipalType', description='The type of the principal. Only User is currently supported.', example='User'),
    roleId?: string(name='RoleId', description='The ID of the role.', example='role_xxxxxxxxxxxxxxxxxxxx'),
    roleName?: string(name='RoleName', description='The name of the role.', example='Analyst'),
    userPoolId?: string(name='UserPoolId', description='The ID of the user pool.', example='up_xxxxxxxxxxxxxxxxxxxx'),
  }(name='RoleAssignment', description='The role assignment.'),
}

model CreateRoleAssignmentResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateRoleAssignmentResponseBody(name='body'),
}

/**
  * @description Users must be assigned roles to complete authorization. When a user is created through JIT, a default role is automatically assigned. Administrators can use this operation to assign additional custom roles to users.
  * PrincipalType currently supports only User. A single identity can have multiple role assignments.
  * @param request  the request parameters of CreateRoleAssignment  CreateRoleAssignmentRequest
  * @return CreateRoleAssignmentResponse
 */
async function createRoleAssignment(request: CreateRoleAssignmentRequest): CreateRoleAssignmentResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateRoleAssignment', 'POST', '/', 'json', true, 'form', request);
}

model CreateTokenVaultRequest {
  description?: string(name='Description', description='The description of the token vault.', example='example description', position='Body'),
  encryptionConfig?: EncryptionConfig(name='EncryptionConfig', description='The encryption configuration of the token vault. The value is a JSON string.', shrink='json', position='Body'),
  roleArn?: string(name='RoleArn', description='The Alibaba Cloud Resource Name (ARN) of the Resource Access Management (RAM) role used to authorize the AgentIdentity service to access other cloud resources such as KMS.', example='acs:ram::123456:role/AliyunAgentIdentityVaultRole', position='Body'),
  tokenVaultName?: string(name='TokenVaultName', description='The name of the token vault. The name must be unique within the current Alibaba Cloud account.', example='default', position='Body'),
}

model CreateTokenVaultResponseBody = {
  requestId?: string(name='RequestId', description='The unique identifier of the request.', example='2A48EB1D-D645-5758-91AF-EDF8E36E257B'),
  tokenVault?: {
    createTime?: string(name='CreateTime', description='The time when the token vault was created, in UTC ISO 8601 format.', example='2026-05-08T06:19:17Z'),
    description?: string(name='Description', description='The description of the token vault.', example='example description'),
    encryptionConfig?: {
      keyType?: string(name='KeyType', description='The type of the encryption key. Valid values:
- SERVICE_MANAGED_KEY: service-managed key
- CUSTOMER_MANAGED_KEY: customer-managed KMS key', example='SERVICE_MANAGED_KEY'),
      kmsKeyArn?: string(name='KmsKeyArn', description='The ARN of the KMS key used when KeyType is set to CUSTOMER_MANAGED_KEY.', example='acs:kms:cn-beijing:123456:key/key-bjxxxxxxxx'),
    }(name='EncryptionConfig', description='The encryption configuration of the token vault.'),
    roleArn?: string(name='RoleArn', description='The Alibaba Cloud Resource Name (ARN) of the Resource Access Management (RAM) role used to authorize the AgentIdentity service to access other cloud resources such as KMS.', example='acs:ram::123456:role/AliyunAgentIdentityVaultRole'),
    tokenVaultArn?: string(name='TokenVaultArn', description='The ARN of the token vault.', example='acs:agentidentity:cn-beijing:123456:tokenvault/default'),
    tokenVaultName?: string(name='TokenVaultName', description='The name of the token vault. The name must be unique within the current Alibaba Cloud account.', example='default'),
  }(name='TokenVault', description='The details of the token vault.'),
}

model CreateTokenVaultResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateTokenVaultResponseBody(name='body'),
}

/**
  * @description Calls the CreateTokenVault operation to create a token vault within the current Alibaba Cloud account. A token vault is a container used by the AgentIdentity service to securely store sensitive credentials such as OAuth2 tokens and API keys. Each token is encrypted when it is written to the vault.
  * You can specify the encryption configuration when you create the vault. By default, a service-managed key (SERVICE_MANAGED_KEY) is used. For greater control over the key, you can use a customer-managed Key Management Service (KMS) key (CUSTOMER_MANAGED_KEY). To use a customer-managed key, specify the Alibaba Cloud Resource Name (ARN) of the KMS key and use the RoleArn parameter to authorize the AgentIdentity service to access the KMS key.
  * @param request  the request parameters of CreateTokenVault  CreateTokenVaultRequest
  * @return CreateTokenVaultResponse
 */
async function createTokenVault(request: CreateTokenVaultRequest): CreateTokenVaultResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateTokenVault', 'POST', '/', 'json', true, 'form', request);
}

model CreateUserRequest {
  description?: string(name='Description', description='The description of the user. It must be 0 to 256 characters in length.', example='Data Analyst', position='Body'),
  displayName?: string(name='DisplayName', description='The display name of the user. It must be 0 to 128 characters in length.', example='Alice', position='Body'),
  email?: string(name='Email', description='The email address of the user.', example='alice@example.com', position='Body'),
  status?: string(name='Status', description='The status of the user. Valid values:
- Enabled: Enabled.
- Disabled: Disabled.', example='Enabled', position='Body'),
  userName?: string(name='UserName', description='The username. It can contain letters, digits, underscores (_), periods (.), and hyphens (-), and must be 3 to 128 characters in length.', example='alice', position='Body'),
  userPoolName?: string(name='UserPoolName', description='The name of the user pool.', example='my-agent-userpool', position='Body'),
}

model CreateUserResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='AABD6E03-4B3A-5687-88FF-72232670ED0C'),
  user?: {
    description?: string(name='Description', description='The description of the user.', example='Data Analyst'),
    displayName?: string(name='DisplayName', description='The display name of the user.', example='Alice'),
    email?: string(name='Email', description='The email address of the user.', example='alice@example.com'),
    status?: string(name='Status', description='The status of the user. Valid values:
- Enabled: Enabled.
- Disabled: Disabled.', example='Enabled'),
    type?: string(name='Type', description='The type of the user. Valid values:
- Manual: The user is manually created by calling an API operation.
- JIT: The user is created through JIT.
- SCIM: The user is synchronized through the System for Cross-domain Identity Management protocol.
- SYNC_DINGTALK: The user is synchronized from DingTalk.', example='Manual'),
    userId?: string(name='UserId', description='The user ID.', example='user_xxxxxxxxxxxxxxxxxxxx'),
    userName?: string(name='UserName', description='The username.', example='alice'),
  }(name='User', description='The user information.'),
}

model CreateUserResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateUserResponseBody(name='body'),
}

/**
  * @description Creates a user in a specified user pool. The type of the created user is Manual, and the default status is Enabled. The username must be unique within the user pool and can contain letters, digits, underscores (_), periods (.), and hyphens (-), and must be 3 to 128 characters in length. The email address must be unique within the user pool. After the user is created, you can call the SetUserPassword operation to set a logon password for the user and call the CreateRoleAssignment operation to assign a role to the user.
  * @param request  the request parameters of CreateUser  CreateUserRequest
  * @return CreateUserResponse
 */
async function createUser(request: CreateUserRequest): CreateUserResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateUser', 'POST', '/', 'json', true, 'form', request);
}

