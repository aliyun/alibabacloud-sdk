model CreateOAuth2CredentialProviderRequest {
  callbackURL?: string(name='CallbackURL', description='The unique callback URL assigned to the provider. You must configure this URL in the list of allowed callback URLs of the identity provider.
Format: https://agentidentitydata.{{region}}.aliyuncs.com/oauth2/callback/{{UUID}}
If you specify this parameter, the specified value is used.
If you do not specify this parameter, the server automatically generates a value.', example='https://agentidentitydata.cn-beijing.aliyuncs.com/oauth2/callback/d51171bc-0dae-3219-8e65-6b4cdafa3beb', position='Body'),
  credentialProviderVendor?: string(name='CredentialProviderVendor', description='The vendor of the provider, such as AliyunOAuth2, AlibabaCloudOAuth2, DingTalkOAuth2, FeiShuOAuth2, or CustomOAuth2.', example='AliyunOAuth2', position='Body'),
  description?: string(name='Description', description='The description of the OAuth 2.0 credential provider.', example='example provider', position='Body'),
  oAuth2CredentialProviderName?: string(name='OAuth2CredentialProviderName', description='The name of the credential provider.', example='oauth-provider-aliyun', position='Body'),
  oAuth2ProviderConfig?: OAuth2ProviderConfig(name='OAuth2ProviderConfig', description='The object that contains provider-specific configurations, such as clientId and clientSecret.', shrink='json', position='Body'),
  oAuthType?: string(name='OAuthType', position='Body'),
  tokenVaultName?: string(name='TokenVaultName', description='The name of the token vault.', position='Body'),
}

