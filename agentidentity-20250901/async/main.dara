}

model CreateAPIKeyCredentialProviderResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateAPIKeyCredentialProviderResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateAPIKeyCredentialProvider  CreateAPIKeyCredentialProviderRequest
  * @return CreateAPIKeyCredentialProviderResponse
 */
async function createAPIKeyCredentialProvider(request: CreateAPIKeyCredentialProviderRequest): CreateAPIKeyCredentialProviderResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateAPIKeyCredentialProvider', 'POST', '/', 'json', true, 'form', request);
