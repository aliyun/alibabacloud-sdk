  return @handler.do('RPC', 'RunUserPoolSyncJob', 'POST', '/', 'json', true, 'form', request);
}

model SetSAMLIdentityProviderRequest {
  entityId?: string(name='EntityId', description='The IdP identifier. This is the EntityID from the SAML metadata of the external IdP.', example='https://idp.example.com/entity', position='Body'),
  JITProvisionStatus?: string(name='JITProvisionStatus', description='The enabling status of Just-In-Time (JIT) user synchronization and creation. Valid values:
- Enabled: Enabled. If a user with the same name does not exist in the user pool during SAML logon, automatic creation is performed.
- Disabled: Shutdown. If the user is not found, the logon is failed. Default value.', example='Enabled', position='Body'),
  JITUpdateStatus?: string(name='JITUpdateStatus', description='The enabling status of updating user information through synchronization. Valid values:
- Enabled: The update is enabled. If a user with the same name exists during SAML logon, the user information is updated based on the attributes (DisplayName and Description) passed by the IdP.
- Disabled: The update is disabled. Only the logon state is updated, and user attributes are not updated. Default value.', example='Enabled', position='Body'),
  loginURL?: string(name='LoginURL', description='The IdP logon URL. When a user logs on, the browser is redirected to this URL to complete SAML authentication.', example='https://idp.example.com/sso/saml', position='Body'),
  SAMLBindingType?: string(name='SAMLBindingType', description='The SAML protocol binding type. Valid values:
- HTTP-Redirect: AuthnRequest is sent by using HTTP redirect. Default value.
- HTTP-POST: AuthnRequest is sent by using HTTP POST.', example='HTTP-Redirect', position='Body'),
  SSOStatus?: string(name='SSOStatus', description='The enabling status of single sign-on (SSO). Valid values:
- Enabled: SAML SSO is enabled, and users can log on through an external IdP.
- Disabled: SAML SSO is disabled, and users cannot log on through the IdP. Default value.', example='Enabled', position='Body'),
  userPoolName?: string(name='UserPoolName', description='The name of the user pool.', example='my-agent-userpool', position='Body'),
  x509Certificates?: [ string ](name='X509Certificates', description='The list of X.509 certificates in PEM format. If you specify this parameter, all existing certificates are replaced.', shrink='json', position='Body'),
}

model SetSAMLIdentityProviderResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='AABD6E03-4B3A-5687-88FF-72232670ED0C'),
  SSOIdentityProviderConfiguration?: {
    entityId?: string(name='EntityId', description='The IdP identifier.', example='https://idp.example.com/entity'),
    JITProvisionStatus?: string(name='JITProvisionStatus', description='The enabling status of Just-In-Time (JIT) user provisioning. A value of Enabled indicates that JIT user provisioning is enabled, and a value of Disabled indicates that it is disabled.', example='Enabled'),
    JITUpdateStatus?: string(name='JITUpdateStatus', description='The enabling status of updating user information through synchronization. A value of Enabled indicates that the update is enabled, and a value of Disabled indicates that it is disabled.', example='Enabled'),
    loginURL?: string(name='LoginURL', description='The IdP logon URL.', example='https://idp.example.com/sso/saml'),
    SAMLBindingType?: string(name='SAMLBindingType', description='The SAML protocol binding type. Valid values: HTTP-Redirect and HTTP-POST.', example='HTTP-Redirect'),
    SSOStatus?: string(name='SSOStatus', description='The enabling status of single sign-on (SSO). A value of Enabled indicates that SSO is enabled, and a value of Disabled indicates that SSO is disabled.', example='Enabled'),
    x509Certificates?: [ 
      {
        certificateId?: string(name='CertificateId', description='The certificate ID.', example='cert-xxxxxxxxxxxxxxxxxxxx'),
        x509Certificate?: string(name='X509Certificate', description='The content of the X.509 certificate in PEM format.', example='-----BEGIN CERTIFICATE-----
MIIDdz...
-----END CERTIFICATE-----'),
      }
    ](name='X509Certificates', description='The list of X.509 certificates.'),
  }(name='SSOIdentityProviderConfiguration', description='The detailed configurations of the identity provider.'),
}

model SetSAMLIdentityProviderResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SetSAMLIdentityProviderResponseBody(name='body'),
}

/**
  * @description This operation sets or updates the core configurations of a SAML identity provider (IdP), including the IdP identifier (EntityId), logon URL (LoginURL), X.509 certificates, single sign-on (SSO) status, and Just-In-Time (JIT) user provisioning and update settings. If you specify X509Certificates, all existing certificates in the user pool are replaced. To append certificates while retaining the existing ones, use AddSAMLIdentityProviderCertificate.
