model CreateClientSecretRequest {
  clientId?: string(name='ClientId', description='The ID of the client. If you specify ClientId, you do not need to specify UserPoolName. Specify either ClientName or ClientId. If both are specified, ClientId takes precedence.', example='client_xxxxxxxxxxxxxxxxxxxx', position='Body'),
  clientName?: string(name='ClientName', description='The name of the client. Specify either ClientName or ClientId.', example='my-web-app', position='Body'),
  userPoolName?: string(name='UserPoolName', description='The name of the user pool.', example='my-agent-userpool', position='Body'),
}

model CreateClientSecretResponseBody = {
  clientSecret?: {
    clientId?: string(name='ClientId', description='The ID of the client.', example='client_xxxxxxxxxxxxxxxxxxxx'),
    clientName?: string(name='ClientName', description='The name of the client.', example='my-web-app'),
    clientSecretId?: string(name='ClientSecretId', description='The client key ID.', example='secret_xxxxxxxxxxxxxxxxxxxx'),
    clientSecretValue?: string(name='ClientSecretValue', description='The plaintext client secret. This value is returned only once upon creation and cannot be retrieved later. Store it securely.', example='xxxxxxxxxxxxxxxx'),
    createTime?: string(name='CreateTime', description='The time when the client secret was created, in ISO 8601 format (UTC).', example='2026-05-07T06:19:17Z'),
    userPoolName?: string(name='UserPoolName', description='The name of the user pool.', example='my-agent-userpool'),
  }(name='ClientSecret', description='The client secret information.'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='AABD6E03-4B3A-5687-88FF-72232670ED0C'),
}

model CreateClientSecretResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateClientSecretResponseBody(name='body'),
}

/**
  * @description The response includes the plaintext client secret (ClientSecretValue). For security reasons, the plaintext secret is returned only once upon creation and cannot be retrieved later. Store it securely.
  * @param request  the request parameters of CreateClientSecret  CreateClientSecretRequest
  * @return CreateClientSecretResponse
 */
async function createClientSecret(request: CreateClientSecretRequest): CreateClientSecretResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateClientSecret', 'POST', '/', 'json', true, 'form', request);
}

