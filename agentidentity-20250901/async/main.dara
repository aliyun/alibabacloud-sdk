model CreatePolicyRequest {
  definition?: Definition(name='Definition', description='The policy definition.', shrink='json', position='Body'),
  description?: string(name='Description', description='The description.', example='example description', position='Body'),
  policyName?: string(name='PolicyName', description='The name of the policy. The name must be unique within the policy set to which the policy belongs.', example='rate-limit-policy', position='Body'),
  policySetName?: string(name='PolicySetName', description='The name of the policy set. The name must be unique within the current Alibaba Cloud account.', example='default-policy-set', position='Body'),
}

model CreatePolicyResponseBody = {
  policy?: {
    createTime?: string(name='CreateTime', description='The time when the policy was created, in UTC ISO 8601 format.', example='2026-05-08T06:19:17Z'),
    definition?: Definition(name='Definition', description='The policy definition.'),
    description?: string(name='Description', description='The description.', example='example description'),
    policyArn?: string(name='PolicyArn', description='The ARN of the policy.', example='acs:agentidentity:cn-beijing:123456:policyset/default-policy-set/policy/rate-limit-policy'),
    policyName?: string(name='PolicyName', description='The name of the policy. The name must be unique within the policy set to which the policy belongs.', example='rate-limit-policy'),
    policySetName?: string(name='PolicySetName', description='The name of the policy set. The name must be unique within the current Alibaba Cloud account.', example='default-policy-set'),
  }(name='Policy', description='The policy details.'),
  requestId?: string(name='RequestId', description='The unique identifier of the request.', example='2A48EB1D-D645-5758-91AF-EDF8E36E257B'),
}

model CreatePolicyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreatePolicyResponseBody(name='body'),
}

/**
  * @description Calls the CreatePolicy operation to add a policy to an existing policy set. The policy defines specific control rules, such as throttling thresholds, admission conditions, and allow or block actions, through the Definition field. After a policy set is mounted to a gateway, requests on the gateway are evaluated and controlled based on the merged results of all policies in the policy set.
  * @param request  the request parameters of CreatePolicy  CreatePolicyRequest
  * @return CreatePolicyResponse
 */
async function createPolicy(request: CreatePolicyRequest): CreatePolicyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreatePolicy', 'POST', '/', 'json', true, 'form', request);
}

model CreatePolicySetRequest {
  description?: string(name='Description', description='The description.', example='example description', position='Body'),
  policySetName?: string(name='PolicySetName', description='The name of the policy set. The name must be unique within the current Alibaba Cloud account.', example='default-policy-set', position='Body'),
  sourcePlatform?: string(name='SourcePlatform', description='The source platform.', example='Manuel', position='Body'),
}

model CreatePolicySetResponseBody = {
  policySet?: {
    createTime?: string(name='CreateTime', description='The creation time in UTC ISO 8601 format.', example='2026-05-08T06:19:17Z'),
    description?: string(name='Description', description='The description.', example='example description'),
    policySetArn?: string(name='PolicySetArn', description='The ARN of the policy set.', example='acs:agentidentity:cn-beijing:123456:policyset/default-policy-set'),
    policySetName?: string(name='PolicySetName', description='The name of the policy set. The name must be unique within the current Alibaba Cloud account.', example='default-policy-set'),
    sourcePlatform?: string(name='SourcePlatform', description='The source platform.', example='Manuel'),
  }(name='PolicySet', description='The policy set details.'),
  requestId?: string(name='RequestId', description='The unique identifier of the request.', example='2A48EB1D-D645-5758-91AF-EDF8E36E257B'),
