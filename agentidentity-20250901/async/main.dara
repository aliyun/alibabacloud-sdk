  APIKey?: string(name='APIKey', description='The API key value to be securely stored.', example='example api key', position='Body'),
  APIKeyCredentialProviderName?: string(name='APIKeyCredentialProviderName', description='The name of the credential provider.', example='api-key-dash-scope', position='Body'),
