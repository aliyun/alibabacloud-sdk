    credentialProviderArn?: string(name='CredentialProviderArn', description='The ARN of the newly created credential provider.', example='acs:agentidentity:cn-beijing:123456:tokenvault/default/apikeycredentialprovider/api-key-dash-scope'),
    description?: string(name='Description', description='The description of the credential provider.', example='example provider'),
