  * @return SetSAMLIdentityProviderResponse
 */
async function setSAMLIdentityProvider(request: SetSAMLIdentityProviderRequest): SetSAMLIdentityProviderResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'SetSAMLIdentityProvider', 'POST', '/', 'json', true, 'form', request);
}

