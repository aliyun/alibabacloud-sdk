/**
  * @description A user pool is a secure and isolated user folder designed by the Agent Identity platform for the AI agent ecosystem. You can create multiple user pools under a single Alibaba Cloud account for the independent user identity management of different AI agents. When you create a user pool, you only need to specify the name (UserPoolName). The description is optional. After the user pool is created, the platform automatically generates a default role for the user pool. Users subsequently created through SAML SSO just-in-time (JIT) synchronization are automatically allocated this default role.
  * @param request  the request parameters of CreateUserPool  CreateUserPoolRequest
  * @return CreateUserPoolResponse
 */
async function createUserPool(request: CreateUserPoolRequest): CreateUserPoolResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateUserPool', 'POST', '/', 'json', true, 'form', request);
}

model CreateUserPoolClientRequest {
  accessTokenValidity?: string(name='AccessTokenValidity', description='The validity period of the access token, in seconds. Valid values: 900 to 10800. Default value: 3600.', example='3600', position='Body'),
  clientName?: string(name='ClientName', description='The name of the client. The name must be unique within the same user pool and must be 1 to 64 characters in length.', example='my-web-app', position='Body'),
  enforcePKCE?: boolean(name='EnforcePKCE', description='Specifies whether to enforce Proof Key for Code Exchange (PKCE). Valid values:
