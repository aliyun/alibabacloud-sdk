model CreateTargetScanTaskRequest {
  lang?: string(name='Lang', description='The language filter for samples, in locale format (such as zh_CN or en_US, which is internally normalized to zh or en). If this parameter is not specified, samples are selected based on the default language policy combined with general-purpose samples.', example='zh_CN'),
  sampleLevel?: long(name='SampleLevel', description='The detection intensity. The backend derives the corresponding technique level based on this value. If this parameter is not specified, the system falls back to the scan task configuration saved for the target, and then to the system default value.', example='3'),
  targetId?: string(name='TargetId', description='The unique identifier of the scan target. The target must have passed connectivity verification (verifyStatus=verified). Otherwise, a 400 error is returned. You can call TestConnectivity to complete the verification first.

This parameter is required.', example='target-abc123def4567'),
}

model CreateTargetScanTaskResponseBody = {
  data?: {
    taskId?: string(name='TaskId', description='The unique identifier of the scan task. The initial task status is PREPARING (asynchronous preparation in progress). You can call ListScanTasksByTarget to query the task status and progress.', example='task-abc123def4567'),
  }(name='Data', description='The creation result, which contains the TaskId of the new scan task.'),
  requestId?: string(name='RequestId', description='The unique identifier of the request, which is used for troubleshooting and log tracing.', example='1EBD0C05-6C1F-4C95-9C63-XXXXX'),
}

