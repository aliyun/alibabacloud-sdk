model UpdateTaskAttributeRequest {
  taskId: string(name='taskId', description='The node ID.

This parameter is required.', example='task-4267dcfbf1b6dfff67fea425525e2', position='Path'),
  autoApply?: boolean(name='autoApply', description='Specifies whether to automatically execute the node. Default value: false.
- true: After the preview is complete (terraform plan), the execution (terraform apply) is automatically performed without manual confirmation.
- false: After the preview is complete (terraform plan), manual confirmation is required before the execution (terraform apply) starts.', example='true', position='Body'),
  autoDestroy?: boolean(name='autoDestroy', description='Specifies whether to automatically destroy resources after creation. Default value: false.
- true: After the execution is complete (terraform apply), the destroy operation (terraform destroy) is automatically performed without manual confirmation.
- false: After the execution is complete (terraform apply), no further action is taken.', example='true', position='Body'),
  clientToken: string(name='clientToken', description='The idempotency token. Format: [0-9a-zA-Z-]{1,64}. Use a UUID.

This parameter is required.', example='a65451293e64979ba7a4b573950217fe', position='Body'),
  description?: string(name='description', description='The description.', example='this is description', position='Body'),
  groupInfo?: {
    groupId?: string(name='groupId', description='The group ID.', example='g-433aead7560571e66e31274ffd3'),
    projectId?: string(name='projectId', description='The project ID.', example='p-433aead75605713865c386cb9d'),
  }(name='groupInfo', description='The project group information.', position='Body'),
  initModuleState?: boolean(name='initModuleState', description='Specifies whether to use a state file. Default value: false. This parameter applies to templates that originate from resource export. Only one node can use this parameter.', example='false', position='Body'),
  moduleVersion?: string(name='moduleVersion', description='The template version.', example='v1', position='Body'),
  name?: string(name='name', description='The node name. The name must meet the following requirements:

- The name must be 2 to 128 characters in length.
- The name can contain letters, digits, Chinese characters, hyphens (-), underscores (_), and periods (.). The name cannot start or end with a hyphen, underscore, or period.
- The name must be unique among all node resources within the current account.', example='TaskName', position='Body'),
  protectionStrategy?: [ string ](name='protectionStrategy', description='The list of resource protection strategies.', position='Body'),
  ramRole?: string(name='ramRole', description='The RAM role. The system assumes this role to execute the template when a new job is triggered. This parameter is required when the job trigger method is not manual.', example='role', position='Body'),
  skipPropertyValidation?: boolean(name='skipPropertyValidation', description='Specifies whether to skip enumeration value validation. Default value: false.', example='false', position='Body'),
  skipRegionValidation?: boolean(name='skipRegionValidation', description='Specifies whether to skip region validation. Valid values: true indicates skipping, false indicates not skipping.', position='Body'),
  tags?: [ 
    {
      tagKey?: string(name='tagKey', description='The tag key of the node.', example='TestKey'),
      tagValue?: string(name='tagValue', description='The tag value of the node.', example='TestValue'),
    }
  ](name='tags', description='The list of tags for the node.', position='Body'),
  terraformProviderVersion?: string(name='terraformProviderVersion', description='The Terraform Provider version. Use the **ListTerraformProviderVersions** API to query the list of supported versions.', example='1.248.0', position='Body'),
  terraformVersion?: string(name='terraformVersion', description='The Terraform version. Use the **ListAvailableTerraformVersions** API to obtain the list of supported versions. Default value: 1.5.7.', example='1.5.7', position='Body'),
  triggerStrategy?: string(name='triggerStrategy', description='The job trigger method.

- Manual: manual trigger (default).
- NewVersion: triggered when a new template version is published.
- ParameterSetUpdated: triggered when the parameter set content changes or the parameter set attach relationship changes.
- Auto: automatically triggered when the node properties change, such as creating a node, changing the execution version, or changing the job trigger policy (when changed from another method to Auto).

The **ramRole** parameter is required for non-manual triggers.', example='Manual', position='Body'),
}

