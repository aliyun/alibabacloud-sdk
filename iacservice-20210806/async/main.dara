model CreateDetectConfigRequest {
  alarmConfigs?: [ 
    {
      address?: string(name='address', description='Alerting address.', example='https://metrichub-cms-cn-hangzhou.aliyuncs.com/event/notify?xxxxx'),
      type?: string(name='type', description='Alerting method. Currently only `cms` is supported.', example='cms'),
    }
  ](name='alarmConfigs', description='List of alerting addresses', position='Body'),
  clientToken: string(name='clientToken', description='Idempotence token, format: `[0-9a-zA-Z-]{1,64}`. It is recommended to use a UUID.

This parameter is required.', example='a65451293e64979ba7a4b573950217fe', position='Body'),
  cronExpression?: string(name='cronExpression', description='Cron expression (UTC+8). Required when trigger type is `Cron`.', example='0 0 0 ? * 1', position='Body'),
  description?: string(name='description', description='Description, up to 256 characters in length.', example='example', position='Body'),
  detectConfigName: string(name='detectConfigName', description='Detection configuration Name

This parameter is required.', example='test', position='Body'),
  enabled?: boolean(name='enabled', description='Whether the Detection feature is Enabled. The default value is `true`.', position='Body'),
  triggerType?: string(name='triggerType', description='Trigger type  
- Manual: Execute manually  
- Cron: Trigger on a schedule', example='Manual', position='Body'),
}

model CreateDetectConfigResponseBody = {
  detectConfigId?: string(name='detectConfigId', description='Drift detection configuration ID', example='dc-xxxx'),
  requestId?: string(name='requestId', description='request ID', example='String'),
}

model CreateDetectConfigResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateDetectConfigResponseBody(name='body'),
}

/**
  * @description ## Request Description  
  * - When `triggerType` is set to `Cron`, a valid `cronExpression` must be provided.  
  * - Each element in the `alarmConfigs` list must specify the alerting method `type` and the corresponding alerting address `address`.  
  * - If the `enabled` parameter is not explicitly set, its default value is `true`, meaning newly created detection configurations are enabled by default.  
  * - It is recommended to use a UUID as the value of `clientToken` to ensure request idempotence.
  * @param request  the request parameters of CreateDetectConfig  CreateDetectConfigRequest
  * @return CreateDetectConfigResponse
 */
async function createDetectConfig(request: CreateDetectConfigRequest): CreateDetectConfigResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateDetectConfig', 'POST', '/terraformState/detectConfig', 'json', false, 'json', request);
}

