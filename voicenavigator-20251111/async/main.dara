/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'VoiceNavigator';
  @version = '2025-11-11';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model BeginSessionRequest {
  draftVersion?: boolean(name='DraftVersion', description='Specifies whether the draft version is used.', example='false', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='36e9a4cd-a821-4f78-86fa-a9a4aefeea2e', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The scenario ID.', example='0a88e269-01f5-49ac-97af-5830f0ccb271', position='Query'),
  vendorParams?: string(name='VendorParams', description='The vendor parameters.
>JSON format: {"key1":"value1"}', example='{"key1":"value1"}', position='Query'),
}

model BeginSessionResponseBody = {
  code?: string(name='Code', description='The business status code. A value of OK indicates that the request is successful.', example='OK'),
  data?: {
    answer?: string(name='Answer', description='The chatbot reply content.', example='Hello, welcome to STO Express. How can I help you?'),
    controlParamsList?: [ 
      {
        type?: string(name='Type', description='The control parameter type. Valid values:
>- HangUp: Hang up.
>- Transfer: Transfer.
>- GatherDtmf: Gather DTMF.
>- Voice: Voice.', example='Voice'),
      }
    ](name='ControlParamsList', description='The list of control parameters.'),
    endTime?: long(name='EndTime', description='The end time.', example='1752283603978'),
    sessionId?: string(name='SessionId', description='The session ID.', example='07d72ea0-6e38-48d4-8371-14deaaba996f'),
    startTime?: long(name='StartTime', description='The start time.', example='1774858849987'),
    streamEnd?: boolean(name='StreamEnd', description='Specifies whether the streaming response has ended.', example='true'),
    streamId?: string(name='StreamId', description='The turn ID of the conversation.', example='1'),
  }(name='Data', description='The business data.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code. A value of 200 indicates that the HTTP request is successful.', example='200'),
  message?: string(name='Message', description='The HTTP response message.', example='SUCCESS'),
  params?: [ string ](name='Params', description='The dynamic error parameters.'),
  requestId?: string(name='RequestId', description='The POP request ID.', example='14C39896-AE6D-4643-9C9A-E0566B2C2DDD'),
}

model BeginSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BeginSessionResponseBody(name='body'),
}

/**
  * @param request  the request parameters of BeginSession  BeginSessionRequest
  * @return BeginSessionResponse
 */
async function beginSession(request: BeginSessionRequest): BeginSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BeginSession', 'POST', '/', 'json', false, 'json', request);
}

function beginSessionWithResponseIterable(request: BeginSessionRequest): iterator[BeginSessionResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'BeginSession', 'POST', '/', 'json', false, 'json', request);
}

model BridgeWebCallRequest {
  accessChannelId?: string(name='AccessChannelId', description='The channel ID.
> This parameter is valid only when AccessChannelType is set to Web or Trial.', example='33606503-c22c-4547-a51c-dda5e8d87962', position='Query'),
  accessChannelType?: string(name='AccessChannelType', description='The channel type.

> - Text: text test window
> - Test: test window
> - Trial: trial link', example='Text', position='Query'),
  caller?: string(name='Caller', description='The caller number.', example='010123*****', position='Query'),
  deviceId?: string(name='DeviceId', description='The device ID.', example='d4c38420-****-43bc-b001-56bfc274****', position='Query'),
  draftVersion?: boolean(name='DraftVersion', description='Specifies whether the test environment is used.
>Default value: false.', example='false', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='36e9a4cd-a821-4f78-86fa-a9a4aefeea2e', maxLength=64, position='Query'),
  sampleRate?: int32(name='SampleRate', description='The sampling rate.', example='8000', position='Query'),
  scriptId?: string(name='ScriptId', description='The script ID.', example='0a88e269-01f5-49ac-97af-5830f0ccb271', position='Query'),
  tags?: string(name='Tags', description='The attached data.', example='{"key":"value"}', position='Query'),
  timeoutSeconds?: int32(name='TimeoutSeconds', description='The timeout period.

> 
> - If the call is not connected within the time specified by this parameter, the system actively hangs up the call. Unit: seconds. Default value: 60.', example='60', position='Query'),
}

model BridgeWebCallResponseBody = {
  code?: string(name='Code', description='The internal error code.', example='OK'),
  data?: {
    channelId?: string(name='ChannelId', description='The channel ID.', example='1515602866088888___5ec8446df1e2495a97969e887ab9e748'),
    expirationTime?: string(name='ExpirationTime', description='The expiration time of the token.', example='1774794266093'),
    instanceId?: string(name='InstanceId', description='The instance ID.', example='36e9a4cd-a821-4f78-86fa-a9a4aefeea2e'),
    serverUrl?: string(name='ServerUrl', description='The server URL.'),
    sessionId?: string(name='SessionId', description='The session ID.', example='f814f3ae-b2a7-44fb-883c-771221274673'),
    token?: string(name='Token', description='token', example='57aa3e9b11d2fa5736787cacf0408c1a'),
  }(name='Data', description='The call record.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The error message.', example='SUCCESS'),
  params?: [ string ](name='Params', description='The list of error parameters.'),
  requestId?: string(name='RequestId', description='The request ID.', example='14C39896-AE6D-4643-9C9A-E0566B2C2DDD'),
}

model BridgeWebCallResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BridgeWebCallResponseBody(name='body'),
}

/**
  * @param request  the request parameters of BridgeWebCall  BridgeWebCallRequest
  * @return BridgeWebCallResponse
 */
async function bridgeWebCall(request: BridgeWebCallRequest): BridgeWebCallResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BridgeWebCall', 'POST', '/', 'json', false, 'json', request);
}

model CreateCallCenterProviderRequest {
  destination?: string(name='Destination', description='The callee number during the transfer. This parameter is required when the transfer method is Bridge.', example='153*********', position='Body'),
  displayName?: string(name='DisplayName', description='The display name of the service provider.', example='Internal service provider of Cloud Call Center', position='Query'),
  extras?: string(name='Extras', description='The attached data.
>Notice: Format: k1=v1;k2=v2.</notice>', example='key1=value1', position='Body'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='36e9a4cd-a821-4f78-86fa-a9a4aefeea2e', maxLength=64, position='Body'),
  name?: string(name='Name', description='The name of the service provider.', example='Internal service provider of Cloud Call Center', position='Body'),
  originator?: string(name='Originator', description='The caller number during the transfer. This parameter is required when the transfer method is Bridge.', example='010****', position='Body'),
  providerType?: string(name='ProviderType', description='The provider type.
> 
> - CCC: Cloud Call Center.
>- CUSTOM: Customer-owned call center.', example='CCC', position='Body'),
  referTo?: string(name='ReferTo', description='The Refer address.<notice>This parameter is required when the transfer method is Refer.</notice>', example='-', position='Body'),
  trunkId?: string(name='TrunkId', description='The trunk ID.
>Notice: This parameter is required when the transfer method is Bridge.</notice>', example='trunk-xxx', position='Body'),
}

model CreateCallCenterProviderResponseBody = {
  code?: string(name='Code', description='The response code.', example='OK'),
  data?: string(name='Data', description='The ID of the human agent service provider.', example='xxxxxxxxx'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The error message.', example='Success'),
  params?: [ string ](name='Params', description='The dynamic error parameters.'),
  requestId?: string(name='RequestId', description='The request ID.', example='14C39896-AE6D-4643-9C9A-E0566B2C2DDD'),
}

model CreateCallCenterProviderResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateCallCenterProviderResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateCallCenterProvider  CreateCallCenterProviderRequest
  * @return CreateCallCenterProviderResponse
 */
async function createCallCenterProvider(request: CreateCallCenterProviderRequest): CreateCallCenterProviderResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateCallCenterProvider', 'POST', '/', 'json', true, 'form', request);
}

