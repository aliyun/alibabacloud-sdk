model CreateScriptVersionRequest {
  instanceId?: string(name='InstanceId', description='The instance ID.', example='abb4aa26-3a8e-43dd-82f8-0c3898c9c67f', position='Body'),
  interactionConfig?: {
    backgroundMusicId?: string(name='BackgroundMusicId', description='The background music ID.', example='office-ambience'),
    endConversationConfig?: {
      delay?: int32(name='Delay', description='The number of seconds to wait after the hang-up script finishes playing before executing the hang-up action. Valid values: 0 to 5.', example='1'),
      triggers?: [ 
        {
          closingStatement?: string(name='ClosingStatement', description='The closing statement played when the turn limit is reached and the hang-up action is executed.', example='Thank you for your time. Have a nice day. Goodbye!'),
          keyWords?: [ string ](name='KeyWords', description='The list of custom interception keywords.'),
          triggerType?: string(name='TriggerType', description='Valid values:\\\\
- TurnLimit: Maximum interaction turn check.\\\\
- IntelligentVoiceAssistant: Voice assistant.\\\\
- InteractiveVoiceResponse: Extension transfer.\\\\
- KeyWords: Custom interception.', example='TurnLimit'),
          turnLimit?: int32(name='TurnLimit', description='The maximum number of interaction turns before the hang-up action is executed. Valid values: 0 to 100. A value of 0 indicates that the turn-limit hang-up feature is disabled.', example='20'),
        }
      ](name='Triggers', description='The special case interception rules.'),
    }(name='EndConversationConfig', description='The hang-up configuration.'),
    initialGreetingDelayMilliseconds?: int32(name='InitialGreetingDelayMilliseconds', description='The delay before playing the greeting after the call is connected. Unit: milliseconds.', example='2000'),
    silenceDetectionConfig?: {
      maxRepeats?: int32(name='MaxRepeats', description='The number of consecutive silence turns before the hang-up action is executed.\\\\
This parameter takes effect when NluEngine is set to PROMPTS for the current scenario.', example='3'),
      timeout?: int32(name='Timeout', description='The silence timeout period, in milliseconds.\\\\
When the user remains silent for longer than the specified value, the silence timeout script is played.\\\\
Valid values: 2000 to 10000.', example='5000'),
    }(name='SilenceDetectionConfig', description='The silence detection configuration.'),
  }(name='InteractionConfig', description='The interaction configuration.', shrink='json', position='Body'),
  labelConfig?: [ 
    {
      candidateValues?: [ string ](name='CandidateValues', description='The list of candidate values for the label.'),
      description?: string(name='Description', description='The label description.', example='Whether the user agrees to repay before the repayment deadline'),
      name?: string(name='Name', description='The label name.', example='Agree to repay'),
    }
  ](name='LabelConfig', description='The custom label configuration.', shrink='json', position='Body'),
  scriptId?: string(name='ScriptId', description='The scenario ID.', example='64241e64-190c-45d1-af66-06f51c07b090', position='Body'),
  scriptProfile?: {
    agentKey?: string(name='AgentKey', description='The AgentKey of the chatbot.\\\\
This parameter is required when NluEngine is set to BEEBOT for the current scenario.', example='1309723684579735_p_beebot_public'),
    agentProfile?: {
      promptsJson?: string(name='PromptsJson', description='The prompt in JSON format.', example='{\\\\"prompts\\\\":\\\\"I am a chatbot.\\\\"}'),
      scriptProfileTemplateId?: string(name='ScriptProfileTemplateId', description='The scenario template ID.', example='CCC_PROMPTS_DEFAULT'),
    }(name='AgentProfile', description='The conversation agent configuration.'),
    chatbotId?: string(name='ChatbotId', description='The chatbot ID.\\\\
This parameter is required when NluEngine is set to BEEBOT for the current scenario.', example='chatbot-cn-MQuyjjb666'),
    functionMeta?: {
      functionId?: string(name='FunctionId', description='The function service ID.\\\\
This parameter is required when NluEngine is set to FUNCTION for the current scenario.', example='9b752bbb-805a-4d3e-9013-eab5555c3fef'),
      functionName?: string(name='FunctionName', description='The function service name.\\\\
This parameter is required when NluEngine is set to FUNCTION for the current scenario.', example='my_funciton'),
      httpTriggerName?: string(name='HttpTriggerName', description='The HTTP trigger name.\\\\
This parameter is required when NluEngine is set to FUNCTION for the current scenario.', example='defaultTrigger'),
      httpTriggerUrl?: string(name='HttpTriggerUrl', description='The HTTP trigger URL.\\\\
This parameter is required when NluEngine is set to FUNCTION for the current scenario.', example='http://chat-xxxxx-v-yewiundukb.cn-hangzhou-xxx.run'),
      regionId?: string(name='RegionId', description='The region where the function service resides.\\\\
This parameter is required when NluEngine is set to FUNCTION for the current scenario.', example='cn-hangzhou'),
    }(name='FunctionMeta', description='The Function Compute configuration.'),
    model?: string(name='Model', description='The conversation model.\\\\
This parameter is required when NluEngine is set to PROMPTS for the current scenario.', example='qwen-plus'),
    nluAccessProfile?: {
      accessProfileId?: string(name='AccessProfileId', description='The third-party conversation model configuration ID.', example='c2c9baae-9351-4c49-a8cb-6f24a83a8718'),
    }(name='NluAccessProfile', description='The associated configuration.'),
    nluAccessType?: string(name='NluAccessType', description='The conversation model invocation method.', example='MANAGED'),
    omniModel?: boolean(name='OmniModel', description='Specifies whether the model is an Omni model.', example='true'),
  }(name='ScriptProfile', description='The conversation capability configuration.', shrink='json', position='Body'),
  sourceVersionId?: string(name='SourceVersionId', example='d7b8a210-1f2d-4c5b-8a63-01e4f3b7c9d2', position='Body'),
  synthesizerConfig?: {
    model?: string(name='Model', description='The TTS model.', example='CosyVoice'),
    nlsAccessProfile?: {
      accessProfileId?: string(name='AccessProfileId', description='The third-party voice configuration ID. This parameter is required when you use a third-party ASR service such as Doubao or iFLYTEK.', example='c2c9baae-9351-4c49-a8cb-6f24a83a8718'),
    }(name='NlsAccessProfile', description='The associated configuration.'),
    nlsAccessType?: string(name='NlsAccessType', description='The TTS invocation method.', example='MANAGED'),
    nlsEngine?: string(name='NlsEngine', description='The TTS engine.', example='BAILIAN'),
    pitchRate?: int32(name='PitchRate', description='The pitch rate.\\\\
Valid values: -500 to 500.\\\\
Default value: 0.', example='0'),
    pronRules?: [ 
      {
        pattern?: string(name='Pattern', description='The commonly mispronounced word.', example='还钱'),
        replacement?: string(name='Replacement', description='The homophone replacement word.', example='环钱'),
      }
    ](name='PronRules', description='The TTS pronunciation correction list.'),
    speechRate?: int32(name='SpeechRate', description='The speech rate.\\\\
Valid values: -500 to 500.\\\\
Default value: 0.', example='0'),
    voice?: string(name='Voice', description='The voice speaker.', example='longanyang'),
    volume?: int32(name='Volume', description='The volume.\\\\
Valid values: 0 to 100.\\\\
Default value: 50.', example='50'),
  }(name='SynthesizerConfig', description='The TTS configuration.', shrink='json', position='Body'),
  transcriberConfig?: {
    correctionRules?: [ 
      {
        pattern?: string(name='Pattern'),
        replacement?: string(name='Replacement'),
      }
    ](name='CorrectionRules'),
    customizationId?: string(name='CustomizationId', description='The custom language model ID for ASR.', example='cd97223f-42f2-4cd9-95af-e734e2fe1fe4'),
    endSilenceTimeout?: int32(name='EndSilenceTimeout', description='The silence detection threshold. When the silence interval between speech segments exceeds x milliseconds, sentence segmentation is triggered (Voice Activity Detection, or VAD).', example='700'),
    model?: string(name='Model', description='The ASR model.', example='Paraformer'),
    nlsAccessProfile?: {
      accessProfileId?: string(name='AccessProfileId', description='The third-party voice configuration ID. This parameter is required when you use a third-party ASR service such as Doubao or iFLYTEK.', example='c2c9baae-9351-4c49-a8cb-6f24a83a8718'),
    }(name='NlsAccessProfile', description='The associated configuration.'),
    nlsAccessType?: string(name='NlsAccessType', description='The ASR invocation method.', example='MANAGED'),
    nlsEngine?: string(name='NlsEngine', description='The ASR engine.', example='BAILIAN'),
    speechNoiseThreshold?: int32(name='SpeechNoiseThreshold', description='The noise threshold. Valid values: -100 to 100.

A value closer to -100 increases the probability that noise is classified as speech.

A value closer to +100 increases the probability that speech is classified as noise.', example='0'),
    vocabularyId?: string(name='VocabularyId', description='The hot word list ID. You can obtain this ID from the hot word management page.', example='cd97223f-42f2-4cd9-95af-e734e2fe1fe3'),
  }(name='TranscriberConfig', description='The ASR configuration.', shrink='json', position='Body'),
}

model CreateScriptVersionResponseBody = {
