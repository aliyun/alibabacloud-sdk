model CreateInstructionRequest {
  code?: string(name='Code', description='The instruction code.
>Notice: Globally unique.</notice>', example='Transfer00', position='Body'),
  config?: string(name='Config', description='The instruction configuration.

> - providerId: the ID of the human agent service provider. You can obtain the ID by calling ListCallCenterProviders.
> - transferMethod: the transfer method. Valid values: BYE, BRIDGE, and REFER.
> - transferType: the transfer target type. Valid values: External (external number), Agent (agent), and SkillGroup (skill group).
> - transferTarget: the transfer target.
> - transferor: the caller number. If this parameter is left empty, the mobile phone number of the calling customer is used by default.
> - timeoutSeconds: the timeout period for transferring to a human agent, in seconds. Default value: 30.', example='{
	"providerId": "xxxxxxxxx",
	"transferMethod": "BYE",
	"transferType": "External",
	"transferTarget": "152******",
	"transferor": "01*****",
	"timeoutSeconds": "10"
}', position='Body'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='36e9a4cd-a821-4f78-86fa-a9a4aefeea2e', maxLength=64, position='Body'),
  name?: string(name='Name', description='The instruction name.', example='Transfer to human agent instruction 1', position='Body'),
  type?: string(name='Type', description='The instruction type.', example='TRANSFER', position='Body'),
}

model CreateInstructionResponseBody = {
  code?: string(name='Code', description='The status code.', example='OK'),
  data?: string(name='Data', description='The instruction code.', example='Transfer00'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The error message.', example='SUCCESS'),
  params?: [ string ](name='Params', description='The dynamic error parameters.'),
  requestId?: string(name='RequestId', description='Id of the request', example='14C39896-AE6D-4643-9C9A-E0566B2C2DDD'),
}

model CreateInstructionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateInstructionResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateInstruction  CreateInstructionRequest
  * @return CreateInstructionResponse
 */
async function createInstruction(request: CreateInstructionRequest): CreateInstructionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateInstruction', 'POST', '/', 'json', true, 'form', request);
}

