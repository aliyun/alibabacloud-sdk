}

/**
 * @summary Initiates a session.
 *
 * @param request BeginSessionRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return BeginSessionResponse
 */
@sse(true)
@context("beginSessionWithSSECtx")
async function beginSessionWithSSE(request: BeginSessionRequest, runtime: $RuntimeOptions): asyncIterator[BeginSessionResponse] {
  request.validate();
  var query = {};
  if (!$isNull(request.draftVersion)) {
    query['DraftVersion'] = request.draftVersion;
  }
  if (!$isNull(request.instanceId)) {
    query['InstanceId'] = request.instanceId;
  }
  if (!$isNull(request.scriptId)) {
    query['ScriptId'] = request.scriptId;
  }
  if (!$isNull(request.vendorParams)) {
    query['VendorParams'] = request.vendorParams;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'BeginSession',
    version = '2025-11-11',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  var sseResp = callSSEApi(params, req, runtime);
  for (var resp : sseResp) {
    if (!$isNull(resp.event) && !$isNull(resp.event.data)) {
      var data = $object($JSON.parseJSON(resp.event.data));
      yield {
        statusCode = resp.statusCode,
        headers = resp.headers,
        id = resp.event.id,
        event = resp.event.event,
        body = data
      };
    }
  }
}
