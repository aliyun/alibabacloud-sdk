import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('voicenavigator', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model BeginSessionRequest {
  draftVersion?: boolean(name='DraftVersion', description='Specifies whether the draft version is used.', example='false'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='36e9a4cd-a821-4f78-86fa-a9a4aefeea2e'),
  scriptId?: string(name='ScriptId', description='The scenario ID.', example='0a88e269-01f5-49ac-97af-5830f0ccb271'),
  vendorParams?: string(name='VendorParams', description='The vendor parameters.
>JSON format: {"key1":"value1"}', example='{"key1":"value1"}'),
}

model BeginSessionResponseBody = {
  code?: string(name='Code', description='The business status code. A value of OK indicates that the request is successful.', example='OK'),
  data?: {
    answer?: string(name='Answer', description='The chatbot reply content.', example='Hello, welcome to STO Express. How can I help you?'),
    controlParamsList?: [ 
      {
        type?: string(name='Type', description='The control parameter type. Valid values:
>- HangUp: Hang up.
>- Transfer: Transfer.
>- GatherDtmf: Gather DTMF.
>- Voice: Voice.', example='Voice'),
      }
    ](name='ControlParamsList', description='The list of control parameters.'),
    endTime?: long(name='EndTime', description='The end time.', example='1752283603978'),
    sessionId?: string(name='SessionId', description='The session ID.', example='07d72ea0-6e38-48d4-8371-14deaaba996f'),
    startTime?: long(name='StartTime', description='The start time.', example='1774858849987'),
    streamEnd?: boolean(name='StreamEnd', description='Specifies whether the streaming response has ended.', example='true'),
    streamId?: string(name='StreamId', description='The turn ID of the conversation.', example='1'),
  }(name='Data', description='The business data.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code. A value of 200 indicates that the HTTP request is successful.', example='200'),
  message?: string(name='Message', description='The HTTP response message.', example='SUCCESS'),
  params?: [ string ](name='Params', description='The dynamic error parameters.'),
  requestId?: string(name='RequestId', description='The POP request ID.', example='14C39896-AE6D-4643-9C9A-E0566B2C2DDD'),
}

model BeginSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  id?: string(name='id'),
