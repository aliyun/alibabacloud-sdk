  messages?: [ 
    {
      content?: [ 
        {
          imageData?: string(name='imageData', description='The compatible inline image field for input_image. You can pass a Base64 data URL.', example='data:image/png;base64,...'),
          imageUrl?: {
            url?: string(name='url', description='A publicly accessible HTTPS image URL or a Base64 image data URL. Each round of user messages must and can only contain one current screenshot. Expired or inaccessible image addresses are rejected.', example='https://example.com/screenshot.png'),
          }(name='imageUrl', description='The screenshot reference. Supports an image_url string or an object containing a url field. The object format is shown here.'),
          text?: string(name='text', description='The text content, which can describe the current operation objective or supplement the current page state.', example='Click the search button'),
          type?: string(name='type', description='The type of the content item. Use text or input_text for text. Use image_url or input_image for screenshots.', example='text'),
        }
      ](name='content', description='The message content. For a user message, use a content array that contains exactly one current screenshot and optionally attached task text. Screenshots support public HTTPS URLs or Base64 image data URLs. When role is set to tool, fill in the actual execution result of the previous action, which can be a non-empty string, object, or array.'),
