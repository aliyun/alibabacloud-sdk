  }
  if (!Util.isUnset(headers.xQIInstanceId)) {
    realHeaders['X-QI-Instance-Id'] = Util.toJSONString(headers.xQIInstanceId);
  }
  if (!Util.isUnset(headers.xQISessionId)) {
    realHeaders['X-QI-Session-Id'] = Util.toJSONString(headers.xQISessionId);
  }
  var req = new OpenApi.OpenApiRequest{ 
    headers = realHeaders,
    body = OpenApiUtil.parseToMap(body),
  };
