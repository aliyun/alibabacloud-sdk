import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('maasqiservice', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AigcChatCompletionStreamHeaders {
  commonHeaders?: map[string]string,
  xQIAgentApiKey?: string(name='X-QI-Agent-Api-Key', description='The instance access key. The key must belong to the Creative Agent instance being called. This key is different from the AccessKey Secret used for OpenAPI signing. Do not expose it publicly.

This parameter is required.', example='qis_xxx'),
  xQIInstanceId?: string(name='X-QI-Instance-Id', description='The published Creative Agent instance ID. Must correspond to the X-QI-Agent-Api-Key.

This parameter is required.', example='AIGC_xxx'),
  xQISessionId?: string(name='X-QI-Session-Id', description='The session identifier. Can be omitted for the first turn. Obtain it from the qi_session_id field in the SSE response and pass it back in subsequent turns. Use no more than 128 characters consisting of letters, digits, periods, underscores, colons, or hyphens.', example='session-xxx'),
}

model AigcChatCompletionStreamRequest {
  messages?: [ 
    {
      content?: [ 
        {
          imageUrl?: {
            url?: string(name='url', description='The publicly accessible HTTPS URL of the reference image, or a complete Base64 image Data URL (such as data:image/png;base64,...). Signed URLs must remain valid during request execution. Re-upload or update the link for expired or unauthorized images.', example='https://example.com/input.png'),
          }(name='imageUrl', description='The reference image when type is set to image_url. Supports HTTPS URLs or Base64 Data URLs.'),
          text?: string(name='text', description='The generation or editing objective when type is set to text.', example='Change the background of the reference image to a seaside sunset'),
          type?: string(name='type', description='The content part type: text, image_url, or video_url.', example='text'),
          videoUrl?: {
            url?: string(name='url', description='The video URL.', example='https://example.com/input.mp4'),
          }(name='videoUrl', description='The video input when type is set to video_url. Only accepted by the Creative Agent Dedicated edition Planner. The Creative Agent Lite edition rejects this type.'),
        }
      ](name='content', description='The message content. Can be text. A multimodal array can contain text, image_url, or video_url. The Creative Agent Lite edition performs image-to-image when a reference image is provided and text-to-image when no reference image is provided. It does not accept video.', example='Generate a futuristic city nightscape after rain'),
      role?: string(name='role', description='The message role. Place the current generation objective in a user message. History can include user, assistant, and tool.', example='user'),
    }
  ](name='messages', description='The conversation message array. Creative Agent uses the last user message as the current objective and executes it in combination with the session history.

This parameter is required.', example='[{"role":"user","content":"Generate an ink wash landscape painting"}]'),
  metadata?: {
    parameters?: {
      guidanceScale?: double(name='guidanceScale', description='The guidance scale. Must be a finite number between 0 and 20.', example='0.0'),
      n?: long(name='n', description='The number of images to generate for this request. Must be an integer in the range of 1 to 6.', example='1'),
      negativePrompt?: string(name='negativePrompt', description='The negative prompt that describes content you do not want to appear in the result.', example='low quality, blurry, text, watermark'),
      numInferenceSteps?: long(name='numInferenceSteps', description='The number of model inference iterations. Must be an integer in the range of 1 to 200.', example='8'),
      seed?: long(name='seed', description='The random seed. Must be an integer in the range of 0 to 2147483647.', example='42'),
      size?: string(name='size', description='The output pixel dimensions, such as `1024*1024` or `1280*720`. The format `1024x1024` is also accepted. When specified, this value overrides the default canvas dimensions for this request. Use width and height values supported by the model.', example='1024*1024'),
    }(name='parameters', description='The image parameters for this request. Only size, n, seed, negative_prompt, num_inference_steps, and guidance_scale are supported. Omitted fields use the default configurations. response_format is not supported.', example='{"size":"1024*1024","n":1,"num_inference_steps":8}'),
  }(name='metadata', description='The extended input for this image creation request. Use the parameters object to set generation parameters. Do not use this field to pass model addresses or keys.', example='{"parameters":{"size":"1024*1024","n":1}}'),
  model?: string(name='model', description='A compatibility placeholder field. Can be omitted or set to an empty string. You cannot use this field to switch the model used by the instance. The model field in the response is an empty string.', example='" "'),
  stream?: boolean(name='stream', description='Specifies whether to use SSE streaming responses. This parameter must be set to true for this operation.

This parameter is required.', example='true'),
  streamOptions?: {
    includeUsage?: boolean(name='includeUsage', description='The HTTP JSON key is include_usage. When set to true, an independent usage chunk is returned before the end marker. The choices field in this chunk is an empty array. Token usage does not represent the number of images or the final bill.', example='true'),
  }(name='streamOptions', description='The HTTP JSON key is stream_options. Set include_usage to retrieve the token usage for this call.', example='{"include_usage":true}'),
}

