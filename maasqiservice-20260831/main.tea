import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = '';
  
  checkConfig(config);
  @endpoint = getEndpoint('maasqiservice', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AigcChatCompletionStreamHeaders {
  commonHeaders?: map[string]string,
  xQIAgentApiKey?: string(name='X-QI-Agent-Api-Key', description='This parameter is required.', example='qis_xxx'),
  xQIInstanceId?: string(name='X-QI-Instance-Id', description='This parameter is required.', example='AIGC_xxx'),
  xQISessionId?: string(name='X-QI-Session-Id', example='session-xxx'),
}

model AigcChatCompletionStreamRequest {
  messages?: [ 
    {
      content?: [ 
        {
          imageUrl?: {
            url?: string(name='url', example='https://example.com/input.png'),
          }(name='imageUrl'),
          text?: string(name='text', example='把参考图背景改成海边日落'),
          type?: string(name='type', example='text'),
          videoUrl?: {
            url?: string(name='url', example='https://example.com/input.mp4'),
          }(name='videoUrl'),
        }
      ](name='content', example='生成一张雨后未来城市夜景'),
      role?: string(name='role', example='user'),
    }
  ](name='messages', description='This parameter is required.', example='[{"role":"user","content":"生成一张水墨山水画"}]'),
  metadata?: {
    parameters?: {
      guidanceScale?: double(name='guidanceScale', example='0.0'),
      n?: long(name='n', example='1'),
      negativePrompt?: string(name='negativePrompt', example='低质量、模糊、文字、水印'),
      numInferenceSteps?: long(name='numInferenceSteps', example='8'),
      seed?: long(name='seed', example='42'),
      size?: string(name='size', example='1024*1024'),
    }(name='parameters', example='{"size":"1024*1024","n":1,"num_inference_steps":8}'),
  }(name='metadata', example='{"parameters":{"size":"1024*1024","n":1}}'),
  model?: string(name='model'),
  stream?: boolean(name='stream', description='This parameter is required.', example='true'),
  streamOptions?: {
    includeUsage?: boolean(name='includeUsage', example='true'),
  }(name='streamOptions', example='{"include_usage":true}'),
}

model AigcChatCompletionStreamResponseBody = {
  requestId?: string(name='requestId'),
}

model AigcChatCompletionStreamResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AigcChatCompletionStreamResponseBody(name='body'),
}

/**
