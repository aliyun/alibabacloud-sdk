model AigcChatCompletionStreamRequest {
  xQIAgentApiKey: string(name='X-QI-Agent-Api-Key', description='This parameter is required.', example='qis_xxx', position='Header'),
  xQIInstanceId: string(name='X-QI-Instance-Id', description='This parameter is required.', example='AIGC_xxx', position='Header'),
  xQISessionId?: string(name='X-QI-Session-Id', example='session-xxx', position='Header'),
  messages: [ 
    {
      content?: [ 
        {
          imageUrl?: {
            url?: string(name='url', example='https://example.com/input.png'),
          }(name='imageUrl'),
          text?: string(name='text', example='把参考图背景改成海边日落'),
          type?: string(name='type', example='text'),
          videoUrl?: {
            url?: string(name='url', example='https://example.com/input.mp4'),
          }(name='videoUrl'),
        }
      ](name='content', example='生成一张雨后未来城市夜景'),
      role?: string(name='role', example='user'),
    }
  ](name='messages', description='This parameter is required.', example='[{"role":"user","content":"生成一张水墨山水画"}]', position='Body'),
  metadata?: {
    parameters?: {
      guidanceScale?: double(name='guidanceScale', example='0.0'),
      n?: long(name='n', example='1'),
      negativePrompt?: string(name='negativePrompt', example='低质量、模糊、文字、水印'),
      numInferenceSteps?: long(name='numInferenceSteps', example='8'),
      seed?: long(name='seed', example='42'),
      size?: string(name='size', example='1024*1024'),
    }(name='parameters', example='{"size":"1024*1024","n":1,"num_inference_steps":8}'),
  }(name='metadata', example='{"parameters":{"size":"1024*1024","n":1}}', position='Body'),
  model?: string(name='model', position='Body'),
  stream: boolean(name='stream', description='This parameter is required.', example='true', position='Body'),
  streamOptions?: {
    includeUsage?: boolean(name='includeUsage', example='true'),
  }(name='streamOptions', example='{"include_usage":true}', position='Body'),
}

model AigcChatCompletionStreamResponseBody = {
  requestId?: string(name='requestId'),
}

model AigcChatCompletionStreamResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AigcChatCompletionStreamResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AigcChatCompletionStream  AigcChatCompletionStreamRequest
  * @return AigcChatCompletionStreamResponse
 */
async function aigcChatCompletionStream(request: AigcChatCompletionStreamRequest): AigcChatCompletionStreamResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AigcChatCompletionStream', 'POST', '/aigc/v1/chat/completions', 'json', false, 'json', request);
}

async function aigcChatCompletionStreamWithAsyncResponseHandler(request: AigcChatCompletionStreamRequest, responseHandler: AsyncResponseHandler): AigcChatCompletionStreamResponse {
  @handler.validateRequestModel(request);
  return @handler.doResponseHandler('RESTFUL', 'AigcChatCompletionStream', 'POST', '/aigc/v1/chat/completions', 'json', false, 'json', request, responseHandler);
}

function aigcChatCompletionStreamWithResponseIterable(request: AigcChatCompletionStreamRequest): iterator[AigcChatCompletionStreamResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'AigcChatCompletionStream', 'POST', '/aigc/v1/chat/completions', 'json', false, 'json', request);
}

model GuiChatCompletionStreamRequest {
  xQIAgentApiKey: string(name='X-QI-Agent-Api-Key', description='This parameter is required.', example='qis_xxx', position='Header'),
  xQIInstanceId: string(name='X-QI-Instance-Id', description='This parameter is required.', example='GUI_xxx', position='Header'),
  xQISessionId?: string(name='X-QI-Session-Id', example='session-xxx', position='Header'),
  allowedTokenIds?: [ long ](name='allowedTokenIds', example='[10,11]', position='Body'),
  badWords?: [ string ](name='badWords', example='["blocked"]', position='Body'),
  chatTemplateKwargs?: {
    enableThinking?: boolean(name='enableThinking', example='true'),
    preserveThinking?: boolean(name='preserveThinking', example='true'),
  }(name='chatTemplateKwargs', position='Body'),
  frequencyPenalty?: double(name='frequencyPenalty', example='0.0', position='Body'),
  ignoreEos?: boolean(name='ignoreEos', example='false', position='Body'),
  includeReasoning?: boolean(name='includeReasoning', example='true', position='Body'),
  logprobs?: boolean(name='logprobs', example='false', position='Body'),
  maxCompletionTokens?: long(name='maxCompletionTokens', example='2048', position='Body'),
  maxTokens?: long(name='maxTokens', example='2048', position='Body'),
  messages: [ 
    {
      content?: [ 
        {
          imageData?: string(name='imageData', example='data:image/png;base64,...'),
          imageUrl?: {
            url?: string(name='url', example='https://example.com/screenshot.png'),
          }(name='imageUrl'),
          text?: string(name='text', example='点击搜索按钮'),
          type?: string(name='type', example='text'),
        }
      ](name='content'),
      role?: string(name='role', example='user'),
      toolCallId?: string(name='toolCallId', example='call_gui_1'),
    }
  ](name='messages', description='This parameter is required.', position='Body'),
  metadata?: {
    appList?: [ string ](name='appList', example='["Chrome","Settings"]'),
    availableApps?: [ string ](name='availableApps', example='["Chrome","Settings"]'),
    harnessMessage?: string(name='harnessMessage', example='previous action completed'),
    screenHeight?: long(name='screenHeight', example='1080'),
    screenWidth?: long(name='screenWidth', example='1920'),
  }(name='metadata', position='Body'),
  minP?: double(name='minP', example='0.05', position='Body'),
  minTokens?: long(name='minTokens', example='1', position='Body'),
  mmProcessorKwargs?: {
    maxDynamicPatch?: long(name='maxDynamicPatch', example='8'),
  }(name='mmProcessorKwargs', position='Body'),
  model?: string(name='model', position='Body'),
  n?: long(name='n', example='1', position='Body'),
  parallelToolCalls?: boolean(name='parallelToolCalls', example='false', position='Body'),
  presencePenalty?: double(name='presencePenalty', example='0.0', position='Body'),
  promptLogprobs?: long(name='promptLogprobs', example='2', position='Body'),
  reasoningEffort?: string(name='reasoningEffort', example='medium', position='Body'),
  repetitionPenalty?: double(name='repetitionPenalty', example='1.1', position='Body'),
  responseFormat?: {
    type?: string(name='type', example='json_object'),
  }(name='responseFormat', position='Body'),
  seed?: long(name='seed', example='42', position='Body'),
  skipSpecialTokens?: boolean(name='skipSpecialTokens', example='true', position='Body'),
  stop?: [ string ](name='stop', example='["DONE"]', position='Body'),
  stopTokenIds?: [ long ](name='stopTokenIds', example='[1,2]', position='Body'),
  stream: boolean(name='stream', description='This parameter is required.', example='true', position='Body'),
  streamOptions?: {
    includeUsage?: boolean(name='includeUsage', example='true'),
  }(name='streamOptions', position='Body'),
  structuredOutputs?: {
    choice?: [ string ](name='choice', example='["tap","type"]'),
  }(name='structuredOutputs', position='Body'),
  temperature?: double(name='temperature', example='0.2', position='Body'),
  topK?: long(name='topK', example='20', position='Body'),
  topLogprobs?: long(name='topLogprobs', example='3', position='Body'),
  topP?: double(name='topP', example='0.9', position='Body'),
}

