 *           "value": "example-session",
 *           "domain": "example.com",
 *           "path": "/",
 *           "secure": true,
 *           "httpOnly": true,
 *           "sameSite": "Lax"
 *         }
 *       ]
 *     },
 *     "localUser": {
 *       "localStorage": {
 *         "access_token": "example-local-token"
 *       }
 *     },
 *     "sessionUser": {
 *       "sessionStorage": {
 *         "session_token": "example-session-token"
 *       }
 *     },
 *     "headerUser": {
 *       "extraHeaders": {
 *         "Authorization": "Bearer example-token"
 *       }
 *     }
 *   }
 * }
