    taskId: string(name='TaskId', description='The task ID to which the report belongs. This parameter is required and must belong to the current account. You can obtain the task ID from CreatePentestTask or TaskList[].TaskId returned by DescribePentestTaskList.

This parameter is required.', example='d89742f4-59a8-4ec8-98db-d109c2365392'),
