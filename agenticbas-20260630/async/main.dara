import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'AgenticBAS';
  @version = '2026-06-30';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CreatePentestTaskRequest {
  operationInput: {
    assetSource: string(name='AssetSource', description='资产来源。SAS_HOST：云安全中心主机资产，校验当前账号下是否存在该公网 IP；ATTACK_SURFACE_ASSET：攻击面资产，校验当前账号下是否存在对应 IP 或域名资产；CUSTOM_ASSET：自定义资产，按当前账号、完整 scan_url 和 ACTIVE 状态匹配。

This parameter is required.', example='CUSTOM_ASSET'),
    description?: string(name='Description', example='检查授权网站的安全风险'),
    execMode?: string(name='ExecMode', description='执行模式：IMMEDIATE 表示立即执行，SCHEDULED 表示定时执行。', example='IMMEDIATE'),
    ipDomains: string(name='IpDomains', description='待检测的公网 IP、域名或完整扫描 URL；多个目标使用英文逗号分隔，最多 5 个。

This parameter is required.', example='https://example.com/'),
    name: string(name='Name', description='任务名称，长度为 1 到 100 个字符。

This parameter is required.', example='网站安全检查', minLength=1, maxLength=100),
    pentestRequirement?: string(name='PentestRequirement', description='补充渗透测试要求，最长 5000 个字符；与 VulnCheckItems 不能同时为空。', example='检查网站是否存在未授权访问和 SQL 注入风险', maxLength=5000),
    reportLanguage?: string(name='ReportLanguage', description='报告语言：zh 表示中文，en 表示英文。', example='zh'),
    scenario?: string(name='Scenario', description='渗透测试场景，当前仅支持 Web 漏洞检测。', example='WEB_VULN'),
    scheduleTime?: string(name='ScheduleTime', description='定时执行时间；ExecMode 为 SCHEDULED 时传入，格式 yyyy-MM-dd HH:mm:ss，且不能早于当前时间。', example='2026-10-01 10:00:00'),
    vulnCheckItems?: [ string ](name='VulnCheckItems', description='漏洞检测项；与 PentestRequirement 不能同时为空。'),
  }(name='OperationInput', description='This parameter is required.', shrink='json', position='Query'),
  operationType?: string(name='OperationType', description='网关内部固定路由参数，不对调用方暴露。', example='createPentestTask', position='Query'),
}

model CreatePentestTaskResponseBody = {
  requestId?: string(name='RequestId', example='72C16BE5-08B3-48D1-8D10-6C15F5A93E27'),
  taskList?: [ 
    {
      createdAt?: long(name='CreatedAt', example='1788825600'),
      name?: string(name='Name', example='网站安全检查'),
      progress?: int32(name='Progress', example='0'),
      scanId?: string(name='ScanId', example='b82f6e42-cc4d-4a39-96a4-4159cff16785'),
      status?: string(name='Status', example='QUEUED'),
      targetUrl?: string(name='TargetUrl', example='https://example.com/'),
      taskId?: string(name='TaskId', example='d89742f4-59a8-4ec8-98db-d109c2365392'),
    }
  ](name='TaskList'),
}

model CreatePentestTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreatePentestTaskResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreatePentestTask  CreatePentestTaskRequest
  * @return CreatePentestTaskResponse
 */
async function createPentestTask(request: CreatePentestTaskRequest): CreatePentestTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreatePentestTask', 'POST', '/', 'json', false, 'json', request);
}

