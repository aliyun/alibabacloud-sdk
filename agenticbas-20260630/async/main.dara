model CreatePentestTaskRequest {
  operationInput: {
    assetSource: string(name='AssetSource', description='The asset source. SAS_HOST: verifies the public IP addresses of Security Center hosts under the current account. ATTACK_SURFACE_ASSET: verifies the IP addresses or domain name assets of the attack surface under the current account. CUSTOM_ASSET: verifies targets based on the ACTIVE custom asset records of the current account, and supports normalized hostname and authenticated parent domain name matching.

This parameter is required.', example='CUSTOM_ASSET'),
    credentials?: map[string]any(name='Credentials', description='The optional identity credential object for the scan target. The top-level keys are custom identity names, and the values are credential configurations. Supports account (username/password), cookies array, localStorage, sessionStorage, and extraHeaders. Internal key names retain their original case. For the specific structure, see the following example. If this parameter is not passed, no identity credentials are injected. This object is not returned in creation and query responses.'),
    creditsLimitAction?: string(name='CreditsLimitAction', description='The action to take after the MaxCredits limit is reached. STOP: stops the task. PAUSE: pauses the task. Default value: STOP. Use this parameter with MaxCredits.', example='STOP'),
    description?: string(name='Description', description='The task description, which is used to record the description information of the task.', example='Check security risks of authorized websites'),
    execMode?: string(name='ExecMode', description='The execution mode. IMMEDIATE: executes immediately, which may be queued due to concurrency limits. SCHEDULED: executes at a scheduled time, which is currently not supported by OpenAPI. Default value: IMMEDIATE. Use IMMEDIATE.', example='IMMEDIATE'),
    ipDomains: string(name='IpDomains', description='The public IP addresses, domain names, or URLs to be scanned. Separate multiple targets with commas. After removing whitespace, there should be 1 to 5 targets. Pass targets that are authorized under the current account and can pass asset ownership verification. If you need to specify HTTP or HTTPS, explicitly write the protocol in the target URL.

This parameter is required.', example='https://example.com/'),
    maxCredits?: long(name='MaxCredits', description='The maximum credits usage for a single task, which must be an integer greater than 0. If this parameter is not passed, no task-level limit is set. When multiple targets are created at a time, each task uses this limit separately.', example='500000', minimum=1),
    name: string(name='Name', description='The task name, which must be 1 to 100 characters in length and cannot contain only whitespace.

This parameter is required.', example='Website security check', minLength=1, maxLength=100),
    pentestRequirement?: string(name='PentestRequirement', description='The supplementary penetration testing requirements, up to 5,000 characters. If VulnCheckItems is not provided, non-whitespace content must be provided. Both fields can also be provided at the same time.', example='Check unauthorized access risks of authorized websites', maxLength=5000),
    reportLanguage?: string(name='ReportLanguage', description='The report language. zh indicates Chinese, and en indicates English. Default value: zh.', example='zh'),
    scenario?: string(name='Scenario', description='The test scenario. Currently, only WEB_VULN (web vulnerability detection) is supported. Default value: WEB_VULN.', example='WEB_VULN'),
    scheduleTime?: string(name='ScheduleTime', description='The scheduled execution time. Pass this parameter when ExecMode is SCHEDULED. The format is yyyy-MM-dd HH:mm:ss, and the time cannot be earlier than the current time.', example='2026-12-01 10:00:00'),
    vulnCheckItems?: [ string ](name='VulnCheckItems', description='The list of vulnerability check items, which contains 1 to 5 unique check items and cannot be an empty array. This parameter and PentestRequirement cannot be empty at the same time.'),
  }(name='OperationInput', description='The business parameter object, which is passed in JSON format. Provide the object and its required fields.

This parameter is required.', shrink='json', position='Query'),
  operationType?: string(name='OperationType', description='The internal fixed routing parameter of the gateway, which is not exposed to callers.', example='createPentestTask', position='Query'),
}

model CreatePentestTaskResponseBody = {
  requestId?: string(name='RequestId', description='The request ID, which is used to locate calls and troubleshoot issues.', example='72C16BE5-08B3-48D1-8D10-6C15F5A93E27'),
  taskList?: [ 
    {
      createdAt?: long(name='CreatedAt', description='The task creation time. It is a UNIX timestamp in seconds, which is the number of seconds since 1970-01-01 00:00:00 UTC.', example='1793577600'),
      name?: string(name='Name', description='The task name. When multiple targets are created at a time, serial numbers such as -1 and -2 are appended to the passed name.', example='Website security check'),
      progress?: int32(name='Progress', description='The task execution progress, which is updated by the server. It is 0 upon initialization.', example='0'),
      scanId?: string(name='ScanId', description='The ID of the current scan for the task. It may be empty if no scan record is generated.', example='b82f6e42-cc4d-4a39-96a4-4159cff16785'),
      status?: string(name='Status', description='The task status. PENDING: pending start. QUEUED: queued. STARTING: starting. RUNNING: running. PAUSED: paused. SUCCESS: executed successfully. FAILED: execution failed. STOPPED: stopped. TIMEOUT: execution timed out. ABNORMAL: execution abnormal. DELETED: deleted. A successful execution does not mean that no vulnerabilities are found.', example='QUEUED'),
      targetUrl?: string(name='TargetUrl', description='The scan target address of the task. It includes the corresponding protocol prefix if a protocol is specified.', example='https://example.com/'),
      taskId?: string(name='TaskId', description='The task ID. Use this value to query vulnerabilities and reports later.', example='d89742f4-59a8-4ec8-98db-d109c2365392'),
    }
  ](name='TaskList', description='The list of tasks created in this request, where each target corresponds to one task.'),
}

model CreatePentestTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreatePentestTaskResponseBody(name='body'),
}

/**
  * @description Creates penetration testing tasks for authorized assets of the current account and returns the task IDs. You can specify up to five targets at a time, and one task is created for each target.
  * Before you call this operation, you must activate the AgenticBAS service or meet the validity period and quota conditions of the trial service. The target assets must meet the ownership verification requirements of the selected asset source. Business parameters are passed in OperationInput. VulnCheckItems and PentestRequirement cannot be empty at the same time. Currently, only IMMEDIATE execution is supported, and scheduled execution is not supported.
  * A successful creation response only indicates that the tasks are created and does not wait for the scan to complete. Save the TaskId in TaskList, query the status and usage by calling DescribePentestTaskList, and then use the same TaskId to query vulnerabilities or reports. Tasks may enter a queue. If a report is not generated, the query response may not contain a download link.
  * Credentials use an object structure of "identity name -> credential configuration". The following are synthetic examples. Replace them with authorized test identities in actual calls.
  * ```json
  * {
  *   "Credentials": {
  *     "accountUser": {
  *       "account": {
  *         "username": "example-user",
  *         "password": "example-password"
  *       }
  *     },
  *     "cookieUser": {
  *       "cookies": [
  *         {
  *           "name": "session",
  *           "value": "example-session",
  *           "domain": "example.com",
  *           "path": "/",
  *           "secure": true,
  *           "httpOnly": true,
  *           "sameSite": "Lax"
  *         }
  *       ]
  *     },
  *     "localUser": {
  *       "localStorage": {
  *         "access_token": "example-local-token"
  *       }
  *     },
  *     "sessionUser": {
  *       "sessionStorage": {
  *         "session_token": "example-session-token"
  *       }
  *     },
  *     "headerUser": {
  *       "extraHeaders": {
  *         "Authorization": "Bearer example-token"
  *       }
  *     }
  *   }
  * }
  * ```
  * @param request  the request parameters of CreatePentestTask  CreatePentestTaskRequest
  * @return CreatePentestTaskResponse
 */
async function createPentestTask(request: CreatePentestTaskRequest): CreatePentestTaskResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreatePentestTask', 'POST', '/', 'json', false, 'json', request);
}

