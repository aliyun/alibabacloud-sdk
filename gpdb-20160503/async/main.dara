      projectName?: string(name='ProjectName', description='The project name. For the same scenario and project ID, the latest non-empty name snapshot within the query range is used. If multiple snapshots exist in the same second, the one with the maximum lexicographical value is used. If missing, the value is null.', example='Scenario remake'),
      usageScene?: string(name='UsageScene', description='The usage scenario code.', example='drama_game_oneshot'),
      usageSceneName?: string(name='UsageSceneName', description='The display name of the usage scenario. This field is supplemented by a dictionary that maps original Meta values to Chinese names, and is not an SLS field. UsageScene always retains the original log value. If no Chinese name is available, the original value is used as the name. Blank values are classified as other. Different codes with the same Chinese name are not merged.', example='游戏生成'),
    }
  ](name='Distribution', description='The usage distribution. The items are sorted in descending order of DataUnit. Items with unknown amounts are placed at the end. Items with the same value are sorted in ascending order of scenario code, project ID, and name. The items are grouped by scenario and project ID. If the project ID is missing but the name is present, the items are grouped by name. Records with both missing are considered unassociated projects. The sum of all items in the complete result equals the summary. Missing or blank log scenarios are classified as other. Scenarios with values but no configured mapping retain the original values as codes and display names, and are normally included in the total. If there are no records for other, no empty row is created.'),
  endTime?: string(name='EndTime', description='The actual end time of the query.', example='2026-10-20T02:00:00Z'),
  requestId?: string(name='RequestId', description='The request ID.', example='mock_req_success'),
  serviceId?: string(name='ServiceId', description='The SaaS service ID.', example='agdb-example'),
  startTime?: string(name='StartTime', description='The actual start time of the query.', example='2026-10-20T00:00:00Z'),
  summary?: {
    dataUnit?: string(name='DataUnit', description='The exact non-negative decimal string. Floating-point or exponential formats are not used. If the amount is incomplete, the value is null.', example='2.82'),
  }(name='Summary', description='The usage summary.'),
  timeSeries?: [ 
    {
      dataUnit?: string(name='DataUnit', description='The exact non-negative decimal string. Floating-point or exponential formats are not used. If the amount is incomplete, the value is null.', example='2.82'),
      scenes?: [ 
        {
          dataUnit?: string(name='DataUnit', description='The exact non-negative decimal string. Floating-point or exponential formats are not used. If the amount is incomplete, the value is null.', example='2.82'),
          projectId?: string(name='ProjectId', description='The project attribution at the time of the call. If missing, the value is null, which does not affect the total amount.', example='project-1'),
          projectName?: string(name='ProjectName', description='The project name. For the same scenario and project ID, the latest non-empty name snapshot within the query range is used. If multiple snapshots exist in the same second, the one with the maximum lexicographical value is used. If missing, the value is null.', example='Scenario remake'),
          usageScene?: string(name='UsageScene', description='The usage scenario code.', example='game_translation'),
        }
      ](name='Scenes', description='The scenario usage within the bucket.'),
      time?: string(name='Time', description='The start time of the UTC bucket.', example='2026-10-20T00:00:00Z'),
    }
  ](name='TimeSeries', description='The time trend. The items are sorted in ascending order of the UTC bucket start time. For a complete query, zero buckets are filled. If the amount is unknown, the value is null and is not replaced with zero.'),
  warnings?: [ 
    {
      code?: string(name='Code', description='The notice code. Valid values include DATA_INCOMPLETE and DATA_UNIT_PENDING.', example='DATA_INCOMPLETE'),
