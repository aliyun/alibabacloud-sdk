model UpsertChunksRequest {
  allowInsertWithFilter?: boolean(name='AllowInsertWithFilter', description='Specifies whether to allow data insertion when a filter is specified. This parameter takes effect only when the Filter parameter in TextChunks is specified.

If AllowInsertWithFilter is set to true, an insert operation is performed when the filter does not match any data.

If AllowInsertWithFilter is set to false, no operation is performed when the filter does not match any data.

Default value: true.', example='true', position='Query'),
  collection: string(name='Collection', description='The name of the document collection.

> The document collection is created by calling the [CreateDocumentCollection](https://help.aliyun.com/document_detail/2618448.html) operation. You can call the [ListDocumentCollections](https://help.aliyun.com/document_detail/2618452.html) operation to view the created document collections.

This parameter is required.', example='document', position='Query'),
  DBInstanceId: string(name='DBInstanceId', description='The instance ID.

> You can call the [DescribeDBInstances](https://help.aliyun.com/document_detail/86911.html) operation to query the details of all AnalyticDB for PostgreSQL instances in a specific region, including the instance IDs.

This parameter is required.', example='gp-xxxxxxxxx', position='Query'),
  fileName?: string(name='FileName', description='The file name.

> If this parameter is not empty, the system determines whether to overwrite the data associated with this file name based on the value of the ShouldReplaceFile parameter. If this parameter is empty, the chunk data is directly appended and uploaded to the document collection.', example='mydoc.txt', position='Query'),
  namespace?: string(name='Namespace', description='The namespace. Default value: public.

> You can call the [CreateNamespace](https://help.aliyun.com/document_detail/2401495.html) operation to create a namespace and call the [ListNamespaces](https://help.aliyun.com/document_detail/2401502.html) operation to view the namespace list.', example='mynamespace', position='Query'),
  namespacePassword: string(name='NamespacePassword', description='The password for the namespace.
> This value is specified in the [CreateNamespace](https://help.aliyun.com/document_detail/2401495.html) operation.

This parameter is required.', example='testpassword', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the instance.

This parameter is required.', example='cn-hangzhou', position='Query'),
  shouldReplaceFile?: boolean(name='ShouldReplaceFile', description='Specifies whether to overwrite the data associated with the specified file name. This parameter takes effect only when the FileName parameter is specified.

If ShouldReplaceFile is set to true, all data associated with the file name is deleted before new data is inserted.

If ShouldReplaceFile is set to false, the data associated with the file name is not deleted. Instead, chunks are inserted or updated based on the specific TextChunks parameter.

Default value: true.', example='true', position='Query'),
  textChunks?: [ 
    {
      content: string(name='Content', description='The document content.

This parameter is required.', example='AnalyticDB for PostgreSQL provides a simple, fast, and cost-effective PB-level cloud data warehousing solution.'),
