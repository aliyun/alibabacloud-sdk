  mergeMethodArgs?: {
    rrf?: {
      k?: long(name='K', description='The constant k in the score calculation formula 1/(k+rank_i). The value must be a positive integer greater than 1.', example='60'),
    }(name='Rrf', description='The configurable parameters when MergeMethod is set to RRF.'),
    weight?: {
      weights?: [ double ](name='Weights', description='The array of weights for each SourceCollection.'),
    }(name='Weight', description='The configurable parameters when MergeMethod is set to Weight.'),
  }(name='MergeMethodArgs', description='The parameters for the merge method of each SourceCollection.', shrink='json', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the instance.

This parameter is required.', example='cn-beijing', position='Query'),
  rerankFactor?: double(name='RerankFactor', description='The reranking factor. If this value is not empty, the vector retrieve results are reranked. Valid values: 1 < RerankFactor <= 5.
> - Reranking is slow when document chunks are sparse.
> - We recommend that the number of reranked items (TopK × Factor, rounded up) does not exceed 50.', example='2', position='Query'),
  rerankModel?: {
    instruct?: string(name='Instruct', description='This parameter can be set when RerankModel.Name is set to qwen3-rerank. Adds a custom description for the sorting task type. You can use this parameter to guide the model to adopt different sorting strategies.', example='Given a web search query, retrieve relevant passages that answer the query'),
    name?: string(name='Name', description='The name of the reranking model. Valid values: qwen3-rerank and gte-rerank-v2.', example='qwen3-rerank'),
  }(name='RerankModel', description='The parameters of the reranking model used to rerank the merged multi-channel results.', shrink='json', position='Query'),
  sourceCollection: [ 
    {
      collection: string(name='Collection', description='The name of the document collection.

> Created by the [CreateDocumentCollection](https://help.aliyun.com/document_detail/2618448.html) operation. You can call the [ListDocumentCollections](https://help.aliyun.com/document_detail/2618452.html) operation to view the created document collections.

This parameter is required.', example='knowledge22'),
      namespace?: string(name='Namespace', description='The namespace.

> You can call the [CreateNamespace](https://help.aliyun.com/document_detail/2401495.html) operation to create a namespace and the [ListNamespaces](https://help.aliyun.com/document_detail/2401502.html) operation to view the namespace list.', example='ns_cloud_index'),
      namespacePassword: string(name='NamespacePassword', description='The password for the namespace.

> This value is specified when you call the [CreateNamespace](https://help.aliyun.com/document_detail/2401495.html) operation.

This parameter is required.', example='ns_password'),
      queryParams?: {
        filter?: string(name='Filter', description='The filter condition for the data to be queried, in the SQL WHERE clause format. It is an expression that returns a Boolean value (true or false). The condition can be a simple comparison operator such as equal to (=), not equal to (<> or !=), greater than (>), less than (<), greater than or equal to (>=), or less than or equal to (<=). It can also be a more complex expression combined with logical operators (AND, OR, NOT), or a condition using keywords such as IN, BETWEEN, and LIKE.

> 
> - For detailed syntax, refer to https://www.postgresqltutorial.com/postgresql-tutorial/postgresql-where/.', example='id = \\\\"llm-52tvykqt6u67iw73_j6ovptwjk7_file_6ce3da1f7e69495d9f491f2180c86973_11967297\\\\"'),
        graphEnhance?: boolean(name='GraphEnhance', description='Specifies whether to enable knowledge graph enhancement. Default value: false.', example='true'),
        graphSearchArgs?: {
          graphTopK?: long(name='GraphTopK', description='The number of top entities and relationship edges to return. Default value: 60.', example='60'),
        }(name='GraphSearchArgs', description='The number of top entities and relationship edges to return. Default value: 60.'),
        hybridSearch?: string(name='HybridSearch', description='The multi-channel recall algorithm. Default value: empty, which means directly comparing and sorting the scores of dense vectors and full text. Valid values:

- RRF: Reciprocal Rank Fusion. A parameter k is used to control the fusion effect. For more information, see the HybridSearchArgs configuration.
- Weight: Weighted sorting. Parameters are used to control the score weights of vectors and full text before sorting. For more information, see the HybridSearchArgs configuration.
- Cascaded: Full-text retrieve is performed first, followed by vector retrieve based on the full-text retrieve results.', example='Cascaded'),
        hybridSearchArgs?: map[string]any(name='HybridSearchArgs', description='The algorithm parameters for multi-channel recall. Currently, RRF and Weight are supported. You can use HybridPathsSetting to specify the recall of dense vectors (dense), sparse vectors (sparse), and full-text index (fulltext). If this value is empty, dense vectors (dense) and full-text index (fulltext) are recalled by default.

- RRF: Specifies the constant k in the score calculation formula 1/(k+rank_i). The value must be a positive integer greater than 1. Format:
```
{
  "HybridPathsSetting": {
    "paths": "dense,fulltext"
  },
  "RRF": {
    "k": 60
  }
}
```

- Weight: 
   - Dual-channel recall (HybridPathsSetting is not specified, only alpha is specified):
      - Calculation formula: alpha * dense_score + (1-alpha) * fulltext_score. The alpha parameter represents the score weight of dense vectors and full-text index retrieve score. The value ranges from 0 to 1, where 0 indicates full-text index only and 1 indicates dense vectors only:
```
{ 
   "Weight": {
    "alpha": 0.5
   }
}
```
  - Triple-channel recall pattern:
     - Calculation formula: normalized_dense * dense_score + normalized_sparse * sparse_score + normalized_fulltext * fulltext_score. Here, dense, sparse, and fulltext represent the weights of dense vectors, sparse vectors, and full-text index, respectively. The value must be greater than or equal to 0. The system automatically performs normalization on the weights to 0 to 1 (that is, normalized_x = x / (dense + sparse + fulltext)).
```
{
  "HybridPathsSetting": {
     "paths": "dense,sparse,fulltext"
   },
  "Weight": {
    "dense": 0.5,
    "sparse": 0.3,
    "fulltext": 0.2
  }
}
```'),
        metrics?: string(name='Metrics', description='The method used to build the vector index. Valid values:
- l2: Euclidean distance.
- ip: Dot product (inner product) distance.
- cosine: Cosine similarity.', example='cosine'),
        offset?: int32(name='Offset', description='The offset used for paging in a paged query.', example='20'),
        orderBy?: string(name='OrderBy', description='The field based on which the results are sorted. Default value: empty.

The field must belong to metadata or be a default field in the table, such as id. Supported formats:

A single field, such as chunk_id.
Multiple fields separated by commas, such as block_id, chunk_id.
Descending order, such as block_id DESC, chunk_id DESC.', example='file_id,sort_num'),
        recallWindow?: [ long ](name='RecallWindow', description='The recall window. If this value is not empty, the context of the retrieval results is additionally returned. The format is an array of two elements: List<A, B>, where -10 <= A <= 0 and 0 <= B <= 10.
> - We recommend that you use this parameter when document chunks are too small and retrieval may lose context information.
> - Reranking takes precedence over windowing. That is, reranking is performed before windowing.', example='[0,0]'),
        rerankFactor?: double(name='RerankFactor', description='The reranking factor. If this value is not empty, the vector retrieve results are reranked. Valid values: 1 < RerankFactor <= 5.
> - Reranking is slow when document chunks are sparse.
> - We recommend that the number of reranked items (TopK × Factor, rounded up) does not exceed 50.', example='2.0'),
        rerankModel?: {
          instruct?: string(name='Instruct', description='This parameter can be set when RerankModel.Name is set to qwen3-rerank. Adds a custom description for the sorting task type. You can use this parameter to guide the model to adopt different sorting strategies.', example='Given a web search query, retrieve relevant passages that answer the query'),
          name?: string(name='Name', description='The name of the reranking model. Valid values: qwen3-rerank and gte-rerank-v2.', example='qwen3-rerank'),
          rerankMetadataFields?: string(name='RerankMetadataFields', description='The metadata fields that participate in reranking. Separate multiple fields with commas (,). By default, only the document content (content) is used for reranking. The field names must be defined in the metadata of the collection.', example='title'),
        }(name='RerankModel', description='The parameters of the reranking model.'),
        topK?: long(name='TopK', description='The number of top results to return.', example='776'),
        useFullTextRetrieval?: boolean(name='UseFullTextRetrieval', description='Specifies whether to use full-text retrieve (dual-channel recall). Default value: false, which indicates that only vector retrieve is used.', example='false'),
      }(name='QueryParams', description='The filter condition for the data to be updated, in the SQL WHERE clause format.'),
    }
  ](name='SourceCollection', description='The information about multiple collections to be retrieved.

This parameter is required.', shrink='json', position='Query'),
  topK?: long(name='TopK', description='The number of top results to return after multi-channel recall results are merged.', example='10', position='Query'),
}

