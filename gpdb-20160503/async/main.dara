model ChatWithKnowledgeBaseRequest {
  DBInstanceId: string(name='DBInstanceId', description='The instance ID.
> You can call the [DescribeDBInstances](https://help.aliyun.com/document_detail/196830.html) operation to query the details of all instances in the target region, including the instance IDs.

This parameter is required.', example='gp-xxxxxxxxx', position='Query'),
  includeKnowledgeBaseResults?: boolean(name='IncludeKnowledgeBaseResults', description='Specifies whether to return the recall results. Default value: false.', example='false', position='Query'),
  knowledgeParams?: {
    mergeMethod?: string(name='MergeMethod', description='The method used to merge multiple knowledge bases. Default value: RRF. Valid values:
- RRF
- Weight', example='"RRF"'),
    mergeMethodArgs?: {
      rrf?: {
        k?: long(name='K', description='The constant k in the score calculation formula 1/(k+rank_i). The value must be a positive integer greater than 1.', example='60'),
      }(name='Rrf', description='The configurable parameters when MergeMethod is set to RRF.'),
      weight?: {
        weights?: [ double ](name='Weights', description='The weight array for each SourceCollection.'),
      }(name='Weight', description='The configurable parameters when MergeMethod is set to Weight.'),
    }(name='MergeMethodArgs', description='The parameters for merging multiple knowledge bases.'),
    rerankFactor?: double(name='RerankFactor', description='The reranking factor. If this value is not empty, the vector retrieve results are reranked. Valid values: 1 < RerankFactor <= 5.
> - When documents are sparsely chunked, the reranking efficiency is low.
> - We recommend that the number of reranked items (TopK × Factor, rounded up) does not exceed 50.', example='1.0001'),
    rerankModel?: {
      instruct?: string(name='Instruct', description='Configurable when RerankModel.Name is set to qwen3-rerank. Adds a custom sorting task type description. You can use this parameter to guide the model to adopt different sorting strategies.', example='Given a web search query, retrieve relevant passages that answer the query'),
      name?: string(name='Name', description='The name of the reranking model. Valid values: qwen3-rerank and gte-rerank-v2.', example='qwen3-rerank'),
    }(name='RerankModel', description='The reranking model parameters.'),
    sourceCollection: [ 
      {
        collection: string(name='Collection', description='The name of the collection to be recalled.

This parameter is required.', example='adbpg_document_collection'),
        namespace?: string(name='Namespace', description='The namespace. Default value: public.

> You can call the [CreateNamespace](https://help.aliyun.com/document_detail/2401495.html) operation to create a namespace and call the [ListNamespaces](https://help.aliyun.com/document_detail/2401502.html) operation to view the namespace list.', example='dukang'),
        namespacePassword: string(name='NamespacePassword', description='The password corresponding to the namespace.

> This value is specified when you call the CreateNamespace operation.

This parameter is required.', example='namespacePasswd'),
        queryParams?: {
          filter?: string(name='Filter', description='The filter condition for the data to be updated, in the SQL WHERE format.', example='id = \\\\"llm-t87l87fxuhn56woc_8anu8j2d3f_file_e74635e2cc314e838543e724f6b3b1f2_10658020\\\\"'),
          graphEnhance?: boolean(name='GraphEnhance', description='Specifies whether to enable knowledge graph enhancement. Default value: false.', example='false'),
          graphSearchArgs?: {
            graphTopK?: long(name='GraphTopK', description='The top number of entities and relationship edges to return. Default value: 60.', example='60'),
          }(name='GraphSearchArgs', description='The top number of entities and relationship edges to return. Default value: 60.'),
          hybridSearch?: string(name='HybridSearch', description='The multi-channel recall algorithm. Default value: empty (which means directly comparing and sorting the scores of dense vectors and full text). Valid values:

- RRF: Reciprocal rank fusion. A parameter k is used to control the fusion effect. For details, see HybridSearchArgs.
- Weight: Weighted sorting. Parameters are used to control the score weights of vectors and full text before sorting. For details, see HybridSearchArgs.
- Cascaded: Full-text retrieve is performed first, followed by vector retrieve based on the results.', example='RRF'),
          hybridSearchArgs?: map[string]any(name='HybridSearchArgs', description='The algorithm parameters for multi-channel recall. RRF and Weight are supported. HybridPathsSetting can be used to specify the recall of dense vectors (dense), sparse vectors (sparse), and full-text retrieve (fulltext). If this value is empty, dense vectors (dense) and full-text retrieve (fulltext) are recalled by default.

- RRF: The constant k in the score calculation formula 1/(k+rank_i). The value must be a positive integer greater than 1. Format:
```
{
  "HybridPathsSetting": {
    "paths": "dense,fulltext"
  },
  "RRF": {
    "k": 60
  }
}
```

- Weight: 
   - Dual-channel recall (HybridPathsSetting is not specified, only alpha is specified):
      - Calculation formula: alpha * dense_score + (1-alpha) * fulltext_score. The alpha parameter represents the score weight of dense vectors and full-text retrieve. The value ranges from 0 to 1, where 0 indicates full-text retrieve only and 1 indicates dense vectors only:
```
{ 
   "Weight": {
    "alpha": 0.5
   }
}
```
  - Triple-channel recall pattern:
     - Calculation formula: normalized_dense * dense_score + normalized_sparse * sparse_score + normalized_fulltext * fulltext_score. dense, sparse, and fulltext represent the weights of dense vectors, sparse vectors, and full-text retrieve, respectively. The value must be greater than or equal to 0. The system automatically performs normalization on the weights to 0 to 1 (that is, normalized_x = x / (dense + sparse + fulltext)).
```
{
  "HybridPathsSetting": {
     "paths": "dense,sparse,fulltext"
   },
  "Weight": {
    "dense": 0.5,
    "sparse": 0.3,
