model CreateCollectionRequest {
  algorithm?: string(name='Algorithm', description='The vector index algorithm.

Valid values:
- hnswflat: HNSW index without quantization compression (default).
- novam: Graph index without quantization compression, suitable for high-performance scenarios such as real-time recommendation.
- novad: Partitioned index with rabitq quantization, suitable for large-scale, low-cost retrieval scenarios.', example='hnswflat', position='Query'),
  collection: string(name='Collection', description='The name of the collection to be created.

> The name must comply with the PostgreSQL object naming conventions.

This parameter is required.', example='document', position='Query'),
  DBInstanceId?: string(name='DBInstanceId', description='Instance ID of the instance.

> You can call the [DescribeDBInstances](https://help.aliyun.com/document_detail/86911.html) operation to query instance IDs of all AnalyticDB for PostgreSQL instances in the target region.', example='gp-bp152460513z****', position='Query'),
  dimension?: long(name='Dimension', description='The vector dimensions.

> If you specify this value, an index is built, and the length of Rows.Vector in the subsequent [UpsertCollectionData](https://help.aliyun.com/document_detail/2401493.html) operation for uploading vector data must be consistent with this value. If you do not specify this value, you can call the [CreateVectorIndex](https://help.aliyun.com/document_detail/2401499.html) operation later to build an index.', example='1024', position='Query'),
  externalStorage?: int32(name='ExternalStorage', description='Specifies whether to use mmap to build the HNSW index. Default value: 0. If the data does not need to be deleted and you have high requirements for the data upload speed, set this parameter to 1.

Valid values:
- 0: Build the index by using segment-page storage. This is the default value. In this mode, shared_buffers in PostgreSQL can be used for caching, and operations such as deletion and update are supported.
- 1: Build the index by using mmap. This mode does not support operations such as deletion and update.

>Notice: The ExternalStorage parameter is supported only in V6.0. It is not supported in V7.0.</notice>', example='0', position='Query'),
  fullTextRetrievalFields?: string(name='FullTextRetrievalFields', description='The fields used to retrieve data via full-text index. Separate multiple fields with commas (,). The fields must be keys defined in Metadata.', example='title,content', position='Query'),
  hnswEfConstruction?: string(name='HnswEfConstruction', description='The size of the candidate set when building the index by using the HNSW algorithm. The value must be greater than or equal to 2 × HNSW_M.

> Valid values:
>- AnalyticDB for PostgreSQL V6.0 instances: 40 to 4000.
>- AnalyticDB for PostgreSQL V7.0 instances: 4 to 1000. Default value: 64.', example='128', position='Query'),
  hnswM?: int32(name='HnswM', description='The maximum number of neighbors in the HNSW algorithm. The operation automatically sets this value based on the vector dimensions. Typically, you do not need to manually set this value.

> Valid values:
>- AnalyticDB for PostgreSQL V6.0 instances: 1 to 1000.
>- AnalyticDB for PostgreSQL V7.0 instances: 2 to 100. Default value: 16.

> Recommended settings based on vector dimensions:
>- Less than or equal to 384: 16.
>- Greater than 384 and less than or equal to 768: 32.
>- Greater than 768 and less than or equal to 1024: 64.
>- Greater than 1024: 128.', example='64', minimum=1, maximum=1000, position='Query'),
  managerAccount: string(name='ManagerAccount', description='The name of the administrator account that has the rds_superuser permission.

> You can call the [CreateAccount](https://help.aliyun.com/document_detail/2361789.html) operation to create an account.

This parameter is required.', example='testaccount', position='Query'),
  managerAccountPassword: string(name='ManagerAccountPassword', description='The password of the administrator account.

This parameter is required.', example='testpassword', position='Query'),
  metadata: string(name='Metadata', description='The metadata of the vector data, which is a JSON string in MAP format. The key represents the field name, and the value represents the data type.

> Supported data types:
> - For the list of data types, see [Data types](https://help.aliyun.com/document_detail/424383.html).
> - The money data type is not supported.

>Warning: The id, vector, to_tsvector, and source fields are reserved fields and cannot be used.</warning>

This parameter is required.', example='{"title":"text","content":"text","response":"int"}', position='Query'),
  metadataIndices?: string(name='MetadataIndices', description='The scalar index fields. Separate multiple fields with commas (,). The fields must be keys defined in Metadata.', example='title', position='Query'),
  metrics?: string(name='Metrics', description='The distance metric used to build the vector index. Valid values:
- l2: Euclidean distance.
- ip: Inner product.
- cosine: Cosine similarity.', example='cosine', position='Query'),
  namespace?: string(name='Namespace', description='The namespace.

> You can call the [CreateNamespace](https://help.aliyun.com/document_detail/2401495.html) operation to create a namespace, and call the [ListNamespaces](https://help.aliyun.com/document_detail/2401502.html) operation to view the namespace list.', example='mynamespace', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  parser?: string(name='Parser', description='The tokenizer used to retrieve data via full-text index. Default value: zh_cn.', example='zh_cn', position='Query'),
  pqEnable?: int32(name='PqEnable', description='Specifies whether to enable the Product Quantization (PQ) algorithm to accelerate the index. Enable this feature when the data volume exceeds 500,000. Valid values:
- 0: Disable.
- 1: Enable (default).', example='1', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the instance.

This parameter is required.', example='cn-hangzhou', position='Query'),
  sparseVectorIndexConfig?: {
    algorithm?: string(name='Algorithm', description='The vector index algorithm.

Valid values:
