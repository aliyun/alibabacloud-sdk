model CreateUserInvitationCodeRequest {
  endUserId?: string(name='EndUserId', description='The logon identifier (EndUserId) of a single user, used for compatibility with single-user creation. You must specify either this parameter or EndUserIds, but not both. If neither is specified, PARAMETER_MISSING is returned. If both are specified, PARAM_ERROR is returned.', example='user-001'),
  endUserIds?: [ string ](name='EndUserIds', description='The array of user logon identifiers (EndUserIds). You must specify either this parameter or EndUserId. You can specify 1 to 100 unique, non-empty strings at a time, and a code is generated for each user. If any user does not exist, USER_NOT_FOUND is returned. If the array is empty, or contains duplicate items, empty items, or non-string items, PARAM_ERROR is returned.'),
  terminalGroupId?: string(name='TerminalGroupId', description='The ID of the terminal group. The group must belong to the current account and must not be deleted. After the corresponding terminal uses the management code to complete management, it is added to this group. If the group does not exist, is deleted, or does not belong to the current account, TERMINAL_GROUP_NOT_FOUND is returned.

This parameter is required.', example='tg-example'),
  validityMinutes?: int32(name='ValidityMinutes', description='The validity period of the management code, in minutes. A value of -1 indicates that the code is permanently valid. For values between 60 and 1440, only integer multiples of 60 (1 to 24 hours) are allowed. For values greater than 1440, only integer multiples of 1440 are allowed, up to a maximum of 12960 (2 to 9 days). Other values return PARAM_ERROR. The server calculates the validity period based on this duration.

This parameter is required.', example='1440'),
}

model CreateUserInvitationCodeResponseBody = {
  code?: string(name='Code', description='The business error code. This field may be empty if the call is successful. If the call fails, a value such as PARAM_ERROR indicates that the parameter value is invalid.', example='PARAM_ERROR'),
  data?: [ 
    {
      bindTime?: string(name='BindTime', description='The binding time when the terminal uses the code to complete management. This field is empty for a newly created code because it is not yet bound to a terminal.', example='null'),
      endUserId?: string(name='EndUserId', description='The logon identifier (EndUserId) of the user corresponding to the management code.', example='user-001'),
      expireTime?: string(name='ExpireTime', description='The expiration time of the management code calculated by the server. This field is empty if the code is permanently valid. To determine whether the code has expired, use the Expired field.', example='null'),
      expired?: boolean(name='Expired', description='Indicates whether the code has expired as calculated by the server. A value of true indicates that the validity period has expired. A value of false indicates that the code has not expired or is permanently valid. This field is independent of the usage status in the Status field.'),
      gmtCreate?: string(name='GmtCreate', description='The creation time of the management code, generated by the server.', example='2026-10-15T08:00:00.000+00:00'),
      invitationCode?: string(name='InvitationCode', description='The generated eight-digit terminal management invitation code. It is processed as a string and leading zeros are preserved.', example='01234567'),
      platform?: string(name='Platform', description='The client type of the bound terminal. This field is empty for a newly created code because it is not yet bound to a terminal.', example='null'),
      status?: string(name='Status', description='The usage status of the management code. Valid values:
- ACTIVE: The code is unused.
- USED: The code is used.
The creation response returns ACTIVE. Expiration does not change the usage status. Use the Expired field to determine whether the code has expired.', example='ACTIVE'),
      terminalGroupId?: string(name='TerminalGroupId', description='The ID of the terminal group specified for the management code.', example='tg-example'),
      terminalGroupName?: string(name='TerminalGroupName', description='The display name of the terminal group. This creation operation does not populate this display field, so it may be empty in the creation response.', example='null'),
      userName?: string(name='UserName', description='The display name of the user. This creation operation does not populate this display field, so it may be empty in the creation response.', example='null'),
      uuid?: string(name='Uuid', description='The UUID of the terminal that uses the code to complete management. This field is empty for a newly created code because it is not yet bound to a terminal.', example='null'),
      validityMinutes?: int32(name='ValidityMinutes', description='The validity period of the management code, in minutes. The value is the same as the request value. A value of -1 indicates that the code is permanently valid.', example='1440'),
    }
  ](name='Data', description='The array of created management invitation code records. Each user corresponds to one record. An array is returned even for single-user creation.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code of the backend business response. A value of 200 indicates success. A value of 400 indicates parameter or business validation failure. A value of 500 indicates a system error.', example='200'),
  message?: string(name='Message', description='The business error message. This field may be empty if the call is successful. If the call fails, this field describes the cause of the error.', example='PARAM_ERROR'),
  requestId?: string(name='RequestId', description='The ID of the request, used to locate call logs and troubleshoot issues.', example='00000000-0000-4000-8000-000000000001'),
  success?: boolean(name='Success', description='Indicates whether the business processing is successful. A value of true indicates success. A value of false indicates failure.'),
}

model CreateUserInvitationCodeResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateUserInvitationCodeResponseBody(name='body'),
}

/**
 * @summary Creates dedicated terminal management invitation codes for one or more users under the current Alibaba Cloud account, generates an eight-digit code for each user, and uniformly specifies the terminal group and validity period.
 *
 * @description ## Usage notes
 * - Call this operation over HTTPS POST, sign the request with an AccessKey pair or STS credentials, and grant the ecd:CreateUserInvitationCode permission. You can only create management codes for users and terminal groups that belong to the Alibaba Cloud account of the caller identity.
 * - You must specify either EndUserIds or the single-user compatible parameter EndUserId. Batch requests support 1 to 100 users. An independent eight-digit management code is generated for each user. Empty items or duplicate users are not supported.
 * - Users in a single request share the same TerminalGroupId and ValidityMinutes. Repeated calls can create multiple different management codes for the same user.
 * - Both users and groups must already exist and belong to the current account. The group cannot be in a deleted state. After parameter and user validation passes, the entire batch is written. The system does not create codes user by user and return partial results.
 * - A management code is a terminal redemption credential. Provide it to the corresponding user only through trusted channels and avoid recording the complete code in public logs.
 * - The returned Data is always an array, even if only one code is created, in which case it is a single-element array. Creating a code does not mean that the terminal has completed management. A UUID and binding time are generated only after the device uses the code to complete management.
 * - Status indicates only the usage status: ACTIVE means unused, and USED means used. To determine whether a code has expired, refer to the Expired field returned by the server. The EXPIRED status is not used.
 * - This operation does not have a ClientToken parameter for business idempotence. Resending a creation request may generate a new management code. If you encounter uncertain results such as timeouts, check whether the code has been created before retrying unconditionally.
 *
 * @param request CreateUserInvitationCodeRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return CreateUserInvitationCodeResponse
 */
async function createUserInvitationCodeWithOptions(request: CreateUserInvitationCodeRequest, runtime: Util.RuntimeOptions): CreateUserInvitationCodeResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.endUserId)) {
    body['EndUserId'] = request.endUserId;
  }
  if (!Util.isUnset(request.endUserIds)) {
    body['EndUserIds'] = request.endUserIds;
  }
  if (!Util.isUnset(request.terminalGroupId)) {
    body['TerminalGroupId'] = request.terminalGroupId;
  }
  if (!Util.isUnset(request.validityMinutes)) {
    body['ValidityMinutes'] = request.validityMinutes;
  }
  var req = new OpenApi.OpenApiRequest{ 
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CreateUserInvitationCode',
    version = '2021-04-20',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

