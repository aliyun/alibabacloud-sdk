  * @return AddDnatEntryResponse
 */
async function addDnatEntry(request: AddDnatEntryRequest): AddDnatEntryResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddDnatEntry', 'POST', '/', 'json', false, 'json', request);
}

model AddSmartAccessGatewayDnsForwardRequest {
  domain: string(name='Domain', description='The domain name.
> 
>- Wildcard domain names and full match are supported. You can enter an asterisk (*) for the domain name to match all. Examples:
*.baidu.com. The allowed input format is baidu.com.

This parameter is required.', example='www.aliyun.com', position='Query'),
  masterIp: string(name='MasterIp', description='The primary DNS server.

This parameter is required.', example='114.114.114.114', position='Query'),
  mode?: string(name='Mode', description='The forwarding mode.

>- This field is invalid. You can ignore it.', example='first', position='Query'),
  outboundPortIndex?: string(name='OutboundPortIndex', description='The outbound port index.
>- This parameter is optional when OutboundPortType is set to PhysicalPort, and is not required when OutboundPortType is set to Tunnel.
>- OutboundPortIndex and OutboundPortName have a one-to-one mapping: 0 - eth0; 2 - lte.', example='0', position='Query'),
  outboundPortName?: string(name='OutboundPortName', description='The outbound port.
>- This parameter is optional when OutboundPortType is set to PhysicalPort, and is not required when OutboundPortType is set to Tunnel.
>- OutboundPortIndex and OutboundPortName have a one-to-one mapping: 0 - eth0; 2 - lte.', example='eth0', position='Query'),
  outboundPortType?: string(name='OutboundPortType', description='The outbound port type.
>- A value of Tunnel indicates a tunnel port, and a value of PhysicalPort indicates a physical port.', example='Tunnel', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the Smart Access Gateway instance.

This parameter is required.', example='cn-shanghai', position='Query'),
  sagInsId: string(name='SagInsId', description='The ID of the Smart Access Gateway instance.

This parameter is required.', example='sag-v9un1ccz22owd76lf8', position='Query'),
  sagSn: string(name='SagSn', description='The serial number of the device.

This parameter is required.', example='sagf4dkqh78', position='Query'),
  slaveIp?: string(name='SlaveIp', description='The secondary DNS server.', example='172.16.0.14', position='Query'),
}

