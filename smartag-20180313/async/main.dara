model AddACLRuleRequest {
  aclId: string(name='AclId', description='The ID of the access control instance.

This parameter is required.', example='acl-xhwhyuo43l0n*****', position='Query'),
  description?: string(name='Description', description='The description of the access control rule.

The description must be **1** to **512** characters in length.', example='desctest', position='Query'),
  destCidr: string(name='DestCidr', description='The destination CIDR block.

The destination CIDR block must be in CIDR format, such as 192.168.10.0/24.

This parameter is required.', example='192.168.10.0/24', position='Query'),
  destPortRange: string(name='DestPortRange', description='The destination port range.

Valid values: **-1** or **1** to **65535**.

The destination port range is in the format of 1/200 or 80/80. A value of -1/-1 specifies that all ports are allowed.

This parameter is required.', example='1/200', position='Query'),
  direction: string(name='Direction', description='The direction in which the access control rule is applied. Valid values:

- **in**: inbound. This value specifies traffic from external networks to the local branch where the Smart Access Gateway (SAG) instance is deployed.
- **out**: outbound. This value specifies traffic from the local branch where the SAG instance is deployed to external networks.

This parameter is required.', example='in', position='Query'),
  dpiGroupIds?: [ string ](name='DpiGroupIds', description='The IDs of the application groups that match the access control rule.

You can call the [ListDpiGroups](https://help.aliyun.com/document_detail/196754.html) operation to query application group IDs and the included application information. Maximum value of N: **10**.', example='20', position='Query'),
  dpiSignatureIds?: [ string ](name='DpiSignatureIds', description='The IDs of the applications that match the access control rule.

You can call the [ListDpiSignatures](https://help.aliyun.com/document_detail/196630.html) operation to query application IDs and the corresponding application information. Maximum value of N: **10**.', example='1', position='Query'),
  ipProtocol: string(name='IpProtocol', description='The protocol used by the access control rule.

For the protocol types supported by the access control feature, refer to the console. The protocol format is not case-sensitive.

This parameter is required.', example='tcp', position='Query'),
  name?: string(name='Name', description='The name of the access control rule.

The name must be 2 to 100 characters in length, and must start with a letter or a Chinese character. It can contain digits, periods (.), underscores (_), and hyphens (-).', example='doctest', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  policy: string(name='Policy', description='The authorization policy of the access control rule. Valid values:

- **accept**: Allows the traffic.

- **drop**: Denies the traffic.

This parameter is required.', example='accept', position='Query'),
  priority?: int32(name='Priority', description='The priority of the access control rule.

A smaller value indicates a higher priority. If multiple rules have the same priority, the rule that is first delivered to the Smart Access Gateway device takes effect first.

Valid values: **1** to **100**. Default value: **1**.', example='12', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the access control instance.

You can call the [DescribeRegions](https://help.aliyun.com/document_detail/69813.html) operation to query the region ID.

This parameter is required.', example='cn-shanghai', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  sourceCidr: string(name='SourceCidr', description='The source CIDR block.

The source CIDR block must be in CIDR format, such as 192.168.1.0/24.

This parameter is required.', example='192.168.20.0/24', position='Query'),
  sourcePortRange: string(name='SourcePortRange', description='The source port range.

Valid values: **-1** or **1** to **65535**.

The source port range is in the format of 1/200 or 80/80. A value of -1/-1 specifies that all ports are allowed.

This parameter is required.', example='1/200', position='Query'),
  type?: string(name='Type', description='The type of the access control rule. Valid values:

- **LAN**: private network. This is the default value. This value specifies that the access control rule is applied to traffic destined for private IP addresses.

- **WAN**: public network. This value specifies that the access control rule is applied to traffic destined for public IP addresses.', example='LAN', position='Query'),
}

model AddACLRuleResponseBody = {
  aclId?: string(name='AclId', description='The ID of the access control instance.', example='acl-xhwhyuo43l0*******'),
  acrId?: string(name='AcrId', description='The ID of the access control rule.', example='acr-c1hkd054qywi******'),
  description?: string(name='Description', description='The description of the access control rule.', example='test'),
  destCidr?: string(name='DestCidr', description='The destination CIDR block.

The destination CIDR block must be in CIDR format, such as 192.168.10.0/24.', example='192.168.10.0/24'),
  destPortRange?: string(name='DestPortRange', description='The destination port range.', example='1/65535'),
  direction?: string(name='Direction', description='The direction in which the access control rule is applied. Valid values:

- **in**: inbound. This value specifies traffic from external networks to the local branch where the Smart Access Gateway (SAG) instance is deployed.
- **out**: outbound. This value specifies traffic from the local branch where the SAG instance is deployed to external networks.', example='out'),
  dpiGroupIds?: {
    dpiGroupId?: [ string ](name='DpiGroupId')
  }(name='DpiGroupIds'),
  dpiSignatureIds?: {
    dpiSignatureId?: [ string ](name='DpiSignatureId')
  }(name='DpiSignatureIds'),
  gmtCreate?: long(name='GmtCreate', description='The timestamp when the access control rule was created.

The timestamp is of the Long type. If multiple rules have the same priority, the rule with the smaller timestamp takes effect first.', example='1553766882689'),
  ipProtocol?: string(name='IpProtocol', description='The protocol used by the access control rule.', example='TCP'),
  name?: string(name='Name', description='The name of the access control rule.', example='doctest'),
  policy?: string(name='Policy', description='The authorization policy of the access control rule.

- **accept**: Allows the traffic.

- **drop**: Denies the traffic.', example='drop'),
  priority?: int32(name='Priority', description='The priority of the access control rule.

A smaller value indicates a higher priority. If multiple rules have the same priority, the rule that is first delivered to the Smart Access Gateway device takes effect first.', example='1'),
  requestId?: string(name='RequestId', description='The request ID.', example='880F84CB-9B54-4413-A8A3-8832C82D1BC4'),
  sourceCidr?: string(name='SourceCidr', description='The source CIDR block.

The source CIDR block must be in CIDR format, such as 192.168.1.0/24.', example='192.168.20.0/24'),
  sourcePortRange?: string(name='SourcePortRange', description='The source port range.', example='1/65535'),
  type?: string(name='Type', description='The type of the access control rule.

- **LAN**: private network. This value specifies that the access control rule is applied to traffic destined for private IP addresses.

- **WAN**: public network. This value specifies that the access control rule is applied to traffic destined for public IP addresses.', example='LAN'),
}

model AddACLRuleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddACLRuleResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddACLRule  AddACLRuleRequest
  * @return AddACLRuleResponse
 */
async function addACLRule(request: AddACLRuleRequest): AddACLRuleResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddACLRule', 'POST', '/', 'json', false, 'json', request);
}

model AddDnatEntryRequest {
  externalIp?: string(name='ExternalIp', description='The external public IP address.
> If the DNAT type is Internet, the system automatically identifies the current public IP address. You do not need to specify this parameter.', example='10.10.1.xx', position='Query'),
  externalPort: string(name='ExternalPort', description='The public port.
Valid values: **1-65535**.

This parameter is required.', example='80', position='Query'),
  internalIp: string(name='InternalIp', description='The destination private IP address.

This parameter is required.', example='192.168.0.1', position='Query'),
  internalPort: string(name='InternalPort', description='The destination private port number.
Valid values: **1-65535**.

This parameter is required.', example='80', position='Query'),
  ipProtocol: string(name='IpProtocol', description='The protocol type. Valid values:
- **TCP**: forwards TCP packets.
- **UDP**: forwards UDP packets.
- **Any**: forwards packets of all protocols.

This parameter is required.', example='TCP', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  regionId: string(name='RegionId', description='The region ID of the Smart Access Gateway instance.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  sagId: string(name='SagId', description='The ID of the Smart Access Gateway instance.

> Currently, only hardware instances are supported.

This parameter is required.', example='sag-kdhg*******', position='Query'),
  type?: string(name='Type', description='The DNAT type. Valid values:
- **Intranet**: private network DNAT. This is the default value.
- **Internet**: public network DNAT.', example='Intranet', position='Query'),
}

model AddDnatEntryResponseBody = {
  dnatEntryId?: string(name='DnatEntryId', description='The DNAT entry ID.', example='fwd-kxe4fq3xuzczze****'),
  requestId?: string(name='RequestId', description='The request ID.', example='56BF6C79-C77D-41A0-86DD-A4B156E784EA'),
}

model AddDnatEntryResponse = {
