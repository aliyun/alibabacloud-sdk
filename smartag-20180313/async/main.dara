    mode?: string(name='Mode', description='The forwarding mode.', example='first'),
    outboundPortIndex?: int32(name='OutboundPortIndex', description='The outbound port index.', example='0'),
    outboundPortName?: string(name='OutboundPortName', description='The outbound port.', example='eth0'),
    outboundPortType?: string(name='OutboundPortType', description='The outbound port type.', example='PhysicalPort'),
    slaveIp?: string(name='SlaveIp', description='The secondary DNS server.', example='172.16.0.14'),
  }(name='Data', description='The business data.'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
