  hcInstanceId: string(name='HcInstanceId', description='The ID of the health check.

This parameter is required.', example='hc-k9id4loo3lup57****', position='Query'),
  name?: string(name='Name', description='The name of the health check.

The name must be 2 to 100 characters in length, and can contain letters, digits, periods (.), underscores (_), and hyphens (-). It must start with a letter.', example='sss333', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  probeCount?: int32(name='ProbeCount', description='The number of probes that are performed per health check.

Valid values: **1** to **20**.

Default value: **1**.', example='1', position='Query'),
  probeInterval?: int32(name='ProbeInterval', description='The time interval at which probes are performed. The next probe does not start before the current one is complete.

Valid values: **1000** to **60000**.

Default value: **2000**.

Unit: milliseconds.', example='2000', position='Query'),
  probeTimeout?: int32(name='ProbeTimeout', description='The timeout period of the probe.

Valid values: **10** to **30000**.

Default value: **3000**.

Unit: milliseconds.', example='3000', position='Query'),
