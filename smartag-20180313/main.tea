model ModifySagPortRoleRequest {
  ownerAccount?: string(name='OwnerAccount'),
  ownerId?: long(name='OwnerId'),
  portName?: string(name='PortName', description='The name of the port.

This parameter is required.', example='0'),
  regionId?: string(name='RegionId', description='The ID of the region where the Smart Access Gateway (SAG) instance is deployed.

