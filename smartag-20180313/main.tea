model AddACLRuleRequest {
  aclId?: string(name='AclId', description='The ID of the ACL.

This parameter is required.', example='acl-xhwhyuo43l0n*****'),
  description?: string(name='Description', description='The description of the ACL rule.

The description must be 1 to **512** characters in length.', example='desctest'),
  destCidr?: string(name='DestCidr', description='The destination CIDR block.

For example: 192.168.10.0/24.

This parameter is required.', example='192.168.10.0/24'),
  destPortRange?: string(name='DestPortRange', description='The destination port range.

Valid values: **-1** and **1** to **65535**.

Use the format 1/200 or 80/80. A value of -1/-1 means all ports.

This parameter is required.', example='1/200'),
  direction?: string(name='Direction', description='The direction of traffic to which the ACL rule applies. Valid values:

- **in**: inbound. Traffic from an external network to the local branch where the SAG instance is deployed.
- **out**: outbound. Traffic from the local branch where the SAG instance is deployed to an external network.

This parameter is required.', example='in'),
  dpiGroupIds?: [ string ](name='DpiGroupIds', description='A list of application group IDs. The ACL rule matches traffic of the specified application groups.

For more information, see [ListDpiGroups](https://help.aliyun.com/document_detail/196754.html). You can specify up to **10** application group IDs.', example='20'),
  dpiSignatureIds?: [ string ](name='DpiSignatureIds', description='A list of application IDs. The ACL rule matches traffic of the specified applications.

For more information, see [ListDpiSignatures](https://help.aliyun.com/document_detail/196630.html). You can specify up to **10** application IDs.', example='1'),
  ipProtocol?: string(name='IpProtocol', description='The protocol to which the ACL rule applies.

For a list of supported protocols, see the console. The protocol is not case-sensitive.

This parameter is required.', example='tcp'),
  name?: string(name='Name', description='The name of the ACL rule.

The name must be 2 to 100 characters in length, start with a letter, and can contain digits, periods (.), underscores (_), and hyphens (-).', example='doctest'),
  ownerAccount?: string(name='OwnerAccount'),
  ownerId?: long(name='OwnerId'),
  policy?: string(name='Policy', description='The authorization policy of the ACL rule. Valid values:

- **accept**: allows access.
- **drop**: denies access.

This parameter is required.', example='accept'),
  priority?: int32(name='Priority', description='The priority of the ACL rule.

A smaller value indicates a higher priority. If multiple rules have the same priority, the rule that is first delivered to the Smart Access Gateway device takes precedence.

Valid values: 1 to **100**. Default value: **1**.', example='12'),
  regionId?: string(name='RegionId', description='The ID of the region where the access control list (ACL) is located.

For more information, see [DescribeRegions](https://help.aliyun.com/document_detail/69813.html).

This parameter is required.', example='cn-shanghai'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount'),
  resourceOwnerId?: long(name='ResourceOwnerId'),
  sourceCidr?: string(name='SourceCidr', description='The source CIDR block.

For example: 192.168.1.0/24.

This parameter is required.', example='192.168.20.0/24'),
  sourcePortRange?: string(name='SourcePortRange', description='The source port range.

Valid values: **-1** and **1** to **65535**.

Use the format 1/200 or 80/80. A value of -1/-1 means all ports.

This parameter is required.', example='1/200'),
  type?: string(name='Type', description='The type of the ACL rule. Valid values:

- **LAN**: (Default) private network. The ACL rule controls traffic on private networks.
- **WAN**: public network. The ACL rule controls traffic on public networks.', example='LAN'),
}

