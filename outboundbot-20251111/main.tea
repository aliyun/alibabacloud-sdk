    nluAccessType?: string(name='NluAccessType', example='MANAGED'),
    omniModel?: boolean(name='OmniModel', example='true'),
  }(name='ScriptProfile', description='话术配置'),
  sourceVersionId?: string(name='SourceVersionId', description='源版本ID', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b26'),
