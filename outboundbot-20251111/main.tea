model CreateScriptVersionRequest {
  instanceId?: string(name='InstanceId', description='实例ID', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b04'),
  interactionConfig?: {
    backgroundMusicId?: string(name='BackgroundMusicId', example='office-ambience'),
    bargeInConfig?: {
      closingBargeInEnabled?: boolean(name='ClosingBargeInEnabled', example='true'),
      globalBargeInEnabled?: boolean(name='GlobalBargeInEnabled', example='true'),
      openingBargeInEnabled?: boolean(name='OpeningBargeInEnabled', example='true'),
    }(name='BargeInConfig'),
    endConversationConfig?: {
      bargeInEnabled?: boolean(name='BargeInEnabled', example='true'),
      delay?: int32(name='Delay', example='1'),
      triggers?: [ 
        {
          closingStatement?: string(name='ClosingStatement', example='感谢您的接听，祝您生活愉快，再见!'),
          keywords?: [ string ](name='Keywords'),
          triggerType?: string(name='TriggerType', example='TurnLimit'),
          turnLimit?: int32(name='TurnLimit', example='20'),
        }
      ](name='Triggers'),
    }(name='EndConversationConfig'),
    initialGreetingDelayMilliseconds?: int32(name='InitialGreetingDelayMilliseconds', example='2000'),
    silenceDetectionConfig?: {
      fallbackControlParamsList?: [ 
        {
          type?: string(name='Type', example='HangUp'),
        }
      ](name='FallbackControlParamsList'),
      maxRepeats?: int32(name='MaxRepeats', example='3'),
      prompt?: string(name='Prompt', example='- 复述上一轮对话的内容
- 保证上下文自然衔接'),
      timeout?: int32(name='Timeout', example='5000'),
    }(name='SilenceDetectionConfig'),
    transitionConfig?: {
      aiPhrasePrompt?: string(name='AiPhrasePrompt', example='请根据下面对话记录中用户的最新回复，生成一句简短承接语，用于客服自然、顺畅地衔接对话，要求如下：
1. 使用客服场景常用的口语化表达，保持语气自然、礼貌且中立......'),
      fixedPhraseList?: [ string ](name='FixedPhraseList'),
      phraseSource?: string(name='PhraseSource', example='aiGenerated'),
      transitionSwitch?: boolean(name='TransitionSwitch', example='true'),
    }(name='TransitionConfig'),
  }(name='InteractionConfig', description='交互配置'),
  labelConfigs?: [ 
    {
      candidateValues?: [ string ](name='CandidateValues'),
      description?: string(name='Description', example='描述用户对本次服务是否满意'),
      name?: string(name='Name', example='满意度'),
    }
  ](name='LabelConfigs', description='草稿版本的标签配置（JSON字符串）'),
  scriptId?: string(name='ScriptId', description='场景ID', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b15'),
  scriptProfile?: {
    agentKey?: string(name='AgentKey', example='1309723684579735_p_beebot_public'),
