model CreateScriptVersionRequest {
  instanceId?: string(name='InstanceId', description='The instance ID.', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b04'),
  interactionConfig?: {
    backgroundMusicId?: string(name='BackgroundMusicId', description='The background music ID.', example='office-ambience'),
    bargeInConfig?: {
      closingBargeInEnabled?: boolean(name='ClosingBargeInEnabled', description='Specifies whether barge-in is supported during the closing statement.', example='true'),
      globalBargeInEnabled?: boolean(name='GlobalBargeInEnabled', description='Specifies whether barge-in is supported during the conversation.', example='true'),
      openingBargeInEnabled?: boolean(name='OpeningBargeInEnabled', description='Specifies whether barge-in is supported during the opening greeting.', example='true'),
    }(name='BargeInConfig', description='The barge-in configuration.'),
    endConversationConfig?: {
      bargeInEnabled?: boolean(name='BargeInEnabled', description='Specifies whether barge-in is supported during the delayed hang-up waiting period.', example='true'),
      delay?: int32(name='Delay', description='The number of seconds to wait after the closing statement is played before executing the hang-up action. Valid values: 0 to 5.', example='1'),
      triggers?: [ 
        {
          closingStatement?: string(name='ClosingStatement', description='The closing statement played when hanging up after reaching the turn limit.', example='Thank you for your time. Have a great day. Goodbye!'),
          keywords?: [ string ](name='Keywords', description='The list of custom interception keywords.'),
          triggerType?: string(name='TriggerType', description='Valid values:

- TurnLimit: maximum number of interaction turns.
- IntelligentVoiceAssistant: voice assistant.
- InteractiveVoiceResponse: extension transfer.
- KeyWords: custom interception.', example='TurnLimit'),
          turnLimit?: int32(name='TurnLimit', description='Hangs up when the number of interaction turns exceeds x. Valid values: 0 to 100. A value of 0 indicates that the turn limit hang-up is disabled.', example='20'),
        }
      ](name='Triggers', description='The special condition interception settings.'),
    }(name='EndConversationConfig', description='The hang-up configuration.'),
    initialGreetingDelayMilliseconds?: int32(name='InitialGreetingDelayMilliseconds', description='The delay in milliseconds before playing audio after the call is connected.', example='2000'),
    silenceDetectionConfig?: {
      fallbackControlParamsList?: [ 
        {
          type?: string(name='Type', description='The action to perform during consecutive silence.', example='HangUp'),
        }
      ](name='FallbackControlParamsList', description='The list of actions to perform during consecutive silence.'),
      maxRepeats?: int32(name='MaxRepeats', description='The number of consecutive silence rounds before hanging up.', example='3'),
      prompt?: string(name='Prompt', description='The silence prompt.', example='- Repeat the content of the previous conversation round'),
      timeout?: int32(name='Timeout', description='The silence timeout period, in milliseconds.\\\\
When the user remains silent for longer than the specified value, the silence timeout prompt is played.\\\\
Valid range: 2000 to 10000.', example='5000'),
    }(name='SilenceDetectionConfig', description='The silence detection configuration.'),
    transitionConfig?: {
      aiPhrasePrompt?: string(name='AiPhrasePrompt', description='The model generation prompt.', example='Based on the user\\\\"s latest reply in the conversation history below, generate a brief transitional phrase for the customer service agent to naturally and smoothly connect the dialogue. Requirements are as follows:
1. Use colloquial expressions common in customer service scenarios, maintaining a natural, polite, and neutral tone......'),
      fixedPhraseList?: [ string ](name='FixedPhraseList', description='The list of fixed transition phrases.'),
      phraseSource?: string(name='PhraseSource', description='The method for generating transition phrases.', example='aiGenerated'),
      transitionSwitch?: boolean(name='TransitionSwitch', description='Specifies whether to enable transition phrases.', example='true'),
    }(name='TransitionConfig', description='The transition phrase model configuration.'),
  }(name='InteractionConfig', description='The interaction configuration.'),
  labelConfigs?: [ 
    {
      candidateValues?: [ string ](name='CandidateValues', description='The candidate values for the label.'),
      description?: string(name='Description', description='The description.', example='Describes whether the user is satisfied with the service'),
      name?: string(name='Name', description='The label name.', example='Satisfaction'),
    }
  ](name='LabelConfigs', description='The label configurations.'),
  scriptId?: string(name='ScriptId', description='The scenario ID.', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b15'),
  scriptProfile?: {
    agentKey?: string(name='AgentKey', description='The chatbot AgentKey.', example='1309723684579735_p_beebot_public'),
    agentProfile?: {
      promptsJson?: string(name='PromptsJson', description='The prompt JSON.', example='{\\\\"prompts\\\\":\\\\"I am a chatbot.\\\\"}'),
      scriptProfileTemplateId?: string(name='ScriptProfileTemplateId', description='The scenario template ID.', example='OUTBOUND_BOT_PROMPTS_DEFAULT'),
    }(name='AgentProfile', description='The dialogue agent configuration.'),
    builderType?: string(name='BuilderType', description='The chatbot type.', example='LITE'),
    chatbotId?: string(name='ChatbotId', description='The chatbot ID.', example='chatbot-cn-MQuyjjb666'),
    functionMeta?: {
      functionId?: string(name='FunctionId', description='The function service ID.', example='9b752bbb-805a-4d3e-9013-eab5555c3fef'),
      functionName?: string(name='FunctionName', description='The function service name.', example='my_funciton'),
      httpTriggerName?: string(name='HttpTriggerName', description='The function trigger name.', example='defaultTrigger'),
      httpTriggerUrl?: string(name='HttpTriggerUrl', description='The function trigger URL.', example='http://chat-xxxxx-v-yewiundukb.cn-hangzhou-xxx.run'),
      regionId?: string(name='RegionId', description='The region where the function service resides.', example='cn-hangzhou'),
    }(name='FunctionMeta', description='The Function Compute configuration.'),
    model?: string(name='Model', description='The dialogue model.', example='qwen-plus'),
    nluAccessProfile?: {
      accessProfileId?: string(name='AccessProfileId', description='The third-party dialogue model configuration ID.', example='c2c9baae-9351-4c49-a8cb-6f24a83a8718'),
