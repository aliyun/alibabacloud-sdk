model DialogueRequest {
  extras?: string(name='Extras', description='The JSON array string of additional input events. Supports DTMF key press events (dataType=DTMF, dtmf is the key content), Silence events (dataType=Silence), and RuntimePrompts events (dataType=RuntimePrompts, prompts is the prompt text, persistent specifies whether to persist). For example, a silence event is [{"dataType":"Silence"}]. This parameter is optional when no additional events are present.', example='[{"dataType":"Silence"}]', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an instance that the invoker has permission to access and that actually exists. It must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The ID of the conversation scenario under the instance. Specify an existing scenario. Subsequent conversations and end requests for the same text session must use the scenario specified when the session was initiated.', example='script-example-001', position='Query'),
  sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text session, it is the text- identifier returned when the session is initiated. For web voice, it is the ws- identifier. For real number outbound call tests, it is the test- identifier. Subsequent calls must use the actual returned value.', example='text-11111111-2222-4333-8444-555555555555', position='Query'),
  utterance?: string(name='Utterance', description='The text input content of the user for the current round. For normal conversations, pass the actual text of the user. Events such as key presses or silence can be passed through Extras. The processing method is determined by the scenario and the engine.', example='I would like to inquire about the business handling process', position='Query'),
}

model DialogueResponseBody = {
  code?: string(name='Code', description='The business processing status code. OK indicates success. When an exception occurs, the corresponding business error code is returned. The error types and mapping rules follow the current API configuration. No error codes are added or modified in this operation.', example='OK'),
  data?: {
    answer?: string(name='Answer', description='The robot reply text in the current streaming event. It may be returned across multiple SSE events, or it may be empty in the end event or debug event. Do not equate the absence of text with session failure. Whether the content is incremental or cumulative is determined by the output convention of the conversation engine. The current general callback directly forwards the engine content.', example='Sure, let me introduce the handling process to you'),
    controlParamsList?: [ 
      {
        type?: string(name='Type', description='The values declared in the control instruction type include Voice (voice reply), HangUp (hang up), Transfer (transfer), GatherDtmf (collect key presses), and SendSms (send SMS). This update supplements the previously omitted SendSms without changing the backend structure or runtime enumeration constraints.', example='Voice'),
      }
    ](name='ControlParamsList', description='The robot control instructions attached to this reply. The current POP structure only expands the instruction Type and does not add other instruction fields in this document. When no control instruction is generated, the text service supplements a Voice type instruction.', example='[{"Type":"Voice"}]'),
    endTime?: long(name='EndTime', description='The UNIX timestamp of the current streaming reply callback event, in milliseconds. It is generated based on the current callback time. It may also be returned when StreamEnd is false. It should not be directly interpreted as the end time of the entire session or call.', example='1794560400123'),
    extras?: {
      debugInfo?: string(name='DebugInfo', description='The debug information returned by the conversation engine, which is a JSON string. It is returned only when the engine provides and obtains the debug information, and may be returned with supplementary events after the reply ends. The internal structure is determined by the engine. The example empty object string does not declare any fixed debug fields.', example='{}'),
    }(name='Extras', description='The extension information object attached to the robot reply, which is different from the JSON event array of the request parameter Extras. The current POP expands the DebugInfo field. Whether it is actually returned depends on the engine used and the current round of reply.', example='{"DebugInfo":"{}"}'),
    sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text session, it is the text- identifier returned when the session is initiated. For web voice, it is the ws- identifier. For real number outbound call tests, it is the test- identifier. Subsequent calls must use the actual returned value.', example='text-11111111-2222-4333-8444-555555555555'),
    startTime?: long(name='StartTime', description='The UNIX timestamp recorded when the streaming reply callback is entered for the first time in the current round, in milliseconds. Subsequent events in the current round use this time. It is not the session creation time, nor is it an update time in the general sense.', example='1794560400000'),
    streamEnd?: boolean(name='StreamEnd', description='Indicates whether the streaming output of the current reply round has ended. A value of true indicates that the streaming output has ended and the service has completed the corresponding SSE response. A value of false indicates that there may still be subsequent events in the current round. This field does not indicate that the entire session or voice call has ended.', example='true'),
    streamId?: string(name='StreamId', description='The ID of the conversation round to which the current robot reply belongs. A single round of reply may contain multiple streaming events. The text session context starts from 0 and increments upon subsequent Dialogue calls. The actual value returned by the engine shall prevail.', example='1'),
  }(name='Data', description='The robot reply, round ID, time, and control instructions carried by the current SSE event. A single round may contain multiple events.', example='{"Answer":"Sure, let me introduce the handling process to you.","StreamEnd":true,"SessionId":"text-11111111-2222-4333-8444-555555555555","StreamId":"1","StartTime":1794560400000,"EndTime":1794560400123,"ControlParamsList":[{"Type":"Voice"}],"Extras":{"DebugInfo":"{}"}}'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A normal return is 200. To determine whether the business operation is successful, you must also check Code. You cannot determine that the call is successful solely based on the presence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error description. It is usually empty or not returned upon success. A fixed text cannot be required upon success. Upon failure, it provides an error description to assist in troubleshooting. Combine it with Code and Params to understand the cause of the error. The example shows an error message when the instance does not exist (corresponding to the Code NotExists.InstanceId) and is for format reference only.', example='Instance instance-example-001 does not exist.'),
  params?: [ string ](name='Params', description='The parameter list used for the localized display of error messages. It is not a scenario variable or business result. A normal successful response is usually an empty array. When an error occurs, parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to associate and troubleshoot this POP request. The value in the response corresponds to the current request. System request parameters are injected by the gateway, and the caller does not need to fill in the system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

model DialogueResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DialogueResponseBody(name='body'),
}

/**
  * @description Sends a round of user input to a text session created by BeginSession and returns the robot reply and control instructions in Server-Sent Events (SSE) format. The InstanceId, ScriptId, and SessionId must be consistent with those used when the session was initiated. The SessionId must use the value returned by the session initiation operation. The conversation cannot continue if the session context does not exist. Utterance is used for plain text input, and Extras is used to pass structured events such as key presses and silence. You can call this operation multiple times in succession. StreamId identifies the reply round, and StreamEnd=true indicates that the output of the current round has ended. Call EndSession after the entire interaction is completed. The resource identifiers, numbers, and authentication credentials in the examples are desensitized or placeholder values. Use actual resources and service return values for actual calls.
  * @param request  the request parameters of Dialogue  DialogueRequest
  * @return DialogueResponse
 */
async function dialogue(request: DialogueRequest): DialogueResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'Dialogue', 'POST', '/', 'json', false, 'json', request);
}

function dialogueWithResponseIterable(request: DialogueRequest): iterator[DialogueResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'Dialogue', 'POST', '/', 'json', false, 'json', request);
}

