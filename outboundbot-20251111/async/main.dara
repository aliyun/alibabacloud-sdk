model TrialDialogueRequest {
  extras?: string(name='Extras', description='The JSON array string of additional input events. Supports DTMF key press events (dataType=DTMF, where dtmf is the key content), silence events (dataType=Silence), and runtime prompt events (dataType=RuntimePrompts, where prompts is the prompt text and persistent specifies whether to persist the prompts). For example, a silence event is [{"dataType":"Silence"}]. If no additional events exist, you can leave this parameter empty.', example='[{"dataType":"Silence"}]', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity of the product. You must use an existing instance that you have access to when you invoke the service. The instance must be the same as the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The ID of the conversation scenario under the instance. Specify an existing scenario. Subsequent conversations and end requests for the same text conversation must use the scenario specified when the conversation was started.', example='script-example-001', position='Query'),
  sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text conversation, it is the text- identifier returned when the conversation is started. For web voice, it is the ws- identifier. For real number outbound call tests, it is the test- identifier. Subsequent calls must use the actual return value.', example='text-11111111-2222-4333-8444-555555555555', position='Query'),
  utterance?: string(name='Utterance', description='The text input content of the user for the current turn. For normal conversations, pass the actual text of the user. Events such as key presses or silence can be passed through Extras. The processing method is determined by the scenario and engine.', example='I would like to ask about the business handling process', position='Query'),
  visitorToken: string(name='VisitorToken', description='The visitor token obtained from the experience link, used to locate the trial channel and verify access permissions and validity period. The token is generated by the channel service and should not be constructed manually. It cannot be empty and must still be within its validity period. The example is a placeholder value that cannot be used for authentication. Do not disclose the actual token to unrelated personnel.

This parameter is required.', example='example-visitor-token', position='Query'),
}

model TrialDialogueResponseBody = {
  code?: string(name='Code', description='The business processing status code. OK indicates success. When an exception occurs, the corresponding business error code is returned. The error types and mapping rules follow the current API configuration, and no error codes are added or modified in this update.', example='OK'),
  data?: {
    answer?: string(name='Answer', description='The robot reply text in the current streaming event. It may be returned across multiple SSE events, or it may be empty in the end event or debug event. Do not equate missing text with session failure. Whether the content is incremental or cumulative is determined by the output convention of the dialogue engine. The current general callback directly forwards the engine content.', example='Sure, let me introduce the handling process to you'),
    controlParamsList?: [ 
      {
        type?: string(name='Type', description='The values declared in the control command type include Voice (voice reply), HangUp (hang up), Transfer (transfer), GatherDtmf (collect key presses), and SendSms (send SMS). This update supplements SendSms, which was omitted in the original description, without changing the backend structure or runtime enumeration constraints.', example='Voice'),
      }
    ](name='ControlParamsList', description='The robot control commands attached to this reply. The current POP structure only expands the command Type and does not add other command fields in this document. When no control commands are generated, the text service supplements a Voice type command.', example='[{"Type":"Voice"}]'),
    endTime?: long(name='EndTime', description='The UNIX timestamp of the current streaming reply callback event, in milliseconds. It is generated based on the current callback time. It may also be returned when StreamEnd=false, and should not be directly interpreted as the end time of the entire conversation or call.', example='1794560400123'),
    extras?: {
      debugInfo?: string(name='DebugInfo', description='The debug information returned by the dialogue engine as a JSON string. It is returned only when the engine provides the debug information, and may be returned with supplementary events after the reply ends. The internal structure is determined by the engine. The example empty object string does not declare any fixed debug fields.', example='{}'),
    }(name='Extras', description='The extended information object attached to the robot reply, which is different from the JSON event array of the request parameter Extras. The current POP expands the DebugInfo field. Whether it is actually returned depends on the engine used and the current turn of reply.', example='{"DebugInfo":"{}"}'),
    sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text conversation, it is the text- identifier returned when the conversation is started. For web voice, it is the ws- identifier. For real number outbound call tests, it is the test- identifier. Subsequent calls must use the actual return value.', example='text-11111111-2222-4333-8444-555555555555'),
    startTime?: long(name='StartTime', description='The UNIX timestamp recorded when the streaming reply callback is entered for the first time in this turn, in milliseconds. Subsequent events in this turn use this time. It is not the session creation time, nor is it an update time in the general sense.', example='1794560400000'),
    streamEnd?: boolean(name='StreamEnd', description='Indicates whether the streaming output for the current reply turn has ended. A value of true indicates that the streaming output has ended and the service has completed the corresponding SSE response. A value of false indicates that there may still be subsequent events in this turn. This field does not indicate that the entire conversation or voice call has ended.', example='true'),
    streamId?: string(name='StreamId', description='The ID of the conversation turn to which this robot reply belongs. The same turn of reply can contain multiple streaming events. The text conversation context starts from 0 and increments during subsequent Dialogue calls. The actual return value of the engine shall prevail.', example='1'),
  }(name='Data', description='The robot reply, turn ID, time, and control commands carried by the current SSE event. A single turn may have multiple events.', example='{"Answer":"Sure, let me introduce the handling process to you.","StreamEnd":true,"SessionId":"text-11111111-2222-4333-8444-555555555555","StreamId":"1","StartTime":1794560400000,"EndTime":1794560400123,"ControlParamsList":[{"Type":"Voice"}],"Extras":{"DebugInfo":"{}"}}'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A normal return is 200. To determine whether the business is successful, you should also check Code. You cannot determine that the call is successful solely based on the presence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error description. It is usually empty or not returned upon success, and you cannot require a fixed text to be returned upon success. Upon failure, it is an error description used to assist troubleshooting, and should be combined with Code and Params to understand the cause of the error. The example is an error message when the experience link visitor token expires (corresponding to Code Expired.VisitorToken), and is for format reference only.', example='VisitorToken: example-visitor-token is expired.'),
  params?: [ string ](name='Params', description='The list of parameters used for the localized display of error messages, which are not scenario variables or business results. A normal successful response is usually an empty array. When an error occurs, parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to associate and troubleshoot this POP request. The value in the response corresponds to this request. System request parameters are injected by the gateway, and the caller does not need to fill in system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

