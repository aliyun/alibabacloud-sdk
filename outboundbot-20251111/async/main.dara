model CreateCampaignRequest {
  attemptOrder?: string(name='AttemptOrder', description='呼叫执行顺序，默认MIN_ATTEMPT_FIRST', example='MIN_ATTEMPT_FIRST', position='Query'),
  callableTime: string(name='CallableTime', description='可执行时间（每日可外呼时间段）

This parameter is required.', example='[{"beginTime":"09:00:00","endTime":"18:00:00" }]。', position='Query'),
  caseFileKey?: string(name='CaseFileKey', description='case文件的OSS Key，通过文件方式导入名单时使用', example='cases/customer.csv', position='Query'),
  cases?: [ 
    {
      customVariables?: string(name='CustomVariables', description='自定义变量，JSON字符串，用于话术中的变量替换', example='{"key1":"value1"}'),
      phoneNumber?: string(name='PhoneNumber', description='被叫号码', example='133********'),
      priority?: string(name='Priority', description='名单外呼优先级', example='1'),
      referenceId?: string(name='ReferenceId', description='名单的外部业务关联ID，用于回调时关联业务数据', example='bizId-1'),
    }
  ](name='Cases', description='外呼名单（case）列表，与CaseFileKey二选一', shrink='json', position='Body'),
  dialingTimeoutSeconds?: int32(name='DialingTimeoutSeconds', description='外呼超时时间（秒），默认25', example='25', position='Query'),
  endTime: long(name='EndTime', description='计划结束时间

This parameter is required.', example='1579965079000', position='Query'),
  fixedQuota?: int32(name='FixedQuota', description='固定并发数', example='0', position='Query'),
  flashSmsParameters?: string(name='FlashSmsParameters', description='闪信参数（JSON字符串，示例: {"applicationId":"xxx","templateId":"yyy"}）', example='{}', position='Query'),
  holidayRestricted?: boolean(name='HolidayRestricted', description='节假日禁止外呼', example='false', position='Query'),
  instanceId: string(name='InstanceId', description='外呼实例ID

This parameter is required.', example='12f3dd08-0c55-44ce-9b64-e69d35ed3a76', position='Query'),
  maxAttemptCount: int32(name='MaxAttemptCount', description='最大重试次数

This parameter is required.', example='2', position='Query'),
  minAttemptInterval: int32(name='MinAttemptInterval', description='最小重试间隔

This parameter is required.', example='5', position='Query'),
  name: string(name='Name', description='外呼活动名称

This parameter is required.', position='Query'),
  numbers?: [ string ](name='Numbers', description='主叫号码列表', shrink='json', position='Query'),
  redialRestrictions?: string(name='RedialRestrictions', description='外呼尝试限制条件列表', position='Query'),
  runUntilEndTime?: boolean(name='RunUntilEndTime', description='联系人均拨打完成时是否持续执行至活动结束时间', example='false', position='Query'),
  scriptId: string(name='ScriptId', description='IVR流程ID

This parameter is required.', example='aa279896-64a6-4182-864c-4f2b04ec8d17', position='Query'),
  startTime: long(name='StartTime', description='计划开始时间

This parameter is required.', example='1578965079000', position='Query'),
  weight?: int32(name='Weight', description='活动权重', example='50', position='Query'),
}

