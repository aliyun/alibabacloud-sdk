model BeginSessionRequest {
  draftVersion?: boolean(name='DraftVersion', description='Specifies whether to use the draft version.', example='false', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity.', example='instance-example-001', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The scenario ID.', example='script-example-001', position='Query'),
  vendorParams?: string(name='VendorParams', description='The accompanying variables for the scenario.', example='{"city":"Tangshan"}', position='Query'),
}

model BeginSessionResponseBody = {
  code?: string(name='Code', description='The business status code.', example='OK'),
  data?: {
    answer?: string(name='Answer', description='The reply content from the robot.', example='Hello, how can I help you?'),
    controlParamsList?: [ 
      {
        type?: string(name='Type', description='The type of the control instruction.', example='Voice'),
      }
    ](name='ControlParamsList', description='The list of robot control instructions.', example='[{"Type":"Voice"}]'),
    endTime?: long(name='EndTime', description='The time when the current reply event is sent.', example='1794560400123'),
    extras?: {
      debugInfo?: string(name='DebugInfo', description='The debug information of the conversation.', example='{}'),
    }(name='Extras', description='The extended information of the reply.', example='{"DebugInfo":"{}"}'),
    sessionId?: string(name='SessionId', description='The session ID.', example='text-11111111-2222-4333-8444-555555555555'),
    startTime?: long(name='StartTime', description='The time of the first reply event in the current round.', example='1794560400000'),
    streamEnd?: boolean(name='StreamEnd', description='Indicates whether the response stream for the current round has ended.', example='true'),
    streamId?: string(name='StreamId', description='The reply round ID.', example='0'),
  }(name='Data', description='The text conversation reply.', example='{"Answer":"Hello, how can I help you?","StreamEnd":true,"SessionId":"text-11111111-2222-4333-8444-555555555555","StreamId":"0","StartTime":1794560400000,"EndTime":1794560400123,"ControlParamsList":[{"Type":"Voice"}],"Extras":{"DebugInfo":"{}"}}'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The business message.', example='xxxxxx'),
  params?: [ string ](name='Params', description='The list of error message parameters.', example='[]'),
  requestId?: string(name='RequestId', description='The request ID.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

model BeginSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BeginSessionResponseBody(name='body'),
}

/**
  * @description Creates a text conversation session for a specified instance and scenario, and streams the initial reply from the robot. An available scenario version must exist before you call this operation. Use DraftVersion to select the draft or published version, and use VendorParams to pass the accompanying variables required by the scenario. The response uses Server-Sent Events (SSE), and each data event carries a business response object. Save the returned SessionId for subsequent Dialogue and EndSession calls. A StreamEnd value of true indicates that the current response stream has ended, but the session remains active. The resource identifiers, phone numbers, and authentication credentials in the examples are masked or placeholder values. Use actual resources and service return values in production calls.
  * @param request  the request parameters of BeginSession  BeginSessionRequest
  * @return BeginSessionResponse
 */
async function beginSession(request: BeginSessionRequest): BeginSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BeginSession', 'POST', '/', 'json', false, 'json', request);
}

function beginSessionWithResponseIterable(request: BeginSessionRequest): iterator[BeginSessionResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'BeginSession', 'POST', '/', 'json', false, 'json', request);
}

model BeginTrialSessionRequest {
  draftVersion?: boolean(name='DraftVersion', description='Specifies whether to use the Scenarios draft version. Valid values:
- true: Uses the draft version.
- false: Uses the published version.
If the draft version is unavailable but a published version exists when a text session is started, the system falls back to the published version. The required version must exist. Do not interpret this parameter as publishing Scenarios or creating a version.', example='false', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an existing instance that the invoker has permission to access. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The ID of the dialogue scenario under the instance. Specify an existing scenario. Subsequent dialogues and end requests for the same text session must use the scenario specified when the session is started.', example='script-example-001', position='Query'),
  vendorParams?: string(name='VendorParams', description='The pass-through parameters passed to the scenario or dialogue engine. The value is a string of a JSON object, not a structured request object. Key names are defined by the scenario variables and the integrated engine. The city key in the example only demonstrates a custom variable in code testing and is not a fixed parameter for all scenarios. You can use an empty JSON object if no additional variables are required.', example='{"city":"Tangshan"}', position='Query'),
  visitorToken: string(name='VisitorToken', description='The visitor token obtained from the trial link. It is used to locate the trial channel and verify access permissions and validity period. The token is generated by the channel service and must not be constructed manually. It cannot be empty and must be within its validity period. The example is a placeholder value that cannot be used for authentication. Do not disclose actual tokens to unauthorized personnel.

This parameter is required.', example='example-visitor-token', position='Query'),
}

model BeginTrialSessionResponseBody = {
  code?: string(name='Code', description='The business processing status code. OK indicates success. If an exception occurs, the corresponding business error code is returned. Error types and mapping rules follow the current API configuration. No error codes are added or modified in this operation.', example='OK'),
  data?: {
    answer?: string(name='Answer', description='The robot reply text in the current streaming event. It may be returned across multiple SSE events, or it may be empty in an end event or debug event. Do not equate missing text with session failure. Whether the content is incremental or cumulative is determined by the output conventions of the dialogue engine. The current general callback directly forwards the engine content.', example='Hello, how can I help you?'),
    controlParamsList?: [ 
      {
        type?: string(name='Type', description='The values declared in the control command type include Voice (voice reply), HangUp (hang up), Transfer (transfer), GatherDtmf (collect DTMF tones), and SendSms (send SMS message). SendSms, which was omitted in the original description, is added in this update without changing the backend structure or runtime enumeration constraints.', example='Voice'),
      }
    ](name='ControlParamsList', description='The robot control commands attached to this reply. The current POP structure only expands the command Type and does not add other command fields in this document. If no control command is generated, the text service supplements a Voice type command.', example='[{"Type":"Voice"}]'),
    endTime?: long(name='EndTime', description='The UNIX timestamp of the current streaming reply callback event, in milliseconds. It is generated based on the current callback time. It may also be returned when StreamEnd=false. Do not directly interpret it as the end time of the entire session or call.', example='1794560400123'),
    extras?: {
      debugInfo?: string(name='DebugInfo', description='The debug information returned by the dialogue engine, which is a JSON string. It is returned only when the engine provides and obtains debug information, and may be returned with supplementary events after the reply ends. The internal structure is determined by the engine. The example empty object string does not declare any fixed debug fields.', example='{}'),
    }(name='Extras', description='The extended information object attached to the robot reply, which is different from the JSON event array of the request parameter Extras. The current POP expands the DebugInfo field. Whether it is actually returned depends on the engine used and the current round of reply.', example='{"DebugInfo":"{}"}'),
    sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text session, it is the text- ID returned when the session is started. For web voice, it is the ws- ID. For a real number outbound call test, it is the test- ID. Subsequent calls must use the actual return value.', example='text-11111111-2222-4333-8444-555555555555'),
    startTime?: long(name='StartTime', description='The UNIX timestamp recorded when the streaming reply callback is entered for the first time in the current round, in milliseconds. Subsequent events in the current round use this time. It is not the session creation time or a general update time.', example='1794560400000'),
    streamEnd?: boolean(name='StreamEnd', description='Specifies whether the streaming output of the current reply round has ended. Valid values:
- true: The streaming output has ended, and the service has completed the corresponding SSE response.
- false: Subsequent events may still occur in the current round.
This field does not indicate that the entire session or voice call has ended.', example='true'),
    streamId?: string(name='StreamId', description='The ID of the dialogue round to which this robot reply belongs. A single round of reply may contain multiple streaming events. The text session context starts from 0 and increments during subsequent Dialogue calls. The actual return value from the engine shall prevail.', example='0'),
  }(name='Data', description='The robot reply, round ID, time, and control commands carried by the current SSE event. A single round may contain multiple events.', example='{"Answer":"Hello, how can I help you?","StreamEnd":true,"SessionId":"text-11111111-2222-4333-8444-555555555555","StreamId":"0","StartTime":1794560400000,"EndTime":1794560400123,"ControlParamsList":[{"Type":"Voice"}],"Extras":{"DebugInfo":"{}"}}'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A normal return value is 200. To determine whether the business operation is successful, you must also check Code. You cannot determine the success of a call solely based on the presence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error description. This field is usually empty or not returned upon success, and no fixed text is returned. Upon failure, it provides an error description to assist in troubleshooting. Combine this field with Code and Params to understand the cause of the error. The example shows an error message when the trial link visitor token expires (corresponding to the Expired.VisitorToken code) and is for format reference only.', example='VisitorToken: example-visitor-token is expired.'),
  params?: [ string ](name='Params', description='The parameter list used for the localized display of error messages. It is not a scenario variable or business result. A normal successful response is usually an empty array. If an error occurs, parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to associate and troubleshoot this POP request. The value in the response corresponds to the current request. System request parameters are injected by the gateway, and the caller does not need to fill in system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

model BeginTrialSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BeginTrialSessionResponseBody(name='body'),
}

/**
  * @description Creates a trial text session in a specified instance and scenario by using the VisitorToken from a trial link, and returns the first-round reply in Server-Sent Events (SSE) format. The service verifies the channel and expiration time corresponding to the token, and then starts the session based on the tenant to which the channel belongs. The token does not replace the business parameters of the scenario and instance. Save the returned SessionId for subsequent calls to TrialDialogue to send user input, and call EndTrialSession to end the session. StreamEnd=true only indicates that the streaming response for the current round has ended. The resource identifiers, numbers, and authentication credentials in the examples are desensitized or placeholder values. Use actual resources and service return values for actual calls.
  * @param request  the request parameters of BeginTrialSession  BeginTrialSessionRequest
  * @return BeginTrialSessionResponse
 */
async function beginTrialSession(request: BeginTrialSessionRequest): BeginTrialSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BeginTrialSession', 'POST', '/', 'json', false, 'json', request);
}

function beginTrialSessionWithResponseIterable(request: BeginTrialSessionRequest): iterator[BeginTrialSessionResponseBody] {
  @handler.validateRequestModel(request);
  yield @handler.doSSERequest('SSE', 'BeginTrialSession', 'POST', '/', 'json', false, 'json', request);
}

model BridgeTrialWebCallRequest {
  caller?: string(name='Caller', description='The caller information used to display and associate with the web call. It is not equivalent to the actual outbound caller phone number. If it is not provided or is empty, the current web call implementation uses the caller identifier as the caller display information.', example='web-user-001', position='Query'),
  deviceId?: string(name='DeviceId', description='The ID of the client device that initiates the web voice call or receives data channel events. The same DeviceId must be used when the same client obtains data channel credentials and initiates a call. The example is only a business device identifier, not a real credential assigned by the platform.', example='10001', position='Query'),
  draftVersion?: boolean(name='DraftVersion', description='Specifies whether to use the draft version. Valid values: true: uses the draft version. false: uses the published version. This is not a scenario publishing operation. Ensure that the selected scenario version exists before the call.', example='false', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an instance that the invoker has access to and that actually exists. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001', maxLength=64, position='Query'),
  sampleRate?: int32(name='SampleRate', description='The audio sampling rate for web voice, in Hz. The backend default is 8000. It must match the client audio and gateway capabilities. The current API code does not define a complete list of allowed values, and other sampling rates are not written as guaranteed supported enumerations.', example='8000', position='Query'),
  scriptId?: string(name='ScriptId', description='The ID of the dialogue scenario under the instance. Specify an existing scenario. Subsequent dialogues and end requests for the same text session must use the scenario specified when the session is started.', example='script-example-001', position='Query'),
  tags?: string(name='Tags', description='The attached data string passed to the call link. It uses the key=value format. Multiple key-value pairs are separated by semicolons. It is not in JSON format. For example, the Callee key can be used by the web call service to read the called party information. The example number is a placeholder value. For actual business, fill it in according to the access agreement. Do not overwrite internal tags that are not within the business custom scope.', example='Callee=057100000000', position='Query'),
  timeoutSeconds?: int32(name='TimeoutSeconds', description='The timeout period for waiting for the call to be answered, in seconds. If the call is not answered within this period, it is actively hung up. The backend default is 60 seconds. This is not the maximum duration of an answered call. The current request object does not declare additional upper and lower limits, and unverified value ranges are not added to the documentation.', example='60', position='Query'),
  visitorToken: string(name='VisitorToken', description='The visitor token obtained from the trial link. It is used to locate the trial channel and verify the access permissions and validity period. The token is generated by the channel service and must not be constructed manually. It cannot be empty and must still be within the validity period. The example is a placeholder value that cannot be used for authentication. Do not disclose the real token to unrelated personnel.

This parameter is required.', example='example-visitor-token', position='Query'),
}

model BridgeTrialWebCallResponseBody = {
  code?: string(name='Code', description='The business processing status code. OK indicates success. When an exception occurs, the corresponding business error code is returned. The error types and mapping rules follow the current API configuration, and no error codes are added or modified this time.', example='OK'),
  data?: {
    channelId?: string(name='ChannelId', description='The web voice connection channel ID assigned or returned by the RTC gateway. It is used to associate and connect the voice channel for this call. It is different from the trial channel AccessChannelId. You must use the real value returned by this API.', example='ch-ws-10001-057100000000-1794560400000-ws-11111111-2222-4333-8444-555555555555'),
    expirationTime?: string(name='ExpirationTime', description='The expiration time of the web voice connection token for this call. The current POP type is string, and the backend WebCallContext type is long. The code does not mark the time unit. The format and unit must be confirmed according to the actual service provider agreement. The example is only a numeric string and does not represent a verified validity period unit.', example='1794564000000'),
    instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an instance that the invoker has access to and that actually exists. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001'),
    serverUrl?: string(name='ServerUrl', description='The service address used to establish the web voice connection for this call. The format and protocol are determined by the service provider of the RTC gateway. You must use the actual returned value and cannot concatenate it yourself. The example is an unconnectable desensitized address and does not represent a production domain name or protocol guarantee.', example='wss://example.invalid/voice'),
    sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text session, it is the text- identifier returned when the session is started. For a web voice session, it is the ws- identifier. For a real number outbound call test, it is the test- identifier. Subsequent calls must use the actual returned value.', example='ws-11111111-2222-4333-8444-555555555555'),
    token?: string(name='Token', description='The temporary token used to connect to the voice channel for this call. It must be used together with the ServerUrl and ChannelId returned this time. Do not disclose or record the actual token without desensitization. The example is not a valid credential, and the format and validity period are determined by the service provider.', example='example-web-call-token'),
  }(name='Data', description='The session, channel, service address, and temporary authentication token for this web voice call. Use the actually returned connection parameters.', example='{"InstanceId":"instance-example-001","SessionId":"ws-11111111-2222-4333-8444-555555555555","ChannelId":"ch-ws-10001-057100000000-1794560400000-ws-11111111-2222-4333-8444-555555555555","ExpirationTime":"1794564000000","ServerUrl":"wss://example.invalid/voice","Token":"example-web-call-token"}'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A normal return is 200. To determine whether the business is successful, you must also check Code. You cannot determine that the call is successful solely based on the existence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error description. It is usually empty or not returned upon success, and it is not required to return a fixed text upon success. Upon failure, it is an error description used to assist troubleshooting, and it is combined with Code and Params to understand the cause of the error. The example is an error message when the trial link visitor token expires (corresponding to the Code Expired.VisitorToken), and is for format reference only.', example='VisitorToken: example-visitor-token is expired.'),
  params?: [ string ](name='Params', description='The list of parameters used for the localized display of error messages. It is not a scenario variable or business result. A normal successful response is usually an empty array. When an error occurs, parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to associate and troubleshoot this POP request. The value in the response corresponds to this request. System request parameters are injected by the gateway, and the caller does not need to fill in the system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

model BridgeTrialWebCallResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BridgeTrialWebCallResponseBody(name='body'),
}

/**
  * @description Initiates a trial web voice call for a specified scenario by using the VisitorToken of a trial link. The service verifies the token, the associated channel, and the validity period, and then delegates the web call service to bridge the web voice channel and the robot channel. The DeviceId must be consistent with the data channel device identifier of the trial client. After the call is initiated, use the returned ChannelId, ServerUrl, and Token to connect to the voice channel. If the data event channel of the trial client is required, you can call GetTrialDataChannelCredential with the same DeviceId. The web voice connection token and the data channel username and password are not the same set of credentials. The resource identifiers, numbers, and authentication credentials in the examples are desensitized or placeholder values. Use actual resources and service return values for actual calls.
  * @param request  the request parameters of BridgeTrialWebCall  BridgeTrialWebCallRequest
  * @return BridgeTrialWebCallResponse
 */
async function bridgeTrialWebCall(request: BridgeTrialWebCallRequest): BridgeTrialWebCallResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BridgeTrialWebCall', 'POST', '/', 'json', false, 'json', request);
}

model BridgeWebCallRequest {
  caller?: string(name='Caller', description='The caller information used to display and associate with the web call. This is not equivalent to the actual outbound caller phone number. If not provided or left empty, the current web call implementation uses the caller identifier as the caller display information.', example='web-user-001', position='Query'),
  deviceId?: string(name='DeviceId', description='Identifies the client device that initiates the web voice call or receives data channel events. The same client must use the same DeviceId when obtaining data channel credentials and initiating a call. The example is only a business device identifier, not a real credential assigned by the platform.', example='10001', position='Query'),
  draftVersion?: boolean(name='DraftVersion', description='Specifies the scenario version. A value of true indicates that the draft version is used. A value of false indicates that the published version is used. This is not a scenario publishing operation. Ensure that the selected scenario version exists before calling the operation.', example='false', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an existing instance that the invoker has permission to access. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001', maxLength=64, position='Query'),
  sampleRate?: int32(name='SampleRate', description='The audio sample rate for the web voice, in Hz. The backend default is 8000. The sample rate must match the client audio and gateway capabilities. The current API code does not define a complete list of allowed values, and other sample rates are not documented as guaranteed supported enumerations.', example='8000', position='Query'),
  scriptId?: string(name='ScriptId', description='The dialogue scenario ID under the instance. Specify an existing scenario. Subsequent dialogue and end requests for the same text session must use the scenario specified when the session is started.', example='script-example-001', position='Query'),
  tags?: string(name='Tags', description='The attached data string passed to the call link in key=value format. Separate multiple key-value pairs with semicolons instead of using JSON. For example, the web call service can read the Callee key to obtain the called party information. The example number is a placeholder value. Specify actual values based on your integration agreements. Do not overwrite internal tags that do not belong to the business custom scope.', example='Callee=057100000000', position='Query'),
  timeoutSeconds?: int32(name='TimeoutSeconds', description='The timeout for waiting for the call to be answered, in seconds. If the call is not answered within this period, it is actively hung up. The default value on the backend is 60 seconds. This does not represent the maximum duration of an answered call. The current request object does not declare additional upper and lower limits, and unverified value ranges are not added to the documentation.', example='60', position='Query'),
}

model BridgeWebCallResponseBody = {
  code?: string(name='Code', description='The business processing status code. A value of OK indicates success. If an exception occurs, the corresponding business error code is returned. The error types and mapping rules follow the current API configuration. No error codes are added or modified in this operation.', example='OK'),
  data?: {
    channelId?: string(name='ChannelId', description='The web voice connection channel ID assigned or returned by the RTC gateway. This ID is used to associate and connect the voice channel for this call. This is different from the trial channel AccessChannelId. You must use the actual value returned by this operation.', example='ch-ws-10001-057100000000-1794560400000-ws-11111111-2222-4333-8444-555555555555'),
    expirationTime?: string(name='ExpirationTime', description='The expiration time of the web voice connection token for this call. The current POP type is string, and the backend WebCallContext type is long. The code does not specify the time unit. Confirm the format and unit based on the actual service provider agreement. The example is only a numeric string and does not represent a verified validity period unit.', example='1794564000000'),
    instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an existing instance that the invoker has permission to access. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001'),
    serverUrl?: string(name='ServerUrl', description='The service address used to establish the web voice connection for this call. The format and protocol are determined by the service provider of the RTC gateway. You must use the actual returned value and cannot concatenate it yourself. The example is an unconnectable masked address and does not represent a production domain name or protocol guarantee.', example='wss://example.invalid/voice'),
    sessionId?: string(name='SessionId', description='The session ID used to uniquely associate this interaction. The ID starts with text- for text sessions returned when starting a session, ws- for web voice sessions, and test- for real number outbound call tests. Subsequent calls must use the actual returned value.', example='ws-11111111-2222-4333-8444-555555555555'),
    token?: string(name='Token', description='The temporary token used to connect to the voice channel for this call. This token must be used together with the ServerUrl and ChannelId returned in this response. Do not expose or record actual tokens without masking them. The example is not a valid credential. The format and validity period are determined by the service provider.', example='example-web-call-token'),
  }(name='Data', description='The session, channel, service address, and temporary authentication token for this web voice call. Use the actual returned connection parameters.', example='{"InstanceId":"instance-example-001","SessionId":"ws-11111111-2222-4333-8444-555555555555","ChannelId":"ch-ws-10001-057100000000-1794560400000-ws-11111111-2222-4333-8444-555555555555","ExpirationTime":"1794564000000","ServerUrl":"wss://example.invalid/voice","Token":"example-web-call-token"}'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A normal return value is 200. To determine whether the business operation is successful, you must also check Code. You cannot determine the success of the call solely based on the presence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error description. This field is usually empty or not returned upon success. A fixed text is not returned upon success. Upon failure, this field contains an error description to help troubleshoot the issue. Combine this field with Code and Params to understand the cause of the error. The example shows an error message when the instance does not exist, where Code is NotExists.InstanceId. This is for format reference only.', example='Instance instance-example-001 does not exist.'),
  params?: [ string ](name='Params', description='The list of parameters used for the localized display of error messages. This is not a scenario variable or business result. A normal success response is usually an empty array. If an error occurs, parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to associate and troubleshoot this POP request. The value in the response corresponds to the current request. System request parameters are injected by the gateway, and the caller does not need to fill in system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

