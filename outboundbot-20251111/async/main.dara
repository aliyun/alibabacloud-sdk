    expirationTime?: long(name='ExpirationTime', description='The expiration time of the trial channel and the visitor token, in Unix timestamp format and measured in milliseconds. The service compares the validity period with the current system time in milliseconds. Expired tokens cannot continue the trial.', example='1794564000000'),
