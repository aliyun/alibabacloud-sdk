model EndSessionRequest {
  instanceId?: string(name='InstanceId', description='The instance identity of the associated product. You must use an existing instance that the invoker is authorized to access. The instance must match the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definitions.', example='instance-example-001', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The ID of the dialog scenario under the instance. You must specify an existing scenario. Subsequent dialog and session termination requests for the same text session must use the same scenario that was used to start the session.', example='script-example-001', position='Query'),
  sessionId: string(name='SessionId', description='The session ID used to uniquely identify the current interaction. For a text session, use the text- prefixed ID returned when the session is started. For web voice, use the ws- prefixed ID. For outbound call tests with real numbers, use the test- prefixed ID. Subsequent calls must use the actual returned values.

This parameter is required.', example='text-11111111-2222-4333-8444-555555555555', position='Query'),
}

model EndSessionResponseBody = {
  code?: string(name='Code', description='The business processing status code. A value of OK indicates success. If an exception occurs, the corresponding business error code is returned. The error types and mapping rules follow the current API configuration. No error codes are added or modified for this operation.', example='OK'),
  data?: string(name='Data', description='The session ID of the terminated text session, which corresponds to the session ID in the request. The service still returns this ID even if the session context has expired.', example='text-11111111-2222-4333-8444-555555555555'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A value of 200 indicates a normal response. To determine whether the business operation is successful, you must also check the Code field. You cannot determine the success of the call based solely on the presence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error message. This field is usually empty or omitted for successful requests. For failed requests, it provides an error description to assist in troubleshooting. Use this field in conjunction with the Code and Params fields to identify the cause of the error. The example shows the error message returned when an instance does not exist, which corresponds to the NotExists.InstanceId error code. This example is for format reference only.', example='Instance instance-example-001 does not exist.'),
  params?: [ string ](name='Params', description='The list of parameters used to localize error messages. These are not scenario variables or business results. A successful response usually returns an empty array. If an error occurs, the parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to trace and troubleshoot the current POP request. The value in the response corresponds to the current request. System request parameters are injected by the gateway, so you do not need to specify system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

model EndSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: EndSessionResponseBody(name='body'),
}

/**
  * @description Ends a text session created by BeginSession, notifies the dialog engine to end the interaction, and clears the text session state. The InstanceId, ScriptId, and SessionId must match those used when the session was started. The Data field in the response returns the SessionId of the ended session. If the text session no longer exists due to prolonged inactivity or cache expiration, the current implementation still returns the SessionId without reporting a session not found error. This operation is used to conclude a text session and is not intended for hanging up web voice or actual phone calls. The resource identifiers, phone numbers, and authentication credentials in the examples are masked or placeholder values. Use actual resources and service return values for real calls.
  * @param request  the request parameters of EndSession  EndSessionRequest
  * @return EndSessionResponse
 */
async function endSession(request: EndSessionRequest): EndSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'EndSession', 'POST', '/', 'json', false, 'json', request);
}

model EndTrialSessionRequest {
  instanceId?: string(name='InstanceId', description='The instance identity of the associated product. When you invoke the operation, you must use an instance that you have access to and that actually exists. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.', example='instance-example-001', maxLength=64, position='Query'),
  scriptId?: string(name='ScriptId', description='The ID of the dialog scenario under the instance. Specify an existing scenario. Subsequent dialog and termination requests for the same text session must use the scenario specified when the session was started.', example='script-example-001', position='Query'),
  sessionId: string(name='SessionId', description='The session ID used to uniquely associate this interaction. For a text session, it is the identifier starting with text- returned when the session is started. For a web voice session, it is the identifier starting with ws-. For a real number outbound call test, it is the identifier starting with test-. Subsequent calls must use the actual returned value.

This parameter is required.', example='text-11111111-2222-4333-8444-555555555555', position='Query'),
  visitorToken: string(name='VisitorToken', description='The visitor token obtained from the trial link. It is used to locate the trial channel and verify access permissions and validity. The token is generated by the channel service and must not be constructed manually. It cannot be empty and must still be within its validity period. The example is a placeholder value that cannot be used for authentication. Do not disclose the actual token to unauthorized personnel.

This parameter is required.', example='example-visitor-token', position='Query'),
}

model EndTrialSessionResponseBody = {
  code?: string(name='Code', description='The business processing status code. OK indicates success. If an exception occurs, the corresponding business error code is returned. The error types and mapping rules follow the current API configuration. No error codes are added or modified in this operation.', example='OK'),
  data?: string(name='Data', description='The SessionId of the text session ended in this request, which corresponds to the SessionId in the request. The termination service still returns this ID even if the context has expired.', example='text-11111111-2222-4333-8444-555555555555'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code recorded in the business response body. A normal return value is 200. To determine whether the business operation is successful, you must also check Code. You cannot determine the success of the call solely based on the presence of this field.', example='200'),
  message?: string(name='Message', description='The business response or error message. It is typically empty or not returned upon success. Do not expect a fixed text string upon success. Upon failure, it provides an error description to assist with troubleshooting. Use it in conjunction with Code and Params to identify the cause of the error. The example shows an error message for an expired visitor token in an experience link (corresponding to the Expired.VisitorToken code) and serves as a format reference only.', example='VisitorToken: example-visitor-token is expired.'),
  params?: [ string ](name='Params', description='The list of parameters used for the localized display of error messages. These are not scenario variables or business results. A normal successful response usually returns an empty array. When an error occurs, parameters corresponding to the error template may be returned.', example='[]'),
  requestId?: string(name='RequestId', description='The ID used to associate and troubleshoot this POP request. The value in the response corresponds to the current request. System request parameters are injected by the gateway, and the caller does not need to fill in system fields.', example='AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE'),
}

model EndTrialSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: EndTrialSessionResponseBody(name='body'),
}

/**
  * @description Ends a trial text session created by BeginTrialSession by using a valid VisitorToken from a trial link. The service first validates the token and then delegates the request to the text session termination service. The InstanceId, ScriptId, and SessionId must maintain session persistence consistent with those of the trial session. The returned Data is the SessionId of the ended session. If the text session context has expired, the termination service can still return the SessionId, but the validation will be marked as failed if the trial token itself is invalid or expired. This operation is not used to hang up web voice calls. The resource identity, numbers, and authentication credentials in the examples are desensitized or placeholder values. Use actual resources and service return values when you invoke the operation.
  * @param request  the request parameters of EndTrialSession  EndTrialSessionRequest
  * @return EndTrialSessionResponse
 */
async function endTrialSession(request: EndTrialSessionRequest): EndTrialSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'EndTrialSession', 'POST', '/', 'json', false, 'json', request);
}

