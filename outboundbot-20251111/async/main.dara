model MakePilotCallRequest {
  callVariables?: string(name='CallVariables', description='The variables passed to the phone call link. The value is a JSON object string, and variable values are processed as strings. Specific variable names are agreed upon by the call link and business scenario. This parameter is not semicolon-separated Tags. The example uses an empty object when no custom variables are defined.', example='{}', position='Query'),
  deviceId: string(name='DeviceId', description='The ID of the client device that initiates the web voice or receives data channel events. The same client must use the same DeviceId when obtaining data channel credentials and initiating a call. The example is only a business device ID and not a real credential assigned by the platform.

This parameter is required.', example='10001', position='Query'),
  draftVersion: boolean(name='DraftVersion', description='Specifies whether to use the draft version. Valid values:
- true: Uses the draft version.
- false: Uses the published version.
This parameter does not publish the scenario. Ensure that the selected scenario version exists before you call this operation.

This parameter is required.', example='false', position='Query'),
  instanceId: string(name='InstanceId', description='The instance identity of the product. You must use an instance that the invoker has access to and that actually exists. The instance must be consistent with the instance to which the scenario, channel, and session belong. The maximum length is subject to the current POP parameter definition.

This parameter is required.', example='instance-example-001', maxLength=64, position='Query'),
  number: string(name='Number', description='The called phone number for the current real-number outbound call test. The number must be the same as the one used to obtain the SMS verification code. Specify a number that is actually supported by the business and authorized. The current request object only requires this parameter to be non-empty. This document does not fabricate number formats or international number support scopes.

This parameter is required.', example='13800000000', position='Query'),
  scriptId: string(name='ScriptId', description='The dialog scenario ID of the instance. Specify an existing scenario. Subsequent dialog and end requests for the same text session must use the scenario specified when the session is started.

This parameter is required.', example='script-example-001', position='Query'),
  tags?: string(name='Tags', description='The attached data string passed to the call link. Use the key=value format. Separate multiple key-value pairs with semicolons. Do not use JSON. For example, the Callee key can be used by the web call service to read the called party information. The example number is a placeholder value. Specify the actual value based on the access conventions of your business. Do not overwrite internal tags that do not belong to the business custom scope.', example='Callee=057100000000', position='Query'),
  verificationCode: string(name='VerificationCode', description='The SMS verification code sent to the number specified by Number for the verification of the OutboundCallTest scenario. The request must use a valid verification code actually received by the number. The example only demonstrates a string parameter and cannot be used to pass the verification. It also does not declare undefined length rules for the code.

This parameter is required.', example='123456', position='Query'),
}

model MakePilotCallResponseBody = {
  code?: string(name='Code', description='The business processing status code. OK indicates success. When an exception occurs, the corresponding business error code is returned. Error types and mapping rules follow the current API configuration. No error codes are added or modified in this operation.', example='OK'),
  data?: {
    sessionId?: string(name='SessionId', description='The session ID used to uniquely associate the current interaction. For a text session, it is the text- ID returned when the session is started. For web voice, it is the ws- ID. For a real-number outbound call test, it is the test- ID. Subsequent calls must use the actual return value.', example='test-11111111-2222-4333-8444-555555555555'),
  }(name='Data', description='The session ID of the current real-number outbound call test. The return of this object does not indicate that the called party has answered.', example='{"SessionId":"test-11111111-2222-4333-8444-555555555555"}'),
