model CreateFlashSmsAccessProfileRequest {
  accessProfile?: {
    account?: string(name='Account', description='Required when ProviderId is set to ShangHaiTianNan or Uincall.', example='6004200267'),
    aesKey?: string(name='AesKey', description='Required when ProviderId is set to ChinaMobile.', example='TQChVEAabhaNp2AB'),
    apiAccount?: string(name='ApiAccount', description='Required when ProviderId is set to ChuangLan.', example='N92685567'),
    apiId?: string(name='ApiId', description='Required when ProviderId is set to ChinaMobile.', example='100235'),
    apiKey?: string(name='ApiKey', description='Required when ProviderId is set to ChinaMobile.', example='3aRsPrTsDG3OPNq5'),
    apiPassword?: string(name='ApiPassword', description='Required when ProviderId is set to ChuangLan.', example='Rp7hyUbtXMef23'),
    capAppId?: string(name='CapAppId', description='Required when ProviderId is set to ChinaMobile.', example='300012117547'),
    dySmsAccessProfiles?: [ 
      {
        description?: string(name='Description', description='The template content.', example='We tried to reach you but you were unavailable. Our staff will contact you again shortly. We apologize for any inconvenience'),
        name?: string(name='Name', description='The template name.', example='Test'),
        signName?: string(name='SignName', description='The signature name.', example='Cloud Call Center'),
        templateCode?: string(name='TemplateCode', description='The template code.', example='SMS_469075249'),
      }
    ](name='DySmsAccessProfiles', description='The list of Alibaba Communication configurations. Required when ProviderId is set to DySms.'),
    extno?: string(name='Extno', description='Required when ProviderId is set to ShangHaiTianNan.', example='10690101220'),
    managementPassword?: string(name='ManagementPassword', description='Required when ProviderId is set to ChuangLan.', example='Rp7hyUbtXMef23'),
    managementSubUserId?: string(name='ManagementSubUserId', description='Required when ProviderId is set to ChuangLan.', example='chuanglanrobot2'),
    managementUsername?: string(name='ManagementUsername', description='Required when ProviderId is set to ChuangLan.', example='chuanglanrobot'),
    password?: string(name='Password', description='Required when ProviderId is set to ShangHaiTianNan or HeDao.', example='nu2DxxfZtY46'),
    pwd?: string(name='Pwd', description='Required when ProviderId is set to Uincall.', example='828ee92ebc8241d3b37d0238dde6345e'),
    user?: string(name='User', description='Required when ProviderId is set to Uincall.', example='6004200267_dev'),
    userName?: string(name='UserName', description='Required when ProviderId is set to HeDao.', example='TEST10'),
  }(name='AccessProfile', description='The access configuration.', shrink='json', position='Body'),
