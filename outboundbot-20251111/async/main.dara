    nluEngine?: string(name='NluEngine', description='The natural language understanding (NLU) engine type defined in the configuration layer. Valid values: BEEBOT, PROMPTS, and FUNCTION. This field is not declared in the current business layer channel response object. Therefore, whether it can be returned through this operation depends on the deployment version and must not be assumed to always exist on the client.', example='BEEBOT'),
    state?: string(name='State', description='The channel status. Valid values: Active (effective) and Expired (invalid). Trial access still requires server-side token and validity period verification. You cannot bypass the verification based solely on the status value saved on the client.', example='Active'),
    updatedTime?: long(name='UpdatedTime', description='The last update time of the channel, in Unix timestamp format and measured in milliseconds. It is converted from the update time of the configuration layer entity.', example='1794560400000'),
    visitorToken?: string(name='VisitorToken', description='The visitor token obtained from the trial link. It is used to locate the trial channel and verify access permissions and the validity period. The token is generated by the channel service and must not be constructed manually. It cannot be empty and must be within its validity period. The example is a placeholder value that cannot be used for authentication. Do not disclose actual tokens to unauthorized personnel.', example='example-visitor-token'),
  }(name='Data', description='The channel configuration corresponding to the VisitorToken and its associated scenarios, used for trial page initialization.', example='{"InstanceId":"instance-example-001","AccessChannelId":"66666666-7777-4888-8999-000000000000","AccessChannelType":"TEST","Name":"Product consultation trial","State":"Active","ChannelSetting":"{}","VisitorToken":"example-visitor-token","ExpirationTime":1794564000000,"CreatedTime":1794556800000,"UpdatedTime":1794560400000,"ChannelScripts":[{"ScriptId":"script-example-001","ScriptName":"Product consultation","VariableConfigs":"[]","LabelConfigs":"[]"}],"NluEngine":"BEEBOT","BuilderType":"FLOW"}'),
