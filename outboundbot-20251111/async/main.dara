/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'OutboundBot';
  @version = '2025-11-11';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-shanghai' = 'outboundbot.cn-shanghai.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model CreateInstanceRequest {
  concurrency?: int32(name='Concurrency', description='实例并发数，最小值0。与该租户下已有实例并发数之和不得超过已购买的并发配额', example='10', position='Body'),
  description?: string(name='Description', description='实例描述，最大长度255个字符', example='用于电销场景的智能外呼实例', position='Body'),
  name?: string(name='Name', description='实例名称，最大长度32个字符', example='智能外呼实例', position='Body'),
  serviceMode?: string(name='ServiceMode', description='服务模式，最大长度32个字符。INTEGRATED：集成模式，创建实例时同步创建晓蜜业务空间；STANDARD：标准模式', example='STANDARD', position='Body'),
}

model CreateInstanceResponseBody = {
  code?: string(name='Code', description='返回码。成功时为 OK'),
  data?: string(name='Data', description='新建实例的实例ID'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP状态码'),
  message?: string(name='Message', description='错误信息'),
  params?: [ string ](name='Params', description='错误信息中的变量值'),
  requestId?: string(name='RequestId', description='Id of the request'),
  success?: boolean(name='Success', description='是否调用成功'),
}

model CreateInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateInstanceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateInstance  CreateInstanceRequest
  * @return CreateInstanceResponse
 */
async function createInstance(request: CreateInstanceRequest): CreateInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateInstance', 'POST', '/', 'json', true, 'form', request);
}

model DeleteInstanceRequest {
  instanceId?: string(name='InstanceId', description='待删除的实例ID', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b04', position='Body'),
}

model DeleteInstanceResponseBody = {
  code?: string(name='Code', description='返回码。成功时为 OK'),
  data?: string(name='Data', description='已删除实例的实例ID'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP状态码'),
  message?: string(name='Message', description='错误信息'),
  params?: [ string ](name='Params', description='错误信息中的变量值'),
  requestId?: string(name='RequestId', description='Id of the request'),
  success?: boolean(name='Success', description='是否调用成功'),
}

model DeleteInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DeleteInstanceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of DeleteInstance  DeleteInstanceRequest
  * @return DeleteInstanceResponse
 */
async function deleteInstance(request: DeleteInstanceRequest): DeleteInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DeleteInstance', 'POST', '/', 'json', true, 'form', request);
}

model GetInstanceRequest {
  instanceId?: string(name='InstanceId', description='实例ID', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b04', position='Body'),
}

model GetInstanceResponseBody = {
  code?: string(name='Code', description='返回码。成功时为 OK'),
  data?: {
    concurrency?: int32(name='Concurrency', description='实例并发数'),
    createdTime?: long(name='CreatedTime', description='实例创建时间，毫秒级时间戳'),
    description?: string(name='Description', description='实例描述'),
    instanceId?: string(name='InstanceId', description='实例ID'),
    name?: string(name='Name', description='实例名称'),
    nluProfile?: string(name='NluProfile', description='晓蜜业务空间信息，JSON格式字符串。仅服务模式为 INTEGRATED 时有值'),
    serviceMode?: string(name='ServiceMode', description='服务模式。INTEGRATED：集成模式，与晓蜜业务空间集成；STANDARD：标准模式'),
    tenantId?: string(name='TenantId', description='租户ID'),
    updatedTime?: long(name='UpdatedTime', description='实例最后更新时间，毫秒级时间戳'),
  }(name='Data', description='实例详情'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP状态码'),
  message?: string(name='Message', description='错误信息'),
  params?: [ string ](name='Params', description='错误信息中的变量值'),
  requestId?: string(name='RequestId', description='Id of the request'),
  success?: boolean(name='Success', description='是否调用成功'),
}

model GetInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetInstanceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of GetInstance  GetInstanceRequest
  * @return GetInstanceResponse
 */
async function getInstance(request: GetInstanceRequest): GetInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetInstance', 'POST', '/', 'json', true, 'form', request);
}

model ListInstancesRequest {
  name?: string(name='Name', description='实例名称，支持模糊匹配，最大长度32个字符', example='外呼', position='Body'),
  pageNumber?: int32(name='PageNumber', description='页码，从1开始', example='1', position='Body'),
  pageSize?: int32(name='PageSize', description='每页记录数，取值范围1~100', example='20', position='Body'),
}

model ListInstancesResponseBody = {
  code?: string(name='Code', description='返回码。成功时为 OK'),
  data?: {
    instances?: [ 
      {
        concurrency?: int32(name='Concurrency', description='实例并发数'),
        createdTime?: long(name='CreatedTime', description='实例创建时间，毫秒级时间戳'),
        description?: string(name='Description', description='实例描述'),
        instanceId?: string(name='InstanceId', description='实例ID'),
        name?: string(name='Name', description='实例名称'),
        serviceMode?: string(name='ServiceMode', description='服务模式。INTEGRATED：集成模式，与晓蜜业务空间集成；STANDARD：标准模式'),
        tenantId?: string(name='TenantId', description='租户ID'),
        updatedTime?: long(name='UpdatedTime', description='实例最后更新时间，毫秒级时间戳'),
      }
    ](name='Instances', description='实例列表'),
    pageNumber?: int32(name='PageNumber', description='当前页码'),
    pageSize?: int32(name='PageSize', description='每页记录数'),
    totalCount?: int32(name='TotalCount', description='符合查询条件的实例总数'),
  }(name='Data', description='分页查询结果'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP状态码'),
  message?: string(name='Message', description='错误信息'),
  params?: [ string ](name='Params', description='错误信息中的变量值'),
  requestId?: string(name='RequestId', description='Id of the request'),
  success?: boolean(name='Success', description='是否调用成功'),
}

model ListInstancesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListInstancesResponseBody(name='body'),
}

/**
  * @param request  the request parameters of ListInstances  ListInstancesRequest
  * @return ListInstancesResponse
 */
async function listInstances(request: ListInstancesRequest): ListInstancesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListInstances', 'POST', '/', 'json', true, 'form', request);
}

model UpdateInstanceRequest {
  concurrency?: int32(name='Concurrency', description='实例并发数，最小值0。调高并发时，该租户下已有实例并发数之和不得超过已购买的并发配额', example='20', position='Body'),
  description?: string(name='Description', description='实例描述，最大长度255个字符', example='用于电销场景的智能外呼实例', position='Body'),
  instanceId?: string(name='InstanceId', description='待更新的实例ID', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b04', position='Body'),
  name?: string(name='Name', description='实例名称，最大长度32个字符', example='智能外呼实例', position='Body'),
}

model UpdateInstanceResponseBody = {
  code?: string(name='Code', description='返回码。成功时为 OK'),
  data?: string(name='Data', description='已更新实例的实例ID'),
  httpStatusCode?: int32(name='HttpStatusCode', description='HTTP状态码'),
  message?: string(name='Message', description='错误信息'),
  params?: [ string ](name='Params', description='错误信息中的变量值'),
  requestId?: string(name='RequestId', description='Id of the request'),
  success?: boolean(name='Success', description='是否调用成功'),
}

model UpdateInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateInstanceResponseBody(name='body'),
}

/**
  * @param request  the request parameters of UpdateInstance  UpdateInstanceRequest
  * @return UpdateInstanceResponse
 */
async function updateInstance(request: UpdateInstanceRequest): UpdateInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'UpdateInstance', 'POST', '/', 'json', true, 'form', request);
}

