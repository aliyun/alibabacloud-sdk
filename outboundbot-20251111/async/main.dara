    ](name='ChannelScripts', description='The scenarios associated with this channel and their display, variable, and label configurations. The trial page should use the ScriptId actually returned in the list and must not specify scenarios outside the channel.', example='[{"ScriptId":"script-example-001","ScriptName":"Product consultation","VariableConfigs":"[]","LabelConfigs":"[]"}]'),
    channelSetting?: string(name='ChannelSetting', description='The display configuration of the trial channel, which is a JSON object string. The content is configured during channel creation and agreed upon with the trial page, and may include display information such as Images. The current code does not provide a complete fixed structure, and the empty object in the example only illustrates the serialization format.', example='{}'),
