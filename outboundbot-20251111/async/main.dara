      {
        labelConfigs?: string(name='LabelConfigs', description='The JSON string of the label configuration exported from the scenario version. The specific fields are determined by the scenario version. The empty JSON array in the example only indicates that there are no configuration items and must not be confused with the call parameter Tags.', example='[]'),
        scriptId?: string(name='ScriptId', description='The ID of the dialog scenario under the instance. Specify an existing scenario. Subsequent dialogs and end requests for the same text session should use the scenario specified when the session is started.', example='script-example-001'),
