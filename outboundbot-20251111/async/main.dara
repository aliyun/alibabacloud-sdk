model CreateCampaignRequest {
  attemptOrder?: string(name='AttemptOrder', description='The call execution order. Default value: MIN_ATTEMPT_FIRST. Valid values:
- PRIORITY_FIRST: prioritize by priority.
- MIN_ATTEMPT_FIRST: prioritize by minimum attempt count.', example='MIN_ATTEMPT_FIRST', position='Query'),
  callableTime: string(name='CallableTime', description='The callable time range for the task. The value is a JSON object that contains two properties: beginTime and EndTime.

This parameter is required.', example='[{"beginTime":"09:00:00","endTime":"18:00:00" }]。', position='Query'),
  caseFileKey?: string(name='CaseFileKey', description='The task contact list, which is an OSS object key obtained through the GenerateFileUploadParams operation. You can also leave this parameter empty and append contacts later through the AppendCases operation.', example='cases/customer.csv', position='Query'),
  cases?: [ 
    {
      customVariables?: string(name='CustomVariables', description='The custom variables defined by the customer. The value is a JSON object that contains up to 10 properties. Both the property names and values are defined by the customer.', example='{"key1":"value1"}'),
      phoneNumber?: string(name='PhoneNumber', description='The phone number of the contact.', example='133********'),
      priority?: string(name='Priority', description='The priority of the contact. Default value: 1.', example='1'),
      referenceId?: string(name='ReferenceId', description='The business ID of the contact.', example='bizId-1'),
    }
  ](name='Cases', description='The contact list. You can also leave this parameter empty and append contacts later through the AppendCases operation.', shrink='json', position='Body'),
  dialingTimeoutSeconds?: int32(name='DialingTimeoutSeconds', description='The dialing timeout period, in seconds. Default value: 25.', example='25', position='Query'),
  endTime: long(name='EndTime', description='The task end time.

This parameter is required.', example='1579965079000', position='Query'),
  fixedQuota?: int32(name='FixedQuota', description='The minimum concurrency for the task. A value of 0 indicates no guaranteed minimum, and resources are allocated by weight.

If multiple campaigns have a minimum concurrency configured:

- If the total concurrency is less than the instance total concurrency, the minimum concurrency of each task is satisfied first, and the remaining resources are allocated proportionally by weight.

- If the total concurrency exceeds the instance total concurrency, the minimum concurrency no longer serves as a guaranteed minimum but is used as a weight factor in the calculation.', example='0', position='Query'),
  flashSmsParameters?: string(name='FlashSmsParameters', description='The flash SMS parameters.', example='{}', position='Query'),
  holidayRestricted?: boolean(name='HolidayRestricted', description='Specifies whether to restrict outbound calls on holidays.', example='false', position='Query'),
  instanceId: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='12f3dd08-0c55-44ce-9b64-e69d35ed3a76', position='Query'),
  maxAttemptCount: int32(name='MaxAttemptCount', description='The maximum number of attempts. This specifies the maximum number of times a number is called when the call fails.

This parameter is required.', example='2', position='Query'),
  minAttemptInterval: int32(name='MinAttemptInterval', description='The interval between attempts.

This parameter is required.', example='5', position='Query'),
  name: string(name='Name', description='The task name.

This parameter is required.', example='Updated job group', position='Query'),
  numbers?: [ string ](name='Numbers', description='The list of caller numbers for the outbound call task.', shrink='json', position='Query'),
  redialRestrictions?: string(name='RedialRestrictions', description='The list of redial restriction conditions. If not specified, no restrictions are applied. Valid values:
- CALLEE_NOT_EXISTS: Do not call nonexistent numbers.
- OUT_OF_SERVICE: Do not call numbers that are out of service.', example='None', position='Query'),
  runUntilEndTime?: boolean(name='RunUntilEndTime', description='Specifies whether to keep the scheduling state until the campaign end time after all contacts are called. Default value: false. Valid values:
- true: The task remains in the scheduling state, and you can continue to append contacts.
- false: The task changes to completed, and you cannot append contacts.', example='false', position='Query'),
  scriptId: string(name='ScriptId', description='The scenario ID.

This parameter is required.', example='aa279896-64a6-4182-864c-4f2b04ec8d17', position='Query'),
  startTime: long(name='StartTime', description='The task start time.

This parameter is required.', example='1578965079000', position='Query'),
  weight?: int32(name='Weight', description='The weight. The value is an integer in the range of 0 to 100. A larger value indicates more concurrency allocated during scheduling.', example='50', position='Query'),
}

model CreateCampaignResponseBody = {
  code?: string(name='Code', description='The status code of the operation.', example='OK'),
  data?: string(name='Data', description='The returned data, which is the task ID.', example='4f9a8e2b-6c1d-4a7e-9b3f-2d5c8a1e7b15'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The message returned by the operation.', example='Success'),
  params?: [ string ](name='Params', description='The variable values in the error message.'),
  requestId?: string(name='RequestId', description='The request ID.', example='254EB995-DEDF-48A4-9101-9CA5B72FFBCC'),
  success?: boolean(name='Success', description='Indicates whether the request was successful.', example='true'),
}

model CreateCampaignResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateCampaignResponseBody(name='body'),
}

/**
  * @description ****
  * @param request  the request parameters of CreateCampaign  CreateCampaignRequest
  * @return CreateCampaignResponse
 */
async function createCampaign(request: CreateCampaignRequest): CreateCampaignResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateCampaign', 'POST', '/', 'json', true, 'form', request);
}

