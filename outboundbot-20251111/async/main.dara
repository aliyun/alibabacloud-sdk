      priority?: int32(name='Priority', description='The priority.', example='1'),
      referenceId?: string(name='ReferenceId', description='The business system ID of the contact.', example='business3-watermark-2704-1776997551'),
    }
  ](name='Cases', description='The list of contacts.

This parameter is required.', shrink='json', position='Body'),
  instanceId: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='361c8a53-0e29-42f3-8aa7-c7752d010399', position='Query'),
}

model AppendCasesResponseBody = {
