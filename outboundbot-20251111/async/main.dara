  message?: string(name='Message', description='The message returned by the API.', example='Success'),
  params?: [ string ](name='Params', description='The variable values in the error message.'),
  requestId?: string(name='RequestId', description='The request ID.', example='254EB995-DEDF-48A4-9101-9CA5B72FFBCC'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='true'),
