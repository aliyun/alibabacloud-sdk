model CreateCampaignRequest {
  attemptOrder?: string(name='AttemptOrder', description='The call execution order. Default value: MIN_ATTEMPT_FIRST. Valid values:
- PRIORITY_FIRST: priority first.
- MIN_ATTEMPT_FIRST: minimum attempt count first.', example='MIN_ATTEMPT_FIRST'),
  callableTime?: string(name='CallableTime', description='The callable time range for the task. The value is a JSON object that contains two properties: beginTime and EndTime.

This parameter is required.', example='[{"beginTime":"09:00:00","endTime":"18:00:00" }]。'),
  caseFileKey?: string(name='CaseFileKey', description='The task contact list, which is an OSS object key obtained through the GenerateFileUploadParams operation. You can also leave this parameter empty and append contacts later through the AppendCases operation.', example='cases/customer.csv'),
  cases?: [ 
    {
      customVariables?: string(name='CustomVariables', description='The custom variables defined by the customer. The value is a JSON object that contains up to 10 properties. The name and value of each property are defined by the customer.', example='{"key1":"value1"}'),
      phoneNumber?: string(name='PhoneNumber', description='The phone number of the contact.', example='133********'),
      priority?: string(name='Priority', description='The priority of the contact. Default value: 1.', example='1'),
      referenceId?: string(name='ReferenceId', description='The business ID of the contact.', example='bizId-1'),
    }
  ](name='Cases', description='The contact list. You can also leave this parameter empty and append contacts later through the AppendCases operation.'),
  dialingTimeoutSeconds?: int32(name='DialingTimeoutSeconds', description='The dialing timeout period, in seconds. Default value: 25.', example='25'),
  endTime?: long(name='EndTime', description='The task end time.

This parameter is required.', example='1579965079000'),
  fixedQuota?: int32(name='FixedQuota', description='The minimum concurrency for the task. A value of 0 indicates no guaranteed minimum, and resources are allocated by weight.

If multiple tasks have a minimum concurrency configured:

- If the total concurrency is less than the instance total concurrency, the minimum concurrency of each task is satisfied first, and the remaining resources are allocated proportionally by weight.

- If the total concurrency exceeds the instance total concurrency, the minimum concurrency no longer serves as a guaranteed minimum but is used as a weight factor in the calculation.', example='0'),
  flashSmsParameters?: string(name='FlashSmsParameters', description='The flash SMS parameters.', example='{}'),
  holidayRestricted?: boolean(name='HolidayRestricted', description='Specifies whether to prohibit outbound calls on holidays.', example='false'),
  instanceId?: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='12f3dd08-0c55-44ce-9b64-e69d35ed3a76'),
  maxAttemptCount?: int32(name='MaxAttemptCount', description='The maximum number of attempts. This specifies the maximum number of times a number is called when the call fails.

This parameter is required.', example='2'),
  minAttemptInterval?: int32(name='MinAttemptInterval', description='The interval between attempts.

This parameter is required.', example='5'),
  name?: string(name='Name', description='The task name.

This parameter is required.', example='Updated_task_group'),
  numbers?: [ string ](name='Numbers', description='The list of caller numbers for the outbound task.'),
  redialRestrictions?: string(name='RedialRestrictions', description='The list of redial restriction conditions. If this parameter is not specified, no restrictions are applied. Valid values:
- CALLEE_NOT_EXISTS: Do not call nonexistent numbers.
- OUT_OF_SERVICE: Do not call numbers that are out of service.', example='None'),
  runUntilEndTime?: boolean(name='RunUntilEndTime', description='Specifies whether to keep the scheduling state until the task end time after all contacts are called. Default value: false. Valid values:
- true: The task remains in the scheduling state, and you can continue to append contacts.
- false: The task changes to completed, and you cannot append contacts.', example='false'),
  scriptId?: string(name='ScriptId', description='The scenario ID.

This parameter is required.', example='aa279896-64a6-4182-864c-4f2b04ec8d17'),
  startTime?: long(name='StartTime', description='The task start time.

This parameter is required.', example='1578965079000'),
  weight?: int32(name='Weight', description='The weight. The value is an integer in the range of 0 to 100. A larger value indicates more concurrency allocated during scheduling.', example='50'),
}

