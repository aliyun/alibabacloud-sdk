      lastRotationDate?: string(name='LastRotationDate', description='The time of the most recent rotation (UTC).
> This parameter is returned only when the secret has been rotated.', example='2023-07-05T08:22:03Z'),
      nextRotationDate?: string(name='NextRotationDate', description='The time of the next rotation (UTC).
> This parameter is returned only when automatic rotation is enabled.', example='2024-07-06T18:22:03Z'),
      requestId?: string(name='RequestId', description='The ID of this request, which is a unique identifier generated by Alibaba Cloud for troubleshooting purposes.', example='8252db58-2036-408c-a3d5-56e656dc2551'),
      rotationInterval?: string(name='RotationInterval', description='The interval for automatic rotation of the secret.
The format is integer[unit], where integer specifies the duration and unit specifies the time unit. The value of unit is s (seconds). For example, a rotation interval of 7 days is 604800s.

> This parameter is returned only when automatic rotation is enabled.', example='604800s'),
      secretData?: string(name='SecretData', description='The secret value. KMS decrypts the stored ciphertext secret value and returns this parameter.  

- A generic secret returns the secret value that you specified.

- An ApsaraDB RDS secret or Redis/Tair secret returns the secret value in the following format: `{"AccountName":"","AccountPassword":""}`.

- A RAM secret returns the secret value in the following format: `{"AccessKeyId":"Adfdsfd","AccessKeySecret":"fdsfdsf","GenerateTimestamp": "2023-03-25T10:42:40Z"}`.  

- An ECS secret returns the secret value in the following formats:  
  - Password-type secret: `{"UserName":"ecs-user","Password":"H5asdasdsads****"}`.  
  - Public-private key-type secret (private key in PEM format): `{"UserName":"ecs-user","PublicKey":"ssh-rsa ****mKwnVix9YTFY9Rs= imported-openssh-key","PrivateKey": "d6bee1cb-2e14-4277-ba6b-73786b21****"}`.

- A PolarDB secret returns the secret value in the following format: `{"AccountName":"","AccountPassword":""}`.', example='testdata1'),
      secretDataType?: string(name='SecretDataType', description='The type of the secret value. Valid values:
- text
- binary', example='binary'),
      secretName?: string(name='SecretName', description='The secret name.', example='secret001'),
      secretType?: string(name='SecretType', description='The type of the secret. Valid values:
- Generic: generic secret.  
- Rds: ApsaraDB RDS secret.  
- Redis: Redis/Tair secret.
- RAMCredentials: RAM secret.  
- ECS: ECS secret.
- PolarDB: PolarDB secret.', example='Generic'),
      versionId?: string(name='VersionId', description='The version number of the secret.', example='v1'),
      versionStages?: {
        versionStage?: [ string ](name='VersionStage', description='The version stages of the secret.'),
      }(name='VersionStages', description='The version stages of the secret.'),
    }
  ](name='SecretValues', description='The list of secrets that are successfully retrieved.'),
