    materialExpireTime?: string(name='MaterialExpireTime', description='The expiration time of the key material. The time is in UTC.<br> If this value is empty, the key material does not expire.<br>', example='2025-03-25T10:00:00Z'),
    nextRotationDate?: string(name='NextRotationDate', description='The time when the next rotation is scheduled.

