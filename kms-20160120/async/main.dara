  keyId?: string(name='KeyId', description='The GUID of the CMK.

> If you use an alias of the CMK in the request, the ID of the CMK to which the alias is bound is returned.', example='5c438b18-05be-40ad-b6c2-3be6752c****'),
  keyVersionId?: string(name='KeyVersionId', description='The ID of the key version. The ID is the GUID of the key version.', example='2ab1a983-7072-4bbc-a582-584b5bd8****'),
  requestId?: string(name='RequestId', description='The ID of the request, which is a unique identifier generated by Alibaba Cloud for the request. You can use the request ID to troubleshoot and locate issues.', example='475f1620-b9d3-4d35-b5c6-3fbdd941423d'),
