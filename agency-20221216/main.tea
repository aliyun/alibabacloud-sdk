    'us-west-1' = 'agency.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('agency', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AutomaticWriteOffRequest {
  automaticWriteOffAmount?: long(name='AutomaticWriteOffAmount', description='The automatic write-off amount. This parameter is required if automatic write-off is enabled. Valid values: 100, 500, and 1000.', example='100'),
  automaticWriteOffEnabled?: boolean(name='AutomaticWriteOffEnabled', description='Specifies whether to enable automatic write-off and set the automatic write-off amount. Valid values:
- true: Enables automatic write-off and sets the automatic write-off amount.
- false: Disables automatic write-off.

This parameter is required.', example='true'),
  customerUid?: long(name='CustomerUid', description='The UID of the customer.

This parameter is required.', example='123456'),
  language?: string(name='Language', description='The language. If this parameter is not specified, English is used by default. Valid values:
- en: English.
- zh: Chinese.
- ja: Japanese.', example='en'),
}

