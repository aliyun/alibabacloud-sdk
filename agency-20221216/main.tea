/**
 * @summary Configures the automatic write-off feature before the end-of-month settlement. When the consumed but undeducted quota reaches the specified automatic write-off amount, the amount is transferred to the deducted quota for offset.
 *
 * @param request AutomaticWriteOffRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AutomaticWriteOffResponse
 */
async function automaticWriteOffWithOptions(request: AutomaticWriteOffRequest, runtime: Util.RuntimeOptions): AutomaticWriteOffResponse {
  Util.validateModel(request);
  var query = {};
  if (!Util.isUnset(request.automaticWriteOffAmount)) {
    query['AutomaticWriteOffAmount'] = request.automaticWriteOffAmount;
  }
  if (!Util.isUnset(request.automaticWriteOffEnabled)) {
    query['AutomaticWriteOffEnabled'] = request.automaticWriteOffEnabled;
  }
  if (!Util.isUnset(request.customerUid)) {
    query['CustomerUid'] = request.customerUid;
  }
  if (!Util.isUnset(request.language)) {
    query['Language'] = request.language;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'AutomaticWriteOff',
    version = '2022-12-16',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Configures the automatic write-off feature before the end-of-month settlement. When the consumed but undeducted quota reaches the specified automatic write-off amount, the amount is transferred to the deducted quota for offset.
 *
 * @param request AutomaticWriteOffRequest
 * @return AutomaticWriteOffResponse
 */
async function automaticWriteOff(request: AutomaticWriteOffRequest): AutomaticWriteOffResponse {
  var runtime = new Util.RuntimeOptions{};
  return automaticWriteOffWithOptions(request, runtime);
}

