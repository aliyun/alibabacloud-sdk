model SubscriptionBillRequest {
  beginBillingCycle: string(name='BeginBillingCycle', description='The billing month from which to start pushing bills. Format: yyyy-MM.

After a successful subscription, the system automatically pushes data from the start billing cycle to the current time. Data for up to the last six months (including the current month) can be pushed. If the specified month exceeds this range, the subscription is invalid.

This parameter is required.', example='2022-10', position='Query'),
  billFormat: string(name='BillFormat', description='The bill file format. Valid values:
- csv
- parquet

If you subscribe to multiple file types, use separate buckets to avoid file overwriting.

This parameter is required.', example='csv', position='Query'),
  bucketOwnerId: long(name='BucketOwnerId', description='The UID of the account that owns the OSS bucket for storing files.

If a partner subscribes and needs to push files to the OSS bucket of a subordinate partner account, this account must be a subordinate partner account of the partner account. Grant the [AliyunConsumeDump2OSSRole](https://ram.console.aliyun.com/?spm=api-workbench.API%20Document.0.0.68c71e0fhmTSJp#/role/authorize?request=%7B%22Requests%22:%20%7B%22request1%22:%20%7B%22RoleName%22:%20%22AliyunConsumeDump2OSSRole%22,%20%22TemplateId%22:%20%22Dump2OSSRole%22%7D%7D,%20%22ReturnUrl%22:%20%22https:%2F%2Fusercenter2.aliyun.com%22,%20%22Service%22:%20%22Consume%22%7D) permission to the subordinate partner account. 

If a partner subscribes and pushes files to the partner account\\\\"s own OSS bucket, grant the [AliyunConsumeDump2OSSRole](https://ram.console.aliyun.com/?spm=api-workbench.API%20Document.0.0.68c71e0fhmTSJp#/role/authorize?request=%7B%22Requests%22:%20%7B%22request1%22:%20%7B%22RoleName%22:%20%22AliyunConsumeDump2OSSRole%22,%20%22TemplateId%22:%20%22Dump2OSSRole%22%7D%7D,%20%22ReturnUrl%22:%20%22https:%2F%2Fusercenter2.aliyun.com%22,%20%22Service%22:%20%22Consume%22%7D) permission to the partner account.

This parameter is required.', example='5569414254138836', position='Query'),
  subscribeBucket: string(name='SubscribeBucket', description='The name of the OSS bucket for storing bill files.

This parameter is required.', example='bill-bucket', position='Query'),
  subscribeSegmentSize?: int32(name='SubscribeSegmentSize', description='The row count threshold for a single bill file. If the number of rows exceeds this threshold, the file is automatically split into multiple files. The naming convention for split files is `uid_billType_billCycle_SquenceNo_fileNo`.

All information in the file names is identical except for fileNo. These files belong to the same billing cycle and the same file type but are split into multiple files.', example='100000', position='Query'),
  subscribeType: string(name='SubscribeType', description='The subscription type. Valid values: 
- PartnerBillingItemDetailForBillingPeriod: billing item detail.
- PartnerBillingItemDetailMonthly: billing item monthly bill.
- PartnerInstanceDetailForBillingPeriod: instance bill detail.
- PartnerInstanceDetailMonthly: instance monthly bill.

This parameter is required.', example='PartnerBillingItemDetailForBillingPeriod', position='Query'),
}

model SubscriptionBillResponseBody = {
  code?: string(name='Code', description='The status code.', example='200'),
  data?: boolean(name='Data', description='The data returned.', example='true'),
  message?: string(name='Message', description='The message returned.', example='成功'),
  requestId?: string(name='RequestId', description='The request ID.', example='9C14ADFE-DF0A-54D4-8BD5-45D0839246B4'),
  success?: boolean(name='Success', description='Indicates whether the request was successful.', example='true'),
}

model SubscriptionBillResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: SubscriptionBillResponseBody(name='body'),
}

/**
  * @description - Ensure that the caller is an Alibaba Cloud international master reseller partner.
  * - A user can subscribe to one type of bill file at a time.
  * - After subscription, bill files generated on the previous day are pushed daily starting from the next day. On the 5th of each month, full bill files for the previous billing cycle are pushed.
  * - Bill files generated on a daily basis may be delayed. Delayed bill files are pushed the day after they are generated and may include bills that were delayed from earlier days. Pull the full files for the previous month at the beginning of each month.
  * - Grant the [AliyunConsumeDump2OSSRole](https://ram.console.aliyun.com/?spm=api-workbench.API%20Document.0.0.68c71e0fhmTSJp#/role/authorize?request=%7B%22Requests%22:%20%7B%22request1%22:%20%7B%22RoleName%22:%20%22AliyunConsumeDump2OSSRole%22,%20%22TemplateId%22:%20%22Dump2OSSRole%22%7D%7D,%20%22ReturnUrl%22:%20%22https:%2F%2Fusercenter2.aliyun.com%22,%20%22Service%22:%20%22Consume%22%7D) permission to the subscribing user.
  * - File names.
  * ```.
  * BillingItemDetailForBillingPeriod   (Billing item detail)
  *   
  * Daily push file name format: UID_PartnerBillingItemDetail_YYYYMMDD_SquenceNo_fileNo. Example: 169**_BillingItemDetail_20190310_0001_01.
  *   
  * Full file name format at the beginning of the next month: UID_PartnerBillingItemDetail_YYYYMM_SquenceNo_fileNo. Example: 169**_BillingItemDetail_201903_0001_01.
  * InstanceDetailForBillingPeriod  (Instance bill detail)
  *  
  *  Daily push file name format: UID_PartnerInstanceDetail_YYYYMMDD_SquenceNo_fileNo. Example: 169**_InstanceDetail_20190310_0001_01.
  *   
  * Full file name format at the beginning of the next month: UID_PartnerInstanceDetail_YYYYMM_SquenceNo_fileNo. Example: 169**_InstanceDetail_201903_1999-0001_01.
  * BillingItemDetailMonthly   (Billing item monthly bill)
  *   
  * Daily push file name format: UID_PartnerBillingItemDetailMonthly_YYYYMM_SquenceNo_fileNo. Example: 169**_BillingItemDetailMonthly_201903_0001_01. This file is updated daily with full data from the beginning of the month to the current day, until the 5th of the next month.
  * InstanceDetailMonthly  (Instance monthly bill)
  *   
  * Daily push file name format: UID_PartnerInstanceDetailMonthly_YYYYMM_SquenceNo_fileNo. Example: 169**_InstanceDetailMonthly_201903_0001_01. This file is updated daily with full data from the beginning of the month to the current day, until the 5th of the next month.
  * fileNo exists only when the number of bill rows reaches the split threshold and the file is split.
  * ```
  * **This content is published only on the Chinese site.**.
  * @param request  the request parameters of SubscriptionBill  SubscriptionBillRequest
  * @return SubscriptionBillResponse
 */
async function subscriptionBill(request: SubscriptionBillRequest): SubscriptionBillResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'SubscriptionBill', 'POST', '/', 'json', false, 'json', request);
}

