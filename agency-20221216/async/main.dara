model AutomaticWriteOffRequest {
  automaticWriteOffAmount?: long(name='AutomaticWriteOffAmount', description='The automatic write-off amount. This parameter is required if automatic write-off is enabled. Valid values: 100, 500, and 1000.', example='100', position='Query'),
  automaticWriteOffEnabled: boolean(name='AutomaticWriteOffEnabled', description='Specifies whether to enable automatic write-off and set the automatic write-off amount. Valid values:
- true: Enables automatic write-off and sets the automatic write-off amount.
- false: Disables automatic write-off.

This parameter is required.', example='true', position='Query'),
  customerUid: long(name='CustomerUid', description='The UID of the customer.

This parameter is required.', example='123456', position='Query'),
  language?: string(name='Language', description='The language. If this parameter is not specified, English is used by default. Valid values:
- en: English.
- zh: Chinese.
- ja: Japanese.', example='en', position='Query'),
}

model AutomaticWriteOffResponseBody = {
  code?: string(name='Code', description='code', example='200'),
  data?: boolean(name='Data', description='Indicates whether the configuration is successful.', example='true'),
  message?: string(name='Message', description='The message.', example='Success'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='6fc1309b17543600398356606d0096'),
}

model AutomaticWriteOffResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AutomaticWriteOffResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AutomaticWriteOff  AutomaticWriteOffRequest
  * @return AutomaticWriteOffResponse
 */
async function automaticWriteOff(request: AutomaticWriteOffRequest): AutomaticWriteOffResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AutomaticWriteOff', 'POST', '/', 'json', false, 'json', request);
}

