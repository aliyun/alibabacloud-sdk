model CreateCouponTemplateRequest {
  acceptLanguage: string(name='AcceptLanguage', description='The accepted language.
Default value: None.
Valid values:
- zh-CN: Chinese.
- en-US: English.
- ja: Japanese.

This parameter is required.', example='zh-CN', position='Query'),
  applicableProducts: string(name='ApplicableProducts', description='The applicable products.
- All Products: All products.
- Custom: Custom products.

This parameter is required.', example='All Products', position='Query'),
  costBearer: string(name='CostBearer', description='The party that bears the coupon cost.
- Partner: Borne by the partner.
- Alibaba Cloud: Borne by Alibaba Cloud.

This parameter is required.', example='Partner', position='Query'),
  couponDescription?: string(name='CouponDescription', description='The remark for the coupon.
The field length is limited to 100 characters.', example='Coupon remark', maxLength=100, position='Query'),
  expireddate?: string(name='Expireddate', description='The end time of the effective period.
Format: yyyy-MM-dd.
Example: 2024-08-26.  
This parameter is required when the validity period is set to Custom Timeframe.', example='2024-08-26', position='Query'),
  limitPerPerson: string(name='LimitPerPerson', description='The maximum number of coupons that each person can claim.
- Limited to 1: Limited to one coupon.
- Unlimited: Unlimited.

This parameter is required.', example='Unlimited', position='Query'),
  productType?: [ string ](name='ProductType', description='The list of product codes.', shrink='json', position='Query'),
  purchaseType?: string(name='PurchaseType', description='The order type.', example='ALL', position='Query'),
  reasonForApplication: string(name='ReasonForApplication', description='The reason for the template application.
The field length is limited to 100 characters.

This parameter is required.', example='Reason for template application', maxLength=100, position='Query'),
  templateName: string(name='TemplateName', description='The template name.
The field length is limited to 30 characters.

This parameter is required.', example='Template name', maxLength=30, position='Query'),
  vailddate?: string(name='Vailddate', description='The start time of the effective period.
Format: yyyy-MM-dd.
Example: 2024-08-26.  
This parameter is required when the validity period is set to Custom Timeframe.', example='2024-08-26', position='Query'),
  vaildperioddays?: string(name='Vaildperioddays', description='The duration of the relative time in days.
The value must be a positive integer.
This parameter is required when the validity period is set to Validity Duration.', example='1', position='Query'),
  validUntil: string(name='ValidUntil', description='The validity period of the coupon.
- Validity Duration: From the date of issuance.
- Custom Timeframe: Custom time period.

This parameter is required.', example='Validity Duration', position='Query'),
  value: string(name='Value', description='The denomination of the coupon.
The value must be an integer.

This parameter is required.', example='1', position='Query'),
}

