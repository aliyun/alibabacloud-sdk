model CreateDirectoryRequest {
  directoryName?: string(name='DirectoryName', description='The name of the directory. The name must be globally unique.

Format: The name can contain lowercase letters, digits, and hyphens (-). It cannot start or end with a hyphen (-) and cannot contain two consecutive hyphens (-). It cannot start with `d-`.

Length: 2 to 64 characters.

> If you do not specify this parameter, the system automatically generates a name.', example='example', position='Query'),
}

model CreateDirectoryResponseBody = {
  directory?: {
    createTime?: string(name='CreateTime', description='The time when the directory was created. The time is displayed in UTC.', example='2021-10-10T04:04:04Z'),
    directoryId?: string(name='DirectoryId', description='The directory ID.', example='d-00fc2p61****'),
    directoryName?: string(name='DirectoryName', description='The name of the directory.', example='example'),
    region?: string(name='Region', description='The region ID of the directory.', example='cn-shanghai'),
    updateTime?: string(name='UpdateTime', description='The time when the directory was updated. The time is displayed in UTC.', example='2021-10-10T04:04:04Z'),
  }(name='Directory', description='The directory information.'),
  requestId?: string(name='RequestId', description='The request ID.', example='ADADC31D-90EE-5459-99B0-D83DF07769A3'),
}

model CreateDirectoryResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateDirectoryResponseBody(name='body'),
}

/**
  * @description ### Usage notes
  * A directory is an instance in CloudSSO. You must create a directory before you use CloudSSO. All CloudSSO resources must be maintained in the directory.
  * You must select a region for the CloudSSO directory. Alibaba Cloud ensures that all CloudSSO-related data is stored only in this region. This is independent of where you deploy cloud resources such as ECS and ApsaraDB RDS. You can log on to and access cloud resources in any region from anywhere in the world. You can select a region based on your security and compliance requirements and the geographic location of your target users. If you do not have special security and compliance requirements, select the region closest to your target users to improve access speed. Currently, you can create directories in the following four regions: China (Shanghai), China (Hong Kong), US (Silicon Valley), and Germany (Frankfurt).
  * This topic provides an example on how to create a directory named `example` in the China (Shanghai) region.
  * ### Limits
  * - A management account can create only one directory.
  * - To change the region of the directory, you must delete the existing directory and create a new one in another region.
  * @param request  the request parameters of CreateDirectory  CreateDirectoryRequest
  * @return CreateDirectoryResponse
 */
async function createDirectory(request: CreateDirectoryRequest): CreateDirectoryResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateDirectory', 'POST', '/', 'json', false, 'json', request);
}

