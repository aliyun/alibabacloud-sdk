 */
async function addExternalSAMLIdPCertificate(request: AddExternalSAMLIdPCertificateRequest): AddExternalSAMLIdPCertificateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddExternalSAMLIdPCertificate', 'POST', '/', 'json', false, 'json', request);
}

model AddPermissionPolicyToAccessConfigurationRequest {
  accessConfigurationId?: string(name='AccessConfigurationId', description='The access configuration ID.', example='ac-00jhtfl8thteu6uj****', position='Query'),
  directoryId?: string(name='DirectoryId', description='The directory ID.', example='d-00fc2p61****', position='Query'),
  inlinePolicyDocument?: string(name='InlinePolicyDocument', description='The content of the inline policy.

The maximum length is 4,096 characters.

If PermissionPolicyType is set to Inline, this parameter is required. For more information about the syntax and structure of access policies, see [Access policy syntax and structure](https://help.aliyun.com/document_detail/93739.html).', example='{"Statement": [{"Action": "*","Effect": "Allow","Resource": "*"}],"Version": "1"}', position='Query'),
  permissionPolicyName?: string(name='PermissionPolicyName', description='The name of the access policy. 
- If PermissionPolicyType is set to System, this parameter specifies the name of the system policy. Because RAM system policies are reused, you must obtain the system policy name from RAM.
- If PermissionPolicyType is set to Inline, this parameter specifies the name of the inline policy. You can customize the name. The name can be up to 32 characters in length.', example='AliyunECSFullAccess', position='Query'),
  permissionPolicyType?: string(name='PermissionPolicyType', description='The type of the access policy. Valid values:

- System: system policy. Reuses the system policies of Resource Access Management (RAM).
- Inline: inline policy. A custom policy written based on the syntax and structure of RAM policies.', example='System', position='Query'),
}

model AddPermissionPolicyToAccessConfigurationResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='B7C6E839-FB65-59BE-B753-003AA8AF7DF7'),
}

model AddPermissionPolicyToAccessConfigurationResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddPermissionPolicyToAccessConfigurationResponseBody(name='body'),
}

/**
  * @description This topic provides an example of adding a system policy named `AliyunECSFullAccess` to the access configuration `ac-00jhtfl8thteu6uj****`.
  * @param request  the request parameters of AddPermissionPolicyToAccessConfiguration  AddPermissionPolicyToAccessConfigurationRequest
  * @return AddPermissionPolicyToAccessConfigurationResponse
 */
async function addPermissionPolicyToAccessConfiguration(request: AddPermissionPolicyToAccessConfigurationRequest): AddPermissionPolicyToAccessConfigurationResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddPermissionPolicyToAccessConfiguration', 'POST', '/', 'json', false, 'json', request);
}

