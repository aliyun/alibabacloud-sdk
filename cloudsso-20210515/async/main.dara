The maximum duration of a session when a CloudSSO user uses the access configuration to access an account in a resource directory.

Unit: seconds.

Valid values: 900 to 43200 (15 minutes to 12 hours).

Default value: 3600 (1 hour).', example='3600', position='Query'),
  tags?: [ 
    {
      key?: string(name='Key', description='The tag key.', example='TestKey'),
      value?: string(name='Value', description='The tag value.', example='TestValue'),
    }
  ](name='Tags', description='The list of tags.', position='Query'),
}

