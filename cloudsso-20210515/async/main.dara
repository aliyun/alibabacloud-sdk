model CreateUserProvisioningRequest {
  deletionStrategy?: string(name='DeletionStrategy', description='The deletion policy. Specifies the action to take for synchronized Resource Access Management (RAM) users when a Resource Access Management (RAM) user synchronization is deleted. Valid values:

- Delete: Delete. When a Resource Access Management (RAM) user synchronization is deleted, the system deletes the Resource Access Management (RAM) users that have been synchronized from CloudSSO to RAM.
- Keep: Keep. When a Resource Access Management (RAM) user synchronization is deleted, the system retains the Resource Access Management (RAM) users that have been synchronized from CloudSSO to RAM.', example='Delete', position='Query'),
  description?: string(name='Description', description='The description.', example='This is a user provisioning.', position='Query'),
  directoryId?: string(name='DirectoryId', description='The ID of the directory.', example='d-003qew84****', position='Query'),
