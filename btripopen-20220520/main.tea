 * - To use this API, you must include the enterprise access token (x-acs-btrip-corp-token) in the request header. For information about how to obtain the enterprise access token, see [Enterprise access token](https://openapi.alibtrip.com/doc/toDocDetail?docId=3769985).
 *
 * @param request FlightOtaSearchRequest
 * @return FlightOtaSearchResponse
 */
async function flightOtaSearch(request: FlightOtaSearchRequest): FlightOtaSearchResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers = new FlightOtaSearchHeaders{};
  return flightOtaSearchWithOptions(request, headers, runtime);
}

