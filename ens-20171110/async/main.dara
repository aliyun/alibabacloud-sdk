model SetLoadBalancerHTTPListenerAttributeRequest {
  description?: string(name='Description', description='The listener name. The name must be **1** to **80** characters in length.

> The name cannot start with `http://` or `https://`.', example='Listener description', minLength=1, maxLength=80, position='Query'),
  healthCheck?: string(name='HealthCheck', description='Specifies whether to enable health checks. Valid values:
- **on**: enabled.
- **off**: disabled.', example='on', position='Query'),
  healthCheckConnectPort?: int32(name='HealthCheckConnectPort', description='The port used for health checks. Valid values: **1** to **65535**. If this parameter is not configured in Settings, the backend service port (BackendServerPort) is used.

> This parameter takes effect only when HealthCheck is set to on.', example='65500', minimum=1, maximum=65535, position='Query'),
  healthCheckDomain?: string(name='HealthCheckDomain', description='The domain name used for health checks.

> This parameter takes effect only when HealthCheck is set to on.', example='www.aliyundoc.com', minLength=1, maxLength=80, position='Query'),
  healthCheckHttpCode?: string(name='HealthCheckHttpCode', description='The HTTP status code that indicates a successful health check. Valid values:

- **http_2xx** (default).
- **http_3xx**.
- **http_4xx**.
- **http_5xx**.

> This parameter takes effect only when HealthCheck is set to on.', example='http_2xx', position='Query'),
  healthCheckInterval?: int32(name='HealthCheckInterval', description='The interval between two consecutive health checks. Valid values: **1** to **50**. Unit: seconds.

> This parameter takes effect only when HealthCheck is set to on.', example='2', minimum=1, maximum=50, position='Query'),
  healthCheckMethod?: string(name='HealthCheckMethod', description='The health check method for the HTTP listener. Valid values:

- **head**.
- **get**.

> This parameter takes effect only when HealthCheck is set to on.', example='head', position='Query'),
  healthCheckTimeout?: int32(name='HealthCheckTimeout', description='The amount of time to wait for a response from a health check. If the backend ECS instance does not respond within the specified time, the health check fails.
- Default value: 5 seconds.
- Valid values: **1** to **300**.
- Unit: seconds.
> - This parameter takes effect only when HealthCheck is set to on.
>- If the value of HealthCheckTimeout is less than the value of HealthCheckInterval, HealthCheckTimeout becomes ineffective and the timeout period equals the value of HealthCheckInterval.', example='5', minimum=1, maximum=300, position='Query'),
  healthCheckURI?: string(name='HealthCheckURI', description='The URI used for health checks. The URI must be **1** to **80** characters in length.

> - The URI cannot be only `/` but must start with `/`.
>- This parameter takes effect only when HealthCheck is set to on.', example='/checkpreload.htm', minLength=1, maxLength=80, position='Query'),
  healthyThreshold?: int32(name='HealthyThreshold', description='The number of consecutive successful health checks required before a backend server is declared healthy (changing the status from fail to success). Valid values: **2** to **10**.
> This parameter takes effect only when HealthCheck is set to on.', example='3', minimum=2, maximum=10, position='Query'),
  idleTimeout?: int32(name='IdleTimeout', description='The idle connection timeout period. Default value: 15 seconds. Valid values: **1** to **60**. Unit: seconds.

> If no access request is received within the timeout period, the load balancing instance temporarily breaks the current connection and re-establishes a new connection when the next request arrives.', example='15', minimum=1, maximum=60, position='Query'),
  listenerPort: int32(name='ListenerPort', description='The listener port whose attributes you want to modify. Valid values: **1** to **65535**.

This parameter is required.', example='8080', minimum=1, maximum=65535, position='Query'),
  loadBalancerId: string(name='LoadBalancerId', description='The ID of the load balancing instance.

This parameter is required.', example='lb-5snthcyu1x10g7tywj7iu****', position='Query'),
  requestTimeout?: int32(name='RequestTimeout', description='The request timeout period. Default value: 60 seconds. Valid values: **1** to **180**. Unit: seconds.

> If no response is received from the backend server within the timeout period, the load balancing instance stops waiting and returns an HTTP 504 error code to the client.', example='60', minimum=1, maximum=180, position='Query'),
  scheduler?: string(name='Scheduler', description='The scheduling algorithm. Valid values:
- **wrr**: Backend servers with higher weights are polled more frequently.
- **wlc**: Requests are distributed based on the weight and actual load (number of connections) of each backend server. When the weights are the same, backend servers with fewer connections are polled more frequently.
- **rr**: Requests are distributed to backend servers in sequence.
- **sch**: Consistent hashing based on source IP addresses. Requests from the same source IP address are distributed to the same backend server.
- **qch**: Consistent hashing based on QUIC Connection IDs. Requests with the same QUIC Connection ID are distributed to the same backend server.
- **iqch**: Consistent hashing based on specific three bytes of the iQUIC CID. Requests with the same 2nd to 4th bytes are distributed to the same backend server.', example='wrr', position='Query'),
  unhealthyThreshold?: int32(name='UnhealthyThreshold', description='The number of consecutive failed health checks required before a backend server is declared unhealthy (changing the status from success to fail). Valid values: **2** to **10**.
> This parameter takes effect only when HealthCheck is set to on.', example='3', minimum=2, maximum=10, position='Query'),
  xForwardedFor?: string(name='XForwardedFor', description='Specifies whether to use the X-Forwarded-For header to retrieve the originating IP address of the client. Valid values:
- **on** (default): enabled.
- **off**: disabled.', example='on', position='Query'),
}

