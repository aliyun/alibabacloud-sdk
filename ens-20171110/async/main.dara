  autoUseCoupon?: string(name='AutoUseCoupon', description='Specifies whether to use coupons. Default value: true (AutoUseCoupon=true).', example='true', position='Query'),
  billingCycle?: string(name='BillingCycle', description='The billing cycle for instance compute resources. Only instance-level pay-as-you-go is supported. Valid values:

- **Day**: daily billing.

- **Month**: monthly billing.', example='Day', position='Query'),
  carrier?: string(name='Carrier', description='The carrier.
