  bandwidth?: int32(name='Bandwidth', description='The peak bandwidth of the load balancer. A value of -1 indicates that no rate limit is applied.', example='5'),
  description?: string(name='Description', description='The listener name.', example='example'),
  eipTransmit?: string(name='EipTransmit', description='Specifies whether to enable EIP passthrough. Valid values:

- **on**: Enabled.

- **off** (default): Disabled.', example='on'),
  establishedTimeout?: int32(name='EstablishedTimeout', description='The connection timeout period. Valid values: **10** to **900**. Unit: seconds.', example='500'),
  healthCheck?: string(name='HealthCheck', description='Specifies whether to enable health checks. Valid values:

- **on**: Enabled.

- **off**: Disabled.', example='on'),
  healthCheckConnectPort?: int32(name='HealthCheckConnectPort', description='The port used for health checks. Valid values: **1** to **65535**. If you do not specify this parameter, the value of `BackendServerPort` is used.', example='8000'),
  healthCheckConnectTimeout?: int32(name='HealthCheckConnectTimeout', description='The timeout period for a health check response. If a backend ENS instance does not respond within the specified timeout period, the health check fails.

- Default value: 5.

- Valid values: **1** to **300**.

- Unit: seconds.

> * This parameter takes effect only when `HealthCheck` is set to `on`.
>
> * If the value of `HealthCheckConnectTimeout` is less than the value of `HealthCheckInterval`, the value of `HealthCheckInterval` is used as the timeout period.', example='100'),
  healthCheckExp?: string(name='HealthCheckExp', description='The response string for UDP health checks. The string can contain only letters and digits and can be up to 64 characters in length.', example='ok'),
  healthCheckInterval?: int32(name='HealthCheckInterval', description='The interval between health checks. Valid values: **1** to **50**. Unit: seconds.

> This parameter takes effect only when `HealthCheck` is set to `on`.', example='5'),
  healthCheckReq?: string(name='HealthCheckReq', description='The request string for UDP health checks. The string can contain only letters and digits and can be up to 64 characters in length.', example='hello'),
  healthyThreshold?: int32(name='HealthyThreshold', description='The number of consecutive successful health checks that must occur before a backend server can be declared healthy. Valid values: **2** to **10**.

> This parameter takes effect only when `HealthCheck` is set to `on`.', example='4'),
  listenerPort?: int32(name='ListenerPort', description='The listener port.', example='80'),
  requestId?: string(name='RequestId', description='The request ID.', example='5D7597CF-1630-54EC-A945-624A33F2E7E8'),
  scheduler?: string(name='Scheduler', description='The scheduling algorithm. Valid values:

- **wrr** (Weighted Round Robin): Backend servers with higher weights receive a larger proportion of requests.

- **wlc** (Weighted Least Connections): Requests are distributed based on both the weight and the current connection count of each backend server. If backend servers have the same weight, the server with the fewest connections receives more new requests.

- **rr** (Round Robin): Requests are distributed to backend servers sequentially.

- **sch** (Source IP Hash): Routes requests from the same source IP address to the same backend server by using a consistent hash of the source IP address.

- **tch** (4-tuple Hash): Routes packets from the same flow to the same backend server by using a consistent hash of the 4-tuple (source IP address, destination IP address, source port, and destination port).

- **qch** (QUIC Connection ID Hash): Uses a consistent hashing algorithm on the QUIC Connection ID to ensure that requests with the same connection ID are always routed to the same backend server.

- **iqch** (iQUIC CID Hash): Uses a consistent hashing algorithm on bytes 2, 3, and 4 of the iQUIC CID. Requests where these three bytes are the same are routed to the same backend server.', example='wrr'),
  status?: string(name='Status', description='The status of the listener. Valid values:

- **Running**: The listener is running.

- **Stopped**: The listener is stopped.

- **Starting**: The listener is starting.

- **Configuring**: The listener is being configured.

- **Stopping**: The listener is being stopped.', example='Stopped'),
  unhealthyThreshold?: int32(name='UnhealthyThreshold', description='The number of consecutive failed health checks that must occur before a backend server can be declared unhealthy. Valid values: **2** to **10**.

> This parameter takes effect only when `HealthCheck` is set to `on`.', example='4'),
}

