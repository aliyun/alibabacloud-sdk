  cloudAssistantRegion?: string(name='CloudAssistantRegion', description='The region for Cloud Assistant access. Valid values: cn-zhangjiakou (Zhangjiakou) and ap-southeast-1 (Singapore).', example='cn-zhangjiakou', position='Query'),
  dataDisk?: [ 
    {
