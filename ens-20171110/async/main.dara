model CreateSDGRequest {
  billingCycle?: string(name='BillingCycle', description='The billing logic for SDG child disks. This parameter specifies the billing method for the RBD child disks produced by this SDG. This parameter does not apply to standard cloud disks.
Optional parameter values:

- Hour.

-  Day. This is the default value.


> - Parameter description: The longer the cycle, the lower the cost. If the disk is released before the billing cycle ends, a service fee is charged.', example='Day', position='Query'),
  description?: string(name='Description', description='The description of the SDG.
> Provide a detailed description for easier future queries.', example='Test SDG', position='Query'),
  diskType?: string(name='DiskType', description='The type of the source disk.
Optional parameter values:
-  standard: standard cloud disk. This is the default value.
-  rbd: RBD disk.

> - Limits: RBD disk SDGs and standard disk SDGs cannot inherit from each other.', example='standard', position='Query'),
  fromSDGId?: string(name='FromSDGId', description='The ID of an existing SDG.
> - If you are creating an SDG for the first time, leave **FromSDGId** empty.
>- If **FromSDGId** is invalid or the corresponding raw cloud disk cannot be found, an error is returned.
>- If **FromSDGId** is not empty, this indicates that you are operating on an existing SDG rather than creating one for the first time.', example='sdg-xxxxx', position='Query'),
  instanceId: string(name='InstanceId', description='The AIC instance ID. You can call the [DescribeARMServerInstances](~~DescribeARMServerInstances~~) operation to obtain the InstanceId value.

This parameter is required.', example='aic-xxxx', position='Query'),
  performanceLevel?: long(name='PerformanceLevel', description='The SDG sharing ratio parameter. This parameter supports cloud disks with different maximum sharing ratios.', example='100', position='Query'),
  size?: string(name='Size', description='The maximum capacity of the SDG. Unit: GB.
>- To reduce costs, evaluate the required capacity as needed.
>- If you are creating an SDG for the first time, **Size** is required.
>- If the data volume increases later, pass a new **Size** value to expand the capacity. If **Size** is not empty and is greater than the original **Size** value of the SDG, the raw cloud disk of the SDG is expanded to the specified **Size**. If **Size** is empty or the specified **Size** is less than the original **Size** value of the SDG, no action is taken.

The minimum tested usable value is 150 GB.', example='150', position='Query'),
}

model CreateSDGResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E'),
  SDGId?: string(name='SDGId', description='The ID of the generated SDG.', example='sdg-xxxx'),
}

model CreateSDGResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateSDGResponseBody(name='body'),
}

/**
  * @description A Shared Data Group (SDG) is a data partition image of a virtual device. You can save the data partition of a virtual device as an SDG. The SDG can then be deployed to the data partition of other virtual devices for fast data sharing and application deployment. The following describes the workflow of SDG-related operations:
  * - Call the [CreateSDG](~~CreateSDG~~) operation to create an SDG. The SDG is bound to AIC instance A (InstanceId). After the SDG is created, a blank cloud disk (also called a raw cloud disk) is mounted to device A (InstanceId) for SDG creation.
  * - Install applications, deliver files, and perform other required operations on AIC instance A (InstanceId).
  * - Call the [SaveSDG](~~SaveSDG~~) operation to save the data cloud disk of AIC instance A as SDG A.
  * - Call the [DeploySDG](~~DeploySDG~~) operation to deploy SDG A to AIC instance B. This process is asynchronous. You can call the [DescribeARMServerInstances](~~DescribeARMServerInstances~~) operation to query the status of AIC instance B. When the status changes back to success, AIC instance B is available and has the same applications as AIC instance A.
  * @param request  the request parameters of CreateSDG  CreateSDGRequest
  * @return CreateSDGResponse
 */
async function createSDG(request: CreateSDGRequest): CreateSDGResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateSDG', 'GET', '/', 'json', false, 'json', request);
}

