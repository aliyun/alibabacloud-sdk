  rescaleLevel?: string(name='RescaleLevel', description='The level of the scaling region. Valid values:

- AreaIspCode: region ISP.
- RegionId: edge zone.
- InstanceId: instance. Scale-out indicates resource hosting. Scale-in indicates resource release.

Default value: AreaIspCode.', example='RegionId', position='Query'),
  rescaleType: string(name='RescaleType', description='The scaling action for resources. Valid values:
- Add: Provisions new resources.
- Del: Releases resources.

This parameter is required.', example='Add', position='Query'),
  resourceSelector: string(name='ResourceSelector', description='The scaling resource requirements. The value is a string in JSON array format.

This parameter is required.', example='[{\\\\"regionCode\\\\": \\\\"cn-wuxi-telecom_unicom_cmcc-3\\\\",    \\\\"ispCode\\\\": \\\\"telecom\\\\",    \\\\"count\\\\": 2	},{    \\\\"regionCode\\\\": \\\\"cn-shanghai-cmcc\\\\",    \\\\"count\\\\": 4	}]', position='Query'),
  timeout?: int32(name='Timeout', description='The timeout period for asynchronous scaling, in seconds. Default value: 300.', example='1800', position='Query'),
  toAppVersion?: string(name='ToAppVersion', description='The application deployment version for new resources. This parameter takes effect only when resources are added. Default value: the stable version number of the application.', example='v2', position='Query'),
}

model RescaleApplicationResponseBody = {
