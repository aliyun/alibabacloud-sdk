  hostName?: string(name='HostName', description='The hostname.', example='test-HostName', position='Query'),
  imageId?: string(name='ImageId', description='The image ID. This parameter cannot be specified for ARM-based instances. This parameter is required for other instance types.', example='m-5si16wo6simkt267p8b7h****', position='Query'),
