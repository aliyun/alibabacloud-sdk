  unhealthyThreshold?: int32(name='UnhealthyThreshold', description='The number of consecutive failed health checks that must occur before the health check status of a backend server is changed from success (reachable) to fail (unreachable). Valid values: **2** to **10**.
> This parameter takes effect only when HealthCheck is set to on.', example='3'),
  XForwardedFor?: string(name='XForwardedFor', description='Indicates whether the X-Forwarded-For header is used to retrieve the originating IP addresses of clients. Valid values:
