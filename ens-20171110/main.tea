  healthyThreshold?: int32(name='HealthyThreshold', description='The number of consecutive successful health checks that must occur before the health check status of a backend server is changed from fail (unreachable) to success (reachable). Valid values: **2** to **10**.
> This parameter takes effect only when HealthCheck is set to on.', example='3'),
  idleTimeout?: int32(name='IdleTimeout', description='The idle connection timeout period. Default value: 15. Valid values: **1** to **60**. Unit: seconds.
> If no request is received within the specified timeout period, load balancing temporarily interrupts the current connection and establishes a new connection when the next request arrives.', example='15'),
  listenerForward?: string(name='ListenerForward', description='Indicates whether HTTP-to-HTTPS forwarding is enabled. Valid values:
