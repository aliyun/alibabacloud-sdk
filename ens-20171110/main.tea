import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-beijing' = 'ens.aliyuncs.com',
    'cn-chengdu' = 'ens.aliyuncs.com',
    'cn-hangzhou' = 'ens.aliyuncs.com',
    'cn-heyuan' = 'ens.aliyuncs.com',
    'cn-shanghai' = 'ens.aliyuncs.com',
    'cn-wulanchabu' = 'ens.aliyuncs.com',
    'cn-zhangjiakou' = 'ens.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('ens', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

