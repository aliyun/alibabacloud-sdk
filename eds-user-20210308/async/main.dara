      phone?: string(name='Phone', description='<props="china">The phone number. The phone number is used to receive relevant text messages, such as notification text messages for cloud computer allocation. You must specify either the email address or the phone number.

<props="intl">Phone numbers are not supported on the international site.', example='1381111****'),
      realNickName?: string(name='RealNickName', description='The display name of the user.', example='Bean'),
      remark?: string(name='Remark', description='The user remarks.', example='remark1'),
