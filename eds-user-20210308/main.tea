  autoLockTime?: string(name='AutoLockTime', description='The date when the account is automatically locked. Specify the date in the yyyy-MM-dd HH:mm:ss format.', example='2025-11-28 00:00:00'),
  businessChannel?: string(name='BusinessChannel', description='The channel.', example='ENTERPRISE'),
  isLocalAdmin?: boolean(name='IsLocalAdmin', description='Specifies whether to set the convenience account as a local administrator.', example='true'),
  password?: string(name='Password', description='The initial password. If you do not specify this parameter, a password reset email is sent to the user\\\\"s email address.', example='Test123****'),
  passwordExpireDays?: string(name='PasswordExpireDays', description='The validity period of the password for the user account. By default, the password never expires. You can set this parameter to a value from 30 to 365 to specify the validity period in days. After the password expires, the end user must change the password before logging on again.

> This feature is in invitational preview. To use this feature, submit a ticket.', example='30'),
  users?: [ 
    {
      email?: string(name='Email', description='The email address. The email address is used to receive relevant emails, such as notification emails for cloud computer allocation. You must specify either the email address or the phone number.', example='username@example.com'),
      endUserId?: string(name='EndUserId', description='The username. The username is custom and must be 3 to 24 characters in length. It can contain only lowercase letters, digits, and underscores.

This parameter is required.', example='alice'),
      groupIdList?: [ string ](name='GroupIdList', description='The IDs of the user groups to join.'),
      orgId?: string(name='OrgId', description='The organization to which the user belongs.', example='design'),
