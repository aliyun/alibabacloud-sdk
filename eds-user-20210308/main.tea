/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('eds-user', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model GroupResources {
  region?: string(name='Region'),
  resourceId?: string(name='ResourceId'),
  resourceType?: string(name='ResourceType'),
}

model ThirdApp {
  appKey?: string(name='AppKey', description='The application ID.'),
  name?: string(name='Name', description='The application name.'),
  oidcSsoConfig?: {
    accessTokenEffectiveTime?: int32(name='AccessTokenEffectiveTime', description='1'),
    codeEffectiveTime?: int32(name='CodeEffectiveTime', description='1'),
    enableAuthLogin?: boolean(name='EnableAuthLogin', description='Specifies whether to enable authorized logon.'),
    endpoints?: {
      authorizationEndpoint?: string(name='AuthorizationEndpoint', description='The authorization endpoint.'),
      discoveryEndpoint?: string(name='DiscoveryEndpoint', description='The discovery endpoint.'),
      guestAuthorizationEndpoint?: string(name='GuestAuthorizationEndpoint', description='The guest authorization endpoint.'),
      issuer?: string(name='Issuer', description='Issuer'),
      jwksEndpoint?: string(name='JwksEndpoint', description='The signature public key endpoint.'),
      logoutEndpoint?: string(name='LogoutEndpoint', description='The logout endpoint.'),
      revokeEndpoint?: string(name='RevokeEndpoint', description='The revocation endpoint.'),
      tokenEndpoint?: string(name='TokenEndpoint', description='The token endpoint.'),
      userinfoEndpoint?: string(name='UserinfoEndpoint', description='The user information endpoint.'),
    }(name='Endpoints', description='The endpoints.'),
    grantScopes?: [ string ](name='GrantScopes', description='The grant scopes.'),
    grantTypes?: [ string ](name='GrantTypes', description='The grant types.'),
    idTokenAlgorithmType?: string(name='IdTokenAlgorithmType', description='The signature type.'),
    idTokenEffectiveTime?: int32(name='IdTokenEffectiveTime', description='1'),
    redirectUris?: [ string ](name='RedirectUris', description='The URI whitelist.'),
    refreshTokenEffective?: int32(name='RefreshTokenEffective', description='1'),
  }(name='OidcSsoConfig', description='The OIDC configuration.'),
  secrets?: [ 
    {
      enable?: boolean(name='Enable', description='Specifies whether it is enabled.'),
      secret?: string(name='Secret', description='The ciphertext.'),
    }
  ](name='Secrets', description='The secrets.'),
}

