    value?: string(name='Value', description='The source content of the parameter value specified by Form. When Form is set to CONSTANT, this value is the content.', example='DEMO CONTENT'),
  }(name='Mqtt5UserProperty', description='The user properties.'),
  parentTopic?: string(name='ParentTopic', description='The parent topic of the destination MQTT instance.', example='example-topic'),
