  }(name='Partition', description='The partition key for the event. This key routes events to a specific partition in the target service, ensuring ordered processing.'),
  workspaceId?: string(name='WorkspaceId', description='The unique ID of the Model Studio workspace.', example='llm-a1b2c3d4e5f6g7h8'),
