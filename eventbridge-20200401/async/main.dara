      sslKeyPassword?: string(name='SslKeyPassword', description='[Required for encrypted private keys] The password for the Kafka client private key. If the client private key is protected by a password (that is, the PEM file contains the \\\\"Proc-Type: 4,ENCRYPTED\\\\" or \\\\"ENCRYPTED\\\\" tag), you must provide the decryption password. Leave this parameter empty if the private key is not encrypted. Note: This password is used only to decrypt the private key and is irrelevant to Kafka authentication.', example='yourPassword'),
      sslKeystoreCertificateChain?: string(name='SslKeystoreCertificateChain', description='[Required for mutual authentication] The Kafka client certificate chain. If mutual SSL authentication (ssl.client.auth=required) is enabled on the Kafka server, you must provide this parameter. Format requirements: Base64-encoded PEM format, including the client certificate and the complete certificate chain (the client certificate first, followed by the intermediate CA certificate, and the root CA certificate is optional). Note: Ensure that the content of each PEM file starts with \\\\"-----BEGIN CERTIFICATE-----\\\\" and ends with \\\\"-----END CERTIFICATE-----\\\\". Concatenate them before Base64 encoding.', example='"SslKeystoreCertificateChain"'),
      sslKeystoreKey?: {
        kmsArn?: string(name='KmsArn', description='[Required] The ARN of the KMS resource that stores the SSL private key. This parameter is used to locate the KMS instance that stores the client private key. Format example: \\\\"acs:kms:cn-hangzhou:123456789:secret/ssl-keystore-key-xxxx\\\\". How to obtain: View the ARN information of the corresponding key in the KMS console.', example='"KmsArn"'),
        kmsSecretValueKey?: string(name='KmsSecretValueKey', description='[KMS KV mode] The key name in the KMS secret. If the secret stored in KMS uses a key-value pair (KV) structure, specify this parameter to indicate the key corresponding to the SSL private key. Example: If the KMS secret is \\\\"{"ssl_keystore_key":"-----BEGIN PRIVATE KEY-----...","ssl_truststore_key":"..."}\\\\", enter \\\\"ssl_keystore_key\\\\". If the KMS secret uses the plaintext mode (directly storing the PEM content of the private key), leave this parameter empty.', example='"KmsSecretValueKey"'),
      }(name='SslKeystoreKey', description='[Required for bidirectional authentication] The SSL private key configuration object. When bidirectional SSL authentication is enabled on the Kafka server, you must provide the client private key. The key only supports the KMS pattern. You can use KmsArn to specify the Key Management Service (KMS) EPS resource that stores the private key. The system retrieves the private key content from KMS only in memory, which provides higher security. Configuration example: {"KmsArn": "acs:kms:cn-hangzhou:123456789:secret/ssl-key-xxxx", "KmsSecretValueKey": "keystore_private_key"}.'),
      sslTruststoreCertificates?: string(name='SslTruststoreCertificates', description='[Required for SSL scenarios] The Kafka server trust certificate. This certificate is used to authenticate the legitimacy of the SSL certificate of the Kafka broker and prevent man-in-the-middle attacks. Format requirements: PEM format with Base64 encoding, which typically includes the CA certificate of the Kafka server or the server certificate itself. Example: Perform Base64 encoding on the content of the CA certificate PEM file (ensure that the content starts with \\\\"-----BEGIN CERTIFICATE-----\\\\" and ends with \\\\"-----END CERTIFICATE-----\\\\"). If Kafka uses a self-signed certificate, you must provide the CA certificate that issued the certificate.', example='"SslTruststoreCertificates"'),
