        kmsArn?: string(name='KmsArn', description='[Required] The ARN of the KMS resource that stores the SSL private key. This parameter is used to locate the KMS instance that stores the client private key. Format example: \\\\"acs:kms:cn-hangzhou:123456789:secret/ssl-keystore-key-xxxx\\\\". How to obtain: View the ARN information of the corresponding key in the KMS console.', example='"KmsArn"'),
        kmsSecretValueKey?: string(name='KmsSecretValueKey', description='[KMS KV mode] The key name in the KMS secret. If the secret stored in KMS uses a key-value pair (KV) structure, specify this parameter to indicate the key corresponding to the SSL private key. Example: If the KMS secret is \\\\"{"ssl_keystore_key":"-----BEGIN PRIVATE KEY-----...","ssl_truststore_key":"..."}\\\\", enter \\\\"ssl_keystore_key\\\\". If the KMS secret uses the plaintext mode (directly storing the PEM content of the private key), leave this parameter empty.', example='"KmsSecretValueKey"'),
      }(name='SslKeystoreKey', description='[Required for bidirectional authentication] The SSL private key configuration object. If bidirectional SSL authentication is enabled on the Kafka server, you must provide the client private key. Only the KMS pattern is supported for the key: specify the Key Management Service (KMS) EPS resource that stores the private key by using KmsArn. The system retrieves the private key content from KMS only in memory, which provides higher security. Configuration example: {"KmsArn": "acs:kms:cn-hangzhou:123456789:secret/ssl-key-xxxx", "KmsSecretValueKey": "keystore_private_key"}'),
      sslTruststoreCertificates?: string(name='SslTruststoreCertificates', description='[Required for SSL scenarios] The Kafka server trusted certificate. This parameter is used to authenticate the validity of the SSL certificate of the Kafka broker and prevent man-in-the-middle attacks. Format requirements: Base64 encoding in PEM format, which usually contains the CA certificate of the Kafka server or the server certificate itself. Example: Perform Base64 encoding on the content of the PEM file of the CA certificate (ensure that it starts with \\\\"-----BEGIN CERTIFICATE-----\\\\" and ends with \\\\"-----END CERTIFICATE-----\\\\"). If Kafka uses a self-signed certificate, you must provide the CA signing certificate that issued the certificate.', example='"SslTruststoreCertificates"'),
