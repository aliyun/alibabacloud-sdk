    topK?: int32(name='TopK', description='The default number of returned results.', example='20'),
    vectorWeight?: double(name='VectorWeight', description='The weight of the vector path in the WEIGHTED fusion algorithm. Valid values: 0 to 1. The weight of the keyword path is 1 minus this value. Default value: 0.7.', example='0.7'),
