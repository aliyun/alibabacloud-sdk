/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'eventbridge';
  @version = '2020-04-01';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-wulanchabu' = 'eventbridge-console.cn-wulanchabu.aliyuncs.com',
    'cn-beijing' = 'eventbridge-console.cn-beijing.aliyuncs.com',
    'cn-qingdao' = 'eventbridge-console.cn-qingdao.aliyuncs.com',
    'cn-shanghai' = 'eventbridge-console.cn-shanghai.aliyuncs.com',
    'cn-hongkong' = 'eventbridge-console.cn-hongkong.aliyuncs.com',
    'cn-heyuan' = 'eventbridge-console.cn-heyuan.aliyuncs.com',
    'cn-zhangjiakou' = 'eventbridge-console.cn-zhangjiakou.aliyuncs.com',
    'cn-shenzhen' = 'eventbridge-console.cn-shenzhen.aliyuncs.com',
    'ap-northeast-2' = 'eventbridge-console.ap-northeast-2.aliyuncs.com',
    'ap-northeast-1' = 'eventbridge-console.ap-northeast-1.aliyuncs.com',
    'cn-chengdu' = 'eventbridge-console.cn-chengdu.aliyuncs.com',
    'cn-guangzhou' = 'eventbridge-console.cn-guangzhou.aliyuncs.com',
    'ap-southeast-1' = 'eventbridge-console.ap-southeast-1.aliyuncs.com',
    'ap-southeast-3' = 'eventbridge-console.ap-southeast-3.aliyuncs.com',
    'cn-huhehaote' = 'eventbridge-console.cn-huhehaote.aliyuncs.com',
    'ap-southeast-5' = 'eventbridge-console.ap-southeast-5.aliyuncs.com',
    'ap-southeast-6' = 'eventbridge-console.ap-southeast-6.aliyuncs.com',
    'ap-southeast-7' = 'eventbridge-console.ap-southeast-7.aliyuncs.com',
    'cn-hangzhou' = 'eventbridge-console.cn-hangzhou.aliyuncs.com',
    'us-east-1' = 'eventbridge-console.us-east-1.aliyuncs.com',
    'eu-west-1' = 'eventbridge-console.eu-west-1.aliyuncs.com',
    'us-west-1' = 'eventbridge-console.us-west-1.aliyuncs.com',
    'eu-central-1' = 'eventbridge-console.eu-central-1.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'eventbridge-console.cn-shenzhen-finance-1.aliyuncs.com',
    'cn-beijing-finance-1' = 'eventbridge-console.cn-beijing-finance-1.aliyuncs.com',
    'cn-shanghai-finance-1' = 'eventbridge-console.cn-shanghai-finance-1.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model Agent {
  createdAt?: long(name='CreatedAt', description='The creation time in UNIX milliseconds.', example='1717200000000'),
  description?: string(name='Description', description='The description of the agent.', example='IoT device data query agent'),
  mcpServerId?: string(name='McpServerId', description='The ID of the MCP server associated with the agent.', example='8vHW4mDRxxxxx'),
  mcpServerName?: string(name='McpServerName', description='The name of the MCP server.', example='data-analyze-agent'),
  metadata?: Metadata(name='Metadata', description='The associated table metadata.'),
  name?: string(name='Name', description='The name of the agent.', example='my-agent'),
  prompt?: string(name='Prompt', description='The custom prompt.', example='You are an IoT data analytics assistant...'),
  updatedAt?: long(name='UpdatedAt', description='The update time in UNIX milliseconds.', example='1717200000000'),
}

model AgentBridgeRuntime {
  cu?: int32(name='Cu', description='The number of CUs that last took effect successfully for the AgentBridge runtime.', example='2'),
  errorCode?: string(name='ErrorCode', description='The stable error code returned when a creation or specification change operation fails.', example='RUNTIME_OPERATION_TIMEOUT'),
  errorMessage?: string(name='ErrorMessage', description='The desensitized error message returned when a creation or specification change operation fails.', example='Runtime operation timed out'),
  name?: string(name='Name', description='The name of the AgentBridge runtime. The initial name is typically default.', example='default'),
  progress?: int32(name='Progress', description='The progress of the current creation or specification change operation. Valid values: 0 to 100.', example='80'),
  stage?: string(name='Stage', description='The current stage of the creation or specification change operation.', example='RUNTIME_HEALTH_CHECK'),
  status?: string(name='Status', description='The current status of the AgentBridge runtime. RUNNING indicates that the runtime is ready and can serve queries. Valid values: CREATING, RUNNING, UPDATING, RECOVERING, CLOSED, CREATE_FAILED, and UPDATE_FAILED.', example='RUNNING'),
  targetCu?: int32(name='TargetCu', description='The target number of CUs during a creation, specification change, or corresponding failure state. This parameter is not returned when the runtime is running stably.', example='2'),
}

model AgentDataSemanticsExample {
  description?: string(name='Description', description='The example usage description.', example='Use this example when a user asks about high-value customers based on weekly statistics', maxLength=128),
  name: string(name='Name', description='The example name.

This parameter is required.', example='High-value customers with weekly sales exceeding 150', maxLength=64),
  parameters?: [
    AgentDataSemanticsExampleParameter
  ](name='Parameters', description='The SQL example parameter list. A maximum of 20 items are supported.'),
  SQLExpression: string(name='SQLExpression', description='The standard SQL example.

This parameter is required.', example='SELECT customerID FROM sales_transactions', maxLength=1024),
}

model AgentDataSemanticsExampleParameter {
  dataType: string(name='DataType', description='The data type of the parameter.

This parameter is required.', example='date'),
  description?: string(name='Description', description='The parameter description.', example='The lower bound of the transaction date', maxLength=128),
  name: string(name='Name', description='The parameter name.

This parameter is required.', example='start_date', maxLength=64),
  value: string(name='Value', description='The example value of the parameter.

This parameter is required.', example='2025-01-01', maxLength=64),
}

model AgentDataSemanticsJoin {
  condition: AgentDataSemanticsJoinCondition(name='Condition', description='The join condition.

This parameter is required.'),
  description?: string(name='Description', description='The join usage description.', example='Use this join when analyzing customer attributes associated with sales transactions', maxLength=128),
  leftTable: string(name='LeftTable', description='The full name of the left table.

This parameter is required.', example='samples.bakehouse.sales_transactions', maxLength=512),
  relationshipType?: string(name='RelationshipType', description='The table relationship type.', example='many_to_one'),
  rightTable: string(name='RightTable', description='The full name of the right table.

This parameter is required.', example='samples.bakehouse.customers', maxLength=512),
}

model AgentDataSemanticsJoinCondition {
  leftColumn?: string(name='LeftColumn', description='The left table field name in form mode.', example='customerID', maxLength=128),
  mode: string(name='Mode', description='The conditional expression method.

This parameter is required.', example='form'),
  rightColumn?: string(name='RightColumn', description='The right table field name in form mode.', example='customerID', maxLength=128),
  SQLExpression?: string(name='SQLExpression', description='The join SQL expression in SQL mode.', example='sales_transactions.customerID = customers.customerID', maxLength=1024),
}

model AgentDataSemanticsMetric {
  description?: string(name='Description', description='The usage description.', example='Use totalPrice to calculate total sales for sales performance comparison', maxLength=128),
  name: string(name='Name', description='The name of the SQL expression.

This parameter is required.', example='TotalSales', maxLength=64),
  SQLExpression: string(name='SQLExpression', description='The SQL expression.

This parameter is required.', example='SUM(sales_transactions.totalPrice)', maxLength=1024),
  synonyms?: [ string ](name='Synonyms', description='The list of synonyms. A maximum of 10 items are supported. Each item can contain up to 64 characters.', example='["Sales","Revenue","GMV"]'),
  type: string(name='Type', description='The type of the SQL expression.

This parameter is required.', example='measure'),
}

model AgentDataSemanticsStageProgress {
  stage: string(name='Stage', description='The stage name.

This parameter is required.', example='PROFILE'),
  status: string(name='Status', description='The stage status.

This parameter is required.', example='SUCCEEDED'),
}

model AgentDataSemanticsText {
  content: string(name='Content', description='The content of the Markdown-formatted text knowledge.

This parameter is required.', example='## Data description'),
}

model AguiMessage {
  content?: string(name='Content', description='The text content of the message.', example='Based on your question, I will query the number of events over the past 7 days..'),
  id?: string(name='Id', description='The unique identifier of the message.', example='msg_123456_a1b2c3d4'),
  metadata?: {
    attachments?: {
      name?: string(name='Name', description='The name of the extended data.', example='acs:eventbridge:cn-hangzhou:12345:eventhouse/system-rocketmq/namespace/rmq-cn-xxx/table/order'),
      type?: string(name='Type', description='The type of the extended data.', example='inner-resource/event-table'),
    }(name='Attachments', description='The extended data.'),
  }(name='Metadata', description='The extended metadata.'),
  reasoning?: string(name='Reasoning', description='The reasoning content.', example='"The user asked me to execute ***"'),
  role?: string(name='Role', description='The role of the message.', example='assistant'),
  toolCallId?: string(name='ToolCallId', description='The associated tool invocation ID.', example='call_xxx'),
  toolCalls?: [ 
    {
      function?: {
        arguments?: string(name='Arguments', description='The parameters of the tool invocation method.', example='{}'),
        name?: string(name='Name', description='The name of the tool invocation method.', example='discoverMetadata'),
      }(name='Function', description='The tool invocation method.'),
      id?: string(name='Id', description='The tool invocation ID.', example='call_xxx'),
      type?: string(name='Type', description='The tool invocation type.', example='function'),
    }
  ](name='ToolCalls', description='The tool invocation list.'),
}

model AiChunkTransformParameters {
  chunkingType?: string(name='ChunkingType', description='The chunking algorithm. Valid values: markdown_header and recursive_character.', example='recursive_character'),
  inputField?: AiTransformField(name='InputField', description='The text field to chunk. This operator does not use InputField.'),
  maxOverlapSize?: int32(name='MaxOverlapSize', description='The chunk overlap length. Default value: 10.', example='10'),
  maxSegmentSize?: int32(name='MaxSegmentSize', description='The maximum chunk length. Default value: 1000.', example='1000'),
  stepName?: string(name='StepName', description='The field name in the CloudEvent to which the output is attached. Default value: transform0.', example='chunks'),
  unpack?: boolean(name='Unpack', description='Specifies whether to split the output into multiple events. Default value: true.', example='true'),
}

model AiClassifyTransformParameters {
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  instruction?: string(name='Instruction', description='The classification constraints provided to the model, such as priority rules or how to categorize uncertain cases. If left empty, classification is performed based on Labels only.', example='Classify as bug when crash or exception is mentioned, classify as other when uncertain'),
  labels?: [ string ](name='Labels', description='The candidate classification labels. The classification result must fall within this list. Specify at least two labels.', example='["bug","feature","question","other"]'),
  outputMode?: string(name='OutputMode', description='The output mode. Valid values: single: single-label. multi: multi-label. Default value: single.', example='single'),
  stepName?: string(name='StepName', description='The field name in the CloudEvent to which the output is attached. Default value: transform0.', example='classify_result'),
}

model AiEmbedTransformParameters {
  dimension?: int32(name='Dimension', description='The vector dimensions. Must be a dimension supported by the selected model. If not specified, the default value of the model is used (1024 for most models, 1536 for v1/v2/async).', example='1024'),
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  model?: string(name='Model', description='The embedding model. Default value: text-embedding-v4.', example='text-embedding-v4'),
  stepName?: string(name='StepName', description='The field name in the CloudEvent to which the output is attached. Default value: transform0.', example='embedding'),
}

model AiExtractTransformParameters {
  extractSchema?: string(name='ExtractSchema', description='The JSON Schema of the extraction results. Pass a serialized JSON object string or JSON Schema text.', example='{"type":"object","properties":{"orderId":{"type":"string"},"amount":{"type":"number"}}}'),
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  stepName?: string(name='StepName', description='The field name attached to the CloudEvent for output. Default value: transform0.', example='extract_result'),
}

model AiFilterTransformParameters {
  condition?: string(name='Condition', description='The retention condition described in natural language. The model uses this condition to determine whether an event matches.', example='Retain only content related to user complaints or refunds'),
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  onMismatch?: string(name='OnMismatch', description='The behavior when a mismatch occurs. Valid values: discard (default): discards the event. forward: forwards the event as-is.', example='discard'),
  stepName?: string(name='StepName', description='The field name in the CloudEvent to which the output is attached. Default value: transform0.', example='filter_result'),
}

model AiPrepSearchTransformParameters {
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  maxChunkSize?: int32(name='MaxChunkSize', description='The maximum number of chunks. Valid values: 1 to 1000. Default value: 20.', example='20'),
  stepName?: string(name='StepName', description='The field name attached to the CloudEvent for output. Default value: transform0.', example='chunks'),
}

model AiRedactTransformParameters {
  entities?: [ string ](name='Entities', description='The entity types to identify and mask in the text, such as phone numbers, ID card numbers, and email addresses.', example='["PHONE","ID_CARD","EMAIL"]'),
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  maskChar?: string(name='MaskChar', description='The mask character used in mask mode. Default value: *.', example='*'),
  mode?: string(name='Mode', description='The masking mode. Valid values: mask, replace, and remove.', example='mask'),
  stepName?: string(name='StepName', description='The field name appended to the CloudEvent for output. Default value: transform0.', example='redact_result'),
}

model AiSentimentAnalysisTransformParameters {
  aspects?: [ string ](name='Aspects', description='Performs emotion analysis on each specified aspect separately. If left empty, performs overall emotion analysis on the entire text.', example='["price","logistics","customer service"]'),
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  stepName?: string(name='StepName', description='The field name attached to the CloudEvent for output. Default value: transform0.', example='sentiment'),
}

model AiSummarizeTransformParameters {
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  maxLength?: int32(name='MaxLength', description='The maximum summary length. The value must be a positive integer. Default value: 200.', example='200'),
  stepName?: string(name='StepName', description='The field name attached to the CloudEvent for output. Default value: transform0.', example='summary'),
}

model AiTransformField {
  form?: string(name='Form', description='The value form. Currently uses JSONPATH.', example='JSONPATH'),
  value?: string(name='Value', description='The JSONPath expression.', example='$.data.message'),
}

model AiTranslateTransformParameters {
  inputField?: AiTransformField(name='InputField', description='The input text field.'),
  sourceLanguage?: string(name='SourceLanguage', description='The source language. If left empty, the language is automatically detected.', example='zh'),
  stepName?: string(name='StepName', description='The field name attached to the CloudEvent output. Default value: transform0.', example='translation'),
  targetLanguage?: string(name='TargetLanguage', description='The target language.', example='en'),
}

model AskLumaLogEntry {
  agentName?: string(name='AgentName', description='Agent name', example='my-agent'),
  clarificationNeeded?: boolean(name='ClarificationNeeded', description='Whether clarification is needed', example='false'),
  clarificationQuestion?: string(name='ClarificationQuestion', description='Clarification question text', example='您指的是哪张表？'),
  content?: Content(name='Content', description='Structured result body'),
  conversationId?: string(name='ConversationId', description='Conversation ID', example='conv_xxx'),
  createdAt?: string(name='CreatedAt', description='Creation time (milliseconds)', example='1717200000000'),
  durationMs?: long(name='DurationMs', description='Invocation duration (milliseconds)', example='3200'),
  errorCode?: string(name='ErrorCode', description='Error code', example='ExecutionFailed'),
  errorMessage?: string(name='ErrorMessage', description='Error details', example='Agent with name \\\\"xxx\\\\" not found for account 1186xxx'),
  isError?: boolean(name='IsError', description='Whether it is an error', example='false'),
  messageId?: string(name='MessageId', description='Message ID', example='msg_xxx'),
  question?: string(name='Question', description='Input question', example='帮我统计一下最近的订单数据。'),
  source?: string(name='Source', description='Log source', example='MCP, CHAT'),
  status?: string(name='Status', description='Execution status', example='RUNNING, SUCCEEDED, FAILED, TIMEOUT'),
}

model AskLumaResult {
  clarificationNeeded?: boolean(name='ClarificationNeeded', description='Indicates whether clarification is needed.', example='false'),
  clarificationQuestion?: string(name='ClarificationQuestion', description='The clarification question text.', example='Which database does the employee table you are referring to belong to?'),
  constraints?: Constraints(name='Constraints', description='The query constraints.'),
  content?: Content(name='Content', description='The structured result body.'),
  conversationId?: string(name='ConversationId', description='The conversation ID, used for multi-turn follow-up questions.', example='conv_xxx'),
  errorCode?: string(name='ErrorCode', description='The error code.', example='ExecutionFailed, Timeout, RateLimited, InternalError, ConversationExpired'),
  errorMessage?: string(name='ErrorMessage', description='The error details.', example='Agent with name \\\\"xxx\\\\" not found for account 1186xxx'),
  isError?: boolean(name='IsError', description='Indicates whether an error occurred. A value of false indicates that the query succeeded or a clarification is needed (including empty result sets). A value of true indicates that the execution failed due to a timeout, throttling, or internal error.', example='false'),
  messageId?: string(name='MessageId', description='The message ID, used for polling with PollAskResult.', example='msg_xxx'),
  status?: string(name='Status', description='The submit status.', example='RUNNING, SUCCEEDED, FAILED, TIMEOUT'),
  storageTruncated?: boolean(name='StorageTruncated', description='Indicates whether the result was truncated because it exceeded the storage limit. This field is returned only for large result sets.', example='true'),
  wikiVersion?: string(name='WikiVersion', description='The business Wiki version that was actually used for this response. This field is not returned if the agent does not have a Wiki configured.', example='eventhouse-multisource-demo-v1'),
}

model BaiLianAgentTransformParameters {
  apiKey?: string(name='ApiKey', description='The API key for Model Studio.', example='Q34****'),
  applicationId?: string(name='ApplicationId', description='The application ID.', example='0123456789abcdef0123456789abcdef'),
  prompt?: {
    form?: string(name='Form', description='The template form.', example='JSONPATH'),
    template?: string(name='Template', description='The template.', example='The value of ${key} is ${value}!'),
    value?: string(name='Value', description='The template value.', example='$.data.message'),
  }(name='Prompt', description='The prompt.'),
  requestPerMinute?: long(name='RequestPerMinute', description='The throttling limit in requests per minute.', example='1000'),
  tokenPerMinute?: long(name='TokenPerMinute', description='The throttling limit in tokens per minute.', example='100000'),
}

model Catalog {
  comment?: string(name='Comment', description='The comment of the data catalog.', example='Test data catalog'),
  connectionName?: string(name='ConnectionName', description='The name of the connection associated with a mounted catalog. This property has a value only when the provider is MySQL, PostgreSQL, Elasticsearch, OSS_TABLES, SLS, OTS, MaxCompute, MongoDB, Redis, SQLServer, ClickHouse, Oracle, Hive, or Iceberg.', example='my_connection'),
  name?: string(name='Name', description='The unique name of the data catalog.', example='my_catalog'),
  properties?: map[string]any(name='Properties', description='The extended properties as a JSON object. The Elasticsearch type includes information such as IndexPattern.', example='{"IndexPattern":"my-index-*"}'),
  provider?: string(name='Provider', description='The data source provider. EventHouse uses built-in storage, while MySQL, PostgreSQL, Elasticsearch, OSS_TABLES, SLS, OTS, MaxCompute, MongoDB, Redis, SQLServer, ClickHouse, Oracle, Hive, and Iceberg are externally mounted.', example='EventHouse'),
  type?: string(name='Type', description='The type of the data catalog, such as RELATIONAL.', example='RELATIONAL'),
}

model Column {
  isNull?: boolean(name='IsNull', description='Whether the value is NULL. When true, it should be treated as NULL.', example='false'),
  name?: string(name='Name', description='Column name.', example='index'),
  type?: string(name='Type', description='Column type.', example='text'),
  value?: string(name='Value', description='Column value.', example='product_info'),
}

model Constraints {
  beginTime?: long(name='BeginTime', description='Start of the query time window (Unix milliseconds)', example='1717200000000'),
  endTime?: long(name='EndTime', description='End of the query time window (Unix milliseconds)', example='1717200000000'),
}

model Content {
  messageAttachments?: [
    AguiMessage
  ](name='MessageAttachments', description='This field is included only in records where Source is set to CHAT. The value is a list of messages in AGUI format.'),
  queryAttachments?: [
    QueryAttachment
  ](name='QueryAttachments', description='The array of executed queries and their query results.'),
  textAttachments?: [ string ](name='TextAttachments', description='The array of Markdown summaries generated by the LLM.'),
}

model Conversation {
  createdAt?: long(name='CreatedAt'),
  id?: string(name='Id'),
  status?: string(name='Status'),
  title?: string(name='Title'),
  updatedAt?: long(name='UpdatedAt'),
}

model DashScopeTransformParameters {
  apiKey?: string(name='ApiKey', description='The API key for DashScope.', example='Q37sQ****'),
  messages?: [ 
    {
      form?: string(name='Form', description='The template form.', example='JSONPATH'),
      role?: string(name='Role', description='The role.', example='USER'),
      template?: string(name='Template', description='The template.', example='The value of ${key} is ${value}!'),
      value?: string(name='Value', description='The template value.', example='$.data.message'),
    }
  ](name='Messages', description='The prompts.'),
  model?: string(name='Model', description='The model name.', example='qwen-max'),
  requestPerMinute?: long(name='RequestPerMinute', description='The rate limit in requests per minute.', example='1000'),
  structuredOutputJsonSchema?: string(name='StructuredOutputJsonSchema', description='The structured output schema.', example='{"type":"object","properties":{"message":{"type":"string"}},"required":["message"]}'),
  tokenPerMinute?: long(name='TokenPerMinute', description='The rate limit in tokens per minute.', example='10000'),
}

model EmbeddingTransformParameters {
  apiKey?: string(name='ApiKey', description='The API key used to call the Model Studio embedding model service.', example='Q37sQ****'),
  embeddingData?: {
    form?: string(name='Form', description='The method used to generate the input data. JSONPATH indicates that data is extracted from the event by using JSONPath.', example='JSONPATH'),
    template?: string(name='Template', description='The template used to build the input data. This parameter is used only when Form is set to TEMPLATE.', example='The value of ${key} is ${value}!'),
    value?: string(name='Value', description='The source content of the input data. If Form is set to JSONPATH, specify a JSONPath expression.', example='$.data.message'),
  }(name='EmbeddingData', description='The input data to be vectorized and its transformation method.'),
  embeddingModel?: string(name='EmbeddingModel', description='The name of the model used to generate embeddings.', example='text-embedding-v3'),
}

model EventHouseRuntime {
  cu?: int32(name='Cu', description='The number of CUs last successfully applied to the EventHouse runtime.', example='2'),
  errorCode?: string(name='ErrorCode', description='The standard error code returned when a creation or specification change fails.', example='RUNTIME_OPERATION_TIMEOUT'),
  errorMessage?: string(name='ErrorMessage', description='The masked error message returned when a creation or specification change fails.', example='Runtime operation timed out'),
  name?: string(name='Name', description='The name of the EventHouse runtime. The initial value is typically default.', example='default'),
  progress?: int32(name='Progress', description='The progress of the current creation or specification change operation. Valid values: 0 to 100.', example='80'),
  stage?: string(name='Stage', description='The current stage of the creation or specification change operation.', example='RUNTIME_HEALTH_CHECK'),
  status?: string(name='Status', description='The current status of the EventHouse runtime. RUNNING indicates that the runtime is ready and can process queries. Valid values: CREATING, RUNNING, UPDATING, RECOVERING, CLOSED, CREATE_FAILED, and UPDATE_FAILED.', example='RUNNING'),
  targetCu?: int32(name='TargetCu', description='The target number of CUs during a creation, specification change, or corresponding failure state. This parameter is not returned when the runtime is stable.', example='2'),
}

model EventTableQueryHistogram {
  count?: long(name='Count'),
  from?: long(name='From'),
  to?: long(name='To'),
}

model ExecutionResult {
  isTruncated?: boolean(name='IsTruncated', description='Indicates whether the result is truncated because of the maxRows limit.', example='false'),
  rowCount?: int32(name='RowCount', description='The number of rows returned in this response.', example='2'),
  rows?: string(name='Rows', description='A two-dimensional array where each row is an array.', example='[["Beijing",120],["Shanghai",98]]'),
  schema?: [
    SchemaColumn
  ](name='Schema', description='The schema information.', example='[{"Name":"event_date","Type":"varchar"}]'),
  totalRows?: int32(name='TotalRows', description='The total number of rows that match the condition. This value differs from RowCount when IsTruncated is set to true.', example='2'),
}

model KnowledgeBase {
  catalog?: string(name='Catalog', description='The EventHouse data catalog to which the knowledge base belongs. This value cannot be modified after the knowledge base is created.', example='my_catalog'),
  chunkConfiguration?: {
    headingLevel?: int32(name='HeadingLevel', description='The heading level (1 to 6) used for splitting in the BY_HEADING strategy. Headings at or above this level serve as split boundaries. Deeper-level headings are retained in the chunk body.', example='2'),
    maxChunkSize?: int32(name='MaxChunkSize', description='The maximum character length of a single chunk. Starting from revision 22, this value is character-based. Valid values: 1 to 6000.', example='600'),
    overlapSize?: int32(name='OverlapSize', description='The overlap character length between adjacent chunks. This parameter takes effect only for the BY_LENGTH strategy. When the value is greater than 0, the beginning of the next chunk repeats the content from the end of the previous chunk within this window. The overlap does not cause a chunk to exceed MaxChunkSize. A value of 0 indicates no overlap.', example='40'),
    preprocessRules?: {
      removeUrlsAndEmails?: boolean(name='RemoveUrlsAndEmails', description='Specifies whether to remove URLs and email addresses during parsing.', example='false'),
      replaceConsecutiveWhitespace?: boolean(name='ReplaceConsecutiveWhitespace', description='Specifies whether to replace consecutive whitespace characters (spaces, line breaks, and tab characters) with a single space.', example='true'),
    }(name='PreprocessRules', description='The preprocessing rules that take effect during document parsing.'),
    separator?: string(name='Separator', description='The separator used in the BY_SEPARATOR strategy. The separator is matched as a literal string (not a regular expression). The maximum length is 32 characters.', example='\\\\\\\\n\\\\\\\\n'),
    strategy?: string(name='Strategy', description='The chunking strategy. Valid values:
- AUTO: intelligent splitting (heading-aware + paragraph packing).
- BY_LENGTH: sliding window splitting by length. You can specify OverlapSize.
- BY_SEPARATOR: splitting by separator. You must specify Separator.
- BY_HEADING: splitting by heading level. You must specify HeadingLevel.', example='BY_SEPARATOR'),
  }(name='ChunkConfiguration', description='The default chunking strategy of the knowledge base. This configuration takes effect only for documents uploaded after the configuration is updated. Existing documents are not re-chunked.'),
  createdAt?: string(name='CreatedAt', description='The time when the knowledge base was created.', example='2026-08-24T10:00:00Z'),
  description?: string(name='Description', description='The description of the knowledge base.', example='Product documentation knowledge base'),
  embeddingDimension?: int32(name='EmbeddingDimension', description='The embedding vector dimension specified during creation or the default dimension of the model. This value cannot be modified after the knowledge base is created.', example='1024'),
  embeddingModel?: string(name='EmbeddingModel', description='The embedding model specified during creation. This value cannot be modified after the knowledge base is created.', example='text-embedding-v4'),
  failureReason?: string(name='FailureReason', description='The brief reason for the most recent creation or deletion failure. This parameter is returned only when the status is CREATE_FAILED or DELETE_FAILED.', example='OssException: BucketAlreadyExists ...'),
  knowledgeBaseName?: string(name='KnowledgeBaseName', description='The name of the knowledge base, which is unique within the namespace.', example='product-docs'),
  metadataSchema?: [
    MetadataSchemaField
  ](name='MetadataSchema', description='The metadata fields declared when the knowledge base was created. These fields cannot be modified after the knowledge base is created.', example='[{"Name":"department","Type":"STRING"}]'),
  namespace?: string(name='Namespace', description='The EventHouse namespace to which the knowledge base belongs. This value cannot be modified after the knowledge base is created.', example='my_namespace'),
  searchConfiguration?: {
    mode?: string(name='Mode', description='The retrieval mode. Valid values:
- KEYWORD: keyword retrieval.
- VECTOR: vector retrieval.
- HYBRID: hybrid retrieval.', example='HYBRID'),
    rankAlgorithm?: string(name='RankAlgorithm', description='The fusion algorithm for hybrid search. This parameter takes effect only in hybrid search mode. Valid values:
- RRF: reciprocal rank fusion.
- WEIGHTED: weighted normalization fusion. Use this value together with VectorWeight.

Default value: RRF.', example='RRF'),
    rerankEnabled?: boolean(name='RerankEnabled', description='Specifies whether reranking is enabled by default. This parameter takes effect for all search modes (KEYWORD, VECTOR, and HYBRID). This default value is used when the Rerank parameter is not specified in a search request.', example='false'),
    rerankModel?: string(name='RerankModel', description='The default reranking model used when the RerankModel parameter is not specified in a search request. Valid values: qwen3-rerank, gte-rerank-v2, and qwen3-vl-rerank. Default value: qwen3-rerank. Score distributions vary across models and cannot be compared. Use the same model consistently within a knowledge base.', example='qwen3-rerank'),
    rrfK?: int32(name='RrfK', description='The k parameter of the RRF fusion algorithm. The value must be greater than 0. Default value: 60.', example='60'),
    topK?: int32(name='TopK', description='The maximum number of results returned by default for a search request.', example='20'),
    vectorWeight?: double(name='VectorWeight', description='The weight of the vector path in the WEIGHTED fusion algorithm. Valid values: 0 to 1. The keyword path weight equals 1 minus this value. Default value: 0.7.', example='0.7'),
  }(name='SearchConfiguration', description='The default search configuration at the knowledge base level. This configuration takes effect when the corresponding parameters are not specified in a search request. You can modify this configuration by calling the UpdateKnowledgeBase operation.'),
  status?: string(name='Status', description='The current status of the knowledge base. Valid values:
- CREATING: The knowledge base is being created.
- ACTIVE: The knowledge base is available.
- CREATE_FAILED: The knowledge base failed to be created.
- DELETING: The knowledge base is being deleted.
- DELETE_FAILED: The knowledge base failed to be deleted.', example='ACTIVE'),
  updatedAt?: string(name='UpdatedAt', description='The time when the knowledge base was last updated.', example='2026-08-24T10:00:00Z'),
}

model KnowledgeBaseChunk {
  chunkSeq?: int32(name='ChunkSeq', description='The sequence number of the chunk within the document, starting from 1 and numbered consecutively.', example='12'),
  chunkSize?: int32(name='ChunkSize', description='The number of characters in the chunk content, measured in UTF-16 code units, consistent with MaxChunkSize. You can use this value to evaluate chunk saturation against the chunking configuration.', example='128'),
  content?: string(name='Content', description='The content of the chunk.', example='EventBridge supports routing events to multiple target services'),
  createdAt?: string(name='CreatedAt', description='The time when the chunk was created.', example='2026-08-24T10:00:00Z'),
  documentId?: string(name='DocumentId', description='The ID of the document to which the chunk belongs.', example='doc-bp1xxxxxxxxxxxx'),
  enabled?: boolean(name='Enabled', description='Indicates whether the chunk is enabled. Disabled chunks are excluded from retrieval.', example='true'),
  fileName?: string(name='FileName', description='The file name of the document to which the chunk belongs. This value is from the same source as the FileName returned by GetDocument.', example='product-handbook.pdf'),
  sourceLocation?: string(name='SourceLocation', description='The location of the chunk in the original document. The format varies by document type: for PDF, the value is p.PageNumber (such as p.3). For PPT/PPTX, the value is s.SlideNumber (such as s.2). For XLS/XLSX, the value is the sheet name. For other formats (such as txt, md, html, doc, or docx), this field is not returned if no source location is available.', example='p.3'),
  titlePath?: string(name='TitlePath', description='The hierarchical title path of the chunk, connected by >. If no recognizable title exists in the original document, the value falls back to a summary of the first paragraph content (such as CONTENT). This field is for display purposes only.', example='Installation Guide>Prerequisites'),
  updatedAt?: string(name='UpdatedAt', description='The time when the chunk was last updated.', example='2026-08-24T10:00:00Z'),
}

model KnowledgeBaseDocument {
  chunkConfiguration?: {
    headingLevel?: int32(name='HeadingLevel', description='The heading level (1 to 6) used for splitting in the BY_HEADING strategy. Headings at or above this level serve as split boundaries. Deeper-level headings are retained in the chunk body.', example='2'),
    maxChunkSize?: int32(name='MaxChunkSize', description='The maximum character length of a single chunk. Starting from revision 22, this value is character-based. Valid values: 1 to 6000.', example='600'),
    overlapSize?: int32(name='OverlapSize', description='The overlap character length between adjacent chunks. This parameter takes effect only for the BY_LENGTH strategy. If the value is greater than 0, the beginning of the next chunk repeats the content from the end of the previous chunk within this window. The overlap does not cause a chunk to exceed MaxChunkSize. A value of 0 indicates no overlap.', example='40'),
    preprocessRules?: {
      removeUrlsAndEmails?: boolean(name='RemoveUrlsAndEmails', description='Specifies whether to remove URLs and email addresses during parsing.', example='false'),
      replaceConsecutiveWhitespace?: boolean(name='ReplaceConsecutiveWhitespace', description='Specifies whether to replace consecutive whitespace characters (spaces, line breaks, and tab characters) with a single space.', example='true'),
    }(name='PreprocessRules', description='The snapshot of preprocessing rules.'),
    separator?: string(name='Separator', description='The separator used in the BY_SEPARATOR strategy. The separator is matched as a literal string (not a regular expression). The maximum length is 32 characters.', example='\\\\\\\\n\\\\\\\\n'),
    strategy?: string(name='Strategy', description='The chunking strategy. Valid values:
- AUTO: intelligent splitting (heading-aware + paragraph packing).
- BY_LENGTH: sliding window splitting by length. You can specify OverlapSize.
- BY_SEPARATOR: splitting by separator. You must specify Separator.
- BY_HEADING: splitting by heading level. You must specify HeadingLevel.', example='BY_SEPARATOR'),
  }(name='ChunkConfiguration', description='The snapshot of the document-level chunking policy actually used for this document. This field is returned only if ChunkConfiguration was explicitly specified during upload (BeginUpload) or update (UpdateDocument). If not specified, the document is chunked based on the knowledge base-level default configurations, and this field is not returned. The knowledge base-level configuration is not echoed back to avoid misleading users about the actual chunking basis for this document when the knowledge base-level configuration is subsequently changed.'),
  chunkCount?: int32(name='ChunkCount', description='The number of chunks generated after processing is complete.', example='120'),
  createdAt?: string(name='CreatedAt', description='The time when the document was created.', example='2026-08-24T10:00:00Z'),
  documentId?: string(name='DocumentId', description='The unique identifier of the document.', example='doc-bp1xxxxxxxxxxxx'),
  errorCode?: string(name='ErrorCode', description='The stable error code returned when processing fails.', example='FILE_CORRUPTED'),
  errorMessage?: string(name='ErrorMessage', description='The desensitized error message returned when processing fails.', example='parse pdf failed'),
  fileName?: string(name='FileName', description='The file name of the document.', example='manual.pdf'),
  fileSize?: long(name='FileSize', description='The file size of the document, in bytes.', example='1048576'),
  metadata?: [ 
    {
      key?: string(name='Key', description='The metadata field name.', example='department'),
      value?: string(name='Value', description='The metadata field value.', example='R&D'),
    }
  ](name='Metadata', description='The document-level metadata key-value pairs, including constant field values and system variable values. This field is not returned if no metadata is specified.', example='[{"Key":"department","Value":"R&D"}]'),
  sourceModifiedTime?: long(name='SourceModifiedTime', description='The last modification time in the upstream source system, in epoch milliseconds. This field is empty if no source information is available.', example='1788000000000'),
  sourceType?: string(name='SourceType', description='The delivery channel through which the document entered the knowledge base. This value is written by the system and cannot be specified by users. Valid values:
- UPLOAD: manually uploaded through the console or API.
- OSS: imported through an OSS event stream.

New values may be added when new channels are supported. The values are not restricted to a fixed enumeration.', example='UPLOAD'),
  sourceUri?: string(name='SourceUri', description='The original source address of the document, such as oss://bucket/path/file.md. This field may be empty for manually uploaded documents.', example='oss://my-bucket/docs/handbook.pdf'),
  status?: string(name='Status', description='The processing status of the document. Valid values:
- UPLOADING: uploading in progress.
- PENDING: upload complete and queued for processing. This is typically a transitional state that lasts for seconds.
- PROCESSING: parsing and processing in progress.
- COMPLETED: processing complete and searchable.
- FAILED: processing failed.
- DELETING: deletion in progress.', example='COMPLETED'),
  updatedAt?: string(name='UpdatedAt', description='The time when the document was last updated.', example='2026-08-24T10:00:00Z'),
}

model KnowledgeBaseSearchChunk {
  chunkSeq?: int32(name='ChunkSeq', description='The sequence number of the chunk within the document.', example='12'),
  content?: string(name='Content', description='The body content of the hit chunk.', example='EventBridge supports routing events to multiple target services'),
  documentId?: string(name='DocumentId', description='The ID of the document to which the hit chunk belongs.', example='doc-bp1xxxxxxxxxxxx'),
  fileName?: string(name='FileName', description='The file name of the document to which the hit chunk belongs. This value has the same source as the FileName returned by GetDocument and can be used to render the reference source.', example='product-handbook.pdf'),
  score?: double(name='Score', description='The retrieval relevance score. A higher score indicates higher relevance.', example='0.92'),
  scores?: {
    fusion?: double(name='Fusion', description='The score after hybrid search fusion (reciprocal rank fusion or weighted normalization, depending on the active fusion algorithm). Value range: [0, 1].', example='0.78'),
    keyword?: double(name='Keyword', description='The normalized score of keyword (full-text) search. Value range: [0, 1].', example='0.62'),
    rerank?: double(name='Rerank', description='The score assigned by the rerank model. Value range: [0, 1].', example='0.91'),
    vector?: double(name='Vector', description='The similarity score of vector retrieval. Value range: [0, 1].', example='0.85'),
  }(name='Scores', description='The score details for each stage. Score fields that are not involved in the calculation are not returned.'),
  sourceLocation?: string(name='SourceLocation', description='The location of the chunk in the original document. p.N indicates page N (PDF). s.N indicates slide N (PPT/PPTX).', example='p.3'),
  titlePath?: string(name='TitlePath', description='The title path to which the chunk belongs, such as Chapter 1>1.1 Overview.', example='Installation Guide>Prerequisites'),
}

model LumaTable {
  catalog?: string(name='Catalog', description='The name of the data catalog to which the table belongs.', example='my_catalog'),
  columns?: [ 
    {
      comment?: string(name='Comment', description='The comment of the column.', example='Primary key ID'),
      name?: string(name='Name', description='The name of the column.', example='id'),
      type?: string(name='Type', description='The data type of the column.', example='bigint'),
    }
  ](name='Columns', description='The list of column definitions for the table. Each column contains Name (column name), Type (data type), and Comment (comment).', example='[{"Name":"id","Type":"bigint","Comment":"Primary key"}]'),
  comment?: string(name='Comment', description='The comment of the table.', example='Test event table'),
  createTime?: long(name='CreateTime', description='The creation time of the table. This value is a UNIX timestamp in milliseconds.', example='1717948800000'),
  name?: string(name='Name', description='The unique name of the event table.', example='my_table'),
  namespace?: string(name='Namespace', description='The name of the namespace to which the table belongs.', example='my_namespace'),
  retentionPolicy?: {
    coldTTL?: int32(name='ColdTTL', description='The number of days to retain cold data in low-cost archival storage.', example='30'),
    hotTTL?: int32(name='HotTTL', description='The number of days to retain hot data in high-performance query storage.', example='7'),
  }(name='RetentionPolicy', description='The data retention policy, including the retention days for hot data and cold data.'),
  updateTime?: long(name='UpdateTime', description='The last update time of the table. This value is a UNIX timestamp in milliseconds.', example='1717948800000'),
}

model Metadata {
  attachments?: [ 
    {
      arn?: string(name='Arn', description='ARN of the associated data', example='acs:eventbridge:cn-hangzhou:12345:eventhouse/system-rocketmq/namespace/rmq-cn-xxx/table/order'),
      mimeType?: string(name='MimeType', description='Data type', example='inner-resource/event-table'),
    }
  ](name='Attachments', description='Associated data'),
}

model MetadataSchemaField {
  name?: string(name='Name', description='The name of the metadata field.', example='department'),
  type?: string(name='Type', description='Valid values: STRING, LONG, DOUBLE, BOOLEAN, and DATETIME. This field is ignored when ValueMode is set to SYSTEM_VARIABLE. The system enforces the inherent type of the bound variable: DOCUMENT_NAME, FILE_TYPE, SOURCE_TYPE, and SOURCE_URI use STRING. FILE_SIZE, DOCUMENT_UPLOAD_TIME, and SOURCE_MODIFIED_TIME use LONG. An incorrect value specified by the user has no effect.', example='STRING'),
  value?: string(name='Value', description='When ValueMode is set to CONSTANT, this field specifies a fixed value. An empty value indicates that the value can be assigned during document upload. When ValueMode is set to SYSTEM_VARIABLE, this field specifies a system variable name. Valid system variable names: DOCUMENT_NAME, FILE_TYPE, FILE_SIZE, DOCUMENT_UPLOAD_TIME, SOURCE_TYPE, SOURCE_URI, and SOURCE_MODIFIED_TIME. The system maintains the values of system variables. For manual uploads, the source is fixed to UPLOAD, and SOURCE_URI and SOURCE_MODIFIED_TIME use the values declared by the user. For event stream imports, the system automatically maintains the values. For example, for an OSS import, the source is OSS, SOURCE_URI is oss://bucket/key, and SOURCE_MODIFIED_TIME is the object modification time.', example='EventHouse'),
  valueMode?: string(name='ValueMode', description='This field is optional. If omitted, the user assigns the value during document upload. Valid values:
- CONSTANT: The field uses a constant. If Value is not empty, the fixed value is automatically applied to the document. If Value is empty, the value can be assigned during upload.
- SYSTEM_VARIABLE: The field is bound to a system variable. Value specifies the variable name, and the system automatically populates the value from the document facts.

A value explicitly provided by the user during document upload always takes precedence. The backend does not override user-specified values.', example='CONSTANT'),
}

model Namespace {
  catalog: string(name='Catalog', description='The name of the data catalog to which the namespace belongs.

This parameter is required.', example='my_catalog'),
  comment?: string(name='Comment', description='The comment of the namespace.', example='Test namespace'),
  name?: string(name='Name', description='The unique identifier name of the namespace.', example='my_namespace'),
  properties?: string(name='properties', description='The extended properties of the namespace.', example='{"key":"value"}'),
}

model QueryAskLumaLogResult {
  entries?: [
    AskLumaLogEntry
  ](name='Entries', description='The list of log records returned by the query.'),
  hasMore?: boolean(name='HasMore', description='Indicates whether more query results are available. Valid values:
- true: More results are available.
- false: No more results are available.'),
  lastKey?: string(name='LastKey', description='The token used to retrieve the next page of query results. Pass this value as LastKey in subsequent requests to continue the query. This field is not returned when all results have been returned.', example='eyJ0cyI6MTcxN...'),
}

model QueryAttachment {
  query?: string(name='Query', description='The query statement.', example='"SELECT city, COUNT(*) AS cnt FROM events GROUP BY city"'),
