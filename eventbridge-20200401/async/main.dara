    maxChunkSize?: int32(name='MaxChunkSize', description='The maximum token length of a single chunk.', example='512'),
    overlapSize?: int32(name='OverlapSize', description='The overlap token length between adjacent chunks.', example='6'),
    preprocessRules?: {
