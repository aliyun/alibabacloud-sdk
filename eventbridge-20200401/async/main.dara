      replaceConsecutiveWhitespace?: boolean(name='ReplaceConsecutiveWhitespace', description='Specifies whether to replace consecutive whitespace characters, such as spaces, line breaks, and tabs, with a single space.', example='true'),
    }(name='PreprocessRules', description='The preprocessing rules.'),
    separator?: string(name='Separator', description='The paragraph identifier for the LINE_BREAK strategy, such as a line break.', example='\\\\\\\\n\\\\\\\\n', maxLength=32),
    strategy: string(name='Strategy', description='The chunking strategy. Valid values: AUTO: Automatic chunking. LINE_BREAK: Chunking by paragraph identifier.

This parameter is required.', example='LINE_BREAK'),
  }(name='ChunkConfiguration', description='Optional. Updates the default chunking strategy of the knowledge base. This update takes effect only for newly uploaded documents and does not re-chunk existing documents. If this parameter is not specified, the strategy is not modified.', shrink='json', position='Query'),
  description?: string(name='Description', description='Updates the description of the knowledge base. If this parameter is not specified, the description is not modified.', example='Product documentation knowledge base', maxLength=255, position='Query'),
  knowledgeBaseName: string(name='KnowledgeBaseName', description='The name of the knowledge base. The name must be unique within the namespace. It is specified during creation and cannot be modified.

