  body?: {
    form?: string(name='Form', description='The transformation format. Default value: CONSTANT. Valid values: ORIGINAL, TEMPLATE. Example: `ORIGINAL`.', example='ORIGINAL'),
    template?: string(name='Template', description='The template pattern. This parameter is required only when Form is set to TEMPLATE. It supports ${variable} placeholder replacement. Example: `The value of ${key} is ${value}!`.', example='The value of ${key} is ${value}!'),
    value?: string(name='Value', description='The parameter value. In ORIGINAL mode, the value is $. In TEMPLATE mode, the value is a key-value mapping in JSON format, where the value is a JSONPath expression or a constant. Example: `$`.', example='$'),
  }(name='Body', description='The triplet configuration for the Body parameter template. It defines the data transformation method and supports two modes: ORIGINAL (pass-through) and TEMPLATE (template replacement).'),
  endpointName?: string(name='EndpointName', description='The endpoint name of the AgentRun agent runtime, which is used to construct the invocation URL.', example='default'),
  roleName?: string(name='RoleName', description='The name of the AgentRun agent role.', example='example-agent-role'),
  timeout?: string(name='Timeout', description='The HTTP request timeout period in milliseconds. Default value: 30000.', example='30000'),
}

