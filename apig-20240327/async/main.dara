  riskLevel?: string(name='riskLevel', description='The overall risk level. Valid values:
- LOW: Low risk.
- MEDIUM: Medium risk.
- HIGH: High risk.
- CRITICAL: Critical risk.', example='MEDIUM'),
  score?: int32(name='score', description='The overall risk score. Valid values: 0 to 100. A higher score indicates a lower risk.', example='85', minimum=0, maximum=100),
  snapshotTime?: long(name='snapshotTime', description='The snapshot time.', example='1234567890000'),
  status?: string(name='status', description='The risk detection status. Valid values:
- SUCCESS: The detection succeeded.
- FAIL: The detection failed.
- RUNNING: The detection is running.', example='SUCCESS'),
  totalRisk?: int32(name='totalRisk', description='The total number of detected risk items.', example='1'),
}

