          subjectType?: string(name='subjectType', description='The type of the conflicting subject. Valid values: consumer and consumer_group.', example='consumer'),
        }
      ](name='items', description='The list of conflicting subjects.'),
      totalConflictCount?: int32(name='totalConflictCount', description='The total number of conflicts.', example='20'),
    }(name='conflictPreview', description='The conflict preview.'),
