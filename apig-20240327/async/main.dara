      description?: string(name='description', description='The detailed description of the risk in JSON string format.', example='{"desc":"The single-node instance has an architecture risk. A single point of failure can cause service unavailability. Scale out to two or more nodes."}'),
      isNoticeMute?: boolean(name='isNoticeMute', description='Indicates whether the alert notification for the risk item is muted.', example='false'),
      riskCode?: string(name='riskCode', description='The unique identifier of the risk item.', example='30010010001'),
