model AiStatisticsConfig {
  logRequestContent?: boolean(name='logRequestContent', description='**[Deprecated]** Specifies whether to log request content (controls whether question-related attributes are generated). This parameter is deprecated in the new version.', example='true'),
  logResponseContent?: boolean(name='logResponseContent', description='**[Deprecated]** Specifies whether to log response content (controls whether answer-related attributes are generated). This parameter is deprecated in the new version.', example='true'),
  pathFieldConfigs?: [ 
    {
      fieldPaths?: map[string]AiStatisticsPathField(name='fieldPaths', description='The log field configuration groups for the AI request log corresponding to the API path. Pass this parameter as a map. The valid keys of the map are fixed as basic and custom. The values are arrays of log field configurations for the corresponding group. basic indicates basic log fields, and custom indicates custom log fields. For the current API path, fieldPaths represents the complete desired state of the field configuration and does not support incremental appending or diff merging.

If pathFieldConfigs is not passed, is set to null, or is an empty array, the existing log field configurations are not updated. If a non-empty array is passed, the system performs a full desired state replacement based on the complete set of paths in the request. Historical path configurations that are not included are deleted.

For example, to add a custom field test to the /v1/chat/completions API path on top of the existing configuration, the caller must use a read-merge-write-back approach:
1. Read all current path configurations.
2. Retain the complete basic array and custom array for the target API path /v1/chat/completions.
3. Append test to the current custom array.
4. Retain the configurations of other API paths as-is.
5. Submit the merged complete pathFieldConfigs.'),
      path?: string(name='path', description='The API path.', example='/v1/chat/completions'),
    }
  ](name='pathFieldConfigs', description='The list of AI request log field collection configurations, configured by API path.'),
}

model AiStatisticsPathField {
  category?: string(name='category', description='The secondary business category of the field. This parameter is optional. Valid values: conversation (conversation content), config (configuration parameters), tools (tool calling), usage (usage statistics), metadata (metadata), choices (candidate results), identity (identity), cache (cache information), media (multimedia content), logprobs (log probabilities), and custom (custom fields). Set custom fields to custom.', example='conversation'),
  description?: string(name='description', description='The field description.', example='The question content entered by the user'),
  fieldKey?: string(name='fieldKey', description='The log key (field name).', example='question'),
  io?: string(name='io', description='The request or response attribution. The backend normalizes this to request or response based on the source value.', example='request'),
  jsonPath?: string(name='jsonPath', description='The corresponding jsonPath (gjson syntax).', example='messages.#.content'),
  name?: string(name='name', description='The annotation for the field key name.', example='Question content'),
  recordEnabled?: boolean(name='recordEnabled', description='Indicates whether collection is enabled to include the corresponding field in AI request log records.', example='true'),
  rule?: string(name='rule', description='The aggregation rule for streaming response fields. Valid values: append, first, and replace. append: appends the matched values from each streaming chunk in sequence. first: retains the first matched value. replace: uses the last matched value. When source is set to response_streaming_body and rule is not specified, the default value is first. This field is not required for non-streaming scenarios.', example='append'),
  sensitive?: boolean(name='sensitive', description='Specifies whether the field is sensitive.', example='false'),
  source?: string(name='source', description='The source of the field value. Valid values: fixed_value (fixed value), request_body (request body), request_header (request header), response_header (response header), response_body (non-streaming response body), and response_streaming_body (streaming response body).', example='request_body'),
}

