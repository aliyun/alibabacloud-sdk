    modelName?: string(name='modelName', description='The name of the model.', example='qwen-plus'),
    modelProvider?: string(name='modelProvider', description='The identifier of the model provider.', example='qwen'),
    source?: string(name='source', description='The source of the model card. user is returned for instance-level model cards.', example='user'),
    updateTime?: string(name='updateTime', description='The last update time of the model card. The format is yyyy-MM-dd HH:mm:ss.', example='2026-07-14 18:30:00'),
  }(name='data', description='The model card details.'),
