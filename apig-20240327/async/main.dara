/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'APIG';
  @version = '2024-03-27';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AgentAccessConfig {
  aiRequestLogEnabled?: boolean(name='aiRequestLogEnabled', description='Specifies whether to enable AI request logging. If this parameter is not specified, the server uses true by default.', example='false'),
  authorization?: {
    authType?: string(name='authType', description='The authentication type of the Agent access entry. Specify this parameter only when enabled is set to true.', example='Apikey'),
    enabled: boolean(name='enabled', description='Specifies whether to enable consumer authorization. If this parameter is set to true, you must specify authType and at least one authorization principal. If this parameter is set to false, you cannot specify authorization principals.

This parameter is required.', example='true'),
    principals?: [
      AgentAuthorizationPrincipal
    ](name='principals', description='The list of consumers or consumer groups that are granted Agent access permissions. At least one authorization principal must be specified when enabled is set to true.'),
  }(name='authorization', description='The consumer authorization configuration for Agent access. If this parameter is not specified, consumer authorization is not enabled.'),
  basePath: string(name='basePath', description='The base path of the Agent access entry. The path must start with a forward slash (/).

This parameter is required.', example='/agent'),
  domainIds: [ string ](name='domainIds', description='The list of domain name IDs bound to the Agent access entry. At least one domain name must be specified.

This parameter is required.'),
  removeBasePathOnForward?: boolean(name='removeBasePathOnForward', description='Specifies whether to remove the base path when forwarding requests to the backend. If this parameter is not specified, the server uses false by default.', example='true'),
}

model AgentAuthorizationPrincipal {
  principalId: string(name='principalId', description='The ID of the authorization principal. Specify a consumer ID or consumer group ID based on the value of principalType.

This parameter is required.', example='consumer-1'),
  principalType: string(name='principalType', description='The type of the authorization principal. Valid values:

- Consumer: consumer.
- ConsumerGroup: consumer group.

This parameter is required.', example='Consumer'),
}

model AgentInfo {
  agentAccess?: {
    httpApiId?: string(name='httpApiId', description='The ID of the HTTP API associated with the agent access capability. The frontend uses this ID to call existing HTTP API, route, consumer authorization, policy, and plug-in query operations.', example='{ "httpApiId": "api-abc123" }'),
  }(name='agentAccess', description='The associated resource information for the agent access capability. If the agent access capability is not configured, null is always returned.'),
  agentId?: string(name='agentId', description='The agent ID.', example='agent-1'),
  agentType?: string(name='agentType', description='The type of the agent. DashScope (Model Studio) allows only agent access, Dify allows agent access and model access, ClaudeCode allows only model access, and Custom allows agent access and model access.', example='Custom'),
  allowedCapabilities?: [ string ](name='allowedCapabilities', description='The list of capabilities that the current agent type is allowed to configure. This field does not indicate that the capabilities are configured. To determine whether they are configured, check whether agentAccess or modelAccess is null.'),
  createTimestamp?: long(name='createTimestamp', description='The creation time of the agent, as a UNIX timestamp in milliseconds.', example='1755129600000'),
  description?: string(name='description', description='The description of the agent.', example='custom agent'),
  gatewayId?: string(name='gatewayId', description='The ID of the gateway to which the agent belongs. When reading the associated API deployment configuration, select the configuration whose gatewayId matches this value.', example='gateway-1'),
  modelAccess?: {
    consumerIds?: [ string ](name='consumerIds', description='The list of consumer identity bindings maintained by the agent domain. The Model API ID and the consumer IDs in the list jointly locate the agent identity and take effect for all routes of the Model API. Consumer details and their Model API authorization details are obtained through existing Consumer API and consumer authorization query operations.'),
    modelApiId?: string(name='modelApiId', description='The ID of the Model API associated with the model access capability. Model access does not distinguish between routes. The frontend uses this ID to query the basic information and all routes of the Model API.', example='{ "modelApiId": "model-api-1" }'),
  }(name='modelAccess', description='The associated resource information for the model access capability. If the model access capability is not configured, null is always returned.'),
  name?: string(name='name', description='The name of the agent.', example='my-agent'),
  resourceGroupId?: string(name='resourceGroupId', description='The ID of the resource group where the agent is saved.', example='rg-1'),
  status?: string(name='status', description='The status of the agent. In the current phase, agents that are successfully created and can be queried always return Ready. Internal creation or compensation statuses are not returned externally.', example='Ready'),
  updateTimestamp?: long(name='updateTimestamp', description='The last update time of the agent, as a UNIX timestamp in milliseconds.', example='1755129600000'),
}

model AgentModelAccessConfig {
  consumerIds: [ string ](name='consumerIds', description='The list of API consumer IDs that represent the Agent to access the Model API. The Model API ID and API consumer ID together identify the Agent identity, and the configuration takes effect on all current and future routes of the Model API. Specify at least one API consumer. The API consumer must be enabled and must have direct Consumer authorization for the Model API in the default environment of the target gateway, with the authorization publish status being Success. Different Agents cannot bind the same API consumer to the same Model API. ConsumerGroup is not supported.

This parameter is required.'),
  modelApiId: string(name='modelApiId', description='The ID of the Model API to associate. The Model API must belong to the specified gateway.

This parameter is required.', example='model-api-1'),
}

model AgentServiceConfig {
  address: string(name='address', description='The address.

This parameter is required.', example='https://dashscope.aliyuncs.com/api/v1'),
  customConfig?: {
    apiKey?: string(name='apiKey', description='The API key.', example='app-xxx'),
    apiKeyGenerateMode?: string(name='apiKeyGenerateMode', description='The key generation mode.', example='Reference'),
  }(name='customConfig', description='The custom configuration. Specify this parameter when provider is set to custom.'),
  dashScopeConfig?: {
    appCredentials?: [ 
      {
        apiKey?: string(name='apiKey', description='apiKey', example='sk-xxx'),
        appId?: string(name='appId', description='The application ID.', example='app-xxx'),
      }
    ](name='appCredentials', description='The application configuration.'),
  }(name='dashScopeConfig', description='The DashScope service configuration. Specify this parameter when provider is set to qwen. The appCredentials parameter cannot be empty, and both appId and apiKey must be specified for each item.'),
  difyConfig?: {
    apiKey?: string(name='apiKey', description='API Key', example='app-xxx'),
    botType?: string(name='botType', description='The interaction type.', example='chatflow'),
  }(name='difyConfig', description='The Dify service configuration. Specify this parameter when provider is set to dify. Both botType and apiKey must be specified.'),
  enableHealthCheck?: boolean(name='enableHealthCheck', description='Specifies whether to enable the health check.', example='true'),
  enableOutlierDetection?: boolean(name='enableOutlierDetection', description='Specifies whether to enable outlier detection.', example='true'),
  protocols?: [ string ](name='protocols', description='The list of communication protocols.'),
  provider: string(name='provider', description='The service provider.

This parameter is required.', example='qwen'),
  upstreamAuthMode?: string(name='upstreamAuthMode', description='Supported only for custom agents. The value api-key indicates a managed API key, and downstream-auth indicates passing through the complete client Authorization header. If this parameter is omitted or left empty during creation, the historical rule applies. If this parameter is omitted or left empty during an update, the existing mode is retained. When passing through the authorization, you can omit customConfig, and you cannot submit a non-empty key.', example='api-key'),
}

model AiCacheConfig {
  cacheKeyStrategy?: string(name='cacheKeyStrategy', description='The cache key generation strategy.', example='default'),
  cacheMode?: string(name='cacheMode', description='The cache mode.', example='exact'),
  cacheTTL?: int32(name='cacheTTL', description='The cache expiration time in seconds.', example='3600'),
  embeddingConfig?: {
    modelName?: string(name='modelName', description='The name of the embedding model.', example='text-embedding-v2'),
    serviceId?: string(name='serviceId', description='The ID of the embedding service.', example='svc-xxx'),
    timeout?: int32(name='timeout', description='The request timeout in milliseconds.', example='5000'),
    type?: string(name='type', description='The embedding service type.', example='dashscope'),
  }(name='embeddingConfig', description='The embedding service configuration.'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The running status of the plugin.'),
  redisConfig?: AiPolicyRedisConfig(name='redisConfig', description='The Redis configuration for exact cache count storage.'),
  vectorConfig?: {
    apiKey?: string(name='apiKey', description='The API key for the vector database.', example='sk-xxx'),
    collectionId?: string(name='collectionId', description='The ID of the vector collection.', example='col-xxx'),
    serviceHost?: string(name='serviceHost', description='The vector database service endpoint.', example='vdb-xxx.dashvector.aliyuncs.com'),
    threshold?: float(name='threshold', description='The similarity threshold.', example='0.95'),
    timeout?: int32(name='timeout', description='The request timeout in milliseconds.', example='5000'),
    type?: string(name='type', description='The vector database type.', example='dashvector'),
  }(name='vectorConfig', description='The vector database configuration.'),
}

model AiFallbackConfig {
  onlyRedirectUpstreamCode?: boolean(name='onlyRedirectUpstreamCode', description='When set to true, fallback is triggered only when the backend returns a 4xx/5xx status code. Status codes generated by the gateway itself (such as 503 connection failed) do not trigger fallback. Requires DPI engine version 2.1.11 or later. If the version does not meet the requirement, this setting is silently ignored.', example='true'),
  serviceConfigs?: [ 
    {
      name?: string(name='name', description='The service name.', example='—'),
      passThroughModelName?: boolean(name='passThroughModelName', description='Specifies whether to pass through the model name from the original request.', example='false'),
      serviceId?: string(name='serviceId', description='The ID of the fallback target service.', example='svc-bbb'),
      targetModelName?: string(name='targetModelName', description='The name of the fallback target model.', example='qwen-max'),
    }
  ](name='serviceConfigs', description='The list of fallback target services, excluding the primary routing service.'),
}

model AiNetworkConfigSearchEngine {
  apiKey?: string(name='apiKey', description='The API key of the search engine.', example='sk-xxx'),
  contentMode?: string(name='contentMode', description='Quark-specific: the content mode.', example='summary'),
  count?: int32(name='count', description='The number of results returned per search.', example='5'),
  endpoint?: string(name='endpoint', description='The endpoint of the search engine.', example='https://cloud-iqs.aliyuncs.com'),
  industry?: string(name='industry', description='Quark-specific: the industry filter.', example='Internet'),
  optionArgs?: map[string]string(name='optionArgs', description='The search engine-specific parameters in key-value pair format.', example='{"market":"zh-CN"}'),
  start?: int32(name='start', description='The offset of the search results.', example='0'),
  timeRange?: string(name='timeRange', description='Quark-specific: the time range filter.', example='7d'),
  timeoutMillisecond?: int32(name='timeoutMillisecond', description='The API call timeout in milliseconds.', example='5000'),
  type?: string(name='type', description='The search engine type.', example='aliyunQuark'),
}

model AiNetworkSearchConfig {
  defaultEnable?: boolean(name='defaultEnable', description='Specifies whether the plug-in feature is enabled by default.', example='true'),
  defaultLang?: string(name='defaultLang', description='The default search language code.', example='zh-CN'),
  needReference?: boolean(name='needReference', description='Specifies whether to add reference sources in the answer.', example='true'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The plug-in running status.'),
  referenceFormat?: string(name='referenceFormat', description='The format template for reference content. Must contain at least one %s placeholder.', example='Reference source:\\\\n%s'),
  referenceLocation?: string(name='referenceLocation', description='The reference location.', example='head'),
  searchEngineConfig?: AiNetworkConfigSearchEngine(name='searchEngineConfig', description='The search engine configuration.'),
  searchFrom?: [
    AiNetworkConfigSearchEngine
  ](name='searchFrom', description='The list of search engines (multi-engine configuration).'),
  searchRewrite?: {
    enable?: boolean(name='enable', description='Specifies whether to enable search term rewriting.', example='true'),
    maxCount?: int32(name='maxCount', description='The maximum number of search terms after rewriting.', example='3'),
    modelName?: string(name='modelName', description='The name of the model used for rewriting.', example='qwen-max'),
    serviceId?: string(name='serviceId', description='The rewriting service ID.', example='svc-xxx'),
    timeoutMillisecond?: int32(name='timeoutMillisecond', description='The timeout period for the rewriting request, in milliseconds.', example='5000'),
  }(name='searchRewrite', description='The search term rewriting configuration.'),
}

model AiPluginStatus {
  errorLogs?: [ map[string]any ](name='errorLogs', description='The list of plug-in runtime error logs. Each item is a map[string]any key-value pair.'),
  pluginId?: string(name='pluginId', description='The ID of the plug-in instance.', example='pi-xxx'),
  serviceHealthy?: boolean(name='serviceHealthy', description='Indicates whether the backend service on which the plug-in depends is healthy.', example='true'),
}

model AiPolicyRedisConfig {
  databaseNumber?: int32(name='databaseNumber', description='The Redis database number.', example='0'),
  host?: string(name='host', description='The Redis hostname.', example='r-xxx.redis.rds.aliyuncs.com'),
  password?: string(name='password', description='The Redis password.', example='pass'),
  port?: int32(name='port', description='The Redis port.', example='6379'),
  timeout?: int32(name='timeout', description='The timeout period, in milliseconds.', example='5000'),
  username?: string(name='username', description='The Redis username.', example='user'),
}

model AiSecurityGuardConfig {
  bufferLimit?: int32(name='bufferLimit', description='The size of the response buffer in KB. Default value: 1000. Valid values: 1 to 1500.', example='1000'),
  checkRequest?: boolean(name='checkRequest', description='Specifies whether to check the request content.', example='true'),
  checkRequestImage?: boolean(name='checkRequestImage', description='Specifies whether to check the request images.', example='false'),
  checkResponse?: boolean(name='checkResponse', description='Specifies whether to check the response content.', example='true'),
  checkResponseImage?: boolean(name='checkResponseImage', description='Specifies whether to check the response images.', example='false'),
  consumerConfigBindings?: [ 
    {
      matchType?: string(name='matchType', description='The match type for consumer names. Valid values: exact (exact match), prefix (prefix match), regexp (regular expression match), and all (matches any consumer). Rules of the all type must be placed at the end of the binding list.', example='exact'),
      name?: string(name='name', description='The match condition for the consumer name. If matchType is exact, enter the full consumer name. If matchType is prefix, enter the name prefix. If matchType is regexp, enter a regular expression. The value cannot be empty for these three types. If matchType is all, the value must be an empty string.', example='example-consumer'),
      templateId?: string(name='templateId', description='The ID of the bound security guardrail configuration. This parameter cannot be empty. You can query the ID by calling the ListAiSecurityGuardConfigs operation and use the returned templateId.', example='apig_0123456789abcdef'),
    }
  ](name='consumerConfigBindings', description='The bindings between consumers and security guardrail configurations. An empty array explicitly clears the pending configurations.'),
  consumerRequestCheckService?: [ 
    {
      matchType?: string(name='matchType', description='The consumer match type.', example='exact'),
      modalityType?: string(name='modalityType', description='The modality type.', example='Text'),
      name?: string(name='name', description='The consumer name.', example='consumer-a'),
      requestCheckService?: string(name='requestCheckService', description='The check service.', example='query_security_check'),
      requestImageCheckService?: string(name='requestImageCheckService', description='The image check service.', example='img_query_guard'),
    }
  ](name='consumerRequestCheckService', description='The consumer-level request check service configuration.'),
  consumerResponseCheckService?: [ 
    {
      matchType?: string(name='matchType', description='The consumer match type.', example='exact'),
      modalityType?: string(name='modalityType', description='The modality type.', example='Text'),
      name?: string(name='name', description='The consumer name.', example='consumer-a'),
      responseCheckService?: string(name='responseCheckService', description='The check service.', example='query_security_check'),
      responseImageCheckService?: string(name='responseImageCheckService', description='The image check service.', example='img_query_guard'),
    }
  ](name='consumerResponseCheckService', description='The consumer-level response check service configuration.'),
  consumerRiskLevel?: [ 
    {
      level?: string(name='level', description='The risk level.', example='high'),
      matchType?: string(name='matchType', description='The consumer match type.', example='exact'),
      name?: string(name='name', description='The consumer name.', example='consumer-a'),
      type?: string(name='type', description='The risk dimension type.', example='ContentModeration'),
    }
  ](name='consumerRiskLevel', description='The consumer-level risk level configuration.'),
  defaultGenerated?: boolean(name='defaultGenerated', description='Specifies whether the entire security guardrail policy is populated by default for this query. Returns true only for synthesized policies. For existing policies, returns false or is not returned. This is a read-only field. It is ignored upon submission, is not saved, and does not affect the start or stop status.'),
  longTermEnabled?: boolean(name='longTermEnabled', description='Specifies whether to use the long-term solution. If omitted or set to null, the original value is retained during an update.'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The running status of the plug-in.'),
  requestCheckService?: string(name='requestCheckService', description='The ServiceCode of the request text check service. The system injects the default value.', example='query_security_check'),
  requestImageCheckService?: string(name='requestImageCheckService', description='The ServiceCode of the request image check service. The system injects the default value.', example='img_query_guard'),
  responseCheckService?: string(name='responseCheckService', description='The ServiceCode of the response text check service. The system injects the default value.', example='response_security_check'),
  responseImageCheckService?: string(name='responseImageCheckService', description='The ServiceCode of the response image check service. The system injects the default value.', example='img_response_guard'),
  riskAlertLevel?: string(name='riskAlertLevel', description='The global risk alert level.', example='high'),
  riskConfig?: [ 
    {
      consumerRules?: {
        matchType?: string(name='matchType', description='The match type.', example='Exact'),
        pattern?: string(name='pattern', description='The consumer match pattern value.', example='consumer-a'),
      }(name='consumerRules', description='The consumer-level match rules.'),
      level?: string(name='level', description='The risk level.', example='high'),
      type?: string(name='type', description='The risk dimension type.', example='ContentModeration'),
    }
  ](name='riskConfig', description='The list of risk dimension configurations. The system injects this list, which is generated by normalizing ConsumerRiskLevel.'),
  serviceAddress?: string(name='serviceAddress', description='The address of the security guardrail service, which is the green-cip endpoint. If the gateway and the security guardrail are in the same region, use the VPC internal network address.', example='https://green-cip-vpc.cn-shanghai.aliyuncs.com'),
}

model AiServiceConfig {
  apiKeyGenerateMode?: string(name='ApiKeyGenerateMode', description='The generation mode of the API key.', example='Custom'),
  address?: string(name='address', description='The service address.', example='https://dashscope.aliyun.com'),
  apiKeyFailover?: {
    cooldownDuration?: long(name='cooldownDuration', description='The cooldown duration after an API key is ejected.', example='30000'),
    enabled?: boolean(name='enabled', description='Specifies whether to enable API key failure ejection.', example='false'),
    failoverOnStatus?: [ string ](name='failoverOnStatus', description='The set of response status matching rules that trigger API key failure ejection.'),
    failureThreshold?: long(name='failureThreshold', description='The failure count threshold that triggers API key ejection.', example='3'),
  }(name='apiKeyFailover', description='The configuration for API key failure ejection and recovery.'),
  apiKeyReferences?: [ string ](name='apiKeyReferences', description='The read-only summary of KMS reference names, excluding credential values.'),
  apiKeys?: [ string ](name='apiKeys', description='The list of API keys.'),
  authHeaderKey?: string(name='authHeaderKey', description='The name of the request header used to pass authentication credentials to the upstream.', example='Authorization'),
  bedrockServiceConfig?: {
    awsAccessKey?: string(name='awsAccessKey', description='The AWS access key.', example='AKIAIOSFODNN7EXAMPLE'),
    awsRegion?: string(name='awsRegion', description='The AWS region.', example='us-east-1'),
    awsSecretKey?: string(name='awsSecretKey', description='The AWS secret key.', example='wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY'),
    bedrockPromptCachePointPositions?: map[string]boolean(name='bedrockPromptCachePointPositions', description='Configures whether to insert Bedrock cache markers based on prompt positions.', example='{"systemPrompt":true}'),
    endpointMode?: string(name='endpointMode', description='The Bedrock service endpoint mode, which supports runtime and mantle. If omitted, runtime is used.', example='runtime'),
    promptCacheEnable?: boolean(name='promptCacheEnable', description='Specifies whether to enable prompt caching for the Bedrock upstream.', example='true'),
    promptCacheRetention?: string(name='promptCacheRetention', description='The data retention policy for the prompt cache.', example='in_memory'),
    promptCacheStrategy?: string(name='promptCacheStrategy', description='The applicable model strategy for Bedrock prompt caching.', example='supported_models_only'),
  }(name='bedrockServiceConfig', description='The Bedrock service-specific configuration.'),
  claudeCodeMode?: boolean(name='claudeCodeMode', description='Specifies whether to enable Claude Code compatibility mode.', example='false'),
  compatibleProtocols?: [ string ](name='compatibleProtocols', description='The list of compatible protocols supported by the service.'),
  configRevision?: string(name='configRevision', description='The read-only service configuration version. Use expectedConfigRevision for conditional updates.', example='7e4f52a9b0c34d16a268e913f5c2087b'),
  defaultModelName?: string(name='defaultModelName', description='The name of the default model.', example='gpt-4'),
  enableHealthCheck?: boolean(name='enableHealthCheck', description='Specifies whether to enable health checks.', example='true'),
  enableOutlierDetection?: boolean(name='enableOutlierDetection', description='Specifies whether to enable the outlier detection feature.', example='true'),
  klingServiceConfig?: {
    klingAccessKey?: string(name='klingAccessKey', description='The KlingAI access key identifier. Examples use desensitized values.', example='kling-access-key-****'),
    klingSecretKey?: string(name='klingSecretKey', description='The KlingAI secret key. Examples use desensitized values.', example='kling-secret-key-****'),
    klingTokenRefreshAhead?: long(name='klingTokenRefreshAhead', description='The advance refresh configuration for KlingAI tokens.', example='120'),
  }(name='klingServiceConfig', description='The authentication and token configuration specific to the KlingAI service.'),
  paiEASServiceConfig?: {
    endpointType?: string(name='endpointType', description='The connection type, which can be a private network (VPC) or a public network.', example='"public"，"private"'),
    serviceId?: string(name='serviceId', description='The service ID.', example='svc-cvaeb0um1hkqp79k72v0'),
    serviceName?: string(name='serviceName', description='The service name.', example='auto-ai-service'),
    workspaceId?: string(name='workspaceId', description='The workspace ID.', example='cb89d4de30042df4459442589664e00d'),
  }(name='paiEASServiceConfig', description='The PAI-EAS service-specific configuration.'),
  protocols?: [ string ](name='protocols', description='The list of model protocols.'),
  provider?: string(name='provider', description='The large language model provider.', example='qwen
