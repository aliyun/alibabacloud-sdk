  creationClientToken?: string(name='creationClientToken', description='The read-only correlation identifier for creation requests. It is returned only when the association with the same instance is unique within approximately 24 hours after the first persistence following normal authentication. It is omitted for historical, expired, or ambiguous cases. This identifier cannot be used to determine the success of publishing or authorization, nor does it replace the creation of idempotent records.', example='b1907ca4-952c-4c5f-8d1f-0aa6ae339c96'),
  deleteStatus?: string(name='deleteStatus', description='The deletion status of the new version model API. This field is read-only and optional. Deleting indicates that the deletion request is accepted but not yet completed. DeleteFailed indicates that the background deletion failed, and you can use the original clientToken to retry the DeleteModelApi operation. This field is not returned for normal publishing and historical undeployment. The absence of this field does not indicate that the deletion is complete.', example='Deleting'),
  deployCntMap?: map[string]ModelApiApiInfoDeployCntMapValue(name='deployCntMap', description='The publish status of the API operation.', example='{"example-scope":{"deployedCnt":1,"cnt":1}}'),
  deployErrorMessage?: string(name='deployErrorMessage', description='The reason for the deployment or deletion failure. This field is read-only.', example='The model configuration is unavailable'),
  description?: string(name='description', description='The API description.', example='Model API for business integration'),
  domainIds?: [ string ](name='domainIds', description='The selected domain IDs.'),
  domainInfos?: [
    ModelApiDomainInfo
  ](name='domainInfos', description='The read-only domain name details and the default domain name flag.'),
  enableAuth?: boolean(name='enableAuth', description='Specifies whether to enable authentication.', example='true'),
  environmentId?: string(name='environmentId', description='The default environment ID of the bound instance. This field is read-only.', example='env-d00000000000000000000'),
  gatewayId?: string(name='gatewayId', description='The ID of the gateway instance to which the API belongs.', example='gw-d00000000000000000000'),
  gatewayInfo?: GatewayInfo(name='gatewayInfo', description='The read-only information of the bound instance.'),
  httpApiId?: string(name='httpApiId', description='The model API ID.', example='api-xxx'),
  ingressInfo?: {
    environmentInfo?: {
      environmentId?: string(name='environmentId', description='The environment ID.', example='env-d00000000000000000000'),
    }(name='environmentInfo', description='The environment context.'),
    ingressClass?: string(name='ingressClass', description='The ingress class.', example='apig'),
    k8sClusterInfo?: {
      clusterId?: string(name='clusterId', description='The cluster ID.', example='c00000000000000000000000000000001'),
    }(name='k8sClusterInfo', description='The Kubernetes cluster information.'),
    overrideIngressIp?: boolean(name='overrideIngressIp', description='Specifies whether to update the address in the ingress status.', example='false'),
    sourceId?: string(name='sourceId', description='The source ID.', example='src-d00000000000000000000'),
    watchNamespace?: string(name='watchNamespace', description='The watched namespace.', example='default'),
  }(name='ingressInfo', description='The HTTP ingress API information.'),
  modelApiInfo?: {
    directSupplyFallbackEnabled?: boolean(name='directSupplyFallbackEnabled', description='The saved state of the direct supply fallback. A value of false indicates that it is disabled. This only reflects the saved configuration and does not indicate successful publishing or activation.', example='false'),
    exposureMode?: string(name='exposureMode', description='The model exposure mode. Only SELECTED is supported in Phase 1.', example='SELECTED'),
    modelSelection?: ModelSelection(name='modelSelection', description='The model selection configuration.'),
    resolvedModelSelection?: {
      complete?: boolean(name='complete', description='Indicates whether the expanded collection of the current configuration is fully read. A fully empty group returns true and an empty array. Missing, invalid groups, or read failures return false. This does not reflect the online publishing or consumer permission status.', example='true'),
      modelCardIds?: [ string ](name='modelCardIds', description='The identities of the models selected for public exposure in the current configuration, stably sorted and deduplicated. Logical models retain their own IDs and do not include fallback-only targets or underlying execution cards of logical models. If complete is false, this is an empty array and must not be interpreted as zero models.'),
    }(name='resolvedModelSelection', description='The read-only collection of publicly exposed models for the current configuration. It retains the modelSelection edit source, but the successful online collection is still subject to publishedEndpoints.'),
    routingMode?: string(name='routingMode', description='The routing mode. Only Direct is supported in Phase 1.', example='Direct'),
  }(name='modelApiInfo', description='The model API public selection information.'),
  modelCardRuntimeDiagnostics?: [ 
    {
      deployConfigIndex?: int32(name='deployConfigIndex', description='The index of the corresponding deployment configuration.', example='0'),
      gatewayId?: string(name='gatewayId', description='The gateway instance ID.', example='gw-d00000000000000000000'),
      invalidConfiguration?: boolean(name='invalidConfiguration', description='Indicates whether the marker of the deployment configuration is invalid.', example='true'),
      reasons?: [ string ](name='reasons', description='The list of reasons for invalidity.'),
    }
  ](name='modelCardRuntimeDiagnostics', description='The read-only runtime diagnostic information for model cards, derived from the original markers of the deployment configuration. It is used only for the readability and diagnostics of abnormal drafts.'),
  modelCategory?: string(name='modelCategory', description='The model category of the model API.', example='Text'),
  name?: string(name='name', description='The API name.', example='test'),
  policyConfigs?: [
    ModelApiPolicyConfig
  ](name='policyConfigs', description='The inline configurations for AI request logs and AI security protection.'),
  protocols?: [ string ](name='protocols', description='The list of API protocols.'),
  publishedEndpoints?: [ 
    {
      endpoint?: string(name='endpoint', description='The name of the successfully published built-in endpoint.', example='model-responses'),
      modelCardIds?: [ string ](name='modelCardIds', description='The collection of executable ModelCard IDs successfully published for this path.'),
    }
  ](name='publishedEndpoints', description='The collection of successfully published per-path executable models. This field is read-only. It is empty when a snapshot is missing, which does not represent consumer permission.'),
  resourceGroupId?: string(name='resourceGroupId', description='The resource group ID.', example='rg-xxx'),
  status?: string(name='status', description='The publishing status on the bound instance. In the new version, the status is Undeploying when a deletion is in progress, and UndeployFailed when a deletion fails. To determine whether an operation is a deletion, refer to the deleteStatus field.', example='Deployed'),
  type?: string(name='type', description='The API type.', example='LLM'),
  versionInfo?: HttpApiVersionInfo(name='versionInfo', description='The API versioning information.'),
}

