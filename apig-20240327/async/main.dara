  serviceConfigs?: [ 
    {
      addresses?: [ string ](name='addresses', description='The list of domain names or fixed addresses.'),
      agentServiceConfig?: AgentServiceConfig(name='agentServiceConfig', description='The agent service configuration. This parameter is required when the source type is AGENT.'),
      aiServiceConfig?: AiServiceConfig(name='aiServiceConfig', description='The AI service configuration. This parameter is required when the source type is AI.'),
      dnsServers?: [ string ](name='dnsServers', description='The list of DNS server addresses.'),
      expressType?: string(name='expressType', description='The service expression type, which identifies the special type or mode of the service.', example='Standard'),
      groupName?: string(name='groupName', description='The name of the service group. This parameter is required when the source type is MSE_NACOS.', example='DEFAULT_GROUP'),
      modelProviderId?: string(name='modelProviderId', description='The ID of the model provider. This parameter is applicable only to AI services.', example='mp-xxx****'),
      name?: string(name='name', description='The name of the service. This parameter is required when the source type is FC3.', example='user-service'),
      namespace?: string(name='namespace', description='The namespace of the service:

- If the source type is K8S, this parameter specifies the namespace where the Kubernetes service resides.
- If the source type is MSE_NACOS, this parameter specifies the namespace in Nacos.

This parameter is required when the source type is K8S or MSE_NACOS.', example='PUBLIC'),
      qualifier?: string(name='qualifier', description='The function version or alias.', example='LATEST'),
      sourceId?: string(name='sourceId', description='The ID of the service source. This parameter is required in scenarios with multiple Nacos instances.', example='nacos-instance-001'),
      validationOptions?: {
        skipVerifyAIChatCompletion?: boolean(name='skipVerifyAIChatCompletion', description='Specifies whether to skip the AI chat completion validation.'),
      }(name='validationOptions', description='The validation options, which include configuration options related to service validation.'),
    }
  ](name='serviceConfigs', description='The list of service configurations. At least one service configuration must be included.', position='Body'),
  sourceType?: string(name='sourceType', description='The source of the service. Valid values:
- MSE_NACOS: Services in MSE Nacos.
- K8S: Services in Kubernetes clusters of Container Service.
- VIP: Fixed-address services.
- DNS: DNS domain name services.
- FC3: Services in Function Compute.
- SAE_K8S_SERVICE: SAE Kubernetes services.
- AI: AI services.
- AGENT: Agent services.', example='MSE_NACOS', position='Body'),
  clientToken?: string(name='clientToken', description='The client token.', example='create-service-client-token-001', position='Query'),
}

