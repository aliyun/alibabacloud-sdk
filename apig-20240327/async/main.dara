  dryRun?: boolean(name='dryRun', description='Specifies whether to perform a dry run only without saving to the database or delivering actual configurations. This is used to check whether conflicting rules exist on the bound consumers. A single consumer cannot be configured with two natural period quotas of the same period. For example, a consumer that already has a natural daily quota cannot be added with another natural daily quota rule.', example='true', position='Body'),
  overwrite?: boolean(name='overwrite', description='Specifies whether to allow overwriting when a conflict occurs. Note that if overwriting is allowed, the conflicting subjects (consumers or consumer groups) will be unbound from the old rule and bound to the new rule.', position='Body'),
  quotaLimit?: long(name='quotaLimit', description='The updated total available quota.', example='1000', position='Body'),
  removeIds?: [ string ](name='removeIds', description='The list of IDs of the subjects (consumers) to unbind.', example='cs003,cs-004', position='Body'),
