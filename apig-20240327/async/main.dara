  retryOnFailure?: {
    enabled?: boolean(name='enabled', description='Specifies whether to enable retries upon current request failure.', example='false'),
    maxRetries?: long(name='maxRetries', description='The maximum number of retries for the current request.', example='2'),
    retryOnStatus?: [ string ](name='retryOnStatus', description='The set of response status matching rules that trigger retries for the current request.'),
    retryTimeout?: long(name='retryTimeout', description='The retry timeout configuration for the current request.', example='30000'),
  }(name='retryOnFailure', description='The configuration for retrying with a different key after the current request fails.'),
  upstreamAuthMode?: string(name='upstreamAuthMode', description='The upstream authentication mode, which distinguishes between API key authentication, no authentication, and pass-through downstream authentication.', example='api-key'),
  vertexServiceConfig?: {
    geminiSafetySetting?: map[string]string(name='geminiSafetySetting', description='The safety filtering level settings for the Gemini model.'),
    vertexAuthKey?: string(name='vertexAuthKey', description='The authentication key for Vertex AI.', example='{\\\\"type\\\\":\\\\"service_account\\\\",\\\\"project_id\\\\":\\\\"my-project\\\\",\\\\"private_key\\\\":\\\\"-----BEGIN PRIVATE KEY-----...\\\\",\\\\"client_email\\\\":\\\\"xxx@xxx.iam.gserviceaccount.com\\\\",\\\\"token_uri\\\\":\\\\"https://oauth2.googleapis.com/token\\\\"}'),
    vertexAuthServiceName?: string(name='vertexAuthServiceName', description='The authentication service name used by Vertex AI.', example='google-oauth2'),
    vertexOpenAICompatible?: boolean(name='vertexOpenAICompatible', description='Specifies whether to use the OpenAI-compatible interface of Vertex AI.', example='false'),
    vertexProjectId?: string(name='vertexProjectId', description='The Google Cloud project ID.', example='my-project'),
    vertexRegion?: string(name='vertexRegion', description='The Google Cloud region where the Vertex AI service is located.', example='us-central1'),
