      data?: map[string]string(name='data', description='The detailed data related to the risk. The data structure varies by risk type.'),
      description?: string(name='description', description='The detailed description of the risk in JSON string format.', example='{"desc":"The single-node instance has an architecture risk. A single point of failure can cause service unavailability. Scale out to two or more nodes."}'),
      isNoticeMute?: boolean(name='isNoticeMute', description='Indicates whether the alert notification for the risk item is muted.', example='false'),
      riskCode?: string(name='riskCode', description='The unique identifier of the risk item.', example='30010010001'),
      riskLevel?: string(name='riskLevel', description='The level of the risk item. Valid values: LOW, MEDIUM, HIGH, and CRITICAL.', example='HIGH'),
      riskName?: string(name='riskName', description='The name of the risk item.', example='Single-node architecture risk'),
      riskType?: string(name='riskType', description='The risk category. Valid values:
- SYSTEM: System risk.
- VERSION: Version risk.
- SAFE: Security risk.
- CAPACITY: Capacity risk.', example='SYSTEM'),
      situation?: string(name='situation', description='The current risk situation of the instance in JSON string format.', example='{"desc":"The cluster has only one node and does not support high availability."}'),
      suggestion?: string(name='suggestion', description='The optimization suggestions for the risk in JSON string format, including descriptions and action links.', example='{"desc":"Scale out to two or more nodes.","links":[{"descEn":"click to upgrade specification","type":"upgrade","desc":"Click to scale out"}]}'),
    }
  ](name='riskDetails', description='The list of detailed risk items.'),
  riskLevel?: string(name='riskLevel', description='The overall risk level. Valid values:
- LOW: Low risk.
- MEDIUM: Medium risk.
- HIGH: High risk.
- CRITICAL: Critical risk.', example='MEDIUM'),
  score?: int32(name='score', description='The overall risk score. Valid values: 0 to 100. A higher score indicates a lower risk.', example='85'),
  snapshotTime?: long(name='snapshotTime', description='The snapshot time.', example='1234567890000'),
  status?: string(name='status', description='The risk detection status. Valid values:
- SUCCESS: The detection succeeded.
- FAIL: The detection failed.
- RUNNING: The detection is running.', example='SUCCESS'),
  totalRisk?: int32(name='totalRisk', description='The total number of detected risk items.', example='1'),
}

