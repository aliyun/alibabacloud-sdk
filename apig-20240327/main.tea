  periodType?: string(name='periodType', description='The period type. Calendar periods support daily, weekly, and monthly statistics. Valid values: day, week, and month. Custom periods support only daily statistics. The value is fixed to day.', example='week'),
  quotaLimit?: long(name='quotaLimit', description='The total available quota per period after the reset.', example='1000'),
  timezone?: string(name='timezone', description='The time zone for the calendar period, in UTC+x format.', example='UTC+8'),
  windowAlignment?: string(name='windowAlignment', description='The period alignment type after the reset. Valid values:
- calendar: calendar period.
- epoch: custom period.', example='calendar'),
}

