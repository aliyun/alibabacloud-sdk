  dryRun?: boolean(name='dryRun', description='Specifies whether to perform only a dry run without persisting or applying the configuration. A dry run checks whether conflicting rules exist on the bound consumer subjects. The same consumer subject cannot have two calendar-period quotas with the same period. For example, a consumer subject that already has a daily calendar quota cannot be assigned another daily calendar quota rule.', example='true'),
  overwrite?: boolean(name='overwrite', description='Specifies whether to allow overwriting when a conflict exists. If overwriting is allowed, conflicting subjects (consumers or consumer groups) are unbound from the old rule and bound to the new rule.'),
  quotaLimit?: long(name='quotaLimit', description='The updated total available quota per period.', example='1000'),
  removeIds?: [ string ](name='removeIds', description='The list of consumer subject IDs to unbind.', example='cs003,cs-004'),
  ruleName?: string(name='ruleName', description='The updated rule name.', example='team-rule'),
}

