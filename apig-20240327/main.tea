  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The plugin running status.', nullable=true),
  requestCheckService?: string(name='requestCheckService', description='The ServiceCode of the request text detection service. The default value is injected by the system.', example='query_security_check'),
  requestImageCheckService?: string(name='requestImageCheckService', description='The ServiceCode of the request image detection service. The default value is injected by the system.', example='img_query_guard'),
  responseCheckService?: string(name='responseCheckService', description='The ServiceCode of the response text detection service. The default value is injected by the system.', example='response_security_check'),
