  if (!Util.isUnset(request.conflictHash)) {
    body['conflictHash'] = request.conflictHash;
  }
  if (!Util.isUnset(request.dryRun)) {
    body['dryRun'] = request.dryRun;
  }
  if (!Util.isUnset(request.overwrite)) {
    body['overwrite'] = request.overwrite;
  }
  if (!Util.isUnset(request.periodMultiplier)) {
    body['periodMultiplier'] = request.periodMultiplier;
  }
  if (!Util.isUnset(request.periodType)) {
    body['periodType'] = request.periodType;
  }
  if (!Util.isUnset(request.quotaLimit)) {
    body['quotaLimit'] = request.quotaLimit;
  }
  if (!Util.isUnset(request.timezone)) {
    body['timezone'] = request.timezone;
  }
  if (!Util.isUnset(request.windowAlignment)) {
    body['windowAlignment'] = request.windowAlignment;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'ResetGatewayQuotaRule',
    version = '2024-03-27',
    protocol = 'HTTPS',
    pathname = `/v1/gateways/${OpenApiUtil.getEncodeParam(gatewayId)}/quota-rules/${OpenApiUtil.getEncodeParam(ruleId)}/reset`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

