  ](name='riskConfig', description='The list of risk dimension configurations. The values are injected by the system and generated by normalizing ConsumerRiskLevel.'),
  serviceAddress?: string(name='serviceAddress', description='The security guardrail service address (green-cip endpoint). Use the VPC internal network address when the gateway and the security guardrail are in the same region.', example='https://green-cip-vpc.cn-shanghai.aliyuncs.com'),
}

