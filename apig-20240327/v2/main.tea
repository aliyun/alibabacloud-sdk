/**
 *
 */
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-southeast-2' = 'apig.ap-southeast-2.aliyuncs.com',
    'ap-southeast-6' = 'apig.ap-southeast-6.aliyuncs.com',
    'ap-southeast-7' = 'apig.ap-southeast-7.aliyuncs.com',
    'cn-guangzhou' = 'apig.cn-guangzhou.aliyuncs.com',
    'cn-heyuan' = 'apig.cn-heyuan.aliyuncs.com',
    'cn-shenzhen' = 'apig.cn-shenzhen.aliyuncs.com',
    'cn-wulanchabu' = 'apig.cn-wulanchabu.aliyuncs.com',
    'cn-beijing' = 'apig.cn-beijing.aliyuncs.com',
    'ap-northeast-2' = 'apig.ap-northeast-2.aliyuncs.com',
    'ap-northeast-1' = 'apig.ap-northeast-1.aliyuncs.com',
    'cn-chengdu' = 'apig.cn-chengdu.aliyuncs.com',
    'cn-qingdao' = 'apig.cn-qingdao.aliyuncs.com',
    'cn-shanghai' = 'apig.cn-shanghai.aliyuncs.com',
    'cn-hongkong' = 'apig.cn-hongkong.aliyuncs.com',
    'ap-southeast-1' = 'apig.ap-southeast-1.aliyuncs.com',
    'ap-southeast-3' = 'apig.ap-southeast-3.aliyuncs.com',
    'ap-southeast-5' = 'apig.ap-southeast-5.aliyuncs.com',
    'cn-zhangjiakou' = 'apig.cn-zhangjiakou.aliyuncs.com',
    'cn-hangzhou' = 'apig.cn-hangzhou.aliyuncs.com',
    'us-west-1' = 'apig.us-west-1.aliyuncs.com',
    'us-east-1' = 'apig.us-east-1.aliyuncs.com',
    'eu-central-1' = 'apig.eu-central-1.aliyuncs.com',
    'eu-west-1' = 'apig.eu-west-1.aliyuncs.com',
    'me-east-1' = 'apig.me-east-1.aliyuncs.com',
    'me-central-1' = 'apig.me-central-1.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('apig', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AgentAccessConfig {
  aiRequestLogEnabled?: boolean(name='aiRequestLogEnabled', description='Specifies whether to enable AI request logging. Default value if omitted: true.', example='false'),
  authorization?: {
    authType?: string(name='authType', description='The authentication type of the Agent access entry. Specify this parameter only when enabled is set to true.', example='Apikey'),
    enabled?: boolean(name='enabled', description='Specifies whether to enable consumer authorization. If set to true, authType must be specified and at least one principal must be provided. If set to false, no principals can be specified.

This parameter is required.', example='true'),
    principals?: [
      AgentAuthorizationPrincipal
    ](name='principals', description='The list of consumers or consumer groups that are granted Agent access permissions. At least one principal must be specified when enabled is set to true.'),
  }(name='authorization', description='The consumer authorization configuration for Agent access. If omitted, consumer authorization is not enabled.'),
  basePath?: string(name='basePath', description='The base path of the Agent access entry. The path must start with a forward slash (/).

This parameter is required.', example='/agent'),
  domainIds?: [ string ](name='domainIds', description='The list of domain name IDs bound to the Agent access entry. At least one domain name must be specified.

This parameter is required.'),
  removeBasePathOnForward?: boolean(name='removeBasePathOnForward', description='Specifies whether to remove the base path when forwarding requests to the backend. Default value if omitted: false.', example='true'),
}

model AgentAuthorizationPrincipal {
  principalId?: string(name='principalId', description='The ID of the authorization principal. Specify a consumer ID or consumer group ID based on the value of principalType.

This parameter is required.', example='consumer-1'),
  principalType?: string(name='principalType', description='The type of the authorization principal. Valid values:

- Consumer: consumer.
- ConsumerGroup: consumer group.

This parameter is required.', example='Consumer'),
}

model AgentInfo {
  agentAccess?: {
    httpApiId?: string(name='httpApiId', description='The HTTP API ID associated with the Agent access capability. The frontend uses this ID to call existing HTTP API, route, consumer authorization, policy, and plugin query interfaces.', example='{ "httpApiId": "api-abc123" }'),
  }(name='agentAccess', description='The associated resource information for the Agent access capability. Returns null if the Agent access capability is not configured.', nullable=true),
  agentId?: string(name='agentId', description='Agent ID。', example='agent-1'),
  agentType?: string(name='agentType', description='The Agent type. DashScope (Bailian) allows only Agent access. Dify allows both Agent access and model access. ClaudeCode allows only model access. Custom allows both Agent access and model access.', example='Custom'),
  allowedCapabilities?: [ string ](name='allowedCapabilities', description='The list of capabilities that the current Agent type allows to be configured. This field does not indicate that the capabilities are already configured. To determine whether a capability is configured, check whether agentAccess or modelAccess is null.'),
  createTimestamp?: long(name='createTimestamp', description='The Agent creation time, in Unix millisecond timestamp.', example='1755129600000'),
  description?: string(name='description', description='The Agent description.', example='custom agent'),
  gatewayId?: string(name='gatewayId', description='The gateway ID to which the Agent belongs. When reading the associated API deployment configuration, select the configuration whose gatewayId matches this value.', example='gateway-1'),
  modelAccess?: {
    consumerIds?: [ string ](name='consumerIds', description='The list of consumer identity bindings maintained by the Agent domain. The Model API ID and the consumer IDs in this list together identify the Agent identity and take effect on all routes of the Model API. Consumer details and their Model API authorization details can be obtained through existing Consumer API and consumer authorization query interfaces.'),
    modelApiId?: string(name='modelApiId', description='The Model API ID associated with the model access capability. Model Access does not distinguish routes. The frontend uses this ID to query the Model API basic information and all routes.', example='{ "modelApiId": "model-api-1" }'),
  }(name='modelAccess', description='The associated resource information for the model access capability. Returns null if the model access capability is not configured.', nullable=true),
  name?: string(name='name', description='The Agent name.', example='my-agent'),
  resourceGroupId?: string(name='resourceGroupId', description='The resource group ID in which the Agent is saved.', example='rg-1'),
  status?: string(name='status', description='The Agent status. An Agent that is successfully created and queryable always returns Ready. Internal creation or compensation states are not returned externally.', example='Ready'),
  updateTimestamp?: long(name='updateTimestamp', description='The Agent last update time, in Unix millisecond timestamp.', example='1755129600000'),
}

model AgentModelAccessConfig {
  consumerIds?: [ string ](name='consumerIds', description='The list of consumer IDs that represent the Agent to access the Model API. The Model API ID and consumer ID together identify the Agent identity, and the configuration takes effect for all current and future routes of the Model API. Specify at least one consumer. The consumer must be enabled and must have direct Consumer authorization for the Model API in the default environment of the target gateway, with the authorization publish status being Success. Different Agents cannot bind the same consumer to the same Model API. ConsumerGroup is not supported.

This parameter is required.'),
  modelApiId?: string(name='modelApiId', description='The ID of the Model API to associate. The Model API must belong to the specified gateway.

This parameter is required.', example='model-api-1'),
}

model AgentServiceConfig {
  address?: string(name='address', description='The address.

This parameter is required.', example='https://dashscope.aliyuncs.com/api/v1'),
  customConfig?: {
    apiKey?: string(name='apiKey', description='The API key.', example='app-xxx'),
    apiKeyGenerateMode?: string(name='apiKeyGenerateMode', description='The key generation mode.', example='Reference'),
  }(name='customConfig', description='The custom configuration. Required when provider is set to custom.'),
  dashScopeConfig?: {
    appCredentials?: [ 
      {
        apiKey?: string(name='apiKey', description='apiKey', example='sk-xxx'),
        appId?: string(name='appId', description='The application ID.', example='app-xxx'),
      }
    ](name='appCredentials', description='The application configuration.'),
  }(name='dashScopeConfig', description='The DashScope service configuration. Required when provider is set to qwen. The appCredentials parameter cannot be empty, and each entry must have non-empty appId and apiKey values.'),
  difyConfig?: {
    apiKey?: string(name='apiKey', description='API Key', example='app-xxx'),
    botType?: string(name='botType', description='The interaction type.', example='chatflow'),
  }(name='difyConfig', description='The Dify service configuration. Required when provider is set to dify. The botType and apiKey parameters cannot be empty.'),
  enableHealthCheck?: boolean(name='enableHealthCheck', description='Specifies whether to enable health check.', example='true'),
  enableOutlierDetection?: boolean(name='enableOutlierDetection', description='Specifies whether to enable outlier detection.', example='true'),
  protocols?: [ string ](name='protocols', description='The list of communication protocols.'),
  provider?: string(name='provider', description='The service provider.

This parameter is required.', example='qwen'),
}

model AiCacheConfig {
  cacheKeyStrategy?: string(name='cacheKeyStrategy', description='The cache key generation strategy.', example='-'),
  cacheMode?: string(name='cacheMode', description='The cache mode.', example='exact'),
  cacheTTL?: int32(name='cacheTTL', description='The cache expiration time, in seconds.', example='3600'),
  embeddingConfig?: {
    modelName?: string(name='modelName', description='The embedding model name.', example='text-embedding-v2'),
    serviceId?: string(name='serviceId', description='The embedding service ID.', example='svc-xxx'),
    timeout?: int32(name='timeout', description='The request timeout period, in milliseconds.', example='5000'),
    type?: string(name='type', description='The embedding service type.', example='dashscope'),
  }(name='embeddingConfig', description='The embedding service configuration.'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The plugin running status.', nullable=true),
  redisConfig?: AiPolicyRedisConfig(name='redisConfig', description='The Redis configuration for exact cache count storage.', nullable=true),
  vectorConfig?: {
    apiKey?: string(name='apiKey', description='The API key of the vector database.', example='sk-xxx'),
    collectionId?: string(name='collectionId', description='The vector collection ID.', example='col-xxx'),
    serviceHost?: string(name='serviceHost', description='The service address of the vector database.', example='vdb-xxx.dashvector.aliyuncs.com'),
    threshold?: float(name='threshold', description='The similarity threshold.', example='0.95'),
    timeout?: int32(name='timeout', description='The request timeout period, in milliseconds.', example='5000'),
    type?: string(name='type', description='The vector database type.', example='dashvector'),
  }(name='vectorConfig', description='The vector database configuration.'),
}

model AiFallbackConfig {
  onlyRedirectUpstreamCode?: boolean(name='onlyRedirectUpstreamCode', description='When set to true, fallback is triggered only when the backend returns a 4xx/5xx status code. Status codes generated by the gateway itself (such as 503 connection failed) do not trigger fallback. Requires DPI engine version 2.1.11 or later. If the version is insufficient, this setting is silently ignored.', example='true'),
  serviceConfigs?: [ 
    {
      name?: string(name='name', description='The service name.', example='—'),
      passThroughModelName?: boolean(name='passThroughModelName', description='Specifies whether to pass through the model name from the original request.', example='false'),
      serviceId?: string(name='serviceId', description='The ID of the fallback target service.', example='svc-bbb'),
      targetModelName?: string(name='targetModelName', description='The name of the fallback target model.', example='qwen-max'),
    }
  ](name='serviceConfigs', description='The list of fallback target services, excluding the primary routing service.'),
}

model AiNetworkConfigSearchEngine {
  apiKey?: string(name='apiKey', description='The API key of the search engine.', example='sk-xxx'),
  contentMode?: string(name='contentMode', description='Quark-specific: the content mode.', example='summary'),
  count?: int32(name='count', description='The number of results returned per search.', example='5'),
  endpoint?: string(name='endpoint', description='The endpoint of the search engine.', example='https://cloud-iqs.aliyuncs.com'),
  industry?: string(name='industry', description='Quark-specific: the industry filter.', example='互联网'),
  optionArgs?: map[string]string(name='optionArgs', description='The search engine-specific parameters in key-value pair format.'),
  start?: int32(name='start', description='The offset of search results.', example='0'),
  timeRange?: string(name='timeRange', description='Quark-specific: the time range filter.', example='7d'),
  timeoutMillisecond?: int32(name='timeoutMillisecond', description='The API call timeout period, in milliseconds.', example='5000'),
  type?: string(name='type', description='The search engine type.', example='aliyunQuark'),
}

model AiNetworkSearchConfig {
  defaultEnable?: boolean(name='defaultEnable', description='Specifies whether the plug-in feature is enabled by default.', example='true'),
  defaultLang?: string(name='defaultLang', description='The default search language code.', example='zh-CN'),
  needReference?: boolean(name='needReference', description='Specifies whether to add reference sources in the answer.', example='true'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The plug-in running status.', nullable=true),
  referenceFormat?: string(name='referenceFormat', description='The format template for reference content. The template must contain at least one %s placeholder.', example='参考来源:\\\\n%s'),
  referenceLocation?: string(name='referenceLocation', description='The reference location.', example='head'),
  searchEngineConfig?: AiNetworkConfigSearchEngine(name='searchEngineConfig', description='The search engine configuration.'),
  searchFrom?: [
    AiNetworkConfigSearchEngine
  ](name='searchFrom', description='The list of search engines (multi-engine configuration).'),
  searchRewrite?: {
    enable?: boolean(name='enable', description='Specifies whether to enable search query rewriting.', example='true'),
    maxCount?: int32(name='maxCount', description='The maximum number of search queries after rewriting.', example='3'),
    modelName?: string(name='modelName', description='The name of the model used for rewriting.', example='qwen-max'),
    serviceId?: string(name='serviceId', description='The ID of the rewriting service.', example='svc-xxx'),
    timeoutMillisecond?: int32(name='timeoutMillisecond', description='The timeout period for the rewriting request, in milliseconds.', example='5000'),
  }(name='searchRewrite', description='The search term rewriting configuration.'),
}

model AiPluginStatus {
  errorLogs?: [ map[string]any ](name='errorLogs', description='The list of plug-in runtime error logs. Each item is a map[string]any key-value pair.'),
  pluginId?: string(name='pluginId', description='The plug-in instance ID.', example='pi-xxx'),
  serviceHealthy?: boolean(name='serviceHealthy', description='Indicates whether the backend service that the plugin depends on is healthy.', example='true'),
}

model AiPolicyRedisConfig {
  databaseNumber?: int32(name='databaseNumber', description='The Redis database number.', example='0'),
  host?: string(name='host', description='The Redis host address.', example='r-xxx.redis.rds.aliyuncs.com'),
  password?: string(name='password', description='The Redis password.', example='pass'),
  port?: int32(name='port', description='The Redis port.', example='6379'),
  timeout?: int32(name='timeout', description='The timeout period, in milliseconds.', example='5000'),
  username?: string(name='username', description='The Redis username.', example='user'),
}

model AiSecurityGuardConfig {
  bufferLimit?: int32(name='bufferLimit', description='The response buffer size in KB. Default value: 1000. Valid values: 1 to 1500.', example='1000'),
  checkRequest?: boolean(name='checkRequest', description='Specifies whether to check request content.', example='true'),
  checkRequestImage?: boolean(name='checkRequestImage', description='Specifies whether to check request images.', example='false'),
  checkResponse?: boolean(name='checkResponse', description='Specifies whether to check response content.', example='true'),
  checkResponseImage?: boolean(name='checkResponseImage', description='Specifies whether to check response images.', example='false'),
  consumerRequestCheckService?: [ 
    {
      matchType?: string(name='matchType', description='The consumer matching method.', example='exact'),
      modalityType?: string(name='modalityType', description='The modality type.', example='Text'),
      name?: string(name='name', description='The consumer name.', example='consumer-a'),
      requestCheckService?: string(name='requestCheckService', description='The check service.', example='query_security_check'),
      requestImageCheckService?: string(name='requestImageCheckService', description='The image check service.', example='img_query_guard'),
    }
  ](name='consumerRequestCheckService', description='The consumer-level request detection service configuration.'),
  consumerResponseCheckService?: [ 
    {
      matchType?: string(name='matchType', description='The consumer matching method.', example='exact'),
      modalityType?: string(name='modalityType', description='The modality type.', example='Text'),
      name?: string(name='name', description='The consumer name.', example='consumer-a'),
      responseCheckService?: string(name='responseCheckService', description='The check service.', example='query_security_check'),
      responseImageCheckService?: string(name='responseImageCheckService', description='The image check service.', example='img_query_guard'),
    }
  ](name='consumerResponseCheckService', description='The consumer-level response detection service configuration.'),
  consumerRiskLevel?: [ 
    {
      level?: string(name='level', description='The risk level.', example='high'),
      matchType?: string(name='matchType', description='The consumer matching method.', example='exact'),
      name?: string(name='name', description='The consumer name.', example='consumer-a'),
      type?: string(name='type', description='The risk dimension type.', example='ContentModeration'),
    }
  ](name='consumerRiskLevel', description='The consumer-level risk level configuration.'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The plugin running status.', nullable=true),
  requestCheckService?: string(name='requestCheckService', description='The ServiceCode of the request text detection service (system-injected default value).', example='query_security_check'),
  requestImageCheckService?: string(name='requestImageCheckService', description='The ServiceCode of the request image detection service (system-injected default value).', example='img_query_guard'),
  responseCheckService?: string(name='responseCheckService', description='The ServiceCode of the response text detection service (system-injected default value).', example='response_security_check'),
  responseImageCheckService?: string(name='responseImageCheckService', description='The ServiceCode of the response image detection service (system-injected default value).', example='img_response_guard'),
  riskAlertLevel?: string(name='riskAlertLevel', description='The global risk alert level.', example='high'),
  riskConfig?: [ 
    {
      consumerRules?: {
        matchType?: string(name='matchType', description='The matching method.', example='Exact'),
        pattern?: string(name='pattern', description='The consumer matching pattern value.', example='consumer-a'),
      }(name='consumerRules', description='The consumer-level matching rules.'),
      level?: string(name='level', description='The risk level.', example='high'),
      type?: string(name='type', description='The risk dimension type.', example='ContentModeration'),
    }
  ](name='riskConfig', description='The risk dimension configuration list (system-injected, normalized from ConsumerRiskLevel).'),
  serviceAddress?: string(name='serviceAddress', description='The security guardrail service address (green-cip endpoint). Use the VPC internal address when the gateway and security guardrail are in the same region.', example='https://green-cip-vpc.cn-shanghai.aliyuncs.com'),
}

model AiServiceConfig {
  apiKeyGenerateMode?: string(name='ApiKeyGenerateMode', description='API key generation mode.', example='-'),
  address?: string(name='address', description='The service endpoint.', example='https://dashscope.aliyun.com'),
  apiKeys?: [ string ](name='apiKeys', description='The API keys.'),
  bedrockServiceConfig?: {
    awsAccessKey?: string(name='awsAccessKey', description='AWS-AccessKey', example='AKIAIOSFODNN7EXAMPLE'),
    awsRegion?: string(name='awsRegion', description='AWS-Region', example='us-west-2'),
    awsSecretKey?: string(name='awsSecretKey', description='AWS-SecretKey', example='wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY'),
  }(name='bedrockServiceConfig', description='Bedrock service configuration.'),
  compatibleProtocols?: [ string ](name='compatibleProtocols', description='Supported compatible protocols.'),
  defaultModelName?: string(name='defaultModelName', description='Default model name.', example='qwen-turbo'),
  enableHealthCheck?: boolean(name='enableHealthCheck', description='Specifies whether to enable health check.', example='true'),
  enableOutlierDetection?: boolean(name='enableOutlierDetection', description='Enable outlier detection.', example='false'),
  paiEASServiceConfig?: {
    endpointType?: string(name='endpointType', description='Type of endpoint.', example='"public"，"private"'),
    serviceId?: string(name='serviceId', description='Service identifier.', example='svc-d33onfmm1hkn5duhuqjg'),
    serviceName?: string(name='serviceName', description='Name of the service.', example='service-hello'),
    workspaceId?: string(name='workspaceId', description='Workspace identifier.', example='plw-d5g7qsem1hkmih54g210'),
  }(name='paiEASServiceConfig', description='PAI-EAS service configuration settings.'),
  protocols?: [ string ](name='protocols', description='The LLM protocols.'),
  provider?: string(name='provider', description='The Large Language Model (LLM) provider.', example='qwen'),
  vertexServiceConfig?: {
    geminiSafetySetting?: map[string]string(name='geminiSafetySetting', description='Gemini safety settings.'),
    vertexAuthKey?: string(name='vertexAuthKey', description='Vertex AI authentication key.', example='{\\\\"type\\\\":\\\\"service_account\\\\",\\\\"project_id\\\\":\\\\"xxx\\\\",\\\\"private_key\\\\":\\\\"-----BEGIN PRIVATE KEY-----\\\\",\\\\"client_email\\\\":\\\\"xxx@xxx.iam.gserviceaccount.com\\\\",\\\\"token_uri\\\\":\\\\"https://oauth2.googleapis.com/token\\\\"}'),
    vertexAuthServiceName?: string(name='vertexAuthServiceName', description='Vertex AI auth service name.', example='custom-vertex-auth'),
    vertexProjectId?: string(name='vertexProjectId', description='Vertex AI project ID.', example='my-gcp-project-123'),
    vertexRegion?: string(name='vertexRegion', description='Vertex AI region.', example='us-central1'),
    vertexTokenRefreshAhead?: int32(name='vertexTokenRefreshAhead', description='Vertex token refresh lead time.', example='300'),
  }(name='vertexServiceConfig', description='Vertex AI service configuration.'),
}

model AiStatisticsConfig {
  logRequestContent?: boolean(name='logRequestContent', description='**[Deprecated]** Specifies whether to record request content (controls whether question-related attributes are generated). This parameter is deprecated in the new version.', example='true'),
  logResponseContent?: boolean(name='logResponseContent', description='**[Deprecated]** Specifies whether to record response content (controls whether answer-related attributes are generated). This parameter is deprecated in the new version.', example='true'),
  pathFieldConfigs?: [ 
    {
      fieldPaths?: map[string]AiStatisticsPathField(name='fieldPaths', description='The AI request log field configuration groups for the API path, passed in as a Map. The Map keys are fixed to basic and custom, and the values are arrays of log field configurations for the corresponding groups. basic indicates basic log fields, and custom indicates custom log fields. For the current API path, fieldPaths represents the complete desired state of field configurations and does not support incremental appending or diff merging.

If pathFieldConfigs is not passed, is null, or is an empty array, the existing log field configurations are not updated. If a non-empty array is passed, the system performs a desired state replacement based on the complete set of Paths in the request, and historical Path configurations not included in the request are deleted.

For example, to add a custom field test to the /v1/chat/completions API path on top of existing configurations, the caller must use a "read-merge-write back in full" approach:
1. Read all current Path configurations.
2. Retain the complete basic array and custom array for the target API path /v1/chat/completions.
3. Append test to the current custom array.
4. Keep configurations for other API paths unchanged.
5. Submit the merged complete pathFieldConfigs.'),
      path?: string(name='path', description='The API path.', example='/v1/chat/completions'),
    }
  ](name='pathFieldConfigs', description='The list of AI request log field collection configurations, configured by API path.'),
}

model AiStatisticsPathField {
  category?: string(name='category', description='The secondary business category of the field. Optional. Valid values: conversation (conversation content), config (configuration parameters), tools (tool calling), usage (usage statistics), metadata (metadata), choices (candidate results), identity (identity identifier), cache (cache information), media (multimedia content), logprobs (log probabilities), and custom (custom field). Set custom fields to custom.', example='conversation'),
  description?: string(name='description', description='The field description.', example='The question content entered by the user'),
  fieldKey?: string(name='fieldKey', description='The log key (field name).', example='question'),
  io?: string(name='io', description='The request or response attribution. The backend normalizes this to request or response based on source.', example='request'),
  jsonPath?: string(name='jsonPath', description='The corresponding jsonPath (gjson syntax).', example='messages.#.content'),
  name?: string(name='name', description='The annotation for the field key name.', example='Question content'),
  recordEnabled?: boolean(name='recordEnabled', description='Indicates whether collection is enabled to create a log record for the corresponding field in AI request logs.', example='true'),
  rule?: string(name='rule', description='The aggregation rule for streaming response fields. Valid values: append, first, and replace. append: appends the matched values from each streaming chunk in sequence. first: retains the first matched value. replace: uses the last matched value. When source is response_streaming_body and rule is not specified, first is used by default. This field is not required for non-streaming scenarios.', example='append'),
  sensitive?: boolean(name='sensitive', description='Specifies whether the field is sensitive.', example='false'),
  source?: string(name='source', description='The source of the field value. Valid values: fixed_value (fixed value), request_body (request body), request_header (request header), response_header (response header), response_body (non-streaming response body), and response_streaming_body (streaming response body).', example='request_body'),
}

model AiTokenRateLimitConfig {
  enableGlobalRules?: boolean(name='enableGlobalRules', description='Specifies whether to enable global (API-level) throttling rules. Default value: false.', example='true'),
  globalRules?: [
    AiTokenRateLimitConfigRule
  ](name='globalRules', description='The list of global throttling rules. Only the LimitByGlobal type is allowed.'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The running status of the plugin.', nullable=true),
  redisConfig?: AiPolicyRedisConfig(name='redisConfig', description='The Redis configuration.', nullable=true),
  rules?: [
    AiTokenRateLimitConfigRule
  ](name='rules', description='The list of throttling rules.'),
}

model AiTokenRateLimitConfigRule {
  limitMode?: string(name='limitMode', description='The throttling mode.', example='TokenPerMinute'),
  limitType?: string(name='limitType', description='The throttling type.', example='Consumer'),
  limitValue?: int32(name='limitValue', description='The throttling value.', example='1000'),
  matchKey?: string(name='matchKey', description='The match key name.', example='X-API-Key'),
  matchType?: string(name='matchType', description='The matching method.', example='Exact'),
  matchValue?: string(name='matchValue', description='The match value.', example='consumer-a'),
}

model AiToolSelectionConfig {
  enableConditions?: {
    toolCountThreshold?: int32(name='toolCountThreshold', description='The tool count threshold.', example='10'),
  }(name='enableConditions', description='The enable conditions configuration. Controls when the overall feature is triggered.'),
  pluginStatus?: AiPluginStatus(name='pluginStatus', description='The plug-in running status.', nullable=true),
  queryRewriting?: {
    contextSelection?: {
      type?: string(name='type', description='The context selection method.', example='allMessages'),
      value?: int32(name='value', description='The number of retained messages or characters.', example='5'),
    }(name='contextSelection', description='The context selection configuration.'),
    enabled?: boolean(name='enabled', description='Specifies whether query rewrite is enabled.', example='true'),
    fallbackStrategy?: string(name='fallbackStrategy', description='The fallback strategy.', example='skip'),
    maxOutputTokens?: int32(name='maxOutputTokens', description='The maximum number of output tokens for rewriting.', example='50'),
    modelService?: {
      modelName?: string(name='modelName', description='The model name.', example='gte-rerank-v2'),
      serviceId?: string(name='serviceId', description='The model service ID.', example='svc-xxx'),
      timeoutMillisecond?: int32(name='timeoutMillisecond', description='The request timeout period, in milliseconds.', example='5000'),
    }(name='modelService', description='The rewriting model service configuration.'),
    promptConfig?: {
      customPrompt?: string(name='customPrompt', description='The custom prompt content.', example='请将以下用户问题改写为...'),
      type?: string(name='type', description='The prompt type.', example='builtIn'),
    }(name='promptConfig', description='The prompt configuration.'),
    triggerConditions?: {
      messageCountThreshold?: int32(name='messageCountThreshold', description='The number of conversation turns after which rewriting is triggered.', example='1'),
    }(name='triggerConditions', description='The trigger condition configuration.'),
  }(name='queryRewriting', description='The query rewrite configuration. Rewrites user queries before tool reranking to improve matching precision.'),
  toolReranking?: {
    fallbackStrategy?: string(name='fallbackStrategy', description='The fallback strategy upon failure.', example='skip'),
    filteringMethod?: string(name='filteringMethod', description='The filtering method.', example='topN'),
    modelService?: {
      modelName?: string(name='modelName', description='The model name.', example='gte-rerank-v2'),
      serviceId?: string(name='serviceId', description='The model service ID.', example='svc-xxx'),
      timeoutMillisecond?: int32(name='timeoutMillisecond', description='The request timeout period, in milliseconds.', example='5000'),
    }(name='modelService', description='The reranking model service configuration.'),
    scoreThreshold?: float(name='scoreThreshold', description='The score threshold.', example='0.5'),
    topKPercent?: int32(name='topKPercent', description='The retention percentage.', example='50'),
    topNCount?: int32(name='topNCount', description='The retention count.', example='5'),
  }(name='toolReranking', description='The tool reranking configuration. Uses a model to rank and filter candidate tools.'),
}

