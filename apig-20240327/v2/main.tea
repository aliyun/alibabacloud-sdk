 *
 * @param request InvokeAIAgentRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return InvokeAIAgentResponse
 */
@sse(true)
@context("invokeAIAgentWithSSECtx")
async function invokeAIAgentWithSSE(request: InvokeAIAgentRequest, headers: map[string]string, runtime: $RuntimeOptions): asyncIterator[InvokeAIAgentResponse] {
  request.validate();
  var body : map[string]any = {};
