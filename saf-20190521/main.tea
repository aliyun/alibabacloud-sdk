import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hangzhou' = 'saf.cn-shanghai.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('saf', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model ExecuteRequestRequest {
  service?: string(name='Service', description='The service product code. For custom events, set this parameter to saf_de.

This parameter is required.', example='account_abuse_pro'),
  serviceParameters?: string(name='ServiceParameters', description='The service input parameters in JSON format. This must be a complete JSON string. For custom events, you must include the eventCode property.

This parameter is required.', example='{"accountId": "1233***"}'),
}

model ExecuteRequestResponseBody = {
  accessDeniedDetail?: {
    authAction?: string(name='AuthAction', description='The specific action that the caller attempted to perform, such as s3:PutObject or ec2:DescribeInstances.', example='yundun-saf:Execute'),
    authPrincipalDisplayName?: string(name='AuthPrincipalDisplayName', description='The human-readable display name of the request principal, such as the username or role name.', example='29918048924096****'),
    authPrincipalOwnerId?: string(name='AuthPrincipalOwnerId', description='The UID of the Alibaba Cloud account to which the request principal belongs.', example='178059440630****'),
    authPrincipalType?: string(name='AuthPrincipalType', description='The identity type of the request principal. Valid values:
- SubUser: RAM user created by an Alibaba Cloud account.
- AssumedRoleUser: Temporary identity obtained by assuming a role.', example='SubUser'),
    encodedDiagnosticMessage?: string(name='EncodedDiagnosticMessage', description='The Base64-encoded permission diagnostic log used for troubleshooting and automated analysis.', example='AQIBIAAAA...r+ow=='),
    noPermissionType?: string(name='NoPermissionType', description='The specific denial type for the access denied scenario. Valid values:
- ImplicitDeny: Implicit deny due to the lack of explicit authorization.
- ExplicitDeny: Explicit deny where the operation is explicitly denied in the policy.', example='ImplicitDeny'),
    policyType?: string(name='PolicyType', description='The scope and type of the policy in the access denied scenario. Valid values:
- AccountLevelIdentityBasedPolicy: Account-level identity-based policy that applies to the entire Alibaba Cloud account.
- ResourceGroupLevelIdentityBasedPolicy: Resource group-level identity-based policy that applies to a specific resource group.
- SessionPolicy: Session policy that applies to a temporary session.
- ControlPolicy: Control policy used for core permission control.
- AssumeRolePolicy: Trust policy that defines which entities can assume the role.', example='AccountLevelIdentityBasedPolicy'),
  }(name='AccessDeniedDetail', description='The diagnostic details for access denial.'),
  code?: int32(name='Code', description='The status code.', example='200'),
  data?: map[string]any(name='Data', description='The response data, which includes fields such as tags, score, and extend.', example='{"score": 80.4, "tags": "ra0601,rnk0002,rn0312"}'),
  message?: string(name='Message', description='The result message.', example='OK'),
  requestId?: string(name='RequestId', description='The request ID.', example='A5F41DC6-2070-5CE7-8B2D-7A23D882932D'),
}

model ExecuteRequestResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ExecuteRequestResponseBody(name='body'),
}

/**
 * @summary Detects risks. This API operation supports public service invocation and allows you to invoke custom events.
 *
 * @param request ExecuteRequestRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return ExecuteRequestResponse
 */
async function executeRequestWithOptions(request: ExecuteRequestRequest, runtime: Util.RuntimeOptions): ExecuteRequestResponse {
  Util.validateModel(request);
  var query = {};
  if (!Util.isUnset(request.service)) {
    query['Service'] = request.service;
  }
  if (!Util.isUnset(request.serviceParameters)) {
    query['ServiceParameters'] = request.serviceParameters;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'ExecuteRequest',
    version = '2019-05-21',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Detects risks. This API operation supports public service invocation and allows you to invoke custom events.
 *
 * @param request ExecuteRequestRequest
 * @return ExecuteRequestResponse
 */
async function executeRequest(request: ExecuteRequestRequest): ExecuteRequestResponse {
  var runtime = new Util.RuntimeOptions{};
  return executeRequestWithOptions(request, runtime);
}

