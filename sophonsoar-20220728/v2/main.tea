    new?: boolean(name='New', description='Indicates whether the second version used for comparison is a new version.

- **true**: The version is new.

- **false**: The version is not new.', example='true'),
    same?: boolean(name='Same', description='Indicates whether the two versions are identical.

- **true**: Identical.

- **false**: Not identical.', example='false'),
