  resultCode?: string(name='ResultCode', description='The error code indicating the reason for transfer failure. Valid values:
- **clientCancelled**: You canceled the domain transfer-in.
- **clientRejected**: The original registrar rejected the domain transfer-in (or you performed a rejection operation through the original registrar).
- **serverCancelled**: The domain name registry canceled the transfer.
- **transferProhibited**: The domain is in a transfer-prohibited status.
- **transferExpired**: You did not complete the required transfer confirmation within the validity period.
- **nameVerificationFailed**: The domain naming review did not pass.
- **transferSubmitted**: Another user has already submitted a transfer request for this domain.', example='clientCancelled'),
  resultDate?: string(name='ResultDate', description='The time when the transfer succeeded or failed.', example='2018-03-28 00:41:42'),
  resultDateLong?: long(name='ResultDateLong', description='The UNIX timestamp indicating when the transfer succeeded or failed.', example='1514428524669'),
  resultMsg?: string(name='ResultMsg', description='Description of the failure reason when the transfer failed.', example='您取消了此次域名转入'),
  simpleTransferInStatus?: string(name='SimpleTransferInStatus', description='Transfer status. Valid values:  
