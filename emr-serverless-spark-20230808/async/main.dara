      queueName?: string(name='queueName', description='The queue name.', example='root_queue'),
      replica?: int32(name='replica', description='The number of workers.', example='2'),
      workerType?: string(name='workerType', description='The worker type.', example='CPU'),
    }
  ](name='workerSpec', description='The parameters of the worker nodes in the Ray cluster.', position='Body'),
