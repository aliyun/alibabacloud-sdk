  * @return ActivateAICenterResponse
 */
async function activateAICenter(request: ActivateAICenterRequest): ActivateAICenterResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'ActivateAICenter', 'POST', '/api/v1/workspaces/{workspaceId}/activateaicenter', 'json', false, 'json', request);
}

