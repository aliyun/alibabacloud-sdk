import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'emr-serverless-spark';
  @version = '2023-08-08';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model Artifact {
  bizId: string(name='bizId', description='This parameter is required.'),
  catagoryBizId?: string(name='catagoryBizId'),
  creator: long(name='creator', description='This parameter is required.'),
  credential?: Credential(name='credential'),
  fullPath?: [ string ](name='fullPath'),
  gmtCreated: string(name='gmtCreated', description='This parameter is required.'),
  gmtModified: string(name='gmtModified', description='This parameter is required.'),
  location: string(name='location', description='This parameter is required.'),
  modifier: long(name='modifier', description='This parameter is required.'),
  modifierName?: string(name='modifierName'),
  name: string(name='name', description='This parameter is required.'),
}

model BatchEditQueueSpec {
  description?: string(name='description', description='The description of the queue. If this parameter is not specified, the description is not modified.', example='Development and debugging queue', maxLength=256),
  environments?: [ string ](name='environments', description='The runtime environments. If this parameter is not specified, the runtime environments are not modified.'),
  gpuSpec?: [ string ](name='gpuSpec', description='The list of GPU instance types. If this parameter is not specified, the GPU specifications are not modified.'),
  resourceSpec?: ResourceSpec(name='resourceSpec', description='The resource specifications, which represent the absolute target value. If this parameter is not specified, only the description, environments, or GPU specifications are modified, and the quota is not recalculated.'),
  workspaceQueueName: string(name='workspaceQueueName', description='The name of the queue.

This parameter is required.', example='dev_queue'),
}

model BatchEditWorkspaceQueuesBody {
  queues: [
    BatchEditQueueSpec
  ](name='queues', description='The list of queues to update. Each entry independently specifies the absolute target state of a queue. Queue names must be unique within the same request.

This parameter is required.'),
  workspaceId: string(name='workspaceId', description='The workspace ID.

This parameter is required.', example='w-1234abcd'),
}

model BatchEditWorkspaceQueuesReceipt {
  acceptedQueues?: [ string ](name='acceptedQueues', description='The target states of these queues are progressively written during the workflow.'),
  skippedQueues?: [ string ](name='skippedQueues', description='The current values are already equal to the target values, so no write operations are required.'),
  workflowInstanceId?: long(name='workflowInstanceId', description='A null value indicates that all queues in this request are already in the target state and no workflow is started (idempotent no-op).', example='9527'),
  workspaceId?: string(name='workspaceId', description='The workspace ID.', example='w-1234abcd'),
}

model CacheCluster {
  bindedWorkspaces?: [ string ](name='bindedWorkspaces', description='The associated workspaces.'),
  cacheClusterId?: string(name='cacheClusterId', description='The cache cluster ID.', example='spc-xxxxxxx'),
  cacheClusterName?: string(name='cacheClusterName', description='The cache cluster name.', example='test-cache-cluster'),
  cachesets?: [ 
    {
      name?: string(name='name', description='The name of the cache set.', example='cache1'),
      path?: string(name='path', description='The path of the cache set.', example='/path1'),
    }
  ](name='cachesets', description='The list of cache sets associated with the cache cluster.'),
  clusterId?: string(name='clusterId', description='The cache cluster ID.', example='spc-xxxxxxx'),
  configuration?: string(name='configuration', example='[{"name":"cache1","path":"/path1"}]'),
  configurations?: [ 
    {
      content?: string(name='content', description='The content of the configuration file.', example='<cachesets><cacheset><name>cache1</name><path>/path1</path><cacheStrategy>DISTRIBUTED</cacheStrategy><metaPolicy><type>ALWAYS</type></metaPolicy><readPolicy>CACHE_ASIDE</readPolicy><preadPolicy>ALL_DYNAMIC</preadPolicy><writePolicy>WRITE_THROUGH</writePolicy></cacheset></cachesets>'),
      name?: string(name='name', description='The name of the configuration file.', example='cacheset.xml'),
    }
  ](name='configurations', description='The list of configuration files for the cache cluster.'),
  createTime?: string(name='createTime', description='The creation time.', example='Fri May 31 12:18:51 CST 2024'),
  creator?: string(name='creator', description='The creator UID.', example='123456'),
  extra?: string(name='extra'),
  gmtCreated?: long(name='gmtCreated', description='The creation time. The value is a UNIX timestamp in milliseconds.', example='1717138731701'),
  gmtModified?: long(name='gmtModified', description='The modification time. The value is a UNIX timestamp in milliseconds.', example='1717138731701'),
  modifier?: string(name='modifier', description='The modifier UID.', example='123456'),
  name?: string(name='name', description='The cache cluster name.', example='test-cache-cluster'),
  paymentType?: string(name='paymentType', description='The billing method.', example='PayAsYouGo'),
  regionId?: string(name='regionId', description='The region ID.', example='cn-hangzhou'),
  resourceGroupId?: string(name='resourceGroupId', description='The resource group ID.', example='rg-aek4f7uj74wdthi'),
  resourceSpec?: {
    bandWidth?: long(name='bandWidth', description='The bandwidth.', example='100'),
    ha?: boolean(name='ha', description='Specifies whether high availability is enabled.'),
    storage?: long(name='storage', description='The physical storage.', example='100'),
  }(name='resourceSpec', description='The cache cluster specifications.'),
  state?: string(name='state', description='The cache cluster status.', example='RUNNING'),
  tables?: [ 
    {
      catalogId?: string(name='catalogId', description='The data catalog ID.', example='15097**********'),
      catalogProvider?: string(name='catalogProvider', description='The data catalog provider.', example='HMS'),
      database?: string(name='database', description='The database name.', example='test_db'),
      table?: string(name='table', description='The data table name.', example='test_table'),
      workspaceId?: string(name='workspaceId', description='The workspace ID.', example='w-d2d82aa09155****'),
    }
  ](name='tables', description='The list of data tables associated with the cache cluster.'),
  tags?: [ 
    {
      key?: string(name='key', description='The tag key.', example='tag_key'),
      value?: string(name='value', description='The tag value.', example='value'),
    }
  ](name='tags', description='The list of tags for the cache cluster.'),
  usedResourceSpec?: {
    bandWidth?: long(name='bandWidth', description='The used bandwidth.'),
    storage?: long(name='storage', description='The used storage capacity.'),
  }(name='usedResourceSpec', description='The resource specifications used by the cache cluster.'),
  version?: string(name='version', description='The cache cluster version.', example='v2.0'),
}

