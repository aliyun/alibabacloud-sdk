  entrypoint?: string(name='entrypoint', description='The entrypoint command.', example='python -c "print(\\"hello ray job\\")"', position='Body'),
  entrypointMemory?: string(name='entrypointMemory', description='The memory size requested by the entrypoint job.', example='4Gi', position='Body'),
  entrypointNumCpus?: string(name='entrypointNumCpus', description='The number of CPUs requested by the entrypoint job.', example='1', position='Body'),
  entrypointNumGpus?: string(name='entrypointNumGpus', description='The number of GPUs requested by the entrypoint job.', example='0', position='Body'),
  entrypointResources?: string(name='entrypointResources', description='The custom resource request JSON string for the entrypoint job.', example='{"fpu": 1}', position='Body'),
  extraParam?: string(name='extraParam', description='The JSON string for extra parameters.', example='{"userDefinedFiles": "oss://mybucket/artifact/config.json,oss://mybucket/artifact/config2.json", "userRequirementsFile": "oss://mybucket/requirements.txt"}', position='Body'),
  headSpec?: {
    cpu?: string(name='cpu', description='The number of CPU cores.', example='2'),
    displayReleaseVersion?: string(name='displayReleaseVersion', description='The Ray DPI engine version.', example='err-1.3.0 (Ray 2.55.1, Python 3.12)'),
    enableAutoScaling?: boolean(name='enableAutoScaling', description='Specifies whether to enable auto scaling for workers.', example='true'),
    gpuSpec?: string(name='gpuSpec', description='The GPU instance type.', example='ecs.gn6i-c4g1.xlarge'),
    idleTimeoutSeconds?: int32(name='idleTimeoutSeconds', description='The worker idle time after auto scaling is enabled.', example='60'),
    memory?: string(name='memory', description='The memory size, in Gi.', example='8Gi'),
    queueName?: string(name='queueName', description='The queue name.', example='root_queue'),
  }(name='headSpec', description='The parameters of the Ray cluster head node.', position='Body'),
  metadataJson?: string(name='metadataJson', description='The job metadata JSON string.', example='{"resourceName": "test"}', position='Body'),
  name?: string(name='name', description='The job name.', example='my-job', position='Body'),
  networkServiceName?: string(name='networkServiceName', description='The network connectivity name.', example='vpc', position='Body'),
  runtimeEnvJson?: string(name='runtimeEnvJson', description='The Ray runtime environment JSON string.', example='{"pip":["requests==2.26.0","pendulum==2.1.2"],"env_vars":{"KEY":"VALUE"}}', position='Body'),
  shutdownAfterJobFinishes?: boolean(name='shutdownAfterJobFinishes', description='Specifies whether to automatically destroy the temporary cluster after the job finishes. Default value: true.', example='true', position='Body'),
  submissionMode?: string(name='submissionMode', description='The job submission mode.', example='HTTPMode', position='Body'),
  tags?: [ 
    {
      key?: string(name='key', description='The key.', example='jobname'),
      value?: string(name='value', description='The value.', example='test'),
    }
  ](name='tags', description='The tags.', position='Body'),
  ttlSecondsAfterFinished?: int32(name='ttlSecondsAfterFinished', description='The wait time in seconds before the cluster is destroyed. This parameter takes effect only when shutdownAfterJobFinishes is set to true.', example='60', position='Body'),
  volumeIds?: [ string ](name='volumeIds', description='The list of mounted volume IDs.', position='Body'),
  workerSpec?: [ 
    {
      cpu?: string(name='cpu', description='The number of CPU cores.', example='4'),
      displayReleaseVersion?: string(name='displayReleaseVersion', description='The DPI engine version.', example='ray-1.2.0 (Ray 2.55.1, Python 3.12)'),
      gpuSpec?: string(name='gpuSpec', description='The GPU instance type.', example='ecs.gn6i-c4g1.xlarge'),
      groupName?: string(name='groupName', description='The worker group name.', example='WorkerGroup1'),
      maxReplica?: int32(name='maxReplica', description='The maximum number of workers after auto-scaling is enabled.', example='10'),
      memory?: string(name='memory', description='The memory size, in Gi.', example='16Gi'),
      minReplica?: int32(name='minReplica', description='The minimum number of workers after auto-scaling is enabled.', example='1'),
      queueName?: string(name='queueName', description='The queue name.', example='root_queue'),
      replica?: int32(name='replica', description='The number of workers.', example='2'),
      workerType?: string(name='workerType', description='The worker type.', example='CPU'),
    }
  ](name='workerSpec', description='The Ray cluster worker node parameters.', position='Body'),
  workingDir?: string(name='workingDir', description='The URL of the working directory for the job code.', example='oss://mybucket/rayjob.zip', position='Body'),
}

