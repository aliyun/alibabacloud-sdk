  runtimeEnvJson?: string(name='runtimeEnvJson', description='The Ray runtime environment JSON string.', example='{"pip":["requests==2.26.0","pendulum==2.1.2"],"env_vars":{"KEY":"VALUE"}}', position='Body'),
