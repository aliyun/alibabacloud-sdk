    enableAutoScaling?: boolean(name='enableAutoScaling', description='Specifies whether to enable automatic scaling for workers.', example='true'),
    gpuSpec?: string(name='gpuSpec', description='The GPU instance type.', example='ecs.gn6i-c4g1.xlarge'),
    idleTimeoutSeconds?: int32(name='idleTimeoutSeconds', description='The worker idle timeout period after automatic scaling is enabled.', example='60'),
    memory?: string(name='memory', description='The memory size. Unit: GiB.', example='8Gi'),
    queueName?: string(name='queueName', description='The queue name.', example='root_queue'),
  }(name='headSpec', description='The Ray cluster head node parameters.', position='Body'),
