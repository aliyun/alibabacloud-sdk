  ](name='tags', description='The tags.', position='Body'),
  ttlSecondsAfterFinished?: int32(name='ttlSecondsAfterFinished', description='The number of seconds to wait before destroying the cluster. This parameter takes effect only when shutdownAfterJobFinishes is set to true.', example='60', position='Body'),
  volumeIds?: [ string ](name='volumeIds', description='The list of mounted volume IDs.', position='Body'),
  workerSpec?: [ 
    {
      cpu?: string(name='cpu', description='The number of CPU cores.', example='4'),
