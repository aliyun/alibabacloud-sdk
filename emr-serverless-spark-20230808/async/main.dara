This parameter is required.', example='150978934701****'),
  gmtCreated: string(name='gmtCreated', description='The time when the folder was created.

This parameter is required.', example='2025-03-10T02:02:41.000+00:00'),
  gmtModified: string(name='gmtModified', description='The time when the folder was last updated.

This parameter is required.', example='2025-03-10T02:02:41.000+00:00'),
  modifier: long(name='modifier', description='The ID of the user who last modifies the folder.

This parameter is required.', example='150978934701****'),
  name: string(name='name', description='The name of the folder.

This parameter is required.', example='name', minLength=1, maxLength=64),
  parentBizId?: string(name='parentBizId', description='The parent folder ID.', example='w-d6********'),
