  fieldName?: string(name='fieldName', description='The name of the column.', example='other_col_test'),
  referenceFieldName?: string(name='referenceFieldName', description='The name of the reference column.', example='col_test'),
  type?: string(name='type', description='The move type.', example='FIRST'),
}

model Namespace {
  createdAt?: long(name='createdAt', description='The creation time, represented as a UNIX timestamp in milliseconds.', example='1741266704867'),
  createdBy?: string(name='createdBy', description='The user who created the namespace.', example='acs:ram:1234567:root'),
  id?: string(name='id', description='The namespace ID.', example='namespace_id'),
  location?: string(name='location', description='The storage path of the namespace.', example='oss://example-bucket/example-namespace/'),
  name?: string(name='name', description='The name of the namespace.', example='default'),
  options?: map[string]string(name='options', description='The extension options for the namespace.'),
  owner?: string(name='owner', description='The namespace owner.', example='acs:ram:1234567:root'),
  updatedAt?: long(name='updatedAt', description='The update time, represented as a UNIX timestamp in milliseconds.', example='1741266704867'),
  updatedBy?: string(name='updatedBy', description='The user who updated the namespace.', example='acs:ram:1045689747920334:root'),
}

model Partition {
  createdAt?: long(name='createdAt', description='The creation time.', example='1747120676378'),
  createdBy?: string(name='createdBy', description='The creator.', example='acs:ram::[accountId]:root'),
  done?: boolean(name='done', description='Indicates whether the tagging is complete.', example='true'),
  fileCount?: long(name='fileCount', description='The number of files.', example='1'),
