  type?: string(name='type', description='The location method type.', example='snapshot'),
}

model FullSchemaChange {
  action?: string(name='action', description='The type of change.', example='setOption'),
  comment?: string(name='comment', description='The description. This parameter is required when `action` is `UpdateComment` or `AddColumn`.', example='col_comment'),
  dataType?: FullDataType(name='dataType', description='The column type. This parameter is required when `action` is `AddColumn`.'),
  fieldNames?: [ string ](name='fieldNames', description='The table column names. This parameter is required when `action` is `AddColumn`, `RenameColumn`, `DropColumn`, `UpdateColumnComment`, `UpdateColumnType`, or `UpdateColumnNullability`.'),
  keepNullability?: boolean(name='keepNullability', description='Specifies whether the column is nullable. This parameter is required when the `action` is `UpdateColumnType`.', example='true'),
  key?: string(name='key', description='The key for the configuration. This parameter is required when `action` is `SetOption` or `RemoveOption`.', example='\\\\"true\\\\"'),
  move?: Move(name='move', description='The column to move. This parameter is required when `action` is `AddColumn` or `UpdateColumnPosition`.'),
  newComment?: string(name='newComment', description='The new description for the column. This parameter is required when `action` is `UpdateColumnComment`.', example='col_comment_test'),
  newDataType?: FullDataType(name='newDataType', description='The new column type. This parameter is required when `action` is `UpdateColumnType`.'),
  newName?: string(name='newName', description='The new name of the column. This parameter is required when `action` is `RenameColumn`.', example='new_col_test'),
  newNullability?: boolean(name='newNullability', description='Specifies whether the new column is nullable. This parameter is required when `action` is `UpdateColumnType`.', example='true'),
  value?: string(name='value', description='The value of the configuration. This parameter is required when `action` is `SetOption`.', example='\\\\"manifest.delete-file-drop-stats\\\\"'),
}

model Function {
