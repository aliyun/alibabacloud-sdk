  id?: string(name='id', description='ID', example='db-xxxx'),
  inputParams?: [
    DataField
  ](name='inputParams', description='The field input parameters.'),
  name?: string(name='name', description='The function name.', example='name'),
  options?: map[string]string(name='options', description='The extension options.'),
  owner?: string(name='owner', description='The owner.', example='acs:ram::[accountId]:root'),
  returnParams?: [
    DataField
  ](name='returnParams', description='The return fields of the function.'),
  updatedAt?: long(name='updatedAt', description='The update time.', example='1764556033696'),
  updatedBy?: string(name='updatedBy', description='The updater.', example='acs:ram::[accountId]:root'),
}

model FunctionChange {
  action?: string(name='action', description='The change type.', example='setOption'),
  comment?: string(name='comment', description='required in UpdateFunctionComment', example='Function configuration update'),
  definition?: FunctionDefinition(name='definition', description='required in AddDefinition/UpdateDefinition'),
  key?: string(name='key', description='required in SetFunctionOption/RemoveFunctionOption', example='namespaceSchema'),
  name?: string(name='name', description='required in AddDefinition/UpdateDefinition/DropDefinition', example='my_function'),
  value?: string(name='value', description='required in SetFunctionOption', example='IDC_MOVE'),
}

model FunctionDefinition {
  className?: string(name='className', description='required in FileFunctionDefinition', example='com.aliyun.pai.flinkjob.udf.CtrKV'),
  definition?: string(name='definition', description='required in SQLFunctionDefinition/LambdaFunctionDefinition', example='{}'),
  fileResources?: [
    FunctionFileResource
  ](name='fileResources', description='required in FileFunctionDefinition'),
  functionName?: string(name='functionName', description='required in FileFunctionDefinition', example='function_name'),
  language?: string(name='language', description='required in LambdaFunctionDefinition/FileFunctionDefinition', example='zh-CN'),
  type?: string(name='type', description='The type.', example='PAIMON'),
}

model FunctionFileResource {
