  storageActionTimestamp?: long(name='storageActionTimestamp', description='The storage class transition time.', example='1764556155852'),
  storageClass?: string(name='storageClass', description='The storage class.', example='STANDARD'),
  tableName?: string(name='tableName', description='The table name.', example='table_name'),
  topRequester?: string(name='topRequester', description='The top requester of the day.', example='acs:ram::[accountId]:root'),
  totalFileAccessNum?: long(name='totalFileAccessNum', description='The total number of file accesses.', example='10'),
  totalFileAccessNum30d?: long(name='totalFileAccessNum30d', description='The total number of file accesses in the last 30 days.', example='100'),
  totalFileAccessNum7d?: long(name='totalFileAccessNum7d', description='The total number of file accesses in the last 7 days.', example='70'),
  totalFileCount?: long(name='totalFileCount', description='The total number of files.', example='2'),
  totalFileSizeInBytes?: long(name='totalFileSizeInBytes', description='The storage capacity in bytes.', example='2048'),
  updatedAt?: long(name='updatedAt', description='The last update time.', example='1744970111419'),
}

model Permission {
  access?: string(name='access', description='The access type.', example='DROP'),
  columnMasking?: map[string]ColumnMask(name='columnMasking', description='The column masking transformation rules mapped by column name. The key is the column name, and the value is the corresponding masking transformation configuration.'),
  columns?: {
    columnNames?: [ string ](name='columnNames', description='The list of included column names.'),
    excludedColumnNames?: [ string ](name='excludedColumnNames', description='The list of excluded column names.'),
  }(name='columns', description='The custom columns.'),
  database?: string(name='database', description='The database name.', example='database_name'),
  expireTime?: string(name='expireTime', description='The expiration time.', example='1762398431157'),
  function?: string(name='function', description='The function name.', example='function_name'),
  principal?: string(name='principal', description='The user resource descriptor.', example='acs:ram::[accountId]:user/user_name'),
