  updatedBy?: string(name='updatedBy', description='The user who last updated the table.', example='acs:ram::1045689747920334:root'),
  version?: long(name='version', description='The version of the table.', example='0'),
}

model IcebergTableMetadata {
  currentSnapshot?: IcebergSnapshot(name='currentSnapshot', description='The latest Iceberg snapshot.'),
  fields?: [
    IcebergNestedField
  ](name='fields', description='The column fields.'),
  identifierFieldIds?: [ int32 ](name='identifierFieldIds', description='The list of field IDs for the Iceberg identifier fields. The array elements are the integer IDs of the identifier fields in the Iceberg schema.'),
  partitionFields?: [
    IcebergPartitionField
  ](name='partitionFields', description='The list of partition fields.'),
  properties?: map[string]string(name='properties', description='The properties.'),
}

model Identifier {
  database?: string(name='database', description='The database name.', example='database_name'),
  object?: string(name='object', description='The table name.', example='table_name'),
}

model MoMValues {
  currentValue?: long(name='currentValue', description='The current value.', example='1000'),
  lastDayValue?: long(name='lastDayValue', description='The value of the previous day.', example='800'),
  lastMonthValue?: long(name='lastMonthValue', description='The value of the previous month.', example='100'),
}

