  updatedBy?: string(name='updatedBy', description='The user who last updated the receiver.', example='acs:ram::[accountId]:root'),
}

model Role {
  createdAt?: long(name='createdAt', description='The time when the role was created. This is a Unix timestamp in milliseconds.', example='1744970111419'),
  createdBy?: string(name='createdBy', description='The name of the user who created the role.', example='acs:ram::[accountId]:root'),
  description?: string(name='description', description='The role description.', example='role_description'),
  displayName?: string(name='displayName', description='The display name of the role.', example='role_display_name'),
  isPredefined?: string(name='isPredefined', description='Indicates whether the role is a system role.', example='true'),
  roleName?: string(name='roleName', description='The name of the role.', example='role_name'),
  rolePrincipal?: string(name='rolePrincipal', description='The resource descriptor of the role.', example='acs:dlf::[accountId]:role/role_name'),
  updatedAt?: long(name='updatedAt', description='The time when the role was last updated. This is a Unix timestamp in milliseconds.', example='1744970111419'),
  updatedBy?: string(name='updatedBy', description='The name of the user who last updated the role.', example='acs:ram::[accountId]:root'),
  users?: [
    User
  ](name='users', description='The users for the role.'),
}

model RowFilter {
  expression?: string(name='expression'),
  predicate?: string(name='predicate'),
}

model Schema {
  comment?: string(name='comment', description='The comment for the table.', example='description'),
  fields?: [
    DataField
