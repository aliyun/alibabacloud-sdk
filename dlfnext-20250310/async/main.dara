model VerifyCatalogKmsRequest {
  catalog: string(name='catalog', description='The name of the Catalog whose BYOK SSE-KMS configuration you want to validate.

This parameter is required.', example='my_catalog', position='Path'),
  kmsKeyId: string(name='kmsKeyId', description='The ID of the KMS customer master key (CMK) to be validated. The server uses this key to perform an SSE-KMS write probe.

This parameter is required.', example='key-1234567890abcdef', position='Body'),
}

model VerifyCatalogKmsResponseBody = {
  errorCode?: string(name='errorCode', description='The error code returned when the validation fails. An empty string is returned when the validation is successful.', example='KeyNotFound'),
  hint?: string(name='hint', description='The description of the failure cause and remediation suggestions returned when the validation fails. An empty string is returned when the validation is successful.', example='The specified parameter KMS keyId is not found.'),
  kmsKeyId?: string(name='kmsKeyId', description='The KMS key identifier actually used by the probe object. When the validation is successful, this corresponds to the customer master key (CMK) specified in the request.', example='key-1234567890abcdef'),
  serverSideEncryption?: string(name='serverSideEncryption', description='The server-side encryption method actually used by the probe object. Returns KMS when the validation is successful.', example='KMS'),
  success?: boolean(name='success', description='Indicates whether the validation is successful. A value of true indicates that the write probe succeeded and the SSE-KMS configuration of the object meets expectations. A value of false indicates that the validation failed.', example='true'),
}

model VerifyCatalogKmsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: VerifyCatalogKmsResponseBody(name='body'),
}

/**
  * @description This operation only validates whether the specified customer master key (CMK) can be used for BYOK SSE-KMS of the Catalog. It does not automatically enable encryption for all tables in the Catalog. The CMK is configured at the Catalog level through oss.sse.kms.key-id. When creating a table, set the table property oss.sse.kms.enabled=true to enable SSE-KMS for the specified table.
  * @param request  the request parameters of VerifyCatalogKms  VerifyCatalogKmsRequest
  * @return VerifyCatalogKmsResponse
 */
async function verifyCatalogKms(request: VerifyCatalogKmsRequest): VerifyCatalogKmsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'VerifyCatalogKms', 'POST', '/dlf/v1/catalogs/{catalog}/kms/verify', 'json', false, 'json', request);
}

