/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'DlfNext';
  @version = '2025-03-10';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CacheCluster {
  clusterId?: string(name='clusterId', description='Cluster ID', example='dc-wqewqr*****'),
  clusterName?: string(name='clusterName', description='Cluster name', example='cluster_name'),
  createdAt?: long(name='createdAt', description='Creation time', example='1744970111419'),
  createdBy?: string(name='createdBy', description='Creator name', example='acs:ram::[accountId]:root'),
  deployInstanceVersion?: string(name='deployInstanceVersion', description='Version of the deployed instance', example='1.0.0'),
  deployOptionsVersion?: long(name='deployOptionsVersion', description='Deployed options version', example='1.0.0'),
  instanceVersion?: string(name='instanceVersion', description='Milvus Version', example='1.0.0'),
  options?: map[string]string(name='options', description='Cache cluster configuration'),
  optionsVersion?: long(name='optionsVersion', description='Options version', example='1.0.0'),
  status?: string(name='status', description='Cache cluster status. Valid values:
● NEW: Newly created and not started.
● STARTING: Starting.
● START_FAILED: Start failed.
● RUNNING: Running.
● PENDING_RESTART: Pending restart.
● PENDING_TERMINATE: Pending termination.
● TERMINATING: Terminating.
● TERMINATE_FAILED: Termination failed.
● TERMINATED: Terminated.', example='RUNNING'),
  updatedAt?: long(name='updatedAt', description='Update time', example='1764555848748'),
  updatedBy?: string(name='updatedBy', description='Updater name', example='acs:ram::[accountId]:root'),
  vSwitches?: [ 
    {
      vSwitchId?: string(name='vSwitchId', description='vSwitch ID', example='vsw-bp1thxw8sgypzj2j*****'),
      zone?: string(name='zone', description='Instance zone', example='cn-hangzhou-e'),
    }
  ](name='vSwitches', description='vSwitch list'),
  vpcId?: string(name='vpcId', description='VPC ID', example='vpc-2ze****'),
}

model Catalog {
  createdAt?: long(name='createdAt', description='The time when the catalog was created.', example='1744970111419'),
  createdBy?: string(name='createdBy', description='The user who created the catalog.', example='acs:ram::[accountId]:root'),
  id?: string(name='id', description='The ID of the catalog.', example='clg-paimon-xxxx'),
  isShared?: boolean(name='isShared', description='Whether the data catalog is shared.', example='false'),
  name?: string(name='name', description='The name of the catalog.', example='test_catalog'),
  options?: map[string]string(name='options', description='The extension options.'),
  owner?: string(name='owner', description='The catalog owner.', example='acs:ram::[accountId]:root'),
  shareId?: string(name='shareId', description='Share ID.', example='share-xxxx'),
  status?: string(name='status', description='The status of the catalog.', example='NEW
INITIALIZING
INITIALIZE_FAILED
RUNNING
TERMINATED
DELETING
DELETE_FAILED 
DELETED
STORAGE_RESTRICTED'),
  type?: string(name='type', description='Type.', example='PAIMON'),
  updatedAt?: long(name='updatedAt', description='The time when the catalog was last modified.', example='1744970111419'),
  updatedBy?: string(name='updatedBy', description='The user who last modified the catalog.', example='acs:ram::[accountId]:root'),
}

model CatalogSummary {
  apiVisitCountMonthly?: long(name='apiVisitCountMonthly', description='The total number of metadata requests in the current month.', example='1000'),
  databaseCount?: MoMValues(name='databaseCount', description='The month-over-month data on the total number of databases.'),
  fileAccessCountMonthly?: long(name='fileAccessCountMonthly', description='The total number of file requests for the current month.', example='10000'),
  generatedDate?: string(name='generatedDate', description='The date when the storage overview data was updated.', example='2025-01-01'),
  objTypeArchiveSize?: long(name='objTypeArchiveSize', description='The storage usage for Archive data files.', example='10240'),
  objTypeColdArchiveSize?: long(name='objTypeColdArchiveSize', description='The storage usage for Cold Archive data files.', example='10240'),
  objTypeIaSize?: long(name='objTypeIaSize', description='The storage usage for Infrequent Access (IA) data files.', example='10240'),
  objTypeStandardSize?: long(name='objTypeStandardSize', description='The storage usage for Standard data files.', example='10240'),
  partitionCount?: MoMValues(name='partitionCount', description='The month-over-month data on the total number of partitions.'),
  tableCount?: MoMValues(name='tableCount', description='The month-over-month data on the total number of tables.'),
  throughputMonthly?: long(name='throughputMonthly', description='The data access traffic for the current month, in bytes.', example='1024'),
  totalFileCount?: MoMValues(name='totalFileCount', description='The month-over-month data on the total number of files.'),
  totalFileSizeInBytes?: MoMValues(name='totalFileSizeInBytes', description='The change in storage capacity from the previous period, in bytes.'),
  totalMetaFileCount?: MoMValues(name='totalMetaFileCount', description='The month-over-month data for the total number of metadata files.'),
  totalMetaSizeInBytes?: MoMValues(name='totalMetaSizeInBytes', description='The month-over-month data for the storage usage of metadata files, in bytes.'),
}

model CatalogSummaryTrend {
  apiVisitCount?: [
    DateSummary
  ](name='apiVisitCount', description='The trend of total metadata requests.'),
  fileAccessCount?: [
    DateSummary
  ](name='fileAccessCount', description='The trend of file access count.'),
  throughput?: [
    DateSummary
  ](name='throughput', description='The data access traffic trend.'),
  totalFileCount?: [
    DateSummary
  ](name='totalFileCount', description='The trend of total file count.'),
  totalFileSizeInBytes?: [
    DateSummary
  ](name='totalFileSizeInBytes', description='The trend of total storage capacity.'),
  totalMetaCount?: [
    DateSummary
  ](name='totalMetaCount', description='The trend of total metadata object count.'),
}

model ColumnMask {
  expression?: string(name='expression'),
  transform?: string(name='transform'),
}

model DataField {
  description?: string(name='description', description='The column description.', example='description'),
  id?: int32(name='id', description='The column ID.', example='0'),
  name?: string(name='name', description='The column name.', example='order_id'),
  type?: FullDataType(name='type', description='The column type.'),
}

model Database {
  createdAt?: long(name='createdAt', description='The creation time.', example='1744970111419'),
  createdBy?: string(name='createdBy', description='The creator.', example='acs:ram::[accountId]:root'),
  id?: string(name='id', description='The UUID of the database.', example='1'),
  location?: string(name='location', description='The storage path of the database.', example='oss://clg-paimon-xxx/db-xxx'),
  name?: string(name='name', description='The name of the database.', example='test_database'),
  options?: map[string]string(name='options', description='The extension options.'),
  owner?: string(name='owner', description='The owner of the database.', example='acs:ram::[accountId]:root'),
  status?: string(name='status'),
  tableCount?: long(name='tableCount'),
  updatedAt?: long(name='updatedAt', description='The update time.', example='1744970111419'),
  updatedBy?: string(name='updatedBy', description='The updater.', example='acs:ram::[accountId]:root'),
}

model DatabaseSummary {
  createdAt?: long(name='createdAt', description='The database creation time.', example='1744970111419'),
  databaseName?: string(name='databaseName', description='The database name.', example='default'),
  generatedDate?: string(name='generatedDate', description='The date when the storage overview data was updated.', example='2025-06-01'),
  location?: string(name='location', description='The storage location.', example='oss://clg-paimon-xxx/db-xxx'),
  objTypeArchiveSize?: long(name='objTypeArchiveSize', description='The storage size of Archive data files.', example='10240'),
  objTypeColdArchiveSize?: long(name='objTypeColdArchiveSize', description='The storage size of Cold Archive data files.', example='10240'),
  objTypeIaSize?: long(name='objTypeIaSize', description='The storage size of Infrequent Access data files.', example='10240'),
  objTypeStandardSize?: long(name='objTypeStandardSize', description='The storage size of Standard data files.', example='10240'),
  partitionCount?: long(name='partitionCount', description='The total number of partitions.', example='1000'),
  tableCount?: long(name='tableCount', description='The total number of tables.', example='50'),
  totalFileCount?: long(name='totalFileCount', description='The total number of files.', example='2000'),
  totalFileSizeInBytes?: long(name='totalFileSizeInBytes', description='The storage capacity.', example='1048576'),
  totalMetaFileCount?: long(name='totalMetaFileCount', description='The total number of metadata files.', example='1500'),
  totalMetaSizeInBytes?: long(name='totalMetaSizeInBytes', description='The storage size of metadata files, in bytes.', example='10240'),
}

model DateSummary {
  date?: string(name='date', description='The date.', example='2025-06-01'),
  value?: long(name='value', description='The value.', example='100'),
}

model ErrorResponse {
  code?: int32(name='code'),
  message?: string(name='message'),
  resourceName?: string(name='resourceName'),
  resourceType?: string(name='resourceType'),
}

model FailurePermission {
  errorCode?: string(name='errorCode', description='The error code.', example='空'),
  errorMessage?: string(name='errorMessage', description='The error message.', example='空'),
  permission?: Permission(name='permission', description='The permission information.'),
}

model FieldRef {
  index?: int32(name='index', description='Text sequence', example='1'),
  name?: string(name='name', description='Table name', example='name'),
  type?: FullDataType(name='type', description='File type'),
}

model FullDataType {
  element?: FullDataType(name='element', description='The data type.'),
  fields?: [
    DataField
  ](name='fields', description='The list of field definitions. This parameter is required when `type` is `ROW`.'),
  key?: FullDataType(name='key', description='The data type of the key. This parameter is required when `type` is `MAP`.'),
  type?: string(name='type', description='The data type. This parameter is required when `type` is `ARRAY` or `MULTISET`.', example='STRING'),
  value?: FullDataType(name='value', description='The data type of the value. This parameter is required when `type` is `MAP`.'),
}

model FullInstant {
  snapshotId?: long(name='snapshotId'),
  tagName?: string(name='tagName'),
  type?: string(name='type'),
}

model FullSchemaChange {
  action?: string(name='action', description='The type of change.', example='setOption'),
  comment?: string(name='comment', description='The description. This parameter is required when `action` is `UpdateComment` or `AddColumn`.', example='col_comment'),
  dataType?: FullDataType(name='dataType', description='The column type. This parameter is required when `action` is `AddColumn`.'),
  fieldNames?: [ string ](name='fieldNames', description='The table column names. This parameter is required when `action` is `AddColumn`, `RenameColumn`, `DropColumn`, `UpdateColumnComment`, `UpdateColumnType`, or `UpdateColumnNullability`.'),
  keepNullability?: boolean(name='keepNullability', description='Specifies whether the column is nullable. This parameter is required when the `action` is `UpdateColumnType`.', example='true'),
  key?: string(name='key', description='The key for the configuration. This parameter is required when `action` is `SetOption` or `RemoveOption`.', example='\\\\"true\\\\"'),
  move?: Move(name='move', description='The column to move. This parameter is required when `action` is `AddColumn` or `UpdateColumnPosition`.'),
  newComment?: string(name='newComment', description='The new description for the column. This parameter is required when `action` is `UpdateColumnComment`.', example='col_comment_test'),
  newDataType?: FullDataType(name='newDataType', description='The new column type. This parameter is required when `action` is `UpdateColumnType`.'),
  newName?: string(name='newName', description='The new name of the column. This parameter is required when `action` is `RenameColumn`.', example='new_col_test'),
  newNullability?: boolean(name='newNullability', description='Specifies whether the new column is nullable. This parameter is required when `action` is `UpdateColumnType`.', example='true'),
  value?: string(name='value', description='The value of the configuration. This parameter is required when `action` is `SetOption`.', example='\\\\"manifest.delete-file-drop-stats\\\\"'),
}

model Function {
  comment?: string(name='comment'),
  createdAt?: long(name='createdAt'),
  createdBy?: string(name='createdBy'),
  definitions?: map[string]FunctionDefinition(name='definitions'),
  deterministic?: boolean(name='deterministic'),
  id?: string(name='id'),
  inputParams?: [
    DataField
  ](name='inputParams'),
  name?: string(name='name'),
  options?: map[string]string(name='options'),
  owner?: string(name='owner'),
  returnParams?: [
    DataField
  ](name='returnParams'),
  updatedAt?: long(name='updatedAt'),
  updatedBy?: string(name='updatedBy'),
}

model FunctionChange {
  action?: string(name='action'),
  comment?: string(name='comment', description='required in UpdateFunctionComment'),
  definition?: FunctionDefinition(name='definition', description='required in AddDefinition/UpdateDefinition'),
  key?: string(name='key', description='required in SetFunctionOption/RemoveFunctionOption'),
  name?: string(name='name', description='required in AddDefinition/UpdateDefinition/DropDefinition'),
  value?: string(name='value', description='required in SetFunctionOption'),
}

model FunctionDefinition {
  className?: string(name='className', description='Required in FileFunctionDefinition.'),
  definition?: string(name='definition', description='Required in SQLFunctionDefinition and LambdaFunctionDefinition.'),
  fileResources?: [
    FunctionFileResource
  ](name='fileResources', description='Required in FileFunctionDefinition.'),
  functionName?: string(name='functionName', description='Required in FileFunctionDefinition.'),
  language?: string(name='language', description='Required in LambdaFunctionDefinition and FileFunctionDefinition.'),
  type?: string(name='type'),
}

model FunctionFileResource {
  resourceType?: string(name='resourceType', description='Resource type', example='JAR'),
  uri?: string(name='uri', description='Resource path', example='oss://tmp/SimpleUdf.jar'),
}

model IcebergNestedField {
  doc?: string(name='doc', description='The comment for the field.', example='desc1'),
  id?: long(name='id', description='The field ID.', example='1'),
  name?: string(name='name', description='The field name.', example='col1'),
  optional?: boolean(name='optional', description='Indicates whether the field is optional.', example='true'),
  type?: string(name='type', description='The field type.', example='string'),
}

model IcebergPartitionField {
  fieldId?: long(name='fieldId', description='The partition ID.', example='1'),
  name?: string(name='name', description='The partition name.', example='ts_day'),
  sourceId?: long(name='sourceId', description='The source ID.', example='0'),
  transform?: string(name='transform', description='The transformation rule.', example='day'),
}

model IcebergSnapshot {
  addedRows?: long(name='addedRows', description='Number of added rows.', example='20'),
  id?: long(name='id', description='The snapshot ID.', example='2443368274334000657'),
  idString?: string(name='idString'),
  operation?: string(name='operation', description='The operation.', example='append'),
  parentId?: long(name='parentId', description='Parent ID.', example='0'),
  parentIdString?: string(name='parentIdString'),
  schemaId?: long(name='schemaId', description='The schema ID.', example='0'),
  sequenceNumber?: long(name='sequenceNumber', description='The sequence number.', example='1'),
  summary?: map[string]string(name='summary', description='The summary.'),
  timestampMillis?: long(name='timestampMillis', description='The timestamp.', example='1750313724369'),
}

model IcebergTable {
  createdAt?: long(name='createdAt', description='The table creation time.', example='1747120676378'),
  createdBy?: string(name='createdBy', description='The table creator.', example='acs:ram::1045689747920334:root'),
  icebergTableMetadata?: IcebergTableMetadata(name='icebergTableMetadata', description='The metadata of the table.'),
  id?: string(name='id', description='The table UUID.', example='tbl-424fc31c-4876-4df5-97a5-c78f3046e739'),
  name?: string(name='name', description='The table name.', example='table1'),
  owner?: string(name='owner', description='The owner of the table.', example='acs:ram::1045689747920334:root'),
  path?: string(name='path', description='The table URI.', example='oss://clg-iceberg-bcc387be9d24490da5f194bbaf990906/ns-b314a3c3-dff5-4e30-8ba2-0493a60566c7.db/iceberg-tbl-56539259-1879-4d6d-bd6e-d1ddb3364cc9'),
  updatedAt?: long(name='updatedAt', description='The time when the table was last updated.', example='1744970111419'),
  updatedBy?: string(name='updatedBy', description='The user who last updated the table.', example='acs:ram::1045689747920334:root'),
  version?: long(name='version', description='The version of the table.', example='0'),
}

model IcebergTableMetadata {
  currentSnapshot?: IcebergSnapshot(name='currentSnapshot', description='The latest snapshot of the Iceberg table.'),
  fields?: [
    IcebergNestedField
  ](name='fields', description='The fields.'),
  identifierFieldIds?: [ int32 ](name='identifierFieldIds'),
  partitionFields?: [
    IcebergPartitionField
  ](name='partitionFields', description='The partition fields.'),
  properties?: map[string]string(name='properties', description='The properties.'),
}

model Identifier {
  database?: string(name='database', description='The database name.', example='database_name'),
  object?: string(name='object', description='The table name.', example='table_name'),
}

model MoMValues {
  currentValue?: long(name='currentValue', description='The current value.', example='1000'),
  lastDayValue?: long(name='lastDayValue', description='The value of the previous day.', example='800'),
  lastMonthValue?: long(name='lastMonthValue', description='The value of the previous month.', example='100'),
}

model Move {
  fieldName?: string(name='fieldName', description='The name of the column.', example='other_col_test'),
  referenceFieldName?: string(name='referenceFieldName', description='The name of the reference column.', example='col_test'),
  type?: string(name='type', description='The move type.', example='FIRST'),
}

model Namespace {
  createdAt?: long(name='createdAt'),
  createdBy?: string(name='createdBy'),
  id?: string(name='id'),
  location?: string(name='location'),
  name?: string(name='name'),
  options?: map[string]string(name='options'),
  owner?: string(name='owner'),
  updatedAt?: long(name='updatedAt'),
  updatedBy?: string(name='updatedBy'),
}

model Partition {
  createdAt?: long(name='createdAt', description='The time when the partition was created.', example='1747120676378'),
  createdBy?: string(name='createdBy', description='The creator of the partition.', example='acs:ram::[accountId]:root'),
  done?: boolean(name='done', description='Indicates whether the process is complete.', example='true'),
  fileCount?: long(name='fileCount', description='The number of files.', example='1'),
  fileSizeInBytes?: long(name='fileSizeInBytes', description='The file size.', example='1'),
  lastFileCreationTime?: long(name='lastFileCreationTime', description='The time when the latest file was created.', example='1741701564261'),
  recordCount?: long(name='recordCount', description='The number of records.', example='1'),
  spec?: map[string]any(name='spec', description='The key-value pairs of the partition values.', example='{"year":"2025"}'),
  storageAction?: string(name='storageAction', description='The status of the storage class conversion.', example='COMPLETE'),
  storageActionTimestamp?: long(name='storageActionTimestamp', description='The storage class conversion time.', example='1758189669915'),
  storageClass?: string(name='storageClass', description='The storage class.', example='STANDARD'),
  totalBuckets?: int32(name='totalBuckets', description='The total number of buckets.', example='1'),
  updatedAt?: long(name='updatedAt', description='The time when the partition was last updated.', example='1744970111419'),
  updatedBy?: string(name='updatedBy', description='The user who last updated the partition.', example='acs:ram::[accountId]:root'),
}

model PartitionSummaries {
  nextPageToken?: string(name='nextPageToken', description='The token to retrieve the next page of results. A null value indicates that the last page of results has been returned.', example='hh=10'),
  partitions?: [
    PartitionSummary
  ](name='partitions', description='The partitions.'),
}

model PartitionSummary {
  createdAt?: long(name='createdAt', description='The creation timestamp for the partition.', example='1744970111419'),
  databaseName?: string(name='databaseName', description='The name of the database.', example='default'),
  lastAccessTime?: long(name='lastAccessTime', description='The last access timestamp for the partition\\\\"s data.', example='1744970111419'),
  lastRequester?: string(name='lastRequester', description='The last requester.'),
  partitionName?: string(name='partitionName', description='The name of the partition.', example='hh=18'),
  storageActionParams?: map[string]string(name='storageActionParams', description='The storage action parameters.'),
  storageActionTimestamp?: long(name='storageActionTimestamp', description='The storage action timestamp.'),
  storageClass?: string(name='storageClass', description='The storage class.'),
  tableName?: string(name='tableName', description='The name of the table.', example='table1'),
  topRequester?: string(name='topRequester', description='The top requester.'),
  totalFileAccessNum?: long(name='totalFileAccessNum', description='Total file access count.'),
  totalFileAccessNum30d?: long(name='totalFileAccessNum30d', description='Total file access count over the last 30 days.'),
  totalFileAccessNum7d?: long(name='totalFileAccessNum7d', description='Total file access count over the last 7 days.'),
  totalFileCount?: long(name='totalFileCount', description='The total number of files in the partition.', example='2'),
  totalFileSizeInBytes?: long(name='totalFileSizeInBytes', description='The total size, in bytes, of all files in the partition.', example='2048'),
  updatedAt?: long(name='updatedAt', description='The last update timestamp for the partition.', example='1744970111419'),
}

model Permission {
  access?: string(name='access', description='The access type.', example='DROP'),
  columnMasking?: map[string]ColumnMask(name='columnMasking'),
  columns?: {
    columnNames?: [ string ](name='columnNames'),
    excludedColumnNames?: [ string ](name='excludedColumnNames'),
  }(name='columns'),
  database?: string(name='database', description='The database name.', example='database_name'),
  expireTime?: string(name='expireTime'),
  function?: string(name='function'),
  principal?: string(name='principal', description='The user resource descriptor.', example='acs:ram::[accountId]:user/user_name'),
  resourceType?: string(name='resourceType', description='The permission resource type.', example='CATALOG'),
  rowFilter?: RowFilter(name='rowFilter'),
  table?: string(name='table', description='The table name.', example='table_name'),
  view?: string(name='view'),
}

model Predicate {
  children?: [
    Predicate
  ](name='children'),
  function?: string(name='function'),
  kind?: string(name='kind'),
  literals?: [ any ](name='literals'),
  transform?: Transform(name='transform'),
}

model PrepayResource {
  catalogId?: string(name='catalogId', description='The catalog ID.', example='clg-xxxx'),
  catalogName?: string(name='catalogName', description='The catalog name.', example='test_catalog'),
  cu?: int32(name='cu', description='The number of CUs.', example='10'),
  expireTime?: long(name='expireTime', description='The time when the subscription expires.', example='1769356800000'),
  gmtCreate?: long(name='gmtCreate', description='The time when the resources are purchased.', example='1764070447351'),
  instanceId?: string(name='instanceId', description='The instance ID of computing resource.', example='dlf-cu-quota-xxxx'),
  instanceStatus?: string(name='instanceStatus', description='The status of the computing resource.', example='RUNNING
UPGRADING
CEASED
RELEASED'),
}

model ReceivedShare {
  catalogName?: string(name='catalogName', description='The catalog name.', example='catalog_name'),
  comment?: string(name='comment', description='The comment of the share.', example='demo'),
  createdAt?: long(name='createdAt', description='The creation time.', example='1744970111419'),
  createdBy?: string(name='createdBy', description='The creator of the share.', example='acs:ram::[accountId]:root'),
  enableWrite?: boolean(name='enableWrite'),
  owner?: string(name='owner', description='The share owner.', example='acs:ram::[accountId]:root'),
  providerTenantId?: long(name='providerTenantId', description='The provider\\\\"s account ID.', example='1111'),
  shareId?: string(name='shareId', description='The share ID.', example='1111'),
  shareName?: string(name='shareName', description='The share name.', example='share_name'),
  updatedAt?: long(name='updatedAt', description='The update time.', example='1744970111419'),
  updatedBy?: string(name='updatedBy', description='The user who last updated the share.', example='acs:ram::[accountId]:root'),
}

model Receiver {
  comment?: string(name='comment', description='The comment.', example='comment'),
  createdAt?: long(name='createdAt', description='The time when the receiver was created.', example='1744970111419'),
  createdBy?: string(name='createdBy', description='The creator.', example='acs:ram::[accountId]:root'),
