import Util;
import GatewayClient;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @productId = 'cloud-siem';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('cloud-siem', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model DataProductListLogMapValue = {
  logCode?: string(name='LogCode', description='The log code.', example='cloud_siem_config_log'),
  logName?: string(name='LogName', description='**[Deprecated]** This parameter is deprecated and can be ignored.', example='audit log'),
  logNameEn?: string(name='LogNameEn', description='**[Deprecated]** This parameter is deprecated and can be ignored.', example='audit log'),
  logNameKey?: string(name='LogNameKey', description='The language code of the log, which is used to display multilingual names.', example='${sas.cloudsiem.prod.cloud_siem_aegis_crack_from_beaver}'),
  status?: boolean(name='Status', description='The log delivery status. Valid values:
- true: Delivery is in progress.  
- false: Delivery is disabled.', example='true'),
  canOperateOrNot?: boolean(name='CanOperateOrNot', description='Specifies whether the log delivery switch can be operated. Only the delegated administrator of Threat Analysis can operate the log delivery switch. Valid values:
- true: The switch can be operated.  
- false: The switch cannot be operated.', example='true'),
  topic?: string(name='Topic', description='The topic of the log in the Logstore. It is an index field of the Logstore and can be used to distinguish different logs.', example='sas_login_event'),
  extraParameters?: [ 
    {
      key?: string(name='Key', description='The identifier of the extended parameter.', example='flag'),
      value?: string(name='Value', description='The value of the extended parameter.', example='value'),
    }
  ](name='ExtraParameters', description='The extended parameters.'),
}

model AddDataSourceRequest {
