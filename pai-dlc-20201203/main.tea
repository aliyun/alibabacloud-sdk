model JobElasticSpec {
  AIMasterDockerImage?: string(name='AIMasterDockerImage', description='The AIMaster Docker image.'),
  AIMasterType?: string(name='AIMasterType', description='The resource specifications for the AIMaster role.', example='ecs.c6.large'),
  EDPMaxParallelism?: int32(name='EDPMaxParallelism', description='The maximum EDP parallelism.', example='16'),
  EDPMinParallelism?: int32(name='EDPMinParallelism', description='The minimum EDP parallelism.', example='8'),
  elasticStrategy?: string(name='ElasticStrategy', description='The elastic training strategy.', example='chief'),
  enableAIMaster?: boolean(name='EnableAIMaster', description='Specifies whether to enable AIMaster.'),
  enableEDP?: boolean(name='EnableEDP', description='Specifies whether to enable EDP.', example='true'),
  enableElasticTraining?: boolean(name='EnableElasticTraining', description='Specifies whether to enable elastic training.', example='true'),
  enablePsJobElasticPS?: boolean(name='EnablePsJobElasticPS', description='Specifies whether to enable the elastic PS feature.', example='true'),
  enablePsJobElasticWorker?: boolean(name='EnablePsJobElasticWorker', description='Specifies whether to enable elastic workers for PS jobs.'),
  enablePsResourceEstimate?: boolean(name='EnablePsResourceEstimate', description='Specifies whether to enable PS resource estimation.', example='true'),
  maxParallelism?: int32(name='MaxParallelism', description='The maximum parallelism.', example='8'),
  minParallelism?: int32(name='MinParallelism', description='The minimum parallelism.', example='1'),
  PSMaxParallelism?: int32(name='PSMaxParallelism', description='The maximum PS parallelism.', example='10'),
  PSMinParallelism?: int32(name='PSMinParallelism', description='The minimum PS parallelism.', example='4'),
}

model JobItem {
  accessibility?: string(name='Accessibility', description='The visibility.', example='PUBLIC'),
  clusterId?: string(name='ClusterId', description='The cluster ID.', example='****1316721349****'),
  codeSource?: {
    branch?: string(name='Branch', description='The code repository branch.', example='master'),
    codeSourceId?: string(name='CodeSourceId', description='The code source configuration ID.', example='code-20210111103721-********'),
    commit?: string(name='Commit', description='The commit ID of the code repository used by this job.', example='44da109b59f8596152987eaa8f3b2487bb******'),
    mountPath?: string(name='MountPath', description='The local mount path of the code.', example='/mnt/data'),
  }(name='CodeSource', description='The code source configuration used by this job.'),
  credentialConfig?: CredentialConfig(name='CredentialConfig', description='The access credential configuration associated with the job.'),
  dataSources?: [ 
    {
      dataSourceId?: string(name='DataSourceId', description='The datasource config ID.', example='data-20210114104214-********'),
      mountPath?: string(name='MountPath', description='The local mount path of the data source.', example='/mnt/data'),
    }
  ](name='DataSources', description='The list of all datasource configs used by this job.'),
  displayName?: string(name='DisplayName', description='The job name.', example='tf-mnist-test'),
  duration?: long(name='Duration', description='The job duration in seconds.', example='243'),
  elasticSpec?: JobElasticSpec(name='ElasticSpec', description='The elastic job parameters.'),
  enablePreemptibleJob?: boolean(name='EnablePreemptibleJob', description='Specifies whether the preemptible job is enabled.', example='false'),
  enabledDebugger?: boolean(name='EnabledDebugger', description='Specifies whether debugger analysis is enabled.', example='false'),
  envs?: map[string]string(name='Envs', description='The environment variables injected during job execution.'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The job creation time in UTC format.', example='2025-04-16T07:25:34Z'),
  gmtFailedTime?: string(name='GmtFailedTime', description='The job failure time in UTC.', example='null'),
  gmtFinishTime?: string(name='GmtFinishTime', description='The job end time in UTC.', example='2025-04-16T07:28:20Z'),
  gmtModifiedTime?: string(name='GmtModifiedTime', description='The job modification time in UTC.', example='2025-04-16T07:28:22Z'),
  gmtRunningTime?: string(name='GmtRunningTime', description='The job start time in UTC.', example='2025-04-16T07:26:41Z'),
  gmtStoppedTime?: string(name='GmtStoppedTime', description='The job stop time in UTC.', example='null'),
  gmtSubmittedTime?: string(name='GmtSubmittedTime', description='The job submission time in UTC.', example='2025-04-16T07:26:14Z'),
  gmtSuccessedTime?: string(name='GmtSuccessedTime', description='The job success time in UTC.', example='2025-04-16T07:28:20Z'),
  isDeleted?: boolean(name='IsDeleted', description='Specifies whether the job is deleted.', example='false'),
  jobId?: string(name='JobId', description='The job ID.', example='dlc-20210126170216-********'),
  jobMaxRunningTimeMinutes?: long(name='JobMaxRunningTimeMinutes', description='The maximum job running time.', example='0'),
  jobReplicaStatuses?: [
    JobReplicaStatus
  ](name='JobReplicaStatuses', description='The list of replica running statuses for each task role.'),
  jobSpecs?: [
    JobSpec
  ](name='JobSpecs', description='The node configuration during job execution.'),
  jobType?: string(name='JobType', description='The job type. Valid values:
- TFJob
- PyTorchJob
- MPIJob
- XGBoostJob
- OneFlowJob
- ElasticBatchJob
- RayJob
- SlurmJob', example='TFJob'),
  nodeCount?: string(name='NodeCount', description='The number of nodes.', example='1'),
  nodeNames?: [ string ](name='NodeNames', description='The node names.'),
  pods?: [
    PodItem
  ](name='Pods', description='The pods.'),
  priority?: int32(name='Priority', description='The job priority.', example='1'),
  reasonCode?: string(name='ReasonCode', description='The reason code for the current job status. Valid values:
- InvalidParameter
- JobSucceeded
- JobStoppedByUser', example='JobStoppedByUser'),
  reasonMessage?: string(name='ReasonMessage', description='The detailed description of the reason for the current job status.', example='Job is stopped by user.'),
  requestCPU?: long(name='RequestCPU', description='The requested CPU resources.', example='1'),
  requestGPU?: string(name='RequestGPU', description='The requested GPU resources.', example='1'),
  requestMemory?: string(name='RequestMemory', description='The requested memory resources.', example='1Gi'),
  resourceId?: string(name='ResourceId', description='The ID of the resource group where the job runs.', example='dlc-quota'),
  resourceLevel?: string(name='ResourceLevel', description='The resource level when the job runs.', example='L0'),
  resourceName?: string(name='ResourceName', description='The name of the resource where the job runs.', example='my_resource_group'),
  resourceQuotaName?: string(name='ResourceQuotaName', description='The name of the resource.', example='test'),
  resourceType?: string(name='ResourceType', description='The resource type, such as ECS, Lingjun, or ACS.', example='ECS'),
  restartTimes?: string(name='RestartTimes', description='The number of times the job is restarted.', example='1'),
  retryCount?: int32(name='RetryCount', description='The number of retries configured for the node.', example='0'),
  schedulingStrategy?: string(name='SchedulingStrategy', description='The scheduling strategy of the node.', example='Auto'),
  settings?: JobSettings(name='Settings', description='The additional parameters of the job.'),
  status?: string(name='Status', description='The job status. Valid values:
- Succeeded
- Failed', example='Stopped'),
  statusHistory?: [
    StatusTransitionItem
  ](name='StatusHistory', description='The status transition information of the job.'),
  subStatus?: string(name='SubStatus', description='The substatus of the job, such as the preemptible retry status.', example='Restarting'),
  systemEnvs?: map[string]string(name='SystemEnvs', description='The system environment variable configuration.'),
  templateId?: string(name='TemplateId', description='The ID of the node template used to create the node.', example='tplmceolmf2****'),
  templateName?: string(name='TemplateName', description='The name of the node template used to create the node.', example='job-template-example-1778047****'),
  tenantId?: string(name='TenantId', description='The tenant ID.', example='****93955616****'),
  thirdpartyLibDir?: string(name='ThirdpartyLibDir', description='The directory where the third-party library file requirements.txt is located.', example='/root/code/'),
  thirdpartyLibs?: [ string ](name='ThirdpartyLibs', description='The list of third-party Python libraries installed before the job runs.'),
  useOversoldResource?: boolean(name='UseOversoldResource', description='Specifies whether the job uses idle resources.', example='false'),
  userCommand?: string(name='UserCommand', description='The startup command run by each node of the job.', example='python /root/code/mnist.py'),
  userId?: string(name='UserId', description='The UID of the user to whom the job belongs.', example='123456789'),
  userScript?: string(name='UserScript', description='The user script.', example='ls'),
  userVpc?: {
    defaultRoute?: string(name='DefaultRoute', description='The default routing. Valid values:
- eth0: Uses the default network interface controller (NIC) to access external networks through the public gateway.
- eth1: Uses the user elastic network interfaces (ENIs) to access external networks through the private gateway.', example='eth0'),
    extendedCidrs?: [ string ](name='ExtendedCidrs', description='The extended CIDR blocks to connect.'),
    securityGroupId?: string(name='SecurityGroupId', description='The security group ID.', example='sg-2zeef***'),
    switchId?: string(name='SwitchId', description='The vSwitch ID.', example='vsw-2ze6***'),
    vpcId?: string(name='VpcId', description='VPC ID', example='vpc-2zed***'),
  }(name='UserVpc', description='The user VPC.', example='vpc-1'),
  username?: string(name='Username', description='The username of the job submitter.', example='pai-dlc-role'),
  workingDir?: string(name='WorkingDir', description='The working directory.', example='/mnt/data'),
  workspaceId?: string(name='WorkspaceId', description='The ID of the workspace to which the job belongs.', example='268'),
  workspaceName?: string(name='WorkspaceName', description='The name of the workspace to which the job belongs.', example='dlc-workspace'),
  supportedProfilingTypes?: string(name='supportedProfilingTypes', description='The list of supported profiling types, separated by commas, such as sysom. An empty string indicates that profiling is not supported.', example='sysom'),
}

model JobReplicaStatus {
  active?: int32(name='Active', description='The number of replicas of this role that are currently running.', example='0'),
  currentSpotInstanceType?: string(name='CurrentSpotInstanceType', description='The currently selected spot instance type (applies only to elastic spot tasks).', example='ecs.gn6e-c12g1.3xlarge'),
  dequeued?: int32(name='Dequeued', description='The number of replicas of this role that have been dequeued.', example='0'),
  estimatedAutoScalingSpec?: AutoScalingSpec(name='EstimatedAutoScalingSpec', description='The estimated auto-scaling configuration for this role.', nullable=true),
  estimatedPodCount?: long(name='EstimatedPodCount', description='The estimated number of pods for this role.', example='2'),
  estimatedResourceConfig?: ResourceConfig(name='EstimatedResourceConfig', description='The estimated resource configuration for this role.', nullable=true),
  queuing?: int32(name='Queuing', description='The number of replicas of this role that are still in the queue.', example='0'),
  type?: string(name='Type', description='The role type to which the task replicas belong.', example='Worker'),
}

model JobSettings {
  advancedSettings?: map[string]any(name='AdvancedSettings', description='The additional advanced parameter settings.'),
  allocateAllRDMADevices?: boolean(name='AllocateAllRDMADevices', description='Specifies whether to allocate all RDMA NICs.'),
  allowUnschedulableNodes?: boolean(name='AllowUnschedulableNodes', description='Specifies whether to allow jobs to be scheduled to nodes that are marked as unschedulable or are in the workspace blacklist. If enabled, node status checks are skipped and the corresponding bypass configurations are applied.'),
  businessUserId?: string(name='BusinessUserId', description='The ID of the user associated with the job.', example='16****'),
  caller?: string(name='Caller', description='The caller.', example='SilkFlow'),
  dataJuicerConfig?: DataJuicerConfig(name='DataJuicerConfig', description='The DataJuicer job configuration.'),
  disableEcsStockCheck?: boolean(name='DisableEcsStockCheck', description='Specifies whether to skip the ECS inventory check. Valid values:
- true
- false', example='false'),
  driver?: string(name='Driver', description='The NVIDIA driver configuration.', example='535.54.03'),
  elasticSpotJobMaxRestartTimes?: int32(name='ElasticSpotJobMaxRestartTimes', description='The maximum number of restarts for an elastic spot job.', example='5'),
  enableCPUAffinity?: boolean(name='EnableCPUAffinity', description='The CPU affinity settings. These settings take effect only when general-purpose computing subscription resources are used.', example='true'),
  enableDSWDev?: boolean(name='EnableDSWDev', description='Specifies whether to enable the DSW development mode for the job. If enabled, a sidecar container is injected into the pod.'),
  enableErrorMonitoringInAIMaster?: boolean(name='EnableErrorMonitoringInAIMaster', description='Specifies whether to enable fault tolerance monitoring for the job. Valid values:
- true
- false', example='false'),
  enableOssAppend?: boolean(name='EnableOssAppend', description='Specifies whether to allow OSS append writes. Valid values:
- true
- false', example='true'),
  enableRDMA?: boolean(name='EnableRDMA', description='Specifies whether to allow the job to use RDMA. Valid values:
- true
- false', example='true'),
  enableSanityCheck?: boolean(name='EnableSanityCheck', description='Specifies whether to enable computing power health checks for the job. Valid values:
- true
- false', example='true'),
  enableTideResource?: boolean(name='EnableTideResource', description='Specifies whether to allow the job to use tide resources. Valid values:
- true
- false', example='true'),
  errorMonitoringArgs?: string(name='ErrorMonitoringArgs', description='The configuration parameters for fault tolerance monitoring when it is enabled, such as specifying whether to enable log hang-based detection.', example='--enable-log-hang-detection true'),
  jobReservedMinutes?: int32(name='JobReservedMinutes', description='The retention duration after the job ends, in minutes.', example='30'),
  jobReservedPolicy?: string(name='JobReservedPolicy', description='The retention policy after the job ends.', example='Always'),
  modelConfig?: ModelConfig(name='ModelConfig', description='The output model configuration. This parameter takes effect only in joint training scenarios.'),
  oversoldType?: string(name='OversoldType', description='The oversold resource usage mode for the job, which can be not accepted, accepted, or only accepted.', example='AcceptQuotaOverSold'),
  pipelineId?: string(name='PipelineId', description='The workflow ID.', example='pid-12****'),
  sanityCheckArgs?: string(name='SanityCheckArgs', description='The configuration parameters for computing power health checks.', example='--sanity-check-timing=AfterJobFaultTolerant --sanity-check-timeout-ops=MarkJobFail'),
  shell?: string(name='Shell', description='The shell used to execute job commands. Valid values: /bin/sh and /bin/bash.', example='/bin/bash'),
  tags?: map[string]string(name='Tags', description='The custom tags.'),
  terminationGracePeriodSeconds?: long(name='TerminationGracePeriodSeconds', description='The grace period to wait for the pod to exit when the job is terminated, in seconds.', example='60'),
}

model JobSpec {
  assignNodeSpec?: AssignNodeSpec(name='AssignNodeSpec', description='The specified node scheduling configuration.'),
  autoScalingSpec?: AutoScalingSpec(name='AutoScalingSpec', description='The auto scaling configuration.'),
  considerInSuccessPolicy?: boolean(name='ConsiderInSuccessPolicy', description='Specifies whether to consider this role when determining job success. This parameter takes effect only when the success policy is set to Partial.'),
  driver?: string(name='Driver', description='The GPU driver version used by the job.', example='535.54.03'),
  ecsSpec?: string(name='EcsSpec', description='The hardware specifications of the worker. For a detailed list of specifications, see [PAI-DLC billing overview](https://help.aliyun.com/document_detail/171758.html).>Notice: Prices vary by specification.', example='ecs.c6.large'),
  elasticSpotSpecs?: [
    ElasticSpotSpec
  ](name='ElasticSpotSpecs', description='The list of candidate instance types for this role to participate in elastic spot bidding.'),
  extraPodSpec?: ExtraPodSpec(name='ExtraPodSpec', description='The additional pod configuration.'),
  hyperNodeSchedulingConfig?: HyperNodeSchedulingConfig(name='HyperNodeSchedulingConfig', description='The hypernode scheduling configuration for this role.'),
  image?: string(name='Image', description='The runtime image URL for this type of worker. You can call [ListImages](https://help.aliyun.com/document_detail/449118.html) to obtain images provided by the PAI platform. You can also specify a public third-party image.', example='registry-vpc.cn-hangzhou.aliyuncs.com/cloud-dsw/tensorflow:1.12PAI-gpu-py36-cu101-ubuntu18.04'),
  imageConfig?: ImageConfig(name='ImageConfig', description='The private image configuration.'),
  isCheif?: boolean(name='IsCheif', description='**[Deprecated]** This field is misspelled and deprecated.', deprecated=true),
  isChief?: boolean(name='IsChief', description='Specifies whether this role is the chief role. Only one chief role is allowed.'),
  localMountSpecs?: [
    LocalMountSpec
  ](name='LocalMountSpecs', description='The list of local mount configurations.'),
  oversoldType?: string(name='OversoldType', description='The usage type of idle resources.', example='AcceptQuotaOverSold'),
  podCount?: long(name='PodCount', description='The number of replicas.', example='1'),
  quotaId?: string(name='QuotaId', description='The ID of the resource quota used by the job.', example='quota12345'),
  resourceConfig?: ResourceConfig(name='ResourceConfig', description='The resource configuration.'),
  restartPolicy?: string(name='RestartPolicy', description='The restart policy. Valid values: Always, Never, OnFailure, and ExitCode.', example='ExitCode'),
  serviceSpec?: ServiceSpec(name='ServiceSpec', description='The service configuration.'),
  spotSpec?: SpotSpec(name='SpotSpec', description='The spot instance configuration.'),
  startupDependencies?: [
    StartupDependency
  ](name='StartupDependencies', description='The dependencies required before this role starts.'),
  systemDisk?: SystemDisk(name='SystemDisk', description='The system cloud disk configuration for the job replicas.'),
  type?: string(name='Type', description='The type is closely related to the job type. Different job types support different worker types.

- **TFJob**: Supports Chief, PS, Worker, Evaluator, and GraphLearn.

- **PyTorchJob**: Supports Worker and Master.

- **XGBoostJob**: Supports Worker and Master.
- **OneFlowJob**: Supports Worker and Master.
- **ElasticBatch**: Supports Worker and Master.
- **RayJob**: Supports Head, Worker, and Worker[-xxx].

The Master role in PyTorchJob, XGBoostJob, OneFlowJob, and ElasticBatch is optional. If not specified, the system automatically assigns the first worker node as the master.', example='Worker'),
  useSpotInstance?: boolean(name='UseSpotInstance', description='Specifies whether to use spot instances.', example='false', deprecated=true),
  userCommand?: string(name='UserCommand', description='The role-level startup command.', example='python train.py'),
}

