  requests?: map[string]string(name='Requests', description='The resource requests.', example='{"cpu":"1","memory":"1000Mi"}'),
}

model Resources {
  CPU?: string(name='CPU', description='The number of CPU cores.', example='10'),
  GPU?: string(name='GPU', description='The number of GPU cards.', example='8'),
  memory?: string(name='Memory', description='The memory size.', example='1024 (unit: GB)'),
}

