  spotPriceLimit?: double(name='SpotPriceLimit', description='The maximum bid price.', example='0.4744'),
  spotStrategy?: string(name='SpotStrategy', description='The spot strategy.', example='SpotWithPriceLimit'),
}

model EnvVar {
  name?: string(name='Name', description='The name of the environment variable.', example='ENABLE_DEBUG'),
  value?: string(name='Value', description='The value of the environment variable.', example='true'),
}

model EventInfo {
  content?: string(name='Content', description='The text content of the event.', example='Training pod started.'),
  id?: string(name='Id', description='The ID of the event, which is used to obtain the related context.', example='event-example-001'),
  podId?: string(name='PodId', description='The ID of the pod to which the event belongs.', example='dlc*****-master-0'),
  podUid?: string(name='PodUid', description='The UID of the pod to which the event belongs.', example='94a7cc7c-0033-48b5-85bd-71c63592c268'),
