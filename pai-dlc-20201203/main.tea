  podIps?: [
    PodNetworkInterface
  ](name='PodIps', description='The IP addresses of the pod. For Lingjun AI Computing Service: user VPC net0, management VPC net, and pod-to-pod communication ethx. For general-purpose computing: user VPC eth1 with dedicated gateway default route, management VPC eth0 with public gateway default route, and pod-to-pod communication net eRDMA.'),
  podUid?: string(name='PodUid', description='Pod Uid', example='fe846462-af2c-4521-bd6f-96787a57591d'),
  status?: string(name='Status', description='The status of the pod.', example='Stopped'),
