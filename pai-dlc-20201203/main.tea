  clusterID?: string(name='ClusterID', description='The cluster ID.', example='cluster-example-001'),
  clusterName?: string(name='ClusterName', description='The cluster name.', example='example-training-cluster'),
  freeResourceId?: string(name='FreeResourceId', description='The idle resource ID.', example='freeres-whateversth'),
