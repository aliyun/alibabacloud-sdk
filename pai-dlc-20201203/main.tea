model RLFlowFunnelStage {
  count?: int32(name='Count', description='The number of trajectories that reach this level.', example='96'),
  key?: string(name='Key', description='The level identifier. Valid values: traj, dispatch, run, rollout, reward, sampled, and trained.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the level. Valid values: 生成轨迹, 下发到 Worker, Agent 启动, Rollout 完成, reward 打分, 采样入批, and 完成训练.', example='生成轨迹'),
  pct?: double(name='Pct', description='The percentage relative to the first traj level.', example='100'),
}

model RLFlowMilestoneCount {
  count?: int32(name='Count', description='The number of in-transit trajectories that remain at this milestone.', example='96'),
  milestone?: string(name='Milestone', description='The milestone. Valid values are the same as those of Stuck[].Milestone.', example='生成中'),
}

model RLFlowSankey {
  columns?: [
    RLFlowSankeyColumn
  ](name='Columns', description='The five columns of the main chain.', example='[{"Key":"traj","Label":"Generated trajectory","Count":96}]'),
  exits?: [
    RLFlowSankeyExit
  ](name='Exits', description='The outflow edges of each column.', example='[{"From":"run","FromIdx":1,"Label":"Not started","Count":0}]'),
}

model RLFlowSankeyColumn {
  count?: int32(name='Count', description='The number of trajectories in the column. The value is monotonized: reaching a later stage implies having passed through all preceding stages.', example='96'),
  key?: string(name='Key', description='The column identifier. Valid values: gen, run, rollout, sampled, and trained.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the column. Valid values: 轨迹生成, Agent 启动, Rollout 完成, 采样入批, and 完成训练.', example='生成轨迹'),
}

model RLFlowSankeyExit {
  count?: int32(name='Count', description='The number of trajectories on the outflow edge.', example='96'),
  from?: string(name='From', description='The key of the outflow source column.', example='DataLoader'),
  fromIdx?: int32(name='FromIdx', description='The index of the outflow source column (0-based).', example='0'),
  label?: string(name='Label', description='The Chinese name of the outflow destination. Valid values vary by the column where the outflow is located: 在途·未下发 / 在途·生成中 / 在途·待采样 / 在途·待训练.', example='生成轨迹'),
}

model RLFlowSlowestItem {
  promptUid?: string(name='PromptUid', description='The UID of the sample.', example='321fa56f-e1e5-4eb3-8047-db7a230c9a75'),
  sampleIndex?: string(name='SampleIndex', description='The ordinal number of the event trace.', example='2'),
  sec?: double(name='Sec', description='The execution duration of the stage, in seconds.', example='9.2'),
}

model RLFlowStep {
  bufferWaitP50?: double(name='BufferWaitP50', description='The P50 latency in seconds from when trajectories of the step enter the buffer to when batching occurs.', example='0.8'),
  gapSec?: double(name='GapSec', description='The gap duration in seconds, calculated as train started − rollout finished. This represents batching or transfer wait time.', example='0'),
  idleSec?: double(name='IdleSec', description='The training idle time in seconds, calculated as the current step training start − the previous step training end. If no marker is present, the value falls back to the current step forward computation start − the previous step optimizer end. A value greater than 0 indicates that the trainer is waiting for data.', example='0'),
  NSamples?: int32(name='NSamples', description='The number of samples (UIDs) consumed by the step.', example='24'),
  NTrajs?: int32(name='NTrajs', description='The number of trajectories executed in the step.', example='96'),
  prodEndMs?: long(name='ProdEndMs', description='The latest time when trajectories of the step enter the buffer, in milliseconds.', example='1787474487713'),
  prodStartMs?: long(name='ProdStartMs', description='The earliest time when trajectories of the step enter the buffer, in milliseconds.', example='1787474487713'),
  rolloutP50?: double(name='RolloutP50', description='The P50 latency in seconds from when trajectories of the step start execution to when they enter the buffer.', example='0.8'),
  rolloutSec?: double(name='RolloutSec', description='The rollout duration in seconds, calculated as rollout finished − rollout started. This value is null if no marker is present.', example='0'),
  step?: long(name='Step', description='The global step ordinal number.', example='3'),
  TFwdStartMs?: long(name='TFwdStartMs', description='The forward computation start time, in milliseconds.', example='1787474487713'),
  TOptEndMs?: long(name='TOptEndMs', description='The optimizer end time, in milliseconds.', example='1787474487713'),
  TRolloutEndMs?: long(name='TRolloutEndMs', description='The node operation log "Step N rollout finished" time, in milliseconds.', example='1787474487713'),
  TRolloutStartMs?: long(name='TRolloutStartMs', description='The node operation log "Step N rollout started" time, in milliseconds (taken from agent_collect_time).', example='1787474487713'),
  TTrainEndMs?: long(name='TTrainEndMs', description='The node operation log "Step N train finished" time, in milliseconds.', example='1787474487713'),
  TTrainStartMs?: long(name='TTrainStartMs', description='The node operation log "Step N train started" time, in milliseconds.', example='1787474487713'),
  TUpdateMs?: long(name='TUpdateMs', description='The TRAIN_UPDATE (parameter update) time, in milliseconds.', example='1787474487713'),
  trainSec?: double(name='TrainSec', description='The training duration in seconds. This value is preferentially calculated as train finished − train started. If no marker is present, the value falls back to the duration from batching to training completion. This value is null if global_step is duplicated because of a job restart.', example='0'),
}

model RLFlowStuckItem {
  idleSec?: long(name='IdleSec', description='The number of idle seconds since NowMs. This value is the descending sort key of the Stuck list.', example='0'),
  lastTsMs?: long(name='LastTsMs', description='The UNIX timestamp of the last event, in milliseconds.', example='1787293215480'),
  milestone?: string(name='Milestone', description='The current milestone where the entry is staying. Valid values:
- 已生成未下发: Generated but not delivered.
- 已下发未启动: Delivered but not started.
- 已启动待生成: Started and pending generation.
- 生成中: Generating.
- Rollout完成待打分: Rollout completed and pending scoring.
- 已打分待采样: Scored and pending sampling.
- 已采样待训练: Sampled and pending training.', example='生成中'),
  NTurns?: int32(name='NTurns', description='The number of completed generation rounds.', example='3'),
  promptUid?: string(name='PromptUid', description='The UID of the sample.', example='321fa56f-e1e5-4eb3-8047-db7a230c9a75'),
  sampleIndex?: string(name='SampleIndex', description='The ordinal number of the trajectory.', example='2'),
}

model RLFlowTotals {
  inflight?: int32(name='Inflight', description='The number of in-flight trajectories (no desired state).', example='0'),
  rewarded?: int32(name='Rewarded', description='The number of trajectories that have completed reward scoring (hit reward_score_computed).', example='96'),
  sampled?: int32(name='Sampled', description='The number of trajectories sampled into a batch by the trainer (hit sampled_from_replay_buffer).', example='96'),
  trained?: int32(name='Trained', description='The number of trajectories that have completed training (hit actor_parameters_updated).', example='96'),
  trajs?: int32(name='Trajs', description='The total number of trajectories in the window.', example='96'),
  uids?: int32(name='Uids', description='The number of sample UIDs that appear in the window.', example='24'),
}

model RLFlowTransition {
  avg?: double(name='Avg', description='The average duration in seconds.', example='1.9'),
  count?: int32(name='Count', description='The number of trajectories included in the statistics.', example='96'),
  key?: string(name='Key', description='The phase identifier. Valid values: dispatch_wait, start_wait, env_prepare, generation, agent_finish, reward, buffer_wait, logprob, ref_logprob, advantage, update, and e2e.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the phase.', example='生成轨迹'),
  max?: double(name='Max', description='The maximum duration in seconds.', example='9.2'),
  p50?: double(name='P50', description='The P50 duration in seconds.', example='0.8'),
  p90?: double(name='P90', description='The P90 duration in seconds.', example='5.9'),
  p99?: double(name='P99', description='The P99 duration in seconds.', example='8.6'),
  slowest?: [
    RLFlowSlowestItem
  ](name='Slowest', description='The slowest 5 trajectories.', example='[{"PromptUid":"321fa56f-e1e5-4eb3-8047-db7a230c9a75","SampleIndex":"2","Sec":9.2}]'),
}

model RLFlowTurns {
  avg?: double(name='Avg', description='The average number of generation rounds.', example='1.9'),
  count?: int32(name='Count', description='The number of traces included in the statistics.', example='96'),
  max?: int32(name='Max', description='The maximum number of generation rounds.', example='9.2'),
  p50?: int32(name='P50', description='The P50 of generation rounds.', example='0.8'),
  p90?: int32(name='P90', description='The P90 of generation rounds.', example='5.9'),
}

model RLFlowWaste {
  usefulSec?: long(name='UsefulSec', description='The cumulative duration of trained trajectories, in seconds.', example='183'),
}

model RLLogContextLine {
  message?: string(name='Message', description='The log text (<= 2000 characters, with ANSI escape codes stripped).', example='CUDA out of memory. Tried to allocate 2.00 GiB'),
  timestampMs?: long(name='TimestampMs', description='The millisecond timestamp of the log line.', example='1787293208012'),
}

model RLProgressBuffer {
  consumed?: int32(name='Consumed', description='The total number of consumed samples in incomplete buffers.', example='0'),
  detail?: [
    RLProgressBufferDetail
  ](name='Detail', description='The buffer details split by tag.', example='[{"Tag":1,"Ready":500,"Consumed":0,"Finished":500,"Total":512}]'),
  etaSec?: long(name='EtaSec', description='The estimated number of remaining seconds to fill the buffer.', example='0'),
  fillRatePerMin?: double(name='FillRatePerMin', description='The fill rate in entries per minute, estimated by using the rollout completion rate as a proxy.', example='120.5'),
  finished?: int32(name='Finished', description='The total number of finished samples in incomplete buffers.', example='500'),
  pct?: double(name='Pct', description='The readiness percentage, which is the ratio of Ready to Target.', example='100'),
  ready?: int32(name='Ready', description='The total number of ready samples in incomplete buffers.', example='500'),
  target?: int32(name='Target', description='The total number of target samples in incomplete buffers.', example='512'),
  trainBatchSize?: int32(name='TrainBatchSize', description='The configured training batch size.', example='512'),
  training?: boolean(name='Training', description='Indicates whether Consumed is greater than 0, which means the batch has been fetched and the trainer is updating.', example='true'),
}

model RLProgressBufferDetail {
  consumed?: int32(name='Consumed', description='The number of samples consumed by the trainer.', example='0'),
  finished?: int32(name='Finished', description='The number of finished samples.', example='500'),
  ready?: int32(name='Ready', description='The number of ready samples.', example='500'),
  tag?: int32(name='Tag', description='The buffer tag, which is the global batch ordinal number.', example='1'),
  total?: int32(name='Total', description='The target number of samples.', example='3'),
}

model RLProgressConfig {
  numMinibatches?: int32(name='NumMinibatches', description='The number of mini-batches per step.', example='4'),
  ppoMiniBatchSize?: int32(name='PpoMiniBatchSize', description='The PPO mini-batch size.', example='128'),
  rolloutN?: int32(name='RolloutN', description='The number of rollouts per prompt.', example='8'),
  totalSteps?: int32(name='TotalSteps', description='The total number of training steps.', example='3'),
  trainBatchSize?: int32(name='TrainBatchSize', description='The training batch size.', example='512'),
}

model RLProgressEval {
  done?: boolean(name='Done', description='Indicates whether Total is greater than 0 and Finished is not less than Total.', example='true'),
  finished?: int32(name='Finished', description='The number of finished samples.', example='500'),
  pct?: double(name='Pct', description='The progress percentage, which is the ratio of Progress to Total.', example='100'),
  progress?: int32(name='Progress', description='The progress count, which is the greater value of Ready and Finished.', example='500'),
  ready?: int32(name='Ready', description='The number of ready samples.', example='500'),
  total?: int32(name='Total', description='The target number of samples.', example='3'),
}

model RLProgressFatal {
  collectNs?: string(name='CollectNs', description='The agent_collect_time of the anchor line, represented as a nanosecond string that exceeds the JavaScript safe integer limit.', example='1787474487713456789'),
  message?: string(name='Message', description='The error message, truncated to 500 characters.', example='CUDA out of memory. Tried to allocate 2.00 GiB'),
  rawMessage?: string(name='RawMessage', description='The raw log line, truncated to 2000 characters. It is passed as AnchorMessage when calling GetRLLogContext.', example='[rank0]: torch.OutOfMemoryError: CUDA out of memory. Tried to allocate 2.00 GiB'),
  subsecNs?: long(name='SubsecNs', description='The nanosecond offset within the same second, used for sorting logs within the same second.', example='123456789'),
  time?: long(name='Time', description='The log time in UNIX seconds.', example='1787474487'),
}

model RLProgressMicro {
