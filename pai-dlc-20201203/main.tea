    RLProgressStage
  ](name='Stages', description='The list of stages in pipeline order.', example='[{"Key":"generation","Label":"Generation","Marker":"start/end generation","Optional":false,"Status":"done","StartTime":1787474487,"EndTime":1787474487,"Duration":0.483}]'),
