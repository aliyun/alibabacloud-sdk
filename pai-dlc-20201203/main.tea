    RLProgressSlowDetail
  ](name='Details', description='The slow inference details, up to 20 entries.', example='[{"Elapsed":42.5,"Time":1787474487,"Message":"rollout generation slow","Rank":0,"Pod":"dlc193cpaitk8eny-master-0","WorkerPid":12345,"Ip":"192.168.0.12","Rid":"req-8f3a2c1d","TokenizerPid":"12360","Ipc":"ipc://worker-0","IsPause":"false","StatePresent":"true","OutQueue":"3"}]'),
  elapsed?: double(name='Elapsed', description='The elapsed time of the slowest entry in seconds.', example='42.5'),
  time?: long(name='Time', description='The log timestamp of the slowest entry in UNIX seconds.', example='1787474487'),
}

model RLProgressSlowDetail {
  elapsed?: double(name='Elapsed', description='The elapsed time of the request, in seconds.', example='42.5'),
  ip?: string(name='Ip', description='worker IP', example='192.168.0.12'),
  ipc?: string(name='Ipc', description='The IPC channel identifier, which corresponds to the ipc field in the log.', example='ipc://worker-0'),
  isPause?: string(name='IsPause', description='Indicates whether the request is paused. This is the raw value of the is_pause field in the log.', example='false'),
  message?: string(name='Message', description='The log message, truncated to 700 characters.', example='CUDA out of memory. Tried to allocate 2.00 GiB'),
  outQueue?: string(name='OutQueue', description='The output queue length. This is the raw value of the out_queue field in the log.', example='3'),
  pod?: string(name='Pod', description='The name of the pod.', example='dlc193cpaitk8eny-master-0'),
  rank?: int32(name='Rank', description='The training rank.', example='0'),
  rid?: string(name='Rid', description='The inference request ID, which corresponds to the rid field in the log.', example='req-8f3a2c1d'),
  statePresent?: string(name='StatePresent', description='Indicates whether the state is present. This is the raw value of the state_present field in the log.', example='true'),
  time?: long(name='Time', description='The log time, in UNIX seconds.', example='1787474487'),
  tokenizerPid?: string(name='TokenizerPid', description='The tokenizer process ID, which corresponds to the pid field in the log.', example='12360'),
  workerPid?: int32(name='WorkerPid', description='The worker process ID.', example='12345'),
}

model RLProgressStage {
  duration?: double(name='Duration', description='The duration of the stage in seconds, with three decimal places. A step often falls entirely within the same second, so the value is not rounded to an integer.', example='0.483'),
  endTime?: long(name='EndTime', description='The end time of the stage in UNIX seconds.', example='1787474487'),
  key?: string(name='Key', description='The stage identifier.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the stage.', example='Generate trace'),
  marker?: string(name='Marker', description='The log marker text used to match the stage.', example='start/end generation'),
  optional?: boolean(name='Optional', description='Specifies whether the stage is optional. If an optional stage does not occur, its status is recorded as skipped.', example='false'),
  startTime?: long(name='StartTime', description='The start time of the stage in UNIX seconds.', example='1787474487'),
  status?: string(name='Status', description='done / running / waiting / pending / skipped', example='done'),
}

model RLProgressStages {
