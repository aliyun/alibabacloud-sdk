  workspaceName?: string(name='WorkspaceName', description='The workspace name.', example='dlc-workspace'),
}

model CreateJobRequest {
  accessibility?: string(name='Accessibility', description='The visibility of the job. Valid values:
- PUBLIC: Visible to all users in the workspace.
- PRIVATE: Visible only to you and administrators in the workspace.', example='PRIVATE'),
  codeSource?: {
    branch?: string(name='Branch', description='The branch of the referenced code repository when the job runs. This parameter is optional. By default, the branch configured in the code source is used.', example='master'),
    codeSourceId?: string(name='CodeSourceId', description='The ID of the code source. <props="china">For more information about how to obtain the code source ID, see [ListCodeSources](https://help.aliyun.com/document_detail/459922.html).', example='code-20210111103721-xxxxxxx'),
    commit?: string(name='Commit', description='The commit ID of the code to be downloaded for the job. This parameter is optional. By default, the commit ID configured in the code source is used.', example='44da109b5******'),
    isSharedMountPath?: boolean(name='IsSharedMountPath', description='Specifies whether the mount path configured in access code source is a shared cloud storage path. If this parameter is set to true, code clone optimization is enabled in the background. In multi-node job scenarios, the clone operation is performed on only one node, and other nodes can directly access access code through the shared cloud storage path.'),
    mountPath?: string(name='MountPath', description='The path to be mounted for the job. This parameter is optional. By default, the mount path configured in the code source is used.', example='/root/data'),
  }(name='CodeSource', description='The code source used by the job. Before the nodes of the job start, DLC automatically downloads the code configured in the code source and mounts it to the local directory of the container.'),
  credentialConfig?: CredentialConfig(name='CredentialConfig', description='The access credential configuration.'),
  customEnvs?: [ 
    {
      key?: string(name='Key', description='The name of the environment variable.', example='PUB'),
      value?: string(name='Value', description='The value of the environment variable.', example='keep'),
      visible?: string(name='Visible', description='The visibility of the environment variable. Valid values: public and private.', example='public'),
    }
  ](name='CustomEnvs', description='The list of custom environment variables.'),
  dataSources?: [ 
    {
      accessPointId?: string(name='AccessPointId', description='The ID of the access point. Currently, only access points of CPFS for AI are supported.'),
      dataSourceId?: string(name='DataSourceId', description='The ID of the data source. <props="china">For more information about how to view the data source ID, see [ListDatasets](https://help.aliyun.com/document_detail/457222.html).', example='d-cn9dl*******'),
      dataSourceVersion?: string(name='DataSourceVersion', description='The version of the dataset.', example='v1'),
      enableCache?: boolean(name='EnableCache', description='Specifies whether to enable the cache service for the data source. This parameter takes effect only when the cluster supports it and a resource group is configured.'),
      mountAccess?: string(name='MountAccess', description='The permissions when the dataset is mounted. Valid values:
- RO: read-only mount.
- RW: read-write mount.', example='RO'),
      mountPath?: string(name='MountPath', description='The path to be mounted for the job. This parameter is optional. By default, the mount path in the data source is used.', example='/root/data'),
      options?: string(name='Options', description='The mount property of the custom dataset. Currently, only OSS is supported.', example='{
  "fs.oss.download.thread.concurrency": "10",
  "fs.oss.upload.thread.concurrency": "10",
  "fs.jindo.args": "-oattr_timeout=3 -oentry_timeout=0 -onegative_timeout=0 -oauto_cache -ono_symlink"
}'),
      roleArn?: string(name='RoleArn', description='The ARN of the data source role. This parameter is required when OSS and CPFS access point authentication are enabled.', example='acs:ram::1872xxxxxxxxx:role/account-pai-prod'),
      roleChain?: string(name='RoleChain', description='The role chain, which is a JSON-formatted string. Example: [{"roleType":"service","roleArn":"acs:ram::Cloud service resource account UID:role/xxxtodlcrole","assumeRoleFor":"Cloud service resource account UID"},{"roleType":"user","roleArn":"acs:ram::Cloud service account UID:role/roletoassumecustomerrole"},{"roleType":"service","roleArn":"acs:ram::End user UID:role/use-bmcpfs-access-ap-role","assumeRoleFor":"End user UID"}]', example='[{"roleType":"service","roleArn":"acs:ram::Cloud service resource account UID:role/xxxtodlcrole","assumeRoleFor":"Cloud service resource account UID"},{"roleType":"user","roleArn":"acs:ram::Cloud service account UID:role/roletoassumecustomerrole"},{"roleType":"service","roleArn":"acs:ram::End user UID:role/use-bmcpfs-access-ap-role","assumeRoleFor":"End user UID"}]'),
      uri?: string(name='Uri', description='The path of the data source.', example='oss://bucket.oss-cn-hangzhou-internal.aliyuncs.com/path/'),
    }
  ](name='DataSources', description='The list of data sources used for running the job.'),
  debuggerConfigContent?: string(name='DebuggerConfigContent', description='This parameter is not supported. Ignore this parameter.', example='“”'),
  description?: string(name='Description', description='The description of the job.', example='This is a training job'),
  displayName?: string(name='DisplayName', description='The name of the job. The name must meet the following requirements:
- The name cannot exceed 256 characters in length.
- The name can contain digits, letters, underscores (_), periods (.), and hyphens (-).

This parameter is required.', example='tf-mnist-test'),
  dryRun?: boolean(name='DryRun', description='Specifies whether to enable dry run mode.'),
  elasticSpec?: JobElasticSpec(name='ElasticSpec', description='This parameter is not supported. Ignore this parameter.'),
  envs?: map[string]string(name='Envs', description='The environment variable configuration.'),
  jobMaxRunningTimeMinutes?: long(name='JobMaxRunningTimeMinutes', description='The maximum running duration of the job, in minutes.', example='1024'),
  jobSpecs?: [
    JobSpec
  ](name='JobSpecs', description='**JobSpecs** describes various configurations for the job at runtime, such as the image address, startup command, node resource declaration, and number of replicas.

A DLC job consists of different types of nodes. Nodes of the same type have identical configurations, which are referred to as a JobSpec. **JobSpecs** describes the configurations for all types of nodes and is an array of JobSpec objects.

This parameter is required.'),
  jobType?: string(name='JobType', description='The type of the job. This parameter is case-sensitive. Valid values:
- TFJob
- PyTorchJob
- MPIJob
- XGBoostJob
- OneFlowJob
- ElasticBatchJob
- SlurmJob
- RayJob
- DataJuicerJob

This parameter is required.', example='TFJob'),
  options?: string(name='Options', description='The additional configuration for the job. You can use this parameter to adjust the behavior of mounted data sources. For example, if the job mounts an OSS data source, you can set this parameter to `fs.oss.download.thread.concurrency=4,fs.oss.download.queue.size=16` to overwrite the default parameter settings of JindoFS.', example='key1=value1,key2=value2'),
  priority?: int32(name='Priority', description='The priority of the job. This parameter is optional. Default value: 1. Valid values: 1 to 9.
- 1: the lowest priority.
- 9: the highest priority.', example='8'),
  resourceId?: string(name='ResourceId', description='The ID of the resource group. This parameter is optional.
- If this parameter is left empty, the job is submitted to the public resource group.
- If the current workspace is attached to a resource quota, you can specify the corresponding resource quota ID here. For details about how to query the resource quota ID, see [Manage resource quotas](https://help.aliyun.com/document_detail/2651299.html).', example='rs-xxx'),
  schedulingStrategy?: string(name='SchedulingStrategy', description='The scheduling strategy.', example='Auto'),
  settings?: JobSettings(name='Settings', description='The additional parameter settings for the job.'),
  successPolicy?: string(name='SuccessPolicy', description='The success policy for distributed multi-node jobs. Currently, only multi-node TensorFlow jobs are supported. Valid values:
- ChiefWorker: If this value is specified, the entire job is considered successful as long as the chief pod ends successfully.
- AllWorkers (default): The entire job is considered successful only when all worker pods end successfully.', example='AllWorkers'),
  templateId?: string(name='TemplateId', description='The ID of the job template.', example='tplabc1234567'),
  templateVersion?: int32(name='TemplateVersion', description='The version of the job template.', example='1'),
  thirdpartyLibDir?: string(name='ThirdpartyLibDir', description='The name of the folder where the Python third-party library file (requirements.txt) is located. Before each node runs the specified UserCommand, PAI-DLC retrieves the requirements.txt file from the specified folder and runs the `pip install -r` command to install the libraries.', example='/root/code/'),
  thirdpartyLibs?: [ string ](name='ThirdpartyLibs', description='The list of Python third-party libraries to be installed.'),
  userCommand?: string(name='UserCommand', description='The startup command for all nodes of the job.

This parameter is required.', example='python /root/code/mnist.py'),
  userVpc?: {
    defaultRoute?: string(name='DefaultRoute', description='The default routing. Valid values:
- eth0: uses the default network interface controller (NIC) to access external networks through the public gateway.
- eth1: uses the user elastic network interface (ENI) to access external networks through the private gateway. For more information about the configuration method, see [Configure a DSW instance to access the Internet through a dedicated public gateway](https://help.aliyun.com/document_detail/2525343.html).', example='eth0'),
    extendedCIDRs?: [ string ](name='ExtendedCIDRs', description='The extended CIDR blocks.
- If the vSwitch ID is empty, this parameter is optional and the system automatically obtains all CIDR blocks under the VPC.
- If the vSwitch ID is not empty, this parameter is required. We recommend that you specify all CIDR blocks under the VPC.'),
    securityGroupId?: string(name='SecurityGroupId', description='The ID of the user security group.', example='sg-abcdef****'),
    switchId?: string(name='SwitchId', description='The ID of the user vSwitch. This parameter is optional.
- If this parameter is left empty, the system automatically selects an appropriate vSwitch based on inventory.
- You can also specify a vSwitch ID.', example='vs-abcdef****'),
    vpcId?: string(name='VpcId', description='The ID of the user VPC.', example='vpc-abcdef****'),
  }(name='UserVpc', description='The VPC configuration of the user.'),
  workspaceId?: string(name='WorkspaceId', description='The ID of the workspace. <props="china">For more information about how to obtain the workspace ID, see [ListWorkspaces](https://help.aliyun.com/document_detail/449124.html).', example='ws-20210126170216-xxxxxxx'),
}

