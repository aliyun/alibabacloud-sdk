model HyperNodeSchedulingConfig {
  minAvailable?: int32(name='MinAvailable', description='The minimum number of available instances required when the role participates in HyperNode scheduling. The value must be greater than 0.', example='1'),
  qualityPolicy?: string(name='QualityPolicy', description='The quality policy. Currently, only AlwaysRequire is supported.', example='AlwaysRequire'),
}

model HyperNodeSpec {
  hyperNodeName?: string(name='HyperNodeName', description='The name of the HyperNode.', example='mg1234567'),
  nodeNames?: string(name='NodeNames', description='The comma-separated names of the specified nodes in the HyperNode. If you leave this parameter empty, all nodes in the HyperNode are specified.', example='lingjxxxxxxxx'),
}

model ImageConfig {
  auth?: string(name='Auth', description='Image repository authentication information'),
  dockerRegistry?: string(name='DockerRegistry', description='Image repository address', example='docker****registry.com'),
  password?: string(name='Password', description='Image repository password', example='password'),
