  message?: string(name='Message', description='The check result details.', example='GPU health check passed.'),
  phase?: string(name='Phase', description='The check phase.', example='CheckInit'),
  startedAt?: string(name='StartedAt', description='The check start time.', example='2023-11-30T16:47:30.343005+08:00'),
