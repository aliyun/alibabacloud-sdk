import Util;
import GatewayClient;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @productId = 'pai-dlc';
  var gatewayClient = new GatewayClient();
  @spi = gatewayClient;
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-northeast-2-pop' = 'pai-dlc.aliyuncs.com',
    'ap-south-1' = 'pai-dlc.aliyuncs.com',
    'ap-southeast-2' = 'pai-dlc.aliyuncs.com',
    'cn-beijing-finance-1' = 'pai-dlc.aliyuncs.com',
    'cn-beijing-finance-pop' = 'pai-dlc.aliyuncs.com',
    'cn-beijing-gov-1' = 'pai-dlc.aliyuncs.com',
    'cn-beijing-nu16-b01' = 'pai-dlc.aliyuncs.com',
    'cn-chengdu' = 'pai-dlc.aliyuncs.com',
    'cn-edge-1' = 'pai-dlc.aliyuncs.com',
    'cn-fujian' = 'pai-dlc.aliyuncs.com',
    'cn-haidian-cm12-c01' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-bj-b01' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-finance' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-internal-prod-1' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-internal-test-1' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-internal-test-2' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-internal-test-3' = 'pai-dlc.aliyuncs.com',
    'cn-hangzhou-test-306' = 'pai-dlc.aliyuncs.com',
    'cn-hongkong-finance-pop' = 'pai-dlc.aliyuncs.com',
    'cn-huhehaote' = 'pai-dlc.aliyuncs.com',
    'cn-huhehaote-nebula-1' = 'pai-dlc.aliyuncs.com',
    'cn-north-2-gov-1' = 'pai-dlc.aliyuncs.com',
    'cn-qingdao' = 'pai-dlc.aliyuncs.com',
    'cn-qingdao-nebula' = 'pai-dlc.aliyuncs.com',
    'cn-shanghai-et15-b01' = 'pai-dlc.aliyuncs.com',
    'cn-shanghai-et2-b01' = 'pai-dlc.aliyuncs.com',
    'cn-shanghai-inner' = 'pai-dlc.aliyuncs.com',
    'cn-shanghai-internal-test-1' = 'pai-dlc.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'pai-dlc.aliyuncs.com',
    'cn-shenzhen-inner' = 'pai-dlc.aliyuncs.com',
    'cn-shenzhen-st4-d01' = 'pai-dlc.aliyuncs.com',
    'cn-shenzhen-su18-b01' = 'pai-dlc.aliyuncs.com',
    'cn-wuhan' = 'pai-dlc.aliyuncs.com',
    'cn-yushanfang' = 'pai-dlc.aliyuncs.com',
    'cn-zhangbei' = 'pai-dlc.aliyuncs.com',
    'cn-zhangbei-na61-b01' = 'pai-dlc.aliyuncs.com',
    'cn-zhangjiakou' = 'pai-dlc.aliyuncs.com',
    'cn-zhangjiakou-na62-a01' = 'pai-dlc.aliyuncs.com',
    'cn-zhengzhou-nebula-1' = 'pai-dlc.aliyuncs.com',
    'eu-west-1' = 'pai-dlc.aliyuncs.com',
    'eu-west-1-oxs' = 'pai-dlc.aliyuncs.com',
    'me-east-1' = 'pai-dlc.aliyuncs.com',
    'rus-west-1-pop' = 'pai-dlc.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('pai-dlc', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AIMasterMessage {
  extended?: string(name='Extended'),
  jobRestartCount?: int32(name='JobRestartCount'),
  messageContent?: string(name='MessageContent'),
  messageEvent?: string(name='MessageEvent'),
  messageVersion?: int32(name='MessageVersion'),
  restartType?: string(name='RestartType'),
}

model AgentPlatformJob {
  agentJobId?: string(name='AgentJobId', description='The ID of the AP task.', example='agent-job-example'),
  attempt?: long(name='Attempt', description='The attempt number of the current task.', example='0'),
  createdAt?: string(name='CreatedAt', description='The creation time in UTC RFC3339 format.', example='2026-10-30T06:00:00Z'),
  durationMs?: long(name='DurationMs', description='The execution duration of the current attempt in milliseconds. This value is returned only when the task is in a terminal state and both the completion time and execution duration are valid. Otherwise, null is returned.', example='1250', nullable=true),
  finishedAt?: string(name='FinishedAt', description='The completion time in UTC RFC3339 format. Returns null if the task is not in a terminal state or the completion time is invalid.', example='2026-10-30T06:00:01.250Z', nullable=true),
  instanceId?: string(name='InstanceId', description='The ID of the AP task instance.', example='sample-001'),
  jobId?: string(name='JobId', description='The ID of the DLC job to which the task belongs.', example='dlc5yfk7eyg95lac'),
  sandboxId?: string(name='SandboxId', description='The sandbox ID of the current attempt. Returns null if no matching information is found.', example='sandbox-example', nullable=true),
  sandboxInfo?: AgentSandboxInfo(name='SandboxInfo', description='The sandbox resource summary of the current attempt. Returns null if no matching information is found.', nullable=true),
  status?: string(name='Status', description='The status of the AP task.', example='Succeeded'),
  tags?: [ string ](name='Tags', description='The AP task tags, returned in the original content and order. Returns [] if the value is missing, null, or an empty array.', example='["scenario:swe"]'),
  template?: string(name='Template', description='The name of the AP template.', example='swe-bench'),
}

model AgentSandboxInfo {
  CPUCount?: long(name='CPUCount', example='2', nullable=true),
  collectedAt?: string(name='CollectedAt', example='2026-10-30T06:00:00.500Z'),
  diskTotal?: long(name='DiskTotal', example='21474836480', nullable=true),
  memoryMB?: long(name='MemoryMB', example='4096', nullable=true),
}

model AliyunAccounts {
  aliyunUid?: string(name='AliyunUid', description='The UID of the Alibaba Cloud account.', example='1234567890123456'),
  employeeId?: string(name='EmployeeId', description='The employee ID of the internal user.', example='123456'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The creation time of the record.', example='2021-01-18T12:52:15Z'),
  gmtModifyTime?: string(name='GmtModifyTime', description='The last modification time of the record.', example='2021-01-18T12:52:15Z'),
}

model AssignNodeSpec {
  antiAffinityHyperNodes?: [
    HyperNodeSpec
  ](name='AntiAffinityHyperNodes', description='The list of hyper nodes to avoid during scheduling.'),
  antiAffinityNodeNames?: string(name='AntiAffinityNodeNames', description='AntiAffinityNodeNames', example='lingjxxxxxxxx'),
  enableAssignNode?: boolean(name='EnableAssignNode', description='EnableAssignNode', example='true'),
  hyperNodes?: [
    HyperNodeSpec
  ](name='HyperNodes', description='The list of hyper nodes to schedule to.'),
  nodeNames?: string(name='NodeNames', description='NodeNames', example='lingjxxxxxxxx'),
}

model AssumeUserInfo {
  accessKeyId?: string(name='AccessKeyId', description='The AccessKey ID used for role assumption.', example='LTAI5tExample****KeyId1234'),
  id?: string(name='Id', description='The user ID.', example='203610320085271232'),
  securityToken?: string(name='SecurityToken', description='The security token used for role assumption.', example='CAISexample****SecurityToken'),
  type?: string(name='Type', description='The user identity type.', example='sub'),
}

model AutoScalingSpec {
  autoscalingMetricSpec?: AutoscalingMetricSpec(name='AutoscalingMetricSpec', description='The monitoring metrics configuration for autoscaling.'),
  maxReplicas?: int32(name='MaxReplicas', description='The maximum number of replicas.', example='10'),
  minReplicas?: int32(name='MinReplicas', description='The minimum number of replicas.', example='1'),
  podsToDelete?: [ string ](name='PodsToDelete', description='The Pods to delete for scale-in. This can only be modified through UpdateJob, and the number of Pods to delete must match PodCount.'),
  scalingStrategy?: string(name='ScalingStrategy', description='The autoscaling policy. Valid values: Default, ScaleByAPI, RayAutoscaler, and CloudMonitorMetric.', example='Default'),
}

model AutoscalingMetricSpec {
  metricName?: string(name='MetricName', description='The name of the monitoring metrics used for auto scaling.', example='POD_CPU_UTIL'),
  stabilizationWindowSeconds?: int32(name='StabilizationWindowSeconds', description='The duration of the stabilization window for the auto scaling metric, in seconds.', example='60'),
  targetValue?: int32(name='TargetValue', description='The target value of the monitoring metrics for auto scaling.', example='80'),
  tolerance?: string(name='Tolerance', description='The allowed bias ratio for the target value of the monitoring metrics.', example='0.1'),
}

model CodeSourceItem {
  codeBranch?: string(name='CodeBranch', description='The branch of the code repository. If you configure this parameter when you call the CreateJob API operation, the branch is overwritten.', example='master'),
  codeCommit?: string(name='CodeCommit', description='The commit ID. If you configure this parameter when you call the CreateJob API operation, the commit is overwritten.', example='44da109b59f8596152987eaa8f3b2487bb72ea63'),
  codeRepo?: string(name='CodeRepo', description='The URL of the code repository.', example='https://code.aliyun.com/pai-dlc/examples.git'),
  codeRepoAccessToken?: string(name='CodeRepoAccessToken', description='The access token used to access the code repository.', example='xxxx'),
  codeRepoUserName?: string(name='CodeRepoUserName', description='The username used to access the private code repository.', example='user'),
  codeSourceId?: string(name='CodeSourceId', description='The ID of the code source.', example='code-20210111103721-********'),
  description?: string(name='Description', description='The description of the code source.', example='code source of dlc examples'),
  displayName?: string(name='DisplayName', description='The name of the code source.', example='MyCodeSourceName1'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The time when the code source was created. The time is displayed in UTC.', example='2021-01-18T12:52:15Z'),
  gmtModifyTime?: string(name='GmtModifyTime', description='The time when the code source was modified. The time is displayed in UTC.', example='2021-01-18T12:52:15Z'),
  userId?: string(name='UserId', description='The UID of the Alibaba Cloud user who creates the code source.', example='115729017166****'),
}

model ContainerInfo {
  mainContainer?: string(name='MainContainer', description='The name of the main container.', example='pytorch'),
  sidecarContainers?: [ string ](name='SidecarContainers', description='The list of sidecar container names.'),
}

model ContainerSpec {
  args?: [ string ](name='Args', description='The command arguments.'),
  command?: [ string ](name='Command', description='The user command.'),
  env?: [
    EnvVar
  ](name='Env', description='The environment variables.'),
  image?: string(name='Image', description='The container image address.', example='registry.cn-hangzhou.aliyuncs.com/pai-dlc/curl:v1.0.0'),
  name?: string(name='Name', description='The container name.', example='data-init'),
  resources?: ResourceRequirements(name='Resources', description='The container resources.'),
  securityContext?: SecurityContext(name='SecurityContext', description='The container security context configuration.'),
  workingDir?: string(name='WorkingDir', description='The working directory in the container.', example='/root'),
}

model CredentialConfig {
  aliyunEnvRoleKey?: string(name='AliyunEnvRoleKey', description='The role identity key injected into environment variables.', example='0'),
  credentialConfigItems?: [
    CredentialConfigItem
  ](name='CredentialConfigItems', description='The list of credential configuration items.'),
  enableCredentialInject?: boolean(name='EnableCredentialInject', description='Specifies whether credential injection is enabled.'),
}

model CredentialConfigItem {
  key?: string(name='Key', description='The identity key of the credential configuration item.', example='0'),
  roles?: [
    CredentialRole
  ](name='Roles', description='The list of associated roles.', nullable=true),
  type?: string(name='Type', description='The credential type.', example='RoleChain'),
}

model CredentialRole {
  assumeRoleFor?: string(name='AssumeRoleFor', description='The account on whose behalf the role is assumed.', example='123456'),
  assumeUserInfo?: AssumeUserInfo(name='AssumeUserInfo', description='The user identity information used for role assumption.'),
  policy?: string(name='Policy', description='The access policy attached during role assumption.', example='{"Version":"1","Statement":[{"Effect":"Allow","Action":["oss:GetObject"],"Resource":["acs:oss:*:*:example-bucket/data/*"]}]}'),
  roleArn?: string(name='RoleArn', description='The ARN of the RAM role.', example='acs:ram::1872xxxxxxxxx:role/account-pai-prod'),
  roleType?: string(name='RoleType', description='The role type. Valid values: service and user.', example='service'),
}

model DataJuicerConfig {
  commandType?: string(name='CommandType', description='The command type. Valid values:

- shell: shell command.
- config: DataJuicer YAML configuration.', example='config'),
  enableResourceEstimation?: boolean(name='EnableResourceEstimation', description='Specifies whether to enable resource estimation. When resource estimation is enabled, the execution mode must be distributed, and the command type must be config (DataJuicer YAML configuration).', example='true'),
  executionMode?: string(name='ExecutionMode', description='The execution mode. Valid values:

- standalone: single-node.
- distributed: distributed.', example='standalone'),
  resourceLimit?: ResourceLimit(name='ResourceLimit', description='The resource estimation limit. This parameter takes effect only when resource estimation is enabled.'),
}

model DataSourceItem {
  dataSourceId?: string(name='DataSourceId', description='The data source ID.', example='data-20210114104214-xxxxxxx'),
  dataSourceType?: string(name='DataSourceType', description='The data source type. Only File Storage NAS (NAS) file systems are supported.', example='nas'),
  description?: string(name='Description', description='The data source description.', example='data source of dlc examples'),
  displayName?: string(name='DisplayName', description='The data source name.', example='nas-data'),
  endpoint?: string(name='Endpoint', description='The endpoint of the Alibaba Cloud OSS file system.', example='oss-cn-beijing-internal.aliyuncs.com'),
  fileSystemId?: string(name='FileSystemId', description='The ID of the NAS file system. For more information, see [Alibaba Cloud documentation](https://help.aliyun.com/document_detail/185212.html).', example='1ca404****'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The time when the data source was created. The time is displayed in UTC.', example='2021-01-12T14:35:00Z'),
  gmtModifyTime?: string(name='GmtModifyTime', description='The time when the data source was last modified. The time is displayed in UTC.', example='2021-01-12T14:36:00Z'),
  mountPath?: string(name='MountPath', description='The local path of the container that is attached to the runtime of the task.', example='/root/data/'),
  options?: string(name='Options', description='The configuration options of the Alibaba Cloud OSS file system.', example='{"key": "value"}'),
  path?: string(name='Path', description='The path of the Alibaba Cloud Object Storage Service (OSS) file system.', example='oss://mybucket/path/to/dir'),
  userId?: string(name='UserId', description='The ID of the Alibaba Cloud account that creates the data source.', example='123456789'),
}

model DebuggerConfig {
  content?: string(name='Content', description='The configuration item details in JSON format.', example='{\\"description\\":\\"This is a new pytorchjob template\\"}'),
  debuggerConfigId?: string(name='DebuggerConfigId', description='The system-generated unique ID of the debug config.', example='dc-vf9lowjt3pso'),
