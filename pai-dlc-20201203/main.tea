  quotaConfig?: QuotaConfig(name='QuotaConfig'),
  quotaId?: string(name='QuotaId', example='quotamtl37ge7gkvdz'),
  quotaName?: string(name='QuotaName', example='dlc-quota'),
  quotaType?: string(name='QuotaType', example='asiquota'),
  totalQuota?: QuotaDetail(name='TotalQuota'),
  totalTideQuota?: QuotaDetail(name='TotalTideQuota'),
  usedQuota?: QuotaDetail(name='UsedQuota'),
  usedTideQuota?: QuotaDetail(name='UsedTideQuota'),
}

model QuotaConfig {
  allowedMaxPriority?: int32(name='AllowedMaxPriority', description='The maximum allowed priority.', example='9'),
  enableDLC?: boolean(name='EnableDLC', description='Specifies whether DLC is enabled.'),
  enableDSW?: boolean(name='EnableDSW', description='Specifies whether DSW is enabled.'),
  enableTideResource?: boolean(name='EnableTideResource', description='Specifies whether to use tide resources.'),
  resourceLevel?: string(name='ResourceLevel', description='The resource level (L0, L1).', example='L0'),
}

model QuotaDetail {
  CPU?: string(name='CPU', description='The number of CPU cores.', example='2'),
  GPU?: string(name='GPU', description='The number of GPUs.', example='5'),
  GPUDetails?: [
    GPUDetail
  ](name='GPUDetails', description='The GPU details.'),
  GPUType?: string(name='GPUType', description='The GPU type.', example='Tesla-V100'),
  GPUTypeFullName?: string(name='GPUTypeFullName', description='The full name of the GPU type.', example='nvidia.com/gpu'),
  memory?: string(name='Memory', description='The memory capacity.', example='10Gi'),
}

model RLFlowFunnelStage {
  count?: int32(name='Count', description='The number of trajectories that reach this level.', example='96'),
  key?: string(name='Key', description='The level identifier. Valid values: traj, dispatch, run, rollout, reward, sampled, and trained.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the level. Valid values: 生成轨迹, 下发到 Worker, Agent 启动, Rollout 完成, reward 打分, 采样入批, and 完成训练.', example='生成轨迹'),
  pct?: double(name='Pct', description='The percentage relative to the first traj level.', example='100'),
}

model RLFlowMilestoneCount {
  count?: int32(name='Count', description='The number of in-transit trajectories at this milestone.', example='96'),
  milestone?: string(name='Milestone', description='The milestone. The valid values are the same as those of Stuck[].Milestone.', example='Generating'),
}

model RLFlowSankey {
  columns?: [
    RLFlowSankeyColumn
  ](name='Columns', description='The five columns of the main chain.', example='[{"Key":"traj","Label":"Generated trajectory","Count":96}]'),
  exits?: [
    RLFlowSankeyExit
  ](name='Exits', description='The outflow edges of each column.', example='[{"From":"run","FromIdx":1,"Label":"Not started","Count":0}]'),
}

model RLFlowSankeyColumn {
  count?: int32(name='Count', description='The number of trajectories in the column. The value is monotonized: reaching a later stage implies having passed through all preceding stages.', example='96'),
  key?: string(name='Key', description='The column identifier. Valid values: gen, run, rollout, sampled, and trained.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the column. Valid values: 轨迹生成, Agent 启动, Rollout 完成, 采样入批, and 完成训练.', example='生成轨迹'),
}

model RLFlowSankeyExit {
  count?: int32(name='Count', description='The number of trajectories on the outflow edge.', example='96'),
  from?: string(name='From', description='The key of the outflow source column.', example='DataLoader'),
  fromIdx?: int32(name='FromIdx', description='The index of the outflow source column (0-based).', example='0'),
  label?: string(name='Label', description='The Chinese name of the outflow destination. Valid values vary by the column where the outflow is located: 在途·未下发 / 在途·生成中 / 在途·待采样 / 在途·待训练.', example='生成轨迹'),
}

model RLFlowSlowestItem {
  promptUid?: string(name='PromptUid', description='The UID of the sample.', example='321fa56f-e1e5-4eb3-8047-db7a230c9a75'),
  sampleIndex?: string(name='SampleIndex', description='The ordinal number of the event trace.', example='2'),
  sec?: double(name='Sec', description='The execution duration of the stage, in seconds.', example='9.2'),
}

model RLFlowStep {
  bufferWaitP50?: double(name='BufferWaitP50', description='The P50 duration in seconds from when trajectories of the step enter the buffer to when they are batched.', example='0.8'),
  gapSec?: double(name='GapSec', description='The gap duration in seconds, calculated as train started minus rollout finished, representing batching or transfer wait time.', example='0'),
  idleSec?: double(name='IdleSec', description='The idle time in seconds between the training phases of adjacent steps. This value only reflects the time interval and cannot be used alone to determine data waiting or other specific causes.', example='0'),
  NSamples?: int32(name='NSamples', description='The number of samples (UIDs) consumed by the step.', example='24'),
  NTrajs?: int32(name='NTrajs', description='The number of trajectories belonging to the current execution of the step.', example='96'),
  prodEndMs?: long(name='ProdEndMs', description='The latest time a trajectory of the step enters the buffer in milliseconds.', example='1787474487713'),
  prodStartMs?: long(name='ProdStartMs', description='The earliest time a trajectory of the step enters the buffer in milliseconds.', example='1787474487713'),
  rolloutP50?: double(name='RolloutP50', description='The P50 duration in seconds from when trajectories of the step start execution to when they enter the buffer.', example='0.8'),
  rolloutSec?: double(name='RolloutSec', description='The rollout duration in seconds, calculated as rollout finished minus rollout started. This value is empty when no markers are available.', example='0'),
  step?: long(name='Step', description='The global step number.', example='3'),
  TFwdStartMs?: long(name='TFwdStartMs', description='The start time of the forward computation in milliseconds.', example='1787474487713'),
  TOptEndMs?: long(name='TOptEndMs', description='The end time of the optimizer in milliseconds.', example='1787474487713'),
  TRolloutEndMs?: long(name='TRolloutEndMs', description='The time of the "Step N rollout finished" entry in the node logs in milliseconds.', example='1787474487713'),
  TRolloutStartMs?: long(name='TRolloutStartMs', description='The observed rollout start time for the current step as a millisecond timestamp.', example='1787474487713'),
  TTrainEndMs?: long(name='TTrainEndMs', description='The time of the "Step N train finished" entry in the node logs in milliseconds.', example='1787474487713'),
  TTrainStartMs?: long(name='TTrainStartMs', description='The time of the "Step N train started" entry in the node logs in milliseconds.', example='1787474487713'),
  TUpdateMs?: long(name='TUpdateMs', description='The time of the TRAIN_UPDATE (parameter update) event in milliseconds.', example='1787474487713'),
  trainSec?: double(name='TrainSec', description='The duration of the training phase for the step in seconds. This value is not provided when the training start and end times are unavailable.', example='0'),
}

model RLFlowStuckItem {
  idleSec?: long(name='IdleSec', description='The number of idle seconds since NowMs (the descending sort key for the stuck list).', example='0'),
  lastTsMs?: long(name='LastTsMs', description='The millisecond timestamp of the last event.', example='1787293215480'),
  milestone?: string(name='Milestone', description='The current milestone: generated but not dispatched, dispatched but not started, started but pending generation, generating, rollout completed pending scoring, scored pending sampling, or sampled pending training.', example='Generating'),
  NTurns?: int32(name='NTurns', description='The number of completed generation turns.', example='3'),
  promptUid?: string(name='PromptUid', description='The sample UID.', example='321fa56f-e1e5-4eb3-8047-db7a230c9a75'),
  sampleIndex?: string(name='SampleIndex', description='The trajectory index.', example='2'),
}

model RLFlowTotals {
  inflight?: int32(name='Inflight', description='The number of in-flight trajectories (no desired state).', example='0'),
  rewarded?: int32(name='Rewarded', description='The number of trajectories that have completed reward scoring (hit reward_score_computed).', example='96'),
  sampled?: int32(name='Sampled', description='The number of trajectories sampled into a batch by the trainer (hit sampled_from_replay_buffer).', example='96'),
  trained?: int32(name='Trained', description='The number of trajectories that have completed training (hit actor_parameters_updated).', example='96'),
  trajs?: int32(name='Trajs', description='The total number of trajectories in the window.', example='96'),
  uids?: int32(name='Uids', description='The number of sample UIDs that appear in the window.', example='24'),
}

model RLFlowTransition {
  avg?: double(name='Avg', description='The average duration in seconds.', example='1.9'),
  count?: int32(name='Count', description='The number of trajectories included in the statistics.', example='96'),
  key?: string(name='Key', description='The phase identifier. Valid values: dispatch_wait, start_wait, env_prepare, generation, agent_finish, reward, buffer_wait, logprob, ref_logprob, advantage, update, and e2e.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the phase.', example='生成轨迹'),
  max?: double(name='Max', description='The maximum duration in seconds.', example='9.2'),
  p50?: double(name='P50', description='The P50 duration in seconds.', example='0.8'),
  p90?: double(name='P90', description='The P90 duration in seconds.', example='5.9'),
  p99?: double(name='P99', description='The P99 duration in seconds.', example='8.6'),
  slowest?: [
    RLFlowSlowestItem
  ](name='Slowest', description='The slowest 5 trajectories.', example='[{"PromptUid":"321fa56f-e1e5-4eb3-8047-db7a230c9a75","SampleIndex":"2","Sec":9.2}]'),
}

model RLFlowTurns {
  avg?: double(name='Avg', description='The average number of generation rounds.', example='1.9'),
  count?: int32(name='Count', description='The number of traces included in the statistics.', example='96'),
  max?: int32(name='Max', description='The maximum number of generation rounds.', example='9.2'),
  p50?: int32(name='P50', description='The P50 of generation rounds.', example='0.8'),
  p90?: int32(name='P90', description='The P90 of generation rounds.', example='5.9'),
}

model RLFlowWaste {
  usefulSec?: long(name='UsefulSec', description='The cumulative duration of trained trajectories, in seconds.', example='183'),
}

model RLJobAgentServiceConfig {
  enable?: boolean(name='Enable', description='Specifies whether to enable the companion AgentService for the job. Default value: false.', example='true'),
  env?: [
    RLJobAgentServiceEnvVar
  ](name='Env', description='The list of name-value environment variables for AgentService. You cannot overwrite platform-reserved variables. The GetRLJob operation returns an asterisk (*) for the values of E2B_API_KEY and platform-specified credentials, and keeps other values unchanged. Automatic masking is not guaranteed for all custom sensitive values.'),
}

model RLJobAgentServiceEnvVar {
  name?: string(name='Name', description='The name of the environment variable, which must be non-empty and unique within the list.

This parameter is required.', example='E2B_DOMAIN'),
  value?: string(name='Value', description='The value of the environment variable.', example='example.com'),
}

model RLJobCheckpointConfig {
  path?: string(name='Path', description='工作容器内的绝对路径，必须位于可读写的数据源挂载目录内。

This parameter is required.', example='/mnt/output'),
  saveIntervalSteps?: int32(name='SaveIntervalSteps', description='Checkpoint 保存间隔。-1 表示关闭，正整数表示每 N 个训练步保存', example='10'),
}

model RLJobDataSourceConfig {
  accessPointId?: string(name='AccessPointId', description='The AI computing CPFS access point ID.', example='ap-example'),
  dataSourceId?: string(name='DataSourceId', description='The datasource ID. You must specify one of DataSourceId, Uri, or ModelId.', example='d-gx8xxxxx'),
  dataSourceVersion?: string(name='DataSourceVersion', description='The datasource version.', example='v1'),
  enableCache?: boolean(name='EnableCache', description='Specifies whether to enable data caching.', example='false'),
  modelId?: string(name='ModelId', description='The ModelGallery model ID to mount. The latest version of the model that you have access to is used. You must specify one of DataSourceId, Uri, or ModelId. Model mounting supports read-only access only.', example='model-v63llpfh7u824imbni'),
  mountAccess?: string(name='MountAccess', description='The mount access mode.', example='RO'),
  mountPath?: string(name='MountPath', description='The absolute mount path in the worker container. This parameter is required for RLJob datasources.

This parameter is required.', example='/mnt/input'),
  options?: string(name='Options', description='The extended datasource configuration.', example='{}'),
  roleArn?: string(name='RoleArn', description='The ARN of the RAM role used to access the datasource.', example='acs:ram::1872xxxxxxxxx:role/account-pai-prod'),
  roleChain?: string(name='RoleChain', description='The JSON string of the role chain used to access the datasource.', example='[]'),
  uri?: string(name='Uri', description='The datasource URI. You must specify one of DataSourceId, Uri, or ModelId.', example='oss://example-bucket/data/'),
}

model RLJobDatasetConfig {
  name?: string(name='Name', description='数据集名称，在 Datasets 列表内唯一

This parameter is required.', example='gsm8k'),
  path?: string(name='Path', description='工作容器内的数据集绝对路径；可指向目录或文件，可位于 DataSources 挂载目录内，也可由镜像预置

This parameter is required.', example='/mnt/input/gsm8k'),
}

model RLJobItem {
  algorithm?: string(name='Algorithm', description='The algorithm.', example='grpo'),
  displayName?: string(name='DisplayName', description='The display name.', example='swebench-lite-grpo-qwen27b'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The creation time in UTC RFC 3339 format.', example='2026-09-08T07:00:00Z'),
  gmtFinishTime?: string(name='GmtFinishTime', description='The end time in the UTC RFC 3339 format. This is consistent with the DLC GetJob operation. The job end time is used first. If the job end time is missing, the stop time is used. If both are missing, this field is not returned. The same value rule applies to sorting.', example='2026-09-08T09:30:00Z'),
  gmtRunningTime?: string(name='GmtRunningTime', description='The start time in UTC RFC 3339 format.', example='2026-09-08T07:05:00Z'),
  jobId?: string(name='JobId', description='The RLJob ID. This field is required and always returned.', example='dlc5yfk7eyg95lac'),
  jobType?: string(name='JobType', description='The job type. Valid value: Train.', example='Train'),
  models?: [
    RLJobModelConfig
  ](name='Models', description='The model names and in-container paths associated with the job.'),
  reasonCode?: string(name='ReasonCode', description='The reason code. This is an independent field and must not be parsed from the ReasonMessage text.', example='JobStoppedByUser'),
  reasonMessage?: string(name='ReasonMessage', description='The reason description.', example='Job is stopped by user.'),
  resourceId?: string(name='ResourceId', description='The job-level resource group or quota ID persisted in the current job record. This is consistent with DLC GetJob and GetRLJob, and is not the original request value. It is returned from the job record even if the execution snapshot is unreadable.', example='dlc-quota'),
  settings?: RLJobSettings(name='Settings', description='The job configuration summary. Uses a supported subset of DLC JobSettings fields. The list returns only the current job tags in Settings.Tags. For the complete configuration, call GetRLJob.', example='{"Tags":{"rls.scene":"code-rl"}}'),
  status?: string(name='Status', description='The job status. Uses the same vocabulary as DLC ValidJobStatus: Creating, Queuing, Running, Stopping, Succeeded, Failed, or Stopped.', example='Running'),
  subStatus?: string(name='SubStatus', description='The substatus. Examples include Evaluating, WritingResults, EarlyStopped, Validating, Deleting, and Archived.', example='Evaluating'),
  trainerMode?: string(name='TrainerMode', description='The training and sampling execution mode that takes effect for the job. Valid values: ColocateSync and DisaggregateAsync.', example='ColocateSync'),
  userId?: string(name='UserId', description='The ID of the user who submitted the job. This has the same meaning as UserId in DLC.', example='123456789'),
  workspaceId?: string(name='WorkspaceId', description='The workspace ID.', example='ws-20210126170216-mtl37ge7gkvdz'),
}

model RLJobModelConfig {
  name?: string(name='Name', description='The model name, which must be unique within the Models list.

This parameter is required.', example='actor'),
  path?: string(name='Path', description='The absolute path of the model in the working container. It can be located in a DataSources mount directory or preset in the image.

This parameter is required.', example='/mnt/input/models/qwen'),
}

model RLJobObservabilityConfig {
  rayDashboardEnabled?: boolean(name='RayDashboardEnabled', description='是否开启 Ray Dashboard 入口。Ray 后端缺省 true，Monarch 后端缺省 false；Monarch 不接受 true', example='true'),
  xfuseEnabled?: boolean(name='XfuseEnabled', description='是否启用训练观测数据采集，默认 true。', example='true'),
}

model RLJobSettings {
  advancedSettings?: map[string]any(name='AdvancedSettings', description='沿用 DLC 的高级设置键值约定；运行时值须为字符串且键不能为空，具体选项是否生效取决于运行环境支持。', example='{"EnableDinD":"true"}'),
  businessUserId?: string(name='BusinessUserId', description='作业关联用户 ID，沿用 DLC 的受信调用方规则。', example='166924'),
  caller?: string(name='Caller', description='调用方标识，与 DLC Settings.Caller 一致。', example='pai-cli'),
  enableRDMA?: boolean(name='EnableRDMA', description='沿用 DLC 的 RDMA 配置，是否生效取决于配额和运行环境。', example='true'),
  pipelineId?: string(name='PipelineId', description='工作流 ID，与 DLC Settings.PipelineId 一致。', example='pid-123456'),
  tags?: map[string]string(name='Tags', description='DLC 作业标签，场景使用 rls.scene。', example='{"rls.scene":"code-rl"}'),
}

model RLJobSpec {
  image?: string(name='Image', description='接受 tag 或 sha256 摘要。未指定配方且已提供所需资源池时，可省略镜像并使用平台为该资源池配置的默认镜像；无唯一默认镜像时须显式指定。', example='registry.example.com/rls/verl@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  podCount?: int32(name='PodCount', description='该资源条目的工作节点数量，默认 1，必须为正整数；不包括平台管理的辅助节点。', example='1'),
  quotaId?: string(name='QuotaId', description='资源池配额 ID；省略时使用作业级 ResourceId。不同资源池可指定不同配额；使用多个配额时每个池必须显式指定，train 池的配额为作业主配额。各配额均须已在作业工作空间授权且属于同一 VPC', example='quotag2uo09dyp40'),
  resourceConfig?: ResourceConfig(name='ResourceConfig', description='每个 Pod 的资源规格，所有值均为字符串。CPU、Memory 必须为正值；GPU 省略时为 CPU 资源池，提供时必须为正整数。GPUType 可省略，并可从已解析的作业或配额信息中确定；若配额存在多种 GPU 类型且尚未确定目标类型，必须显式指定。SharedMemory 可选。最终资源组合还须满足所选框架、入口与 TrainerMode 的拓扑约束。

This parameter is required.'),
  type?: string(name='Type', description='资源角色，必填，使用小写 train 或 rollout，在 JobSpecs 内唯一。文档中的 rollout/train 表示二选一，不是可直接提交的字面值

This parameter is required.', example='train'),
}

model RLLogContextLine {
  message?: string(name='Message', description='The log text (<= 2000 characters, with ANSI escape codes stripped).', example='CUDA out of memory. Tried to allocate 2.00 GiB'),
  timestampMs?: long(name='TimestampMs', description='The millisecond timestamp of the log line.', example='1787293208012'),
}

model RLMetricPoint {
  gmtTime?: string(name='GmtTime', description='UTC RFC3339，秒精度；聚合桶使用最后一个有效源点的时间，不表示极值发生时间', example='2026-09-10T06:00:00Z'),
  sampleCount?: long(name='SampleCount', description='去重且排除非有限值后的有效源点数，正整数；仅聚合桶返回', example='3'),
  startStep?: long(name='StartStep', description='桶内有效点的最小步数，包含；仅聚合桶返回', example='1'),
  step?: long(name='Step', description='非负框架步数，0 有效；聚合桶使用最后一个有效源点的步数', example='1'),
  value?: double(name='Value', description='原始有限数值或桶聚合结果。非有限点省略；缺失区间不补点或填 0', example='0.012'),
}

model RLMetricScalar {
  gmtTime?: string(name='GmtTime', description='该标量的源事件时间，UTC RFC3339，秒精度', example='2026-09-10T06:00:00Z'),
  metricName?: string(name='MetricName', description='精确且区分大小写的原生指标键', example='actor/ppo_kl'),
  step?: long(name='Step', description='该指标在生效日志窗口内最高已观测步数，0 有效；稀疏指标的步数可以不同', example='5'),
  value?: double(name='Value', description='最新已观测值；空值或非有限值为 null，不回退到较早有限值，也不填 0。完整读取时为 Available，空值本身不产生原因码；查询受限或记录损坏时仍为 Partial', example='0.012', nullable=true),
}

model RLMetricSeries {
  aggregation?: string(name='Aggregation', description='生效聚合策略，即使未降采样也返回', example='Last'),
  downsampled?: boolean(name='Downsampled', description='是否为满足点数上限进行了等宽步数分桶', example='false'),
  metricName?: string(name='MetricName', description='本次查询的精确指标键', example='actor/ppo_kl'),
  points?: [
    RLMetricPoint
  ](name='Points', description='按步数升序排列的有限数据点或聚合桶，同一步数取最新源事件。没有有限点时返回 []，不返回 null', example='[{"Step":1,"GmtTime":"2026-09-10T06:00:00Z","Value":0.012}]'),
}

model RLProgressBuffer {
  consumed?: int32(name='Consumed', description='The total number of consumed samples in unfinished buffers.', example='0'),
  detail?: [
    RLProgressBufferDetail
  ](name='Detail', description='The buffer details split by tag.', example='[{"Tag":1,"Ready":500,"Consumed":0,"Finished":500,"Total":512}]'),
  etaSec?: long(name='EtaSec', description='The estimated number of seconds remaining to fill the buffer.', example='0'),
  fillRatePerMin?: double(name='FillRatePerMin', description='The fill rate in entries per minute, estimated by using the rollout completion rate as a proxy.', example='120.5'),
  finished?: int32(name='Finished', description='The total number of finished samples in unfinished buffers.', example='500'),
  pct?: double(name='Pct', description='The completion percentage of the finished count relative to the target count, up to 100%. This value is provided when the target count is greater than 0. This value is not equivalent to the proportion of currently available samples indicated by the ready count.', example='100'),
  ready?: int32(name='Ready', description='The total number of ready samples in unfinished buffers.', example='500'),
  target?: int32(name='Target', description='The total number of target samples in unfinished buffers.', example='512'),
  trainBatchSize?: int32(name='TrainBatchSize', description='The configured training batch size.', example='512'),
  training?: boolean(name='Training', description='Indicates whether the consumed count is greater than 0, which means that batches have been fetched and the trainer is updating.', example='true'),
}

model RLProgressBufferDetail {
  consumed?: int32(name='Consumed', description='The number of samples consumed by the trainer.', example='0'),
  finished?: int32(name='Finished', description='The number of finished samples.', example='500'),
  ready?: int32(name='Ready', description='The number of ready samples.', example='500'),
  tag?: int32(name='Tag', description='The buffer tag, which is the global batch ordinal number.', example='1'),
  total?: int32(name='Total', description='The target number of samples.', example='3'),
}

model RLProgressConfig {
  numMinibatches?: int32(name='NumMinibatches', description='The number of mini-batches per step.', example='4'),
  ppoMiniBatchSize?: int32(name='PpoMiniBatchSize', description='The PPO mini-batch size.', example='128'),
  rolloutN?: int32(name='RolloutN', description='The number of rollouts per prompt.', example='8'),
  totalSteps?: int32(name='TotalSteps', description='The total number of training steps.', example='3'),
  trainBatchSize?: int32(name='TrainBatchSize', description='The training batch size.', example='512'),
}

model RLProgressEval {
  done?: boolean(name='Done', description='Indicates whether Total is greater than 0 and Finished is not less than Total.', example='true'),
  finished?: int32(name='Finished', description='The number of finished samples.', example='500'),
  pct?: double(name='Pct', description='The progress percentage, which is the ratio of Progress to Total.', example='100'),
  progress?: int32(name='Progress', description='The progress count, which is the greater value of Ready and Finished.', example='500'),
  ready?: int32(name='Ready', description='The number of ready samples.', example='500'),
  total?: int32(name='Total', description='The target number of samples.', example='3'),
}

model RLProgressFatal {
  collectNs?: string(name='CollectNs', description='Raw log collection time in the form of a nanosecond timestamp string, used to help locate raw log context. Pass this value as is when calling raw log context API to avoid precision loss caused by numeric conversion. This value does not guarantee an exact match with the original log.', example='1787474487713456789'),
  message?: string(name='Message', description='The error message, truncated to 500 characters.', example='CUDA out of memory. Tried to allocate 2.00 GiB'),
  rawMessage?: string(name='RawMessage', description='The raw log line, truncated to 2000 characters. It is passed as AnchorMessage when calling GetRLLogContext.', example='[rank0]: torch.OutOfMemoryError: CUDA out of memory. Tried to allocate 2.00 GiB'),
  subsecNs?: long(name='SubsecNs', description='The nanosecond offset within the same second, used for sorting logs within the same second.', example='123456789'),
  time?: long(name='Time', description='The log time in UNIX seconds.', example='1787474487'),
}

model RLProgressMicro {
  current?: int32(name='Current', description='The current micro-batch ordinal number.', example='3'),
  total?: int32(name='Total', description='The micro-batch total count.', example='3'),
}

model RLProgressProcessed {
  done?: int32(name='Done', description='The processed count.', example='true'),
  total?: int32(name='Total', description='The total count.', example='3'),
}

model RLProgressRollout {
  finished?: int32(name='Finished', description='The total number of completed items within the window.', example='500'),
  processed?: RLProgressProcessed(name='Processed', description='The rollout processed count.', nullable=true),
  ratePerMin?: double(name='RatePerMin', description='The completion rate (items per minute), estimated from the last 120 completion events.', example='31.2'),
}

model RLProgressSlow {
  details?: [
    RLProgressSlowDetail
  ](name='Details', description='The slow inference details, up to 20 entries.', example='[{"Elapsed":42.5,"Time":1787474487,"Message":"rollout generation slow","Rank":0,"Pod":"dlc193cpaitk8eny-master-0","WorkerPid":12345,"Ip":"192.168.0.12","Rid":"req-8f3a2c1d","TokenizerPid":"12360","Ipc":"ipc://worker-0","IsPause":"false","StatePresent":"true","OutQueue":"3"}]'),
  elapsed?: double(name='Elapsed', description='The elapsed time of the slowest entry in seconds.', example='42.5'),
  time?: long(name='Time', description='The log timestamp of the slowest entry in UNIX seconds.', example='1787474487'),
}

model RLProgressSlowDetail {
  elapsed?: double(name='Elapsed', description='The elapsed time of the request, in seconds.', example='42.5'),
  ip?: string(name='Ip', description='worker IP', example='192.168.0.12'),
  ipc?: string(name='Ipc', description='The IPC channel identifier, which corresponds to the ipc field in the log.', example='ipc://worker-0'),
  isPause?: string(name='IsPause', description='Indicates whether the request is paused. This is the raw value of the is_pause field in the log.', example='false'),
  message?: string(name='Message', description='The log message, truncated to 700 characters.', example='CUDA out of memory. Tried to allocate 2.00 GiB'),
  outQueue?: string(name='OutQueue', description='The output queue length. This is the raw value of the out_queue field in the log.', example='3'),
  pod?: string(name='Pod', description='The name of the pod.', example='dlc193cpaitk8eny-master-0'),
  rank?: int32(name='Rank', description='The training rank.', example='0'),
  rid?: string(name='Rid', description='The inference request ID, which corresponds to the rid field in the log.', example='req-8f3a2c1d'),
  statePresent?: string(name='StatePresent', description='Indicates whether the state is present. This is the raw value of the state_present field in the log.', example='true'),
  time?: long(name='Time', description='The log time, in UNIX seconds.', example='1787474487'),
  tokenizerPid?: string(name='TokenizerPid', description='The tokenizer process ID, which corresponds to the pid field in the log.', example='12360'),
  workerPid?: int32(name='WorkerPid', description='The worker process ID.', example='12345'),
}

model RLProgressStage {
  duration?: double(name='Duration', description='The duration of the stage in seconds, with three decimal places. A step often falls entirely within the same second, so the value is not rounded to an integer.', example='0.483'),
  endTime?: long(name='EndTime', description='The end time of the stage in UNIX seconds.', example='1787474487'),
  key?: string(name='Key', description='The stage identifier.', example='traj'),
  label?: string(name='Label', description='The Chinese name of the stage.', example='Generate trace'),
  marker?: string(name='Marker', description='The log marker text used to match the stage.', example='start/end generation'),
  optional?: boolean(name='Optional', description='Specifies whether the stage is optional. If an optional stage does not occur, its status is recorded as skipped.', example='false'),
  startTime?: long(name='StartTime', description='The start time of the stage in UNIX seconds.', example='1787474487'),
  status?: string(name='Status', description='done / running / waiting / pending / skipped', example='done'),
}

model RLProgressStages {
  currentIndex?: int32(name='CurrentIndex', description='The index of the current stage.', example='6'),
  mode?: string(name='Mode', description='The disagg, colocate, or empty string.', example='colocate'),
  stages?: [
    RLProgressStage
  ](name='Stages', description='The list of stages in pipeline order.', example='[{"Key":"generation","Label":"Generation","Marker":"start/end generation","Optional":false,"Status":"done","StartTime":1787474487,"EndTime":1787474487,"Duration":0.483}]'),
  stepDone?: boolean(name='StepDone', description='Indicates whether the stage pipeline for this step is completed.', example='false'),
}

model RLProgressStep {
  current?: int32(name='Current', description='The current step.', example='3'),
  etaSec?: long(name='EtaSec', description='The estimated time remaining, in seconds. This value is not provided when it cannot be estimated. A value of 0 may be returned when the training is confirmed to be complete, even if PaceSec is not provided.', example='0'),
  paceSec?: double(name='PaceSec', description='The average time per step over the recent step progress, in seconds. This value is not provided when there is insufficient information.', example='14'),
  pct?: double(name='Pct', description='The training progress percentage. A value of 100% may be returned for confirmed completed progress, where Current may be less than Total. Do not determine whether the training is complete based solely on the current step number.', example='100'),
  time?: long(name='Time', description='The timestamp of the latest step (in UNIX seconds).', example='1787474487'),
  total?: int32(name='Total', description='The total number of steps (retrieved from the configuration dump).', example='3'),
}

model RLProgressSync {
  cost?: double(name='Cost', description='The parameter synchronization duration in seconds. This property has a value only when State is end.', example='1.5'),
  state?: string(name='State', description='begin / end', example='end'),
}

model RLProgressTrainer {
  micro?: RLProgressMicro(name='Micro', description='The micro-batch progress.', nullable=true),
  miniIdx?: int32(name='MiniIdx', description='The current mini-batch index.', example='1'),
  numMinibatches?: int32(name='NumMinibatches', description='The total number of mini-batches.', example='4'),
  sync?: RLProgressSync(name='Sync', description='The parameter synchronization status.', nullable=true),
}

model RLSample {
  latestDetail?: string(name='LatestDetail', description='The detail of the latest event.', example='actor_parameters_updated'),
  latestStage?: string(name='LatestStage', description='The stage of the latest event.', example='TRAIN_UPDATE'),
  latestStatus?: string(name='LatestStatus', description='The latest sample_status.', example='COMPLETE'),
  latestTimestampMs?: long(name='LatestTimestampMs', description='The millisecond timestamp of the latest event.', example='1787293215480'),
  promptUid?: string(name='PromptUid', description='The sample UID.', example='321fa56f-e1e5-4eb3-8047-db7a230c9a75'),
  sampleIndex?: string(name='SampleIndex', description='The trajectory ordinal number (numeric string).', example='2'),
  terminalState?: string(name='TerminalState', description='The desired state. Valid values: trained (training completed) and empty string (in progress). The current frame does not perform oversampling, so discarded and cancelled do not occur.', example='trained'),
  traceCount?: long(name='TraceCount', description='The number of trace rows for the trajectory, including B/C type allocations.', example='10'),
}

model RLSampleEvent {
  detail?: string(name='Detail', description='The supplementary information for the event. The specific content depends on the event type.', example='uid_generated'),
  from?: string(name='From', description='The source component or execution stage of the event.', example='DataLoader'),
  globalStep?: string(name='GlobalStep', description='The decimal string of the training step. An empty string is used when the corresponding information is not collected.', example='12'),
  stage?: string(name='Stage', description='The training or sampling stage to which the event belongs.', example='DATA_PREPROCESS'),
  timestampMs?: long(name='TimestampMs', description='The millisecond timestamp.', example='1787293208012'),
  to?: string(name='To', description='The destination component or execution action of the event.', example='Trainer'),
}

model RLTrajectory {
  latestTimestampMs?: long(name='LatestTimestampMs', description='The latest event millisecond UNIX timestamp.', example='1787293215480'),
  sampleIndex?: string(name='SampleIndex', description='The trajectory ordinal number.', example='2'),
  terminalState?: string(name='TerminalState', description='The desired state. Valid values:
- trained: Training is complete.
- Empty string: In progress.

The current frame does not perform oversampling, so discarded and cancelled do not occur.', example='trained'),
  traceCount?: long(name='TraceCount', description='The number of trace rows.', example='10'),
}

model RecipeEvalDetail {
  command?: string(name='Command', description='The evaluation startup command in argv format. This parameter is optional. If left empty, the template does not specify a command, and the caller must provide it when creating the job. The string-type pai.entrypoint parameter at the parameter level takes precedence over this field. In this case, the command is stored but does not take effect.', example='python -m verl.trainer.main_ppo val_only=true'),
  envs?: map[string]string(name='Envs', description='The template environment variables, in the format of map<string,string>. Evaluation jobs use the values from this child table, which are independent of the training child table because the images on both sides are different. When creating a job, these variables are merged with the environment variables in the request by key. If a key exists in both, the value in the request takes precedence. Do not include credentials. Names starting with _PAI_PRIVATE_ENV_ are rejected.', example='{"PYTHONPATH":"/opt/eval/verl"}'),
  image?: string(name='Image', description='The evaluation image. This parameter is optional. If left empty, the template does not specify an image, and the caller must provide it when creating the job. If specified, the value must be pinned to a SHA-256 digest in the format of name@sha256:<64-character hexadecimal string> or an explicit tag in the format of name:tag. Bare image names with an implicit :latest tag are rejected.', example='registry.example.com/rls/verl@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  isDefaultDetail?: boolean(name='IsDefaultDetail', description='Only platform callers can set this parameter to true, and they must still pass Resource Access Management (RAM) authentication for the current workspace ID. Defaults published by custom recipes are limited to their workspaces. Defaults published by official preset recipes are not bound to a user workspace and serve as a public official fallback. The inheritance mechanism first checks the default of the current workspace and then falls back to the public official default. If set to false, the record is a normal detail and does not participate in default inheritance. However, it can still be referenced by ID after passing the read authentication of the source recipe. Details in other empty workspaces are not automatically made public.', example='false'),
  model?: string(name='Model', description='The name of the model to which the child table belongs. If left empty, the model of the main row is inherited.', example='qwen'),
  paramsJson?: map[string]any(name='ParamsJson', description='The framework default parameter layer, which is a raw JSON object. As the default value layer, reserved key validation is not performed during creation. If specified, the value must be valid JSON.', example='{"data.val_files":["/mnt/input/gsm8k/test.parquet"]}'),
  renderer?: string(name='Renderer', description='The configuration renderer. Valid values: hydra. In the first phase, only hydra is implemented. If left empty, the default value is used.', example='hydra'),
  resource?: RecipeResource(name='Resource', description='The inline resource pool. This parameter and ResourceId are mutually exclusive. The inline resource must be of the eval type. When referencing an existing pool, the workspace scope and read permissions of the source recipe must be met.'),
  resourceId?: long(name='ResourceId', description='The ID of the existing evaluation resource pool row to reference. This parameter and Resource are mutually exclusive. If the specified row does not exist, the Recipe.InvalidParameter (400) error is returned, and the original resource type validation is retained. The row must be reachable from the source recipe of the current tenant and workspace or a public official source recipe. It must also pass the current paidlc:CreateRecipe and source paidlc:GetRecipe authentication. Any readable source for the same row is sufficient, and SourceRecipeId is not required.', example='1002'),
  runtimeMinutes?: int32(name='RuntimeMinutes', description='The estimated runtime in minutes. The value must be greater than or equal to 0. A value of 0 or the default value indicates that the template does not specify a runtime, and no upper limit is set for the job runtime. The platform does not provide a default value.', example='30'),
}

model RecipeEvalDetailView {
  command?: string(name='Command', description='The startup command for the evaluation.', example='python -m verl.trainer.main_ppo val_only=true'),
  detailId?: long(name='DetailId', description='The ID of the evaluation child table row, which is always the specifically parsed row.', example='3001'),
  envs?: map[string]string(name='Envs', description='The template environment variables of the evaluation child table. The data type is map<string,string>. The values are fully echoed without masking. Therefore, credentials must not be stored in the template. Jobs with Mode=Eval use the values from this child table, which are independent of the training child table.', example='{"PYTHONPATH":"/opt/eval/verl"}'),
  image?: string(name='Image', description='The evaluation image with a fixed digest.', example='registry.example.com/rls/verl@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  isDefaultDetail?: boolean(name='IsDefaultDetail', description='Indicates whether the child table is explicitly published by the platform as a shared default evaluation child table. The parsing process first checks the default of the current workspace and then falls back to the public default officially preset and published. A value of false indicates a private detail. Details in other empty workspaces are not automatically used as the public default. Inheritance still requires Resource Access Management (RAM) permissions for the current workspace.', example='false'),
  model?: string(name='Model', description='The name of the model to which the child table belongs.', example='qwen'),
  paramsJson?: map[string]any(name='ParamsJson', description='The framework default parameter layer, which echoes the original JSON object.', example='{"data.val_files":["/mnt/input/gsm8k/test.parquet"]}'),
  renderer?: string(name='Renderer', description='The configuration renderer. Valid values: hydra.', example='hydra'),
  resource?: RecipeResourceView(name='Resource', description='The parsed evaluation resource pool.'),
  runtimeMinutes?: int32(name='RuntimeMinutes', description='The estimated runtime in minutes. A value of 0 indicates that the template does not specify a limit, and no upper limit is set for the job runtime.', example='30'),
}

model RecipeResource {
  resourceType?: string(name='ResourceType', description='The resource pool type. Valid values: train, eval, and inference. If left empty, the storage layer uses the default value based on the associated slot. For training child tables, TrainResource must be set to train and InferenceResource must be set to inference. For evaluation child tables, the resource must be set to eval. Cross-type sharing is not allowed.', example='train'),
  specs?: [
    RecipeSpec
  ](name='Specs', description='The JSON array of resource specifications. It uses the CustomJob resource shape (flat pod_count, ecs_spec, cpu, memory, gpu, gpu_type, shared_memory, and quota_id). It is required and passed through as-is. Currently, the path that starts an RLJob from a Recipe only consumes a single train specification and a single quota, and does not support ecs_spec. Support for multiple specifications, multiple quotas, and ecs_spec will be available when the RLJob side enables these features.

This parameter is required.', example='[{"PodCount":1,"CPU":"4","Memory":"8Gi","GPU":"1","GPUType":"A100","QuotaId":"quotag2uo09dyp40"}]'),
}

model RecipeResourceView {
  resourceId?: long(name='ResourceId', description='资源池行 ID', example='1001'),
  resourceType?: string(name='ResourceType', description='资源池类型，取值：train / eval', example='train'),
  specs?: [
    RecipeSpec
  ](name='Specs', description='资源规格列表，采用 CustomJob 资源形状（与入参 open_struct_RecipeSpec 同构），回显存储值', example='[{"PodCount":1,"CPU":"4","Memory":"8Gi","GPU":"1","GPUType":"A100","QuotaId":"quotag2uo09dyp40"}]'),
}

model RecipeSpec {
  CPU?: string(name='CPU', description='The CPU specification of a single pod, represented as a Kubernetes quantity string such as "4".', example='4'),
  ecsSpec?: string(name='EcsSpec', description='The name of the ECS instance specification. This field is not supported when starting an RLJob. Omit this field. A non-empty value returns Recipe.InvalidParameter. The example only illustrates the name format.', example='ecs.gn7i-c8g1.2xlarge'),
  GPU?: string(name='GPU', description='The number of GPUs for a single pod, such as "1".', example='1'),
  GPUType?: string(name='GPUType', description='The GPU type, such as "A100". You can obtain the supported values from the existing quota or specification API.', example='A100'),
  memory?: string(name='Memory', description='The memory specification of a single pod, represented as a Kubernetes quantity string such as "8Gi". This refers to the host memory rather than the GPU memory.', example='8Gi'),
  podCount?: int32(name='PodCount', description='The number of pods for the entry. The default value is 1. This parameter takes effect only when the value is greater than 0. Otherwise, the downstream RLJob uses the default value of 1.', example='1'),
  quotaId?: string(name='QuotaId', description='The quota ID. The current RLJob startup path requires a single quota. Multiple quotas are not supported.', example='quotag2uo09dyp40'),
  sharedMemory?: string(name='SharedMemory', description='The shared memory specification of a single pod, represented as a Kubernetes quantity string such as "4Gi".', example='4Gi'),
}

model RecipeSummary {
  algorithmLabel?: [ string ](name='AlgorithmLabel', description='The list of algorithm labels.', example='["grpo"]'),
  creator?: string(name='Creator', description='The user ID of the creator. This field is used for auditing and Owner=mine filtering, and is not used as a basis for permissions.', example='123456789'),
  description?: string(name='Description', description='The recipe description.', example='GRPO training recipe for Qwen2.5-7B-Instruct'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The creation time in UTC RFC 3339 format.', example='2026-09-08T07:00:00Z'),
  gmtModifyTime?: string(name='GmtModifyTime', description='The modification time in UTC RFC 3339 format.', example='2026-09-08T09:30:00Z'),
  isDefaultRecipe?: boolean(name='IsDefaultRecipe', description='The default recipe indicator for the model. The list can return both the default recipe for the current workspace and the public official default recipe. Job parsing prioritizes the default recipe of the current workspace and falls back to the public official default if no match is found. All read operations still require RAM authentication in the current workspace. Other records with empty workspaces are not exposed simply because they have the default indicator.', example='false'),
  model?: string(name='Model', description='The name of the associated model.', example='qwen'),
  name?: string(name='Name', description='The recipe name.', example='qwen-grpo'),
  ownerType?: string(name='OwnerType', description='The owner type derived from the source. A value of preset maps to platform, and custom maps to user. A recipe is considered a public official preset only when Source is preset, OwnerType is platform, and the persistent WorkspaceId is empty. The presence of OwnerType or an empty workspace alone is not sufficient to expose the record.', example='user'),
  recipeId?: string(name='RecipeId', description='The recipe ID. This field is always returned.', example='recipe-20260908-qwen-grpo'),
  recipeType?: [ string ](name='RecipeType', description='The list of recipe types. Valid values: train and eval. A value of ["train"] indicates training, ["eval"] indicates independent evaluation, and ["train","eval"] indicates both.', example='["train"]'),
  source?: string(name='Source', description='The source of the recipe. Valid values: preset (platform preset) and custom (user-created).', example='custom'),
  workspaceId?: string(name='WorkspaceId', description='The persistent workspace to which the recipe belongs. Returns the actual workspace ID for custom recipes and an empty string for public official preset recipes. A public official preset recipe must simultaneously meet the following conditions: Source is preset, OwnerType is platform, and WorkspaceId is empty. Other records with empty workspaces are not exposed. Access to official items requires the RAM permissions of the current request workspace.', example='ws-20210126170216-mtl37ge7gkvdz'),
}

model RecipeTrainDetail {
  command?: string(name='Command', description='The training startup command in argv format. This parameter is optional. If left empty, the template does not specify a command, and the command is provided by the pai.entrypoint of TrainingConfig or the string-type pai.entrypoint in TrainingParamsJson (module format) when the job is created. If all are missing, the job creation returns a 400 error with the message "configuration.pai.entrypoint: nonempty argv required". If specified, it serves as the source of the job\\"s pai.entrypoint. However, the string-type pai.entrypoint at the parameter level takes precedence (module format). In this case, the command is stored but does not take effect. Templates in module format should be left empty instead of filling in a placeholder command that is never executed.', example='python -m verl.trainer.main_ppo'),
  envs?: map[string]string(name='Envs', description='The template environment variables, represented as a map<string,string>. When a job is created, these variables are merged with the Envs in the request by key. If a key exists in both, the value in the request takes precedence. Credentials are prohibited. Names starting with _PAI_PRIVATE_ENV_ are rejected. Both the default value and an empty object indicate that the template does not set environment variables. Names reserved by the platform, such as HF_HOME, TMPDIR, and prefixes starting with RLS_, are not blocked during creation but are rejected during job creation.', example='{"PYTHONPATH":"/workspace/verl"}'),
  image?: string(name='Image', description='The training image. This parameter is optional. If left empty, the template does not specify an image, and the image is provided by JobSpecs[].Image when the job is created. If both are missing, the job creation returns a 400 error with the message "JobSpecs.Image: must not be blank". If specified, the image must be pinned to a sha256 digest (name@sha256:<64-character hexadecimal>) or an explicit tag (name:tag). Bare image names with an implicit :latest tag are rejected.', example='registry.example.com/rls/verl@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  inferenceImage?: string(name='InferenceImage', description='The inference rollout image. If specified, the image must be pinned to a sha256 digest (name@sha256:<64-character hexadecimal>) or an explicit tag (name:tag). This image is consumed only when TrainerMode is set to DisaggregateAsync to build the rollout pool. In other modes, it is stored but does not take effect.', example='registry.example.com/rls/sglang@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  inferenceParamsJson?: map[string]any(name='InferenceParamsJson', description='The default parameter layer for the inference framework, represented as a raw JSON object. It always participates in merging in all Train modes, although the rollout pool itself is built only in DisaggregateAsync mode. Keys with the same name override those in TrainingParamsJson, which is consistent with the priority of TrainingConfig < RolloutConfig on the request side. In other modes, it is stored but does not take effect.', example='{"actor_rollout_ref.rollout.name":"sglang","trainer.disaggregated.enable":true,"trainer.disaggregated.mode":"full","trainer.train_mode":"rl_training"}'),
  inferenceResource?: RecipeResource(name='InferenceResource', description='The inline resource pool for inference. You must specify either this parameter or InferenceResourceId. The resource must be of the inference type and is consumed only when TrainerMode is set to SeparateAsync. The specification shape is consistent with the training side, where the pod_count in Specs represents the number of rollout replicas. It must not contain a quota_id. The quota is provided by CreateRLJob.ResourceId. When referencing an existing pool, the workspace scope and read permissions of the source recipe must be met.'),
  inferenceResourceId?: long(name='InferenceResourceId', description='The ID of the row in an existing inference resource pool. You must specify either this parameter or InferenceResource. It is consumed only when TrainerMode is set to SeparateAsync. If the ID does not exist, a Recipe.InvalidParameter (400) error is returned, and the original resource type validation is maintained. The row must be reachable from the source recipe of the current tenant and workspace or a public official source recipe. It must also pass the current paidlc:CreateRecipe and source paidlc:GetRecipe authentication. Any readable source for the same row is sufficient, and SourceRecipeId is not required.', example='1002'),
  isDefaultDetail?: boolean(name='IsDefaultDetail', description='Specifies whether to publish the child table as the shared default training child table for the model. Only platform callers can set this parameter to true, and they must still pass the RAM authentication for the current WorkspaceId. Defaults published by custom recipes are limited to their workspaces. Defaults published by official preset recipes are not bound to user workspaces and serve as public official fallbacks. Inheritance first checks the default of the current workspace, and then falls back to the public official default. If set to false, the child table is a regular detail and does not participate in default inheritance, but can still be referenced by ID after passing the read authentication of the source recipe. Details in other empty workspaces are not automatically made public.', example='false'),
  model?: string(name='Model', description='The name of the model to which the child table belongs. If left empty, the model of the main row is inherited.', example='qwen'),
  renderer?: string(name='Renderer', description='The configuration renderer. Valid values: hydra. Only hydra is implemented in the first phase. If left empty, the default value is used.', example='hydra'),
  runtimeMinutes?: int32(name='RuntimeMinutes', description='The estimated runtime in minutes. The value must be greater than or equal to 0. Both 0 and the default value indicate that the template does not specify a runtime, and the job does not have a runtime limit. The platform does not provide a default value.', example='120'),
  saveIntervalStepsDefault?: int32(name='SaveIntervalStepsDefault', description='The default checkpoint save interval in steps. The value must be greater than or equal to -1. A value of -1 indicates that checkpoints are not saved.', example='10'),
  trainResource?: RecipeResource(name='TrainResource', description='The inline resource pool for training. You must specify either this parameter or TrainResourceId. The inline resource must be of the train type. When referencing an existing pool, the workspace scope and read permissions of the source recipe must be met.'),
  trainResourceId?: long(name='TrainResourceId', description='The ID of the row in an existing training resource pool. You must specify either this parameter or TrainResource. If the ID does not exist, a Recipe.InvalidParameter (400) error is returned, and the original resource type validation is maintained. The row must be reachable from the source recipe of the current tenant and workspace or a public official source recipe. It must also pass the current paidlc:CreateRecipe and source paidlc:GetRecipe authentication. Any readable source for the same row is sufficient, and SourceRecipeId is not required.', example='1001'),
  trainerMode?: string(name='TrainerMode', description='The training and inference execution mode. Valid values: ColocateSync and DisaggregateAsync. The legacy spellings Sync and ColocateAsync are normalized to ColocateSync, and SeparateAsync is normalized to DisaggregateAsync. For DisaggregateAsync, the rollout side is provided by InferenceImage and InferenceResource. This parameter is not mandatory when creating a template. If missing, the error is attributed to RecipeId or JobSpecs based on actionability during job creation. This parameter is specified by the caller and is not overridden by the platform.', example='ColocateSync'),
  trainingParamsJson?: map[string]any(name='TrainingParamsJson', description='The default parameter layer for the training framework, represented as a raw JSON object. It serves as the default value layer. Reserved key validation is not performed during creation. If specified, it must be a valid JSON object. If it does not contain the path and experiment name, the job creation request must include these keys.', example='{"algorithm.adv_estimator":"gae","data.train_files":["/mnt/input/gsm8k/train.parquet"]}'),
}

model RecipeTrainDetailView {
  command?: string(name='Command', description='The training start command.', example='python -m verl.trainer.main_ppo'),
  detailId?: long(name='DetailId', description='The ID of the training detail row, which is always the specifically resolved row.', example='2001'),
  envs?: map[string]string(name='Envs', description='The template environment variables of the training detail table, in map<string,string> format. Values are fully echoed without desensitization, so credentials must not be stored in the template. An empty value indicates that the template does not set environment variables. When creating a job, it is merged with the requested Envs by key, and the requested values take precedence for identical keys.', example='{"PYTHONPATH":"/workspace/verl"}'),
  image?: string(name='Image', description='The training image with a fixed digest.', example='registry.example.com/rls/verl@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  inferenceImage?: string(name='InferenceImage', description='The inference-side rollout image with a fixed digest. It is consumed by created jobs only when TrainerMode is set to SeparateAsync. An empty value indicates that the template does not provide an inference-side image.', example='registry.example.com/rls/sglang@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'),
  inferenceParamsJson?: map[string]any(name='InferenceParamsJson', description='The default parameter layer of the inference-side framework, which echoes the original JSON object. It participates in merging and overrides TrainingParamsJson only when TrainerMode is set to SeparateAsync. In other modes, it is echoed but does not take effect.', example='{"actor_rollout_ref.rollout.name":"sglang","trainer.disaggregated.enable":true}'),
  inferenceResource?: RecipeResourceView(name='InferenceResource', description='The resolved inference-side resource pool of the inference type. It is consumed by created jobs only when TrainerMode is set to SeparateAsync. An empty value indicates that the template does not provide inference-side resources.'),
  isDefaultDetail?: boolean(name='IsDefaultDetail', description='Specifies whether the detail table is explicitly published by the platform as a shared default training detail table. The resolution first checks the default of the current workspace, and then falls back to the public default published by official presets. A value of false indicates a private detail. Details in other empty workspaces are not automatically used as public defaults. Inheritance still requires RAM permissions for the current operating workspace.', example='false'),
  model?: string(name='Model', description='The name of the model to which the detail table belongs.', example='qwen'),
  renderer?: string(name='Renderer', description='The configuration renderer. Valid values: hydra.', example='hydra'),
  runtimeMinutes?: int32(name='RuntimeMinutes', description='The estimated runtime in minutes. A value of 0 indicates that the template does not specify a duration, and the job does not have a runtime limit.', example='120'),
  saveIntervalStepsDefault?: int32(name='SaveIntervalStepsDefault', description='The default checkpoint save interval in steps. A value of -1 indicates that checkpoints are not saved.', example='10'),
  trainResource?: RecipeResourceView(name='TrainResource', description='The resolved training-side resource pool.'),
  trainerMode?: string(name='TrainerMode', description='The training and inference execution mode. Valid values: Sync, ColocateAsync, and SeparateAsync.', example='Sync'),
  trainingParamsJson?: map[string]any(name='TrainingParamsJson', description='The default parameter layer of the training-side framework, which echoes the original JSON object.', example='{"algorithm.adv_estimator":"gae"}'),
}

model ResourceConfig {
  CPU?: string(name='CPU', description='The number of vCPUs.', example='10'),
  GPU?: string(name='GPU', description='The number of GPUs.', example='3'),
  GPUType?: string(name='GPUType', description='The GPU type.', example='Tesla-V100-16G'),
  memory?: string(name='Memory', description='The memory size.', example='10Gi'),
  sharedMemory?: string(name='SharedMemory', description='The shared memory capacity.', example='5Gi'),
}

model ResourceLimit {
