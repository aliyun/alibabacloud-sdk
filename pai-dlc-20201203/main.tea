  displayName?: string(name='DisplayName', description='The name of the template configuration item.', example='Pytorch Experiment Config'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The creation time in UTC.', example='2021-01-12T14:35:00Z'),
  gmtModifyTime?: string(name='GmtModifyTime', description='The modification time in UTC.', example='2021-01-12T14:36:00Z'),
}

