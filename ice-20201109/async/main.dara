model AddTemplateRequest {
  config?: string(name='Config', description='- The Config parameter for standard templates is an encapsulation based on the cloud editing timeline. Custom template configurations are more flexible. If you have special requirements, familiarize yourself with the Config structure and customize the template. For more information, see [Config details for standard templates](https://help.aliyun.com/document_detail/456193.html).
- For more Config examples, see [Common Config examples for standard templates](https://help.aliyun.com/document_detail/451634.html).
- For the Config settings of one-click video generation templates, see [Metric description for one-click video generation template configuration](https://help.aliyun.com/document_detail/2878274.html).', example='See Config documentation', position='Body'),
  coverUrl?: string(name='CoverUrl', description='The URL of the template cover.', example='http://example-bucket.oss-cn-shanghai.aliyuncs.com/cover.jpg', position='Query'),
  name?: string(name='Name', description='The name of the template.', example='TemplateName', position='Query'),
  previewMedia?: string(name='PreviewMedia', description='The media asset ID of the template preview video.', example='****01bf24bf41c78b2754cb3187****', position='Query'),
  relatedMediaids?: string(name='RelatedMediaids', description='The media assets associated with the template. This parameter is used by the standard template editor.', example='{"video":["1805a0c6ca544fb395a06ca683619655"]}', position='Query'),
  source?: string(name='Source', description='The source from which the template is created. Valid values:
- OpenAPI: Created by calling an API operation.
- AliyunConsole: Created in the Alibaba Cloud Management Console.
- WebSDK: Created by using WebSDK.', example='OpenAPI', position='Query'),
  status?: string(name='Status', description='The template status. Valid values:
- Available: Normal.
- Created: Created but unavailable.
- Uploading: Uploading.
- Processing: Analyzing the advanced template.
- UploadFailed: Upload failed.
- ProcessFailed: Advanced template analysis failed.', example='Available', position='Query'),
  type?: string(name='Type', description='The templatetype. Valid values:  
- Timeline: standard template. It is created based on the timeline of a video clip project, where multiple materials are spliced across multiple layers. It supports effects such as text-to-video, photo albums, intros and outros, and default watermarks.
- VETemplate: advanced template. It is created based on Adobe After Effects (AE) effects to achieve advanced media effects with complex motion graphics.
- BatchEditing: one-click video generation template. It supports parameters such as sticker watermarks, background music, background images, voiceover subtitle styles, title subtitle styles, and output resolution. These parameters are automatically applied when a one-click video generation node is committed.', example='Timeline', position='Query'),
}

