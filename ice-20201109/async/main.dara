/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'ICE';
  @version = '2020-11-09';
  @endpointRule = 'regional';
  @endpointMap = {
    'ap-northeast-1' = 'ice.aliyuncs.com',
    'ap-northeast-2-pop' = 'ice.aliyuncs.com',
    'ap-south-1' = 'ice.aliyuncs.com',
    'ap-southeast-1' = 'ice.aliyuncs.com',
    'ap-southeast-2' = 'ice.aliyuncs.com',
    'ap-southeast-3' = 'ice.aliyuncs.com',
    'ap-southeast-5' = 'ice.aliyuncs.com',
    'cn-beijing' = 'ice.aliyuncs.com',
    'cn-beijing-finance-1' = 'ice.aliyuncs.com',
    'cn-beijing-finance-pop' = 'ice.aliyuncs.com',
    'cn-beijing-gov-1' = 'ice.aliyuncs.com',
    'cn-beijing-nu16-b01' = 'ice.aliyuncs.com',
    'cn-chengdu' = 'ice.aliyuncs.com',
    'cn-edge-1' = 'ice.aliyuncs.com',
    'cn-fujian' = 'ice.aliyuncs.com',
    'cn-haidian-cm12-c01' = 'ice.aliyuncs.com',
    'cn-hangzhou' = 'ice.aliyuncs.com',
    'cn-hangzhou-bj-b01' = 'ice.aliyuncs.com',
    'cn-hangzhou-finance' = 'ice.aliyuncs.com',
    'cn-hangzhou-internal-prod-1' = 'ice.aliyuncs.com',
    'cn-hangzhou-internal-test-1' = 'ice.aliyuncs.com',
    'cn-hangzhou-internal-test-2' = 'ice.aliyuncs.com',
    'cn-hangzhou-internal-test-3' = 'ice.aliyuncs.com',
    'cn-hangzhou-test-306' = 'ice.aliyuncs.com',
    'cn-hongkong' = 'ice.aliyuncs.com',
    'cn-hongkong-finance-pop' = 'ice.aliyuncs.com',
    'cn-huhehaote' = 'ice.aliyuncs.com',
    'cn-huhehaote-nebula-1' = 'ice.aliyuncs.com',
    'cn-north-2-gov-1' = 'ice.aliyuncs.com',
    'cn-qingdao' = 'ice.aliyuncs.com',
    'cn-qingdao-nebula' = 'ice.aliyuncs.com',
    'cn-shanghai-et15-b01' = 'ice.aliyuncs.com',
    'cn-shanghai-et2-b01' = 'ice.aliyuncs.com',
    'cn-shanghai-finance-1' = 'ice.aliyuncs.com',
    'cn-shanghai-inner' = 'ice.aliyuncs.com',
    'cn-shanghai-internal-test-1' = 'ice.aliyuncs.com',
    'cn-shenzhen' = 'ice.aliyuncs.com',
    'cn-shenzhen-finance-1' = 'ice.aliyuncs.com',
    'cn-shenzhen-inner' = 'ice.aliyuncs.com',
    'cn-shenzhen-st4-d01' = 'ice.aliyuncs.com',
    'cn-shenzhen-su18-b01' = 'ice.aliyuncs.com',
    'cn-wuhan' = 'ice.aliyuncs.com',
    'cn-wulanchabu' = 'ice.aliyuncs.com',
    'cn-yushanfang' = 'ice.aliyuncs.com',
    'cn-zhangbei' = 'ice.aliyuncs.com',
    'cn-zhangbei-na61-b01' = 'ice.aliyuncs.com',
    'cn-zhangjiakou' = 'ice.aliyuncs.com',
    'cn-zhangjiakou-na62-a01' = 'ice.aliyuncs.com',
    'cn-zhengzhou-nebula-1' = 'ice.aliyuncs.com',
    'eu-central-1' = 'ice.aliyuncs.com',
    'eu-west-1' = 'ice.aliyuncs.com',
    'eu-west-1-oxs' = 'ice.aliyuncs.com',
    'me-east-1' = 'ice.aliyuncs.com',
    'rus-west-1-pop' = 'ice.aliyuncs.com',
    'us-east-1' = 'ice.aliyuncs.com',
    'us-west-1' = 'ice.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model AIAgentCallInfo {
  callDuration?: int32(name='CallDuration', description='The duration of the call, in seconds.', example='5'),
  callEndTime?: string(name='CallEndTime', description='The time the call ended, in ISO 8601 format.', example='2026-04-01T16:53:58.875932+00:00'),
  callStartTime?: string(name='CallStartTime', description='The time the call started, in ISO 8601 format.', example='2026-04-01T16:53:53.184797+00:00'),
  calleeNumber?: string(name='CalleeNumber', description='The number of the called party.', example='136******794'),
  callerNumber?: string(name='CallerNumber', description='The number of the calling party.', example='183*****333'),
  hangupRole?: int32(name='HangupRole', description='Indicates which party ended the call.
0: The agent ended the call.
1: The user ended the call.
2: The system ended the call for a transfer.', example='0'),
  status?: string(name='Status', description='The status of the call.', example='4'),
}

model AIAgentConfig {
  ambientSoundConfig?: {
    resourceId?: string(name='ResourceId', description='The ID of the call ambient sound. You can obtain the ID from the advanced settings of the agent configuration in the console.', example='f67901c595834************'),
    volume?: int32(name='Volume', description='The volume of the call background sound. Valid values: 0 to 100. A value of 0 indicates that the background sound is disabled.', example='50'),
  }(name='AmbientSoundConfig', description='The call ambient sound configuration.'),
  asrConfig?: {
    asrContext?: string(name='AsrContext', description='The ASR context enhancement.', example='[{"role":"user","content":[{"type":"input_text","text":"Alibaba Cloud, Qwen, Qwen-Audio"}]},{"role":"assistant","content":[{"type":"text","text":"Okay, I will incorporate these terms into our conversation."}]}]'),
    asrHotWords?: [ string ](name='AsrHotWords', description='The ASR hotword list. The list supports a maximum of 128 hotwords.'),
    asrLanguageId?: string(name='AsrLanguageId', description='The ASR language ID. Valid values:
- zh_mandarin: Chinese.
- en: English.
- zh_en: Mixed Chinese and English.
- es: Spanish.
- jp: Japanese.', example='zh_mandarin'),
    asrMaxSilence?: int32(name='AsrMaxSilence', description='The threshold for speech segmentation detection. If the silence duration exceeds this threshold, the speech is considered segmented. Valid values: 200 to 1200. Unit: milliseconds. Default value: 400.', example='400'),
    asrVocabulary?: string(name='AsrVocabulary', description='The instance-level real-time hotwords and their weights for ASR.', example='{"Qwen":4,"Qwen-Audio":5,"Alibaba Cloud Speech Lab":50}'),
    customParams?: string(name='CustomParams', description='The pass-through parameters for custom ASR integration.', example='mode=fast&sample=16000&format=wav'),
    vadDuration?: int32(name='VadDuration', description='The minimum duration threshold for voice activity detection (VAD), which is used to control the sensitivity of interruptions. A value of 0 indicates that this feature is disabled. Valid values: 200 to 2000. Unit: milliseconds. Common values range from 200 to 500, which correspond to 1 to 4 words. Default value: null. If this parameter is left empty, this feature does not take effect.', example='300'),
    vadLevel?: int32(name='VadLevel', description='The interruption threshold parameter. Valid values: 0 to 11. Default value: 11.
- 0: Disables the VAD feature.
- 1 to 10: A larger value indicates that it is more difficult to trigger an interruption.
- 11: Significantly different from previous values. It causes less damage to the pre-processed conversation audio and provides stronger anti-interference capability.', example='11'),
  }(name='AsrConfig', description='The speech recognition configuration.'),
  autoSpeechConfig?: {
    llmPending?: {
      messages?: [ 
        {
          probability?: double(name='Probability', description='The selection probability of the prompt. Valid values: 0 to 1, which correspond to 0% to 100%.', example='0.5'),
          text?: string(name='Text', description='The text of the inquiry prompt. Maximum length: 100 characters.', example='Just a moment'),
        }
      ](name='Messages', description='The collection of inquiry prompts. A maximum of 10 prompts are supported. Each prompt can be up to 100 characters in length. The sum of probabilities must be 100%.'),
      mode?: string(name='Mode', description='The mode for selecting the soothing prompt from LlmPending.Messages to broadcast while waiting for the agent to reply. Valid values:
- ai_select: The AI selects the most appropriate prompt from Messages based on the current conversation. This mode does not check whether the sum of Probability values is 1, but WaitTime cannot be less than 800 milliseconds. This is the default value.
- probability: A prompt is randomly selected based on the Probability weight of each prompt. The sum of all Probability values must be exactly 1.0.', example='ai_select'),
      waitTime?: int32(name='WaitTime', description='The threshold for the waiting time for a response from the large language model (LLM). If the waiting time exceeds this threshold, a broadcast prompt is triggered. This parameter is required. Valid values: 500 to 10000. Unit: milliseconds. Set this parameter based on the actual usage of the LLM.', example='3000'),
    }(name='LlmPending', description='The broadcast configuration for LLM response delays.'),
    userIdle?: {
      hangupEndWord?: string(name='HangupEndWord', description='The hang-up closing remark. It is broadcast before the call is hung up after a prolonged period of user unresponsiveness. Maximum length: 200 characters.', example='I\\\\"m hanging up, bye'),
      maxRepeats?: int32(name='MaxRepeats', description='The maximum number of inquiries. Valid values: 0 to 10. This parameter is required. If the number of inquiries exceeds this value, no more inquiries are triggered and the call is directly closed.', example='5'),
      messages?: [ 
        {
          probability?: double(name='Probability', description='The selection probability of the prompt. Valid values: 0 to 1, which correspond to 0% to 100%.', example='0.5'),
          text?: string(name='Text', description='The text of the inquiry prompt. Maximum length: 100 characters.', example='Are you still there?'),
        }
      ](name='Messages', description='The collection of inquiry prompts. A maximum of 10 prompts are supported. Each prompt can be up to 100 characters in length. The sum of probabilities must be 100%.'),
      waitTime?: int32(name='WaitTime', description='The silence duration threshold. This parameter is required. If the silence duration exceeds this threshold, an inquiry is triggered. Valid values: 5000 to 600000. Unit: milliseconds.', example='5000'),
    }(name='UserIdle', description='The broadcast configuration for inquiries during prolonged user silence.'),
  }(name='AutoSpeechConfig', description='The automatic speech configuration module for the agent, which includes prompts for LLM response delays and inquiries during prolonged user silence.'),
  avatarConfig?: {
    avatarId?: string(name='AvatarId', description='The model ID of the digital human.', example='5257'),
    resolution?: string(name='Resolution', description='The resolution of the digital human video stream. The value must be in strictly lowercase letters and must be specified together with AvatarId. Valid values:
- 360p
- 480p
- 720p
- 1080p', example='1080p'),
    templateId?: string(name='TemplateId', description='The ID of the digital human template, which specifies the template used when the digital human is started. The template is provided by the digital human service provider, and the provider also verifies whether the specified value is valid.', example='tpl-9527'),
  }(name='AvatarConfig', description='The digital human configuration. This configuration takes effect only when the workflow includes a digital human node.'),
  avatarUrl?: string(name='AvatarUrl', description='The URL of the agent avatar for voice calls. Default value: none.', example='http://example.com/a.jpg'),
  avatarUrlType?: string(name='AvatarUrlType', description='The URL type of the agent avatar. Default value: none.', example='USER'),
  backChannelingConfig?: [ 
    {
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the backchanneling feature. This parameter is required. Valid values: true and false.', example='true'),
      probability?: double(name='Probability', description='The trigger probability of the feature. Valid values: 0.0 to 1.0. This parameter is required.', example='0.5'),
      triggerStage?: string(name='TriggerStage', description='The trigger stage for backchanneling. Valid values:
- pause_detected: A short pause in speech is detected.', example='pause_detected'),
      words?: [ 
        {
          probability?: double(name='Probability', description='The trigger probability of the phrase. Valid values: 0.0 to 1.0. This parameter is required.', example='0.3'),
          text?: string(name='Text', description='The text of the phrase. Maximum length: 20 characters. Multiple languages are supported. This parameter is required.', example='ok'),
        }
      ](name='Words', description='The collection of backchanneling phrases. A maximum of 10 phrases are supported. Each phrase can be up to 20 characters in length. The sum of probabilities must be 1.0.'),
    }
  ](name='BackChannelingConfig', description='**[Deprecated]** Use BackChannelingConfigs instead.', deprecated='true'),
  backChannelingConfigs?: [ 
    {
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the backchanneling feature. This parameter is required. Valid values: true and false.', example='true'),
      probability?: double(name='Probability', description='The trigger probability of the feature. Valid values: 0.0 to 1.0. This parameter is required.', example='0.5'),
      triggerStage?: string(name='TriggerStage', description='The trigger stage for backchanneling. Valid values:
- pause_detected: A short pause in speech is detected.', example='pause_detected'),
      words?: [ 
        {
          probability?: double(name='Probability', description='The trigger probability of the phrase. Valid values: 0.0 to 1.0. This parameter is required.', example='0.3'),
          text?: string(name='Text', description='The text of the phrase. Maximum length: 20 characters. Multiple languages are supported. This parameter is required.', example='ok'),
        }
      ](name='Words', description='The collection of backchanneling phrases. A maximum of 10 phrases are supported. Each phrase can be up to 20 characters in length. The sum of probabilities must be 1.0.'),
    }
  ](name='BackChannelingConfigs', description='The backchanneling feature configuration module. After this feature is enabled, the system randomly broadcasts short backchanneling phrases at specific trigger stages.'),
  enableIntelligentSegment?: boolean(name='EnableIntelligentSegment', description='Specifies whether to enable intelligent segmentation. After intelligent segmentation is enabled, segmented speech from the user is intelligently merged into a single sentence. Default value: true.', example='true'),
  enablePushToTalk?: boolean(name='EnablePushToTalk', description='Specifies whether to enable the push-to-talk mode. Default value: false.', example='false'),
  experimentalConfig?: string(name='ExperimentalConfig', description='The experimental feature parameters. Contact technical support if you have any requirements.', example='""'),
  gracefulShutdown?: boolean(name='GracefulShutdown', description='Specifies whether to enable graceful shutdown. Default value: false.
Graceful shutdown: When the agent is stopped, it finishes broadcasting the current speech before shutting down. The maximum broadcast duration is 10 seconds.', example='false'),
  greeting?: string(name='Greeting', description='The greeting. Modifications take effect the next time the user joins the call. Default value: none.', example='hello'),
  interruptConfig?: {
    enableVoiceInterrupt?: boolean(name='EnableVoiceInterrupt', description='Specifies whether to support speech interruption. Default value: true.', example='true'),
    interruptWords?: [ string ](name='InterruptWords', description='The list of specific words or phrases that trigger conversation interruption.'),
    keepInterruptWordsForLLM?: boolean(name='KeepInterruptWordsForLLM', description='Specifies whether to retain interrupt words when sending messages to the LLM. By default, interrupt words are discarded.
For example, if the interrupt word is "wait", the message "wait how is the weather today" is changed to "how is the weather today" after the interrupt word is discarded.', example='true'),
    noInterruptMode?: string(name='NoInterruptMode', description='The ASR processing policy in No Interrupting mode. Valid values:
- cache: Caches the ASR text. After the current turn ends, the cached ASR text is processed together in the next turn.
- discard: Directly discards the ASR text.
Default value: cache.', example='cache'),
  }(name='InterruptConfig', description='The speech interruption policy configuration.'),
  llmConfig?: {
    bailianAppParams?: string(name='BailianAppParams', description='The parameters for Alibaba Cloud Model Studio. The value must be a JSON string. For more information about the parameter format, see [Alibaba Cloud Model Studio parameters](https://help.aliyun.com/document_detail/2858132.html).', example='"{\\\\"biz_params\\\\":{\\\\"user_defined_params\\\\":{\\\\"your_plugin_id\\\\":{\\\\"article_index\\\\":2}}},\\\\"memory_id\\\\":\\\\"your_memory_id\\\\",\\\\"image_list\\\\":[\\\\"https://your_image_url\\\\"],\\\\"rag_options\\\\":{\\\\"pipeline_ids\\\\":[\\\\"your_id\\\\"],\\\\"file_ids\\\\":[\\\\"DocumentID1\\\\",\\\\"DocumentID2\\\\"],\\\\"metadata_filter\\\\":{\\\\"name\\\\":\\\\"ZhangSan\\\\"},\\\\"structured_filter\\\\":{\\\\"key1\\\\":\\\\"value1\\\\",\\\\"key2\\\\":\\\\"value2\\\\"},\\\\"tags\\\\":[\\\\"Tag1\\\\",\\\\"Tag2\\\\"]}}"'),
    functionMap?: [ 
      {
        function?: string(name='Function', description='The name of the built-in feature provided by the Alibaba Cloud agent system. Currently, only hangup is supported.', example='hangup'),
        matchFunction?: string(name='MatchFunction', description='The name of the LLM function that corresponds to the feature. This name is customized by the user and is used to call the corresponding feature in the LLM. For more information about the user-defined LLM protocol, see [Standard LLM API](https://help.aliyun.com/document_detail/2839094.html).', example='hangup'),
      }
    ](name='FunctionMap', description='The function mapping list, which is used to map agent capabilities to LLM functions. Currently, only function calling with user-defined LLMs that use the OpenAI protocol is supported.'),
    historySyncWithTTS?: boolean(name='HistorySyncWithTTS', description='Specifies whether to keep the LLM message history consistent with the text-to-speech (TTS) playback content. Default value: false. After this feature is enabled, the saved LLM messages are kept consistent with the TTS playback content.
When the user interrupts the agent in the LLM message history, the `<ims_agent_interrupted>` tag is inserted at the interruption position in the next message sent to the LLM. Example:
```
[
  {"role": "user", "content": "Tell me a story."},
  {"role": "assistant", "content": "Okay, let me tell you a story about Romance of the Three Kingdoms. Do<ims_agent_interrupted> you want to listen?"},
  {"role": "user", "content": "Tell me another one."}
]
```', example='false'),
    llmCompleteReply?: boolean(name='LlmCompleteReply', description='Specifies whether to send the complete LLM result to the client after the LLM generates the complete response. This switch does not affect the streaming generation of subtitles.', example='true'),
    llmHistory?: [ 
      {
        content?: string(name='Content', description='The actual text of the conversation content, which records the specific expression or response of the role in the conversation.', example='hello'),
        role?: string(name='Role', description='The role of the conversation participant. Valid values:
- user: User.
- assistant: Assistant.
- system: System.
- function: Function.
- plugin: Plugin.
- tool: Tool.', example='user'),
      }
    ](name='LlmHistory', description='The historical conversation context of the LLM or multimodal LLM.'),
    llmHistoryLimit?: int32(name='LlmHistoryLimit', description='The maximum number of retained turns for the historical conversation context of the LLM or multimodal LLM. Default value: 10.', example='10'),
    llmSystemPrompt?: string(name='LlmSystemPrompt', description='The system prompt for the LLM after the call is started.', example='You are the 1 friendly and helpful assistant, focused on providing accurate information and advice to users.'),
    openAIExtraQuery?: string(name='OpenAIExtraQuery', description='The extra query parameters for the OpenAI-compatible LLM. Parameters must be in the key=value format. Multiple parameters are connected by an ampersand (&). All values must be of the string type.', example='api-version=2024-02-01&api-key=sk-xxx'),
    outputMaxDelay?: int32(name='OutputMaxDelay', description='The maximum delay time for text output in milliseconds. If this time is exceeded, the cached text is forcibly output. Valid values: 1000 to 10000. A value of 0 or empty indicates no limit. Default value: empty.', example='2000'),
    outputMinLength?: int32(name='OutputMinLength', description='The minimum length of text output in characters. Text shorter than this length is cached and concatenated. Valid values: 0 to 100. A value of 0 or empty indicates no limit. Default value: empty.', example='5'),
  }(name='LlmConfig', description='The large language model (LLM) configuration.'),
  maxIdleTime?: int32(name='MaxIdleTime', description='The maximum wait time without interaction with the agent. If this time is exceeded, the agent goes offline. Unit: seconds. Default value: 600.', example='600'),
  transferCallConfig?: {
    calledNumber?: string(name='CalledNumber', description='The default transfer number. This is a backup number. You must still explicitly pass the called number when you initiate a transfer call.', example='0571xxxxxxx', maxLength=32),
    callerNumber?: string(name='CallerNumber', description='The caller number used for transfer calls. Configuring this field enables the RTC transfer capability. If this field is not configured, the behavior remains unchanged.', example='0571xxxxxxx', maxLength=32),
    forwardTranscriptionEnabled?: boolean(name='ForwardTranscriptionEnabled', description='Specifies whether to perform real-time speech recognition for both parties (the RTC user and the transferred phone party) after the transfer is connected. When enabled, the recognition results are pushed to the client as subtitles through the RTC message channel and written to the call record. Valid values:
* true: Enabled. This is the default value.
* false: Disabled. Subtitles and call records are not generated during the transfer.', example='false'),
    sipDomain?: string(name='SipDomain', description='The custom SIP outbound gateway address. This parameter is required only when Type is set to 1.', example='sip.example.com:5060', maxLength=256),
    type?: int32(name='Type', description='Valid values:
* 0: Alibaba Cloud communication line. This is the default value.
* 1: Custom SIP line.', example='1'),
  }(name='TransferCallConfig', description='The configuration for Real-Time Communication (RTC) call transfer. When you call ForwardAIAgentCall to transfer an RTC call (CallMode=0) to a regular phone, use this configuration to specify the line and the caller number.
Transfer is available only if CallerNumber is configured. If it is not configured, a 400 error is returned when you call the transfer API operation.
This configuration is read only once when the instance starts. Modifications during a call do not take effect.
This configuration does not apply to inbound and outbound call transfers. Use InboundCallConfig and OutboundCallConfig instead.'),
  ttsConfig?: {
    emotion?: string(name='Emotion', description='The emotion of the voice. Currently, only MiniMax is supported. MiniMax supports the following seven emotions:
- happy: Happy
- sad: Sad
- angry: Angry
- fearful: Fearful
- disgusted: Disgusted
- surprised: Surprised
- calm: Calm', example='happy'),
    hotFix?: string(name='HotFix', description='The TTS pronunciation correction and text replacement configuration.', example='{"pronunciation":[{"weather":"tian1 qi4"}],"replace":[{"today":"golden day"}]}'),
    instruction?: string(name='Instruction', description='The natural language instruction control for TTS.', example='Please use a gentle and friendly female voice, and broadcast at a slightly slower speed'),
    languageId?: string(name='LanguageId', description='The language ID. Currently, only MiniMax is supported. Default value: empty. This parameter enhances the recognition capability for specified minority languages and dialects. Setting this parameter improves the voice performance in the specified minority language or dialect scenarios. If the minority language type is not specified, you can set this parameter to auto, and the model automatically determines the language type. Valid values:
<details>
<summary>Supported languages</summary>

- Chinese: Chinese
- Chinese,Yue: Cantonese
- English: English
- Arabic: Arabic
- Russian: Russian
- Spanish: Spanish
- French: French
- Portuguese: Portuguese
- German: German
- Turkish: Turkish
- Dutch: Dutch
- Ukrainian: Ukrainian
- Vietnamese: Vietnamese
- Indonesian: Indonesian
- Japanese: Japanese
- Italian: Italian
- Korean: Korean
- Thai: Thai
- Polish: Polish
- Romanian: Romanian
- Greek: Greek
- Czech: Czech
- Finnish: Finnish
- Hindi: Hindi
- auto: Automatic detection
</details>', example='Chinese'),
    modelId?: string(name='ModelId', description='The model ID. Currently, only MiniMax is supported. Valid values:
speech-01-turbo and speech-02-turbo.', example='speech-01-turbo'),
    pronunciationRules?: [ 
      {
        pronunciation?: string(name='Pronunciation', description='The target pronunciation. The length must be less than 10 characters. It must consist of Chinese characters and cannot contain spaces.', example='110'),
        type?: string(name='Type', description='The specific pronunciation rule type. Valid values:
- replacement: A rule that directly replaces Word with Pronunciation.', example='replacement'),
        word?: string(name='Word', description='The word to be replaced. The length must be less than 10 characters. It must consist of Chinese characters and cannot contain spaces.', example='110'),
      }
    ](name='PronunciationRules', description='The TTS pronunciation rules. The array length cannot exceed 20. The rules are executed in sequence.'),
    speechRate?: double(name='SpeechRate', description='The speech rate. This parameter is supported on all platforms.
For CosyVoice, the default value is 1.0, and the valid values range from 0.5 to 2.0.
For MiniMax, the default value is 1.0, and the valid values range from 0.5 to 2.0.', example='1.0'),
    voiceId?: string(name='VoiceId', description='The voice ID. Modifications take effect in the next sentence. If you do not specify this parameter, the voice ID configured in the agent template is used. This parameter takes effect only for preset TTS. The input length cannot exceed 64 characters. For valid values, refer to [Intelligent speech effect examples](https://help.aliyun.com/document_detail/449563.html).', example='longcheng_v2'),
    voiceIdList?: [ string ](name='VoiceIdList', description='The list of available voices.'),
  }(name='TtsConfig', description='The speech synthesis configuration.'),
  turnDetectionConfig?: {
    eagerness?: string(name='Eagerness', description='The eagerness level. This parameter takes effect only in Semantic mode. It controls how quickly the AI starts to respond after detecting a pause:
- Low: Patient waiting. The maximum wait time is 6 seconds, which reduces the risk of being interrupted.
- Medium: Balanced waiting. The maximum wait time is 4 seconds, which is suitable for most scenarios.
- High: Fast response. The maximum wait time is 2 seconds, which improves speed but may increase the risk of false cut-offs.
Default value: empty.', example='High'),
    mode?: string(name='Mode', description='The turn detection mode. Valid values:
- Normal: Normal mode. AI is not used to determine semantics. This is the default value.
- Semantic: Semantic mode. AI is used to determine whether the user has finished speaking based on the context semantics.', example='Semantic'),
    semanticWaitDuration?: int32(name='SemanticWaitDuration', description='The pause determination time in AI mode. Unit: milliseconds. Default value: -1. Valid values:
- -1: The AI automatically determines the appropriate wait time.
- 0 to 10000: A custom wait time. We recommend that you set this value to 0 to 1500 milliseconds.
> This parameter is invalid in Normal mode.', example='-1'),
    turnEndWords?: [ string ](name='TurnEndWords', description='The list of keywords used to determine the end of a user turn.'),
  }(name='TurnDetectionConfig', description='The turn detection configuration.'),
  userOfflineTimeout?: int32(name='UserOfflineTimeout', description='The timeout period for the agent to close the task after the user leaves the meeting. Unit: seconds. Default value: 5.', example='5'),
  userOnlineTimeout?: int32(name='UserOnlineTimeout', description='The timeout period for the agent to close the task if the user does not join the meeting. Unit: seconds. Default value: 60.', example='60'),
  vcrConfig?: {
    equipment?: {
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the disabled equipment check. Default value: false.', example='false'),
    }(name='Equipment', description='The equipment recognition configuration.'),
    headMotion?: {
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the head motion recognition check. Default value: false.', example='false'),
    }(name='HeadMotion', description='The head motion recognition configuration.'),
    invalidFrameMotion?: {
      callbackDelay?: int32(name='CallbackDelay', description='The delay for the invalid frame check notification. After this parameter is set, the notification is triggered after a static frame lasts for a specified period of time. Unit: milliseconds. Default value: empty. If this parameter is empty, the configuration in the console is used during the call. Valid values: 200 to 5000.', example='3000'),
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the invalid frame check.', example='false'),
    }(name='InvalidFrameMotion', description='The parameter settings for the invalid frame check.'),
    lookAway?: {
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the look-away recognition configuration. Default value: false.', example='true'),
    }(name='LookAway', description='The look-away recognition configuration.'),
    peopleCount?: {
      enabled?: boolean(name='Enabled', description='The switch for the people counting feature. Default value: false.', example='false'),
    }(name='PeopleCount', description='The configuration for the people counting feature.'),
    stillFrameMotion?: {
      callbackDelay?: int32(name='CallbackDelay', description='The delay for the still frame check notification. After this parameter is set, the notification is triggered after a still frame lasts for a specified period of time. Unit: milliseconds. Default value: empty. If this parameter is empty, the configuration in the console is used during the call. Valid values: 200 to 5000.', example='3000'),
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the still frame check. Default value: false.', example='false'),
    }(name='StillFrameMotion', description='The configuration for the still frame detection.'),
  }(name='VcrConfig', description='The configuration for the video content recognition feature. This feature supports calling back the content recognized by the algorithm in the video to the client.'),
  voiceprintConfig?: {
    registrationMode?: string(name='RegistrationMode', description='The voiceprint registration mode. Default value: Explicit.
| Value | Description |
|---|---|
| Explicit | Explicit registration mode. Users must upload audio through the voiceprint registration API operation in advance to complete the registration. |
| Implicit | Implicit registration mode. The system automatically collects the user\\\\"s voice and generates voiceprint features during the conversation. |', example='Explicit'),
    useVoiceprint?: boolean(name='UseVoiceprint', description='Specifies whether to use voiceprint recognition. Default value: false. When voiceprint recognition is enabled, a valid voiceprint ID must be passed.', example='false'),
    voiceprintId?: string(name='VoiceprintId', description='The unique identity ID for voiceprint recognition. Default value: empty. The passed voiceprint ID must be registered through the voiceprint registration API operation. For more information about the API operation, refer to [Register human voiceprint](https://help.aliyun.com/document_detail/2964738.html).', example='zhixiaoxia'),
  }(name='VoiceprintConfig', description='The voiceprint configuration.'),
  volume?: long(name='Volume', description='The volume of the agent\\\\"s voice.
- If you do not specify this parameter, the adaptive volume mode recommended by Alibaba Cloud is used by default.
- If you specify this parameter, the valid values range from 0 to 400. Output volume = Voice output volume in the workflow × volume / 100. Examples:
1. If volume is set to 0, the output volume is 0.
2. If volume is set to 100, the output volume is the original volume.
3. If volume is set to 200, the output volume is twice the original volume.', example='100'),
  wakeUpQuery?: string(name='WakeUpQuery', description='The user\\\\"s instruction before the call starts. The agent responds to this sentence immediately after the call starts.', example='How’s the weather today?'),
  workflowOverrideParams?: string(name='WorkflowOverrideParams', description='The workflow override parameters. Default value: none.', example='{}'),
}

model AIAgentOutboundCallConfig {
  ambientSoundConfig?: {
    resourceId?: string(name='ResourceId', description='The ID of the ambient sound for calls. You can obtain this ID in the advanced configurations of the agent configuration in the console.', example='f67901c595834************'),
    volume?: int32(name='Volume', description='The volume of the background sound for calls. Valid values: 0 to 100. A value of 0 indicates that the background sound is disabled.', example='50'),
  }(name='AmbientSoundConfig', description='The ambient sound configuration for calls.'),
  asrConfig?: {
    asrHotWords?: [ string ](name='AsrHotWords', description='The list of ASR hotwords. The list supports a maximum of 128 hotwords.'),
    asrLanguageId?: string(name='AsrLanguageId', description='The language ID for automatic speech recognition (ASR). Valid values:

- zh_mandarin: Chinese

- en: English

- zh_en: Chinese and English mixed

- es: Spanish

- jp: Japanese', example='zh_mandarin'),
    asrMaxSilence?: int32(name='AsrMaxSilence', description='The silence duration threshold for speech segmentation. If the silence duration exceeds this threshold, the speech is considered segmented. Valid values: 200 to 1200. Unit: milliseconds. Default value: 400.', example='400'),
    customParams?: string(name='CustomParams', description='The pass-through parameters for the proprietary ASR integration.', example='mode=fast&sample=16000&format=wav'),
    vadDuration?: int32(name='VadDuration', description='The minimum duration threshold for voice activity detection, which is used to control the sensitivity of interruptions. A value of 0 disables this feature. Valid values: 200 to 2000. Unit: milliseconds. Common values: 200 to 500, which correspond to 1 to 4 characters. Default value: empty. This parameter does not take effect when left empty.', example='300'),
    vadLevel?: int32(name='VadLevel', description='The interruption threshold parameter. Valid values: 0 to 11. Default value: 11.

- 0: Disables the voice activity detection (VAD) feature.
- 1 to 10: A higher value indicates that it is more difficult to interrupt the speech.
- 11: Significantly different from previous values. It causes less damage to the conversation voice during pre-processing and provides stronger anti-interference capability.', example='11'),
  }(name='AsrConfig', description='The speech recognition configuration.'),
  autoSpeechConfig?: {
    llmPending?: {
      messages?: [ 
        {
          probability?: double(name='Probability', description='The selection probability of the prompt. Valid values: 0 to 1, which correspond to 0% to 100%.', example='0.5'),
          text?: string(name='Text', description='The text of the inquiry prompt. The maximum length is 100 characters.', example='Just a moment'),
        }
      ](name='Messages', description='The collection of inquiry prompts. A maximum of 10 prompts are supported. The length of each prompt cannot exceed 100 characters. The sum of probabilities must be 100%.'),
      mode?: string(name='Mode'),
      waitTime?: int32(name='WaitTime', description='The waiting time threshold for the LLM response. If this time is exceeded, a broadcast prompt is triggered. This parameter is required. Unit: milliseconds. Valid values: 500 to 10000. Set this parameter based on the actual usage of the LLM.', example='3000'),
    }(name='LlmPending', description='The broadcast configuration when the LLM response is delayed.'),
    userIdle?: {
      hangupEndWord?: string(name='HangupEndWord', description='The hang-up closing word. It is broadcast before the call is hung up after the user does not respond for a long time. The maximum length is 200 characters.', example='I’m hanging up, goodbye.'),
      maxRepeats?: int32(name='MaxRepeats', description='The maximum number of inquiries. Valid values: 0 to 10. This parameter is required. If this number is exceeded, no more inquiries are triggered, and the call is directly closed.', example='5'),
      messages?: [ 
        {
          probability?: double(name='Probability', description='The selection probability of the prompt. Valid values: 0 to 1, which correspond to 0% to 100%.', example='0.5'),
          text?: string(name='Text', description='The text of the inquiry prompt. The maximum length is 100 characters.', example='Are you still there?'),
        }
      ](name='Messages', description='The collection of inquiry prompts. A maximum of 10 prompts are supported. The length of each prompt cannot exceed 100 characters. The sum of probabilities must be 100%.'),
      waitTime?: int32(name='WaitTime', description='The silence duration threshold. Unit: milliseconds. This parameter is required. An inquiry is triggered when the silence duration exceeds this threshold. Valid values: 5000 to 600000.', example='5000'),
    }(name='UserIdle', description='The inquiry broadcast configuration when the user is silent for a long time.'),
  }(name='AutoSpeechConfig', description='The automatic speech configuration module for the agent, including LLM waiting prompts and user long-time silence inquiries.'),
  backChannelingConfig?: {
    enabled?: boolean(name='Enabled'),
    probability?: double(name='Probability'),
    triggerStage?: string(name='TriggerStage'),
    words?: {
      probability?: double(name='Probability'),
      text?: string(name='Text'),
    }(name='Words'),
  }(name='BackChannelingConfig', description='**[Deprecated]** Use BackChannelingConfigs instead.', deprecated='true'),
  backChannelingConfigs?: [ 
    {
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the backchanneling feature. This parameter is required. Valid values: true and false.', example='true'),
      probability?: double(name='Probability', description='The trigger probability of the feature. Valid values: 0.0 to 1.0. This parameter is required.', example='0.5'),
      triggerStage?: string(name='TriggerStage', description='The trigger timing for backchanneling. Valid values:

- pause_detected: A short pause in speech is detected.', example='pause_detected'),
      words?: [ 
        {
          probability?: double(name='Probability', description='The trigger probability of the phrase. Valid values: 0.0 to 1.0. Required.', example='0.3'),
          text?: string(name='Text', description='The text of the phrase. The maximum length is 20 characters. Multiple languages are supported. Required.', example='ok'),
        }
      ](name='Words', description='The collection of backchanneling phrases. A maximum of 10 phrases are supported. The length of each phrase cannot exceed 20 characters. The sum of probabilities must be 1.0.'),
    }
  ](name='BackChannelingConfigs', description='The backchanneling feature configuration module. After this feature is enabled, the system randomly broadcasts short backchanneling words at specific trigger timings.'),
  enableIntelligentSegment?: boolean(name='EnableIntelligentSegment', description='Specifies whether to enable intelligent segmentation. After this feature is enabled, fragmented sentences spoken by the user are intelligently merged into a single sentence. Default value: true.', example='true'),
  experimentalConfig?: string(name='ExperimentalConfig', description='The parameters for experimental features. Contact technical support if you have any requirements.', example='""'),
  greeting?: string(name='Greeting', description='The greeting message. Changes take effect in the next session. Default value: none.', example='hello'),
  greetingDelay?: int32(name='GreetingDelay', description='The delay time for the greeting message. Unit: milliseconds. Default value: 0. Valid values: 0 to 5000.', example='0'),
  interruptConfig?: {
    eagerness?: string(name='Eagerness', deprecated='true'),
    enableVoiceInterrupt?: boolean(name='EnableVoiceInterrupt', description='Specifies whether to support speech interruption. Default value: true.', example='true'),
    interruptWords?: [ string ](name='InterruptWords', description='The specific words or phrases that trigger conversation interruption.'),
    keepInterruptWordsForLLM?: boolean(name='KeepInterruptWordsForLLM', description='Specifies whether to retain the interrupt words and send them to the LLM. Default value: discard.

> Example: If the interrupt word is "wait", the phrase "wait how is the weather today" becomes "how is the weather today" after the interrupt word is discarded and sent to the LLM.', example='true'),
    noInterruptMode?: string(name='NoInterruptMode', description='The ASR processing policy in the No Interrupting mode. Valid values:

- cache: Caches the ASR text. After the current turn ends, the cached ASR text is processed together in the next turn.

- discard: Directly discards the ASR text.

Default value: cache.', example='cache'),
  }(name='InterruptConfig', description='The speech interruption policy configuration.'),
  llmConfig?: {
    bailianAppParams?: string(name='BailianAppParams', description='The parameters for Alibaba Cloud Model Studio Application Center. For the parameter format, refer to [Alibaba Cloud Model Studio Application Center parameters](https://help.aliyun.com/document_detail/2858132.html).', example='"{\\\\"biz_params\\\\":{\\\\"user_defined_params\\\\":{\\\\"your_plugin_id\\\\":{\\\\"article_index\\\\":2}}},\\\\"memory_id\\\\":\\\\"your_memory_id\\\\",\\\\"image_list\\\\":[\\\\"https://your_image_url\\\\"],\\\\"rag_options\\\\":{\\\\"pipeline_ids\\\\":[\\\\"your_id\\\\"],\\\\"file_ids\\\\":[\\\\"DocumentID1\\\\",\\\\"DocumentID2\\\\"],\\\\"metadata_filter\\\\":{\\\\"name\\\\":\\\\"ZhangSan\\\\"},\\\\"structured_filter\\\\":{\\\\"key1\\\\":\\\\"value1\\\\",\\\\"key2\\\\":\\\\"value2\\\\"},\\\\"tags\\\\":[\\\\"Tag1\\\\",\\\\"Tag2\\\\"]}}"'),
    functionMap?: [ 
      {
        function?: string(name='Function', description='The name of the built-in feature provided by the Alibaba Cloud agent system. Currently, only hangup is supported.', example='hangup'),
        matchFunction?: string(name='MatchFunction', description='The name of the LLM function that corresponds to the feature. This name is customized by the user and used to call the corresponding feature in the LLM. For the user-defined LLM protocol, refer to [Standard LLM API](https://help.aliyun.com/document_detail/2839094.html).', example='hangup'),
      }
    ](name='FunctionMap', description='The list of function mappings, which is used to map agent capabilities to LLM functions. Currently, only function calling with user-defined OpenAI-compatible LLMs is supported.'),
    historySyncWithTTS?: boolean(name='HistorySyncWithTTS', description='Specifies whether the LLM message history is consistent with the text-to-speech (TTS) playback content. Default value: false. After this feature is enabled, the saved LLM messages are consistent with the TTS playback content.', example='false'),
    llmCompleteReply?: boolean(name='LlmCompleteReply', description='After this feature is enabled, the complete LLM result is sent to the client after the LLM generates the result.', example='true'),
    llmHistory?: [ 
      {
        content?: string(name='Content', description='The actual text content of the conversation, which records the specific expression or response of the role in the conversation.', example='hello'),
        role?: string(name='Role', description='The role of the conversation participant. Valid values:

- user: User

- assistant: Assistant

- system: System

- function: Function

- plugin: Plugin

- tool: Tool', example='user'),
      }
    ](name='LlmHistory', description='The LLM or MLLM conversation history context.'),
    llmHistoryLimit?: int32(name='LlmHistoryLimit', description='The maximum number of retained turns for the LLM or multimodal LLM (MLLM) conversation history context. Default value: 10.', example='10'),
    llmSystemPrompt?: string(name='LlmSystemPrompt', description='The system prompt for the LLM after the call is initiated.', example='You are a friendly and helpful assistant, focused on providing users with accurate information and advice.'),
    openAIExtraQuery?: string(name='OpenAIExtraQuery', description='The additional query parameters for the OpenAI-compatible LLM. Parameters must be in the key=value format. Multiple parameters are connected by an ampersand (&). All values must be of the string type.', example='api-version=2024-02-01&api-key=sk-xxx'),
    outputMaxDelay?: string(name='OutputMaxDelay', description='The maximum delay time for text output in milliseconds. If this time is exceeded, the cached text is forcibly output. Valid values: 1000 to 10000. A value of 0 or empty indicates no limit. Default value: empty.', example='2000'),
    outputMinLength?: int32(name='OutputMinLength', description='The minimum length of text output in characters. Text shorter than this length is cached and waiting to be concatenated. Valid values: 0 to 100. A value of 0 or empty indicates no limit. Default value: empty.', example='5'),
  }(name='LlmConfig', description='The large language model (LLM) configuration.'),
  maxIdleTime?: int32(name='MaxIdleTime', description='The maximum waiting time without interaction with the agent. If this time is exceeded, the agent goes offline. Unit: seconds. Default value: 600.', example='600'),
  ttsConfig?: {
    emotion?: string(name='Emotion', description='The emotion. Currently, only MiniMax is supported. MiniMax supports the following seven emotions:

- happy: Happy
- sad: Sad
- angry: Angry
- fearful: Fearful
- disgusted: Disgusted
- surprised: Surprised
- calm: Neutral', example='happy'),
    languageId?: string(name='LanguageId', description='The language ID. Currently, only MiniMax is supported. Default value: empty. This parameter enhances the recognition capability for specified minority languages and dialects. After this parameter is set, the speech performance in the specified minority language or dialect scenarios is improved. If the minority language type is not clear, you can set this parameter to auto, and the model automatically determines the minority language type. Valid values:
<details>
<summary>Supported languages</summary>

- Chinese: Chinese
- Chinese,Yue: Cantonese
- English: English
- Arabic: Arabic
- Russian: Russian
- Spanish: Spanish
- French: French
- Portuguese: Portuguese
- German: German
- Turkish: Turkish
- Dutch: Dutch
- Ukrainian: Ukrainian
- Vietnamese: Vietnamese
- Indonesian: Indonesian
- Japanese: Japanese
- Italian: Italian
- Korean: Korean
- Thai: Thai
- Polish: Polish
- Romanian: Romanian
- Greek: Greek
- Czech: Czech
- Finnish: Finnish
- Hindi: Hindi
- auto: Automatic detection
</details>', example='Chinese'),
    modelId?: string(name='ModelId', description='The model ID. Currently, only MiniMax is supported. Valid values: speech-01-turbo and speech-02-turbo.', example='speech-01-turbo'),
    pronunciationRules?: [ 
      {
        pronunciation?: string(name='Pronunciation', description='The target pronunciation. The length must be less than 10 characters. It must consist of Chinese characters and cannot contain spaces.', example='Dashi Lane'),
        type?: string(name='Type', description='The specific pronunciation rule type. Valid values:

- replacement: The rule that directly replaces the word with the pronunciation.', example='replacement'),
        word?: string(name='Word', description='The word to be replaced. The length must be less than 10 characters. It must consist of Chinese characters and cannot contain spaces.', example='Dashi Lane'),
      }
    ](name='PronunciationRules', description='The TTS pronunciation rules. The array length cannot exceed 20. The rules are executed in sequence.'),
    speechRate?: double(name='SpeechRate', description='The speech rate. This parameter is supported on all platforms. For CosyVoice, the default value is 1.0, and the valid values are 0.5 to 2.0. For MiniMax, the default value is 1.0, and the valid values are 0.5 to 2.0.', example='1.0'),
    voiceId?: string(name='VoiceId', description='The voice ID. Changes take effect in the next sentence. If this parameter is not specified, the voice ID configured in the agent template is used. This parameter takes effect only for preset TTS. The input length cannot exceed 64 characters. For valid values, refer to [Intelligent speech effect examples](https://help.aliyun.com/document_detail/449563.html).', example='longcheng_v2'),
    voiceIdList?: [ string ](name='VoiceIdList', description='The list of available voices.'),
  }(name='TtsConfig', description='The speech synthesis configuration.'),
  turnDetectionConfig?: {
    eagerness?: string(name='Eagerness', description='The eagerness level. This parameter takes effect only in Semantic mode. It controls the speed at which the AI initiates a response after detecting a pause. Valid values:
- Low: Waits patiently with a maximum waiting time of 6 seconds to reduce the risk of being interrupted.
- Medium: Balances waiting with a maximum waiting time of 4 seconds. This value is suitable for most scenarios.
- High: Responds quickly with a maximum waiting time of 2 seconds. This value improves speed but may increase the risk of false cuts.

Default value: empty.', example='Low'),
    mode?: string(name='Mode', description='The turn detection mode. Valid values:

- Normal: The normal mode, which does not use AI to determine semantics.

- Semantic: Uses AI to determine whether the user has finished speaking based on the context semantics.

Default value: Normal.', example='Semantic'),
    semanticWaitDuration?: int32(name='SemanticWaitDuration', description='The pause determination time in AI mode. Unit: milliseconds. Default value: -1.

- -1: AI automatically determines the appropriate waiting time.

- 0 to 10000: Custom waiting time. We recommend that you set this value to 0 to 1500.

Note: This parameter is invalid in normal mode.', example='-1'),
    turnEndWords?: [ string ](name='TurnEndWords', description='The list of keywords used to determine the end of a user turn.'),
  }(name='TurnDetectionConfig', description='The conversation turn detection configuration.'),
}

model AIAgentRuntimeConfig {
  agentUserId?: string(name='AgentUserId', description='The name of the agent in the ARTC channel.', example='877ae632caae49b1afc81c2e8194ffb4'),
  authToken?: string(name='AuthToken', description='The authentication token for the agent to join the channel. This must be generated using your AppKey.', example='eyJhcHBpZCI6ICIxMjM0MTIzNxxxxx'),
  avatarChat3D?: {
    agentUserId?: string(name='AgentUserId', description='Required. The name of the agent in the ARTC channel.', example='877ae632caae49b1afc81c2e8194ffb4'),
    authToken?: string(name='AuthToken', description='Required. The authentication token for the agent to join the channel. This must be generated using your AppKey.', example='eyJhcHBpZCI6ICIxMjM0MTIzNxxxxx'),
    channelId?: string(name='ChannelId', description='Required. The ID of the ARTC channel.', example='70f22d5784194938a7e387052f2b3208'),
  }(name='AvatarChat3D', description='The runtime parameters of the avatar call.', deprecated='true'),
  channelId?: string(name='ChannelId', description='The ID of the ARTC channel.', example='70f22d5784194938a7e387052f2b3208'),
  visionChat?: {
    agentUserId?: string(name='AgentUserId', description='Required. The name of the agent in the ARTC channel.', example='877ae632caae49b1afc81c2e8194ffb4'),
    authToken?: string(name='AuthToken', description='Required. The authentication token for the agent to join the channel. This must be generated using your AppKey.', example='eyJhcHBpZCI6ICIxMjM0MTIzNxxxxx'),
    channelId?: string(name='ChannelId', description='Required. The ID of the ARTC channel.', example='70f22d5784194938a7e387052f2b3208'),
  }(name='VisionChat', description='The runtime parameters of the vision call.', deprecated='true'),
  voiceChat?: {
    agentUserId?: string(name='AgentUserId', description='Required. The name of the agent in the ARTC channel.', example='877ae632caae49b1afc81c2e8194ffb4'),
    authToken?: string(name='AuthToken', description='Required. The authentication token for the agent to join the channel. This must be generated using your AppKey.', example='eyJhcHBpZCI6ICIxMjM0MTIzNxxxxx'),
    channelId?: string(name='ChannelId', description='Required. The ID of the ARTC channel.', example='70f22d5784194938a7e387052f2b3208'),
  }(name='VoiceChat', description='The runtime parameters of the voice call.', deprecated='true'),
}

model AIAgentTemplateConfig {
  avatarChat3D?: {
    asrHotWords?: [ string ](name='AsrHotWords', description='The list of hotwords for ASR. The hotword list supports a maximum of 128 words.'),
    asrLanguageId?: string(name='AsrLanguageId', description='The language ID for automatic speech recognition (ASR). Valid values:
- zh_mandarin: Chinese
- en: English
- zh_en: Chinese and English mixed
- es: Spanish
- jp: Japanese', example='zh_mandarin'),
    asrMaxSilence?: int32(name='AsrMaxSilence', description='The threshold for speech segmentation detection. Silence exceeding this threshold is treated as a sentence break. Valid values: 200 to 1200. Unit: milliseconds. Default value: 400.', example='400'),
    avatarId?: string(name='AvatarId', description='The ID of the digital human model.', example='1231'),
    bailianAppParams?: string(name='BailianAppParams', description='The parameters for Alibaba Cloud Model Studio Application Center. For the parameter format, refer to [Alibaba Cloud Model Studio Application Center parameters](https://help.aliyun.com/document_detail/2858132.html).', example='{}'),
    charBreak?: boolean(name='CharBreak'),
    enableIntelligentSegment?: boolean(name='EnableIntelligentSegment', description='Specifies whether to enable intelligent segmentation. After this feature is enabled, sentence breaks in user speech are intelligently merged into a single sentence. Default value: true.', example='true'),
    enablePushToTalk?: boolean(name='EnablePushToTalk', description='Specifies whether to enable the push-to-talk mode. Default value: false.', example='false'),
    enableVoiceInterrupt?: boolean(name='EnableVoiceInterrupt', description='Specifies whether to support voice interruption. Default value: true.', example='true'),
    gracefulShutdown?: boolean(name='GracefulShutdown', description='Specifies whether to enable graceful shutdown. Default value: false.

- Graceful shutdown: When the agent is stopped, it finishes broadcasting the current speech before stopping, with a maximum broadcast duration of 10 seconds.', example='false'),
    greeting?: string(name='Greeting', description='The greeting message, which takes effect when joining the session. If not specified, the greeting configured in the agent template is used. Maximum length: 128 characters.', example='Good morning, my friend!'),
    interruptWords?: [ string ](name='InterruptWords', description='The list of specific words or phrases that trigger conversation interruption.'),
    llmHistory?: [ 
      {
        content?: string(name='Content', description='The actual text of the conversation content, which records the specific expression or response of the role in the conversation.', example='hello'),
        role?: string(name='Role', description='The role of the conversation participant. Valid values:

- user: User

- assistant: Assistant

- system: System

- function: Function

- plugin: Plug-in

- tool: Tool', example='user'),
      }
    ](name='LlmHistory', description='The maximum number of retained turns for the LLM or MLLM historical conversation context. Default value: 10.'),
    llmHistoryLimit?: int32(name='LlmHistoryLimit', description='The maximum number of retained turns for the LLM or MLLM historical conversation context. Default value: 10.', example='10'),
    llmSystemPrompt?: string(name='LlmSystemPrompt', description='The system prompt for the LLM after the call starts.', example='You are a friendly and helpful assistant, focused on providing users with accurate information and advice.'),
    maxIdleTime?: int32(name='MaxIdleTime', description='The maximum waiting time without interaction with the agent. The agent goes offline upon timeout. Unit: seconds. Default value: 600.', example='600'),
    useVoiceprint?: boolean(name='UseVoiceprint', description='Specifies whether to enable voiceprint recognition. Default value: false.', example='false'),
    userOfflineTimeout?: int32(name='UserOfflineTimeout', description='The timeout period for the agent to close the task after the user leaves the session. Unit: seconds. Default value: 5.', example='5'),
    userOnlineTimeout?: int32(name='UserOnlineTimeout', description='The timeout period for the agent to close the task if the user does not join the session. Unit: seconds. Default value: 60.', example='60'),
    vadLevel?: int32(name='VadLevel', description='The interruption threshold parameter. Valid values: 0 to 11. Default value: 11.

- 0: Disables the voice activity detection (VAD) feature.
- 1 to 10: A higher value indicates that it is more difficult to interrupt.
- 11: Significantly different from previous values, with lower pre-processing speech damage and stronger anti-interference.', example='0'),
    voiceId?: string(name='VoiceId', description='The ID of the voice, which takes effect in the next sentence. If not specified, the voice ID configured in the agent template is used. This parameter applies only to preset text-to-speech (TTS). Maximum length: 64 characters. For valid values, refer to [Intelligent speech effect examples](https://help.aliyun.com/document_detail/449563.html).', example='zhixiaoxia'),
    voiceIdList?: [ string ](name='VoiceIdList', description='The list of available voices.'),
    voiceprintId?: string(name='VoiceprintId', description='The unique identity ID for voiceprint recognition. Default value: none.', example='uniqueId'),
    volume?: long(name='Volume', description='The volume of the agent\\\\"s speech.

- If not specified: The adaptive volume mode recommended by Alibaba Cloud is used by default.

- If specified: Valid values are 0 to 400. Output volume = Speech output volume in the workflow × volume / 100. Examples:

1. If volume is set to 0, the output volume is 0.
 
2. If volume is set to 100, the volume is the original volume.

3. If volume is set to 200, the volume is twice the original volume.', example='100'),
    wakeUpQuery?: string(name='WakeUpQuery', description='The user\\\\"s instruction before the call starts, which is used for the agent to respond immediately after the call starts.', example='How’s the weather today?'),
    workflowOverrideParams?: string(name='WorkflowOverrideParams', description='The override parameters for the workflow. Default value: none.', example='{}'),
  }(name='AvatarChat3D', description='The 3D digital human parameters.'),
  visionChat?: {
    asrHotWords?: [ string ](name='AsrHotWords', description='The list of hotwords for ASR. The hotword list supports a maximum of 128 words.'),
    asrLanguageId?: string(name='AsrLanguageId', description='The language ID for automatic speech recognition (ASR). Valid values:
- zh_mandarin: Chinese
- en: English
- zh_en: Chinese and English mixed
- es: Spanish
- jp: Japanese', example='zh_mandarin'),
    asrMaxSilence?: int32(name='AsrMaxSilence', description='The threshold for speech segmentation detection. Silence exceeding this threshold is treated as a sentence break. Valid values: 200 to 1200. Unit: milliseconds. Default value: 400.', example='400'),
    bailianAppParams?: string(name='BailianAppParams', description='The parameters for Alibaba Cloud Model Studio Application Center. For the parameter format, refer to [Alibaba Cloud Model Studio Application Center parameters](https://help.aliyun.com/document_detail/2858132.html).', example='{}'),
    charBreak?: boolean(name='CharBreak'),
    enableIntelligentSegment?: boolean(name='EnableIntelligentSegment', description='Specifies whether to enable intelligent segmentation. After this feature is enabled, sentence breaks in user speech are intelligently merged into a single sentence. Default value: true.', example='true'),
    enablePushToTalk?: boolean(name='EnablePushToTalk', description='Specifies whether to enable the push-to-talk mode. Default value: false.', example='false'),
    enableVoiceInterrupt?: boolean(name='EnableVoiceInterrupt', description='Specifies whether to support voice interruption. Default value: true.', example='true'),
    gracefulShutdown?: boolean(name='GracefulShutdown', description='Specifies whether to enable graceful shutdown. Default value: false.

Graceful shutdown: When the agent is stopped, it finishes broadcasting the current speech before stopping, with a maximum broadcast duration of 10 seconds.', example='false'),
