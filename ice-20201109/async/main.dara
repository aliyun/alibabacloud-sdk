        lines?: int32(name='Lines', description='The number of rows for image stitching.', example='20'),
        margin?: int32(name='Margin', description='The margin width. Default value: 0. Unit: pixels.', example='20'),
        padding?: int32(name='Padding', description='The spacing between images. Default value: 0. Unit: pixels.', example='20'),
      }(name='SpriteSnapshotConfig', description='The sprite snapshot configuration.'),
      time?: long(name='Time', description='The start time of the snapshot. Unit: milliseconds.', example='1000'),
