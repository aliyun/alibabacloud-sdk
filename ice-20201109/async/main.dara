  relatedMediaids?: string(name='RelatedMediaids', description='The media assets associated with the template, used by the common template editor.', example='{"video":["f64c6acc840247edb6b12f575c66****","9675dcf040ba4525bb037c29d156****"],"audio":["62a54019d9114009a5ae9bcfd70b****"],"image":["743ffbeb7e004c758cdc1fb34c04****"]}', position='Query'),
  source?: string(name='Source', description='The update source. Default value: OpenAPI. Valid values:
- AliyunConsole: Created through the Alibaba Cloud Management Console.
- OpenAPI: Created through OpenAPI.
- WebSDK: Created through WebSDK.', example='OpenAPI', position='Query'),
  status?: string(name='Status', description='The template status. Valid values:
- Available: Normal.
- Created: Created but unavailable.
- Uploading: Uploading.
- Processing: Analyzing the advanced template.
- UploadFailed: Upload failed.
- ProcessFailed: Advanced template analysis failed.

> After an advanced template is created, it requires analysis time and its status is Processing. The template is unavailable during this period and can only be used when its status changes to Available. The analysis time depends on the template file size and typically ranges from 10 seconds to 5 minutes.', example='Available', position='Query'),
  templateId?: string(name='TemplateId', description='The ID of the cloud editing template. You can obtain the ID from the [Intelligent Media Services console](https://ice.console.aliyun.com/production/template/list/common) or the response parameters of the [CreateTemplate](https://help.aliyun.com/document_detail/441161.html) operation.', example='23923ec3318f4c359e42e1e5b296****', position='Query'),
}

model UpdateTemplateResponseBody = {
  requestId?: string(name='RequestId', description='The request ID.', example='F8D475A5-F2EC-5755-ABD8-22D5561C****'),
}

model UpdateTemplateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateTemplateResponseBody(name='body'),
}

/**
  * @description - To use common templates, refer to [Quick start for common templates](https://help.aliyun.com/document_detail/270942.html).
  * - To use advanced templates, refer to [Create and use advanced templates](https://help.aliyun.com/document_detail/291418.html).
  * @param request  the request parameters of UpdateTemplate  UpdateTemplateRequest
  * @return UpdateTemplateResponse
 */
async function updateTemplate(request: UpdateTemplateRequest): UpdateTemplateResponse {
