model SubmitAudioProduceJobRequest {
  description?: string(name='Description', description='The task description:
- The length cannot exceed 1,024 bytes.
- UTF-8 encoding.', example='taskDescription', position='Query'),
  editingConfig: string(name='EditingConfig', description='The audio production configuration:
- voice: The [voice type](https://help.aliyun.com/document_detail/449563.html).
- customizedVoice: The VoiceId for voice cloning.
- format: The output file format. Valid values: PCM, WAV, and MP3.
- volume: The volume. Valid values: 0 to 100. Default value: 50.
- speech_rate: The speech rate. Valid values: -500 to 500. Default value: 0.
    - [-500, 0, 500] corresponds to the speech rate multiplier range of [0.5, 1.0, 2.0].
    - The calculation method is as follows:
        - 0.8x speed: (1 - 1/0.8) / 0.002 = -125
        - 1.2x speed: (1 - 1/1.2) / 0.001 = 166
        - For speeds less than 1x, the 0.002 coefficient is used.
        - For speeds greater than 1x, the 0.001 coefficient is used.
- pitch_rate: The pitch. Valid values: -500 to 500. Default value: 0.
<notice>If both voice and customizedVoice are specified, customizedVoice takes precedence.</notice>

This parameter is required.', example='{"voice":"Siqi","format":"MP3","volume":50}', position='Query'),
  inputConfig: string(name='InputConfig', description='The text content. A maximum of 10,000 Chinese characters are supported. [Speech Synthesis Markup Language (SSML)](https://help.aliyun.com/document_detail/2672807.html) is supported.

This parameter is required.', example='test', position='Query'),
  outputConfig: string(name='OutputConfig', description='The audio output configuration. For example, to store the output speech at http://my_bucket.oss-cn-shanghai.aliyuncs.com/target_audio.mp3, the parameter settings are as follows:
{
      "bucket": "my_bucket",
      "object": "target_audio"
}

This parameter is required.', example='{
      "bucket": "my_bucket",
      "object": "target_audio"
}', position='Query'),
  overwrite?: boolean(name='Overwrite', description='Specifies whether to overwrite existing OSS files.', example='true', position='Query'),
  title?: string(name='Title', description='The task title. If not provided, a default title is automatically generated based on the date.
- The length cannot exceed 128 bytes.
- UTF-8 encoding.', example='taskTitle', position='Query'),
  userData?: string(name='UserData', description='The custom settings in JSON format. The maximum length is 512 bytes. [Custom callback URL configuration](https://help.aliyun.com/document_detail/451631.html) is supported.', example='{"NotifyAddress":"http://xx.xx.xxx"}', position='Query'),
