                isCheckReso?: string(name='IsCheckReso', description='Specifies whether to check the video resolution. You can specify only one of IsCheckReso and IsCheckResoFail. IsCheckResoFail has a higher priority. Valid values:
- true: Checks the resolution. If the width or height of the input video resolution is smaller than the output settings, the video is transcoded based on the input video resolution.
- false: Does not check the resolution. This is the default value.', example='true'),
                isCheckResoFail?: string(name='IsCheckResoFail', description='Specifies whether to check the video resolution. You can specify only one of IsCheckReso and IsCheckResoFail. This parameter has a higher priority. Valid values:
- true: Checks the resolution. If the width or height of the input video resolution is smaller than the output settings, a transcoding failure is returned.
- false: Does not check the resolution. This is the default value.', example='true'),
                isCheckVideoBitrate?: string(name='IsCheckVideoBitrate', description='Specifies whether to check the video bitrate. You can specify only one of IsCheckVideoBitrate and IsCheckVideoBitrateFail. IsCheckVideoBitrateFail has a higher priority. Valid values:
- true: Checks the bitrate. If the input video bitrate is lower than the output settings, the video is transcoded based on the input video bitrate.
- false: Does not check the bitrate. This is the default value.', example='true'),
                isCheckVideoBitrateFail?: string(name='IsCheckVideoBitrateFail', description='Specifies whether to check the video bitrate. You can specify only one of IsCheckVideoBitrate and IsCheckVideoBitrateFail. This parameter has a higher priority. Valid values:
- true: Checks the bitrate. If the input video bitrate is lower than the output settings, a transcoding failure is returned.
- false: Does not check the bitrate. This is the default value.', example='true'),
                transMode?: string(name='TransMode', description='The video transcoding mode. Valid values:
- onepass: Typically used for ABR. The encoding speed is faster than that of twopass. This is the default value.
- twopass: Typically used for VBR. The encoding speed is slower than that of onepass.
- CBR: Constant bitrate mode.', example='onepass'),
              }(name='TransConfig', description='The conditional transcoding parameters.'),
              video?: {
                abrMax?: string(name='AbrMax', description='The maximum adaptive bitrate (ABR). This parameter is valid only for Narrowband HD 1.0. Valid values: 10 to 50000. Unit: Kbit/s.', example='6000'),
                bitrate?: string(name='Bitrate', description='The average video bitrate.
- Valid values: 10 to 50000.
- Unit: Kbit/s.', example='3000'),
                bufsize?: string(name='Bufsize', description='The buffer size.
- Valid values: 1000 to 128000.
- Default value: 6000.
- Unit: Kb.', example='6000'),
                codec?: string(name='Codec', description='The codec.', example='H.264'),
                crf?: string(name='Crf', description='The constant rate factor (CRF) for bitrate-quality control.
- Valid values: 0 to 51.
- Default value: 23 for H.264 and 26 for H.265.

If Crf is specified, the Bitrate setting becomes invalid.', example='23'),
                crop?: string(name='Crop', description='The video cropping settings. Two methods are supported:
- Automatically detect and crop black borders: Set the value to border.
- Custom cropping: Use the format width:height:left:top. Example: 1280:800:0:140.', example='1280:800:0:140'),
                fps?: string(name='Fps', description='The frame rate.
- Valid values: (0, 60].
- If the frame rate of the input file exceeds 60, the value is set to 60.
- Default value: The frame rate of the input file.', example='25'),
                gop?: string(name='Gop', description='The maximum number of frames between keyframes.
- Valid values: 1 to 1080000.
- Default value: 250.', example='250'),
                height?: string(name='Height', description='The height.
- Valid values: 128 to 4096.
- Unit: pixels.
- Default value: The original height of the video.', example='1080'),
                longShortMode?: string(name='LongShortMode', description='Specifies whether to enable the adaptive landscape and portrait mode, which adjusts the output based on the long and short edges of the video.', example='false'),
                maxrate?: string(name='Maxrate', description='The peak video bitrate. Valid values: 10 to 50000. Unit: Kbit/s.', example='9000'),
                pad?: string(name='Pad', description='The video padding settings for adding black borders.   
- Format: width:height:left:top.
- Example: 1280:800:0:140.', example='1280:800:0:140'),
                pixFmt?: string(name='PixFmt', description='The video pixel format. Valid values: standard color formats such as yuv420p and yuvj420p.', example='yuv420p'),
                preset?: string(name='Preset', description='The video algorithm preset. This parameter is supported only for H.264. Valid values: veryfast, fast, medium, slow, and slower. Default value: medium.', example='medium'),
                profile?: string(name='Profile', description='The encoding profile. Valid values:
- baseline: for mobile devices
- main: for standard resolution devices
- high: for high resolution devices

Default value: high.', example='Main'),
                remove?: string(name='Remove', description='Specifies whether to remove the video stream.', example='false'),
                scanMode?: string(name='ScanMode', description='The scan mode. Valid values: interlaced and progressive.', example='progressive'),
                width?: string(name='Width', description='The width.
- Valid values: 128 to 4096.
- Unit: pixels.
- Default value: The original width of the video.', example='1920'),
              }(name='Video', description='The video settings.'),
            }(name='OverwriteParams', description='The override parameters. If specified, these parameters override the corresponding parameters in the template.'),
            templateId?: string(name='TemplateId', description='The template ID.', example='9547c6ad97cb4f2aaa29683ebd18d410'),
          }(name='Transcode', description='The transcoding configuration.'),
        }(name='ProcessConfig', description='The transcoding configuration.'),
