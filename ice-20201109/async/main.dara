  pipelineId?: string(name='PipelineId', description='The ID of the queue on which this task was processed.', example='688c2a8bfa4e44ddbba0c8730db91b0c'),
  requestId?: string(name='RequestId', description='The ID of the API request that created this task.', example='******11-DB8D-4A9A-875B-275798******'),
  state?: string(name='State', description='The status of the task.

*   Inited: The task is initialized.
*   Running
*   Complete
*   Error
*   Cancelled', example='Inited'),
  userData?: string(name='UserData', description='The user-defined data.', example='{"info": "xxx"}'),
}

model MediaConvertMuxConfig {
  segment?: MediaConvertSegment(name='Segment', description='The segment configuration field. For more information, see the Segment details.

This parameter takes effect only when Container is set to m3u8, hls-fmp4, mpd, or cmaf.'),
