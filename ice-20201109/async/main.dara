      interval?: long(name='Interval', description='The snapshot interval. Unit: seconds.', example='10'),
      isSptFrag?: boolean(name='IsSptFrag', description='The WebVTT snapshot configuration. Specifies whether to stitch the output.', example='true'),
      pixelBlackThreshold?: int32(name='PixelBlackThreshold', description='The threshold for determining whether a pixel is a black pixel.', example='70'),
