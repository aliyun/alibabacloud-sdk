    userOnlineTimeout?: int32(name='UserOnlineTimeout', description='The timeout period for the agent to close the task if the user does not join the session. Unit: seconds. Default value: 60.', example='60'),
    vadLevel?: int32(name='VadLevel', description='The interruption threshold parameter. Valid values: 0 to 11. Default value: 11.

- 0: Disables the voice activity detection (VAD) feature.
- 1 to 10: A higher value indicates that it is more difficult to interrupt.
- 11: Significantly different from previous values, with lower pre-processing speech damage and stronger anti-interference.', example='0'),
    voiceId?: string(name='VoiceId', description='The ID of the voice, which takes effect in the next sentence. If not specified, the voice ID configured in the agent template is used. This parameter applies only to preset text-to-speech (TTS). Maximum length: 64 characters. For valid values, refer to [Intelligent speech effect examples](https://help.aliyun.com/document_detail/449563.html).', example='zhixiaoxia'),
    voiceIdList?: [ string ](name='VoiceIdList', description='The list of available voices.'),
    voiceprintId?: string(name='VoiceprintId', description='The unique identity ID for voiceprint recognition. Default value: none.', example='uniqueId'),
    volume?: long(name='Volume', description='The volume of the agent\\\\"s speech.

If not specified: The adaptive volume mode recommended by Alibaba Cloud is used by default.

If specified: Valid values are 0 to 400. Output volume = Speech output volume in the workflow × volume / 100. Examples:

If volume is set to 0, the output volume is 0.

If volume is set to 100, the volume is the original volume.

If volume is set to 200, the volume is twice the original volume.', example='100'),
    wakeUpQuery?: string(name='WakeUpQuery', description='The user\\\\"s instruction before the call starts, which is used for the agent to respond immediately after the call starts.', example='How’s the weather today?'),
    workflowOverrideParams?: string(name='WorkflowOverrideParams', description='The override parameters for the workflow. Default value: none.', example='{}'),
