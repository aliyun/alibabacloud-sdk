model MediaConvertOutput {
  features?: string(name='Features', description='The feature parameters.', example='{}'),
  name?: string(name='Name', description='The name of the output.', example='output-video'),
  outputFile?: MediaObject(name='OutputFile', description='The output file.'),
  overrideParams?: string(name='OverrideParams', description='A JSON string containing parameters to overwrite the corresponding settings of the template.', example='{}'),
  priority?: int32(name='Priority', description='The priority. Valid values: 1 to 10. A larger value indicates a higher priority. Default value: 6.', example='6'),
