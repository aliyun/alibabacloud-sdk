}

model MediaConvertOutputDetail {
  code?: string(name='Code', description='The error code for a transcoding failure.', example='InvalidParameter.ResourceContentBad'),
  createTime?: string(name='CreateTime', description='The time when the output was created. The time is displayed in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format (UTC).', example='2024-12-07T06:06:58Z'),
  finishTime?: string(name='FinishTime', description='The time when the output was completed. The time is displayed in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format (UTC).', example='2024-12-07T13:01:07Z'),
  message?: string(name='Message', description='The detailed cause of the transcoding failure.', example='The resource operated InputFile is bad'),
  name?: string(name='Name', description='The name of the transcoding output.', example='720P-mp4'),
  result?: {
    outFileMeta?: MediaConvertOutputDetailFileMeta(name='OutFileMeta', description='The metadata of the audio and video streams.'),
    outputFile?: {
      media?: string(name='Media', description='The media value.

- When Type is set to OSS, the URL supports the OSS and HTTP protocols.
- When Type is set to Media, the value is the media asset ID.', example='oss://bucket/path/to/video.mp4'),
      type?: string(name='Type', description='The media object type. Valid values:
- OSS: OSS file.
- Media: Media asset ID.', example='OSS'),
      url?: string(name='Url', description='The actual file URL when Type is set to Media.', example='oss://bucket/path/to/video.mp4'),
    }(name='OutputFile', description='The details of the output file.'),
  }(name='Result', description='The details of the output result.'),
  status?: string(name='Status', description='The task status. Valid values:
- Init: Initialized.
- Scheduled: Scheduled.
- Success: Succeeded.
- Failed: Failed.
- Skipped: Skipped.', example='Success'),
  taskId?: string(name='TaskId', description='The ID of the transcoding output task.', example='******4215e042b3966ca5441e******'),
}

