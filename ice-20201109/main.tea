model LiveManifestConfig {
  adMarkers?: string(name='AdMarkers', description='The ad markers supported in the playlist. Valid values:
- NONE: removes ad markers.
- DATE_RANGE: uses the EXT-X-DATERANGE marker in the HLS specification. Available when the endpoint protocol is HLS or HLS_CMAF.
- XML: uses XML ad markers in the DASH specification. Available when the endpoint protocol is DASH.', example='NONE'),
  dateTimeInterval?: int32(name='DateTimeInterval', description='The interval at which the EXT-X-PROGRAM-DATE-TIME time tag is inserted, in seconds. By default, no tag is inserted. Valid values: 1 to 3600. Applicable to the HLS and HLS_CMAF protocols.', example='5'),
  manifestDuration?: int32(name='ManifestDuration', description='The maximum time-shift duration during live streaming, in seconds. Valid values: 1 to 3600. Default value: 60. Applicable to DASH.', example='60'),
  maxVideoBitrate?: int32(name='MaxVideoBitrate', description='The maximum input bitrate threshold, in bit/s. The video track must have a bitrate less than or equal to this threshold to be played from this endpoint. Valid values: integers greater than 0. Default value: empty, which indicates that no maximum bitrate is set.', example='8000000'),
  minBufferTime?: int32(name='MinBufferTime', description='The minimum buffer time, in seconds. Valid values: 1 to 30. Default value: the duration of two segments. Applicable only to DASH. Note: A small minimum buffer time may cause stuttering during playback. Set this value to no less than the duration of two segments.', example='8'),
  minUpdatePeriod?: int32(name='MinUpdatePeriod', description='The minimum update interval, in seconds. Valid values: 1 to 3600. Default value: the duration of two segments. Applicable to DASH. Note: Set this parameter to a value less than the minimum buffer time. A large value may cause stuttering during DASH playback.', example='8'),
  minVideoBitrate?: int32(name='MinVideoBitrate', description='The minimum input bitrate threshold, in bit/s. The video track must have a bitrate greater than or equal to this threshold to be played from this endpoint. Valid values: integers greater than 0. Default value: empty, which indicates that no minimum bitrate is set.', example='1000000'),
  partHoldBackMs?: int32(name='PartHoldBackMs', description='The part segment cache duration, in milliseconds. The minimum value is twice the PartDurationMs, and the maximum value is three times the SegmentDuration. Applicable only to LL_HLS_CMAF.', example='1100'),
  presentationDelay?: int32(name='PresentationDelay', description='The recommended playback start delay, in seconds. Valid values: 1 to 60. Default value: the duration of three segments.', example='12'),
  segmentCount?: int32(name='SegmentCount', description='The number of segments. Applicable to the HLS and HLS_CMAF protocols. By default, the configuration of the channel is used. Valid values: 2 to 100.', example='3'),
  segmentTemplateFormat?: string(name='SegmentTemplateFormat', description='The segment template. Currently, only NUMBER_TIMELINE is supported. Default value: NUMBER_TIMELINE. Applicable to DASH.', example='NUMBER_TIMELINE'),
  streamOrder?: string(name='StreamOrder', description='The stream sorting rule. Valid values:
- ORIGINAL: keeps the sorting of the input sub-playlists.
- VIDEO_BITRATE_ASCENDING: sorts video streams in ascending order of bitrate.
- VIDEO_BITRATE_DESCENDING: sorts video streams in descending order of bitrate.', example='ORIGINAL'),
}

model LivePackagingConfig {
  drmConfig?: {
    contentId?: string(name='ContentId', description='The content ID in the DRM system. Format: [A-Za-z0-9_-]+. Maximum length: 256 characters. You must ensure the uniqueness of the content ID. Otherwise, DRM playback may fail.', example='live-axb1-9dd2fa123'),
    encryptionMethod?: string(name='EncryptionMethod', description='The encryption algorithm. Valid values:
- SAMPLE_AES

Default value: empty, which indicates no encryption.', example='SAMPLE_AES'),
    IV?: string(name='IV', description='The optional 128-bit (16-byte) hexadecimal value represented by a 32-character string, used with the key for encrypted data blocks. If you do not specify this value, MediaPackage creates a constant initialization vector (IV). Default value: empty. If specified, the value is passed through to the provider as a constant initialization vector.', example='00000000000000000000000000000000'),
    rotatePeriod?: int32(name='RotatePeriod', description='The DRM key rotation interval in seconds. Default value: 0, which indicates that keys are not rotated.', example='0'),
    systemIds?: [ string ](name='SystemIds', description='The DRM system IDs, which are determined by the protocol type used.
- DASH: supports Google Widevine and Microsoft PlayReady
- HLS: not supported
- HLS_CMAF: supports Apple FairPlay, Google Widevine, and Microsoft PlayReady

The following three DRM systems are supported, with their corresponding system IDs:
- Apple FairPlay:
94ce86fb-07ff-4f43-adb8-93d2fa968ca2
- Google Widevine:
edef8ba9-79d6-4ace-a3c8-27dcd51d21ed
- Microsoft PlayReady:
9a04f079-9840-4286-ab92-e65be0885f95.'),
    url?: string(name='Url', description='The URL of the DRM key provider.', example='https://exampledrm.com/path?arg1=xxx'),
  }(name='DrmConfig', description='The DRM encryption provider configuration. If encryption is not used, leave all fields empty.'),
  liveManifestConfigs?: [
    LiveManifestConfig
  ](name='LiveManifestConfigs', description='The live streaming manifest configuration. Up to one configuration is supported.'),
  partDurationMs?: int32(name='PartDurationMs', description='The duration of an LL-HLS part or an LL-DASH chunk in milliseconds. The value must be no less than 200 and no greater than the segment duration in milliseconds.', example='350'),
  segmentDuration?: int32(name='SegmentDuration', description='The duration of each segment in seconds. Default value: the segment duration of the channel. The actual segment duration is the nearest multiple of the source segment duration that is greater than or equal to the configured value. Valid values: 1 to 30.', example='6'),
  useAudioRenditionGroups?: boolean(name='UseAudioRenditionGroups', description='Specifies whether to separate audio tracks for TS segments.', example='true'),
}

model MediaConvertAudio {
  bitrate?: long(name='Bitrate', description='The audio bitrate of the output file.

*   Unit: Kbps.
*   Valid values: [8,1000].
*   Default value: 128.
*   Common values: 64, 128, and 256.', example='128'),
  channels?: long(name='Channels', description='The number of audio channels.

*   Valid values: 0, 1, 2, 4, 5, 6, and 8.

    *   If the Codec parameter is set to MP3 or OPUS, you can set this parameter to 0, 1, or 2.
    *   If the Codec parameter is set to AAC or FLAC, you can set this parameter to 0, 1, 2, 4, 5, 6, or 8.
    *   If the Codec parameter is set to VORBIS, you can set this parameter to 2.
    *   If the Format parameter is set to MPD, you cannot set this parameter to 8.

*   Default value: 2.

*   Set the value to 0 to preserve the original number of channels from the source file.', example='2'),
  codec?: string(name='Codec', description='The audio codec.

*   Valid values: AAC, AC3, EAC3, MP2, MP3, FLAC, OPUS, VORBIS, WMA-V1, WMA-V2, and pcm_s16le.
*   Default value: AAC.', example='AAC'),
  profile?: string(name='Profile', description='The audio codec profile.

*   This parameter takes effect only if the Codec parameter is set to AAC.
*   Valid values: aac_low, aac_he, aac_he_v2, aac_ld, and aac_eld.
*   Default value: aac_low.', example='aac_low'),
  remove?: boolean(name='Remove', description='Specifies whether to remove the audio stream from the output.

*   true: deletes the audio stream. All other parameters in the Audio object are ignored.
*   false: retains the audio stream.
*   Default value: false.'),
  samplerate?: string(name='Samplerate', description='The sample rate.

*   Unit: Hz
*   Valid values: 22050, 32000, 44100, 48000, and 96000.
*   Default value: 44100.

The supported sample rates vary depending on the container and codec format. For example, when the audio codec is MP3, a sample rate of 96000 is not supported. If the container format is FLV, only sample rates of 22050 and 44100 are supported.', example='44100'),
}

model MediaConvertInput {
  inputFile?: MediaObject(name='InputFile', description='The input file.'),
  name?: string(name='Name', description='The name of the input file. If Output contains InputRef, use this name to reference the input file.', example='InputVideo'),
}

model MediaConvertJob {
  clientToken?: string(name='ClientToken', description='The idempotency key of the request for creating the task.', example='****12e8864746a0a398****'),
  code?: string(name='Code', description='An error code returned if the task failed.', example='InvalidParameter.ResourceContentBad'),
  config?: MediaConvertJobConfig(name='Config', description='The task configuration.'),
  createTime?: string(name='CreateTime', description='The time the task was created. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC.', example='2022-07-07T07:16:11Z'),
  finishTime?: string(name='FinishTime', description='The time the task was completed. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC.', example='2022-07-07T07:16:11Z'),
  jobId?: string(name='JobId', description='The ID of the task.', example='****d80e4e4044975745c14b****'),
  message?: string(name='Message', description='The reason for a failed task.', example='The resource operated InputFile is bad'),
  outputDetails?: [
    MediaConvertOutputDetail
  ](name='OutputDetails', description='An array containing the results for each output.'),
  outputGroupDetails?: [
    MediaConvertOutputGroupDetail
  ](name='OutputGroupDetails', description='The details of the output groups.'),
  percent?: int32(name='Percent', description='The completion percentage of the task.', example='0'),
  pipelineId?: string(name='PipelineId', description='The ID of the queue that processed the task.', example='****d80e4e4044975745c14b****'),
  requestId?: string(name='RequestId', description='The ID of the API request that created this task.', example='7B117AF5-2A1******'),
  state?: string(name='State', description='The task status.

*   Inited: Initialized
*   Running
*   Complete
*   Error
*   Cancelled', example='Finished'),
  userData?: string(name='UserData', description='The user-defined data.', example='{}'),
}

model MediaConvertJobConfig {
  inputs?: [ 
    {
      inputFile?: {
        media?: string(name='Media', description='The URL or ID of the media asset file.
- When Type is set to OSS, the value is a URL that supports the OSS or HTTP protocol. Do not include signature parameters. Otherwise, permission verification may fail. 
- When Type is set to Media, the value is a media asset ID. By default, the source stream is used as the input.', example='http://bucket.loction.aliyuncs.com/path/to/video.mp4'),
        type?: string(name='Type', description='The media file type. Valid values:
- OSS: OSS file.
- Media: Media asset file.', example='OSS'),
      }(name='InputFile', description='The input file.'),
      name?: string(name='Name', description='The name of the input file. This name can be referenced when InputRef is used in Output.', example='InputVideo'),
    }
  ](name='Inputs', description='The list of inputs for the transcoding job.'),
  jobName?: string(name='JobName', description='The job name.
- The maximum length is 64 bytes.', example='Name'),
  outputGroups?: [ 
    {
      groupConfig?: {
        manifestExtend?: {
          excludes?: [ 
            {
              language?: string(name='Language', description='Filters items based on the Language field of the stream. This field follows the RFC 5646 standard.', example='en'),
              name?: string(name='Name', description='Filters items based on the Name field of the stream.', example='audio-1'),
              type?: string(name='Type', description='Filters items based on the Type field of the stream. Valid values:
- Audio.
- Subtitle.', example='Audio'),
            }
          ](name='Excludes', description='The conditions used to exclude streams from the referenced manifest file. The AND logic is used within a condition, and the OR logic is used between conditions for filtering.'),
          inputRef?: string(name='InputRef', description='The referenced manifest file. The value is the Name of the Input.', example='Input-Manifest'),
        }(name='ManifestExtend', description='The extended configuration of the manifest file. This feature allows you to reference an existing manifest file and generate a new manifest file by combining it with the current output group results.'),
        manifestName?: string(name='ManifestName', description='The name of the manifest file. When Type is set to Hls or Dash, this parameter specifies the file name of the generated manifest file.', example='manifest'),
        outputFileBase?: {
          media?: string(name='Media', description='The media asset of the file.
- When Type is set to OSS, the value is a URL that supports the OSS and HTTP protocols.
- When Type is set to Media, the value is a media asset ID. By default, the source stream is used as the input.', example='oss://bucket/path/to/dir'),
          type?: string(name='Type', description='The media object type. Valid values:
- OSS: Alibaba Cloud OSS file.
- Media: Media asset.', example='OSS'),
        }(name='OutputFileBase', description='The output directory of the group. All files generated by this OutputGroup are stored in this directory.'),
        type?: string(name='Type', description='The output group type. Valid values:
- File: Independent file.
- Hls: HTTP Live Streaming (HLS) protocol file that generates an adaptive streaming playlist.', example='Hls'),
      }(name='GroupConfig', description='The group information configuration.'),
      name?: string(name='Name', description='The name of the output group.', example='hls-group'),
      outputs?: [ 
        {
          features?: string(name='Features', description='The feature parameters. For more information, see [MediaConvertJobFeature](https://help.aliyun.com/document_detail/2979993.html).', example='{}'),
          hlsGroupConfig?: {
            audioGroup?: string(name='AudioGroup', description='The audio group referenced by this video stream. This parameter takes effect when Type is set to video.
Default value: audio.', example='audio'),
            autoSelect?: string(name='AutoSelect', description='Specifies whether to automatically select the stream. This parameter takes effect when Type is set to audio or subtitle.', example='true'),
            forced?: string(name='Forced', description='Specifies whether to force the display of the stream. This parameter takes effect when Type is set to audio or subtitle.', example='true'),
            group?: string(name='Group', description='The GROUP_ID attribute of this output stream in the HLS manifest. This attribute takes effect when Type is set to audio or subtitle.
Default value: the same as the value of Type.', example='audio'),
            isDefault?: string(name='IsDefault', description='Specifies whether to set the stream as the default stream. This parameter takes effect when Type is set to audio or subtitle. Only one default stream is allowed in the same group.', example='false'),
            language?: string(name='Language', description='The LANGUAGE attribute of this output stream in the HLS manifest. This attribute takes effect when Type is set to audio or subtitle and must follow the RFC 5646 standard.', example='zh'),
            name?: string(name='Name', description='The NAME attribute of this output stream in the HLS manifest. This parameter is **required** when Type is set to audio or subtitle.', example='audio'),
            subtitleGroup?: string(name='SubtitleGroup', description='The subtitle group referenced by this video stream. This parameter takes effect when Type is set to video or hybrid.
Default value: subtitle.', example='subtitle'),
            type?: string(name='Type', description='Specifies the output stream type. Valid values:
- video: Video stream. Only video-related settings are retained during processing.
- audio: Audio stream. Only audio-related settings are retained during processing.
- subtitle: Subtitle stream. Only subtitle-related settings are retained during processing.
- hybrid: Hybrid stream. Both audio- and video-related settings are retained during processing.
Default value: hybrid.', example='hybrid'),
          }(name='HlsGroupConfig', description='The HLS group configuration. This parameter configures the behavior of the current stream in the manifest. This parameter takes effect only when the group type is Hls.'),
          name?: string(name='Name', description='The name of the transcoding output. This name is used only to label the output.', example='group-output'),
          outputFileName?: string(name='OutputFileName', description='The file name of the transcoding output. This parameter is used together with OutputFileBase in GroupConfig.', example='720p.mp4'),
          overrideParams?: string(name='OverrideParams', description='The override parameters in JSON string format. This parameter allows you to override the parameters associated with the transcoding template.', example='{}'),
          priority?: int32(name='Priority', description='The priority. A larger value indicates a higher priority. Valid values: 1 to 10. Default value: 6.', example='6'),
          templateId?: string(name='TemplateId', description='The ID of the transcoding template.', example='****96e8864746a0b6f3****'),
        }
      ](name='Outputs', description='The list of single-output transcoding configurations. Each configuration in the array represents an output stream file.'),
    }
  ](name='OutputGroups', description='The list of output group configurations for the transcoding job.'),
}

