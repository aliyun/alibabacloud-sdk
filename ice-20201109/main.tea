  finishTime?: string(name='FinishTime', description='The time the task finished processing, in UTC format (*yyyy-MM-dd*T*HH:mm:ss*Z).', example='2024-12-07T13:01:07Z'),
  jobId?: string(name='JobId', description='The ID of the task.', example='****d80e4e4044975745c14b****'),
