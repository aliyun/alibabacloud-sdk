model MediaConvertOutputGroupDetail {
  code?: string(name='Code', description='The error code for the failed output group task.', example='InvalidParameter.ResourceContentBad'),
  createTime?: string(name='CreateTime', description='The time the task was created.', example='2025-03-21T01:48:41Z'),
  finishTime?: string(name='FinishTime', description='The end time of the task.', example='2025-03-21T01:48:41Z'),
  message?: string(name='Message', description='The reason for a task failure.', example='The resource operated "InputFile" is bad'),
  name?: string(name='Name', description='The name of the output group.', example='hls-group'),
  outputs?: [
    MediaConvertOutputDetail
  ](name='Outputs', description='The output details.'),
  status?: string(name='Status', description='The status of the output group task.

*   Init: The task is submitted.
*   Running
*   Success
*   Failed
*   Skipped', example='Success'),
  taskId?: string(name='TaskId', description='The ID of the output group task.', example='******22dad741d086a50325f9******'),
}

model MediaConvertOutputGroupOutput {
  features?: string(name='Features', description='The feature parameters.', example='{}'),
  name?: string(name='Name', description='A name to label this output. This is for identification purposes only and does not affect the filename.', example='group-output'),
  outputFileName?: string(name='OutputFileName', description='The filename for this output. This path is relative to OutputFileBase defined in MediaConvertOutputGroupConfig. The final output path is {OutputFileBase}/{OutputFileName}.', example='720p.mp4'),
  overrideParams?: string(name='OverrideParams', description='A JSON string containing parameters to override the settings from the associated transcoding template.', example='{}'),
  priority?: int32(name='Priority', description='The processing priority for this output. Valid values: 1 to 10. A higher value indicates higher priority. Default value: 6.', example='6'),
  templateId?: string(name='TemplateId', description='The ID of the transcoding template.', example='****96e8864746a0b6f3****'),
}

model MediaConvertSegment {
  duration?: int32(name='Duration', description='The length of the segment.

*   Unit: seconds.
*   Valid values: [1,60].
*   Default value: 10. A value of 10 will create segments at the 10s, 20s, 30s, and 40s marks of the video.', example='10'),
  forceSegTime?: string(name='ForceSegTime', description='The points in time at which the video is forcibly segmented. Separate multiple points with commas (,). You can specify up to 10 points.

*   Format: {Point in time},{Point in time},{Point in time}.
*   Type: decimal. This parameter supports up to three decimal places.
*   Unit: seconds.
*   Example: 1,2,4,6,10,14,18, which specifies that the video is forcibly segmented at the 1st, 2nd, 4th, 6th, 10th, 14th, and 18th seconds.', example='1,2'),
}

model MediaConvertTransConfig {
  adjDarMethod?: string(name='AdjDarMethod', description='The method for adjusting the resolution. This parameter takes effect only if both the Width and Height parameters are specified. You can use this parameter together with the LongShortMode parameter.

*   Valid values: rescale, crop, pad, and none.
*   Default value: none.
*', example='rescale'),
  isCheckAudioBitrate?: boolean(name='IsCheckAudioBitrate', description='Specifies whether to check the audio bitrate. Mutually exclusive with IsCheckVideoBitrateFail. IsCheckVideoBitrateFail has a higher priority.

*   true: checks the audio bitrate. If the source bitrate is lower than the target, the task will transcode using the source bitrate.

*   false: does not check the audio bitrate.

*   Default value:

    *   If this parameter is not specified and the codec of the output audio is different from that of the input audio, the default value is false.
    *   If this parameter is not specified and the codec of the output audio is the same as that of the input audio, the default value is true.'),
  isCheckAudioBitrateFail?: boolean(name='IsCheckAudioBitrateFail', description='Specifies whether to check the audio bitrate. Mutually exclusive with IsCheckAudioBitrate. This parameter has a higher priority.

*   true: checks the audio bitrate. If the source bitrate is lower than the target, the task will fail.
*   false: does not check the audio bitrate.
*   Default value: false.'),
  isCheckReso?: boolean(name='IsCheckReso', description='Specifies whether to check the video resolution. Mutually exclusive with IsCheckResoFail. IsCheckResoFail has a higher priority.

*   true: checks the video resolution. If the source resolution (width or height) is smaller than the target, the task will transcode using the source resolution.
*   false: does not check the video resolution.
*   Default value: false.'),
  isCheckResoFail?: boolean(name='IsCheckResoFail', description='Specifies whether to check the video resolution. Mutually exclusive with IsCheckReso. This parameter has a higher priority.

*   true: checks the video resolution. If the source resolution (width or height) is smaller than the target, the task will fail.
*   false: does not check the video resolution.
*   Default value: false.'),
  isCheckVideoBitrate?: boolean(name='IsCheckVideoBitrate', description='Specifies whether to check the video bitrate. Mutually exclusive with IsCheckVideoBitrateFail. IsCheckVideoBitrateFail has a higher priority.

*   true: checks the video bitrate. If the source bitrate is lower than the target, the task will transcode using the source bitrate.
*   false: does not check the video bitrate.
*   Default value: false.'),
  isCheckVideoBitrateFail?: boolean(name='IsCheckVideoBitrateFail', description='Specifies whether to check the video bitrate. Mutually exclusive with IsCheckVideoBitrate. This parameter has a higher priority.

*   true: checks the video bitrate. If the source bitrate is lower than the target, the task will fail.
*   false: does not check the video bitrate.
*   Default value: false.'),
  transMode?: string(name='TransMode', description='The video bitrate control mode. This is only valid for H.264, H.265, and AV1 codecs and must be used with the correct Bitrate or Crf settings. Valid values:

*   CBR: Constant bitrate mode.
*   onepass: Typically used for Average bitrate mode (ABR). Faster than twopass.
*   twopass: Typically used for variable bitrate mode (VBR). Slower than onepass.
*   fixCRF: Constant Rate Factor (quality-based) mode.
*   If you specify the Bitrate parameter, the default value of this parameter is onepass. If you do not specify the Bitrate parameter, the default value of this parameter is fixCRF, and the default value of the Crf parameter is used.', example='onepass'),
}

model MediaConvertVideo {
  bitrate?: int32(name='Bitrate', description='The average bitrate of the output. If you use the CRB, ABR, or VBR bitrate control mode, you must specify Bitrate, and you must set TransMode to a valid value.

*   Unit: Kbps.
*   Valid values: -1 and [10,50000]. A value of -1 indicates that the original bitrate of the input is used.

Best practices:

*   CBR: Set TransMode to CBR and Bitrate, Maxrate, and Bufsize to the same value.
*   ABR: Set TransMode to onepass and specify Bitrate. You can also specify Maxrate and Bufsize to control the bitrate range.
*   VBR: Set TransMode to twopass and specify Maxrate/BitrateBnd and Bufsize.', example='6000'),
  bufsize?: int32(name='Bufsize', description='The buffer size. It controls bitrate fluctuations. A larger value allows for more bitrate variation and potentially higher video quality.

*   Unit: Kbps.
*   Valid values: [1000,128000].
*   Default value: 6000.', example='20000'),
  codec?: string(name='Codec', description='The video codec.

*   Valid values: H.264, H.265, AV1, GIF, and WEBP.
*   Default value: H.264.', example='H.264'),
  crf?: any(name='Crf', description='The quality control factor. To use the CRF mode, you must specify Crf and set TransMode to fixCRF. A larger value means lower quality and a higher compression ratio.

*   Valid values: [20,51].
*   If Codec is set to H.264, the default value is 23. If Codec is set to H.265, the default value is 26. If Codec is set to AV1, the default value is 32.

Best Practice:

*   A value of 0 specifies lossless quality. A value of 51 specifies the worst quality. A recommended range is [23, 29]. You can adjust the value based on the complexity of the image. If you increase the value by six, the bitrate is reduced by half. Under the same definition, you can set the value for an animated cartoon higher than that for a shot video.
*   CRF targets perceptual quality, not a fixed bitrate. Use it with Maxrate and Bufsize to control bitrate fluctuations.', example='23'),
  crop?: string(name='Crop', description='Crops the video frame. You can set automatic black border removal or custom cropping.

*   Specify this parameter if the input resolution is greater than the output resolution. Do not specify AdjDarMethod if this parameter is specified.

*   To automatically remove black borders, set this parameter to border.

*   To use custom cropping, set the parameter in the format of {width}:{height}:{left}:{top}.

    *   width: the width of the output video.
    *   height: the height of the output video.
    *   left: the distance between the left border of the output and that of the original frame.
    *   top: the distance between the top border of the output and that of the original frame.

Example: 1920:800:0:140.', example='1920:800:0:140'),
  fps?: any(name='Fps', description='The frame rate of the video stream.

*   Unit: frames per second (FPS).
*   Valid values: (0,60].
*   Default value: the frame rate of the input file. If the original frame rate exceeds 60 FPS, 60 is used.
*   Recommended values: 24, 25, and 30.', example='25'),
  gop?: any(name='Gop', description='The keyframe interval.

*   Set by time: The time interval, in seconds. Valid values: [1,100000].
*   Set by frame count: The number of frames. Valid values: [1,100000].
*   Default value: 10s.

Best practice: Set this parameter to 2-7s to improve the Time-to-First-Frame and seeking performance.', example='10s'),
  height?: int32(name='Height', description='The height or short edge of the output. If LongShortMode is set to false or left empty, this parameter specifies the height of the output. If LongShortMode is set to true, this parameter specifies the short edge of the output.

*   Unit: pixel.

*   Valid values: [128,4096]. The value must be an even number.

*   Default value:

    *   If neither Width nor Height is specified, the dimension of the input is used.
    *   If only Width is specified, Height is auto-scaled.', example='1080'),
  longShortMode?: boolean(name='LongShortMode', description='Specifies whether to enable orientation-adaptive scaling. This parameter takes effect if at least one of the Width and Height parameters is specified. Valid values:

*   true
*   false
*   Default value: false.

Best practice: Enable this feature when your inputs include both horizontal and vertical videos. This prevents videos from stretching.', example='true'),
  maxFps?: any(name='MaxFps', description='The maximum frame rate.', example='25'),
  maxrate?: int32(name='Maxrate', description='The maximum bitrate of the output.

*   Unit: Kbps.
*   Valid values: [10,50000].', example='10000'),
  pad?: string(name='Pad', description='The black borders added to the video.

*   Specify this parameter if the input resolution is smaller than the output resolution. If you specify this parameter, do not specify IsCheckReso, IsCheckResoFail, or AdjDarMethod.

*   Format: {width}:{height}:{left}:{top}.

    *   width: the width of the output video.
    *   height: the height of the output video.
    *   left: the distance between the left border of the output and that of the original frame.
    *   top: the distance between the top border of the output and that of the original frame.

Example: 1920:1080:0:140.', example='1920:1080:0:140'),
  profile?: string(name='Profile', description='The codec profile.

*   This parameter takes effect only if Codec is set to H.264.
*   Valid values: baseline, main, and high.
*   Default value: high.

Best practice: For multi-bitrate streaming, use baseline for the lowest quality rendition to ensure maximum compatibility with older devices. Use main or high for other renditions.', example='high'),
  qscale?: int32(name='Qscale', description='The video quality scale. This parameter applies to VBR mode. A higher value means lower video quality and a higher compression ratio.

*   This parameter takes effect only if Codec is set to H.264.
*   Valid values: [0,51].', example='13'),
  remove?: boolean(name='Remove', description='Specifies whether to delete the video stream. Valid values:

*   true: deletes the video stream. All video-related parameters are invalid.
*   false: retains the video stream.
*   Default value: false.', example='false'),
  scanMode?: string(name='ScanMode', description='The scan mode. Valid values:

*   If you leave this parameter empty, the output follows the source\\\\"s original scan mode.
*   auto: automatic deinterlacing
*   progressive
*   interlaced
*   By default, this parameter is left empty.

Best practice: The interlaced scan mode saves data traffic than the progressive scan mode but provides poor image quality. Therefore, the latter is commonly used in mainstream video production.

*   If you set ScanMode to progressive or interlaced, but this scan mode does not match that of the input, the video fails to be transcoded.
*   To improve compatibility, leave this parameter empty or set it to auto.', example='auto'),
  width?: int32(name='Width', description='The width or long edge of the output. If LongShortMode is set to false or left empty, this parameter specifies the width of the output. If LongShortMode is set to true, this parameter specifies the long edge of the output.

*   Unit: pixel.

*   Valid values: [128,4096]. The value must be an even number.

*   Default value:

    *   If neither Width nor Height is specified, the dimension of the input is used.
    *   If only Height is specified, Width is auto-scaled.', example='1920'),
}

model MediaConvertVolume {
  integratedLoudnessTarget?: int32(name='IntegratedLoudnessTarget', description='The target volume.
- This parameter takes effect only when Method is set to dynamic.
- Unit: dB.
- Value range: -70 to -5.
- Default value: -6.', example='-6'),
  level?: int32(name='Level', description='The volume increase relative to the input audio.
- This parameter takes effect only when Method is set to linear.
- Unit: dB.
- Value range: up to 20 dB.
- Default value: -20 dB.', example='-20'),
  loudnessRangeTarget?: int32(name='LoudnessRangeTarget', description='The fluctuation range relative to the target volume.
- This parameter takes effect only when Method is set to dynamic.
- Unit: dB.
- Value range: 1 to 20.
- Default value: 8.', example='8'),
  method?: string(name='Method', description='The volume adjustment method.
- auto: Automatic adjustment.
- dynamic: Dynamic adjustment.
- linear: Linear adjustment.
- Default value: dynamic.', example='dynamic'),
  truePeak?: int32(name='TruePeak', description='The peak volume.
- This parameter takes effect only when Method is set to dynamic.
- Unit: dB.
- Value range: -9 to 0.
- Default value: -1.', example='-1'),
}

model MediaObject {
  media?: string(name='Media', description='The file media asset.
- If Type is OSS, Media is a URL and supports the OSS and HTTP protocols.     
- If Type is Media, Media is a media asset ID.', example='http://bucket.loction.aliyuncs.com/path/to/video.mp4'),
  type?: string(name='Type', description='The input type. Valid values:
- OSS: Alibaba Cloud OSS file 
- Media: Media asset
- ExternalURL: External URL, not currently publicly supported', example='OSS'),
}

model MediaQualityAnalysisJob {
  createTime?: string(name='CreateTime'),
  finishTime?: string(name='FinishTime'),
  input?: {
    media?: string(name='Media'),
    type?: string(name='Type'),
  }(name='Input'),
  jobId?: string(name='JobId'),
  name?: string(name='Name'),
  scheduleConfig?: {
    pipelineId?: string(name='PipelineId'),
    priority?: int32(name='Priority'),
  }(name='ScheduleConfig'),
  state?: string(name='State'),
  templateConfig?: {
    templateId?: string(name='TemplateId'),
  }(name='TemplateConfig'),
  userData?: string(name='UserData'),
  vqaResult?: MediaQualityAnalysisJobVqaResult(name='VqaResult'),
}

model MediaQualityAnalysisJobVqaResult {
  block?: MediaQualityAnalysisJobVqaScoreDetail(name='Block'),
  color?: MediaQualityAnalysisJobVqaScoreDetail(name='Color'),
  detail?: MediaQualityAnalysisJobVqaScoreDetail(name='Detail'),
  noise?: MediaQualityAnalysisJobVqaScoreDetail(name='Noise'),
  scoreResult?: {
    block?: {
      intensityValue?: double(name='IntensityValue'),
      perceptualScore?: double(name='PerceptualScore'),
    }(name='Block'),
    color?: {
      intensityValue?: double(name='IntensityValue'),
      perceptualScore?: double(name='PerceptualScore'),
    }(name='Color'),
    detail?: {
      intensityValue?: double(name='IntensityValue'),
      perceptualScore?: double(name='PerceptualScore'),
    }(name='Detail'),
    noise?: {
      intensityValue?: double(name='IntensityValue'),
      perceptualScore?: double(name='PerceptualScore'),
    }(name='Noise'),
    score?: double(name='Score'),
    sharp?: {
      intensityValue?: double(name='IntensityValue'),
      perceptualScore?: double(name='PerceptualScore'),
    }(name='Sharp'),
  }(name='ScoreResult'),
  sharp?: MediaQualityAnalysisJobVqaScoreDetail(name='Sharp'),
  state?: string(name='State'),
}

model MediaQualityAnalysisJobVqaScoreDetail {
  intensityValue?: double(name='IntensityValue'),
  perceptualScore?: double(name='PerceptualScore'),
}

model Program {
  adBreaks?: [ 
    {
      channelName?: string(name='ChannelName', description='The name of the channel.', example='MyChannel'),
      messageType?: string(name='MessageType', description='MessageType', example='SPLICE_INSERT'),
      offsetMillis?: long(name='OffsetMillis', description='The offset.', example='1000'),
      programName?: string(name='ProgramName', description='The name of the program.', example='program_name'),
      sourceLocationName?: string(name='SourceLocationName', description='The name of the source location.', example='MySourceLocation'),
      sourceName?: string(name='SourceName', description='The name of the source.', example='MyAdSource'),
      spliceInsertSettings?: string(name='SpliceInsertSettings', description='The SpliceInsert configurations.', example='{"AvailNumber":0,"AvailExpected":0,"SpliceEventID":1,"UniqueProgramID":0}'),
      timeSignalSettings?: string(name='TimeSignalSettings', description='The TimeSignal configurations.', example='{"segmentationEventID":0,"segmentationUPIDType":14,"segmentationUPID":"upid","segmentationTypeID":48,"segmentNumber":0,"segmentsExpected":0,"subSegmentNumber":1,"subSegmentsExpected":0}'),
    }
  ](name='AdBreaks', description='The ad breaks.'),
  arn?: string(name='Arn', description='The ARN of the program.', example='acs:ims:mediaweaver:<regionId>:<userId>:program/myChannel/MyProgram'),
  channelName?: string(name='ChannelName', description='The name of the channel.', example='MyChannel'),
  clipRange?: string(name='ClipRange', description='The information about the clip.', example='{StartOffsetMillis: 213123, EndOffsetMillis: 213134}'),
  gmtCreate?: string(name='GmtCreate', description='The creation time.', example='2024-04-02T00:58:19Z'),
  gmtModified?: string(name='GmtModified', description='The modification time.', example='2024-04-02T00:58:19Z'),
  programName?: string(name='ProgramName', description='The name of the program.', example='program1'),
  sourceLocationName?: string(name='SourceLocationName', description='The name of the source location.', example='MySourceLocation'),
  sourceName?: string(name='SourceName', description='The name of the source.', example='MySource'),
  sourceType?: string(name='SourceType', description='The source type.', example='vodSource'),
  transition?: string(name='Transition', description='The program transition method.', example='{"Type": "RELATIVE", "RelativePosition": "AFTER_PROGRAM", "RelativeProgram": "program2"}'),
}

model ScheduleData {
  adBreaks?: [ 
    {
      messageType?: string(name='MessageType', description='MessageType', example='SPLICE_INSERT'),
      offsetMillis?: string(name='OffsetMillis', description='The time offset.', example='100000'),
      sourceLocationName?: string(name='SourceLocationName', description='The name of the source location.', example='MySourceLocation'),
      sourceName?: string(name='SourceName', description='The name of the source.', example='MySource'),
      spliceInsertSettings?: string(name='SpliceInsertSettings', description='The SpliceInsert configurations.', example='{"AvailNumber":0,"AvailExpected":0,"SpliceEventID":1,"UniqueProgramID":0}'),
      timeSignalSettings?: string(name='TimeSignalSettings', description='The TimeSignal configurations.', example='{"segmentationEventID":0,"segmentationUPIDType":14,"segmentationUPID":"upid","segmentationTypeID":48,"segmentNumber":0,"segmentsExpected":0,"subSegmentNumber":1,"subSegmentsExpected":0}'),
    }
  ](name='AdBreaks', description='The information about ad breaks.'),
  approximateDurationSeconds?: long(name='ApproximateDurationSeconds', description='The scheduled playback duration.', example='100000'),
  approximateStartTime?: string(name='ApproximateStartTime', description='The scheduled start time.', example='1989128002313'),
  entryType?: string(name='EntryType', description='The entry type.

Valid values:

*   FillerSlate
*   program', example='program'),
  programName?: string(name='ProgramName', description='The name of the program.', example='program1'),
  sourceLocationName?: string(name='SourceLocationName', description='The name of the source location.', example='MySourceLocation'),
  sourceName?: string(name='SourceName', description='The name of the source.', example='MySource'),
  sourceType?: string(name='SourceType', description='The source type.', example='vodSource'),
}

model Source {
  arn?: string(name='Arn', description='The ARN of the source.', example='acs:ims:mediaweaver:<regionId>:<userId>:vodSource/mySourceLocation/mySource'),
  gmtCreate?: string(name='GmtCreate', description='The creation time.', example='2024-11-07T10:12:01Z'),
  gmtModified?: string(name='GmtModified', description='The modification time.', example='2024-11-07T10:12:01Z'),
  httpPackageConfigurations?: string(name='HttpPackageConfigurations', description='The source configuration.', example='[{
	"sourceGroupName": "mySourceGroup-1",
	"relativePath": "group1/hls.m3u8",
	"packageType": "hls"
}]'),
  sourceLocationName?: string(name='SourceLocationName', description='The name of the source location.', example='MySourceLocation'),
  sourceName?: string(name='SourceName', description='The name of the source.', example='MyVodSource'),
  sourceType?: string(name='SourceType', description='The source type. Valid values: vodSource and liveSource.', example='vodSource'),
  state?: int32(name='State', description='The status of the source. 0: normal. 1: deleted.', example='0'),
}

model SourceLocation {
  arn?: string(name='Arn', description='The ARN of the source location.', example='acs:ims:mediaweaver:<regionId>:<UserId>:sourcelocation/MySourceLocation'),
  baseUrl?: string(name='BaseUrl', description='The base URL of the source location.', example='http://xxxx.com'),
  gmtCreate?: string(name='GmtCreate', description='The creation time.', example='2023-09-12T07:15:52Z'),
  gmtModified?: string(name='GmtModified', description='The modification time.', example='2023-10-22T10:49:14Z'),
  segmentDeliveryConfigurations?: string(name='SegmentDeliveryConfigurations', description='The segment delivery server configurations.', example='http://segmentdelivery.com'),
  sourceLocationName?: string(name='SourceLocationName', description='The name of the source location.', example='MySourceLocation'),
  state?: int32(name='State', description='The status of the source location. 0: normal. 1: deleted.', example='0'),
}

model TranspositionResult {
  targetLanguage?: string(name='TargetLanguage', description='- The target language for translation transposition. For more information, see the list of target languages for video translation.
- This field is only used in video translation scenarios.', example='zh'),
  translatedText?: string(name='TranslatedText', description='- The text after translation transposition, which is the expected output text after the matched hot word is translated. The maximum length is 100 characters.
- This field is only used in scenarios related to the translation feature.', example='hello'),
}

model VodPackagingAsset {
  assetName?: string(name='AssetName', description='The asset name. It must be unique per user, up to 128 characters in length, and match the format [A-Za-z0-9_-]+.', example='example-asset'),
  contentId?: string(name='ContentId', description='The content ID in the DRM system. The format is [A-Za-z0-9_-]+, and the maximum length is 256 characters.', example='example-content'),
  createTime?: string(name='CreateTime', description='The creation time. The format is 2024-11-21T06:45:32Z, which indicates 2024-11-21 14:45:32 in UTC+8.', example='2024-11-21T06:45:32Z'),
  groupName?: string(name='GroupName', description='The name of the packaging group.'),
  input?: {
    media?: string(name='Media', description='The input media asset. Currently, only OSS paths are supported, such as OSS://test-bucket/video/202208/test.m3u8. Only inputs with the .m3u8 extension are supported.'),
    type?: string(name='Type', description='The input type. Currently, only OSS is supported.'),
  }(name='Input', description='The input configuration of the asset.'),
}

model VodPackagingConfig {
  drmProvider?: {
    encryptionMethod?: string(name='EncryptionMethod', description='The encryption algorithm. Valid values:
- AES_128
- SAMPLE_AES'),
    IV?: string(name='IV', description='The optional 128-bit (16-byte) hexadecimal value represented by a 32-character string, which is used with the key for encrypted data blocks. If you do not specify this value, MediaPackage creates a constant initialization vector (IV). Default value: empty. If specified, the value is passed through to the provider as a constant initialization vector.', example='0123456789abcdef0123456789abcdef'),
    systemIds?: [ string ](name='SystemIds', description='The DRM system IDs. The number of system IDs depends on the protocol type used:
- DASH: up to two
- HLS: one
- HLS_CMAF: up to two
Only the following three DRM systems are supported: Apple FairPlay, Google Widevine, and Microsoft PlayReady. The corresponding system IDs are:
Apple FairPlay:
94ce86fb-07ff-4f43-adb8-93d2fa968ca2
Google Widevine:
edef8ba9-79d6-4ace-a3c8-27dcd51d21ed
Microsoft PlayReady:
9a04f079-9840-4286-ab92-e65be0885f95.'),
    url?: string(name='Url', description='The URL of the DRM key provider.'),
  }(name='DrmProvider', description='The DRM encryption provider configuration.'),
  manifestName?: string(name='ManifestName', description='The manifest name. The value must match the regular expression [A-Za-z0-9_]+ and cannot exceed 128 characters in length.'),
  segmentDuration?: long(name='SegmentDuration', description='The duration of each segment in seconds. The actual segment duration is rounded to the nearest multiple of the source segment duration. Valid values: 1 to 30.', example='6'),
  streamSelection?: {
    maxVideoBitsPerSecond?: long(name='MaxVideoBitsPerSecond', description='The maximum video stream bitrate in bps.'),
    minVideoBitsPerSecond?: long(name='MinVideoBitsPerSecond', description='The minimum video stream bitrate in bps.'),
    streamOrder?: string(name='StreamOrder', description='The stream sorting rule. Valid values:
- ORIGINAL: Keeps the input sequence number.
- VIDEO_BITRATE_ASCENDING: Sorts streams by video bitrate in ascending order.
- VIDEO_BITRATE_DESCENDING: Sorts streams by video bitrate in descending order.'),
  }(name='StreamSelection', description='The stream selection configuration for packaging output.'),
}

model VodPackagingConfiguration {
  configurationName?: string(name='ConfigurationName', description='The name of the packaging configuration. The name can be up to 128 characters in length, must match the [A-Za-z0-9_-]+ format, and must be unique per user.', example='example-config'),
  createTime?: string(name='CreateTime', description='The creation time.'),
  description?: string(name='Description', description='The description of the packaging configuration.'),
  groupName?: string(name='GroupName', description='The name of the packaging group. The name can be up to 128 characters in length and must match the [A-Za-z0-9_-]+ format.', example='example-group'),
  packageConfig?: VodPackagingConfig(name='PackageConfig'),
  protocol?: string(name='Protocol', description='The packaging type. Valid values:
- HLS: HLS protocol playback format.
- HLS_CMAF: CMAF playback format for the HLS protocol.
- DASH: DASH protocol playback format.', example='HLS'),
}

model VodPackagingGroup {
  approximateAssetCount?: long(name='ApproximateAssetCount', description='The approximate number of packaging assets in the packaging group.'),
