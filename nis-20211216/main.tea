  beginTime?: long(name='BeginTime', description='The start time, in **ms**, in **UNIX** timestamp format. If not specified, the most recent 1 hour is queried by default. The earliest start time is 7 days ago.', example='1638239092000'),
  dimensions?: [ 
    {
      name?: string(name='Name', description='The name of the filter condition.', example='instanceId'),
      value?: string(name='Value', description='The value of the filter condition.', example='eip-sample*'),
