  poolKey?: string(name='PoolKey', description='The key of the number pool. You can obtain the **number pool key** on the [Number Pool Management](https://dyplsnext.console.aliyun.com/number-pool?spm=a2c4g.11186623.0.0.7e6449bbtiHP8m) page in the Privacy Protection console.', example='FC2256****'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount'),
  resourceOwnerId?: long(name='ResourceOwnerId'),
  ringConfig?: string(name='RingConfig', description='Sets the corporate color ringback tone (CRBT) played during a dial-up to Number X after the AXN privacy number is attached.

