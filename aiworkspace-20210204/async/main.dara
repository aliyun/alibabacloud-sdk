  query?: string(name='Query', description='Fuzzy searches by image name and description.', example='name', position='Query'),
  sortBy?: string(name='SortBy', description='The sort field for a paged query. Currently, the GmtCreateTime field is used for sorting.', example='GmtCreateTime', position='Query'),
