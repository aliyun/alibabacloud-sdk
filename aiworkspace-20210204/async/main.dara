  tagUpdateTime?: string(name='TagUpdateTime', description='The last modification time of the tags in ISO 8601 format.

Use the UTC time format: yyyy-MM-ddTHH:mmZ', example='2021-01-12T14:36:01.000Z'),
  tags?: string(name='Tags', description='The collection of tags for this metadata, including:
- Algorithm tag groups:
  - ai: A list of tag names summarized from all algorithm tagging tasks for a single metadata entry.
- User-defined tag groups:
  - user: A list of tag names added by the user for a single metadata entry.
  - user-delete-ai-tags: A list of tag names to be deleted by the user from the algorithm tag group for a single metadata entry.', example='{
    "ai":
    [
