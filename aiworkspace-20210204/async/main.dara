  pageSize?: int32(name='PageSize', description='The number of entries per page.', example='10', position='Query'),
  pageToken?: long(name='PageToken', description='The paging token. It starts from 0. The default is 0.', example='0', position='Query'),
  sortBy?: string(name='SortBy', description='The field to use for sorting in a paged query. Currently, only the GmtCreateTime field is supported for sorting.', example='GmtCreateTime', position='Query'),
  verbose?: boolean(name='Verbose', description='Specifies whether to retrieve the LatestRun information related to the experiment.', example='false', position='Query'),
  workspaceId?: string(name='WorkspaceId', description='The ID of the workspace where the experiment resides. For more information about how to obtain a workspace ID, see [ListWorkspaces](https://help.aliyun.com/document_detail/449124.html).

> If you do not specify a workspace ID, the system returns the list of experiments in the default workspace.', example='1517**', position='Query'),
}

