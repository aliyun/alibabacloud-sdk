model GetDatasetFileMetasStatisticsRequest {
  datasetId: string(name='DatasetId', description='The dataset ID. For more information about how to obtain a dataset ID, see [ListDatasets](https://help.aliyun.com/document_detail/457222.html).

This parameter is required.', example='d-rbvg5wz****c9ks92', position='Path'),
  aggregateBy?: string(name='AggregateBy', description='The metadata field used for statistical aggregation. The value is not case-sensitive. If you do not specify this parameter, the total number of file metadata entries in the dataset is returned, and the aggregation list is not returned.
Valid values:

- filedir: The directory path of the file.

- filetype: The file type.

- tags.user: Custom user tags.

