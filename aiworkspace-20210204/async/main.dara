        "Water horse",
        "Sunny day"
    ],
    "user":
    [
        "Everett",
        "Intelligent driving Dataset 1",
        "Cloudy day"
    ],
    "user-delete-ai-tags":
    [
        "Sunny day"
    ]
}'),
  uri?: string(name='Uri', description='The unique URI of the file. This URI records the unique path of the file. File paths in OSS and NAS are supported.
