model CreateMmsTimerRequest {
  sourceId: long(name='sourceId', description='The data source ID.

This parameter is required.', example='2000015', position='Path,Body'),
  columnMapping?: map[string]string(name='columnMapping', description='A map of source column names to target column names.', position='Body'),
  enableDataMigration?: boolean(name='enableDataMigration', description='Specifies whether to migrate table data.', example='true', position='Body'),
  enableSchemaMigration?: boolean(name='enableSchemaMigration', description='Specifies whether to migrate the table schema.', example='true', position='Body'),
  enableVerification?: boolean(name='enableVerification', description='Specifies whether to enable data verification. If set to `true`, the system runs a `SELECT COUNT(*)` query on both the source and target tables and compares the row counts.', example='false', position='Body'),
  name?: string(name='name', description='The name of the scheduled task.', example='planA', position='Body'),
  others?: map[string]any(name='others', description='Other configuration settings.', position='Body'),
  partitionFilters?: map[string]string(name='partitionFilters', description='A map of table names to their corresponding partition filter expressions.', position='Body'),
  partitions?: [ long ](name='partitions', description='A list of IDs for the table partitions to migrate. This parameter takes effect only when the `type` parameter is set to `Partitions`.', position='Body'),
  scheduleType?: string(name='scheduleType', description='The schedule type for the task.', example='Daily', position='Body'),
  srcDbName?: string(name='srcDbName', description='The name of the source database.', example='src_db', position='Body'),
  tableBlackList?: [ string ](name='tableBlackList', description='A blacklist of tables to exclude from the migration. This parameter takes effect only when the `type` parameter is set to `Database`.', position='Body'),
  tableMapping?: map[string]string(name='tableMapping', description='A map of source table names to target table names.', position='Body'),
  tableWhiteList?: [ string ](name='tableWhiteList', description='A whitelist of tables to migrate. This parameter takes effect only when the `type` parameter is set to `Database`. If omitted, all tables in the source database are migrated.', position='Body'),
  tables?: [ string ](name='tables', description='A list of table names to migrate. This parameter takes effect only when the `type` parameter is set to `Tables`.', position='Body'),
  value?: string(name='value', description='The time to run the scheduled task. If `scheduleType` is set to `Daily`, the value is the time in `HH:MM` format. If `scheduleType` is set to `Hourly`, the value is the minute of the hour (`MM`).', example='12:00', position='Body'),
}

model CreateMmsTimerResponseBody = {
  data?: {
    timerId?: long(name='timerId', description='The ID of the timer.', example='1'),
  }(name='data', description='The response data.'),
  requestId?: string(name='requestId', description='The ID of the request.', example='0be3e0b716671885050924814e3623'),
}

model CreateMmsTimerResponse = {
