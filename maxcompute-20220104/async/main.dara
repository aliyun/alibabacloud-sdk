ord_time supports monthly (month) and yearly (year) billing.

- After creation, commodityData cannot be modified. To modify it, go to the MaxCompute console.', example='{"CU":50,"ord_time":"1:Month","autoRenew":false}', position='Query'),
  partNickName?: string(name='partNickName', description='>Notice: This parameter is required only for subscription quotas.', example='MyQuota', position='Query'),
}

