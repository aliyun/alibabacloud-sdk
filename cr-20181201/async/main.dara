model DiagnosisIssue {
  code?: string(name='Code', description='A unique code that identifies the issue type.', example='RepoNumOverLimit'),
  extra?: map[string]string(name='Extra', description='An object that contains additional, unstructured key-value information about the issue.'),
  firstOccurrence?: string(name='FirstOccurrence', description='The time, in ISO 8601 format, when the issue was first detected.

Use the UTC time format: yyyy-MM-ddTHH:mm:ssZ', example='2026-01-01T00:00:00+08:00'),
  lastOccurrence?: string(name='LastOccurrence', description='The time, in ISO 8601 format, when the issue was last detected.

Use the UTC time format: yyyy-MM-ddTHH:mm:ssZ', example='2026-01-01T00:30:00+08:00'),
  level?: string(name='Level', description='Specifies the severity of the issue. Valid values are `INFO`, `WARN`, and `ERROR`.', example='INFO'),
  occurrenceCount?: long(name='OccurrenceCount', description='The total number of times the issue has occurred.', example='10'),
  solution?: string(name='Solution', description='The recommended action to resolve the issue.', example='Buy repository quota'),
}

model DiagnosisTarget {
  endTime?: string(name='EndTime', description='The end of the diagnostic time window, in ISO 8601 format. Must be after `StartTime`.

Use the UTC time format: yyyy-MM-ddTHH:mm:ssZ', example='2026-01-01T00:30:00+08:00'),
  extra?: map[string]string(name='Extra', description='A map of key-value pairs providing additional context for the diagnosis.'),
  namespace?: string(name='Namespace', description='The namespace that contains the repository.', example='test_namespace'),
  relatedId?: string(name='RelatedId', description='The ID of a related operation, such as a previous diagnostic task.'),
  repository?: string(name='Repository', description='The name of the repository.', example='test_repo'),
  startTime?: string(name='StartTime', description='The start of the diagnostic time window, in ISO 8601 format.

Use the UTC time format: yyyy-MM-ddTHH:mm:ssZ', example='2026-01-01T00:00:00+08:00'),
  tag?: string(name='Tag', description='The container image tag.', example='latest'),
}

