import Credential;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'central';
  @endpointMap = {
    'cn-beijing' = 'cloudauth.cn-beijing.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('cloudauth', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model AIGCFaceVerifyRequest {
  faceContrastPicture?: string(name='FaceContrastPicture', description='The Base64-encoded photo.
> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='/9j/4AAQSkZJRgABAQAASxxxxxxx'),
  faceContrastPictureUrl?: string(name='FaceContrastPictureUrl', description='The URL of the portrait image. The URL must be a publicly accessible HTTP or HTTPS link.

> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='https://cn-shanghai-aliyun-cloudauth-xxxxxx.oss-cn-shanghai.aliyuncs.com/verify/xxxxx/xxxxx.jpeg'),
  ossBucketName?: string(name='OssBucketName', description='The name of the authorized Object Storage Service (OSS) bucket.
> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='cn-shanghai-aliyun-cloudauth-xxxxx'),
  ossObjectName?: string(name='OssObjectName', description='The name of the object in the authorized OSS bucket.
> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='verify/xxxxx/xxxxxx.jpeg'),
  outerOrderNo?: string(name='OuterOrderNo', description='The custom unique business identifier on the customer\\\\"s server, which is used for subsequent troubleshooting. The value can be up to 32 characters in length and can contain letters and digits. Make sure that the value is unique.', example='e0c34a77f5ac40a5aa5e6ed20c353888'),
  productCode?: string(name='ProductCode', description='The product solution.', example='LR_FR_AIGC'),
  sceneId?: long(name='SceneId', description='The ID of the authentication scenario. This ID is automatically generated after you create an authentication scenario in the console. For more information about how to create an authentication scenario, see Add an authentication scenario.', example='100000xxxx'),
}

model AIGCFaceVerifyResponseBody = {
  code?: string(name='Code', description='The return code. A value of 200 indicates success, and other values indicate failure.', example='200'),
  message?: string(name='Message', description='The message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E'),
  resultObject?: {
    certifyId?: string(name='CertifyId', description='The unique identifier for ID Verification.', example='91707dc296d469ad38e4c5efa6a0****'),
    result?: string(name='Result', description='The authentication result. Valid values:

- Y: The face is generated by AIGC.

- N: No AIGC-generated face is detected.', example='Y'),
    score?: string(name='Score', description='The detection score.', example='1.0000'),
  }(name='ResultObject', description='The returned result.'),
}

model AIGCFaceVerifyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AIGCFaceVerifyResponseBody(name='body'),
}

/**
 * @summary Detects AI-generated images and outputs a detection identifier.
 *
 * @param request AIGCFaceVerifyRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AIGCFaceVerifyResponse
 */
@context("aIGCFaceVerifyWithContext")
async function aIGCFaceVerifyWithOptions(request: AIGCFaceVerifyRequest, runtime: $RuntimeOptions): AIGCFaceVerifyResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.faceContrastPictureUrl)) {
    query['FaceContrastPictureUrl'] = request.faceContrastPictureUrl;
  }
  if (!$isNull(request.ossBucketName)) {
    query['OssBucketName'] = request.ossBucketName;
  }
  if (!$isNull(request.ossObjectName)) {
    query['OssObjectName'] = request.ossObjectName;
  }
  if (!$isNull(request.outerOrderNo)) {
    query['OuterOrderNo'] = request.outerOrderNo;
  }
  if (!$isNull(request.productCode)) {
    query['ProductCode'] = request.productCode;
  }
  if (!$isNull(request.sceneId)) {
    query['SceneId'] = request.sceneId;
  }
  var body : map[string]any = {};
  if (!$isNull(request.faceContrastPicture)) {
    body['FaceContrastPicture'] = request.faceContrastPicture;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'AIGCFaceVerify',
    version = '2019-03-07',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Detects AI-generated images and outputs a detection identifier.
 *
 * @param request AIGCFaceVerifyRequest
 * @return AIGCFaceVerifyResponse
 */
async function aIGCFaceVerify(request: AIGCFaceVerifyRequest): AIGCFaceVerifyResponse {
  var runtime = new $RuntimeOptions{};
  return aIGCFaceVerifyWithOptions(request, runtime);
}

model BankMetaVerifyRequest {
  bankCard?: string(name='BankCard', description='The bank card number.

- If ParamType is set to normal, enter the bank card number in plaintext.
- If ParamType is set to md5, enter all digits of the card number except the last 6 in plaintext, followed by the MD5 hash (32-character lowercase) of the last 6 digits.', example='610*************1181'),
  identifyNum?: string(name='IdentifyNum', description='The ID card number.

- This parameter is required when ProductType is set to BANK_CARD_3_META.
- If ParamType is set to normal, enter the ID card number in plaintext.
- If ParamType is set to md5, enter the first 6 digits of the ID card number in plaintext, followed by the date of birth encrypted with MD5 (32-character lowercase MD5 hash), followed by the last 4 digits of the ID card number.', example='429001********8211'),
  identityType?: string(name='IdentityType', description='The ID document type.', example='01'),
  mobile?: string(name='Mobile', description='The mobile phone number.

- This parameter is required when ProductType is set to BANK_CARD_4_META.
- If ParamType is set to normal, enter the mobile phone number in plaintext.
- If ParamType is set to md5, enter the MD5 hash (32-character lowercase) of the mobile phone number.', example='138******11'),
  paramType?: string(name='ParamType', description='The parameter type.

- normal: no encryption.
- md5: MD5 encryption.', example='normal'),
  productType?: string(name='ProductType', description='The product type.

- BANK_CARD_2_META: verifies the bank card number and name.
- BANK_CARD_3_META: verifies the bank card number, name, and ID card number.
- BANK_CARD_4_META: verifies the bank card number, name, ID card number, and mobile phone number.', example='BANK_CARD_2_META'),
  userName?: string(name='UserName', description='The name.

- If ParamType is set to normal, enter the name in plaintext.
- If ParamType is set to md5, enter the first character of the name encrypted with MD5 (32-character lowercase MD5 hash) followed by the remaining characters of the name in plaintext.', example='张*'),
  verifyMode?: string(name='VerifyMode', description='VERIFY_BANK_CARD: the bank card verification mode. Verifies whether the bank card number matches the user\\\\"s real name, ID card number, and mobile phone number.', example='VERIFY_BANK_CARD'),
}

model BankMetaVerifyResponseBody = {
  code?: string(name='Code', description='The response code. 200 indicates success. Other values indicate failure.', example='200'),
  message?: string(name='Message', description='The response message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-A***B-A3DC0DE3C83E'),
  resultObject?: {
    bizCode?: string(name='BizCode', description='The verification result.

- 1: verification passed (billed).
- 2: verification failed (billed).
- 3: no records found (not billed).', example='1'),
    subCode?: string(name='SubCode', description='The verification details.

- **101**: verification passed.
- **201**: verification failed. The cardholder information is incorrect.
- **202**: verification failed. Authentication payment is not enabled for the bank card.
- **203**: verification failed. The bank card has expired.
- **204**: verification failed. The bank card is restricted.
- **205**: verification failed. The card has been confiscated.
- **206**: verification failed. The bank card is invalid.
- **207**: verification failed. No matching issuing bank exists.
- **208**: verification failed. The card is not initialized or is a dormant card.
- **209**: verification failed. The card is fraudulent or has been retained.
- **210**: verification failed. The card has been reported lost.
- **211**: verification failed. The maximum number of password attempts has been exceeded.
- **212**: verification failed. The issuing bank does not support this transaction.
- **213**: verification failed. The card status is abnormal or the card is invalid.
- **214**: verification failed. No mobile phone number is registered.
- **215**: verification failed. The password, expiration date, or CVN2 is incorrect.
- **216**: verification failed. Other card exceptions.
- **301**: unable to verify. The bank card does not support this service.
- **302**: unable to verify. Verification failed or the bank refused verification. Contact the issuing bank.
- **303**: unable to verify. The bank card does not support mobile phone number verification.
- **304**: unable to verify. The bank card number is incorrect.
- **305**: unable to verify. Other reasons.
- **306**: unable to verify. The maximum number of verification attempts has been exceeded.', example='101'),
  }(name='ResultObject', description='The verification result.'),
}

model BankMetaVerifyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BankMetaVerifyResponseBody(name='body'),
}

