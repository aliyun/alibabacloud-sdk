  targetOssBucketName?: string(name='TargetOssBucketName', description='The name of the authorized OSS bucket.

> You can use one of the following four methods to upload the base library face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='cn-shanghai-aliyun-cloudauth-xxxxx'),
  targetOssObjectName?: string(name='TargetOssObjectName', description='The name of the object in the authorized OSS bucket.

