  };
  var params = new OpenApiUtil.Params{
    action = 'BankMetaVerify',
    version = '2019-03-07',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

