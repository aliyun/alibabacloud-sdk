model CredentialVerifyRequest {
  regionId?: string(name='RegionId', position='Host'),
  certNum?: string(name='CertNum', description='The certificate number.', example='4601*****', position='Query'),
  credName?: string(name='CredName', description='The credential name. Valid values:

- 01: personal card and certificate
  - 0101: ID card
  - 0102: bank card
  - 0104: teacher qualification certificate
  - 0107: student ID card
- 02: business scenario
  - 0201: storefront photo
  - 0202: counter photo
  - 0203: scene photo
- 03: enterprise qualification
  - 0301: business license.', example='0104', position='Query'),
  credType?: string(name='CredType', description='The credential type. Valid values:

- 01: personal card and certificate
- 02: business scenario
- 03: enterprise qualification.', example='01', position='Query'),
  identifyNum?: string(name='IdentifyNum', description='The ID card number.', example='429001********8211', position='Query'),
  imageContext?: string(name='ImageContext', description='The Base64-encoded image. Specify either imageUrl or imageContext.', example='base64', position='Body'),
  imageUrl?: string(name='ImageUrl', description='The image URL. Specify either imageUrl or imageContext.', example='http://marry.momocdn.com/avatar/3B/B6/3BB6527E-7467-926E-1048-B43614F20CC420230803_L.jpg', position='Query'),
  isCheck?: string(name='IsCheck', description='Specifies whether to enable authoritative verification. Valid values:

- **0**: Disabled.
- **1**: Enabled.', example='0', position='Query'),
  isOCR?: string(name='IsOCR', description='Specifies whether to enable optical character recognition (OCR). Valid values:

- **0**: Disabled.
- **1**: Enabled.

You can set **isOCR** to **1** only when **CredType** is set to **01**.', example='1', position='Query'),
  merchantDetail?: [ 
    {
      key?: string(name='Key', description='The replacement keyword key.', example='keyword'),
      value?: string(name='Value', description='The replacement keyword value.', example='关键字'),
    }
  ](name='MerchantDetail', description='This parameter is required when PromptModel is set to DEFAULT.', shrink='json', position='Query'),
  merchantId?: string(name='MerchantId', description='The merchant ID. This parameter is required when **CredName** is set to **02**.', example='无。', position='Query'),
  productCode?: string(name='ProductCode', description='The call mode. Valid values:

* ANTI_FAKE_CHECK: image anti-forgery detection.

* ANTI_FAKE_VL: image anti-forgery detection and semantic understanding.

* IMAGE_VL_COG: image semantic understanding.

Default value: ANTI_FAKE_CHECK.

ProductCode can be set to ANTI_FAKE_VL or IMAGE_VL_COG only when CredType is set to 02.', example='ANTI_FAKE_CHECK', position='Query'),
  prompt?: string(name='Prompt', description='The custom prompt content for image semantic understanding.

This parameter is required when PromptModel is set to CUSTOM.', example='无', position='Query'),
  promptModel?: string(name='PromptModel', description='The method to obtain the prompt for image semantic understanding. Valid values:

* DEFAULT: system default.

* CUSTOM: custom.

Note: This parameter is required when ProductCode is set to ANTI_FAKE_VL or IMAGE_VL_COG.', example='DEFAULT', position='Query'),
  userName?: string(name='UserName', description='The name.', example='张*', position='Query'),
}

