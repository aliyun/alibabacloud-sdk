}', position='Body'),
  outerOrderNo: string(name='OuterOrderNo', description='The custom unique business identifier used for subsequent troubleshooting.

The value can contain uppercase and lowercase letters and digits, and can be up to 32 characters in length.

This parameter is required.', example='e0c34a77f5ac40a5aa5e6ed20c******', position='Body'),
  productCode: string(name='ProductCode', description='The product solution to be integrated. Valid values: ID_OCR.

This parameter is required.', example='ID_OCR', position='Body'),
