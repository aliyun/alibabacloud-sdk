model VerifyMaterialRequest {
  regionId?: string(name='RegionId', position='Host'),
  bizId: string(name='BizId', description='The unique ID that identifies an authentication task. The ID cannot exceed 64 characters. For a single authentication task, the system supports unlimited submissions until the authentication is passed and the task is completed.

> You must use a different BizId when initiating different authentication tasks.

This parameter is required.', example='39ecf51e-2f81-4dc5-90ee-ff86125b****', position='Query'),
  bizType: string(name='BizType', description='The business scenario identifier for using the ID Verification service. Create it in the console first. For more information, see [Business settings](https://help.aliyun.com/document_detail/127885.html).

This parameter is required.', example='RPMinTest', position='Query'),
  faceImageUrl: string(name='FaceImageUrl', description='The HTTP or HTTPS URL of the front-facing portrait photo.

This parameter is required.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/example.jpg', position='Query'),
  idCardBackImageUrl?: string(name='IdCardBackImageUrl', description='The HTTP or HTTPS URL of the image for the back side of the ID card.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/example3.jpg', position='Query'),
  idCardFrontImageUrl?: string(name='IdCardFrontImageUrl', description='The HTTP or HTTPS URL of the image for the front side of the ID card.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/example2.jpg', position='Query'),
  idCardNumber: string(name='IdCardNumber', description='The ID card number.

This parameter is required.', example='02343218901123****', position='Query'),
  name: string(name='Name', description='The name.

This parameter is required.', example='Zhang San', position='Query'),
  userId?: string(name='UserId', description='The ID of the end user, such as the account ID of the end user.', example='54sdj', position='Query'),
}

model VerifyMaterialResponseBody = {
  authorityComparisionScore?: float(name='AuthorityComparisionScore', description='The comparison score between the submitted face photo and the authoritative data during the authentication process. Valid values: **0** to **100**.

Refer to the following confidence thresholds:
- When the false acceptance rate (FAR) is 0.001%, the corresponding threshold is 95.
- When the FAR is 0.01%, the corresponding threshold is 90.
- When the FAR is 0.1%, the corresponding threshold is 80.
- When the FAR is 1%, the corresponding threshold is 60.

> This field only indicates the comparison result between the face and the authoritative data and serves as a reference score. Do not use this score alone as the pass or fail criterion. For the comprehensive authentication result, refer to the **VerifyStatus** field. The **VerifyStatus** result combines the face and authoritative data comparison with various other strategies to improve the security level.', example='97'),
  idCardFaceComparisonScore?: float(name='IdCardFaceComparisonScore', description='The comparison score between the submitted face photo and the face on the front side of the ID card during the authentication process. Valid values: **0** to **100**.

Refer to the following confidence thresholds:
- When the false acceptance rate (FAR) is 0.001%, the corresponding threshold is 95.
- When the FAR is 0.01%, the corresponding threshold is 90.
- When the FAR is 0.1%, the corresponding threshold is 80.
- When the FAR is 1%, the corresponding threshold is 60.', example='97'),
  material?: {
    faceGlobalUrl?: string(name='FaceGlobalUrl', description='The global image captured by the camera and collected by the ID Verification SDK.

> This parameter takes effect only after it is configured. If you need to use this parameter, submit a [ticket](https://selfservice.console.aliyun.com/ticket/category/cloudauth/today) to contact us.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/face-global-example.jpg'),
    faceImageUrl?: string(name='FaceImageUrl', description='The HTTP or HTTPS URL of the front-facing portrait photo, which corresponds to the **FaceImageUrl** request parameter. The URL is valid for 5 minutes. Store the image in your own storage to prevent usage issues.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/example.jpg'),
    faceMask?: string(name='FaceMask', description='Specifies whether the face is wearing a mask. Valid values:
- **true**: A mask is worn.
- **false**: No mask is worn.', example='false'),
    faceQuality?: string(name='FaceQuality', description='The quality of the front-facing portrait photo. Valid values:
- **UNQUALIFIED**: Poor photo quality.
- **LOW**: Low.
- **NORMAL**: Normal.
- **HIGH**: High.', example='NORMAL'),
    idCardInfo?: {
      address?: string(name='Address', description='The address.', example='No. 969 Wenyi West Road, Yuhang District, Hangzhou City, Zhejiang Province'),
      authority?: string(name='Authority', description='The issuing authority.', example='Hangzhou Municipal Public Security Bureau'),
      backImageUrl?: string(name='BackImageUrl', description='The HTTP or HTTPS URL of the image for the back side of the ID card. The URL is valid for 5 minutes. Store the image in your own storage to prevent usage issues.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/example3.jpg'),
      birth?: string(name='Birth', description='The date of birth.', example='19900101'),
      endDate?: string(name='EndDate', description='The end date of the ID card validity period. Format: yyyymmdd.', example='20201101'),
      frontImageUrl?: string(name='FrontImageUrl', description='The HTTP or HTTPS URL of the image for the front side of the ID card. The URL is valid for 5 minutes. Store the image in your own storage to prevent usage issues.', example='http://image-demo.img-cn-hangzhou.aliyuncs.com/example2.jpg'),
      name?: string(name='Name', description='The name.', example='Zhang San'),
      nationality?: string(name='Nationality', description='The ethnicity.', example='Han'),
      number?: string(name='Number', description='The ID card number.', example='02343218901123****'),
      startDate?: string(name='StartDate', description='The start date of the ID card validity period. Format: yyyymmdd.', example='20201101'),
    }(name='IdCardInfo', description='The OCR result of the ID card information.

> If the front and back sides of the ID card are not provided during the authentication process, the OCR result of the ID card information is not returned. Even if the front and back sides of the ID card are provided, the system does not guarantee that all information on the ID card is returned. If OCR fails to recognize certain information due to photo quality issues, the OCR information may be incomplete. Do not strongly rely on the ID card OCR information in your business.'),
    idCardName?: string(name='IdCardName', description='The name, which corresponds to the **Name** request parameter.', example='Zhang San'),
    idCardNumber?: string(name='IdCardNumber', description='The ID card number, which corresponds to the **IdCardNumber** request parameter.', example='02343218901123****'),
  }(name='Material', description='The authentication materials.'),
  requestId?: string(name='RequestId', description='The request ID.', example='04F0F334-1335-436C-A1D7-6C044FE73368'),
  verifyStatus?: int32(name='VerifyStatus', description='The authentication status. Valid values:

- **1**: The authentication is passed.
- **2** to **n**: The authentication fails due to various reasons. For detailed descriptions, see **Authentication status description** below.', example='1'),
  verifyToken?: string(name='VerifyToken', description='The token for this authentication. It is used to link various APIs in the authentication request and is valid for 30 minutes.', example='c302c0797679457685410ee51a5ba375'),
}

model VerifyMaterialResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: VerifyMaterialResponseBody(name='body'),
}

/**
  * @description Preparations: Before integrating this API, ensure that you have completed the required preparations. For more information, see [Server-side integration preparations](https://help.aliyun.com/document_detail/127471.html).
  * Request methods: HTTPS POST and GET.
  * API description: The integrator\\"s server submits authentication materials to the ID Verification service for verification and comparison, and the result is returned synchronously.
  * Applicable scope: This API is applicable only to server-only integration authentication solutions.
  * Image URL description:
  * - HTTP or HTTPS URL: Publicly accessible HTTP or HTTPS URLs are supported. Example: `http://image-demo.img-cn-hangzhou.aliyuncs.com/example.jpg`.
  * - OSS URL: If the integrator\\"s images are local files, Alibaba Cloud provides corresponding upload SDKs. You can use the SDK to upload images to the OSS bucket specified by the ID Verification service, obtain the corresponding OSS URL, and use it as the image URL parameter for the API. If your business requires the upload SDK, submit a [ticket](https://selfservice.console.aliyun.com/ticket/category/cloudauth/today) to contact us.
  * Image limits:
  * - The relative path or absolute path of a local image is not supported.
  * - Keep the size of a single image within 2 MB to prevent timeouts when the algorithm pulls the image.
  * - The face area in the image must be at least 64 × 64 pixels.
  * - The body of a single request is limited to 8 MB. Calculate the total size of all images and other information in the request to ensure it does not exceed the limit.
  * @param request  the request parameters of VerifyMaterial  VerifyMaterialRequest
  * @return VerifyMaterialResponse
 */
async function verifyMaterial(request: VerifyMaterialRequest): VerifyMaterialResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'VerifyMaterial', 'POST', '/', 'json', false, 'json', request);
}

