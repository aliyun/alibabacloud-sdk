/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Cloudauth';
  @version = '2019-03-07';
  @endpointRule = 'central';
  @endpointMap = {
    'cn-beijing' = 'cloudauth.cn-beijing.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model AIGCFaceVerifyRequest {
  regionId?: string(name='RegionId', position='Host'),
  faceContrastPicture?: string(name='FaceContrastPicture', description='The Base64-encoded photo.
> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='/9j/4AAQSkZJRgABAQAASxxxxxxx', position='Body'),
  faceContrastPictureUrl?: string(name='FaceContrastPictureUrl', description='The URL of the portrait image. The URL must be a publicly accessible HTTP or HTTPS link.

> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='https://cn-shanghai-aliyun-cloudauth-xxxxxx.oss-cn-shanghai.aliyuncs.com/verify/xxxxx/xxxxx.jpeg', position='Query'),
  ossBucketName?: string(name='OssBucketName', description='The name of the authorized Object Storage Service (OSS) bucket.
> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='cn-shanghai-aliyun-cloudauth-xxxxx', position='Query'),
  ossObjectName?: string(name='OssObjectName', description='The name of the object in the authorized OSS bucket.
> You can pass the image by using one of the following methods: FaceContrastPicture, FaceContrastPictureUrl, or OSS.', example='verify/xxxxx/xxxxxx.jpeg', position='Query'),
  outerOrderNo?: string(name='OuterOrderNo', description='The custom unique business identifier on the customer\\\\"s server, which is used for subsequent troubleshooting. The value can be up to 32 characters in length and can contain letters and digits. Make sure that the value is unique.', example='e0c34a77f5ac40a5aa5e6ed20c353888', position='Query'),
  productCode?: string(name='ProductCode', description='The product solution.', example='LR_FR_AIGC', position='Query'),
  sceneId?: long(name='SceneId', description='The ID of the authentication scenario. This ID is automatically generated after you create an authentication scenario in the console. For more information about how to create an authentication scenario, see Add an authentication scenario.', example='100000xxxx', position='Query'),
}

model AIGCFaceVerifyResponseBody = {
  code?: string(name='Code', description='The return code. A value of 200 indicates success, and other values indicate failure.', example='200'),
  message?: string(name='Message', description='The message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E'),
  resultObject?: {
    certifyId?: string(name='CertifyId', description='The unique identifier for ID Verification.', example='91707dc296d469ad38e4c5efa6a0****'),
    result?: string(name='Result', description='The authentication result. Valid values:

- Y: The face is generated by AIGC.

- N: No AIGC-generated face is detected.', example='Y'),
    score?: string(name='Score', description='The detection score.', example='1.0000'),
  }(name='ResultObject', description='The returned result.'),
}

model AIGCFaceVerifyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AIGCFaceVerifyResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AIGCFaceVerify  AIGCFaceVerifyRequest
  * @return AIGCFaceVerifyResponse
 */
async function aIGCFaceVerify(request: AIGCFaceVerifyRequest): AIGCFaceVerifyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AIGCFaceVerify', 'POST', '/', 'json', true, 'form', request);
}

model BankMetaVerifyRequest {
  regionId?: string(name='RegionId', position='Host'),
  bankCard?: string(name='BankCard', description='The bank card number.

- If ParamType is set to normal, enter the bank card number in plaintext.
- If ParamType is set to md5, enter all digits of the card number except the last 6 in plaintext, followed by the MD5 hash (32-character lowercase) of the last 6 digits.', example='610*************1181', position='Query'),
  identifyNum?: string(name='IdentifyNum', description='The ID card number.

- This parameter is required when ProductType is set to BANK_CARD_3_META.
- If ParamType is set to normal, enter the ID card number in plaintext.
- If ParamType is set to md5, enter the first 6 digits of the ID card number in plaintext, followed by the date of birth encrypted with MD5 (32-character lowercase MD5 hash), followed by the last 4 digits of the ID card number.', example='429001********8211', position='Query'),
  identityType?: string(name='IdentityType', description='The ID document type.', example='01', position='Query'),
  mobile?: string(name='Mobile', description='The mobile phone number.

- This parameter is required when ProductType is set to BANK_CARD_4_META.
- If ParamType is set to normal, enter the mobile phone number in plaintext.
- If ParamType is set to md5, enter the MD5 hash (32-character lowercase) of the mobile phone number.', example='138******11', position='Query'),
  paramType?: string(name='ParamType', description='The parameter type.

- normal: no encryption.
- md5: MD5 encryption.', example='normal', position='Query'),
  productType?: string(name='ProductType', description='The product type.

- BANK_CARD_2_META: verifies the bank card number and name.
- BANK_CARD_3_META: verifies the bank card number, name, and ID card number.
- BANK_CARD_4_META: verifies the bank card number, name, ID card number, and mobile phone number.', example='BANK_CARD_2_META', position='Query'),
  userName?: string(name='UserName', description='The name.

- If ParamType is set to normal, enter the name in plaintext.
- If ParamType is set to md5, enter the first character of the name encrypted with MD5 (32-character lowercase MD5 hash) followed by the remaining characters of the name in plaintext.', example='张*', position='Query'),
  verifyMode?: string(name='VerifyMode', description='VERIFY_BANK_CARD: the bank card verification mode. Verifies whether the bank card number matches the user\\\\"s real name, ID card number, and mobile phone number.', example='VERIFY_BANK_CARD', position='Query'),
}

model BankMetaVerifyResponseBody = {
  code?: string(name='Code', description='The response code. 200 indicates success. Other values indicate failure.', example='200'),
  message?: string(name='Message', description='The response message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='473469C7-A***B-A3DC0DE3C83E'),
  resultObject?: {
    bizCode?: string(name='BizCode', description='The verification result.

- 1: verification passed (billed).
- 2: verification failed (billed).
- 3: no records found (not billed).', example='1'),
    subCode?: string(name='SubCode', description='The verification details.

- **101**: verification passed.
- **201**: verification failed. The cardholder information is incorrect.
- **202**: verification failed. Authentication payment is not enabled for the bank card.
- **203**: verification failed. The bank card has expired.
- **204**: verification failed. The bank card is restricted.
- **205**: verification failed. The card has been confiscated.
- **206**: verification failed. The bank card is invalid.
- **207**: verification failed. No matching issuing bank exists.
- **208**: verification failed. The card is not initialized or is a dormant card.
- **209**: verification failed. The card is fraudulent or has been retained.
- **210**: verification failed. The card has been reported lost.
- **211**: verification failed. The maximum number of password attempts has been exceeded.
- **212**: verification failed. The issuing bank does not support this transaction.
- **213**: verification failed. The card status is abnormal or the card is invalid.
- **214**: verification failed. No mobile phone number is registered.
- **215**: verification failed. The password, expiration date, or CVN2 is incorrect.
- **216**: verification failed. Other card exceptions.
- **301**: unable to verify. The bank card does not support this service.
- **302**: unable to verify. Verification failed or the bank refused verification. Contact the issuing bank.
- **303**: unable to verify. The bank card does not support mobile phone number verification.
- **304**: unable to verify. The bank card number is incorrect.
- **305**: unable to verify. Other reasons.
- **306**: unable to verify. The maximum number of verification attempts has been exceeded.', example='101'),
  }(name='ResultObject', description='The verification result.'),
}

model BankMetaVerifyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BankMetaVerifyResponseBody(name='body'),
}

/**
  * @description Bank card consistency verification, including two-element verification (name and bank card number), three-element verification (name, ID card number, and bank card number), and four-element verification (name, ID card number, mobile phone number, and bank card number).
  * - Service endpoints:
  *   - China (Beijing) region: cloudauth.cn-beijing.aliyuncs.com (IPv4) or cloudauth-dualstack.cn-beijing.aliyuncs.com (IPv6).
  *   - China (Shanghai) region: cloudauth.cn-shanghai.aliyuncs.com (IPv4) or cloudauth-dualstack.cn-shanghai.aliyuncs.com (IPv6).
  * - Request methods: POST and GET.
  * - Transport protocol: HTTPS.
  * @param request  the request parameters of BankMetaVerify  BankMetaVerifyRequest
  * @return BankMetaVerifyResponse
 */
async function bankMetaVerify(request: BankMetaVerifyRequest): BankMetaVerifyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BankMetaVerify', 'POST', '/', 'json', false, 'json', request);
}

model CompareFaceVerifyRequest {
  regionId?: string(name='RegionId', position='Host'),
  crop?: string(name='Crop', description='Specifies whether to allow cropping. Default value: F. Valid values:
- T: Allowed.
- F: Not allowed.', example='T', position='Body'),
  outerOrderNo?: string(name='OuterOrderNo', description='The unique identifier of the merchant request.

The value is a 32-character alphanumeric string. The first few characters are a custom abbreviation of the merchant, the middle part can be a period of time, and the last part can be a random or incremental sequence.', example='e0c34a77f5ac40a5aa5e6ed20c353888', position='Body'),
  productCode?: string(name='ProductCode', description='The product code. Fixed value: PV_FC.', example='PV_FC', position='Body'),
  sceneId?: long(name='SceneId', description='The ID of the verification scenario.', example='1000000006', position='Body'),
  sourceCertifyId?: string(name='SourceCertifyId', description='The CertifyId of a previous successful ID Verification. The photo used during the verification is used as the face comparison photo.

> You can use one of the following four methods to upload the face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='0bfa7c493f850e5178b9f8613634c9xx', position='Body'),
  sourceFaceContrastPicture?: string(name='SourceFaceContrastPicture', description='The Base64-encoded string of the photo.

> You can use one of the following four methods to upload the face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='/9j/4AAQSkZJRgABAQAASxxxxxxx', maxLength=1048676, position='Body'),
  sourceFaceContrastPictureUrl?: string(name='SourceFaceContrastPictureUrl', description='The URL of the photo in OSS. Only authorized OSS photo URLs are supported.

> You can use one of the following four methods to upload the face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='https://cn-shanghai-aliyun-cloudauth-xxxxxx.oss-cn-shanghai.aliyuncs.com/verify/xxxxx/xxxxx.jpeg', position='Body'),
  sourceOssBucketName?: string(name='SourceOssBucketName', description='The name of the authorized OSS bucket.

> You can use one of the following four methods to upload the face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='cn-shanghai-aliyun-cloudauth-xxxxx', position='Body'),
  sourceOssObjectName?: string(name='SourceOssObjectName', description='The name of the object in the authorized OSS bucket.

> You can use one of the following four methods to upload the face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='verify/xxxxx/xxxxxx.jpeg', position='Body'),
  targetCertifyId?: string(name='TargetCertifyId', description='The CertifyId of a previous successful ID Verification. The photo used during the verification is used as the base library face comparison photo.

> You can use one of the following four methods to upload the base library face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='0bfa7c493f850e5178b9f8613634c9xx', position='Body'),
  targetFaceContrastPicture?: string(name='TargetFaceContrastPicture', description='The Base64-encoded string of the base library photo.

> You can use one of the following four methods to upload the base library face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='/9j/4AAQSkZJRgABAQAASxxxxxxx', maxLength=1048676, position='Body'),
  targetFaceContrastPictureUrl?: string(name='TargetFaceContrastPictureUrl', description='The URL of the base library photo in OSS. Only authorized OSS photo URLs are supported.

> You can use one of the following four methods to upload the base library face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='https://cn-shanghai-aliyun-cloudauth-xxxxxx.oss-cn-shanghai.aliyuncs.com/verify/xxxxx/xxxxx.jpeg', position='Body'),
  targetOssBucketName?: string(name='TargetOssBucketName', description='The name of the authorized OSS bucket.

> You can use one of the following four methods to upload the base library face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='cn-shanghai-aliyun-cloudauth-xxxxx', position='Body'),
  targetOssObjectName?: string(name='TargetOssObjectName', description='The name of the object in the authorized OSS bucket.

> You can use one of the following four methods to upload the base library face photo: FaceContrastPicture, FaceContrastPictureUrl, CertifyId, and OSS.', example='verify/xxxxx/xxxxxx.jpeg', position='Body'),
}

model CompareFaceVerifyResponseBody = {
  code?: string(name='Code', description='The return code. A value of 200 indicates success, and other values indicate failure.', example='200'),
  message?: string(name='Message', description='The error message.', example='success'),
  requestId?: string(name='RequestId', description='The request ID.', example='130A2C10-B9EE-4D84-88E3-5384FF039795'),
  resultObject?: {
    certifyId?: string(name='CertifyId', description='The unique identifier of the ID Verification request.', example='08573be80f944d95ac812e019e3655a8'),
    passed?: string(name='Passed', description='Indicates whether the verification is passed. Valid values:
- T: Passed.
- F: Failed.', example='T'),
    verifyScore?: float(name='VerifyScore', description='The face comparison score.', example='99.60875'),
  }(name='ResultObject', description='The face comparison result.'),
}

model CompareFaceVerifyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CompareFaceVerifyResponseBody(name='body'),
}

/**
  * @description - API operation: CompareFaceVerify.
  * - Endpoint: cloudauth.aliyuncs.com.
  * - Request methods: HTTPS POST and GET.
  * - Operation description: Implements ID Verification through server-side integration.
  * #### Requirements for uploaded photos
  * When you perform face comparison, upload two face photos that meet all the following conditions.
  * - The photos must be recent photos or recent photos from the base library. The faces must be complete, clear, and unobstructed, with natural expressions and facing the camera directly.
  * - The photos must be clear and properly exposed. The faces must not be too dark, too bright, or have halos. The angle must not deviate significantly.
  * - The resolution must not exceed 1920×1080 and must be at least 640×480. We recommend that you scale the short side to 720 pixels and use a compression ratio greater than 0.9.
  * - Photo size: less than 1 MB.
  * - Photos rotated by 90, 180, and 270 degrees are supported. If multiple faces are detected, the largest face is selected.
  * @param request  the request parameters of CompareFaceVerify  CompareFaceVerifyRequest
  * @return CompareFaceVerifyResponse
 */
async function compareFaceVerify(request: CompareFaceVerifyRequest): CompareFaceVerifyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CompareFaceVerify', 'POST', '/', 'json', true, 'form', request);
}

model CompareFacesRequest {
  sourceImageType?: string(name='SourceImageType', description='The type of the first image. Valid values:

- **FacePic**: A face photo of the user.
- **IDPic**: A portrait photo from the chip of a second-generation Chinese ID card. This photo is typically read and decoded by a second-generation ID card reader.', example='FacePic', position='Body'),
  sourceImageValue?: string(name='SourceImageValue', description='The URL of the first image. For more information, see the instructions on uploading image URLs.', example='http%3A%2F%2Fjiangsu.china.com.cn%2Fuploadfile%2F2015%2F0114%2F1421221304095989.jpg', position='Body'),
  targetImageType?: string(name='TargetImageType', description='The type of the second image. Valid values:

- **FacePic**: A face photo of the user.
- **IDPic**: A portrait photo from the chip of a second-generation Chinese ID card. This photo is typically read and decoded by a second-generation ID card reader.', example='FacePic', position='Body'),
  targetImageValue?: string(name='TargetImageValue', description='The URL of the second image. For more information, see the instructions on uploading image URLs.', example='http%3A%2F%2Fjiangsu.china.com.cn%2Fuploadfile%2F2015%2F0114%2F1421221304095989.jpg', position='Body'),
}

model CompareFacesResponseBody = {
  code?: string(name='Code', description='The HTTP status code.', example='200'),
  data?: {
    confidenceThresholds?: string(name='ConfidenceThresholds', description='The confidence thresholds for face comparison. The response is a JSON object in the `"key":"value"` format.

- `key`: The false acceptance rate (FAR), which is the probability of misidentifying another person as the specified person.
- `value`: The corresponding threshold.


> Regarding the confidence thresholds (confidenceThresholds) in the example:
- `"0.0001": "90.07"` indicates that the threshold is 90.07 when the FAR is 0.01%.
- `"0.001": "80.01"` indicates that the threshold is 80.01 when the FAR is 0.1%.
- `"0.01": "70.02"` indicates that the threshold is 70.02 when the FAR is 1%.

The confidence thresholds are dynamically generated based on different images and algorithms. Do not persist the confidence thresholds.', example='{"0.0001":"90.07","0.001":"80.01","0.01":"70.02"}'),
    similarityScore?: float(name='SimilarityScore', description='The similarity score of the faces in the two images. Valid values: [0, 100]. A higher value indicates a higher similarity.', example='98.7913'),
  }(name='Data', description='The face comparison result.'),
  message?: string(name='Message', description='The error code.', example='Error.InternalError'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E'),
  success?: boolean(name='Success', description='Indicates whether the response is successful.', example='true'),
}

model CompareFacesResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CompareFacesResponseBody(name='body'),
}

/**
  * @description Request method: Only HTTPS POST requests are supported.
  * API description: Compares two specified face images and returns the similarity score of the faces in the two images.
  * - At least one of the specified images must be a face photo (FacePic).
  * - If an image contains multiple faces, the algorithm automatically selects the largest face in the image.
  * - If no face is detected in one of the two images, the system returns a "No face detected" error message.
  * When you pass images, you must upload the HTTP URL or Base64 encoding of the image.
  * - HTTP URL: A publicly accessible HTTP URL. Example: `http://image-demo.img-cn-hangzhou.aliyuncs.com/example.jpg`.
  * - Base64 encoding: A Base64-encoded image in the format of `base64://<Base64 string of the image>`.
  * Image limits.
  * - The relative path or absolute path of local images is not supported.
  * - The size of a single image must be less than 2 MB to prevent algorithm pull timeouts.
  * - The body of a single request is limited to 8 MB. Make sure that the total size of all images and other information in the request does not exceed this limit.
  * - When you use Base64 to pass images, the request method must be POST. You must remove the header description from the Base64 character string, such as the data URI prefix.
  * @param request  the request parameters of CompareFaces  CompareFacesRequest
  * @return CompareFacesResponse
 */
async function compareFaces(request: CompareFacesRequest): CompareFacesResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CompareFaces', 'POST', '/', 'json', true, 'form', request);
}

