- false: Failed.', example='true'),
      vlContent?: string(name='VlContent', description='The content of the Qwen explanation.', example='{"Does this image have obvious Photoshop features":0,"Is the image a normal business photo":1,"Does the image contain the words 58, Meituan, or Dianping":0,"Does this image contain website information":0,"Is the business scene in the image a hotel":0}'),
    }(name='VlResult', description='The Qwen explanation.'),
  }(name='ResultObject', description='The returned result.'),
