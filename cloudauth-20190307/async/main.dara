  imageUrl?: string(name='ImageUrl', description='The image URL. You must specify either imageUrl or imageContext.', example='http://marry.momocdn.com/avatar/3B/B6/3BB6527E-7467-926E-1048-B43614F20CC420230803_L.jpg', position='Query'),
  isCheck?: string(name='IsCheck', description='Specifies whether to enable authoritative verification. Valid values:

- ****0****: No.
- **1**: Yes.', example='0', position='Query'),
  isOCR?: string(name='IsOCR', description='Specifies whether to enable optical character recognition (OCR). Valid values:

- **0**: No.
- **1**: Yes.

You can set this parameter to **1** only when **CredType** is set to **01**.', example='1', position='Query'),
  merchantDetail?: [ 
    {
      key?: string(name='Key', description='The key of the replacement keyword.', example='keyword'),
      value?: string(name='Value', description='The value of the replacement keyword.', example='Keyword'),
    }
  ](name='MerchantDetail', description='The merchant details. This parameter is required when PromptModel is set to DEFAULT.', shrink='json', position='Query'),
  merchantId?: string(name='MerchantId', description='The merchant ID. This parameter is required when ****CredName**** is set to **02**.', example='None', position='Query'),
  productCode?: string(name='ProductCode', description='The call mode. Valid values:

* ANTI_FAKE_CHECK: Image anti-counterfeiting detection.

* ANTI_FAKE_VL: Image anti-counterfeiting detection and semantic understanding.

* IMAGE_VL_COG: Image semantic understanding.

Default value: ANTI_FAKE_CHECK.

You can set this parameter to ANTI_FAKE_VL or IMAGE_VL_COG only when CredType is set to 02.', example='ANTI_FAKE_CHECK', position='Query'),
  prompt?: string(name='Prompt', description='The custom prompt content for image semantic understanding.

This parameter is required when PromptModel is set to CUSTOM.', example='None', position='Query'),
  promptModel?: string(name='PromptModel', description='The method to obtain the prompt for image semantic understanding. Valid values:

* DEFAULT: System default.

* CUSTOM: Custom.

Note: This parameter is required when ProductCode is set to ANTI_FAKE_VL or IMAGE_VL_COG.', example='DEFAULT', position='Query'),
  userName?: string(name='UserName', description='The name.', example='Zhang*', position='Query'),
}

