  postCommandPath?: string(name='PostCommandPath', description='The relative path of the post-command in the application package. This parameter is supported only for Windows applications.', example='install.ps1'),
  postCommandTimeoutSec?: int32(name='PostCommandTimeoutSec', description='The timeout period for executing the post-command, in seconds. This parameter is supported only for Windows applications.', example='10'),
}

