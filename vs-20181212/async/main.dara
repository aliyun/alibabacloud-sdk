    downloadURL?: string(name='DownloadURL', description='The download URL of the patch package. By default, the format of the patch package is the same as that of the original cloud application package. You must specify either RenderingInstanceId or DownloadURL. DownloadURL takes precedence.', example='https://test_host/app/test-tar-pkg.tar'),
    md5?: string(name='Md5', description='The MD5 hash of the patch package, which is used to verify integrity. This parameter is valid and required only when DownloadURL is not empty.', example='346f6404395adfg5bae1e45g4e943bf7'),
    patchName?: string(name='PatchName', description='The name or description of the patch package, which is one of the unique identifiers under the AppId. Naming conventions: 1. The value cannot be origin or all. 2. The length must be 1 to 50 characters. 3. The value can contain lowercase letters, digits, underscores (_), hyphens (-), and periods (.). 4. The first and last characters must be letters or digits.', example='p1', minLength=1, maxLength=50),
    pkgFormat?: string(name='PkgFormat', description='The format of the installation package. By default, the format is the same as the suffix of the download file URL. This parameter is valid only when DownloadURL is not empty. Valid values:
- tar.gz
- tar
- zip
- rar', example='tar'),
    postCommandPath?: string(name='PostCommandPath', description='The relative path of the post-command within the application package. This parameter is supported only for Windows applications.', example='install.ps1'),
    postCommandTimeoutSec?: int32(name='PostCommandTimeoutSec', description='The timeout period for executing the post-command, in seconds. This parameter is supported only for Windows applications.', example='10'),
    renderingInstanceId?: string(name='RenderingInstanceId', description='The instance ID used to create the patch package. This parameter is valid only for Android application marketplace scenarios where PkgType is set to andrpid_appmarket. You must specify either RenderingInstanceId or DownloadURL. DownloadURL takes precedence.', example='render-d7ec79fe47ce47aca2d8d7500d25a28a'),
  }(name='Patch', description='The information about the patch package to be uploaded. 1. This parameter is not supported when PkgType is set to android. 2. Only one patch package can be in the uploading state (non-final state) for the same AppId at a time.', shrink='json', position='Body'),
  pkgLabels?: [ string ](name='PkgLabels', description='The tags of the cloud application. You can specify multiple tags to reset the cloud application tags. Valid values:
- hot
- game
- app
To delete all tags, set the value to ["NULL"].', shrink='json', position='Query'),
  stablePatchId?: string(name='StablePatchId', description='The ID of the stable patch. This is the default patch ID used in customer business scenarios, such as session startup, when no patch ID is specified. This parameter is not supported when PkgType is set to android. Special value: origin: cancels the patch version and uses the initial version by default.', example='patch-03fa76e8e13a49b6a966b063d9d309b4', position='Query'),
