  height?: long(name='Height', description='Image height.', example='720'),
  id?: string(name='Id', description='Stream ID.', example='323*****997-cn-qingdao'),
  ossBucket?: string(name='OssBucket', description='The OSS bucket of the snapshot file.', example='examplebucket'),
  ossEndpoint?: string(name='OssEndpoint', description='The OSS endpoint of the snapshot file.', example='oss-cn-qingdao.aliyuncs.com'),
  ossObject?: string(name='OssObject', description='The OSS object of the snapshot file.', example='photos/live/340200*****100049/ondemand-1639126601767.jpg'),
  requestId?: string(name='RequestId', description='The request ID.', example='BEA5625F-8FCF-48F4-851B-CA63946DA664'),
  timestamp?: long(name='Timestamp', description='The snapshot timestamp.', example='1639126601767'),
  url?: string(name='Url', description='The URL of the snapshot file.', example='http://examplebucket.oss-*****.aliyuncs.com/photos/live/340200*****100049/ondemand-1639126601767.jpg'),
  width?: long(name='Width', description='Image width.', example='1280'),
}

model CreateStreamSnapshotResponse = {
