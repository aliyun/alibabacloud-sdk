model UploadCloudAppRequest {
  appName: string(name='AppName', description='The application name. For Android applications, we recommend that you use the package name, such as com.aaa.bbb. Naming conventions: 1. The length is 4 to 50 characters. 2. The name can contain lowercase letters, digits, underscores (_), hyphens (-), and periods (.). 3. The first and last characters must be letters or digits.

This parameter is required.', example='com.aaa.bbb', minLength=4, maxLength=50, position='Query'),
  appVersion: string(name='AppVersion', description='The application version. For Android applications, we recommend that you use the VersionName, such as 1.1.1. Naming conventions: 1. The length is 1 to 50 characters. 2. The version can contain lowercase letters, digits, underscores (_), hyphens (-), and periods (.). 3. The first and last characters must be letters or digits.

This parameter is required.', example='1.1.1', minLength=1, maxLength=50, position='Query'),
  description?: string(name='Description', description='The description of the application.', example='Test application package', maxLength=255, position='Query'),
  downloadUrl: string(name='DownloadUrl', description='The download URL of the application package.

This parameter is required.', example='https://xxx.xxx.xxx.apk', position='Query'),
  md5: string(name='Md5', description='The MD5 hash of the application package, which is used to check the integrity of the application package.

This parameter is required.', example='0CFBB7BD10CDD7279642ADAB8FEF3DEE', position='Query'),
  pkgFormat?: string(name='PkgFormat', description='The format of the installation package. The default value is the file name extension of the download URL. Valid values: 1. apk 2. tar.gz 3. tar 4. zip 5. rar.', example='apk', position='Query'),
  pkgLabels?: [ string ](name='PkgLabels', description='The tags of the cloud application. You can specify multiple tags. Valid values: 1. hot 2. game 3. app.', shrink='json', position='Query'),
  pkgType?: string(name='PkgType', description='The type of the installation package. ## Valid values: 1. android 2. win 3. android_appmarket: This value applies to Android app marketplace scenarios. In this scenario, the actual package name of the APK is restricted. a. The package names of different AppName values cannot be duplicated. b. Different AppVersion values of the same AppName can be associated with different package names. ## Default value description: If this parameter is not specified, the installation package type is automatically mapped based on the PkgFormat parameter or the file name extension of the DownloadUrl parameter. The default mapping between PkgFormat and the installation package type is as follows: 1. android: apk. The apk format is mapped to android by default. 2. win: tar.gz, tar, zip, and rar. 3. android_appmarket: apk.', example='android', position='Query'),
  postCommandPath?: string(name='PostCommandPath', description='The relative path of the post-command in the application package. This parameter is supported only for Windows applications.', example='install.ps1', position='Query'),
  postCommandTimeoutSec?: int32(name='PostCommandTimeoutSec', description='The timeout period for executing the post-command, in seconds. This parameter is supported only for Windows applications.', example='10', position='Query'),
}

model UploadCloudAppResponseBody = {
  appId?: string(name='AppId', description='The ID of the cloud application, which corresponds to a unique application package.', example='cap-b06b26edfhytbn b94a75ae1a79efc90eb'),
  requestId?: string(name='RequestId', description='The request ID.', example='BEA5625F-8FCF-48F4-851B-CA63946DA664'),
}

model UploadCloudAppResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UploadCloudAppResponseBody(name='body'),
}

