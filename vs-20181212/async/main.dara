model UninstallCloudAppRequest {
  appId: string(name='AppId', description='Cloud application ID

This parameter is required.', example='cap-b06b26edfhytbn b94a75ae1a79efc90eb', position='Query'),
  pageNumber?: int32(name='PageNumber', description='Page number for paged queries of instance associations in the project. Results are sorted by association time in descending order. This parameter applies only when ProjectId is not empty. It limits the maximum number of instances affected by this operation to control impact scope. Default value: 1.

1. Valid PageNumber range:
   a. Recommended method: Calculate the upper limit based on the total number of instances associated with the project. You can get this count using the ListRenderingProjectInstances API.
   b. Alternative method: Check the API response to determine whether PageNumber has reached the upper limit. This avoids manual calculation. PageNumber has reached the upper limit if either of the following occurs:
   ⅰ. The API returns HTTP status 403 and error code 200301.
   ⅱ. The sum of SuccessInstanceCount and FailedInstanceCount in the response is less than PageSize.

2. Example scenario:
   a. Full uninstall across all project instances: If the project has more instances than PageSize (default 100), call UninstallCloudApp multiple times, incrementing PageNumber by 1 each time. Track uninstall progress using the ListCloudAppInstallations API.', example='1', minimum=1, position='Query'),
  pageSize?: int32(name='PageSize', description='Maximum number of instances selected in the project. This parameter applies only when ProjectId is not empty. It limits the maximum number of instances affected by this operation to control impact scope. Default value: 100. Valid values: 1 to 100.', example='20', minimum=1, maximum=100, position='Query'),
  patchId?: string(name='PatchId', description='ID of the patch package to uninstall. Supported only on Windows.

1. Default: uninstall the StablePatchId.

2. Set to origin to uninstall the original version.

3. Set to all to uninstall all installed versions.', example='patch-03fa76e8e13a49b6a966b063d9d309b4', position='Query'),
  projectId?: string(name='ProjectId', description='Project ID', example='project-422bc38dfgh5eb44149f135ef76304f63b', position='Query'),
  renderingInstanceId?: string(name='RenderingInstanceId', description='Cloud application instance ID', example='render-9f8c57355d224ad7beaf95e145f22111', position='Query'),
  renderingInstanceIds?: [ string ](name='RenderingInstanceIds', description='List of cloud application instance IDs', shrink='json', position='Query'),
}

model UninstallCloudAppResponseBody = {
  failedInstanceCount?: int32(name='FailedInstanceCount', description='The number of cloud application service instances that failed.', example='0'),
  failedInstances?: [ 
    {
      errCode?: int32(name='ErrCode', description='Error code', example='300000'),
      errMessage?: string(name='ErrMessage', description='Error message', example='Rejected due to timeout'),
      renderingInstanceId?: string(name='RenderingInstanceId', description='Cloud application instance ID', example='render-b45f28650ffe4591bf4c5c95996a428c'),
    }
  ](name='FailedInstances', description='List of failed cloud application service instances'),
  requestId?: string(name='RequestId', description='Request ID', example='BEA5625F-8FCF-48F4-851B-CA63946DA664'),
  successInstanceCount?: int32(name='SuccessInstanceCount', description='Number of successfully uninstalled cloud application instances', example='5'),
  successInstances?: [ 
    {
      renderingInstanceId?: string(name='RenderingInstanceId', description='Cloud application instance ID', example='render-e6cf423c787e4e43b460a788da254fe3'),
    }
  ](name='SuccessInstances', description='A list of service instances for which the cloud application was uninstalled successfully.'),
}

model UninstallCloudAppResponse = {
