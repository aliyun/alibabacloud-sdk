model AddHiveEdgeWorkersRequest {
  hiveId: string(name='HiveId', description='The cluster ID.

This parameter is required.', example='hive-xxxx-xxx-xxx', position='Query'),
  instanceIds: [ string ](name='InstanceIds', description='A list of instance IDs.

This parameter is required.', example='[\\\\"acp-c4b9pbj4fzkagfexv\\\\", \\\\"acp-c4b9pbj4fzkagfexw\\\\"]', shrink='json', position='Query'),
}

model AddHiveEdgeWorkersResponseBody = {
  failedInstanceCount?: int32(name='FailedInstanceCount', description='The number of instances that failed to be added.', example='0'),
  failedInstances?: [ 
    {
      instanceId?: string(name='InstanceId', description='The instance ID.', example='ew-1226d588c69449209ee963161c067b04'),
      message?: string(name='Message', description='The error message.', example='Error 1062 (23000): Duplicate entry \\\\"hive-4fbf3928d40e43948b98acdb4fb5aaed-ew-1226d588c69449209ee9631\\\\" for key \\\\"PRIMARY\\\\"'),
    }
  ](name='FailedInstances', description='A list of instances that failed to be added.'),
  requestId?: string(name='RequestId', description='The request ID.', example='xxxx-xxx-xxx'),
  successInstanceCount?: int32(name='SuccessInstanceCount', description='The number of instances that were successfully added.', example='5'),
  successInstances?: [ 
    {
      instanceId?: string(name='InstanceId', description='The instance ID.', example='ew-1226d588c69449209ee963161c067b04'),
      message?: string(name='Message', description='A message indicating the result of the operation.', example='SUCCESS'),
    }
  ](name='SuccessInstances', description='A list of successfully added instances.'),
}

model AddHiveEdgeWorkersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddHiveEdgeWorkersResponseBody(name='body'),
}

/**
  * @description ## Usage notes
  * - **HiveId** is a required parameter that specifies the ID of the target cluster.
  * - **InstanceIds** is a required parameter that specifies a list of instance IDs to add.
  * - Adding an instance that already exists in the target cluster returns an error message.
  * - The response includes lists of successful and failed instances. This allows you to verify which instances were added and review the reasons for any failures.
  * @param request  the request parameters of AddHiveEdgeWorkers  AddHiveEdgeWorkersRequest
  * @return AddHiveEdgeWorkersResponse
 */
async function addHiveEdgeWorkers(request: AddHiveEdgeWorkersRequest): AddHiveEdgeWorkersResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddHiveEdgeWorkers', 'POST', '/', 'json', false, 'json', request);
}

