  patchId?: string(name='PatchId', description='The ID of the patch package.', example='patch-03fa76e8e13a49b6a966b063d9d309b4'),
  requestId?: string(name='RequestId', description='The request ID.', example='BEA5625F-8FCF-48F4-851B-CA63946DA664'),
