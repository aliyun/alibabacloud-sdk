  flv?: string(name='Flv', description='The storage path for FLV files. For information about the format, see the description of the Mp4 parameter.', example='osspath/record/{StreamName}/{EscapedStartTime}_{EscapedEndTime}', position='Query'),
  hlsM3u8?: string(name='HlsM3u8', description='The storage path for HLS M3U8 files. For information about the format, see the description of the Mp4 parameter.', example='osspath/record/{StreamName}/{EscapedStartTime}_{EscapedEndTime}', position='Query'),
  hlsTs?: string(name='HlsTs', description='The storage path for HLS TS files.

- The path supports variables such as {AppName}, {StreamName}, {UnixTimestamp}, and {Sequence}.

- You must include the {UnixTimestamp} and {Sequence} variables.', example='osspath/record/{StreamName}/{UnixTimestamp}_{Sequence}', position='Query'),
  id: string(name='Id', description='The ID of the template.

This parameter is required.', example='323*****998-cn-qingdao', position='Query'),
  interval?: long(name='Interval', description='The operation interval, in seconds.', example='3600', position='Query'),
  jpgOnDemand?: string(name='JpgOnDemand', description='The storage path for JPG files. This path is used for on-demand snapshots.

- Only JPG images are supported.

- The path supports variables such as {AppName}, {StreamName}, {UnixTimestamp}, and {Sequence}.

- You must include either {UnixTimestamp} or {Sequence}.', example='osspath/snapshot/{AppName}/{StreamName}/{UnixTimestamp}_ondemand.jpg', position='Query'),
  jpgOverwrite?: string(name='JpgOverwrite', description='The storage path for JPG files. This path is used to overwrite snapshots.

- Only JPG images are supported.

- The path supports variables such as {AppName} and {StreamName}.', example='osspath/snapshot/{AppName}/{StreamName}.jpg', position='Query'),
  jpgSequence?: string(name='JpgSequence', description='The storage path for JPG files. This path is used for sequence snapshots.

- Only JPG images are supported.

- The path supports variables such as {AppName}, {StreamName}, {UnixTimestamp}, and {Sequence}.

- You must include either {UnixTimestamp} or {Sequence}.', example='osspath/snapshot/{AppName}/{StreamName}/{UnixTimestamp}.jpg', position='Query'),
  mp4?: string(name='Mp4', description='The storage path for MP4 files.

- The path supports variables such as {AppName}, {StreamName}, {Sequence}, {EscapedStartTime}, and {EscapedEndTime}.

- You must include {EscapedStartTime} and {EscapedEndTime}.', example='osspath/record/{StreamName}/{EscapedStartTime}_{EscapedEndTime}', position='Query'),
  name?: string(name='Name', description='The name of the template.', example='录制模板', position='Query'),
  ossBucket?: string(name='OssBucket', description='The OSS bucket.', example='bucketname', position='Query'),
  ossEndpoint?: string(name='OssEndpoint', description='The domain name of the OSS bucket.', example='oss-cn-qingdao.aliyuncs.com', position='Query'),
  ossFilePrefix?: string(name='OssFilePrefix', description='The prefix of the OSS file.', example='oss-prefix', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  region?: string(name='Region', description='The region where the Object Storage Service (OSS) bucket is located.', example='cn-qingdao', position='Query'),
  retention?: long(name='Retention', description='The retention period for time shifting, in days.', example='3', position='Query'),
  transConfigsJSON?: string(name='TransConfigsJSON', description='An array of transcoding configurations of the TransConfig type, in a JSON-formatted string.', example='[{"Fps":25,"Gop":50,"Height":720,"VideoCodec":"h264","Width":1280,"Name":"sd","VideoBitrate":800}]', position='Query'),
  trigger?: string(name='Trigger', description='The trigger type of the template. The default value is auto. Valid values:

