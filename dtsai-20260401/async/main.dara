  body?: DescribeDocParserJobResultResponseBody(name='body'),
}

/**
  * @description - Region: Only China (Beijing) is supported.
  * - Fees: Free of charge during the public preview period.
  * - Call DescribeDocParserJobResult to retrieve the parsing result of a document parsing task. Call this operation only after DescribeDocParserJobStatus returns a Status of success. Task results are retained for 72 hours and cannot be retrieved after expiration.
  * @param request  the request parameters of DescribeDocParserJobResult  DescribeDocParserJobResultRequest
  * @return DescribeDocParserJobResultResponse
 */
async function describeDocParserJobResult(request: DescribeDocParserJobResultRequest): DescribeDocParserJobResultResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DescribeDocParserJobResult', 'POST', '/', 'json', false, 'json', request);
}

model DescribeDocParserJobStatusRequest {
  agentName?: string(name='AgentName', description='The agent name.', example='codex', position='Query'),
  jobId: string(name='JobId', description='The ID of the document parsing task. You can obtain the ID by calling CreateDocParserJob.

This parameter is required.', example='job_abc123', position='Query'),
  regionId: string(name='RegionId', description='The region ID.

This parameter is required.', example='cn-beijing', position='Query'),
}

model DescribeDocParserJobStatusResponseBody = {
  errorCode?: string(name='ErrorCode', description='The error code.', example='JobNotFound'),
  errorMessage?: string(name='ErrorMessage', description='The error message.', example='The specified job does not exist.'),
  failureMessage?: string(name='FailureMessage', description='The failure reason. This parameter has a value only when Status is failed.', example='Failed Message'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  requestId?: string(name='RequestId', description='The request ID.', example='A30D0930-xxxx-xxxx-xxxx-C2C661CC8B58'),
  status?: string(name='Status', description='The task status. Valid values:

- **init**: Created and being prepared.

- **pending**: Queued and waiting to be scheduled.

- **running**: Being processed and parsed.

- **success**: Completed. You can call DescribeDocParserJobResult to obtain the result.

- **failed**: Failed. The reason is provided in FailureMessage.

- **cancelled**: Canceled.', example='running'),
  success?: boolean(name='Success', description='Indicates whether the request was successful.', example='true'),
}

model DescribeDocParserJobStatusResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DescribeDocParserJobStatusResponseBody(name='body'),
}

