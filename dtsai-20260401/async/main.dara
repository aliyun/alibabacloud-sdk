model AuthorizeFileUploadRequest {
  agentName?: string(name='AgentName', description='The source of the agent or client that initiates the call, such as codex, cursor, or openapi. The maximum length is 32 characters. This parameter is used only for statistics and does not participate in authentication, throttling, quota management, or billing.', example='codex', position='Query'),
  batchSize?: string(name='BatchSize', description='The number of OSS PostObject direct upload authorizations returned in this request.', example='10', position='Query'),
  fileFormat?: string(name='FileFormat', description='The format of the file to be uploaded.', example='pdf', position='Query'),
  regionId: string(name='RegionId', description='The region ID, such as cn-beijing.

This parameter is required.', example='cn-beijing', position='Query'),
}

model AuthorizeFileUploadResponseBody = {
  accessKeyId?: string(name='AccessKeyId', description='The temporary AccessKey ID used for OSS PostObject.', example='STS.NV5xxx'),
  authorizations?: [ 
    {
      encodedPolicy?: string(name='EncodedPolicy', description='The Base64-encoded PostObject policy, which includes the object key and file size limits.', example='eyJleHBpcmF0aW9uIjo...'),
      objectKey?: string(name='ObjectKey', description='The object key that must be used exactly as provided for the upload.', example='0a1b_123456_0123456789abcdef0123456789abcdef'),
      signature?: string(name='Signature', description='The policy signature.', example='masked-signature'),
    }
  ](name='Authorizations', description='The list of OSS PostObject direct upload authorizations returned in batch.'),
  bucket?: string(name='Bucket', description='The destination OSS bucket.', example='dts-ai-upload-cn-beijing7500163e0eae09'),
  encodedPolicy?: string(name='EncodedPolicy', description='The Base64-encoded PostObject policy, which includes the object key and file size limits.', example='eyJleHBpcmF0aW9uIjo...'),
  endpoint?: string(name='Endpoint', description='OSS Endpoint', example='oss-cn-beijing.aliyuncs.com'),
  errorCode?: string(name='ErrorCode', description='The error code.', example='InvalidParameter'),
  errorMessage?: string(name='ErrorMessage', description='The error message.', example='The parameter [Query] is not valid.'),
  expireTime?: long(name='ExpireTime', description='The expiration time of the OSS PostObject direct upload authorization.', example='0'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The business semantic status code.', example='200'),
  objectKey?: string(name='ObjectKey', description='The object key that must be used exactly as provided for the upload.', example='0a1b_123456_0123456789abcdef0123456789abcdef'),
  requestId?: string(name='RequestId', description='The request ID.', example='A30D0930-xxxx-xxxx-xxxx-C2C661CC8B58'),
  securityToken?: string(name='SecurityToken', description='The temporary Security Token Service (STS) token.', example='CAISxxx'),
  signature?: string(name='Signature', description='The policy signature.', example='masked-signature'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='true'),
}

model AuthorizeFileUploadResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AuthorizeFileUploadResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AuthorizeFileUpload  AuthorizeFileUploadRequest
  * @return AuthorizeFileUploadResponse
 */
async function authorizeFileUpload(request: AuthorizeFileUploadRequest): AuthorizeFileUploadResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AuthorizeFileUpload', 'POST', '/', 'json', false, 'json', request);
}

model DescribeDocParserJobResultRequest {
