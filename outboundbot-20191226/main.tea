  faqCategoryIds?: string(name='FaqCategoryIds', description='The FAQ category IDs.', example='[30000474726]'),
  instanceId?: string(name='InstanceId', description='The instance ID.

This parameter is required.', example='af81a389-91f0-4157-8d82-720edd02b66a'),
  instructionJson?: string(name='InstructionJson', description='The instruction configuration.', example='[{
	"type": "TransferToAgent",
	"instructions": [{
		"code": "Transfer0",
		"skillGroupId": "testcode",
		"skillGroupName": "skillgroup"
	}],
