  jobGroupName: string(name='JobGroupName', description='The name of the job.

This parameter is required.', example='First job', position='Query'),
  minConcurrency?: long(name='MinConcurrency', description='The guaranteed concurrency.  
- When the job starts, a minimum of N concurrent calls are guaranteed.
- The sum of guaranteed concurrency for jobs of the same priority cannot exceed the instance concurrency.  
- If the guaranteed concurrency is set to 0, the system intelligently allocates idle concurrency.', example='1', position='Query'),
  priority?: string(name='Priority', description='The priority of the job group. Valid values:
- **Urgent**: urgent job.
- **Daily**: daily job.', example='Daily', position='Query'),
  recallCallingNumber?: [ string ](name='RecallCallingNumber', description='The list of caller numbers for redialing.', position='Query'),
  recallStrategyJson?: string(name='RecallStrategyJson', description='The redial strategy in JSON format. The default value of the parameters in the JSON object is false.

- **emptyNumberIgnore**: specifies whether to skip nonexistent numbers.
- **inArrearsIgnore**: specifies whether to skip numbers with overdue payments.
- **outOfServiceIgnore**: specifies whether to skip suspended numbers.', example='{"emptyNumberIgnore":true,"inArrearsIgnore":true,"outOfServiceIgnore":true}', position='Query'),
  ringingDuration?: long(name='RingingDuration', description='The optimal ringing duration. Default value: 25.', example='25', position='Query'),
  scenarioId?: string(name='ScenarioId', description='**[Deprecated]**', example='b9ff4e88-65f9-4eb3-987c-11ba51f3f24d', position='Query'),
  scriptId?: string(name='ScriptId', description='The scenario ID.', example='b9ff4e88-65f9-4eb3-987c-11ba51f3f24d', position='Query'),
  strategyJson?: string(name='StrategyJson', description='The execution strategy of the job.  
- repeatBy: the repetition type. Valid values: Once (no repetition), Week (weekly repetition), and Month (monthly repetition).  
- startTime: the start time of the time-based strategy.
- endTime: the end time of the time-based strategy.  
> Execution methods:
> - If the start and end times of the strategy are not specified, the execution method is immediate execution.
> - If the strategy time is specified, the job is executed based on the time, and the repetition type repeatBy must be selected.
- workingTime: the time period during which outbound calls can be made.
- maxAttemptsPerDay: the maximum number of call attempts per day for numbers under this job.
- minAttemptInterval: the retry interval for numbers, in minutes.
- routingStrategy: the number strategy. Valid values: None (not specified), LocalFirst (local numbers first), and LocalProvinceFirst (local province numbers first).
- repeatDays: the execution days corresponding to the repetition type. If the repetition type RepeatBy is Week, 0 represents Sunday, and 1 to 6 represent Monday to Saturday. If the repetition cycle RepeatBy is Month, 1 to 31 represent the 1st to the 31st day. Months without the specified date are not executed. For example, if the 30th is selected, the job is not executed in February.
- repeatable: specifies whether to enable cyclic jobs. Valid values: true and false.', example='{"maxAttemptsPerDay":"3","minAttemptInterval":"10","routingStrategy":"LocalProvinceFirst","repeatDays":["1","2","3"],"workingTime":[{"beginTime":"10:00:00","endTime":"11:00:00"},{"beginTime":"14:00:00","endTime":"15:00:00"}],"repeatable":true,"endTime":1707494400000,"startTime":1706976000000,"repeatBy":"Week"}', position='Query'),
}

