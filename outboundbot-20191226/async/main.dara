  callingNumber?: [ string ](name='CallingNumber', description='The caller number.', position='Query'),
  description?: string(name='Description', description='The job description.', example='Modified job group', position='Query'),
  flashSmsExtras?: string(name='FlashSmsExtras', description='The configuration parameters for flash message push in JSON format, including the configuration information of third-party flash messages.

templateId: the flash message template ID.  
configId: the flash message configuration ID.', example='{"templateId":"10471","configId":"8037f524-6ff2-4dbe-bb28-f59234ea7a64"}', position='Query'),
  instanceId: string(name='InstanceId', description='The instance ID.

