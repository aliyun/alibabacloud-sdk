  jobGroupId: string(name='JobGroupId', description='The job ID.

This parameter is required.', example='3edc0260-6f7c-4de4-8535-09372240618b', position='Query'),
  jobGroupStatus?: string(name='JobGroupStatus', description='The job status. Valid values:
- Draft: draft.
- Paused: paused.', example='Draft', position='Query'),
  minConcurrency?: long(name='MinConcurrency', description='The guaranteed concurrency.
When a job starts, a minimum of N concurrent calls are guaranteed.
The sum of guaranteed concurrency values for jobs of the same priority cannot exceed the instance concurrency.
If the guaranteed concurrency is set to 0, the system intelligently allocates idle concurrency.', example='1', position='Query'),
  name: string(name='Name', description='The job name.

This parameter is required.', example='Modified job group', position='Query'),
  priority?: string(name='Priority', description='The job group priority. Valid values:
- **Urgent**: urgent job.
- **Daily**: daily job.', example='Daily', position='Query'),
  recallCallingNumber?: [ string ](name='RecallCallingNumber', description='The list of caller numbers for recall.', position='Query'),
  recallStrategyJson?: string(name='RecallStrategyJson', description='The JSON string of the recall strategy.', example='{"emptyNumberIgnore":false,"inArrearsIgnore":false,"outOfServiceIgnore":false}', position='Query'),
  ringingDuration?: long(name='RingingDuration', description='The optimal ringing duration.', example='25', position='Query'),
  scenarioId?: string(name='ScenarioId', description='The scenario ID. This is a legacy parameter. Use ScriptId instead.

> This parameter is a legacy parameter. You can pass any value. Keep it consistent with the ScriptId.', example='c6a668d1-3145-4048-9101-cb3678bb8884', position='Query'),
  scriptId?: string(name='ScriptId', description='The script ID.', example='5a3940ce-a12f-4222-9f0f-605a9b89ea7c', position='Query'),
  strategyJson?: string(name='StrategyJson', description='The job execution strategy.
- id: the job group strategy ID. You can obtain it from the StrategyId response parameter of the DescribeJobGroup operation.
- repeatBy: the recurrence type. Valid values: Once (no recurrence), Day (daily), Week (weekly), and Month (monthly).
- startTime: the start time of the strategy.
- endTime: the end time of the strategy.
- workingTime: the time period during which outbound calls are allowed.
- maxAttemptsPerDay: the maximum number of call attempts per day for a phone number under this job.
- minAttemptInterval: the retry interval for a phone number, in minutes.
- routingStrategy: the phone number strategy. Valid values: None (not specified), LocalFirst (local numbers first), and LocalProvinceFirst (local province numbers first).
- repeatDays: the execution days corresponding to the recurrence type. If RepeatBy is Week, 0 indicates Sunday, and 1 to 6 indicate Monday to Saturday. If RepeatBy is Month, 1 to 31 indicate the 1st to the 31st day of the month. If a month does not have the specified day, the job is not executed in that month. For example, if the 30th is selected, the job is not executed in February.
- repeatable: specifies whether to enable recurring jobs. Valid values: true and false.', example='{"maxAttemptsPerDay":"3","minAttemptInterval":"10","routingStrategy":"LocalProvinceFirst","repeatDays":["1","2","3"],"workingTime":[{"beginTime":"10:00:00","endTime":"11:00:00"},"id":"cdca9ed7-6470-42d0-afb3-a41e08b41383",{"beginTime":"14:00:00","endTime":"15:00:00"}],"repeatable":true,"endTime":1707494400000,"startTime":1706976000000,"repeatBy":"Week"}', position='Query'),
}

