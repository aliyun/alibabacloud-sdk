/**
  *
  */
import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'EcdBiz';
  @version = '2024-09-29';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ActiveRightsRequest {
  clientIp?: string(name='ClientIp', description='The IP address of the client.', example='192.0.2.1', position='Body'),
  customImageId?: string(name='CustomImageId', description='The ID of the image that is available for the specification in the target region.', example='m-example', position='Body'),
  dataDiskSize?: int32(name='DataDiskSize', description='The size of the data cloud disk, in GiB. Pass this parameter only when the commodity supports this activation parameter.', example='80', position='Query'),
  desktopType?: string(name='DesktopType', description='The desktop type. Specify the value based on the types supported by the selected commodity. Omit this parameter if regular cloud desktops do not have this configuration.', example='eds.business_edition_office.4c8g', position='Query'),
  endTime?: string(name='EndTime', description='The end time of the non-hibernation period, in the HH:mm:ss format. This parameter is used together with StartTime.', example='18:00:00', position='Body'),
  hibernate?: int32(name='Hibernate', description='The hibernation-related options. The compute plan and existing activation rules corresponding to the right are used.', example='0', position='Body'),
  language?: string(name='Language', description='The display language of the cloud desktop. Valid values: en-US, ja-JP, zh-CN, and zh-HK.', example='zh-CN', position='Query'),
  officeSiteId?: string(name='OfficeSiteId', description='The ID of the office network in the target region. This parameter is required when you activate a cloud desktop.', example='cn-hangzhou+dir-example', position='Body'),
  policyGroupId?: string(name='PolicyGroupId', description='The ID of the policy group. This parameter is optional. If you do not specify this parameter, the default policy of the workspace is used.', example='pg-example', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The ID of the resource group. This parameter is optional. The ID is specified by the caller and passed through to the activation request.', example='rg-example', position='Query'),
  rightsAssignedUser?: [ string ](name='RightsAssignedUser', description='The list of IDs of the assigned end users. The IDs correspond to the rights in this batch by position. For convenience accounts, pass the EndUserId. The number of IDs must be the same as the number of rights.', example='["user-example"]', position='Body'),
  rightsGpuSpec?: string(name='RightsGpuSpec', description='The GPU specification. The value is subject to the return value of the rights details.', example='eds.graphics_flagship_pro.8c16g.2g', position='Body'),
  rightsIds?: [ string ](name='RightsIds', description='The list of IDs of the rights to be activated. Select the rights accessible to the current identity from ListRights. The parameters in the same batch apply to these rights.', example='["New_beds-example_0001"]', position='Body'),
  rightsResourceArea?: string(name='RightsResourceArea', description='The area to which the right belongs. This parameter cannot replace the resource region for a new activation request.', example='cn-east', position='Body'),
  rightsResourceImageOs?: string(name='RightsResourceImageOs', description='The operating system type of the image used for rights activation.', example='Windows', position='Body'),
  rightsResourceRegion?: string(name='RightsResourceRegion', description='The ID of the region where the resource resides. This parameter is configured separately from the routing region of the POP request.', example='cn-hangzhou', position='Body'),
  rightsResourceType?: string(name='RightsResourceType', description='The resource type of the right. For regular cloud desktops, use Desktop. For other commodities, pass the actual type of the right.', example='Desktop', position='Body'),
  rightsSpec?: string(name='RightsSpec', description='The specification code of the right. The value is subject to the rights query result.', example='eds.business_edition_office.4c8g', position='Body'),
  rootDiskSize?: int32(name='RootDiskSize', description='The size of the system cloud disk, in GiB. Pass this parameter only when the commodity supports this activation parameter.', example='80', position='Query'),
  startTime?: string(name='StartTime', description='The start time of the non-hibernation period, in the HH:mm:ss format. This parameter applies only to the corresponding compute plan.', example='09:00:00', position='Body'),
  vSwitchId?: string(name='VSwitchId', description='The ID of the vSwitch in the target office network. Pass the value based on the network type.', example='vsw-example', position='Body'),
  workspaceIds?: [ string ](name='WorkspaceIds', description='The list of AD workspace IDs used for BusinessJvsCopilotAgent activation.', example='["ws-example"]', position='Query'),
  wyidList?: [ string ](name='WyidList', description='The list of WAIDs used for BusinessJvsCopilotAgent activation. Do not pass this parameter for regular cloud desktop activation.', example='["waid-example"]', position='Query'),
}

model ActiveRightsResponseBody = {
  code?: string(name='Code', description='The business processing result code.', example='Success'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  message?: string(name='Message', description='The description of the processing result. This parameter is used to help troubleshoot failures.', example='The request is processed'),
  requestId?: string(name='RequestId', description='The unique ID of the request. You can use the ID to troubleshoot issues.', example='01A00000-0000-4000-8000-000000000001'),
  success?: boolean(name='Success', description='Indicates whether the request is processed. A successful activation request does not mean that the resource is created.', example='true'),
}

model ActiveRightsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ActiveRightsResponseBody(name='body'),
}

/**
  * @description Activates the commercial edition rights under the current account. First, query the rights by calling ListRights, and then select the target region, office network, image, and user. A Success response indicates that the request is processed. To check the resource creation result, query the RightsActiveStatus, RightsActiveFailureCause, and RightsResourceId parameters returned by ListRights.
  * @param request  the request parameters of ActiveRights  ActiveRightsRequest
  * @return ActiveRightsResponse
 */
async function activeRights(request: ActiveRightsRequest): ActiveRightsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ActiveRights', 'POST', '/', 'json', true, 'form', request);
}

model ListRightsRequest {
  aiDesktop?: boolean(name='AiDesktop', description='Optional AI rights filter. Set to true to query only AI rights, or false to query only regular rights, including historical unmarked rights. If you do not specify this parameter, all rights are queried.', example='true', position='Body'),
  businessSceneCode?: string(name='BusinessSceneCode', description='The scenario code for the commercial edition.', example='GENERAL_OFFICE', position='Query'),
  maxResults?: int32(name='MaxResults', description='The maximum number of results per page. Specify a positive integer from 1 to 200.', example='20', minimum=0, maximum=200, position='Body'),
  nextToken?: string(name='NextToken', description='The pagination token. Do not specify this parameter for the first query. For subsequent queries, pass the NextToken value returned from the previous page exactly as it was returned. The example is for illustration purposes only. Do not construct the token manually.', example='b5f4e3d2c1a09876b5f4e3d2c1a09876', position='Body'),
  orderField?: string(name='OrderField', description='The field by which to sort the results, such as gmtCreate, rightsId, or rightsExpireTime. If you do not specify this parameter, the default sorting order of the server is used.', example='gmtCreate', position='Body'),
  orderType?: string(name='OrderType', description='The sorting order. Valid values: asc and desc (lowercase). Use this parameter together with OrderField.', example='desc', position='Body'),
  overseas?: int32(name='Overseas', description='Specifies whether the rights apply to regions outside the Chinese mainland, including Hong Kong (China), Macao (China), and Taiwan (China). Valid values:
- 0: The Chinese mainland.
- 1: Regions outside the Chinese mainland, including Hong Kong (China), Macao (China), and Taiwan (China).', example='0', position='Body'),
  rightsActiveStatus?: string(name='RightsActiveStatus', description='The rights activation status. Use the returned value to determine whether the activation is complete.', example='ACTED', position='Body'),
  rightsAssignedUser?: string(name='RightsAssignedUser', description='The end user to whom the rights are assigned. For convenience accounts, use EndUserId.', example='user-example', position='Body'),
  rightsIds?: [ string ](name='RightsIds', description='The list of rights IDs to query or activate. Specify the RightsId values returned by ListRights.', example='["New_beds-example_0001"]', position='Query'),
  rightsPeriod?: string(name='RightsPeriod', description='The rights period code.', example='BUSINESS_WEEK_1', position='Body'),
  rightsResourceId?: string(name='RightsResourceId', description='The ID of the resource associated with the rights. This value is returned after the resource is created.', example='ecd-example', position='Body'),
  rightsResourceType?: string(name='RightsResourceType', description='The rights resource type. Use Desktop for regular cloud computers. For other commodities, specify the actual rights type.', example='Desktop', position='Body'),
  rightsResourceTypes?: [ string ](name='RightsResourceTypes', description='The list of rights resource types to filter.', example='["Desktop"]', position='Body'),
  rightsSpec?: string(name='RightsSpec', description='The rights specification code. Refer to the rights query results for the actual value.', example='eds.business_edition_office.4c8g', position='Body'),
}

model ListRightsResponseBody = {
  code?: string(name='Code', description='The business processing result code.', example='Success'),
  data?: [ 
    {
      addDataDiskSize?: int32(name='AddDataDiskSize', description='The size of the additional data cloud disk. Unit: GiB.', example='0'),
      addRootDiskSize?: int32(name='AddRootDiskSize', description='The size of the additional system cloud disk. Unit: GiB.', example='0'),
      aiDesktop?: boolean(name='AiDesktop', description='Indicates whether the cloud computer is an AI cloud computer. Valid values:
- true: AI cloud computer.
- false: Regular cloud computer.', example='true'),
      businessSceneCode?: string(name='BusinessSceneCode', description='The scenario code for the commercial edition.', example='GENERAL_OFFICE'),
      calculatingCode?: string(name='CalculatingCode', description='The compute plan code. Refer to the actual returned value of the rights.', example='HOURS_120_PER_MONTH'),
      dataDiskSize?: int32(name='DataDiskSize', description='The size of the data cloud disk. Unit: GiB.', example='80'),
      gmtCreate?: string(name='GmtCreate', description='The time when the rights record was created. The time is in RFC 3339 UTC format and ends with Z.', example='2026-11-06T01:00:00Z'),
      hibernate?: int32(name='Hibernate', description='The hibernation options for the rights. The actual policy is determined in combination with the compute plan.', example='0'),
      monthlyCredit?: string(name='MonthlyCredit', description='The monthly credit information corresponding to the rights. This value may be empty if this configuration is not available.', example='2000'),
      overseas?: int32(name='Overseas', description='Specifies whether the rights apply to regions outside the Chinese mainland, including Hong Kong (China), Macao (China), and Taiwan (China). Valid values:
- 0: The Chinese mainland.
- 1: Regions outside the Chinese mainland, including Hong Kong (China), Macao (China), and Taiwan (China).', example='0'),
      rightsActiveFailureCause?: string(name='RightsActiveFailureCause', description='The cause of the rights activation failure. This value may be empty if the activation is successful.', example='The image is unavailable. Select an available image and try again'),
      rightsActiveStatus?: string(name='RightsActiveStatus', description='The rights activation status. Use the returned value to determine whether the activation is complete.', example='ACTED'),
      rightsActiveTime?: string(name='RightsActiveTime', description='The time when the rights were activated. This value may be empty if the rights are not yet activated. The time is in RFC 3339 UTC format and ends with Z.', example='2026-11-06T01:00:00Z'),
      rightsAssignedUser?: string(name='RightsAssignedUser', description='The end user to whom the rights are assigned. For convenience accounts, use EndUserId.', example='user-example'),
      rightsExpireTime?: string(name='RightsExpireTime', description='The deadline for manual activation of the rights. This is different from RightsResourceExpireTime, which is the expiration time of the resource after activation. The time is in RFC 3339 UTC format and ends with Z.', example='2026-12-06T00:00:00Z'),
      rightsGpuSpec?: string(name='RightsGpuSpec', description='The GPU specification. Refer to the returned value in the rights details.', example='eds.graphics_flagship_pro.8c16g.2g'),
      rightsId?: string(name='RightsId', description='The rights ID. Use this value for activation. This is not the cloud computer resource ID.', example='New_beds-example_0001'),
      rightsInventorySpec?: string(name='RightsInventorySpec', description='The inventory specification corresponding to the rights.', example='eds.business_edition_office.4c8g'),
      rightsPeriod?: string(name='RightsPeriod', description='The rights period code.', example='BUSINESS_WEEK_1'),
      rightsResourceArea?: string(name='RightsResourceArea', description='The area to which the rights belong. This cannot replace the resource region in a new activation request.', example='cn-east'),
      rightsResourceExpireTime?: string(name='RightsResourceExpireTime', description='The actual expiration time of the resource. This is different from the deadline for rights activation. The time is in RFC 3339 UTC format and ends with Z.', example='2026-12-06T01:00:00Z'),
      rightsResourceId?: string(name='RightsResourceId', description='The ID of the resource associated with the rights. This value is returned after the resource is created.', example='ecd-example'),
      rightsResourceRegion?: string(name='RightsResourceRegion', description='The region ID of the resource. This is configured separately from the POP request routing region.', example='cn-hangzhou'),
      rightsResourceStatus?: string(name='RightsResourceStatus', description='The status of the associated resource. Refer to the returned value for the actual status.', example='Running'),
      rightsResourceType?: string(name='RightsResourceType', description='The rights resource type. Use Desktop for regular cloud computers. For other commodities, specify the actual rights type.', example='Desktop'),
      rightsSourceName?: string(name='RightsSourceName', description='The name of the rights source.', example='Channel Service Provider Co., Ltd'),
      rightsSpec?: string(name='RightsSpec', description='The rights specification code. Refer to the rights query results for the actual value.', example='eds.business_edition_office.4c8g'),
      systemDiskSize?: int32(name='SystemDiskSize', description='The size of the system cloud disk. Unit: GiB.', example='80'),
      valuePackageInfos?: [ 
        {
          function?: string(name='Function', description='The content of the value-added feature.', example='Basic monitoring, real-time monitoring, session monitoring, and application control'),
          valuePackageCode?: string(name='ValuePackageCode', description='The value-added feature code.', example='Monitor'),
        }
      ](name='ValuePackageInfos', description='The list of value-added feature information associated with the rights.', example='[]'),
    }
  ](name='Data', description='The list of rights on the current page.', example='[]'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  maxResults?: int32(name='MaxResults', description='The maximum number of results per page. Specify a positive integer from 1 to 200.', example='20'),
  message?: string(name='Message', description='The description of the processing result. This is used for troubleshooting when a failure occurs.', example='The request is processed successfully'),
  nextToken?: string(name='NextToken', description='The pagination token for the next page. An empty value indicates that the current query has ended. If the value is not empty, pass it exactly as it is in the next query. The example is for illustration purposes only.', example='b5f4e3d2c1a09876b5f4e3d2c1a09876'),
  requestId?: string(name='RequestId', description='The unique identifier of the request. This is used to troubleshoot call issues.', example='01A00000-0000-4000-8000-000000000001'),
  success?: boolean(name='Success', description='Indicates whether the request was processed successfully. A successful activation request does not mean that the resource has been created.', example='true'),
  totalCount?: int32(name='TotalCount', description='The total number of rights that meet the query conditions.', example='1'),
}

model ListRightsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListRightsResponseBody(name='body'),
}

/**
  * @description Queries the commercial edition rights accessible to the current caller identity by using paging. Use this operation to select rights before activation. After you call ActiveRights, you can query the processing results by using RightsActiveStatus, RightsActiveFailureCause, and RightsResourceId.
  * @param request  the request parameters of ListRights  ListRightsRequest
  * @return ListRightsResponse
 */
async function listRights(request: ListRightsRequest): ListRightsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListRights', 'POST', '/', 'json', true, 'form', request);
}

