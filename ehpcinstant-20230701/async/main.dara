              {
                size?: int32(name='Size', description='The size of the cloud disk. Unit: GiB.', example='40'),
                type?: string(name='Type', description='The type of the cloud disk.', example='System'),
              }
            ](name='Disks', description='The array of cloud disks.'),
            enableHT?: boolean(name='EnableHT', description='Specifies whether hyper-threading is enabled in the runtime environment.', example='true'),
            hostNamePrefix?: string(name='HostNamePrefix', description='The hostname prefix of the runtime environment.', example='compute'),
            instanceTypes?: [ string ](name='InstanceTypes', description='The instance types of the runtime environment.', example='ecs.c7a.8xlarge'),
            memory?: float(name='Memory', description='The memory size of the runtime environment. Unit: GiB.', example='4'),
          }(name='Resource', description='The resource information of the runtime environment.'),
          retryPolicy?: {
            exitCodeActions?: [ 
              {
                action?: string(name='Action', description='The next action of the task. Valid values:
- Retry: Retries the task.
- Exit: Exits the task.', example='Retry'),
                exitCode?: long(name='ExitCode', description='The exit code of the task. This code is used together with the Action parameter to form the retry rules for the job. Valid values: 0 to 255.', example='1'),
              }
            ](name='ExitCodeActions', description='The retry rules.'),
            retryCount?: int32(name='RetryCount', description='The number of retries.', example='5'),
          }(name='RetryPolicy', description='The retry policy of the task.'),
          taskExecutor?: [ 
            {
              container?: {
                appId?: string(name='AppId', description='The ID of the container application.', example='ci-vm-32k6LXAi3cOG'),
                arg?: [ string ](name='Arg', description='The arguments for the container startup commands.', example='60s'),
                command?: [ string ](name='Command', description='The list of startup commands for the container.', example='sleep'),
                environmentVars?: [ 
                  {
                    name?: string(name='Name', description='The name of the environment variable.', example='PATH'),
                    value?: string(name='Value', description='The value of the environment variable.', example='/usr/local/bin'),
                  }
                ](name='EnvironmentVars', description='The environment variables of the container.'),
                gpuDriverVersion?: string(name='GpuDriverVersion', description='The GPU driver version.', example='tesla=535'),
