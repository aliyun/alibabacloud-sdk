import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'EhpcInstant';
  @version = '2023-07-01';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model AddImageRequest {
  containerImageSpec?: {
    isACREnterprise?: boolean(name='IsACREnterprise', description='Specifies whether the image is stored in Alibaba Cloud Container Registry Enterprise Edition. Valid values:

- True: yes
- False: no', example='True'),
    isACRRegistry?: boolean(name='IsACRRegistry', description='Specifies whether the image is stored in Alibaba Cloud Container Registry. Valid values:

- True: yes
- False: no', example='True'),
    registryCredential?: {
      password?: string(name='Password', description='The logon password.', example='userpassword'),
      server?: string(name='Server', description='The registry address of the image repository.', example='registry-vpc.cn-hangzhou.aliyuncs.com'),
      userName?: string(name='UserName', description='The logon username.', example='username'),
    }(name='RegistryCredential', description='The authentication credentials for the private image repository.'),
    registryCriId?: string(name='RegistryCriId', description='The ID of the Container Registry Enterprise Edition instance.', example='cri-xyz795ygf8k9****'),
    registryUrl?: string(name='RegistryUrl', description='The access URL of the container image.', example='registry-vpc.cn-hangzhou.aliyuncs.com/ehpc_open/nginx:latest'),
  }(name='ContainerImageSpec', description='The container image configuration.', shrink='json', position='Query'),
  description?: string(name='Description', description='The image description.', example='Test image', position='Query'),
  imageType?: string(name='ImageType', description='The image type. Valid values:

- VM: virtual machine image
- Container: container image', example='VM', position='Query'),
  imageVersion?: string(name='ImageVersion', description='The image version.', example='V1.0', position='Query'),
  name: string(name='Name', description='The image name.

This parameter is required.', example='app-image', position='Query'),
  VMImageSpec?: {
    imageId?: string(name='ImageId', description='The image ID.', example='m-bp1akkkr1rkxtb******'),
  }(name='VMImageSpec', description='The virtual machine image configuration.', shrink='json', position='Query'),
}

model AddImageResponseBody = {
  imageId?: string(name='ImageId', description='The image ID.', example='m-bp1akkkr1rkxtb******'),
  requestId?: string(name='RequestId', description='The request ID.', example='04F0F334-1335-436C-A1D7-6C044FE73368'),
  success?: boolean(name='Success', description='Indicates whether the command execution and result retrieval were successful. Valid values:

- true: successful
- false: failed', example='True'),
}

model AddImageResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddImageResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddImage  AddImageRequest
  * @return AddImageResponse
 */
async function addImage(request: AddImageRequest): AddImageResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddImage', 'POST', '/', 'json', false, 'json', request);
}

model CreateActionPlanRequest {
  actionPlanName?: string(name='ActionPlanName', description='The name of the execution plan.', example='TestActionPlan', position='Query'),
  allocationSpec?: string(name='AllocationSpec', description='The resource allocation specification. Valid values:
- Standard: standard
- Dedicated: dedicated. To use this value, you must be added to the whitelist.
- Economic: economy. To use this value, you must be added to the whitelist.', example='Standard', position='Query'),
  appId?: string(name='AppId', description='The application ID.', example='ci-vm-rYfypJKwlN9Y', position='Query'),
  desiredCapacity?: double(name='DesiredCapacity', description='The desired resource capacity for the execution plan. If ResourceType is set to VCpuCapacity, this parameter specifies the expected number of vCPUs to maintain, such as 10000.', example='1000', position='Query'),
  intervalMinutes?: int32(name='IntervalMinutes', description='The scheduling interval of the execution plan. Unit: minutes. Valid values: 10 to 10080. Default value: 60.', example='60', position='Query'),
  level?: string(name='Level', description='The computing power level. This parameter takes effect only when the resource type is set to Economic. Valid values:
- General: general-purpose
- Performance: performance-optimized

Default value: General.', example='General', position='Query'),
  prologScript?: string(name='PrologScript', description='The prolog script. The script must be Base64-encoded.', example='bHMgLWFsCmxzIC1hbGggfCB3YyAtbA==', position='Query'),
  regions?: [ 
    {
      regionId?: string(name='RegionId', description='The region ID.', example='cn-hangzhou'),
      securityGroupId?: [ string ](name='SecurityGroupId', description='The list of security groups available for the execution plan in the region. You can specify 0 to 5 security groups.'),
      securityGroupIds?: [ string ](name='SecurityGroupIds', description='The list of security group IDs. You can call the [DescribeSecurityGroups](https://api.aliyun.com/document/Ecs/2014-05-26/DescribeSecurityGroups) operation to query available security groups.'),
      vSwitchIds?: [ string ](name='VSwitchIds', description='The list of vSwitches available for the execution plan in the region. You can specify 0 to 5 vSwitches.'),
    }
  ](name='Regions', description='The list of region-specific resource configurations for the runtime environment of the execution plan.', shrink='json', position='Query'),
  resourceType?: string(name='ResourceType', description='The type of the target resource for the execution plan. Valid values:

- VCpuCapacity: vCPU capacity

- ExecutorCapacity: number of execution nodes', example='VCpuCapacity', position='Query'),
  resources?: [ 
    {
      cores?: double(name='Cores', description='The number of CPU cores in the runtime environment.', example='2'),
      memory?: double(name='Memory', description='The memory size of the runtime environment. Unit: GiB.', example='4'),
    }
  ](name='Resources', description='The list of resource configurations for the runtime environment of the execution plan. You can specify 1 to 10 resource configurations.', shrink='json', position='Query'),
  script?: string(name='Script', description='The script used to run the job. The script must be Base64-encoded.', example='bHMgLWFsCmxzIC1hbGggfCB3YyAtbA==', position='Query'),
}

model CreateActionPlanResponseBody = {
  actionPlanId?: string(name='ActionPlanId', description='The execution plan ID.', example='ap-hz036ubmx2qmw93k****'),
  requestId?: string(name='RequestId', description='The request ID.', example='896D338C-E4F4-41EC-A154-D605E5DE****'),
}

model CreateActionPlanResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateActionPlanResponseBody(name='body'),
}

/**
  * @description **Make sure that you fully understand the billing methods and [pricing](https://www.alibabacloud.com/help/en/e-hpc/e-hpc-instant/product-overview/billing-overview) of E-HPC Instant before you call this operation.**
  * @param request  the request parameters of CreateActionPlan  CreateActionPlanRequest
  * @return CreateActionPlanResponse
 */
async function createActionPlan(request: CreateActionPlanRequest): CreateActionPlanResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateActionPlan', 'POST', '/', 'json', false, 'json', request);
}

model CreateJobRequest {
  dependencyPolicy?: {
    jobDependency?: [ 
      {
        jobId: string(name='JobId', description='The job ID.

This parameter is required.', example='job-bjxxxxxxxxxxxx'),
        type?: string(name='Type', description='The dependency type. Valid values:

- AfterSucceeded: All child jobs of the dependent job or array job run successfully (the exit code is 0).
- AfterFailed: Any child job of the dependent job or array job fails (the exit code is not 0).
- AfterAny: The dependent job finishes running, regardless of success or failure.
- AfterCorresponding: The corresponding child job of the dependent array job runs successfully (the exit code is 0).

Default value: AfterSucceeded.', example='AfterSucceeded'),
      }
    ](name='JobDependency', description='The job dependencies. A maximum of 10 dependencies are supported.'),
  }(name='DependencyPolicy', description='The dependency policy.', shrink='json', position='Query'),
  deploymentPolicy?: {
    allocationSpec?: string(name='AllocationSpec', description='The resource type. Valid values:
- Standard: standard.
- Dedicated: dedicated. You must be added to the whitelist to use this type.
- Economic: economic. You must be added to the whitelist to use this type.', example='Dedicated'),
    level?: string(name='Level', description='The computing power level. This parameter is valid only when the resource type is economy. Valid values:
- General: general-purpose.
- Performance: compute-optimized.

Default value: General.', example='General'),
    network?: {
      enableENIMapping?: boolean(name='EnableENIMapping', description='Specifies whether resource scheduling is restricted to the specified vSwitch. Default value: false.', example='true'),
      enableExternalIpAddress?: boolean(name='EnableExternalIpAddress', description='Specifies whether to create a public IP address for the job. Valid values:
- true: A public IP address is created.
- false: No public IP address is created.

Default value: false.', example='true'),
      vswitch?: [ string ](name='Vswitch', description='The vSwitch array.'),
    }(name='Network', description='The network configuration information.'),
    pool?: string(name='Pool', description='The resource pool of the job.', example='compute'),
    priority?: int32(name='Priority', description='The priority of the job. A larger value indicates a higher scheduling priority. Valid values: 1 to 100.', example='1'),
    tag?: [ 
      {
        key: string(name='Key', description='The tag key. If this parameter is specified, it cannot be an empty string. The tag key can be up to 128 characters in length. It cannot start with aliyun or acs: and cannot contain http:// or https://.

This parameter is required.', example='TestKey'),
        value?: string(name='Value', description='The tag value. If this parameter is specified, it can be an empty string. The tag value can be up to 128 characters in length and cannot contain http:// or https://.', example='TestValue'),
      }
    ](name='Tag', description='The tag information of the job. A maximum of 20 tags are supported.'),
  }(name='DeploymentPolicy', description='The resource deployment policy.', shrink='json', position='Query'),
  jobDescription?: string(name='JobDescription', description='The job description.', example='Demo', position='Query'),
  jobName: string(name='JobName', description='The job name. The name must be 2 to 64 characters in length and can contain Chinese characters, English letters, and digits. It can also contain hyphens (-) and underscores (_).

This parameter is required.', example='testjob', position='Query'),
  jobScheduler?: string(name='JobScheduler', position='Query'),
  jobTemplateId?: string(name='JobTemplateId', description='The job template ID.', example='jt-xxxx', position='Query'),
  securityPolicy?: {
    securityGroup?: {
      securityGroupIds?: [ string ](name='SecurityGroupIds', description='The array of security group IDs.'),
    }(name='SecurityGroup', description='The security group.'),
  }(name='SecurityPolicy', description='The security policy.', shrink='json', position='Query'),
  tasks: [ 
    {
      executorPolicy?: {
        arraySpec?: {
          indexEnd?: int32(name='IndexEnd', description='The end value of the array job index. Valid values: 0 to 4999. The value must be greater than or equal to IndexStart.', example='9'),
          indexStart?: int32(name='IndexStart', description='The start value of the array job index. Valid values: 0 to 4999.', example='0'),
          indexStep?: int32(name='IndexStep', description='The step of the array job index.
> If the array job attributes are IndexStart=1, IndexEnd=5, and IndexStep=2, the array job contains three sub-jobs with index values of 1, 3, and 5. User business programs can access these values through environment variables.', example='1'),
        }(name='ArraySpec', description='The array job details. The index values of sub-jobs are passed to the runtime environment through environment variables and can be referenced by user business programs. The environment variables include:
- EHPC_JOB_NAME: the job name, which corresponds to the JobName parameter.
- EHPC_JOB_ID: the job ID.
- EHPC_TASK_NAME: the task name, which corresponds to the TaskName parameter.
- EHPC_EXECUTOR_ID: the executor ID.
- EHPC_ARRAY_TASK_ID: the index value of the sub-job.
- EHPC_ARRAY_TASK_COUNT: the total number of sub-jobs.
- EHPC_ARRAY_TASK_MAX: the maximum index value of the sub-job, which corresponds to the IndexStart parameter.
- EHPC_ARRAY_TASK_MIN: the minimum index value of the sub-job, which corresponds to the IndexEnd parameter.
- EHPC_ARRAY_TASK_STEP: the index step of the sub-job, which corresponds to the IndexStep parameter.'),
        maxCount?: int32(name='MaxCount', description='The maximum number of nodes for the job execution.
> The value must follow the formula: `MaxCount = (IndexEnd - IndexStart) / IndexStep + 1`.', example='1'),
      }(name='ExecutorPolicy', description='The task execution policy.'),
      taskName?: string(name='TaskName', description='The task name. The name must be 2 to 32 characters in length and can contain Chinese characters, English letters, and digits. It can also contain hyphens (-) and underscores (_).', example='task0'),
      taskSpec?: {
        resource?: {
          cores?: float(name='Cores', description='The number of CPUs in the runtime environment.', example='2'),
          disks?: [ 
            {
              size?: int32(name='Size', description='The size of the cloud disk. Unit: GiB.', example='40'),
              type?: string(name='Type', description='The cloud disk type. Only System is supported, which indicates a system cloud disk.', example='System'),
            }
          ](name='Disks', description='The cloud disk array.'),
          enableHT?: boolean(name='EnableHT', description='Specifies whether to enable hyper-threading in the runtime environment. Default value: true.', example='true'),
          hostNamePrefix?: string(name='HostNamePrefix', description='The hostname prefix of the runtime environment. Limits:

- The prefix cannot start or end with a period (.) or a hyphen (-), and cannot contain consecutive periods (.) or hyphens (-).
- Windows environment: The prefix can be up to 10 characters in length and cannot contain periods (.). It cannot contain only digits. It can contain uppercase and lowercase letters, digits, and hyphens (-).
- Linux environment: The prefix can be up to 32 characters in length and can contain multiple periods (.). The string between two periods is a segment, and each segment can contain uppercase and lowercase letters, digits, and hyphens (-).', example='compute'),
          instanceTypes?: [ string ](name='InstanceTypes', description='The instance types of the runtime environment. A maximum of 5 instance types are supported.'),
          memory?: float(name='Memory', description='The memory size of the runtime environment. Unit: GiB.', example='4'),
        }(name='Resource', description='The resource information of the runtime environment.'),
        retryPolicy?: {
          exitCodeActions?: [ 
            {
              action: string(name='Action', description='The next action of the task. Valid values:

- Retry: The job starts a new retry when the specified exit code is matched.

- Exit: The job exits when the specified exit code is matched.

This parameter is required.', example='Retry'),
              exitCode: long(name='ExitCode', description='The task exit code, which is used together with Action to form the job retry rule. Valid values: 0 to 255.

This parameter is required.', example='1'),
            }
          ](name='ExitCodeActions', description='The retry rules. A maximum of 10 retry rules are supported.'),
          retryCount?: int32(name='RetryCount', description='The number of retries. Valid values: 1 to 10. Default value: 3.', example='5'),
        }(name='RetryPolicy', description='The task retry policy.'),
        taskExecutor: [ 
          {
            container?: {
              appId?: string(name='AppId', description='The ID of the container application.', example='ci-vm-32k6LXAi3cOG'),
              arg?: [ string ](name='Arg', description='The arguments for the container startup command. A maximum of 10 arguments are supported.'),
              command?: [ string ](name='Command', description='The list of container startup commands. A maximum of 20 commands are supported, and each command can be up to 256 characters in length.    
> 1. If a startup command contains spaces (for example, `sleep 60s`), pass the parameter in JSON format as `["sleep", "60s"]`.
> 2. If the startup command is complex, you can combine `Command: ["/bin/bash"]` and `Arg:["-c", "<customized command>"]`. `<customized command>` is a custom command combination defined by the user and can contain spaces and other characters.'),
              environmentVars?: [ 
                {
                  name?: string(name='Name', description='The name of the environment variable. The name must be 1 to 128 characters in length and can contain letters, digits, and underscores (_). It cannot start with a digit.', example='PATH'),
                  value?: string(name='Value', description='The value of the environment variable. The value can be 0 to 256 characters in length.', example='/usr/local/bin'),
                }
              ](name='EnvironmentVars', description='The environment variables of the container. A maximum of 20 environment variables are supported.'),
              gpuDriverVersion?: string(name='GpuDriverVersion', description='Specifies the GPU driver version.', example='tesla=535'),
              image: string(name='Image', description='The container image.

This parameter is required.', example='registry-vpc.cn-hangzhou.aliyuncs.com/ehpc/hpl:latest'),
              imageRegistryOptions?: string(name='ImageRegistryOptions', description='The list of mount parameters for the self-managed image registry. The parameters are passed in JSON format as key-value pairs.

- Sample format: {"ImageRegistryType":"https","ImageRegistryServer":"xxx","ImageRegistryUserName":"xxx","ImageRegistryPassword":"xxx"}', example='{"ImageRegistryType":"https","ImageRegistryServer":"xxx","ImageRegistryUserName":"xxx","ImageRegistryPassword":"xxx"}'),
              privileged?: boolean(name='Privileged', description='Specifies whether to run the container in privileged mode. Default value: false.', example='true'),
              workingDir?: string(name='WorkingDir', description='The working directory of the container.', example='/usr/local/'),
            }(name='Container', description='The container environment.'),
            vm?: {
              appId?: string(name='AppId', description='The ID of the virtual machine application.', example='ci-vm-9jc58Pm5Leky'),
              environmentVars?: [ 
                {
                  name?: string(name='Name', description='The name of the environment variable.', example='PATH'),
                  value?: string(name='Value', description='The value of the environment variable.', example='/usr/local/bin'),
                }
              ](name='EnvironmentVars', description='The environment variables of the virtual machine.'),
              image: string(name='Image', description='The image ID.

This parameter is required.', example='m-xxxx'),
              password?: string(name='Password', description='The logon password for the virtual machine environment. The password must be 8 to 30 characters in length and must contain at least three of the following character types: uppercase letters, lowercase letters, digits, and special characters. Special characters include:

()`~!@#$%^&*-_+=|{}[]:;\\\\"<>,.?/
The password for a Windows environment cannot start with a forward slash (/).

> If you specify the Password parameter, use HTTPS to send the request to prevent password leaks.', example='EHPC@1234'),
              prologScript?: string(name='PrologScript', description='The pre-processing script. The script must be Base64-encoded.', example='ZWNobyBoZWxsbyBlY3Mh'),
              script?: string(name='Script', description='The job execution script. The script must be Base64-encoded.', example='ZWNobyBoZWxsbyBlY3Mh'),
            }(name='VM', description='The virtual machine environment.'),
          }
        ](name='TaskExecutor', description='The task execution configuration.

This parameter is required.'),
        volumeMount?: [ 
          {
            mountOptions?: string(name='MountOptions', description='The list of mount parameters for the data volume. The parameters are passed in JSON format as key-value pairs.
- Sample format for mounting a NAS file system: {"server":"xxxxx-xxxxx.cn-heyuan.nas.aliyuncs.com","vers":"3","path":"/data","options":"nolock,tcp,noresvport"}
> server indicates the mount target address of the NAS file system. path indicates the subdirectory under the NAS path, which must start with a forward slash (/) and already exist. vers indicates the NFS protocol version used to mount the NAS file system. We recommend that you use v3. options indicates the custom parameters for mounting the NAS file system, in the format of "xxx,xxx,xxx".

- Sample format for mounting an OSS bucket: {"bucket":"xxxxx", "url":"oss-cn-heyuan-internal.aliyuncs.com","path":"/data","akId":"xxxxx","akSecret":"xxxxx"}
> bucket indicates the name of the OSS bucket. url indicates the endpoint of the OSS bucket. You can log on to the OSS console and obtain the endpoint on the Overview page of the bucket. path indicates the directory structure relative to the root directory of the bucket when the volume is mounted. The default value is /, and the directory must already exist. akId indicates the AccessKey ID used for direct authorization. akSecret indicates the AccessKey secret used for direct authorization.', example='{"server":"xxxxx-xxxxx.cn-heyuan.nas.aliyuncs.com","vers":"3","path":"/data","options":"nolock,tcp,noresvport"}'),
            mountPath?: string(name='MountPath', description='The directory to which the data volume is mounted.

> The content in the mount directory is directly overwritten by the content of the volume. Proceed with caution.', example='/mnt'),
            readOnly?: boolean(name='ReadOnly', description='Specifies whether the data volume is read-only. Default value: false.', example='false'),
            volumeDriver?: string(name='VolumeDriver', description='The type of the data volume. Valid values:
- alicloud/nas: mounts a NAS file system.
- alicloud/oss: mounts an OSS bucket.', example='alicloud/nas'),
          }
        ](name='VolumeMount', description='The list of data volumes mounted to the task. A maximum of 10 data volumes are supported.'),
      }(name='TaskSpec', description='The task specification details.'),
      taskSustainable?: boolean(name='TaskSustainable', description='Specifies whether the job runs for a long time. Valid values:
- true: The job is a background service job.
- false: The job is a batch job.

Default value: false.', example='true'),
    }
  ](name='Tasks', description='The list of tasks. Only one task is supported.

This parameter is required.', shrink='json', position='Query'),
}

model CreateJobResponseBody = {
  jobId?: string(name='JobId', description='The job ID.', example='job-xxxx'),
  requestId?: string(name='RequestId', description='The request ID.', example='896D338C-E4F4-41EC-A154-D605E5DE****'),
  tasks?: [ 
    {
      executorIds?: [ string ](name='ExecutorIds', description='The list of executor IDs included in the task.'),
      taskName?: string(name='TaskName', description='The task name.', example='task0'),
    }
  ](name='Tasks', description='The list of tasks.'),
}

model CreateJobResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateJobResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateJob  CreateJobRequest
  * @return CreateJobResponse
 */
async function createJob(request: CreateJobRequest): CreateJobResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateJob', 'POST', '/', 'json', false, 'json', request);
}

