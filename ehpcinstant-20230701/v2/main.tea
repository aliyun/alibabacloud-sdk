      vSwitchIds?: [ string ](name='VSwitchIds', description='A list of vSwitches that are available for the execution plan in the region. You can specify 0 to 5 vSwitches.'),
    }
  ](name='Regions', description='A list of regional resource configurations for the runtime environment of the execution plan.'),
  resourceType?: string(name='ResourceType', description='The type of resource for the execution target. The value can be the vCPU capacity or the number of executor nodes. Valid values:

- VCpuCapacity: vCPU capacity

- ExecutorCapacity: number of executor nodes', example='VCpuCapacity'),
  resources?: [ 
    {
      cores?: double(name='Cores', description='The number of vCPUs for the runtime environment.', example='2'),
      memory?: double(name='Memory', description='The memory size of the runtime environment. Unit: GiB.', example='4'),
    }
  ](name='Resources', description='A list of resource configurations for the runtime environment of the execution plan. You can specify 1 to 10 resource configurations.', example='1000'),
  script?: string(name='Script', description='The script to run the job. The script must be Base64-encoded.', example='bHMgLWFsCmxzIC1hbGggfCB3YyAtbA=='),
