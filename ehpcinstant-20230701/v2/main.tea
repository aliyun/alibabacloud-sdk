  description?: string(name='Description', description='The description of the image.', example='Test image'),
  imageType?: string(name='ImageType', description='The type of the images. Valid values:

*   VM: virtual machine image.
*   Container: the container image.', example='VM'),
  imageVersion?: string(name='ImageVersion', description='The version of the image.', example='V1.0'),
  name?: string(name='Name', description='The name of the custom image.

This parameter is required.', example='app-image'),
  VMImageSpec?: {
    imageId?: string(name='ImageId', description='The image ID.', example='m-bp1akkkr1rkxtb******'),
  }(name='VMImageSpec', description='The image configuration of the virtual machine.'),
}

