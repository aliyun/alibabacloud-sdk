    query['AppId'] = request.appId;
  }
  if (!$isNull(request.desiredCapacity)) {
    query['DesiredCapacity'] = request.desiredCapacity;
  }
  if (!$isNull(request.intervalMinutes)) {
    query['IntervalMinutes'] = request.intervalMinutes;
  }
  if (!$isNull(request.level)) {
    query['Level'] = request.level;
  }
  if (!$isNull(request.prologScript)) {
    query['PrologScript'] = request.prologScript;
  }
  if (!$isNull(request.regionsShrink)) {
    query['Regions'] = request.regionsShrink;
  }
  if (!$isNull(request.resourceType)) {
    query['ResourceType'] = request.resourceType;
  }
  if (!$isNull(request.resourcesShrink)) {
    query['Resources'] = request.resourcesShrink;
  }
