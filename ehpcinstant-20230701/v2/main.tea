      server?: string(name='Server', description='The registered address of the image repository.', example='registry-vpc.cn-hangzhou.aliyuncs.com'),
      userName?: string(name='UserName', description='The username of the logon user.', example='username'),
    }(name='RegistryCredential', description='The authentication of the private image repository.'),
