model AddTagsRequest {
  groupIds?: [ string ](name='GroupIds', description='The IDs of the application groups.

The value of N can be from 1 to 20.

For information about how to obtain application group IDs, see [DescribeMonitorGroups](https://help.aliyun.com/document_detail/2513168.html).

This parameter is required.', example='7301****'),
  regionId?: string(name='RegionId'),
  tag?: [ 
    {
      key?: string(name='Key', description='The tag key.

The value of N can be from 1 to 3. The tag key must be 1 to 64 characters in length.

Enter a new tag key or use an existing tag key from Cloud Monitor. For information about how to obtain tag keys, see [DescribeTagKeyList](https://help.aliyun.com/document_detail/2513189.html).

> The tag key cannot start with `aliyun` or `acs:`. The `Tag.N.Key` and `Tag.N.Value` parameters must be specified together.

This parameter is required.', example='key1'),
      value?: string(name='Value', description='The tag value.

The value of N can be from 1 to 3. The tag value must be 1 to 64 characters in length.

Enter a new tag value or use an existing tag value from Cloud Monitor. For information about how to obtain tag values, see [DescribeTagValueList](https://help.aliyun.com/document_detail/2513188.html).

> The tag value cannot start with `aliyun` or `acs:`. The `Tag.N.Key` and `Tag.N.Value` parameters must be specified together.

This parameter is required.', example='value1'),
    }
  ](name='Tag', description='A list of tags.

This parameter is required.'),
}

model AddTagsResponseBody = {
  code?: string(name='Code', description='The status code.

> A status code of 200 indicates that the request was successful.', example='200'),
  message?: string(name='Message', description='The error message.', example='The specified resource is not found.'),
  requestId?: string(name='RequestId', description='The request ID.', example='DAE4B115-3847-5438-8709-423627F0A3A3'),
  success?: boolean(name='Success', description='Indicates whether the operation was successful. Valid values:

- true: The operation was successful.

- false: The operation failed.', example='true'),
}

model AddTagsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddTagsResponseBody(name='body'),
}

/**
 * @summary The AddTags operation attaches tags to specified application groups.
 *
 * @description This topic provides an example of how to attach a tag to the application group `7301****`. In this example, the tag key is `key1` and the tag value is `value1`.
 *
 * @param request AddTagsRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AddTagsResponse
 */
@context("addTagsWithContext")
async function addTagsWithOptions(request: AddTagsRequest, runtime: $RuntimeOptions): AddTagsResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.groupIds)) {
    query['GroupIds'] = request.groupIds;
  }
  if (!$isNull(request.tag)) {
    query['Tag'] = request.tag;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApiUtil.Params{
    action = 'AddTags',
    version = '2019-01-01',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary The AddTags operation attaches tags to specified application groups.
 *
 * @description This topic provides an example of how to attach a tag to the application group `7301****`. In this example, the tag key is `key1` and the tag value is `value1`.
 *
 * @param request AddTagsRequest
 * @return AddTagsResponse
 */
async function addTags(request: AddTagsRequest): AddTagsResponse {
  var runtime = new $RuntimeOptions{};
  return addTagsWithOptions(request, runtime);
}

model ApplyMetricRuleTemplateRequest {
  appendMode?: string(name='AppendMode', description='The application policy of the template. Valid values:

- all: deletes all rules created by using alert templates on the selected group and then creates new alert rules based on the template. This is the default value.

- append: deletes the rules created by using the current alert template on the selected group and then creates new alert rules based on the current template.', example='all'),
  applyMode?: string(name='ApplyMode', description='The application mode of the template. Valid values:

- GROUP_INSTANCE_FIRST: application group instances take precedence. When the alert template is applied, the instances in the application group take precedence. If an instance specified in the template does not exist in the application group, the rule for the instance in the template is ignored.

- ALARM_TEMPLATE_FIRST: alert template instances take precedence. When the alert template is applied, alert rules are created regardless of whether the instances exist in the application group.', example='GROUP_INSTANCE_FIRST'),
  dryRun?: boolean(name='DryRun', description='Specifies whether to perform a dry run on the request. Valid values:
- **true**: performs a dry run and does not bind a security group to the instance. The system checks whether required parameters are specified, the request format is valid, and service limits are met. If the request fails the dry run, an error is returned. If the request passes the dry run, the `DryRunOperation` error code is returned.
- **false**: performs a normal request. If the request passes the dry run, an HTTP 2xx status code is returned and the operation is performed. This is the default value.', example='false'),
  enableEndTime?: long(name='EnableEndTime', description='The end time of the effective period for the alert, in hours. The value is a two-digit string, such as "00", "18", or "23". Valid values: 00 to 23. The value specifies the hour of the end time, and the actual effective period ends at the 59th minute of the hour. For example, "23" indicates that the effective period ends at 23:59. The default time zone is UTC+8.', example='23'),
  enableStartTime?: long(name='EnableStartTime', description='The start time of the effective period for the alert, in hours. The value is a two-digit string, such as "00", "09", or "23". Valid values: 00 to 23, which represent 00:00 to 23:00. The default time zone is UTC+8.', example='00'),
  groupId?: long(name='GroupId', description='The ID of the application group.

For more information about how to obtain the ID of an application group, see [DescribeMonitorGroups](https://help.aliyun.com/document_detail/115032.html).

This parameter is required.', example='123456'),
  notifyLevel?: long(name='NotifyLevel', description='The alert notification method. Valid values:

<props="china">- 2: phone call, text message, mailbox, TradeManager, and DingTalk chatbot.

<props="china">- 3: text message, mailbox, TradeManager, and DingTalk chatbot.

<props="china">- 4: TradeManager and DingTalk chatbot.


<props="intl">4: TradeManager and DingTalk chatbot.

<props="partner">4: TradeManager and DingTalk chatbot.', example='4'),
  silenceTime?: long(name='SilenceTime', description='The mute for. Unit: seconds. Default value: 86400.

> If the monitoring data continuously exceeds the threshold of the alert rule, the system sends only one alert notification within each epoch.', example='86400'),
  templateIds?: string(name='TemplateIds', description='The ID of the alert template.

For more information about how to obtain the ID of an alert template, see [DescribeMetricRuleTemplateList](https://help.aliyun.com/document_detail/114982.html).

This parameter is required.', example='700****'),
  webhook?: string(name='Webhook', description='The webhook URL to which a POST request is sent when an alert is triggered.', example='https://www.aliyun.com'),
}

