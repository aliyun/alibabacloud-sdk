This parameter is required.', example='acs:ram::13234:role/logsource'),
  cmkKeyId: string(name='cmk_key_id', description='The ID of the customer master key (CMK) if you use the bring-your-own-key (BYOK) key.

This parameter is required.', example='f5136b95-2420-ab31-xxxxxxxxx'),
  regionId: string(name='region_id', description='The ID of the region where the CMK resides.

This parameter is required.', example='cn-hangzhou'),
}

model FieldSpec {
  analysable?: boolean(name='analysable', description='Specifies whether the field can be analyzed, that is, whether it can be used as a dimension column in a GROUP BY clause.', example='true'),
  dataFormat?: string(name='data_format', description='The formatting method for numeric or display values, such as KMB (thousand/million/billion), percent, ms, or dthms (hours:minutes:seconds).', example='KMB'),
  description?: string(name='description', description='The business description of the field.', example='The unique ID of the transaction order'),
  displayName?: string(name='display_name', description='The display name used in the console. The value can contain Chinese characters.', example='OrderNumber'),
  filterable?: boolean(name='filterable', description='Specifies whether the field can be filtered, that is, whether index-based filter queries are supported.', example='true'),
  launchStage?: string(name='launch_stage', description='The launch stage of the field. Valid values: preview, beta, ga, and deprecated.', example='ga'),
  name?: string(name='name', description='The field name. The value must consist of lowercase letters, digits, hyphens (-), underscores (_), and periods (.).', example='order_id'),
  orderable?: boolean(name='orderable', description='Specifies whether the field can be sorted.', example='true'),
  shortDescription?: string(name='short_description', description='The short description (one sentence) used in compact display scenarios such as lists.', example='Order ID'),
  type?: string(name='type', description='The field type. Valid values: string, integer, float, boolean, time, json_object, and json_array.', example='string'),
  unit?: string(name='unit', description='The unit of the field. The unit is used only for display purposes and is not automatically converted. For example, ms is not automatically converted to s.', example='ms'),
  valueMapping?: map[string]string(name='value_mapping', description='The value mapping for enumerated values. The key is the raw value and the value is the mapped semantic name. This is used to display the business meaning of enumerated values. For example, the value 1 of the status field is mapped to running.'),
}

