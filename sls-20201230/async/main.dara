model Metric {
  aggregator?: string(name='aggregator', description='The aggregation method of the metric (such as avg or sum). If the metric is already aggregated by the same dimensions (such as avg(rate(cpu_core_usage_seconds_total{}[1m]))), configuration is not required. Metrics based on log aggregation generally do not require configuration either.', example='avg'),
  dataFormat?: string(name='data_format', description='The numeric or display formatting method, such as KMB (thousand/million/billion), percent, ms, or dthms (hours:minutes:seconds).', example='KMB'),
  description?: string(name='description', description='The business description of the metric.', example='The number of requests processed by the service per second'),
  displayName?: string(name='display_name', description='The display name for UI presentation, which can contain Chinese characters.', example='Request Count'),
  generator?: string(name='generator', description='The generation method of the metric. In PromQL mode, this is a PromQL expression (such as rate(request_count{}[1m]), which can be combined with aggregator to compute sum(...) by (label1, label2)). In SQL/SPL mode, this is an aggregation expression (such as count(1)) that is incorporated into the generated query statement.', example='rate(request_count{}[1m])'),
  goldenMetric?: boolean(name='golden_metric', description='Indicates whether the metric is a golden metric (core metrics such as latency, traffic, error count, and saturation).', example='false'),
  intervalUs?: [ long ](name='interval_us', description='The collection interval of the metric in microseconds. Multiple values indicate that multiple collection interval precisions are supported.'),
  name?: string(name='name', description='The metric name, which is unique within the MetricSet.', example='request_count'),
  queryMode?: string(name='query_mode', description='The expected query mode of the metric: range (range query), instant (instant query), or both.', example='instant'),
  type?: string(name='type', description='The metric type. Metrics that do not require secondary processing are fixed as gauge.', example='gauge'),
  unit?: string(name='unit', description='The metric unit, which is used for display only without automatic conversion. For example, ms is not automatically converted to s.', example='ms'),
}

model MetricSetSpec {
  labels?: {
    dynamic?: boolean(name='dynamic', description='Specifies whether to automatically extract (dynamically generate) labels based on data. Set this parameter to true in most cases.', example='true'),
    keys?: [ string ](name='keys', description='The static label key list. This parameter takes effect when dynamic is set to false.'),
  }(name='labels', description='The label definitions for the metric set. Labels are recommended to be automatically generated using the dynamic method. MetricSet defines only common labels. Defining additional labels under individual Metrics is not recommended.'),
  metrics?: [
    Metric
  ](name='metrics', description='The list of metrics included in the metric set.'),
  needsProcessing?: boolean(name='needs_processing', description='Specifies whether the metric requires secondary processing before use. For example, Prometheus counter/summary/histogram metrics require calculations such as rate before they can be used directly.', example='false'),
  queryType?: string(name='query_type', description='The query syntax for the metrics. Valid values: prom (PromQL), spl, and cms (CloudMonitor).', example='prom'),
}

