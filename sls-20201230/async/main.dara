  sink?: {
    bucket: string(name='bucket', description='The name of the destination OSS bucket.

This parameter is required.', example='test-bucket'),
    bufferInterval?: long(name='bufferInterval', description='The time in seconds to buffer data before exporting. The value must be an integer from 300 to 900.', example='300'),
    bufferSize?: long(name='bufferSize', description='The amount of data in MB to buffer before exporting. The value must be an integer from 5 to 256.', example='256'),
    compressionType?: string(name='compressionType', description='The compression type for the exported files. Valid values: `snappy`, `gzip`, `zstd`, and `none` (no compression).', example='snappy/gizp/zstd/none'),
    contentDetail?: map[string]any(name='contentDetail', description='Format-specific settings. The structure of this JSON object depends on the `contentType` value.'),
    contentType?: string(name='contentType', description='The format of the files stored in OSS. Valid values: `json`, `parquet`, `csv`, and `orc`.', example='json/parquet/csv/orc'),
    delaySec?: long(name='delaySec', description='The delivery delay.

> - This parameter is deprecated.', example='123', deprecated='true'),
    delaySeconds?: long(name='delaySeconds', description='The delivery delay, in seconds. This value cannot exceed the data retention period of the source Logstore.', example='900'),
    endpoint: string(name='endpoint', description='- For Object Storage Service (OSS): The OSS internal endpoint. You must use an endpoint in the same region as the Logstore. For more information, see [OSS access domains and data centers](https://help.aliyun.com/document_detail/31837.html). The endpoint must use the HTTPS protocol.

- For OSS-HDFS: The OSS-HDFS internal endpoint. You must use an endpoint in the same region as the Logstore.

This parameter is required.', example='http://xxxxxxxx'),
    pathFormat: string(name='pathFormat', description='The path format for exported files. For more information, see [Path format](https://help.aliyun.com/document_detail/371934.html).

This parameter is required.', example='%Y_%m_%d/good/bad'),
    pathFormatType: string(name='pathFormatType', description='The type of the path format.

This parameter is required.', example='only support time'),
    prefix?: string(name='prefix', description='The prefix for files exported to the OSS bucket.', example='prefixxxx/'),
    roleArn: string(name='roleArn', description='The ARN of the RAM role that Log Service assumes to write data to the OSS bucket. You must specify the ARN of your role.

This parameter is required.', example='acs:ram::xxxxxxx'),
    suffix?: string(name='suffix', description='The suffix for the exported files.', example='.json'),
    timeZone?: string(name='timeZone', description='The time zone used for the path format. For more information, see [Time zones](https://help.aliyun.com/document_detail/375323.html).', example='+0800'),
  }(name='sink', description='The configuration of the destination OSS sink.'),
  sourceSecureTransport?: boolean(name='sourceSecureTransport'),
  toTime?: long(name='toTime', description='The end time for the export, specified as a Unix timestamp. Set to 0 to run the task continuously until it is stopped.', example='123456789'),
