  displayName: string(name='displayName', description='The display name for the job.

This parameter is required.', example='gcs ingestion'),
  lastModifiedTime?: long(name='lastModifiedTime', description='Output only. The last modified time of the job, as a Unix timestamp.', example='1714360581'),
  name: string(name='name', description='The job name.

