  isAllWeight?: boolean(name='is_all_weight', description='Whether it is total checked baggage weight', example='true'),
  carryOnAmount?: int32(name='carry_on_amount', description='Number of carry-on baggage pieces', example='1'),
  carryOnWeight?: int32(name='carry_on_weight', description='Carry-on baggage weight', example='2'),
  carryOnWeightUnit?: string(name='carry_on_weight_unit', description='Carry-on baggage weight unit KG', example='KG'),
  isAllCarryOnWeight?: boolean(name='is_all_carry_on_weight', description='Whether it is total carry-on baggage weight', example='true'),
  carryLength?: int32(name='carry_length', example='55'),
  carryWidth?: int32(name='carry_width', example='40'),
  carryHeight?: int32(name='carry_height', example='20'),
  carrySumOfLengthWidthHeight?: int32(name='carry_sum_of_length_width_height', example='115'),
  length?: int32(name='length', example='60'),
  width?: int32(name='width', example='40'),
  height?: int32(name='height', example='60'),
  sumOfLengthWidthHeight?: int32(name='sum_of_length_width_height', example='200'),
}

