      }
    ](name='CancellationPolicies'),
    itemOfferId?: string(name='ItemOfferId', example='itemOffer_123'),
    pricing?: {
      currency?: string(name='Currency', example='USD'),
      nightlyPrices?: [ 
        {
          amount?: string(name='Amount', example='5000'),
          date?: string(name='Date', example='2026-07-01'),
          tracerId?: string(name='TracerId', example='traceId'),
        }
      ](name='NightlyPrices'),
      totalAmount?: string(name='TotalAmount', example='10000'),
      tracerId?: string(name='TracerId', example='traceId'),
    }(name='Pricing'),
