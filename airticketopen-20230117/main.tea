  success?: boolean(name='Success', example='true'),
  tracerId?: string(name='TracerId', example='traceId'),
}

model ValidatePriceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ValidatePriceResponseBody(name='body'),
}

/**
 * @summary 验价
 *
 * @param tmpReq ValidatePriceRequest
 * @param headers map
 * @param runtime runtime options for this request RuntimeOptions
 * @return ValidatePriceResponse
 */
async function validatePriceWithOptions(tmpReq: ValidatePriceRequest, headers: map[string]string, runtime: Util.RuntimeOptions): ValidatePriceResponse {
  Util.validateModel(tmpReq);
  var request = new ValidatePriceShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!Util.isUnset(tmpReq.childrenAges)) {
    request.childrenAgesShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.childrenAges, 'ChildrenAges', 'json');
  }
  var body : map[string]any = {};
  if (!Util.isUnset(request.accountNo)) {
    body['AccountNo'] = request.accountNo;
  }
  if (!Util.isUnset(request.adults)) {
    body['Adults'] = request.adults;
  }
  if (!Util.isUnset(request.children)) {
    body['Children'] = request.children;
  }
  if (!Util.isUnset(request.childrenAgesShrink)) {
    body['ChildrenAges'] = request.childrenAgesShrink;
  }
  if (!Util.isUnset(request.itemOfferKey)) {
    body['ItemOfferKey'] = request.itemOfferKey;
  }
  if (!Util.isUnset(request.roomCount)) {
    body['RoomCount'] = request.roomCount;
  }
  if (!Util.isUnset(request.tracerId)) {
    body['TracerId'] = request.tracerId;
  }

  var req = new OpenApi.OpenApiRequest{ 
    headers = headers,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'validatePrice',
    version = '2023-01-17',
    protocol = 'HTTPS',
    pathname = `/validatePrice`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary 验价
 *
 * @param request ValidatePriceRequest
