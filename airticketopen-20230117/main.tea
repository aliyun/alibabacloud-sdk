  adults?: int32(name='Adults', description='This parameter is required.', example='2'),
  children?: int32(name='Children', example='0'),
  childrenAges?: [ int32 ](name='ChildrenAges', example='0'),
  itemOfferKey?: string(name='ItemOfferKey', description='This parameter is required.', example='itemOfferKey_abc123'),
  roomCount?: int32(name='RoomCount', description='This parameter is required.', example='1'),
  tracerId?: string(name='TracerId', example='traceId'),
}

model ValidatePriceShrinkRequest {
  accountNo?: long(name='AccountNo', description='This parameter is required.', example='123456'),
  adults?: int32(name='Adults', description='This parameter is required.', example='2'),
  children?: int32(name='Children', example='0'),
  childrenAgesShrink?: string(name='ChildrenAges', example='0'),
  itemOfferKey?: string(name='ItemOfferKey', description='This parameter is required.', example='itemOfferKey_abc123'),
  roomCount?: int32(name='RoomCount', description='This parameter is required.', example='1'),
  tracerId?: string(name='TracerId', example='traceId'),
}

model ValidatePriceResponseBody = {
  data?: {
    cancellationPolicies?: [ 
      {
        penalties?: [ 
          {
            currency?: string(name='Currency', example='USD'),
            end?: long(name='End', example='1672617600000'),
            penaltyType?: string(name='PenaltyType', example='PERCENTAGE'),
            penaltyValue?: string(name='PenaltyValue', example='50'),
            start?: long(name='Start', example='1672531200000'),
            tracerId?: string(name='TracerId', example='traceId'),
          }
        ](name='Penalties'),
        policyType?: string(name='PolicyType', example='FREE_CANCELLATION'),
