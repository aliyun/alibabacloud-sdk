            segmentIdList?: [ string ](name='segment_id_list', description='Segment ID list. These segment IDs use the same refund and change rules.'),
          }
        ](name='segment_refund_change_rule_mapping_list', description='Refund and change rules'),
        solutionAttribute?: {
          issueTimeInfo?: {
            issueTicketType?: int32(name='issue_ticket_type', description='Issue ticket type:  1: after payment; 2: before departure; -1: unknown'),
            issueTimeLimit?: int32(name='issue_time_limit', description='Estimated issue ticket time, unit: minutes'),
          }(name='issue_time_info', description='Issue ticket time related'),
          supplySourceType?: string(name='supply_source_type', description='Supply source type 1: Self-operated; 2: Agent; 3: Flagship store', example='1'),
        }(name='solution_attribute', description='Quotation attributes'),
        solutionId?: string(name='solution_id', description='solution_id', example='eJwz8DeySEo0NjQ01TU3TU7TNTFINNO1SE5O0jVKM0hKNjEwTElLNYwz0A32cNT1dfPVNTIwMjYwNjRQ8/A3NLI01Q0Ic0cRBwBVFxJJ'),
      }
    ](name='solution_list', description='search quotation results'),
  }(name='data', description='correctly processed return data'),
  errorCode?: string(name='error_code', description='business error code', example='null'),
  errorData?: any(name='error_data', description='Data carried in error handling', example='null'),
  errorMsg?: string(name='error_msg', description='error message', example='null'),
