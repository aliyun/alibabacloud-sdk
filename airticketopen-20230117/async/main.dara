      ruleEndTime?: int32(name='rule_end_time', description='该退票规则适用于的退票时间区间结束时间，单位（天/小时）', example='12'),
      canRefund?: boolean(name='can_refund', description='起飞前X-Y小时(天) 可否退票', example='true'),
      refundFee?: double(name='refund_fee', description='起飞前X-Y小时(天) 退票手续费', example='200'),
      canReturnAllTax?: boolean(name='can_return_all_tax', description='起飞前X-Y小时(天) 是否全额退税', example='true'),
      returnPartTaxFee?: double(name='return_part_tax_fee', description='起飞前X-Y小时(天) 可部分退税金额', example='100'),
    }
  ](name='refund_rule_part_unused_list', description='部分未使用退票规则'),
  changeRuleInUnusedList?: [ 
    {
      type?: int32(name='type', description='该改签规则适用航程使用类型 2:去程未使用; 3:回程未使用', example='2'),
      timeUnit?: string(name='time_unit', description='时间单位：day/hour', example='hour'),
      ruleStartTime?: int32(name='rule_start_time', description='该退票规则适用于的退票时间区间开始时间，单位（天/小时）', example='36'),
      ruleEndTime?: int32(name='rule_end_time', description='该退票规则适用于的退票时间区间结束时间，单位（天/小时）', example='12'),
      canChange?: boolean(name='can_change', description='起飞前X-Y小时(天) 可否可以改签', example='true'),
      changeFee?: double(name='change_fee', description='起飞前X-Y小时(天) 改签费', example='100'),
    }
  ](name='change_rule_in_unused_list', description='回程未使用改签规则'),
  changeRuleOutUnusedList?: [ 
    {
      type?: int32(name='type', description='该改签规则适用航程使用类型 2:去程未使用; 3:回程未使用', example='2'),
      timeUnit?: string(name='time_unit', description='时间单位：day/hour', example='hour'),
      ruleStartTime?: int32(name='rule_start_time', description='该退票规则适用于的退票时间区间开始时间，单位（天/小时）', example='36'),
      ruleEndTime?: int32(name='rule_end_time', description='该退票规则适用于的退票时间区间结束时间，单位（天/小时）', example='12'),
      canChange?: boolean(name='can_change', description='起飞前X-Y小时(天) 可否可以改签', example='true'),
      changeFee?: double(name='change_fee', description='起飞前X-Y小时(天) 改签费', example='100'),
    }
  ](name='change_rule_out_unused_list', description='去程未使用改签规则'),
}

model DataHotelsValue = {
  checkInDate?: string(name='CheckInDate', description='The check-in date (yyyy-MM-dd).', example='2026-01-01'),
  checkOutDate?: string(name='CheckOutDate', description='The check-out date (yyyy-MM-dd).', example='2026-01-02'),
  rooms?: [ 
    {
      standardRoomId?: string(name='StandardRoomId', description='The standard room type ID.', example='R001'),
      lowestPrice?: {
        amount?: string(name='Amount', description='The amount in the smallest currency unit.', example='287'),
        currency?: string(name='Currency', description='The currency code.', example='USD'),
        tracerId?: string(name='TracerId', description='null', example='null'),
      }(name='LowestPrice', description='The lowest price for the room type on the day.'),
      offers?: [ 
        {
          itemOfferKey?: string(name='ItemOfferKey', description='The item-level offer identifier (price verification key, pass through as-is).', example='itemOffer_123'),
          ratePlanName?: string(name='RatePlanName', description='The rate plan name.', example='Breakfast included'),
          mealType?: string(name='MealType', description='The meal type.', example='BREAKFAST'),
          mealCount?: int32(name='MealCount', description='The number of meals included.', example='2'),
          cancelPolicy?: {
            policyType?: string(name='PolicyType', description='The policy type (NON_REFUNDABLE/FREE_CANCELLATION/PARTIAL_REFUND).', example='FREE_CANCELLATION'),
            penalties?: [ 
              {
                start?: string(name='Start', description='The effective start time (UTC millisecond timestamp).', example='1672531200000'),
                end?: string(name='End', description='The effective end time (UTC millisecond timestamp).', example='1672617600000'),
                penaltyType?: string(name='PenaltyType', description='The penalty type (PERCENTAGE/AMOUNT/NIGHTS).', example='PERCENTAGE'),
                penaltyValue?: string(name='PenaltyValue', description='The penalty value (percentage/amount/number of nights).', example='50'),
                currency?: string(name='Currency', description='The currency code (present only when the type is AMOUNT).', example='USD'),
                tracerId?: string(name='TracerId', description='traceId', example='TraceId'),
              }
            ](name='Penalties', description='The list of penalty details.'),
            tracerId?: string(name='TracerId', description='TraceId', example='TraceId'),
          }(name='CancelPolicy', description='The cancellation policy.'),
          totalPrice?: {
            amount?: string(name='Amount', description='The amount in the smallest currency unit.', example='287'),
            currency?: string(name='Currency', description='The currency code.', example='USD'),
            tracerId?: string(name='TracerId', description='null', example='null'),
          }(name='TotalPrice', description='The total selling price.'),
          dailyPrices?: [ 
            {
              date?: string(name='Date', description='The check-in date (yyyy-MM-dd, time zone: hotel local time zone).', example='2026-08-16'),
              price?: {
                amount?: string(name='Amount', description='The amount in the smallest currency unit.', example='287'),
                currency?: string(name='Currency', description='The currency code.', example='USD'),
                tracerId?: string(name='TracerId', description='null', example='null'),
              }(name='Price', description='The price for the day.'),
              tracerId?: string(name='TracerId', description='null', example='null'),
            }
          ](name='DailyPrices', description='The list of daily prices.'),
          availableRooms?: int32(name='AvailableRooms', description='The number of available rooms.', example='5'),
          maxOccupancy?: int32(name='MaxOccupancy', description='The maximum number of guests allowed.', example='3'),
          confirmType?: string(name='ConfirmType', description='The confirmation type (INSTANT_CONFIRM/NON_INSTANT_CONFIRM).', example='INSTANT_CONFIRM'),
        }
      ](name='Offers', description='The list of all available offers for the room type.'),
    }
  ](name='Rooms', description='The list of available room types for the day.'),
  standardRoomId?: string(name='StandardRoomId', description='The standard room type ID.', example='R001'),
  offers?: [ 
    {
      itemOfferKey?: string(name='ItemOfferKey', description='The item offer key, which is a price verification key. Pass this value through as-is.', example='itemOffer_123'),
      ratePlanName?: string(name='RatePlanName', description='The rate plan name.', example='Breakfast Included'),
      mealType?: string(name='MealType', description='The meal type.', example='BREAKFAST'),
      mealCount?: int32(name='MealCount', description='The number of meals included.', example='2'),
      cancelPolicy?: {
        policyType?: string(name='PolicyType', description='The policy type (NON_REFUNDABLE/FREE_CANCELLATION/PARTIAL_REFUND).', example='FREE_CANCELLATION'),
        penalties?: [ 
          {
            start?: string(name='Start', description='The effective start time, in UTC millisecond timestamp format.', example='1672531200000'),
            end?: string(name='End', description='The effective end time, in UTC millisecond timestamp format.', example='1672617600000'),
            penaltyType?: string(name='PenaltyType', description='The penalty type (PERCENTAGE/AMOUNT/NIGHTS).', example='PERCENTAGE'),
            penaltyValue?: string(name='PenaltyValue', description='The penalty value (percentage, amount, or number of nights).', example='50'),
            currency?: string(name='Currency', description='The currency code. This field has a value only when the penalty type is AMOUNT.', example='USD'),
            tracerId?: string(name='TracerId', description='TraceId', example='TraceId'),
          }
        ](name='Penalties', description='The list of penalty details.'),
        tracerId?: string(name='TracerId', description='TraceId', example='TraceId'),
      }(name='CancelPolicy', description='The cancellation policy.'),
      totalPrice?: {
        amount?: string(name='Amount', description='The amount in the smallest currency unit.', example='287'),
        currency?: string(name='Currency', description='The currency code.', example='USD'),
        tracerId?: string(name='TracerId', description='null', example='null'),
      }(name='TotalPrice', description='The total selling price.'),
      dailyPrices?: [ 
        {
          date?: string(name='Date', description='The check-in date in yyyy-MM-dd format, based on the hotel local time zone.', example='2026-08-16'),
          price?: {
            amount?: string(name='Amount', description='The amount in the smallest currency unit.', example='287'),
            currency?: string(name='Currency', description='The currency code.', example='USD'),
            tracerId?: string(name='TracerId', description='null', example='null'),
          }(name='Price', description='The price for the day.'),
          tracerId?: string(name='TracerId', description='null', example='null'),
        }
      ](name='DailyPrices', description='The list of daily prices.'),
      availableRooms?: int32(name='AvailableRooms', description='The number of available rooms.', example='5'),
      maxOccupancy?: int32(name='MaxOccupancy', description='The maximum number of guests allowed.', example='3'),
      confirmType?: string(name='ConfirmType', description='The confirmation type (INSTANT_CONFIRM/NON_INSTANT_CONFIRM).', example='INSTANT_CONFIRM'),
    }
  ](name='Offers', description='All available offers for the room type.'),
}

