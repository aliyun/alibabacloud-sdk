  cabinClass?: string(name='cabin_class', description='Cabin class ALL_CABIN: all cabin classes; Y: economy; FC: first class and business class; S: premium economy; YS: economy and premium economy; YSC: economy, premium economy, and business class;', example='ALL_CABIN', position='Body'),
  children?: int32(name='children', description='Number of child passengers 0-9', example='1', position='Body'),
  infants?: int32(name='infants', description='Number of infant passengers 0-9', example='1', position='Body'),
  journeyParamList?: [ 
    {
      arrivalCity: string(name='arrival_city', description='Arrival city code (3-letter uppercase)

This parameter is required.', example='MFM'),
      departureCity: string(name='departure_city', description='Departure city code (3-letter uppercase)

This parameter is required.', example='SHA'),
      departureDate: string(name='departure_date', description='Departure date (yyyyMMdd)

This parameter is required.', example='20230310'),
      segmentParamList: [ 
        {
          arrivalAirport?: string(name='arrival_airport', description='Flight arrival airport code (3-letter uppercase)', example='MFM'),
          arrivalCity?: string(name='arrival_city', description='Flight arrival city code (3-letter uppercase)', example='MFM'),
          cabin?: string(name='cabin', description='Booking class', example='V'),
          childCabin?: string(name='child_cabin', description='Child booking class', example='E'),
          departureAirport?: string(name='departure_airport', description='Flight departure airport code (3-letter uppercase)', example='PVG'),
          departureCity?: string(name='departure_city', description='Flight departure city code (3-letter uppercase)', example='SHA'),
          departureDate?: string(name='departure_date', example='2023-03-10'),
          departureTime?: string(name='departure_time', description='String, flight departure date and time (yyyy-MM-dd HH:mm:ss)', example='2023-03-10 07:55:00'),
          marketingFlightNo: string(name='marketing_flight_no', description='Marketing carrier flight number (e.g., KA5809)

This parameter is required.', example='HO1295'),
        }
      ](name='segment_param_list', description='Specified segment information for this journey

This parameter is required.'),
    }
  ](name='journey_param_list', description='Journey information', shrink='json', position='Body'),
  solutionId?: string(name='solution_id', description='solution_id returned by Search', example='eJwz8DeySEo0NjQ01TU3TU7TNTFINNO1SE5O0jVKM0hKNjEwTElLNYwz0A32cNT1dfPVNTIwMjYwNjRQ8/A3NLI01Q0Ic0cRBwBVFxJJ', position='Body'),
  xAcsAirticketAccessToken: string(name='x-acs-airticket-access-token', description='access_token

This parameter is required.', example='eyJhbGciOiJSUzI1NiIsImtpZCI6InN1ZXpfa2V5aWQifQ.eyJqdGkiOiJCQldMaWIzN0VxbC0xMjhhR2N5elJ3IiwiaWF0IjoxNjc3MDY2NTAxLCJleHAiOjE2NzcwNzM3MDEsIm5iZiI6MTY3NzA2NjQ0MX0.AF0DxsZK4Edyg0C6ObRQFUo36R1VYrb5IYmak25TmL1OfR5RkIUc3PpqFuQKNLKXf5fOtVQaKjaexzwodVeWZQDKEG_RPt_Ybb99EnEm6vPKs6e3pWFbKiBq71WleLHhVrdFb4YPowRKjc7bG0jyGUxiQ2iXy0RWDj9tIjfI-KEdzNp5oVnX7j4p3H12DwQrRPmd1nz3BciAQNINvDpzqusuIUw8JXyLFCz838Y0NhwB1_bYZyctxRLSzrGZuI5rrWtItgupqMsOlJ3RNy1QrIbQ2g6nPmzl-atOqcQ4Nw0HeDLR8dhM1OsIcFLbKXBUtwXofflhzAQrkDxhwYiXii', position='Header'),
  xAcsAirticketLanguage?: string(name='x-acs-airticket-language', description='Multilingual, defaults to buyer account configuration', example='en_US', position='Header'),
}

model EnrichResponseBody = {
  requestId?: string(name='RequestId', description='Request RequestId', example='51593418-8C73-5E47-8BA8-3F1D4A00CC0B'),
  data?: {
    solutionList?: [ 
      {
        adultPrice?: double(name='adult_price', description='Adult unit price', example='500'),
        adultTax?: double(name='adult_tax', description='Adult tax', example='100'),
        childPrice?: double(name='child_price', description='Child unit price', example='100'),
        childTax?: double(name='child_tax', description='Child tax', example='100'),
        infantPrice?: double(name='infant_price', description='Infant unit price', example='500'),
        infantTax?: double(name='infant_tax', description='Infant tax', example='100'),
        journeyList?: [ 
          {
            segmentList?: [ 
              {
                arrivalAirport?: string(name='arrival_airport', description='Flight arrival airport code (3-letter uppercase)', example='MFM'),
                arrivalCity?: string(name='arrival_city', description='Flight arrival city code (3-letter uppercase)', example='MFM'),
                arrivalTerminal?: string(name='arrival_terminal', description='Flight arrival terminal', example='null'),
                arrivalTime?: string(name='arrival_time', description='Flight arrival date and time, string format (yyyy-MM-dd HH:mm:ss)', example='2023-03-10 10:40:00'),
                availability?: string(name='availability', description='Remaining seats. Value range: 1,2,3,4,5,6,7,8,9,A; A indicates more than 9 remaining seats.', example='7'),
                cabin?: string(name='cabin', description='Booking class', example='V'),
                cabinClass?: string(name='cabin_class', description='Cabin class', example='Y'),
                codeShare?: boolean(name='code_share', description='Whether it is a codeshare flight', example='false'),
                departureAirport?: string(name='departure_airport', description='Flight departure airport code (3-letter uppercase)', example='PVG'),
                departureCity?: string(name='departure_city', description='Flight departure city code (3-letter uppercase)', example='SHA'),
                departureTerminal?: string(name='departure_terminal', description='Flight departure terminal', example='T2'),
                departureTime?: string(name='departure_time', description='Flight departure date and time, string format (yyyy-MM-dd HH:mm:ss)', example='2023-03-10 07:55:00'),
                equipType?: string(name='equip_type', description='Aircraft type', example='32Q'),
                fareBasis?: string(name='fare_basis'),
                flightDuration?: int32(name='flight_duration', description='Flight duration, unit: minutes', example='165'),
                marketingAirline?: string(name='marketing_airline', description='Marketing carrier airline (e.g., KA)', example='HO'),
                marketingFlightNo?: string(name='marketing_flight_no', description='Marketing carrier flight number (e.g., KA5809)', example='HO1295'),
                marketingFlightNoInt?: int32(name='marketing_flight_no_int', description='Marketing carrier numeric flight number (e.g., 5809)', example='1295'),
                operatingAirline?: string(name='operating_airline', description='Operating carrier airline (e.g., CX)', example='HO'),
                operatingFlightNo?: string(name='operating_flight_no', description='Operating carrier flight number (e.g., CX601)', example='HO1295'),
                segmentId?: string(name='segment_id', description='Segment ID format: flight number + departure airport + arrival airport + departure date (MMdd)', example='HO1295-PVG-MFM-20230310'),
                stopCityList?: string(name='stop_city_list', description='Stopover city list, has value when stopQuantity > 0, multiple values separated by commas', example='""'),
                stopQuantity?: int32(name='stop_quantity', description='Number of stopover cities', example='0'),
              }
            ](name='segment_list', description='Segment information'),
            transferCount?: int32(name='transfer_count', description='Number of transfers', example='0'),
          }
        ](name='journey_list', description='Journey'),
        segmentBaggageCheckInInfoList?: [ 
          {
            luggageDirectInfoType?: int32(name='luggage_direct_info_type', description='Baggage through-check rule type 1: baggage through-checked between segments; 2: baggage re-checked between segments; 3: baggage through-checked at stopover city; 4: baggage re-checked at stopover city', example='1'),
            segmentIdList?: [ string ](name='segment_id_list', description='Segment ID list. These segment IDs share the same baggage through-check rules'),
          }
        ](name='segment_baggage_check_in_info_list', description='Baggage through-check rules'),
        segmentBaggageMappingList?: [ 
          {
            passengerBaggageAllowanceMapping?: map[string]DataSolutionListSegmentBaggageMappingListPassengerBaggageAllowanceMappingValue(name='passenger_baggage_allowance_mapping', description='Passenger type to free baggage allowance mapping'),
            segmentIdList?: [ string ](name='segment_id_list', description='Segment ID list. These segment IDs share the same free baggage allowance rules'),
          }
        ](name='segment_baggage_mapping_list', description='Free baggage allowance rules'),
        segmentRefundChangeRuleMappingList?: [ 
          {
            refundChangeRuleMap?: map[string]DataSolutionListSegmentRefundChangeRuleMappingListRefundChangeRuleMapValue(name='refund_change_rule_map', description='Passenger type to refund and change rules mapping'),
            segmentIdList?: [ string ](name='segment_id_list', description='Segment ID list. These segment IDs share the same refund and change rules'),
          }
        ](name='segment_refund_change_rule_mapping_list', description='Refund and change rules'),
        solutionAttribute?: {
          issueTimeInfo?: {
            issueTicketType?: int32(name='issue_ticket_type'),
            issueTimeLimit?: int32(name='issue_time_limit'),
          }(name='issue_time_info'),
          supplySourceType?: string(name='supply_source_type', description='Supply source type 1: self-operated; 2: agent; 3: flagship store', example='1'),
        }(name='solution_attribute', description='Quote attributes'),
        solutionId?: string(name='solution_id', description='solution_id', example='eJwz8DeySEo0NjQ01TU3TU7TNTFINNO1SE5O0jVKM0hKNjEwTElLNYwz0A32cNT1dfPVNTIwMjYwNjRQ8/A3NLI01Q0Ic0cRBwBVFxJJ'),
      }
    ](name='solution_list', description='Search and inquiry results'),
  }(name='data', description='Data returned on successful processing'),
  errorCode?: string(name='error_code', description='Business error code', example='null'),
  errorData?: any(name='error_data', description='Data carried on error processing', example='null'),
  errorMsg?: string(name='error_msg', description='Error message', example='null'),
  status?: int32(name='status', description='When HTTP request succeeds, status value is always 200', example='200'),
  success?: boolean(name='success', description='Whether successful', example='true'),
}

model EnrichResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: EnrichResponseBody(name='body'),
}

/**
  * @description In the input parameters, choose either solution_id or journey_param_list. solution_id must be obtained from the Search API.
  * @param request  the request parameters of Enrich  EnrichRequest
  * @return EnrichResponse
 */
async function enrich(request: EnrichRequest): EnrichResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'Enrich', 'POST', '/airticket/v1/trade/action-enrich', 'json', true, 'form', request);
}

