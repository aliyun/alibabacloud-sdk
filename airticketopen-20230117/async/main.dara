                availability?: string(name='availability', description='Number of remaining seats. The value range is 1,2,3,4,5,6,7,8,9,A; A indicates more than 9 seats available.', example='7'),
                cabin?: string(name='cabin', description='Cabin class', example='V'),
                cabinClass?: string(name='cabin_class', description='Cabin grade', example='Y'),
                codeShare?: boolean(name='code_share', description='Whether it is a code-share flight', example='false'),
                departureAirport?: string(name='departure_airport', description='Three-letter code of the departure airport (uppercase)', example='PVG'),
                departureCity?: string(name='departure_city', description='Three-letter code of the departure city (uppercase)', example='SHA'),
                departureTerminal?: string(name='departure_terminal', description='Departure terminal of the flight', example='T2'),
                departureTime?: string(name='departure_time', description='Departure date and time in string format (yyyy-MM-dd HH:mm:ss)', example='2023-03-10 07:55:00'),
                equipType?: string(name='equip_type', description='Aircraft type', example='32Q'),
                flightDuration?: int32(name='flight_duration', description='Flight duration in minutes', example='165'),
                marketingAirline?: string(name='marketing_airline', description='Marketing airline (e.g., KA)', example='HO'),
                marketingFlightNo?: string(name='marketing_flight_no', description='Marketing flight number (e.g., KA5809)', example='HO1295'),
                marketingFlightNoInt?: int32(name='marketing_flight_no_int', description='Marketing flight number in digits (e.g., 5809)', example='1295'),
                operatingAirline?: string(name='operating_airline', description='Operating airline (e.g., CX)', example='HO'),
                operatingFlightNo?: string(name='operating_flight_no', description='Operating flight number (e.g., CX601)', example='HO1295'),
                segmentId?: string(name='segment_id', description='segment ID format: flight number + departure airport + arrival airport + departure date (MMdd)', example='HO1295-PVG-MFM-20230310'),
                stopCityList?: string(name='stop_city_list', description='List of stopover cities, with values when stopQuantity > 0, separated by commas', example='""'),
                stopQuantity?: int32(name='stop_quantity', description='Number of stopover cities', example='0'),
              }
            ](name='segment_list', description='segment information'),
            transferCount?: int32(name='transfer_count', description='number of transfers', example='0'),
          }
        ](name='journey_list', description='journey'),
        segmentBaggageCheckInInfoList?: [ 
          {
            luggageDirectInfoType?: int32(name='luggage_direct_info_type', description='Baggage check-in rule type 1: Direct baggage between segments; 2: Re-check baggage between segments; 3: Direct baggage at stopover cities; 4: Re-check baggage at stopover cities', example='1'),
            segmentIdList?: [ string ](name='segment_id_list', description='List of segment IDs that use the same baggage check-in rule'),
          }
        ](name='segment_baggage_check_in_info_list', description='Baggage check-in rules'),
