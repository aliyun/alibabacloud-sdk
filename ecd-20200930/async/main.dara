    memory?: long(name='Memory', description='The memory size. Unit: MiB.', example='4096'),
    minDesktopsCount?: int32(name='MinDesktopsCount', description='- For pay-as-you-go shared cloud computers, this parameter indicates the minimum number of cloud computers to create.
- For subscription shared cloud computers, this parameter is equivalent to BuyDesktopsCount, indicating the number of cloud computers initially purchased.', example='1'),
