init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'ecd';
  @version = '2020-09-30';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CdsFileShareLinkModel {
  accessCount?: long(name='AccessCount', description='The number of times to access the shared file.', example='10000'),
  createTime?: string(name='CreateTime', description='The creation time.', example='2021-09-04T03:30:36Z'),
  creator?: string(name='Creator', description='The user that creates the file sharing task.', example='user01'),
  description?: string(name='Description', description='The description.', example='newDescription'),
  disableDownload?: boolean(name='DisableDownload', description='The shared file is forbidden from being downloaded.', example='false'),
  disablePreview?: boolean(name='DisablePreview', description='The shared file is forbidden from being previewed.', example='false'),
  disableSave?: boolean(name='DisableSave', description='The shared file is forbidden from being dumped.', example='false'),
  downloadCount?: long(name='DownloadCount', description='The number of times that the shared file can be downloaded.', example='100'),
  downloadLimit?: long(name='DownloadLimit', description='The maximum number of times that the shared file can be downloaded.', example='100'),
  driveId?: string(name='DriveId', description='The team space ID.', example='dri-g0877jp3hu1ox****'),
  expiration?: string(name='Expiration', description='The time when the file sharing link expires.

>  The value must be in the FC3339 format. Example: 2020-06-28T11:33:00.000+08:00. If the parameter is left empty, the file sharing link is permanently valid.', example='2020-06-28T11:33:00.000+08:00'),
  expired?: boolean(name='Expired', description='Specifies whether the file sharing link expires.', example='False'),
  fileIds?: string(name='FileIds', description='The file sharing task IDs.', example='[\\\\"63886f1fe2014d9a5a3348768dcc27dfc57ee103\\\\"]'),
  modifiyTime?: string(name='ModifiyTime', description='The modification time.', example='2021-09-04T04:30:36Z'),
  previewCount?: long(name='PreviewCount', description='The number of times that the shared file is previewed.', example='0'),
  previewLimit?: long(name='PreviewLimit', description='The maximum number of times that the shared file can be previewed.', example='100'),
  reportCount?: long(name='ReportCount', description='The number of times that the shared file is reported due to content violation.', example='0'),
  saveCount?: long(name='SaveCount', description='The number of times that the shared files can be dumped.', example='100'),
  saveLimit?: long(name='SaveLimit', description='The maximum number of times that the shared file can be saved.', example='100'),
  shareId?: string(name='ShareId', description='The file sharing task ID.', example='7JQX1Fs****'),
  shareLink?: string(name='ShareLink', description='The file sharing link.', example='https://stg109960.apps.aliyunpds.com/disk/s/7uLJanz****'),
  shareName?: string(name='ShareName', description='The shared file name. By default, the name of the first shared file is used.', example='view.txt'),
  sharePwd?: string(name='SharePwd', description='The access code. It must contain up to 64 characters in length. 0 characters indicates that there is no access code.', example='12345678'),
  status?: string(name='Status', description='The status of the file sharing link.

Valid values:

*   forbidden_disabled

    <!-- -->

    : The file sharing link is canceled

    <!-- -->

    after it

    <!-- -->

    is not allowed.

*   forbidden

    <!-- -->

    :

    <!-- -->

    The file sharing link is not allowed

    <!-- -->

    .

*   disabled

    <!-- -->

    :

    <!-- -->

    The file sharing link is canceled.

    <!-- -->

*   enabled

    <!-- -->

    :

    <!-- -->

    The file sharing link is valid.

    <!-- -->', example='disabled'),
  videoPreviewCount?: long(name='VideoPreviewCount', description='The number of times that the audio and video file is played.', example='0'),
}

model FilePermissionMember {
  cdsIdentity: {
    id: string(name='Id', description='The user ID or a team ID.

This parameter is required.', example='16435bdf934248b788b7b3771ee9****'),
    type: string(name='Type', description='The object type.

Valid values:

*   IT_Group: team
*   IT_User: user

This parameter is required.', example='IT_User'),
  }(name='CdsIdentity', description='The object that you want to grant permissions. The object can be a user or a group.

This parameter is required.'),
  disinheritSubGroup?: boolean(name='DisinheritSubGroup', description='Indicates whether to disable the permission from users in the subgroup.', example='true'),
  expireTime?: long(name='ExpireTime', description='The expiration time. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since the epoch time January 1, 1970, 00:00:00 UTC', example='1633598866642'),
  roleId: string(name='RoleId', description='The role.

Valid values:

*   SystemFileEditorWithoutShareLink: The role that can edit but cannot share files.
*   SystemFileUploaderAndDownloaderWithShareLink: The role that can upload, download, and share files.
*   SystemFileDownloader: The role that can download files.
*   SystemFileEditorWithoutDelete: The role that can edit but cannot edit files.
*   SystemFileOwner: The role that can collaborate with others on files.
*   SystemFileDownloaderWithShareLink: The role that can download and share files.
*   SystemFileUploaderAndViewer: The role that can preview and upload files.
*   SystemFileViewer: The role that can preview files.
*   SystemFileEditor: The role that can edit files.
*   SystemFileUploaderWithShareLink: The role that can upload and share files.
*   SystemFileUploader: The role that can upload files.
*   SystemFileUploaderAndDownloader: The role that can upload and download files.
*   SystemFileMetaViewer: The role that can view file list.

This parameter is required.', example='SystemFileEditor'),
}

