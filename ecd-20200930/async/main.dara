      resourceInstanceType?: string(name='ResourceInstanceType', description='The cloud computer specification ID.', example='eds.enterprise_office.8c16g'),
      snapshotPolicyId?: string(name='SnapshotPolicyId', description='The ID of the automatic snapshot policy.', example='sp-35fvn8m2*****'),
      subnetId?: string(name='SubnetId', description='The subnet ID.', example='vsw-adjrehad1****'),
      volumeEncryptionEnable?: boolean(name='VolumeEncryptionEnable', description='Specifies whether to enable disk encryption.', example='false'),
      volumeEncryptionKey?: string(name='VolumeEncryptionKey', description='The ID of the KMS key used when disk encryption is enabled.', example='a7b3c0c8-b3a2-4876-b1cc-116dddc9****'),
    }
  ](name='RegionConfigList', description='The region-specific template configurations. You can specify multiple configurations. The configuration that matches the specific region is used.

> You can specify configurations for up to 20 regions.', position='Body'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-a5fqjjqaejt***', position='Body'),
  resourceTagList?: [ 
    {
      key?: string(name='Key', description='The tag key.', example='department'),
      value?: string(name='Value', description='The tag value.', example='design'),
    }
  ](name='ResourceTagList', description='The tags of the cloud computer in key-value format. You can specify up to 20 tags.', position='Body'),
  siteConfigList?: [ 
    {
      appRuleId?: string(name='AppRuleId', description='The application control policy ID.', example='bwr-5a5371e0*******'),
      siteId?: string(name='SiteId', description='The site name.', example='mainland'),
    }
  ](name='SiteConfigList', description='The site configuration management.', position='Body'),
  systemDiskPerformanceLevel?: string(name='SystemDiskPerformanceLevel', description='The type of the system cloud disk.

> Only high frequency and graphics cloud computer specifications support ESSD cloud disks.', example='AutoPL', position='Body'),
  systemDiskSize?: int32(name='SystemDiskSize', description='The size of the system cloud disk. Unit: GiB. Valid values: 40 to 500. The value must be a multiple of 10.

> The system cloud disk size cannot be smaller than the size of the configured image.', example='80', minimum=40, maximum=2040, position='Body'),
  templateId: string(name='TemplateId', description='The template ID.

This parameter is required.', example='b-0caoeogs88y*****', position='Body'),
  templateName?: string(name='TemplateName', description='The name of the template. The name must meet the following requirements:

- The name must be 2 to 126 characters in length.
- The name must start with a letter or a Chinese character. It cannot start with `http://` or `https://`.
- The name can contain letters, digits, Chinese characters, colons (:), underscores (_), or hyphens (-). Periods (.) are not supported.', example='MyCloudComputerTemplate001', minLength=2, maxLength=126, position='Body'),
  timerGroupId?: string(name='TimerGroupId', description='The configuration group ID.', example='bcc-dweha*****', position='Body'),
  userDuration?: int32(name='UserDuration', description='The per-user usage duration plan.', example='120', position='Body'),
