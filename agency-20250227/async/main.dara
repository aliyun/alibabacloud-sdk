model CustomerNoteCreateRequest {
  contactInformation?: string(name='ContactInformation', description='The contact information.', example='13833333333', position='Body'),
  contactName?: string(name='ContactName', description='The contact name.', example='Zhang San', position='Body'),
  customerName?: string(name='CustomerName', description='The customer name.', example='XXXX Co., Ltd', position='Body'),
  customerUid?: string(name='CustomerUid', description='The customer UID.', example='1647796581073291', position='Body'),
  noteContent?: string(name='NoteContent', description='The note content.', example='Routine customer visit to discuss the agent implementation plan for the customer', position='Body'),
  touchDate?: long(name='TouchDate', description='The contact time (timestamp, in milliseconds).', example='1784266662000', position='Body'),
}

model CustomerNoteCreateResponseBody = {
  accessDeniedDetail?: string(name='AccessDeniedDetail', description='The access denied details returned by the POP API when RAM permissions are missing.', example='{}'),
  code?: string(name='Code', description='The status code.', example='200'),
  data?: long(name='Data', description='The returned data.', example='true'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code returned by the POP API.', example='200'),
  message?: string(name='Message', description='The message returned for the request.', example='Success'),
  msg?: string(name='Msg', description='Same as Message.', example='Success'),
  requestId?: string(name='RequestId', description='The request ID.', example='A9B725C7-3DBD-576B-AC91-F6F22AB99A77'),
}

model CustomerNoteCreateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CustomerNoteCreateResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CustomerNoteCreate  CustomerNoteCreateRequest
  * @return CustomerNoteCreateResponse
 */
async function customerNoteCreate(request: CustomerNoteCreateRequest): CustomerNoteCreateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CustomerNoteCreate', 'POST', '/', 'json', true, 'form', request);
}

