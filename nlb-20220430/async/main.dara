model CreateListenerRequest {
  alpnEnabled?: boolean(name='AlpnEnabled', description='Specifies whether to enable ALPN. Valid values:

- **true**: enables ALPN.

- **false** (default): disables ALPN.', example='false', position='Body'),
  alpnPolicy?: string(name='AlpnPolicy', description='The ALPN policy. Valid values:

- **HTTP1Only**: negotiates only HTTP/1.x. The priority is HTTP/1.1 > HTTP/1.0.
- **HTTP2Only**: negotiates only HTTP/2.
- **HTTP2Optional**: prefers HTTP/1.x but also accepts HTTP/2. The priority is HTTP/1.1 > HTTP/1.0 > HTTP/2.
- **HTTP2Preferred**: prefers HTTP/2 but also accepts HTTP/1.x. The priority is HTTP/2 > HTTP/1.1 > HTTP/1.0.

> You must configure this parameter after **AlpnEnabled** is enabled.', example='HTTP1Only', position='Body'),
  caCertificateIds?: [ string ](name='CaCertificateIds', description='The CA certificate list. This parameter takes effect only for TCPSSL listeners.

> Currently, you can add only one CA certificate.', position='Body'),
  caEnabled?: boolean(name='CaEnabled', description='Specifies whether to enable mutual authentication. Valid values:

- **true**: enables mutual authentication.

- **false** (default): disables mutual authentication.', example='false', position='Body'),
  certificateIds?: [ string ](name='CertificateIds', description='The server certificate list. This parameter takes effect only for TCPSSL listeners.

> Currently, you can add only one server certificate.', position='Body'),
  clientToken?: string(name='ClientToken', description='The client token that is used to ensure the idempotence of the request.

You can generate a parameter value on your client to ensure that the value is unique across different requests. The client token can contain only ASCII characters.

> If you do not specify this parameter, the system automatically uses the **RequestId** of the API request as the **ClientToken**. The **RequestId** of each API request is unique.', example='123e4567-e89b-12d3-a456-426655440000', position='Body'),
  cps?: int32(name='Cps', description='The limit on the number of new connections processed per second by the listener in each zone (VIP). Valid values: **0** to **1000000**. **0** indicates that no limit is applied.', example='100', position='Body'),
  dryRun?: boolean(name='DryRun', description='Specifies whether to only precheck the request. Valid values:
- **true**: sends a precheck request without creating the listener. The system checks whether required parameters are specified, the request format, and service limits. If the request fails the precheck, the corresponding error is returned. If the request passes the precheck, the DryRunOperation error code is returned.
- **false** (default): sends a regular request. If the request passes the precheck, an HTTP 2xx status code is returned and the operation is performed.', example='false', position='Body'),
  endPort?: int32(name='EndPort', description='The end port for all-port listening. Valid values: **1** to **65535**.
The end port must be greater than the start port.

> You must configure this parameter when **ListenerPort** is set to **0**.', example='566', position='Body'),
  idleTimeout?: int32(name='IdleTimeout', description='The idle timeout period for connections. Unit: seconds.

- If **ListenerProtocol** is set to **TCP** or **TCPSSL**, the valid values are **10** to **900**. Default value: **900**.

- If **ListenerProtocol** is set to **UDP**, the valid values are **10** to **90**. Default value: **90**.', example='900', minimum=10, position='Body'),
  listenerDescription?: string(name='ListenerDescription', description='The custom listener name.

The name must be 2 to 256 characters in length, and can contain Chinese characters, English letters, digits, commas (,), periods (.), semicolons (;), forward slashes (/), at signs (@), underscores (_), and hyphens (-).', example='tcp_80', position='Body'),
  listenerPort: int32(name='ListenerPort', description='The listener port. Valid values: **0** to **65535**.

**0**: indicates that the all-port feature is used. If you set this parameter to **0**, you must configure **StartPort** and **EndPort**.

This parameter is required.', example='80', minimum=0, maximum=65535, position='Body'),
  listenerProtocol: string(name='ListenerProtocol', description='The listener protocol. Valid values: **TCP**, **UDP**, and **TCPSSL**.

This parameter is required.', example='TCP', position='Body'),
  loadBalancerId: string(name='LoadBalancerId', description='The Network Load Balancer (NLB) instance ID.

This parameter is required.', example='nlb-83ckzc8d4xlp8o****', position='Body'),
  mss?: int32(name='Mss', description='The maximum segment size (MSS) of TCP packets. Unit: bytes. Valid values: **0** to **1500**.
**0**: indicates that the MSS value of user TCP packets is not modified.

> This parameter is supported only by TCP and TCPSSL listeners.', example='43', position='Body'),
  proxyProtocolEnabled?: boolean(name='ProxyProtocolEnabled', description='Specifies whether to use the Proxy Protocol to pass the client source IP address to backend servers. Valid values:

- **true**: enables the feature.

- **false** (default): disables the feature.', example='false', position='Body'),
  proxyProtocolV2Config?: {
    ppv2CnIdEnabled?: boolean(name='Ppv2CnIdEnabled', description='Ppv2CnIdEnabled'),
    ppv2PrivateLinkEpIdEnabled?: boolean(name='Ppv2PrivateLinkEpIdEnabled', description='Specifies whether to use the Proxy Protocol to pass the Ppv2PrivateLinkEpId to backend servers. Valid values:

- **true**: enables the feature.

- **false** (default): disables the feature.', example='false'),
    ppv2PrivateLinkEpsIdEnabled?: boolean(name='Ppv2PrivateLinkEpsIdEnabled', description='Specifies whether to use the Proxy Protocol to pass the PrivateLinkEpsId to backend servers. Valid values:

- **true**: enables the feature.

- **false** (default): disables the feature.', example='false'),
    ppv2VpcIdEnabled?: boolean(name='Ppv2VpcIdEnabled', description='Specifies whether to use the Proxy Protocol to pass the VpcId to backend servers. Valid values:

- **true**: enables the feature.

- **false** (default): disables the feature.', example='false'),
  }(name='ProxyProtocolV2Config', description='The configuration for passing the VpcId, PrivateLinkEpId, and PrivateLinkEpsId information to backend servers by using the Proxy Protocol.', shrink='json', position='Body'),
  regionId?: string(name='RegionId', description='The region ID of the Network Load Balancer (NLB) instance. 

You can invoke the [DescribeRegions](https://help.aliyun.com/document_detail/443657.html) operation to query region IDs.', example='cn-hangzhou', position='Body'),
  secSensorEnabled?: boolean(name='SecSensorEnabled', description='Specifies whether to enable second-level monitoring. Valid values:

- **true**: enables second-level monitoring.

- **false** (default): disables second-level monitoring.', example='false', position='Body'),
  securityPolicyId?: string(name='SecurityPolicyId', description='The ID of the security policy. System security policies and custom security policies are supported.

- System policies: **tls_cipher_policy_1_0** (default), **tls_cipher_policy_1_1**, **tls_cipher_policy_1_2**, **tls_cipher_policy_1_2_strict**, and **tls_cipher_policy_1_2_strict_with_1_3**.
- Custom security policies: Enter the ID of a custom security policy.
    - To create a custom policy, refer to [CreateSecurityPolicy](https://help.aliyun.com/document_detail/445901.html).
    - To query security policies, refer to [ListSecurityPolicy](https://help.aliyun.com/document_detail/445900.html).

> This parameter takes effect only for TCPSSL listeners.', example='tls_cipher_policy_1_0', position='Body'),
  serverGroupId?: string(name='ServerGroupId', description='The ID of the server group.
> - If **ListenerProtocol** is set to **TCP**, the listener supports server groups whose backend protocol is **TCP** or **TCP_UDP**, but does not support server groups whose backend protocol is **UDP**.
> - If **ListenerProtocol** is set to **UDP**, the listener supports server groups whose backend protocol is **UDP** or **TCP_UDP**, but does not support server groups whose backend protocol is **TCP**.
> - If **ListenerProtocol** is set to **TCPSSL**, the listener supports server groups whose backend protocol is **TCP** and for which **client address preservation is disabled**. It does not support server groups whose backend protocol is **TCP** and for which **client address preservation is enabled**, or server groups whose backend protocol is **UDP** or **TCP_UDP**.', example='sgp-ppdpc14gdm3x4o****', position='Body'),
  startPort?: int32(name='StartPort', description='The start port for all-port listening. Valid values: **1** to **65535**.

> You must configure this parameter when **ListenerPort** is set to **0**.', example='244', position='Body'),
  tag?: [ 
    {
      key?: string(name='Key', description='The tag key. The key can be up to 64 characters in length, and cannot start with `aliyun` or `acs:`, or contain `http://` or `https://`. Supported characters include letters, digits, underscores (_), periods (.), colons (:), forward slashes (/), equal signs (=), plus signs (+), hyphens (-), and at signs (@).

You can add up to 20 tags in a single call.', example='KeyTest'),
      value?: string(name='Value', description='The tag value. The value can be up to 128 characters in length, and cannot start with `aliyun` or `acs:`, or contain `http://` or `https://`. Supported characters include letters, digits, underscores (_), periods (.), colons (:), forward slashes (/), equal signs (=), plus signs (+), hyphens (-), and at signs (@).

You can add up to 20 tags in a single call.', example='Test'),
    }
  ](name='Tag', description='The list of tags.', position='Body'),
}

