  status?: string(name='Status', description='The task status.', example='FE_RUNNING'),
  warnings?: map[string]any(name='Warnings', description='The warning information for each sub-publish module. The key is the sub-publish module and the value is the warning information.', example='{
	"category_bind_faq": [
		"The following categories have not been published to the production environment: Project Delivery Information Summary"
