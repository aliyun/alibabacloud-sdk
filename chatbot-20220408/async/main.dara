model CreateCategoryRequest {
  regionId?: string(name='RegionId', position='Host'),
  agentKey?: string(name='AgentKey', description='The business space key. If this parameter is not specified, the default business space is accessed. You can obtain the key value from the business management page of the Alibaba Cloud account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Query'),
  bizCode?: string(name='BizCode', description='The business code.', example='bizcode123', position='Body'),
  knowledgeType?: int32(name='KnowledgeType', description='The knowledge type. Valid values:

- 1: FAQ category.
- 3: Document category.

Default value: 1.', example='1', position='Body'),
  name: string(name='Name', description='The category name.

This parameter is required.', example='Test1', position='Body'),
  parentCategoryId?: long(name='ParentCategoryId', description='The parent category ID. Default value: -1, which indicates the root directory.', example='-1', minimum=-9223372036854775808, maximum=9223372036854775807, position='Body'),
}

model CreateCategoryResponseBody = {
  category?: {
    bizCode?: string(name='BizCode', description='The business code.', example='bizcode123'),
    categoryId?: long(name='CategoryId', description='The category ID.', example='30000049006'),
    name?: string(name='Name', description='The category name.', example='Category name'),
