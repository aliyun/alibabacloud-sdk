  createTime?: string(name='CreateTime', description='The UTC time when the task was created.', example='2022-04-12T06:30:17Z'),
  error?: string(name='Error', description='The task failure information.', example='An error occurred while checking whether the module to be published is idle, faq'),
  id?: long(name='Id', description='The publish task ID.', example='8522'),
  modifyTime?: string(name='ModifyTime', description='The UTC time when the task was last modified.', example='2022-04-12T06:30:33Z'),
