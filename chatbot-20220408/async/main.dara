model ChatRequest {
  agentKey?: string(name='AgentKey', description='The business space key. If this parameter is not specified, the default business space is accessed. Obtain the key value from the business management page of the Alibaba Cloud account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Query'),
  instanceId?: string(name='InstanceId', description='The unique chatbot identifier (chatbot ID). Log on to the Chatbot console and navigate to Chatbot Details > Session Interface to view the chatbot instance information and obtain the instance ID.', example='chatbot-cn-mp90s2lrk00050', position='Query'),
  intentName?: string(name='IntentName', description='The intent name in the dialog flow. If this name is specified, the chatbot directly enters this intent for Q&A.', example='CheckWeatherIntent', position='Query'),
  knowledgeId?: string(name='KnowledgeId', description='The ID of a knowledge title in the knowledge base. If this ID is specified, the chatbot directly returns the answer for the specified knowledge title.', example='30002406051', position='Query'),
  perspective?: [ string ](name='Perspective', description='The array of perspective codes, which is used to call answers from different perspectives under the same knowledge title. Example: Perspective=["FZJBY3raWr"]. When using the SDK, use the parameters defined in the SDK.', shrink='json', position='Query'),
  sandBox?: boolean(name='SandBox', description='Specifies whether to use the test or production environment. Default value: false (production environment). Valid values:
- true: Test environment. This is for testing only. Using it in production may cause instability and QPS throttling.
- false: Production environment.', example='true', position='Query'),
  senderId?: string(name='SenderId', description='The visitor ID, which identifies the user in the current session.', example='custumer_123456', position='Query'),
  senderNick?: string(name='SenderNick', description='The nickname of the visitor in the current session.', example='User123456', position='Query'),
  sessionId?: string(name='SessionId', description='The session ID, which identifies a visitor\\\\"s session and maintains context information. For a new visitor, you do not need to pass this field when calling the Chat operation for the first time. The chatbot starts a session and returns the SessionId in the response of the Chat operation. For subsequent conversation turns of the visitor, pass the SessionId of the current session when calling the Chat operation so that the chatbot can continue the conversation based on the SessionId. Maximum length: 64 characters.', example='9c6ebdc6e66f46ecadab3434314f6959', position='Query'),
  utterance?: string(name='Utterance', description='The input from the chatbot visitor.', example='How is the weather today?', position='Query'),
  vendorParam?: string(name='VendorParam', description='A JSON-formatted set of user-defined parameters that can be passed to various dialog engines.', example='{"phone":123456789}', position='Query'),
}

model ChatResponseBody = {
  messageId?: string(name='MessageId', description='The ID of the response message in the current session.', example='A2315C4B-A872-5DEE-9DAD-D73B194A4AEC'),
  messages?: [ 
    {
      answerSource?: string(name='AnswerSource', description='The source of the recommended answer when AnswerType is Recommend.
[_single.resp.200.props.Messages.items.AnswerSource.enum. INTENT_FAQ_CLARIFY]mixed clarification from FAQ and dialog flow', example='KNOWLEDGE'),
      answerType?: string(name='AnswerType', description='The type of this message.', example='Text'),
      knowledge?: {
        answerSource?: string(name='AnswerSource', description='Distinguishes the answer type.
KnowledgeBase: knowledge base.', example='KnowledgeBase'),
        category?: string(name='Category', description='The knowledge category.', example='公积金'),
        content?: string(name='Content', description='The content of the hit question.', example='公积金提取，请在首页搜索公积金提取，提交办事的表单'),
        contentType?: string(name='ContentType', description='The indicator of whether the answer is plain text or rich text.', example='PLAIN_TEXT'),
        hitStatement?: string(name='HitStatement', description='The hit statement.', example='公积金'),
        id?: string(name='Id', description='The ID of the hit question in the knowledge base.', example='735898'),
        relatedKnowledges?: [ 
          {
            knowledgeId?: string(name='KnowledgeId', description='The ID of the related knowledge entry.', example='735899'),
            title?: string(name='Title', description='The title of the related knowledge entry.', example='公积金查询'),
          }
        ](name='RelatedKnowledges', description='The list of related knowledge entries.'),
        score?: double(name='Score', description='The score.', example='0.998'),
        summary?: string(name='Summary', description='The summary of the hit question.', example='公积金提取'),
        title?: string(name='Title', description='The title of the hit question.', example='公积金提取'),
      }(name='Knowledge', description='When AnswerType is Knowledge, this field contains the Knowledge object returned by the chatbot.'),
      recommends?: [ 
        {
          answerSource?: string(name='AnswerSource', description='The identifier of the clarification source.', example='KNOWLEDGE'),
          knowledgeId?: string(name='KnowledgeId', description='The knowledge ID for clarification.', example='4548'),
          score?: double(name='Score', description='The score of the recommended content. This field has a value when AnswerSource is KNOWLEDGE.', example='0.46'),
          title?: string(name='Title', description='The clarification content, which can be an entity from knowledge graph Q&A, a knowledge title from knowledge-based Q&A, or a column value from table-based Q&A.', example='Test plain text'),
        }
      ](name='Recommends', description='The list of recommendations returned by the bot when AnswerType is Recommend.'),
      text?: {
        answerSource?: string(name='AnswerSource', description='Distinguishes the answer type.', example='BotFramework'),
        articleTitle?: string(name='ArticleTitle', description='When AnswerSource is MACHINE_READ, this field returns the title of the hit article.', example='ICP Filing 11
[responses.200.schema.properties.Messages.items.properties.AnswerSource.enumValueTitles. INTENT_FAQ_CLARIFY]FAQ and dialog flow mixed clarification'),
        commands?: map[string]any(name='Commands', description='The instruction parameters, such as the skill group for a transfer-to-agent instruction.', example='{
	"sysToAgent": "{\\\\"skillGroup\\\\":\\\\"12\\\\"}"
}'),
        content?: string(name='Content', description='The content of the text message.', example='Which location do you want to check the weather for?'),
        contentType?: string(name='ContentType', description='The indicator of whether the answer is plain text or rich text.', example='PLAIN_TEXT'),
        dialogName?: string(name='DialogName', description='When AnswerSource is BotFramework, this field returns the dialog flow unit name.', example='Sample_CheckWeather'),
        ext?: map[string]any(name='Ext', description='The pass-through parameters returned in this field.', example='{
	"MATCHED_INTENT_SOURCE": "",
	"INTENT_ID": 724414,
	"IntentName": "CheckWeatherIntent",
	"INTENT_DETAIL": "[I want|I need to] check the weather",
	"LGF_EXPRESSION": "[I want|I need to] check the weather",
	"IS_SESSION_FINISHED": false,
	"DsScore": 100.0,
	"DIALOG_ID": "299034",
	"FINISH_LABEL": false,
	"MODULE_START": false,
	"INTENT_NAME": "CheckWeatherIntent",
	"INTENT_SOURCE": "Lgf",
	"DIALOG_NAME": "Sample_CheckWeather"
}'),
        externalFlags?: map[string]any(name='ExternalFlags', description='The pass-through parameters returned when AnswerSource is BotFramework.'),
        hitStatement?: string(name='HitStatement', description='The hit statement.', example='CheckWeather'),
        intentName?: string(name='IntentName', description='When AnswerSource is BotFramework, this field returns the intent name.', example='CheckWeatherIntent'),
        metaData?: string(name='MetaData', description='The metadata.', example='[[{"columnName":"Name","stringValue":"Wang Shanshan"}]]'),
        nodeId?: string(name='NodeId', description='The node ID returned when AnswerSource is BotFramework.', example='1410-c7a72a78.__city'),
        nodeName?: string(name='NodeName', description='When AnswerSource is BotFramework, this field returns the node name.', example='Sample_CheckWeather.CheckWeatherSlotFilling.__city'),
        responseType?: string(name='ResponseType', description='When AnswerSource is BotFramework and ResponseType is SSML, this field indicates that a dialog flow interactive slot filling is hit. Otherwise, this field does not exist.', example='SSML'),
        score?: double(name='Score', description='The score.', example='100.0'),
        slots?: [ 
          {
            hit?: boolean(name='Hit', description='Indicates whether the slot is hit.', example='false'),
            name?: string(name='Name', description='The name.', example='CheckWeatherIntent.city'),
            origin?: string(name='Origin', description='The original value.', example='Beijing'),
            value?: string(name='Value', description='The specific value.', example='Beijing'),
          }
        ](name='Slots', description='When AnswerSource is BotFramework, this field returns the list of named entities.'),
        userDefinedChatTitle?: string(name='UserDefinedChatTitle', description='The title of the custom chitchat topic.', example='Greeting'),
      }(name='Text', description='When AnswerType is Text, this field contains the Text object returned by the chatbot.'),
      title?: string(name='Title', description='The counter-question title in online scenarios.', example='Which insurance age range are you inquiring about?'),
      voiceTitle?: string(name='VoiceTitle', description='The clarification content in voice scenarios.', example='Are you asking about provident fund inquiry or provident fund withdrawal?'),
    }
  ](name='Messages', description='The list of messages.'),
  querySegList?: [ string ](name='QuerySegList', description='The tokenization results of the query, which may be empty.'),
  requestId?: string(name='RequestId', description='The request ID.', example='A2315C4B-A872-5DEE-9DAD-D73B194A4AEC'),
  sessionId?: string(name='SessionId', description='The ID of the current session.', example='a6f216a0685c4c8baa0e8beb6d5ec6db'),
}

model ChatResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ChatResponseBody(name='body'),
}

/**
  * @param request  the request parameters of Chat  ChatRequest
  * @return ChatResponse
 */
async function chat(request: ChatRequest): ChatResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'Chat', 'POST', '/', 'json', false, 'json', request);
}

model ContinueInstancePublishTaskRequest {
  regionId?: string(name='RegionId', position='Host'),
  agentKey?: string(name='AgentKey', description='The key of the business space. If this parameter is not specified, the default business space is accessed. You can obtain the key on the business management page of the Alibaba Cloud account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Query'),
  id?: long(name='Id', description='The task ID.', example='8521', position='Query'),
  instanceId?: string(name='InstanceId', description='The unique identifier of the chatbot.', example='chatbot-cn-mp90s2lrk00050', position='Query'),
