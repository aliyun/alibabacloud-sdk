import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Chatbot';
  @version = '2022-04-08';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model ApplyForStreamAccessTokenRequest {
  agentKey?: string(name='AgentKey', description='The key of the business space. If this parameter is not set, the default business space is accessed. You can obtain the key value on the business management page of the Alibaba Cloud account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Query'),
}

model ApplyForStreamAccessTokenResponseBody = {
  accessToken?: string(name='AccessToken', description='The request token of the service.', example='63ba97b4f18a4a04f715c81e8e643938'),
  channelId?: string(name='ChannelId', description='The channel ID.', example='cc9e88c0-4f41-4f1d-a1a9-91a72d2aa27d'),
  requestId?: string(name='RequestId', description='Id of the request', example='736994BD-AA35-4742-88C9-E64BE4BAA14B'),
  streamSecret?: string(name='StreamSecret', description='The secret key of the business space, which is used to sign streaming requests.', example='cc9e88c0-4f41-4f1d-a1a9-91a72d2aa27d'),
}

model ApplyForStreamAccessTokenResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ApplyForStreamAccessTokenResponseBody(name='body'),
}

/**
  * @param request  the request parameters of ApplyForStreamAccessToken  ApplyForStreamAccessTokenRequest
  * @return ApplyForStreamAccessTokenResponse
 */
async function applyForStreamAccessToken(request: ApplyForStreamAccessTokenRequest): ApplyForStreamAccessTokenResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ApplyForStreamAccessToken', 'POST', '/', 'json', false, 'json', request);
}

model AssociateRequest {
  regionId?: string(name='RegionId', position='Host'),
  agentKey?: string(name='AgentKey', description='The business space key. If not specified, the default business space is accessed. Obtain the key value from the business management page of the primary account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Query'),
  instanceId?: string(name='InstanceId', description='The unique identifier of the robot.', example='chatbot-cn-mp90s2lrk00050', position='Query'),
  perspective?: [ string ](name='Perspective', description='The perspective code, which is used to call answers from different perspectives under the same knowledge title. When assembling request parameters, pass the parameter in the format Perspective={perspective code}. For example: &Perspective=["FZJBY3raWr"]. When using the SDK, use the parameters defined in the SDK. Currently, only one perspective answer can be called.', example='["qyzzVfyFfa"]', shrink='json', position='Query'),
  recommendNum?: long(name='RecommendNum', description='The number of recommended questions, ranging from 1 to 10. This parameter takes effect only when recommendations are returned. The number of returned recommended questions is less than or equal to RecommendNum.', example='8', position='Query'),
  sessionId?: string(name='SessionId', description='The session ID, which is used to identify a visitor\\\\"s session and maintain context information. For a new visitor, you do not need to pass this field when calling the Chat operation for the first time. The robot starts a session and returns the SessionId of the session in the response of the Chat operation. For subsequent conversation turns of the visitor, pass the SessionId of the current session when calling the Chat operation so that the robot can continue the conversation based on the SessionId.', example='7c3cec23cc8940bc9db4a318c8f4f0aa', position='Query'),
  utterance?: string(name='Utterance', description='The user utterance.', example='Housing fund withdrawal', position='Query'),
}

model AssociateResponseBody = {
  associate?: [ 
    {
      meta?: string(name='Meta', description='The additional information.', example='{}'),
      title?: string(name='Title', description='The title of the associated question.', example='Housing fund withdrawal policy'),
    }
  ](name='Associate', description='The list of associated suggestions.'),
  messageId?: string(name='MessageId', description='The ID of the response message in the current session.', example='5ADF0EBD-7C50-1922-A28B-43215B47CC1A'),
  requestId?: string(name='RequestId', description='The request ID.', example='5C20F0D4-9721-178A-8236-3BF990634962'),
  sessionId?: string(name='SessionId', description='The ID of the current session.', example='1531ded6b3df4afca4be63943f708bb7'),
}

model AssociateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AssociateResponseBody(name='body'),
}

/**
  * @param request  the request parameters of Associate  AssociateRequest
  * @return AssociateResponse
 */
async function associate(request: AssociateRequest): AssociateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'Associate', 'POST', '/', 'json', false, 'json', request);
}

model BeginSessionRequest {
  regionId?: string(name='RegionId', position='Host'),
  agentKey?: string(name='AgentKey', description='The key of the workspace. If this parameter is not set, the default workspace is accessed. You can obtain the key on the business management page of the Alibaba Cloud account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Query'),
  instanceId?: string(name='InstanceId', position='Body'),
  sandBox?: boolean(name='SandBox', position='Body'),
  sessionId?: string(name='SessionId', position='Body'),
  vendorParam?: string(name='VendorParam', position='Body'),
}

model BeginSessionResponseBody = {
  asrMaxEndSilence?: int32(name='AsrMaxEndSilence', description='The Automatic Speech Recognition (ASR) end-of-speech detection time. Unit: milliseconds.', example='700'),
  interruptible?: boolean(name='Interruptible', description='Indicates whether the voice broadcast can be interrupted.', example='false'),
  requestId?: string(name='RequestId', description='The request ID.', example='149C7528-C104-1B50-A4F9-0C5907A8AD9D'),
  silenceReplyTimeout?: int32(name='SilenceReplyTimeout', description='The silence timeout period. Unit: seconds.', example='5'),
  welcomeMessage?: string(name='WelcomeMessage', description='The welcome message.', example='The intelligent chatbot is at your service. How can I help you?'),
}

model BeginSessionResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: BeginSessionResponseBody(name='body'),
}

/**
  * @param request  the request parameters of BeginSession  BeginSessionRequest
  * @return BeginSessionResponse
 */
async function beginSession(request: BeginSessionRequest): BeginSessionResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'BeginSession', 'POST', '/', 'json', true, 'form', request);
}

model CancelChatRequest {
  agentKey?: string(name='AgentKey', description='The business space key. If this parameter is not specified, the default business space is accessed. You can obtain the key value on the business management page of the Alibaba Cloud account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public', position='Body'),
  answer?: string(name='Answer', description='The answer content.', example='<This answer was inter>', position='Body'),
  chatId?: string(name='ChatId', description='The ID that identifies a single conversation.', example='7105a351-b2e7-4c9e-8437-c43a043c0a4e', position='Body'),
  instanceId?: string(name='InstanceId', description='The chatbot ID.', example='chatbot-cn-yjzbyrEvqd', position='Body'),
  sessionId?: string(name='SessionId', description='The session ID, which is used to identify a visitor\\\\"s session and maintain context information. For a new visitor, you do not need to specify this parameter when calling the Chat operation for the first time. The chatbot starts a session and returns the SessionId in the response of the Chat operation. For subsequent conversation turns of the visitor, pass the SessionId of the current session when calling the Chat operation so that the chatbot can continue the conversation based on the SessionId. Maximum length: 64 characters.', example='c1187530338311ebade7cf3eaeb3668a', position='Body'),
  type?: string(name='Type', description='The interruption type.', example='Canceled', position='Body'),
}

model CancelChatResponseBody = {
  cancelResult?: boolean(name='CancelResult', description='The result of calling this operation.'),
  requestId?: string(name='RequestId', description='The request ID.', example='E3E5C779-A630-45AC-B0F2-A4506A4212F1'),
}

model CancelChatResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CancelChatResponseBody(name='body'),
}

/**
  * @description Only new version chatbots are supported. Only data within the last 90 days can be queried.
  * @param request  the request parameters of CancelChat  CancelChatRequest
  * @return CancelChatResponse
 */
async function cancelChat(request: CancelChatRequest): CancelChatResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CancelChat', 'POST', '/', 'json', true, 'form', request);
}

