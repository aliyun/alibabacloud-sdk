model ContinueInstancePublishTaskResponseBody = {
  bizTypeList?: [ string ](name='BizTypeList', description='The list of business types.'),
  createTime?: string(name='CreateTime', description='The UTC time when the task was created.', example='2022-04-12T06:30:17Z'),
  error?: string(name='Error', description='The job failure information.', example='An error occurred while checking whether the module to be published is idle, faq'),
  errors?: map[string]any(name='Errors', description='The fault information for each sub-publish module. The key is the sub-publish module and the value is the fault information.', example='{}'),
  id?: long(name='Id', description='The task ID.', example='8522'),
  modifyTime?: string(name='ModifyTime', description='The UTC time when the task was last modified.', example='2022-04-12T06:30:33Z'),
