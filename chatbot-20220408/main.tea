model AssociateRequest {
  agentKey?: string(name='AgentKey', description='The business space key. If not specified, the default business space is accessed. Obtain the key value from the business management page of the primary account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public'),
  instanceId?: string(name='InstanceId', description='The unique identifier of the robot.', example='chatbot-cn-mp90s2lrk00050'),
  perspective?: [ string ](name='Perspective', description='The perspective code, which is used to call answers from different perspectives under the same knowledge title. When assembling request parameters, pass the parameter in the format Perspective={perspective code}. For example: &Perspective=["FZJBY3raWr"]. When using the SDK, use the parameters defined in the SDK. Currently, only one perspective answer can be called.', example='["qyzzVfyFfa"]'),
  recommendNum?: long(name='RecommendNum', description='The number of recommended questions, ranging from 1 to 10. This parameter takes effect only when recommendations are returned. The number of returned recommended questions is less than or equal to RecommendNum.', example='8'),
  sessionId?: string(name='SessionId', description='The session ID, which is used to identify a visitor\\\\"s session and maintain context information. For a new visitor, you do not need to pass this field when calling the Chat operation for the first time. The robot starts a session and returns the SessionId of the session in the response of the Chat operation. For subsequent conversation turns of the visitor, pass the SessionId of the current session when calling the Chat operation so that the robot can continue the conversation based on the SessionId.', example='7c3cec23cc8940bc9db4a318c8f4f0aa'),
  utterance?: string(name='Utterance', description='The user utterance.', example='Housing fund withdrawal'),
}

model AssociateShrinkRequest {
  agentKey?: string(name='AgentKey', description='The business space key. If not specified, the default business space is accessed. Obtain the key value from the business management page of the primary account.', example='ac627989eb4f8a98ed05fd098bbae5_p_beebot_public'),
  instanceId?: string(name='InstanceId', description='The unique identifier of the robot.', example='chatbot-cn-mp90s2lrk00050'),
  perspectiveShrink?: string(name='Perspective', description='The perspective code, which is used to call answers from different perspectives under the same knowledge title. When assembling request parameters, pass the parameter in the format Perspective={perspective code}. For example: &Perspective=["FZJBY3raWr"]. When using the SDK, use the parameters defined in the SDK. Currently, only one perspective answer can be called.', example='["qyzzVfyFfa"]'),
  recommendNum?: long(name='RecommendNum', description='The number of recommended questions, ranging from 1 to 10. This parameter takes effect only when recommendations are returned. The number of returned recommended questions is less than or equal to RecommendNum.', example='8'),
  sessionId?: string(name='SessionId', description='The session ID, which is used to identify a visitor\\\\"s session and maintain context information. For a new visitor, you do not need to pass this field when calling the Chat operation for the first time. The robot starts a session and returns the SessionId of the session in the response of the Chat operation. For subsequent conversation turns of the visitor, pass the SessionId of the current session when calling the Chat operation so that the robot can continue the conversation based on the SessionId.', example='7c3cec23cc8940bc9db4a318c8f4f0aa'),
  utterance?: string(name='Utterance', description='The user utterance.', example='Housing fund withdrawal'),
}

model AssociateResponseBody = {
  associate?: [ 
    {
      meta?: string(name='Meta', description='The additional information.', example='{}'),
      title?: string(name='Title', description='The title of the associated question.', example='Housing fund withdrawal policy'),
    }
  ](name='Associate', description='The list of associated suggestions.'),
  messageId?: string(name='MessageId', description='The ID of the response message in the current session.', example='5ADF0EBD-7C50-1922-A28B-43215B47CC1A'),
  requestId?: string(name='RequestId', description='The request ID.', example='5C20F0D4-9721-178A-8236-3BF990634962'),
  sessionId?: string(name='SessionId', description='The ID of the current session.', example='1531ded6b3df4afca4be63943f708bb7'),
}

model AssociateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AssociateResponseBody(name='body'),
}

/**
 * @summary Suggests FAQs from the knowledge base based on a user query.
 *
 * @param tmpReq AssociateRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return AssociateResponse
 */
async function associateWithOptions(tmpReq: AssociateRequest, runtime: Util.RuntimeOptions): AssociateResponse {
  Util.validateModel(tmpReq);
  var request = new AssociateShrinkRequest{};
  OpenApiUtil.convert(tmpReq, request);
  if (!Util.isUnset(tmpReq.perspective)) {
    request.perspectiveShrink = OpenApiUtil.arrayToStringWithSpecifiedStyle(tmpReq.perspective, 'Perspective', 'json');
  }
  var query = {};
  if (!Util.isUnset(request.agentKey)) {
    query['AgentKey'] = request.agentKey;
  }
  if (!Util.isUnset(request.instanceId)) {
    query['InstanceId'] = request.instanceId;
  }
  if (!Util.isUnset(request.perspectiveShrink)) {
    query['Perspective'] = request.perspectiveShrink;
  }
  if (!Util.isUnset(request.recommendNum)) {
    query['RecommendNum'] = request.recommendNum;
  }
  if (!Util.isUnset(request.sessionId)) {
    query['SessionId'] = request.sessionId;
  }
  if (!Util.isUnset(request.utterance)) {
    query['Utterance'] = request.utterance;
  }
  var req = new OpenApi.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
  };
  var params = new OpenApi.Params{
    action = 'Associate',
    version = '2022-04-08',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Suggests FAQs from the knowledge base based on a user query.
 *
 * @param request AssociateRequest
 * @return AssociateResponse
 */
async function associate(request: AssociateRequest): AssociateResponse {
  var runtime = new Util.RuntimeOptions{};
  return associateWithOptions(request, runtime);
}

