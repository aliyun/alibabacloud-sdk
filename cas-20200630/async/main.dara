model AssignCertificateCountRequest {
  caIdentifier?: string(name='CaIdentifier', description='The identifier of the CA certificate.', example='1f0167b4-ee84-XXX-49bc4d39fa68', position='Query'),
  certTotalCount?: int32(name='CertTotalCount', description='The total number of certificate records.', example='5', position='Query'),
  id?: long(name='Id', description='The ID of the data source to which the certificate belongs.', example='33285', position='Query'),
}

model AssignCertificateCountResponseBody = {
  certCount?: int32(name='CertCount', description='The number of allocated certificates.', example='2'),
  currentYearFreeCertCount?: int32(name='CurrentYearFreeCertCount', description='The number of free certificates in the current year.', example='0'),
  requestId?: string(name='RequestId', description='The request ID.', example='E77C4794-F24F-58CB-9929-F0F0C0EDE7B2'),
}

model AssignCertificateCountResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AssignCertificateCountResponseBody(name='body'),
}

/**
  * @description Queries the number of CA certificates that you have created, including root CA certificates and subordinate CA certificates.
  * ## QPS limits
  * The QPS limit for a single user is 10 calls per second. If the limit is exceeded, API calls are throttled, which may affect your services. Call this operation at a reasonable rate.
  * @param request  the request parameters of AssignCertificateCount  AssignCertificateCountRequest
  * @return AssignCertificateCountResponse
 */
async function assignCertificateCount(request: AssignCertificateCountRequest): AssignCertificateCountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AssignCertificateCount', 'POST', '/', 'json', false, 'json', request);
}

model CreateClientCertificateRequest {
  afterTime?: long(name='AfterTime', description='The expiration time of the client certificate in timestamp format. Unit: seconds.
>The **BeforeTime** and **AfterTime** parameters must both be empty or both be specified.', example='1665819958', position='Query'),
  algorithm?: string(name='Algorithm', description='The key algorithm of the client certificate. The key algorithm is in the format of `<encryption algorithm>_<key length>`. Valid values:

- **RSA_1024**: The signature algorithm is Sha256WithRSA.
- **RSA_2048**: The signature algorithm is Sha256WithRSA.
- **RSA_4096**: The signature algorithm is Sha256WithRSA.
- **ECC_256**: The signature algorithm is Sha256WithECDSA.
- **ECC_384**: The signature algorithm is Sha256WithECDSA.
- **ECC_512**: The signature algorithm is Sha256WithECDSA.
- **SM2_256**: The signature algorithm is SM3WithSM2.

The encryption algorithm of the client certificate must be the same as that of the sub-CA certificate, but the key length can be different. For example, if the key algorithm of the sub-CA certificate is RSA_2048, the key algorithm of the client certificate must be RSA_1024, RSA_2048, or RSA_4096.

>You can call [DescribeCACertificate](https://help.aliyun.com/document_detail/465954.html) to query the key algorithm of the sub-CA certificate.', example='RSA_2048', position='Query'),
  aliasName?: string(name='AliasName', description='The name of the issued certificate.', example='cert-name', position='Query'),
  asynchronousFlag?: boolean(name='AsynchronousFlag', description='The asynchronous processing flag. If the value is set to "true", the backend service issues the certificate asynchronously.
After the request is submitted, you can call the ListClientCertificate operation to obtain the latest certificate.', example='false', position='Query'),
  beforeTime?: long(name='BeforeTime', description='The issuance time of the client certificate in timestamp format. Default value: the time when you call this operation. Unit: seconds.

>The **BeforeTime** and **AfterTime** parameters must both be empty or both be specified.', example='1634283958', position='Query'),
  clientToken?: string(name='ClientToken', description='The client token that is used to ensure the idempotence of the request. The value is generated by the client and must be unique across different requests. The value can contain up to 64 ASCII characters and cannot contain non-ASCII characters.', example='XXX', position='Body'),
  commonName?: string(name='CommonName', description='The name of the certificate subject. The subject of a client authentication (ClientAuth) certificate is typically a person, company, organization, or application. Specify the common name of the subject. For example, John Doe, Alibaba, Alibaba Cloud Crypto Platform, or Tmall Genie.', example='aliyun', position='Query'),
  country?: string(name='Country', description='The country. Default value: CN.', example='CN', position='Query'),
  customIdentifier?: string(name='CustomIdentifier', description='The custom identifier, which serves as a unique key.', example='****6bb538d538c70c01f81jh2****', position='Query'),
  days?: int32(name='Days', description='The validity period of the client certificate. Unit: days.
The **Days**, **BeforeTime**, and **AfterTime** parameters cannot all be empty, and the **BeforeTime** and **AfterTime** parameters must both be empty or both be specified. The following rules apply:

- If you set the **Days** parameter, you can optionally set both **BeforeTime** and **AfterTime** or leave them empty.
- If you do not set the **Days** parameter, you must set both **BeforeTime** and **AfterTime**.

>- If you set **Days**, **BeforeTime**, and **AfterTime** at the same time, the validity period is determined by the **Days** parameter.
- The validity period of the client certificate cannot exceed that of the sub-CA certificate. You can call [DescribeCACertificate](https://help.aliyun.com/document_detail/465954.html) to query the validity period of the sub-CA certificate.', example='365', position='Query'),
  enableCrl?: long(name='EnableCrl', description='Specifies whether to include the Certificate Revocation List (CRL) address. Valid values:

- 0: No.
- 1: Yes.', example='1', position='Query'),
  immediately?: int32(name='Immediately', description='Specifies whether to immediately return the digital certificate. Valid values:
- **0**: Does not return the certificate. This is the default value.
- **1**: Returns the certificate.
- **2**: Returns the certificate and its certificate chain.', example='1', position='Query'),
  locality?: string(name='Locality', description='The name of the city where the certificate organization is located. Chinese and English characters are supported.
Default value: the city of the sub-CA certificate that issues this certificate.', example='Hangzhou', position='Query'),
  months?: int32(name='Months', description='The validity period of the certificate. Unit: months.', example='1', position='Query'),
  organization?: string(name='Organization', description='The organization name. Default value: Alibaba Inc.', example='Alibaba Cloud', position='Query'),
  organizationUnit?: string(name='OrganizationUnit', description='The department name. Default value: Aliyun CDN.', example='IT', position='Query'),
  parentIdentifier?: string(name='ParentIdentifier', description='The unique identifier of the sub-CA certificate that issues this certificate. The Private Certificate Authority instance (PrivateCaInstanceId) bound to the sub-CA must be in a valid and unexpired state.
>You can call [DescribeCACertificateList] to query the unique identifier of the sub-CA certificate.', example='273ae6bb538d538c70c01f81jh2****', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-aek****wia', position='Query'),
  sanType?: int32(name='SanType', description='The Subject Alternative Name (SAN) type supported by the client certificate. Valid values:

- **1**: email address.
- **6**: Uniform Resource Identifier (URI).', example='1', position='Query'),
  sanValue?: string(name='SanValue', description='The specific SAN extension information of the client certificate. You can enter multiple SAN values separated by commas (,).', example='somebody@example.com', position='Query'),
  state?: string(name='State', description='<props="china">The name of the province, municipality, or autonomous region where the certificate organization is located. Chinese and English characters are supported. Default value: the province, municipality, or autonomous region of the sub-CA certificate that issues this certificate.
<props="intl">The name of the province or state where the certificate organization is located. Chinese and English characters are supported. Default value: the province or state of the sub-CA certificate that issues this certificate.', example='Zhejiang', position='Query'),
  tags?: [ 
    {
      key?: string(name='Key', description='The tag key.', example='account'),
      value?: string(name='Value', description='The tag value.', example='1'),
    }
  ](name='Tags', description='The tag list.', position='Query'),
  years?: int32(name='Years', description='The validity period of the certificate. Unit: years.', example='5', position='Query'),
}

model CreateClientCertificateResponseBody = {
  certificateChain?: string(name='CertificateChain', description='The CA certificate chain.', example='-----BEGIN CERTIFICATE-----\\\\n......\\\\n-----END CERTIFICATE-----\\\\n-----BEGIN CERTIFICATE-----\\\\n......\\\\n-----END CERTIFICATE-----\\\\n'),
  identifier?: string(name='Identifier', description='The unique identifier of the client certificate.', example='190ae6bb538d538c70c01f81dcf2****'),
  requestId?: string(name='RequestId', description='The request ID. Alibaba Cloud generates a unique identifier for each request, which can be used for troubleshooting and diagnostics.', example='8C467B38-3910-447D-87BC-AC049166F216'),
  serialNumber?: string(name='SerialNumber', description='The certificate serial number.', example='084bde9cd233f0ddae33adc438cfbbbd****'),
  x509Certificate?: string(name='X509Certificate', description='The content of the client certificate.', example='-----BEGIN CERTIFICATE-----\\\\n......\\\\n-----END CERTIFICATE-----'),
}

model CreateClientCertificateResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateClientCertificateResponseBody(name='body'),
}

/**
  * @description Before calling this operation, you must have called [CreateRootCACertificate](https://help.aliyun.com/document_detail/465962.html) to create a root CA certificate and called [CreateSubCACertificate](https://help.aliyun.com/document_detail/465959.html) to create a sub-CA certificate. Only sub-CA certificates can issue client certificates.
  * ## QPS limit
  * The single-user QPS limit for this operation is 10 calls per second. If the limit is exceeded, the API call is throttled, which may affect your business. Call this operation appropriately.
  * @param request  the request parameters of CreateClientCertificate  CreateClientCertificateRequest
  * @return CreateClientCertificateResponse
 */
async function createClientCertificate(request: CreateClientCertificateRequest): CreateClientCertificateResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateClientCertificate', 'POST', '/', 'json', true, 'form', request);
}

