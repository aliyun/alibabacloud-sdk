  * @return GetDataMaskingAccountCountResponse
 */
async function getDataMaskingAccountCount(request: GetDataMaskingAccountCountRequest): GetDataMaskingAccountCountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetDataMaskingAccountCount', 'POST', '/', 'json', false, 'json', request);
}

