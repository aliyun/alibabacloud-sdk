  maintainStartTime?: long(name='MaintainStartTime', description='The start time of the O&M window. The value is a UNIX timestamp in milliseconds since 1970-01-01 00:00:00 UTC. The UTC time of the O&M window is combined with the date of the query day and returned.', example='1788566400000'),
