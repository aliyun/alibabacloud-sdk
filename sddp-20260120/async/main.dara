import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Sddp';
  @version = '2026-01-20';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hongkong' = 'sddp-api.cn-hongkong.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model CheckDataMaskingInstanceRequest {
  regionId?: string(name='RegionId', position='Host'),
  instanceId?: string(name='InstanceId', description='The database instance identity. You can obtain the value from Items[].InstanceId in the response of ListDataMaskingInstances.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:
- zh: Chinese
- en: English', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud service code. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also specified, the two parameters must match.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The cloud service type identifier. Valid values:
- 5: RDS
- 8: POLARDB
- 27: PolarDBX2
If this parameter is specified together with ProductCode, the values must match.', example='5', position='Query'),
}

model CheckDataMaskingInstanceResponseBody = {
  errorCode?: string(name='ErrorCode', description='The instance check result code. A value of Success indicates that the check is passed. For other values, refer to ErrorMessage for troubleshooting.', example='Success'),
  errorMessage?: string(name='ErrorMessage', description='The instance check result message. If the check fails, the specific cause is returned.', example='The instance is not in the running state'),
  requestId?: string(name='RequestId', description='The request ID. You can use the ID to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model CheckDataMaskingInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CheckDataMaskingInstanceResponseBody(name='body'),
}

/**
  * @description Checks the permissions, DPI engine, and running conditions of an instance before you create column encryption. You must check both ErrorCode and ErrorMessage in the response. Only ErrorCode=Success indicates that the check is passed. A successful request does not mean that the instance meets all encryption conditions. This check does not create a column encryption rule.
  * Parameter examples are for format illustration only. When you invoke the operation, replace them with the region, resource identity, and configuration values obtained from the current account.
  * Use the service registration endpoint of the region where the target asset is located and configure the Settings for the common parameter RegionId, such as cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * @param request  the request parameters of CheckDataMaskingInstance  CheckDataMaskingInstanceRequest
  * @return CheckDataMaskingInstanceResponse
 */
async function checkDataMaskingInstance(request: CheckDataMaskingInstanceRequest): CheckDataMaskingInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CheckDataMaskingInstance', 'POST', '/', 'json', false, 'json', request);
}

model CreateDataMaskingRuleRequest {
  regionId?: string(name='RegionId', position='Host'),
  encAlgorithm?: string(name='EncAlgorithm', description='The name of the column encryption algorithm. The availability of AES_128_GCM, AES_256_GCM, and SM4_128_GCM depends on the instance. Select an available algorithm from ListDataMaskingEncryptionAlgorithms.', example='AES_256_GCM', position='Query'),
  encryptionKeyId?: string(name='EncryptionKeyId', description='The identifier of the Key Management Service (KMS) key. You can obtain it from Items[].KeyId in the response of the ListKmsKeys operation. Provide this parameter when you use a KMS key. Do not pass this parameter in local key scenarios.', example='12345678-1234-1234-1234-12345678****', position='Query'),
  encryptionKeyMode?: string(name='EncryptionKeyMode', description='The key mode. Valid values:
- client_key: local key
- kms_key: KMS key
When you use kms_key, you must specify EncryptionKeyId.', example='client_key', position='Query'),
  engineType?: string(name='EngineType', description='The type of the database engine. The value must be consistent with the EngineType of the target instance, such as MySQL or PostgreSQL.', example='MySQL', position='Query'),
  expireTime?: long(name='ExpireTime', description='The expiration time of the plaintext permission. The value is a UNIX timestamp in milliseconds since 00:00:00 UTC on January 1, 1970. Specify this parameter only when ExpireTimeOperation is set to SET. The value must be later than the current time and no greater than 2145953410000. The server saves the value with second precision. Do not specify this parameter when ExpireTimeOperation is set to PRESERVE or CLEAR.', example='2145953410000', position='Query'),
  expireTimeOperation?: string(name='ExpireTimeOperation', description='The processing method for the permission expiration time. Valid values:
- PRESERVE: retains the original expiration time.
- CLEAR: clears the expiration time.
- SET: sets ExpireTime.
Default value: PRESERVE. Only fullAccess supports setting a validity period.', example='PRESERVE', position='Query'),
  instanceId?: string(name='InstanceId', description='The instance identity. You can obtain it from Items[].InstanceId in the response of the ListDataMaskingInstances operation.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:
- zh: Chinese
- en: English', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The code of the cloud service. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also passed, the two must correspond to each other.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The identifier of the cloud service type. Valid values:
- 5: RDS
- 8: POLARDB
- 27: PolarDBX2
When specified together with ProductCode, the values must correspond to each other.', example='5', position='Query'),
  riskHandleId?: long(name='RiskHandleId', description='The identifier of the associated risk handling record. You do not need to specify this parameter in the standard column encryption creation process.', example='1001', position='Query'),
  subRuleList?: [ 
    {
      columns?: string(name='Columns', description='The list of target column names. Multiple column names are separated by commas (,).', example='phone,email'),
      dbName?: string(name='DbName', description='The name of the target database.', example='business_db'),
      tableName?: string(name='TableName', description='The name of the target table.', example='customer'),
    }
  ](name='SubRuleList', description='The list of column encryption targets grouped by database and table.', shrink='json', position='Query'),
  userList?: [ 
    {
      accountId?: string(name='AccountId', description='The identifier of the database account. You can obtain it from Items[].Id in the response of the ListDataAssetAccounts operation. Pass the value as a string.', example='1001'),
      authDb?: string(name='AuthDb', description='The authentication database for MongoDB accounts. This parameter is required when you select a MongoDB account. You do not need to pass this parameter for other services.', example='admin'),
    }
  ](name='UserList', description='The list of database accounts to which the fullAccess plaintext permission is granted. The accounts must belong to the target instance.', shrink='json', position='Query'),
}

model CreateDataMaskingRuleResponseBody = {
  requestId?: string(name='RequestId', description='The request ID. You can use the ID to locate the API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model CreateDataMaskingRuleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateDataMaskingRuleResponseBody(name='body'),
}

/**
  * @description Creates a column encryption rule for specified databases, tables, and columns under the same instance. Before calling this operation, check the instance status, supported algorithms, keys, target columns, and accounts. SubRuleList is a list of targets grouped by table, and Columns is a string of column names separated by commas. Accounts in UserList are granted the fullAccess plaintext permission. A successful request only indicates that the request is accepted. You must call the ListDataMaskingColumns and ListDataAssetAccounts operations to confirm the column status, account permissions, and validity period.
  * The parameter examples are for illustrative purposes only. When calling this operation, replace them with the region, resource identifiers, and configuration values obtained by querying the current account.
  * Use the endpoint of the region where the target asset is located, and set the common parameter RegionId, such as cn-zhangjiakou. The product code and instance identity must match those of the target asset.
  * This operation only returns RequestId. Request acceptance does not mean that the business operation is complete. Read back the status as described in the operation description.
  * @param request  the request parameters of CreateDataMaskingRule  CreateDataMaskingRuleRequest
  * @return CreateDataMaskingRuleResponse
 */
async function createDataMaskingRule(request: CreateDataMaskingRuleRequest): CreateDataMaskingRuleResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateDataMaskingRule', 'POST', '/', 'json', false, 'json', request);
}

model DeleteDataMaskingRuleRequest {
  regionId?: string(name='RegionId', position='Host'),
  engineType?: string(name='EngineType', description='The database engine type. The value must be the same as the EngineType of the target instance, such as MySQL or PostgreSQL.', example='MySQL', position='Query'),
  instanceId?: string(name='InstanceId', description='The database instance identifier. You can obtain this value from the Items[].InstanceId field in the response of the ListDataMaskingInstances operation.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response message. Valid values: zh: Chinese. en: English.', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud service code. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also specified, the two parameters must match.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The cloud service type identifier. Valid values: 5: RDS. 8: POLARDB. 27: PolarDBX2. If this parameter is specified together with ProductCode, the values must match.', example='5', position='Query'),
  subRuleList?: [ 
    {
      columns?: string(name='Columns', description='The list of target column names. Separate multiple column names with commas (,).', example='phone,email'),
      dbName?: string(name='DbName', description='The name of the target database.', example='business_db'),
      tableName?: string(name='TableName', description='The name of the target table.', example='customer'),
    }
  ](name='SubRuleList', description='The list of column encryption targets grouped by database and table.', shrink='json', position='Query'),
}

model DeleteDataMaskingRuleResponseBody = {
  requestId?: string(name='RequestId', description='The request ID. You can use the ID to locate the API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model DeleteDataMaskingRuleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DeleteDataMaskingRuleResponseBody(name='body'),
}

/**
  * @description Disables encryption rules for specified columns in the same instance. SubRuleList precisely specifies databases, tables, and columns. If no rule is matched, no new operation object is created. The disable request is processed asynchronously. Use ListDataMaskingColumns to verify that the column is restored to NotEncrypted or that the target rule has been removed. DeleteFailed indicates that the disable operation failed.
  * The parameter examples are for format illustration only. When you invoke the API, replace them with the region, resource identifier, and configuration values obtained for the current account.
  * Use the endpoint of the region where the target asset is located, and set the common parameter RegionId, such as cn-zhangjiakou. The product code and instance identifier must match the target asset.
  * This operation returns only RequestId. Request acceptance does not mean that the business operation is complete. You should check the status as described in the operation description.
  * @param request  the request parameters of DeleteDataMaskingRule  DeleteDataMaskingRuleRequest
  * @return DeleteDataMaskingRuleResponse
 */
async function deleteDataMaskingRule(request: DeleteDataMaskingRuleRequest): DeleteDataMaskingRuleResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DeleteDataMaskingRule', 'POST', '/', 'json', false, 'json', request);
}

model GetDataMaskingAccountCountRequest {
  regionId?: string(name='RegionId', position='Host'),
  lang?: string(name='Lang', description='The language of the response description. Valid values: zh: Chinese. en: English.', example='zh', position='Query'),
  productIds?: string(name='ProductIds', description='The list of cloud product type identifiers. Separate multiple values with commas (,). For column encryption scenarios, the values are 5 (RDS), 8 (PolarDB), and 27 (PolarDB-X 2.0).', example='5', position='Query'),
}

model GetDataMaskingAccountCountResponseBody = {
  accountCount?: {
    fullAccessCount?: long(name='FullAccessCount', description='The number of accounts with plaintext access (fullAccess).', example='2'),
    noneAccessCount?: long(name='NoneAccessCount', description='The number of accounts prohibited from decryption (noneAccess).', example='1'),
    restrictedAccessCount?: long(name='RestrictedAccessCount', description='The number of accounts with restricted access (restrictedAccess).', example='3'),
    totalCount?: long(name='TotalCount', description='The total number of database accounts.', example='10'),
  }(name='AccountCount', description='The statistics on the number of account permissions for column encryption.'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate the API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model GetDataMaskingAccountCountResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetDataMaskingAccountCountResponseBody(name='body'),
}

/**
  * @description Queries the permission statistics of database accounts in the current region by product scope. Plaintext accounts correspond to FullAccessCount. Restricted access and decryption-prohibited accounts are counted in RestrictedAccessCount and NoneAccessCount, respectively. The number of accounts without configured permissions can be obtained by subtracting the number of the preceding three types of accounts from TotalCount. This operation does not accept filter conditions such as instance, database, table, or column.
  * Parameter examples are for format illustration only. Replace them with the region, resource identity, and configuration values obtained from the current account when you invoke this operation.
  * Use the service registration endpoint of the region where the target asset is located and configure the Settings for the common parameter RegionId, such as cn-zhangjiakou. The product encoding and instance identity must be consistent with the target asset.
  * @param request  the request parameters of GetDataMaskingAccountCount  GetDataMaskingAccountCountRequest
  * @return GetDataMaskingAccountCountResponse
 */
async function getDataMaskingAccountCount(request: GetDataMaskingAccountCountRequest): GetDataMaskingAccountCountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetDataMaskingAccountCount', 'POST', '/', 'json', false, 'json', request);
}

model GetDataMaskingColumnCountRequest {
  regionId?: string(name='RegionId', position='Host'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:
- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productIds?: string(name='ProductIds', description='The list of cloud product type identifiers. Separate multiple values with commas (,). For column encryption scenarios, the values correspond to 5 (ApsaraDB RDS), 8 (PolarDB), and 27 (PolarDB-X).', example='5', position='Query'),
  templateId?: long(name='TemplateId', description='The data classification template ID. You can obtain the ID from the Items[].Id parameter in the ListTemplates response. The ID must be consistent with the selected sensitivity level and detection model.', example='1', position='Query'),
}

model GetDataMaskingColumnCountResponseBody = {
  columnCount?: {
    maskedCount?: long(name='MaskedCount', description='The number of encrypted columns in the current scope.', example='10'),
    maskingFailedCount?: long(name='MaskingFailedCount', description='The number of columns that failed to be encrypted in the current scope.', example='1'),
    sensitiveCount?: long(name='SensitiveCount', description='The number of sensitive columns in the current scope.', example='20'),
    totalCount?: long(name='TotalCount', description='The total number of columns in the current scope.', example='100'),
  }(name='ColumnCount', description='The statistics on the number of encrypted columns.'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate the API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model GetDataMaskingColumnCountResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetDataMaskingColumnCountResponseBody(name='body'),
}

/**
  * @description Queries the total number of columns, the number of sensitive columns, the number of encrypted columns, and the number of columns that failed to be encrypted by region, product, and categorization and classification template. This operation returns data for statistics cards and does not filter by instance, database name, table name, column name, or model in the column list.
  * To be compatible with historical detection results, if the specified template has no first-screen results and is not filtered by sensitivity level or detection model, the results may backoff to the built-in general detection results. If strict template attribution is required, use the level or model conditions within the template for verification.
  * The parameter examples are for format illustration only. Replace them with the region, resource identity, and configuration values obtained from the current account when you invoke the operation.
  * Use the service registration endpoint of the region where the target asset is located and apply the Settings for the common parameter RegionId, such as cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * @param request  the request parameters of GetDataMaskingColumnCount  GetDataMaskingColumnCountRequest
  * @return GetDataMaskingColumnCountResponse
 */
async function getDataMaskingColumnCount(request: GetDataMaskingColumnCountRequest): GetDataMaskingColumnCountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetDataMaskingColumnCount', 'POST', '/', 'json', false, 'json', request);
}

