  maintainStartTime?: long(name='MaintainStartTime', description='The start time of the maintenance window. The value is a UNIX timestamp in milliseconds that have elapsed since 1970-01-01 00:00:00 UTC. The returned value combines the UTC time of the maintenance window with the date of the query day.', example='1788566400000'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
