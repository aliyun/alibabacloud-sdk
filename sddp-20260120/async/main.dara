  * Parameter examples are for format illustration only. When you call the API, replace them with the region, resource ID, and configuration values obtained from the current account.
  * Use the endpoint of the region where the target asset is located, and set the common parameter RegionId, such as cn-zhangjiakou. The product code and instance ID must match the target asset.
  * @param request  the request parameters of GetInstanceAttribute  GetInstanceAttributeRequest
  * @return GetInstanceAttributeResponse
 */
async function getInstanceAttribute(request: GetInstanceAttributeRequest): GetInstanceAttributeResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetInstanceAttribute', 'POST', '/', 'json', false, 'json', request);
}

model ListColumnsRequest {
  regionId?: string(name='RegionId', position='Host'),
  currentPage?: int32(name='CurrentPage', description='The page number of the current query. Pages start from 1.', example='1', position='Query'),
  dataAssetSourceId?: string(name='DataAssetSourceId', description='The cloud database instance identity. Set this parameter to the InstanceId in the instance list.', example='rm-2ze1abcdefgh****', position='Query'),
  dataSourceName?: string(name='DataSourceName', description='The name of the database. Set this parameter to the DbName returned by ListDataSources.', example='business_db', position='Query'),
  engineType?: string(name='EngineType', description='The type of the database engine. This parameter must be consistent with the EngineType of the target instance, such as MySQL or PostgreSQL.', example='MySQL', position='Query'),
  instanceName?: string(name='InstanceName', description='The compatible parameter for the instance identity. DataAssetSourceId takes precedence. If both are specified, DataAssetSourceId is used.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values: zh: Chinese; en: English.', example='zh', position='Query'),
  name?: string(name='Name', description='The filter condition for the column name.', example='phone', position='Query'),
  pageSize?: int32(name='PageSize', description='The number of entries to return on each page. Keep other filter conditions consistent when querying the next page.', example='20', position='Query'),
  productCode?: string(name='ProductCode', description='The code of the cloud service. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also specified, the two parameters must match.', example='RDS', position='Query'),
  riskLevelId?: long(name='RiskLevelId', description='The identifier of the sensitivity level. You can obtain this value from the return list of ListRiskLevels.', example='1', position='Query'),
  ruleId?: long(name='RuleId', description='The identifier of the detection rule or model. Set this parameter to the ID of the corresponding detection rule in the target template.', example='1001', position='Query'),
  tableName?: string(name='TableName', description='The name of the data table. In PostgreSQL or Oracle scenarios, retain the schema.table format obtained from the table list.', example='customer', position='Query'),
  templateId?: long(name='TemplateId', description='The identifier of the data classification and grading template. You can obtain this value from Items[].Id returned by ListTemplates. Keep this parameter consistent with the selected sensitivity level and detection model.', example='1', position='Query'),
}

model ListColumnsResponseBody = {
  currentPage?: int32(name='CurrentPage', description='The page number of the returned data.', example='1'),
  items?: [ 
    {
      creationTime?: long(name='CreationTime', description='The creation time of the data object. The value is a UNIX timestamp in milliseconds since 1970-01-01 00:00:00 UTC.', example='1788566400000'),
      dataAssetSourceId?: string(name='DataAssetSourceId', description='The cloud instance identity.', example='rm-2ze1abcdefgh****'),
      dataSourceName?: string(name='DataSourceName', description='The name of the database.', example='business_db'),
      dataType?: string(name='DataType', description='The data type of the database column.', example='varchar'),
      engineType?: string(name='EngineType', description='The type of the database engine.', example='MySQL'),
      instanceName?: string(name='InstanceName', description='The instance identity of the cloud instance to which the column belongs. This is a compatible field.', example='rm-2ze1abcdefgh****'),
      maskingStatus?: int32(name='MaskingStatus', description='The compatibility field for the column encryption status. To query column encryption results, call ListDataMaskingColumns.', example='0'),
      name?: string(name='Name', description='The name of the data column.', example='phone'),
      productCode?: string(name='ProductCode', description='The code of the cloud service.', example='RDS'),
      regionId?: string(name='RegionId', description='The ID of the region where the asset is located.', example='cn-zhangjiakou'),
      revisionId?: long(name='RevisionId', description='The identifier of the detection result correction record.', example='1001'),
      revisionStatus?: long(name='RevisionStatus', description='The correction status of the detection result. Valid values: 0: Not corrected. 1: Corrected.', example='0'),
      riskLevelId?: long(name='RiskLevelId', description='The identifier of the sensitivity level.', example='1'),
      riskLevelName?: string(name='RiskLevelName', description='The name of the sensitivity level.', example='S2'),
      ruleId?: long(name='RuleId', description='The identifier of the matched detection rule.', example='1001'),
      ruleName?: string(name='RuleName', description='The name of the matched detection rule.', example='Phone number'),
      schemaName?: string(name='SchemaName', description='The name of the database schema.', example='public'),
      sensitive?: boolean(name='Sensitive', description='Indicates whether the data is detected as sensitive data.'),
      tableName?: string(name='TableName', description='The name of the data table.', example='customer'),
    }
  ](name='Items', description='The list of records returned by the current query.'),
  pageSize?: int32(name='PageSize', description='The number of entries returned per page in the current query.', example='20'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate the current API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
  totalCount?: int32(name='TotalCount', description='The total number of entries that meet the current statistics or query scope.', example='100'),
}

model ListColumnsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListColumnsResponseBody(name='body'),
}

/**
  * @description Performs a paging query on the columns and detection results in a data table. If both DataAssetSourceId and InstanceName are specified, DataAssetSourceId takes precedence. In PostgreSQL and Oracle scenarios, you can use the schema.table format for TableName and pass the corresponding EngineType. To query the execution status of column encryption, call ListDataMaskingColumns.
  * To ensure compatibility with historical detection results, if the specified template has no first-screen results and is not filtered by sensitivity level or detection model, the results may fall back to the built-in general detection results. If strict template attribution is required, use the level or model conditions within the template for verification.
  * The parameter examples are for format illustration only. When you call the API, replace them with the region, resource identifier, and configuration values obtained from the current account.
  * Use the endpoint of the region where the target asset is located, and set the common parameter RegionId, such as cn-zhangjiakou. The product code and instance identity must match the target asset.
  * @param request  the request parameters of ListColumns  ListColumnsRequest
  * @return ListColumnsResponse
 */
async function listColumns(request: ListColumnsRequest): ListColumnsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListColumns', 'POST', '/', 'json', false, 'json', request);
}

model ListDataAssetAccountsRequest {
  regionId?: string(name='RegionId', position='Host'),
  accountName?: string(name='AccountName', description='The database account name. The system filters accounts by the exact account name.', example='app_reader', position='Query'),
  authDb?: string(name='AuthDb', description='The authentication database of the MongoDB account. This parameter is used to distinguish accounts with the same name in different authentication databases.', example='admin', position='Query'),
  authRole?: string(name='AuthRole', description='The column encryption access permissions. Valid values:
