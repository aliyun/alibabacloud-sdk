  instanceId?: string(name='InstanceId', description='The database instance identity. You can obtain this value from Items[].InstanceId in the response of ListDataMaskingInstances.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:
- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud product code. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also specified, the two must correspond to each other.', example='RDS', position='Query'),
