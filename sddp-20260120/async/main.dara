noneAccess applies only to ApsaraDB RDS for MySQL instances whose active key pattern is client_key.', example='fullAccess', position='Query'),
  expireTime?: long(name='ExpireTime', description='The expiration time of the plaintext access permissions. Specify a UNIX timestamp in milliseconds since 1970-01-01 00:00:00 UTC. This parameter is required only when ExpireTimeOperation is set to SET. The value must be later than the current time and no later than 2145953410000. The server stores the value with second-level precision. Do not specify this parameter when ExpireTimeOperation is set to PRESERVE or CLEAR.', example='2145953410000', position='Query'),
  expireTimeOperation?: string(name='ExpireTimeOperation', description='The action to take on the permission expiration time. Valid values:

- PRESERVE: Retains the existing expiration time.
- CLEAR: Clears the expiration time.
- SET: Sets the expiration time to the value specified by ExpireTime.

Default value: PRESERVE. Only fullAccess supports configuring a validity period.', example='PRESERVE', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:

- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud product code. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also specified, the two parameters must correspond to each other.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The cloud product type identifier. Valid values:

- 5: RDS.
- 8: POLARDB.
- 27: PolarDBX2.

If both ProductId and ProductCode are specified, they must correspond to each other.', example='5', position='Query'),
  userList?: [ 
    {
      accountId?: string(name='AccountId', description='The database account identifier. Obtain this value from Items[].Id in the response of ListDataAssetAccounts and pass it as a string.', example='1001'),
      instanceId?: string(name='InstanceId', description='The database instance identity. Obtain this value from Items[].InstanceId in the response of ListDataMaskingInstances.', example='rm-2ze1abcdefgh****'),
    }
  ](name='UserList', description='The list of database accounts for which to set permissions.', shrink='json', position='Query'),
}

model UpdateDataMaskingUsersResponseBody = {
