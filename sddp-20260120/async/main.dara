  switchTime?: long(name='SwitchTime', description='The specified upgrade time. The value is a UNIX timestamp in milliseconds that have elapsed since 1970-01-01 00:00:00 UTC. Specify this parameter only when UpgradeTime is set to SpecifyTime, and the time must be later than the current time.', example='1893456000000', position='Query'),
  upgradeTime?: string(name='UpgradeTime', description='The execution time of the kernel upgrade. Valid values:
