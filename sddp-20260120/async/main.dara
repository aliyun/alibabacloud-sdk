import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'Sddp';
  @version = '2026-01-20';
  @endpointRule = 'regional';
  @endpointMap = {
    'cn-hongkong' = 'sddp-api.cn-hongkong.aliyuncs.com',
  };
}

function close(): void {
  @handler.close();
}

model CheckDataMaskingInstanceRequest {
  regionId?: string(name='RegionId', position='Host'),
  instanceId?: string(name='InstanceId', description='The database instance identifier. You can obtain this value from Items[].InstanceId returned by ListDataMaskingInstances.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:

- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud product code. Column encryption supports RDS, POLARDB, and PolarDBX2. If you also specify ProductId, the two values must correspond to each other.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The cloud product type identifier. Valid values:

- 5: ApsaraDB RDS.
- 8: PolarDB.
- 27: PolarDB-X 2.0.

If you specify both ProductId and ProductCode, the values must correspond to each other.', example='5', position='Query'),
}

model CheckDataMaskingInstanceResponseBody = {
  errorCode?: string(name='ErrorCode', description='The instance check result code. A value of Success indicates that the check passed. For other values, handle the error based on ErrorMessage.', example='Success'),
  errorMessage?: string(name='ErrorMessage', description='The instance check result description. A specific reason is returned when the check fails.', example='The instance is not in the running state'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model CheckDataMaskingInstanceResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CheckDataMaskingInstanceResponseBody(name='body'),
}

/**
  * @description Checks the permissions, engine, and runtime conditions of an instance before creating column encryption rules. Check both ErrorCode and ErrorMessage in the response. Only ErrorCode=Success indicates that the check passed. A successful request alone does not mean the instance meets all encryption conditions. This check does not create column encryption rules.
  * The parameter examples are provided only to illustrate the format. Replace them with the region, resource identities, and configuration values obtained from your account.
  * Use the service registration endpoint of the region where the target asset resides, and configure the common parameter RegionId to the corresponding value, such as cn-zhangjiakou. The product code and instance identifier must match the target asset.
  * @param request  the request parameters of CheckDataMaskingInstance  CheckDataMaskingInstanceRequest
  * @return CheckDataMaskingInstanceResponse
 */
async function checkDataMaskingInstance(request: CheckDataMaskingInstanceRequest): CheckDataMaskingInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CheckDataMaskingInstance', 'POST', '/', 'json', false, 'json', request);
}

model CreateDataMaskingRuleRequest {
  regionId?: string(name='RegionId', position='Host'),
  encAlgorithm?: string(name='EncAlgorithm', description='The name of the column encryption algorithm. The availability of AES_128_GCM, AES_256_GCM, and SM4_128_GCM depends on the instance. Select an available algorithm from [ListDataMaskingEncryptionAlgorithms](https://help.aliyun.com/document_detail/2859327.html).', example='AES_256_GCM', position='Query'),
  encryptionKeyId?: string(name='EncryptionKeyId', description='The KMS key ID. You can obtain this value from Items[].KeyId in the response of [ListKmsKeys](https://help.aliyun.com/document_detail/2859328.html). Specify this parameter when you use a KMS key. Do not specify this parameter for local key scenarios.', example='12345678-1234-1234-1234-12345678****', position='Query'),
  encryptionKeyMode?: string(name='EncryptionKeyMode', description='The key mode. Valid values:

- client_key: local key.
- kms_key: KMS key. If you set this parameter to kms_key, you must specify EncryptionKeyId.', example='client_key', position='Query'),
  engineType?: string(name='EngineType', description='The database engine type. This value must match the EngineType of the target instance, such as MySQL or PostgreSQL.', example='MySQL', position='Query'),
  expireTime?: long(name='ExpireTime', description='The expiration time of the plaintext access permissions. This value is a UNIX timestamp in milliseconds since 1970-01-01 00:00:00 UTC. Specify this parameter only when ExpireTimeOperation is set to SET. The value must be later than the current time and no greater than 2145953410000. The server stores the value with second-level precision. Do not specify this parameter when ExpireTimeOperation is set to PRESERVE or CLEAR.', example='2145953410000', position='Query'),
  expireTimeOperation?: string(name='ExpireTimeOperation', description='The handling method for the permission expiration time. Valid values:

- PRESERVE: Retains the original expiration time.
- CLEAR: Clears the expiration time.
- SET: Sets the expiration time to the value specified by ExpireTime.

Default value: PRESERVE. Only fullAccess supports expiration time settings.', example='PRESERVE', position='Query'),
  instanceId?: string(name='InstanceId', description='The database instance identity. You can obtain this value from Items[].InstanceId in the response of [ListDataMaskingInstances](https://help.aliyun.com/document_detail/2859326.html).', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:

- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud product code. Column encryption supports RDS, POLARDB, and PolarDBX2. If you specify both ProductCode and ProductId, the values must correspond to each other.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The cloud product type ID. Valid values:

- 5: RDS.
- 8: POLARDB.
- 27: PolarDBX2.

If you specify both ProductId and ProductCode, the values must correspond to each other.', example='5', position='Query'),
  riskHandleId?: long(name='RiskHandleId', description='The ID of the associated risk handling record. You do not need to specify this parameter for standard column encryption creation.', example='1001', position='Query'),
  subRuleList?: [ 
    {
      columns?: string(name='Columns', description='The list of target column names. Separate multiple column names with commas (,).', example='phone,email'),
      dbName?: string(name='DbName', description='The name of the target database.', example='business_db'),
      tableName?: string(name='TableName', description='The name of the target table.', example='customer'),
    }
  ](name='SubRuleList', description='The list of column encryption targets grouped by database and table.', shrink='json', position='Query'),
  userList?: [ 
    {
      accountId?: string(name='AccountId', description='The database account ID. You can obtain this value from Items[].Id in the response of [ListDataAssetAccounts](https://help.aliyun.com/document_detail/2859330.html). Pass this value as a string.', example='1001'),
    }
  ](name='UserList', description='The list of database accounts to be granted fullAccess plaintext access permissions. The accounts must belong to the target instance.', shrink='json', position='Query'),
}

model CreateDataMaskingRuleResponseBody = {
  requestId?: string(name='RequestId', description='The request ID. You can use this ID to locate the API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model CreateDataMaskingRuleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateDataMaskingRuleResponseBody(name='body'),
}

/**
  * @description Creates a column encryption rule for a specified database, table, and columns under the same instance. Before invoking this operation, verify the instance status, supported algorithms, key, target columns, and accounts. SubRuleList is a list of target columns grouped by table. Columns is a comma-separated string of column names. Accounts in UserList are granted fullAccess plaintext access permissions. A successful request indicates only that the request has been accepted. You must invoke [ListDataMaskingColumns](https://help.aliyun.com/document_detail/2859325.html) and [ListDataAssetAccounts](https://help.aliyun.com/document_detail/2859330.html) to confirm the column status, account access permissions, and expiration time.
  * The parameter examples are provided only to illustrate the format. Replace them with the region, resource identifiers, and configuration values obtained from your account.
  * Use the endpoint of the region where the target asset resides and set the common parameter RegionId, such as cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * This operation returns only RequestId. A successful request does not mean that the operation is complete. Read back the status as described in the operation description.
  * @param request  the request parameters of CreateDataMaskingRule  CreateDataMaskingRuleRequest
  * @return CreateDataMaskingRuleResponse
 */
async function createDataMaskingRule(request: CreateDataMaskingRuleRequest): CreateDataMaskingRuleResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateDataMaskingRule', 'POST', '/', 'json', false, 'json', request);
}

