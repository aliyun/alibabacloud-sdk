}

model ListColumnsRequest {
  regionId?: string(name='RegionId', position='Host'),
  currentPage?: int32(name='CurrentPage', description='The current page number, starting from 1.', example='1', position='Query'),
  dataAssetSourceId?: string(name='DataAssetSourceId', description='The cloud database instance identity. Set this parameter to the InstanceId from the instance list.', example='rm-2ze1abcdefgh****', position='Query'),
  dataSourceName?: string(name='DataSourceName', description='The database name. Set this parameter to the DbName returned by ListDataSources.', example='business_db', position='Query'),
  engineType?: string(name='EngineType', description='The database engine type. This value must match the EngineType of the target instance, such as MySQL or PostgreSQL.', example='MySQL', position='Query'),
  instanceName?: string(name='InstanceName', description='The compatible parameter for the instance identity. DataAssetSourceId takes precedence. If both are specified, DataAssetSourceId is used.', example='rm-2ze1abcdefgh****', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:
- zh: Chinese.
- en: English.', example='zh', position='Query'),
  name?: string(name='Name', description='The column name filter condition.', example='phone', position='Query'),
  pageSize?: int32(name='PageSize', description='The number of records per page. Keep other filter conditions consistent when querying the next page.', example='20', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud product code. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also specified, the two values must correspond to each other.', example='RDS', position='Query'),
  riskLevelId?: long(name='RiskLevelId', description='The sensitivity level ID. You can obtain this value from the list returned by ListRiskLevels.', example='1', position='Query'),
  ruleId?: long(name='RuleId', description='The ID of the detection rule or model. Set this parameter to the ID of the corresponding detection rule in the target template.', example='1001', position='Query'),
  tableName?: string(name='TableName', description='The name of the data table. For PostgreSQL or Oracle scenarios, retain the schema.table format obtained from the table list.', example='customer', position='Query'),
  templateId?: long(name='TemplateId', description='The ID of the classification and grading template. You can obtain this value from Items[].Id returned by ListTemplates. Ensure consistency with the selected sensitivity level and detection model.', example='1', position='Query'),
}

model ListColumnsResponseBody = {
  currentPage?: int32(name='CurrentPage', description='The page number of the returned data.', example='1'),
  items?: [ 
    {
      creationTime?: long(name='CreationTime', description='The creation time of the data object. This value is a UNIX timestamp in milliseconds since 1970-01-01 00:00:00 UTC.', example='1788566400000'),
      dataAssetSourceId?: string(name='DataAssetSourceId', description='The cloud instance identity.', example='rm-2ze1abcdefgh****'),
      dataSourceName?: string(name='DataSourceName', description='The database name.', example='business_db'),
      dataType?: string(name='DataType', description='The data type of the database column.', example='varchar'),
      engineType?: string(name='EngineType', description='The database engine type.', example='MySQL'),
      instanceName?: string(name='InstanceName', description='The cloud instance identity to which the column belongs. This is a compatible field.', example='rm-2ze1abcdefgh****'),
      maskingStatus?: int32(name='MaskingStatus', description='The compatible field for column encryption status. To query column encryption results, call ListDataMaskingColumns.', example='0'),
      name?: string(name='Name', description='The name of the data column.', example='phone'),
      productCode?: string(name='ProductCode', description='The cloud product code.', example='RDS'),
      regionId?: string(name='RegionId', description='The region ID of the asset.', example='cn-zhangjiakou'),
      revisionId?: long(name='RevisionId', description='The ID of the detection result revision record.', example='1001'),
      revisionStatus?: long(name='RevisionStatus', description='The revision status of the detection result. Valid values:
- 0: not revised.
- 1: revised.', example='0'),
      riskLevelId?: long(name='RiskLevelId', description='The sensitivity level ID.', example='1'),
      riskLevelName?: string(name='RiskLevelName', description='The sensitivity level name.', example='S2'),
      ruleId?: long(name='RuleId', description='The ID of the matched detection rule.', example='1001'),
      ruleName?: string(name='RuleName', description='The name of the matched detection rule.', example='Phone number'),
      schemaName?: string(name='SchemaName', description='The database schema name.', example='public'),
      sensitive?: boolean(name='Sensitive', description='Indicates whether the data is detected as sensitive data.'),
      tableName?: string(name='TableName', description='The data table name.', example='customer'),
    }
  ](name='Items', description='The list of records returned by this query.'),
  pageSize?: int32(name='PageSize', description='The number of records per page for this query.', example='20'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
  totalCount?: int32(name='TotalCount', description='The total number of records that match the current query scope.', example='100'),
}

model ListColumnsResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: ListColumnsResponseBody(name='body'),
}

/**
  * @description Queries columns and detection results of a data table with paging. When both DataAssetSourceId and InstanceName are specified, DataAssetSourceId takes precedence. For PostgreSQL and Oracle scenarios, you can use the schema.table format for TableName and pass in the corresponding EngineType. To query the execute status of column encryption, invoke ListDataMaskingColumns.
  * For compatible with historical detection results, if the specified template has no initial results and no filtering by sensitivity level or detection model is applied, the results may fall back to built-in general detection results. To strictly verify template ownership, use the sensitivity level or model conditions within the template for verification.
  * The parameter examples are provided only to illustrate the format. Replace them with the region, resource identity, and configuration values obtained from your current account.
  * Use the endpoint of the region where the target asset resides and set the common parameter RegionId, such as cn-zhangjiakou. The product code and instance identity must match the target asset.
  * @param request  the request parameters of ListColumns  ListColumnsRequest
  * @return ListColumnsResponse
 */
async function listColumns(request: ListColumnsRequest): ListColumnsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListColumns', 'POST', '/', 'json', false, 'json', request);
}

model ListDataAssetAccountsRequest {
  regionId?: string(name='RegionId', position='Host'),
  accountName?: string(name='AccountName', description='The database account name. Filters by exact account name.', example='app_reader', position='Query'),
  authRole?: string(name='AuthRole', description='The column encryption access permissions. Valid values:

