/**
  * @description Modifies the instance-level column encryption algorithm and key configuration, which affects the column encryption configuration of the instance. The current implementation supports ApsaraDB RDS for MySQL and PolarDB-X 2.0. Query the algorithms and keys supported by the instance before invoking this operation. This operation does not have an EncryptionKeyMode parameter. Configure the parameter based on the usage conditions of EncryptionKeyId. After a successful request, read back the instance encryption configuration and column status. Do not determine completion based solely on the RequestId.
  * The parameter examples are provided only to illustrate the format. Replace them with the region, resource identities, and configuration values obtained by querying your current account.
  * Use the service registration endpoint of the region where the target asset resides, and set the common parameter RegionId, for example, cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * This operation returns only the RequestId. A successful request does not indicate that the business operation is complete. Read back the status as described in the operation description.
  * @param request  the request parameters of UpdateDataMaskingEncryptionAlgorithm  UpdateDataMaskingEncryptionAlgorithmRequest
  * @return UpdateDataMaskingEncryptionAlgorithmResponse
 */
async function updateDataMaskingEncryptionAlgorithm(request: UpdateDataMaskingEncryptionAlgorithmRequest): UpdateDataMaskingEncryptionAlgorithmResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'UpdateDataMaskingEncryptionAlgorithm', 'POST', '/', 'json', false, 'json', request);
}

model UpdateDataMaskingUsersRequest {
  regionId?: string(name='RegionId', position='Host'),
  authRole?: string(name='AuthRole', description='The column encryption access permissions. Valid values: fullAccess: plaintext access. restrictedAccess: restricted access. noneAccess: prohibits decryption. noneAccess applies only to RDS MySQL instances whose current effective key pattern is client_key.', example='fullAccess', position='Query'),
  expireTime?: long(name='ExpireTime', description='The expiration time of the plaintext access permissions. The value is a UNIX timestamp in milliseconds since 00:00:00 UTC on January 1, 1970. Specify this parameter only when ExpireTimeOperation is set to SET. The value must be later than the current time and no greater than 2145953410000. The server saves the value with second-level precision. Do not specify this parameter when ExpireTimeOperation is set to PRESERVE or CLEAR.', example='2145953410000', position='Query'),
  expireTimeOperation?: string(name='ExpireTimeOperation', description='The processing method for the permission expiration time. Valid values: PRESERVE: retains the original expiration time. CLEAR: clears the expiration time. SET: sets the expiration time to the value of ExpireTime. Default value: PRESERVE. Only fullAccess supports setting an expiration time.', example='PRESERVE', position='Query'),
  lang?: string(name='Lang', description='The language of the response description. Valid values: zh: Chinese. en: English.', example='zh', position='Query'),
  productCode?: string(name='ProductCode', description='The cloud product code. Column encryption supports RDS, POLARDB, and PolarDBX2. If ProductId is also provided, the two parameters must match.', example='RDS', position='Query'),
  productId?: long(name='ProductId', description='The cloud product type identifier. Valid values: 5: RDS. 8: POLARDB. 27: PolarDBX2. If specified together with ProductCode, the values must match.', example='5', position='Query'),
  userList?: [ 
    {
      accountId?: string(name='AccountId', description='The name of the database account. Obtain the value from Items[].AccountName in the records returned by ListDataAssetAccounts and pass it as a string exactly as it is. Do not pass Items[].Id. Each AccountId must correspond to the InstanceId in the same item. Accounts with the same name in different instances are considered different targets.', example='app_reader'),
      authDb?: string(name='AuthDb', description='The authentication database of MongoDB.', example='database'),
      instanceId?: string(name='InstanceId', description='The database instance identity. You can obtain the value from Items[].InstanceId returned by ListDataMaskingInstances.', example='rm-2ze1abcdefgh****'),
    }
  ](name='UserList', description='The list of database accounts for which you want to set permissions.', shrink='json', position='Query'),
}

model UpdateDataMaskingUsersResponseBody = {
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model UpdateDataMaskingUsersResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: UpdateDataMaskingUsersResponseBody(name='body'),
}

/**
  * @description Sets the same column encryption access permissions Settings for a batch of database accounts. UserList can contain accounts from different instances under the same product and region. Each item must include InstanceId and AccountId. fullAccess allows plaintext access, restrictedAccess allows restricted access, and noneAccess prohibits decryption and is supported only by specific DPI engines and key patterns. Only fullAccess supports configuring an expiration time. After a successful request, invoke ListDataAssetAccounts to read back the results.
