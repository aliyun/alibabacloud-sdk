model GetDataMaskingAccountCountResponseBody = {
  accountCount?: {
    fullAccessCount?: long(name='FullAccessCount', example='2'),
    noneAccessCount?: long(name='NoneAccessCount', example='1'),
    restrictedAccessCount?: long(name='RestrictedAccessCount', example='3'),
