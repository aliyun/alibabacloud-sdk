  * @return ListDataMaskingColumnsResponse
 */
async function listDataMaskingColumns(request: ListDataMaskingColumnsRequest): ListDataMaskingColumnsResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'ListDataMaskingColumns', 'POST', '/', 'json', false, 'json', request);
}

