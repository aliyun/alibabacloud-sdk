model DeleteDataMaskingRuleResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: DeleteDataMaskingRuleResponseBody(name='body'),
}

/**
  * @description Disables column encryption rules for specified columns within the same instance. SubRuleList precisely specifies the database, table, and columns. If no matching rule is found, no new operation object is created. The disable request is processed asynchronously. Use ListDataMaskingColumns to verify that the column has recovered to NotEncrypted or that the target rule has been removed. DeleteFailed indicates that the shutdown failed.
  * The parameter examples are provided only to illustrate the format. Replace them with the region, resource identity, and configuration values obtained by querying your current account.
  * Use the endpoint of the region where the target asset resides, and set the common parameter RegionId to the corresponding value, such as cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * This operation returns only RequestId. Request acceptance does not indicate that the business operation is complete. Poll the status as described in the operation description.
  * @param request  the request parameters of DeleteDataMaskingRule  DeleteDataMaskingRuleRequest
  * @return DeleteDataMaskingRuleResponse
 */
async function deleteDataMaskingRule(request: DeleteDataMaskingRuleRequest): DeleteDataMaskingRuleResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'DeleteDataMaskingRule', 'POST', '/', 'json', false, 'json', request);
}

model GetDataMaskingAccountCountRequest {
  regionId?: string(name='RegionId', position='Host'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:
- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productIds?: string(name='ProductIds', description='The list of cloud product type identifiers. Separate multiple values with commas (,). For column encryption scenarios, valid values: 5 (RDS), 8 (POLARDB), and 27 (PolarDBX2).', example='5', position='Query'),
}

model GetDataMaskingAccountCountResponseBody = {
  accountCount?: {
    fullAccessCount?: long(name='FullAccessCount', description='The number of fullAccess accounts that have plaintext access.', example='2'),
    noneAccessCount?: long(name='NoneAccessCount', description='The number of noneAccess accounts that are prohibited from decryption.', example='1'),
    restrictedAccessCount?: long(name='RestrictedAccessCount', description='The number of restrictedAccess accounts that have restricted access.', example='3'),
    totalCount?: long(name='TotalCount', description='The total number of database accounts.', example='10'),
  }(name='AccountCount', description='The permission statistics of column encryption accounts.'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model GetDataMaskingAccountCountResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetDataMaskingAccountCountResponseBody(name='body'),
}

/**
  * @description Queries the permission statistics of database accounts in the current region by product scope. Plaintext accounts correspond to FullAccessCount. Restricted access and decryption-prohibited accounts are counted in RestrictedAccessCount and NoneAccessCount, respectively. The number of accounts without configured permissions can be obtained by subtracting the preceding three account types from TotalCount. This operation does not accept filter conditions such as instance, database, table, or column.
  * The parameter examples are provided only to illustrate the format. Replace them with the region, resource identities, and configuration values obtained by querying the current account.
  * Use the endpoint of the region where the target asset resides, and set the common parameter RegionId to the corresponding value, such as cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * @param request  the request parameters of GetDataMaskingAccountCount  GetDataMaskingAccountCountRequest
  * @return GetDataMaskingAccountCountResponse
 */
async function getDataMaskingAccountCount(request: GetDataMaskingAccountCountRequest): GetDataMaskingAccountCountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetDataMaskingAccountCount', 'POST', '/', 'json', false, 'json', request);
}

model GetDataMaskingColumnCountRequest {
  regionId?: string(name='RegionId', position='Host'),
  lang?: string(name='Lang', description='The language of the response description. Valid values:

- zh: Chinese.
- en: English.', example='zh', position='Query'),
  productIds?: string(name='ProductIds', description='The list of cloud product type identifiers. Separate multiple values with commas (,). Valid values for column encryption scenarios: 5 (ApsaraDB RDS), 8 (PolarDB), and 27 (PolarDB-X 2.0).', example='5', position='Query'),
  templateId?: long(name='TemplateId', description='The ID of the data classification template. You can obtain this value from Items[].Id returned by the ListTemplates operation. This value must be consistent with the selected sensitivity level and detection model.', example='1', position='Query'),
}

model GetDataMaskingColumnCountResponseBody = {
  columnCount?: {
    maskedCount?: long(name='MaskedCount', description='The number of encrypted columns within the current scope.', example='10'),
    maskingFailedCount?: long(name='MaskingFailedCount', description='The number of columns that failed to be encrypted within the current scope.', example='1'),
    sensitiveCount?: long(name='SensitiveCount', description='The number of sensitive columns within the current scope.', example='20'),
    totalCount?: long(name='TotalCount', description='The total number of columns within the current scope.', example='100'),
  }(name='ColumnCount', description='The column encryption statistics.'),
  requestId?: string(name='RequestId', description='The request ID, which can be used to locate this API call.', example='7C6D8E9F-1234-5678-ABCD-0123456789AB'),
}

model GetDataMaskingColumnCountResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: GetDataMaskingColumnCountResponseBody(name='body'),
}

/**
  * @description Queries the total number of columns, the number of sensitive columns, the number of encrypted columns, and the number of columns that failed to be encrypted by region, product, and categorization template. This operation returns statistics card data and does not follow the instance, database name, table name, column name, or model filters in the column list.
  * For compatible with historical detection results, if no initial results are found for the specified template and no filtering by sensitivity level or detection model is applied, the results may backoff to built-in general detection results. To enforce strict template ownership, verify the results by using the sensitivity level or model conditions within the template.
  * The parameter examples are provided only to illustrate the format. Replace the values with the regions, resource identifiers, and configuration values obtained from your current account.
  * Use the endpoint of the region where the target asset resides and set the common parameter RegionId, such as cn-zhangjiakou. The product encoding and instance identity must match the target asset.
  * @param request  the request parameters of GetDataMaskingColumnCount  GetDataMaskingColumnCountRequest
  * @return GetDataMaskingColumnCountResponse
 */
async function getDataMaskingColumnCount(request: GetDataMaskingColumnCountRequest): GetDataMaskingColumnCountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'GetDataMaskingColumnCount', 'POST', '/', 'json', false, 'json', request);
}

