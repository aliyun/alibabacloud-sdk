  * @return UpdateDataMaskingUsersResponse
 */
async function updateDataMaskingUsers(request: UpdateDataMaskingUsersRequest): UpdateDataMaskingUsersResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'UpdateDataMaskingUsers', 'POST', '/', 'json', false, 'json', request);
}

