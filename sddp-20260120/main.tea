model CreateDataMaskingRuleRequest {
  encAlgorithm?: string(name='EncAlgorithm', example='AES_256_GCM'),
  encryptionKeyId?: string(name='EncryptionKeyId', example='12345678-1234-1234-1234-12345678****'),
  encryptionKeyMode?: string(name='EncryptionKeyMode', example='client_key'),
  engineType?: string(name='EngineType', example='MySQL'),
  expireTime?: long(name='ExpireTime', example='2145953410000'),
  expireTimeOperation?: string(name='ExpireTimeOperation', example='PRESERVE'),
  instanceId?: string(name='InstanceId', example='rm-2ze1abcdefgh****'),
  lang?: string(name='Lang', example='zh'),
  productCode?: string(name='ProductCode', example='RDS'),
  productId?: long(name='ProductId', example='5'),
  riskHandleId?: long(name='RiskHandleId', example='1001'),
  subRuleList?: [ 
    {
      columns?: string(name='Columns', example='phone,email'),
      dbName?: string(name='DbName', example='business_db'),
      tableName?: string(name='TableName', example='customer'),
    }
  ](name='SubRuleList'),
  userList?: [ 
    {
      accountId?: string(name='AccountId', example='1001'),
    }
  ](name='UserList'),
}

