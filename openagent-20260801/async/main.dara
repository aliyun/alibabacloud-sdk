model ListMessagesRequest {
  sessionId: string(name='sessionId', description='The ID of the session for which to retrieve the message history.

This parameter is required.', example='session_example_001', position='Path'),
  maxResults?: string(name='maxResults', description='The maximum number of timeline entries to return per page. The value must be a positive integer.', example='20', position='Query'),
  nextToken?: string(name='nextToken', description='The pagination token. Do not specify this parameter in the first request. For subsequent requests, use the value returned from the previous response.', example='example-next-token', position='Query'),
  runId?: string(name='runId', description='Filters messages by a specified run ID.', example='run_example_001', position='Query'),
}

model ListMessagesResponseBody = {
  data?: {
    nextToken?: string(name='nextToken', description='The pagination token for the next page. A value of null indicates that no more data is available.', example='example-next-token'),
    sessionId?: string(name='sessionId', description='The ID of the session to which the messages belong.', example='session_example_001'),
    timeline?: [ 
      {
        message?: {
          activityType?: string(name='activityType', description='The type identifier of the activity message.', example='example_activity'),
          content?: any(name='content', description='The message content. The structure is determined by the message type.', example='Check the status of the sample resource'),
          encryptedValue?: string(name='encryptedValue', description='The encrypted content. The example is an invalid placeholder value and does not contain actual ciphertext.', example='EXAMPLE_ENCRYPTED_VALUE'),
          error?: string(name='error', description='The error description when the tool execution fails.', example='Sample tool execution failure'),
          id?: string(name='id', description='The message ID.', example='message_example_001'),
          interruptOutcome?: {
            interrupts?: [ 
              {
                data?: {
                  apiCalls?: [ 
                    {
                      action?: string(name='action', description='The name of the API action.', example='ExampleAction'),
                      description?: string(name='description', description='The description of the operation pending approval.', example='Modify the sample resource'),
                    }
                  ](name='apiCalls', description='The list of API operations that require approval.'),
                  approvalId?: string(name='approvalId', description='The ID of the associated approval request.', example='approval_example_001'),
                  approvalUrl?: string(name='approvalUrl', description='The URL of the approval page. The example URL cannot be used for actual approvals.', example='https://example.com/approvals/approval_example_001'),
                  cancellable?: boolean(name='cancellable', description='Specifies whether the approval can be canceled.', example='true'),
                  changeDigest?: string(name='changeDigest', description='The summary identifier of the change pending approval.', example='example-change-digest'),
                  title?: string(name='title', description='The title of the approval request.', example='Sample change approval'),
                }(name='data', description='The supplementary business data for the interrupt.'),
                expiresAt?: string(name='expiresAt', description='The expiration time of the interrupt, in RFC 3339 format.', example='2026-01-02T00:00:00Z'),
                id?: string(name='id', description='The interrupt ID.', example='interrupt_example_001'),
                message?: string(name='message', description='The interrupt prompt displayed to the user.', example='Specify the target region'),
                metadata?: map[string]any(name='metadata', description='The extended metadata of the interrupt.', example='{}'),
                reason?: string(name='reason', description='The reason for the interrupt. Valid values: `tool_call` (tool invocation requires processing), `input_required` (user input is required), `confirmation` (confirmation is required), and `out_of_band_approval` (waiting for out-of-band approval).', example='input_required'),
                responseSchema?: map[string]any(name='responseSchema', description='The JSON schema that the resume result payload must follow.', example='{"type":"object","properties":{"region":{"type":"string"}},"required":["region"]}'),
                toolCallId?: string(name='toolCallId', description='The tool invocation ID associated with the interrupt.', example='tool_call_example_001'),
              }
            ](name='interrupts', description='The list of historical interrupts.'),
            type?: string(name='type', description='The interrupt result type. The value is fixed to `interrupt`.', example='interrupt'),
          }(name='interruptOutcome', description='The result information of the historical interrupt.'),
          metadata?: map[string]any(name='metadata', description='The extended metadata of the message.', example='{}'),
          name?: string(name='name', description='The name of the message sender.', example='example-user'),
          resumeInput?: {
            resolvedAt?: string(name='resolvedAt', description='The time when the interrupt processing was completed, in RFC 3339 format.', example='2026-01-01T00:01:00Z'),
            resume?: [ 
              {
                interruptId?: string(name='interruptId', description='The ID of the processed interrupt.', example='interrupt_example_001'),
                payload?: any(name='payload', description='The processing result for the corresponding interrupt. The result must comply with the responseSchema of the interrupt.', example='{"region":"cn-hangzhou"}'),
                status?: string(name='status', description='The response method for this interrupt. Valid values: `resolved` (the answer, confirmation, or tool result required by the interrupt has been submitted, which includes the `payload`) and `cancelled` (the interrupt has been canceled, which does not include the `payload`).', example='resolved'),
              }
            ](name='resume', description='The submitted processing results for each interrupt.'),
            runId?: string(name='runId', description='The ID of the original run that is resumed.', example='run_example_001'),
            source?: string(name='source', description='The source of the resume request. Valid values: `USER` (submitted by a user) and `INTERNAL` (submitted by an internal process).', example='USER'),
          }(name='resumeInput', description='The resume input corresponding to the historical interrupt.'),
          role?: string(name='role', description='The role of the message. Valid values: `user` (user message), `assistant` (assistant message), `tool` (tool result), `activity` (activity message), `reasoning` (reasoning message), and `interrupt` (interrupt record).', example='user'),
          toolCallId?: string(name='toolCallId', description='The tool invocation ID associated with the tool result.', example='tool_call_example_001'),
          toolCalls?: [ 
            {
              encryptedValue?: string(name='encryptedValue', description='The encrypted content of the tool invocation. The example is a placeholder value only.', example='EXAMPLE_ENCRYPTED_VALUE'),
              function?: {
                arguments?: string(name='arguments', description='The tool parameters as a JSON string.', example='{"keyword":"example"}'),
                name?: string(name='name', description='The name of the function or tool.', example='lookup_example'),
              }(name='function', description='The information about the function to execute.'),
              id?: string(name='id', description='The tool invocation ID.', example='tool_call_example_001'),
              metadata?: map[string]any(name='metadata', description='The extended metadata of the tool invocation.', example='{}'),
              type?: string(name='type', description='The tool invocation type. The value is fixed to `function`.', example='function'),
            }
          ](name='toolCalls', description='The list of tool invocations initiated by the agent.'),
        }(name='message', description='The message object. Message types are distinguished by role, and each type uses its corresponding fields.'),
        runId?: string(name='runId', description='The ID of the run to which the message belongs.', example='run_example_001'),
      }
    ](name='timeline', description='The message records returned in chronological order.'),
    total?: int32(name='total', description='The number of timeline records on the current page. The value is equal to the length of the timeline array.', example='1'),
  }(name='data', description='The message history and pagination information.'),
  requestId?: string(name='requestId', description='The request ID, which is used to locate and troubleshoot issues.', example='00000000-0000-4000-8000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request was successful. A value of true indicates success.', example='true'),
}

