          error?: string(name='error', description='The error description when tool execution fails.', example='Sample tool execution failure'),
          id?: string(name='id', description='The message ID.', example='message_example_001'),
          interruptOutcome?: {
            interrupts?: [ 
              {
                data?: {
                  apiCalls?: [ 
                    {
                      action?: string(name='action', description='The name of the API action.', example='ExampleAction'),
                      description?: string(name='description', description='The description of the operation pending approval.', example='Execute changes on the sample resource'),
                    }
                  ](name='apiCalls', description='The list of API operations that require approval.'),
                  approvalId?: string(name='approvalId', description='The associated approval ID.', example='approval_example_001'),
                  approvalUrl?: string(name='approvalUrl', description='The URL of the approval page. The example URL cannot be used for actual approval.', example='https://example.com/approvals/approval_example_001'),
                  cancellable?: boolean(name='cancellable', description='Specifies whether the approval can be canceled.', example='true'),
                  changeDigest?: string(name='changeDigest', description='The digest identifier of the change pending approval.', example='example-change-digest'),
                  title?: string(name='title', description='The title of the approval item.', example='Sample change approval'),
                }(name='data', description='The supplementary business data for the interrupt.'),
                expiresAt?: string(name='expiresAt', description='The expiration time of the interrupt, in RFC 3339 format.', example='2026-01-02T00:00:00Z'),
                id?: string(name='id', description='The interrupt ID.', example='interrupt_example_001'),
                message?: string(name='message', description='The interrupt prompt displayed to the user.', example='Specify the target region'),
                metadata?: map[string]any(name='metadata', description='The extended metadata of the interrupt.', example='{}'),
                reason?: string(name='reason', description='The reason for the interrupt. Valid values: `tool_call` (tool invocation requires processing), `input_required` (user input is required), `confirmation` (confirmation is required), and `out_of_band_approval` (waiting for out-of-band approval).', example='input_required'),
                responseSchema?: map[string]any(name='responseSchema', description='The JSON schema that the resume result payload must follow.', example='{"type":"object","properties":{"region":{"type":"string"}},"required":["region"]}'),
                toolCallId?: string(name='toolCallId', description='The ID of the tool invocation associated with the interrupt.', example='tool_call_example_001'),
              }
            ](name='interrupts', description='The list of historical interrupts.'),
            type?: string(name='type', description='The type of the interrupt result. The value is fixed to `interrupt`.', example='interrupt'),
          }(name='interruptOutcome', description='The result information of historical interrupts.'),
          metadata?: map[string]any(name='metadata', description='The extended metadata of the message.', example='{}'),
          name?: string(name='name', description='The name of the message sender.', example='example-user'),
          resumeInput?: {
            resolvedAt?: string(name='resolvedAt', description='The time when the interrupt processing was completed, in RFC 3339 format.', example='2026-01-01T00:01:00Z'),
            resume?: [ 
              {
                interruptId?: string(name='interruptId', description='The ID of the processed interrupt.', example='interrupt_example_001'),
                payload?: any(name='payload', description='The processing result for the corresponding interrupt, which must comply with the responseSchema of the interrupt.', example='{"region":"cn-hangzhou"}'),
                status?: string(name='status', description='The response method for the current interrupt. Valid values: `resolved` (the answer, confirmation, or tool result required by the interrupt has been submitted, including the `payload`) and `cancelled` (the interrupt has been canceled, excluding the `payload`).', example='resolved'),
              }
            ](name='resume', description='The submitted processing results for each interrupt.'),
            runId?: string(name='runId', description='The ID of the original run that was resumed.', example='run_example_001'),
            source?: string(name='source', description='The source of the resume request. Valid values: `USER` (submitted by a user) and `INTERNAL` (submitted by an internal process).', example='USER'),
          }(name='resumeInput', description='The resume input corresponding to the historical interrupt.'),
          role?: string(name='role', description='The role of the message. Valid values: `user` (user message), `assistant` (assistant message), `tool` (tool result), `activity` (activity message), `reasoning` (reasoning message), and `interrupt` (interrupt record).', example='user'),
          toolCallId?: string(name='toolCallId', description='The ID of the tool invocation associated with the tool result.', example='tool_call_example_001'),
          toolCalls?: [ 
            {
              encryptedValue?: string(name='encryptedValue', description='The encrypted content of the tool invocation. The example is only a placeholder value.', example='EXAMPLE_ENCRYPTED_VALUE'),
              function?: {
                arguments?: string(name='arguments', description='The tool parameters in the form of a JSON string.', example='{"keyword":"example"}'),
                name?: string(name='name', description='The name of the function or tool.', example='lookup_example'),
              }(name='function', description='The information about the function to be executed.'),
              id?: string(name='id', description='The tool invocation ID.', example='tool_call_example_001'),
              metadata?: map[string]any(name='metadata', description='The extended metadata of the tool invocation.', example='{}'),
              type?: string(name='type', description='The type of the tool invocation. The value is fixed to `function`.', example='function'),
            }
          ](name='toolCalls', description='The list of tool invocations initiated by the agent.'),
        }(name='message', description='The message object. Different message types are distinguished by role, and each type uses the corresponding fields.'),
        runId?: string(name='runId', description='The ID of the run to which the message belongs.', example='run_example_001'),
      }
    ](name='timeline', description='The message records returned in a timeline.'),
    total?: int32(name='total', description='The number of timeline records on the current page, which is equal to the length of the timeline array.', example='1'),
  }(name='data', description='The message history and pagination information.'),
  requestId?: string(name='requestId', description='The request ID, which is used to locate and troubleshoot issues.', example='00000000-0000-4000-8000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request is successful. A value of true indicates success.', example='true'),
