            approvalUrl?: string(name='approvalUrl', description='The approval URL.', example='https://example.com/approvals/approval_example_001'),
            cancellable?: boolean(name='cancellable', description='Indicates whether it can be canceled.', example='true'),
            changeDigest?: string(name='changeDigest', description='The change summary.', example='example-change-digest'),
            title?: string(name='title', description='The approval title.', example='Sample change approval'),
          }(name='data', description='The interrupt data.'),
          expiresAt?: string(name='expiresAt', description='The interrupt expiration time in ISO 8601 format.', example='2026-01-02T00:00:00Z'),
          id?: string(name='id', description='The interrupt ID.', example='interrupt_example_001'),
          message?: string(name='message', description='The interrupt message.', example='Specify the region of the target resource'),
          metadata?: map[string]any(name='metadata', description='The extended information.', example='{}'),
          reason?: string(name='reason', description='The interrupt reason. Valid values:
- `tool_call`: tool invocation requires handling
- `input_required`: user input is required
- `confirmation`: confirmation is required
- `out_of_band_approval`: waiting for out-of-band approval', example='input_required'),
          responseSchema?: map[string]any(name='responseSchema', description='The JSON schema that the payload must comply with when resuming this interrupt.', example='{"type":"object","properties":{"region":{"type":"string"}},"required":["region"]}'),
          toolCallId?: string(name='toolCallId', description='The tool invocation ID.', example='tool_call_example_001'),
        }
      ](name='interrupts', description='The interrupt list.'),
      type?: string(name='type', description='The result type. Valid values:
- `success`: successfully completed
- `interrupt`: waiting for interrupt handling', example='interrupt'),
    }(name='outcome', description='The run outcome.'),
    runId?: string(name='runId', description='The run ID.', example='run_example_001'),
    sessionId?: string(name='sessionId', description='The session ID.', example='session_example_001'),
    status?: string(name='status', description='The run status. Valid values:
- `PENDING`: pending execution
- `RUNNING`: running
- `WAITING_USER`: waiting for interrupt handling
- `COMPLETED`: completed
- `FAILED`: failed
- `CANCELLED`: canceled
- `REJECTED`: rejected', example='COMPLETED'),
    updatedAt?: string(name='updatedAt', description='The last update time of the run in ISO 8601 format.', example='2026-01-01T00:01:00Z'),
  }(name='data', description='The returned data.'),
  requestId?: string(name='requestId', description='The request ID.', example='00000000-0000-4000-8000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request is successful.', example='true'),
}

