model SendMessageRequest {
  sessionId: string(name='sessionId', description='The ID of the target session to which the message is sent or the run is resumed.

This parameter is required.', example='session_example_001', position='Path'),
  xOpenAgentIdempotencyKey?: string(name='X-OpenAgent-Idempotency-Key', description='The idempotency key for the request. Use the same key and the same business parameters when retrying the same request.', example='send-message-example-001', position='Header'),
  content?: string(name='content', description='The message text in MESSAGE mode. This parameter cannot be empty. The type can be omitted in this mode.', example='Query the status of the sample resource without making any changes', minLength=1, position='Body'),
  resume?: [ 
    {
      interruptId?: string(name='interruptId', description='The ID of the interrupt to be replied to. Obtain this value from `data.outcome.interrupts[].id` in the SSE `RUN_FINISHED` event or `data.outcome.interrupts[].id` in the `GetRun` response.', example='interrupt_example_001'),
      payload?: any(name='payload', description='The interrupt handling result. This parameter is required when `status` is set to `resolved` and must conform to the `responseSchema` of the corresponding interrupt. Do not pass this parameter when `status` is set to `cancelled`.', example='{"region":"cn-hangzhou"}'),
      status?: string(name='status', description='The reply method for the current interrupt. `resolved` indicates that the answer, confirmation, or tool result required by the interrupt is submitted, and `payload` must be provided. `cancelled` indicates that the interrupt is canceled, and `payload` is not passed.', example='resolved'),
    }
