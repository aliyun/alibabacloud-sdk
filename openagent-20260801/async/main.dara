model ListMessagesRequest {
  sessionId: string(name='sessionId', description='The ID of the session for which to query the message history.

This parameter is required.', example='session_example_001', position='Path'),
  maxResults?: string(name='maxResults', description='The maximum number of timeline entries to return per page. The value must be a positive integer.', example='20', position='Query'),
  nextToken?: string(name='nextToken', description='The pagination token. Do not specify this parameter for the first request. For subsequent requests, use the value returned from the previous page.', example='example-next-token', position='Query'),
  runId?: string(name='runId', description='Filters messages by the specified run ID.', example='run_example_001', position='Query'),
}

