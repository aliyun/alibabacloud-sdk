model SendMessageRequest {
  sessionId: string(name='sessionId', description='The ID of the target session for sending a message or resuming a run.

This parameter is required.', example='session_example_001', position='Path'),
  xOpenAgentIdempotencyKey?: string(name='X-OpenAgent-Idempotency-Key', description='The idempotency key for the request. Use the same key and the same business parameters when retrying the same request.', example='send-message-example-001', position='Header'),
  attachments?: [ 
    {
      fileExtension?: string(name='fileExtension', description='The file name extension.', example='xlsx'),
      fileId?: string(name='fileId', description='The ID of the file after it is uploaded.', example='att_12345678'),
      sourceName?: string(name='sourceName', description='The original name of the file.', example='file.xlsx'),
      workspacePath?: string(name='workspacePath', description='The workspace path.', example='source/att_12345678.xlsx'),
    }
  ](name='attachments', description='The list of attachments.', example='[]', position='Body'),
  content?: string(name='content', description='The message text in MESSAGE mode. This parameter cannot be empty. The type parameter can be omitted in this mode.', example='Query the status of the sample resource without making changes', position='Body'),
  resume?: [ 
    {
      interruptId?: string(name='interruptId', description='The ID of the interrupt to be replied to. Obtain this value from data.outcome.interrupts[].id in the SSE RUN_FINISHED event or the GetRun response.', example='interrupt_example_001'),
      payload?: any(name='payload', description='The interrupt handling result. This parameter is required when status is set to resolved and must conform to the responseSchema of the corresponding interrupt. Do not pass this parameter when status is set to cancelled.', example='{"region":"cn-hangzhou"}'),
      status?: string(name='status', description='The reply method for the interrupt. Valid values: resolved (submits the answer, confirmation, or tool result required by the interrupt, and must include payload) and cancelled (cancels the interrupt without passing payload).', example='resolved'),
