This parameter is required.', example='run_example_001', position='Path'),
}

model GetRunResponseBody = {
  data?: {
    createdAt?: string(name='createdAt', description='The run creation time in ISO 8601 format.', example='2026-01-01T00:00:00Z'),
    outcome?: {
      interrupts?: [ 
        {
          data?: {
            apiCalls?: [ 
              {
                action?: string(name='action', description='The API name.', example='ExampleAction'),
                description?: string(name='description', description='The operation description.', example='Perform changes on the sample resource'),
