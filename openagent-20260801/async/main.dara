extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'OpenAgent';
  @version = '2026-08-01';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model CancelRunRequest {
  sessionId: string(name='sessionId', description='The session ID.

This parameter is required.', example='session_example_001', position='Path'),
  runId: string(name='runId', description='The run ID.

This parameter is required.', example='run_example_001', position='Path'),
  xOpenAgentIdempotencyKey?: string(name='X-OpenAgent-Idempotency-Key', description='The idempotency key of the request. Use the same value and the same business parameters when retrying the same cancellation request.', example='cancel-example-001', position='Header'),
  reason?: string(name='reason', description='The reason for the cancellation. The value must be 1 to 1,024 characters in length.', example='The user manually canceled this task', minLength=1, maxLength=1024, position='Body'),
}

model CancelRunResponseBody = {
  data?: {
    runId?: string(name='runId', description='The run ID.', example='run_example_001'),
    status?: string(name='status', description='The run status. If the cancellation is successful, the value is fixed to `CANCELLED`.', example='CANCELLED'),
  }(name='data', description='The returned data.'),
  requestId?: string(name='requestId', description='The request ID.', example='00000000-0000-4000-8000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request is successful.', example='true'),
}

model CancelRunResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CancelRunResponseBody(name='body'),
}

/**
  * @description Cancels a specified run and returns the run status after the cancellation.
  * @param request  the request parameters of CancelRun  CancelRunRequest
  * @return CancelRunResponse
 */
async function cancelRun(request: CancelRunRequest): CancelRunResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CancelRun', 'POST', '/openapi/v1/agent/sessions/{sessionId}/runs/{runId}/cancel', 'json', false, 'json', request);
}

model CreateSessionRequest {
