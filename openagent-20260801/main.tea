/**
 *
 */
import Util;
import OpenApi;
import OpenApiUtil;
import EndpointUtil;

extends OpenApi;


init(config: OpenApi.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('openagent', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!Util.empty(endpoint)) {
    return endpoint;
  }
  
  if (!Util.isUnset(endpointMap) && !Util.empty(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return EndpointUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CancelRunHeaders {
  commonHeaders?: map[string]string,
  xOpenAgentIdempotencyKey?: string(name='X-OpenAgent-Idempotency-Key', description='The idempotency key of the request. Use the same value and the same business parameters when retrying the same cancellation request.', example='cancel-example-001'),
}

model CancelRunRequest {
  reason?: string(name='reason', description='The reason for the cancellation. The value must be 1 to 1,024 characters in length.', example='The user manually canceled this task'),
}

model CancelRunResponseBody = {
  data?: {
    runId?: string(name='runId', description='The run ID.', example='run_example_001'),
    status?: string(name='status', description='The run status. If the cancellation is successful, the value is fixed to `CANCELLED`.', example='CANCELLED'),
  }(name='data', description='The returned data.'),
  requestId?: string(name='requestId', description='The request ID.', example='00000000-0000-4000-8000-000000000001'),
  success?: boolean(name='success', description='Indicates whether the request is successful.', example='true'),
}

model CancelRunResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CancelRunResponseBody(name='body'),
}

/**
 * @summary Cancels a run.
 *
 * @description Cancels a specified run and returns the run status after the cancellation.
 *
 * @param request CancelRunRequest
 * @param headers CancelRunHeaders
 * @param runtime runtime options for this request RuntimeOptions
 * @return CancelRunResponse
 */
async function cancelRunWithOptions(sessionId: string, runId: string, request: CancelRunRequest, headers: CancelRunHeaders, runtime: Util.RuntimeOptions): CancelRunResponse {
  Util.validateModel(request);
  var body : map[string]any = {};
  if (!Util.isUnset(request.reason)) {
    body['reason'] = request.reason;
  }

  var realHeaders : map[string]string = {};
  if (!Util.isUnset(headers.commonHeaders)) {
    realHeaders = headers.commonHeaders;
  }
  if (!Util.isUnset(headers.xOpenAgentIdempotencyKey)) {
    realHeaders['X-OpenAgent-Idempotency-Key'] = Util.toJSONString(headers.xOpenAgentIdempotencyKey);
  }
  var req = new OpenApi.OpenApiRequest{ 
    headers = realHeaders,
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApi.Params{
    action = 'CancelRun',
    version = '2026-08-01',
    protocol = 'HTTPS',
    pathname = `/openapi/v1/agent/sessions/${OpenApiUtil.getEncodeParam(sessionId)}/runs/${OpenApiUtil.getEncodeParam(runId)}/cancel`,
    method = 'POST',
    authType = 'AK',
    style = 'ROA',
    reqBodyType = 'json',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Cancels a run.
 *
 * @description Cancels a specified run and returns the run status after the cancellation.
 *
 * @param request CancelRunRequest
 * @return CancelRunResponse
 */
async function cancelRun(sessionId: string, runId: string, request: CancelRunRequest): CancelRunResponse {
  var runtime = new Util.RuntimeOptions{};
  var headers = new CancelRunHeaders{};
  return cancelRunWithOptions(sessionId, runId, request, headers, runtime);
}

