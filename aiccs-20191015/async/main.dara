model AiccsSmartCallRequest {
  actionCodeBreak?: boolean(name='ActionCodeBreak', description='Specifies whether the opening audio file can be interrupted. Default value: **true**, which indicates that the opening audio file can be interrupted.', example='true', position='Query'),
  actionCodeTimeBreak?: int32(name='ActionCodeTimeBreak', description='The interruption threshold based on the duration of continuous user speech. This parameter takes effect only when ActionCodeBreak is set to **true**. Unit: milliseconds.', example='120', position='Query'),
  asrAlsAmId?: string(name='AsrAlsAmId', description='The acoustic model ID.', example='23387****', position='Query'),
  asrBaseId?: string(name='AsrBaseId', description='The ASR foundation model.

- **customer_service_8k**: Mandarin.
- **dialect_customer_service_8k**: Heavy accent.

> - When calling the **SendCcoSmartCall** operation, specify the ASR model to use. Specify either **asrModelId** or **AsrBaseId**.
- If only **asrModelId** is set, the specified ASR model is used.
- If only **AsrBaseId** is set, the specified ASR foundation model is used.
- If neither is set, the default ASR foundation model is used. The default value of **AsrBaseId** is **customer_service_8k**, which indicates the Mandarin ASR foundation model.
- If both are set, make sure they correspond correctly.', example='customer_service_8k', position='Query'),
  asrModelId?: string(name='AsrModelId', description='The ASR model ID. View the ASR model ID on the [ASR Model Management page](https://aiccs.console.aliyun.com/sentence/model/private?spm=a2c4g.11186623.0.0.7f9b2964fYSGv4).', example='bf71664d30d2478fb8cb8c39c6b6****', position='Query'),
  asrVocabularyId?: string(name='AsrVocabularyId', description='The hot word ID. View the ASR hot word ID on the [ASR Hot Word Management page](https://aiccs.console.aliyun.com/sentence/vocab?spm=a2c4g.11186623.0.0.7f9bf965IKBpsi).', example='6689****', position='Query'),
  backgroundFileCode?: string(name='BackgroundFileCode', description='The ID of the background audio file played during the conversation between the user and the robot.

Log on to the [Artificial Intelligence Cloud Call Service console](https://aiccs.console.aliyun.com/overview), choose **Intelligent Interaction > Voice File Management**, and click **Details** to view the corresponding voice ID.', example='2d4c-4e78-8d2a-afbb06cf****.wav', position='Query'),
  backgroundSpeed?: int32(name='BackgroundSpeed', description='This parameter is not supported.', example='1', position='Query'),
  backgroundVolume?: int32(name='BackgroundVolume', description='This parameter is not supported.', example='1', minimum=-4, maximum=4, position='Query'),
  calledNumber: string(name='CalledNumber', description='The called number. Only numbers in the Chinese mainland are supported.

This parameter is required.', example='1862222****', position='Query'),
  calledShowNumber: string(name='CalledShowNumber', description='The China-based number displayed to the called party. The number must be a purchased number.

You can log on to the [Contact Center console](https://aiccs.console.aliyun.com/overview?spm=a2c4g.11186623.0.0.7f9bf9658X6jte) to view purchased numbers.

This parameter is required.', example='0571000****', position='Query'),
  dynamicId?: string(name='DynamicId', description='The dynamic extension ID reserved for the caller. This ID is returned in the callback URL for the caller\\\\"s development identifier.', example='2234****', position='Query'),
  earlyMediaAsr?: boolean(name='EarlyMediaAsr', description='The early media speech recognition flag. If set to **true**, the reason for unanswered calls is recorded. Default value: **false**, which indicates that this feature is disabled.

> To enable early media speech recognition, manually set this parameter to **true**.', example='false', position='Query'),
  enableITN?: boolean(name='EnableITN', description='Specifies whether to perform Inverse Text Normalization (ITN) in post-processing.

> If set to **true**, Chinese numerals are converted to Arabic numerals in the output. Default value: **false**.', example='true', position='Query'),
  muteTime?: int32(name='MuteTime', description='The silence duration. Specifies how long the user remains silent before the call ends. Unit: milliseconds. Valid values: **1000** to **20000**.

- If the specified value is not within the valid range, the default value of MuteTime is **10000**.
- This parameter can be dynamically set during the call. The last setting takes effect.', example='10000', position='Query'),
  outId?: string(name='OutId', description='The ID reserved for the caller. This ID is returned to the caller in the receipt message.
The value is a string of 1 to 15 bytes in length.', example='222356****', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  pauseTime?: int32(name='PauseTime', description='The pause duration. Specifies how long the user pauses before a sentence is considered complete. Unit: milliseconds. Valid values: **300** to **1200**.

- If the specified value is not within the valid range, the default value of PauseTime is **800**.
- Only the initial setting takes effect. Subsequent settings are ignored.', example='800', position='Query'),
  playTimes?: int32(name='PlayTimes', description='This parameter is not supported.', example='1', position='Query'),
  prodCode?: string(name='ProdCode', description='The product name. Default value: **aiccs**.', example='aiccs', position='Query'),
  recordFlag?: boolean(name='RecordFlag', description='Specifies whether to record the call.', example='true', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  sessionTimeout?: int32(name='SessionTimeout', description='The maximum call duration. Unit: seconds. The call is automatically hung up after the timeout period.', example='120', position='Query'),
  speed?: int32(name='Speed', description='This parameter is not supported.', example='1', position='Query'),
  ttsConf?: boolean(name='TtsConf', description='Specifies whether to configure TTS voice parameters.
- true: Configure the voice style by using the TtsStyle, TtsColume, and TtsSpeed parameters.
- false: No configuration is required. Even if these parameters are set, they do not take effect.', example='true', position='Query'),
  ttsSpeed?: int32(name='TtsSpeed', description='The speech speed for TTS variable playback. Valid values: **-200** to **200**. Default value: **0**.', example='100', position='Query'),
  ttsStyle?: string(name='TtsStyle', description='The voice style for TTS variable playback. Default value: **xiaoyun**. For specific styles, refer to the voice style list.', example='xiaoyun', position='Query'),
  ttsVolume?: int32(name='TtsVolume', description='The volume for TTS variable playback. Valid values: **0** to **100**. Default value: **0**.', example='10', position='Query'),
  voiceCode: string(name='VoiceCode', description='The intelligent outbound call audio file. Network files and text-to-speech (TTS) are supported. You can mix multiple files and TTS parameters, separated by commas (,). The replacement values for TTS parameters are specified in **VoiceCodeParam**.

- If the audio file is a network file, set VoiceCode to a URL of the audio file that allows public network access. Use a WAV format audio file with a sampling frequency of 8000 Hz or 16000 Hz.
- If the audio file uses TTS, set VoiceCode to a variable name such as $name$, and set the corresponding content for the variable in VoiceCodeParam.

This parameter is required.', example='2d4c-4e78-8d2a-afbb06cf****.wav,$name$', position='Query'),
  voiceCodeParam?: string(name='VoiceCodeParam', description='The TTS parameter string in JSON format. This parameter must correspond to the TTS parameters in VoiceCode.', example='"{\\\\"name\\\\":\\\\"Hello\\\\"}"', position='Query'),
  volume?: int32(name='Volume', description='The volume for playing user audio. Valid values: **-4** to **4**. Set this parameter to **1**.', example='1', position='Query'),
}

model AiccsSmartCallResponseBody = {
  code?: string(name='Code', description='The unique receipt ID for this call.', example='116012854210^10281427****'),
  data?: string(name='Data', description='The request status code. OK indicates that the request was successful.', example='OK'),
  message?: string(name='Message', description='The description of the status code.', example='OK'),
  requestId?: string(name='RequestId', description='The request ID.', example='A90E4451-FED7-49D2-87C8-00700A8C4D0D'),
}

model AiccsSmartCallResponse = {
