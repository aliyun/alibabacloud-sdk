}

model AddModelApplicationRequest {
  applicationCps: long(name='ApplicationCps', description='The number of concurrent requests for the application.

This parameter is required.', example='25', position='Query'),
  applicationName: string(name='ApplicationName', description='The name of the model application.

This parameter is required.', example='TestApplication', position='Query'),
  callConnectedTriggerModel?: boolean(name='CallConnectedTriggerModel', description='Specifies whether to enable call-connected event push. Disabled by default.', example='false', position='Query'),
  dyvmsSceneName?: string(name='DyvmsSceneName', description='The scenario name.', example='TestScenario', position='Query'),
  modelCode: string(name='ModelCode', description='The model code.

This parameter is required.', example='1234', position='Query'),
  modelVersion?: string(name='ModelVersion', description='The model version.', example='1', position='Query'),
  muteActive?: boolean(name='MuteActive', description='Specifies whether the first mute event triggers the model.', example='false', position='Query'),
  muteDuration?: long(name='MuteDuration', description='The mute duration.', example='70', position='Query'),
  muteHangupNum?: long(name='MuteHangupNum', description='The number of consecutive mute events before the system proactively hangs up the call.', example='5', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  prompt?: string(name='Prompt', description='The prompt.', example='Test prompt', position='Query'),
  qualificationId?: long(name='QualificationId', description='The qualification ID.', example='85', position='Query'),
  qualificationName?: string(name='QualificationName', description='The qualification name.', example='TestQualification', position='Query'),
  recordingFile?: string(name='RecordingFile', description='The URL of the recorded audio file for the opening statement. This parameter is required when the opening statement type is set to 1.', example='https://xxxxxxxx.wav', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  source?: string(name='Source', description='The source. Fixed value: USER.', example='USER', position='Query'),
  speechContent?: string(name='SpeechContent', description='The speech script content.', example='Test speech script', position='Query'),
  speechId?: long(name='SpeechId', description='The speech script ID.', example='88', position='Query'),
  startWord: string(name='StartWord', description='The opening statement.

This parameter is required.', example='Hello, this is an opening statement', position='Query'),
  startWordType?: long(name='StartWordType', description='The type of the opening statement.', example='0', position='Query'),
  ttsConfig: {
    backgroundEnabled?: boolean(name='BackgroundEnabled', description='Specifies whether to enable background sound.', example='true'),
    backgroundSound?: long(name='BackgroundSound', description='The background sound ID.', example='111'),
    backgroundVolume?: long(name='BackgroundVolume', description='The background sound volume.', example='1'),
    customerAccountId?: long(name='CustomerAccountId', description='The account ID.', example='45'),
    mixingEnabled?: boolean(name='MixingEnabled', description='Specifies whether to enable audio mixing.', example='true'),
    mixingTemplate?: long(name='MixingTemplate', description='The mixing template ID.', example='111'),
    resourceId?: string(name='ResourceId', description='The resource ID.', example='example'),
    ttsSpeed?: long(name='TtsSpeed', description='The speed for TTS variable playback. Valid values: -200 to 200. Default value: 0.', example='13'),
    ttsStyle?: string(name='TtsStyle', description='The voice style.', example='龙小夏'),
    ttsVolume?: long(name='TtsVolume', description='The volume for TTS variable playback. Valid values: 0 to 100. Default value: 0.', example='55'),
    voiceCode?: string(name='VoiceCode', description='The voice code.', example='ddddfd'),
    voiceType?: string(name='VoiceType', description='The voice type. Valid values:

- SYSTEM: system voice.
- COSYCLONE: cloned voice.
- BL-CUSTOM: custom premium cloned voice.', example='SYSTEM'),
  }(name='TtsConfig', description='The text-to-speech (TTS) configuration, including voice, volume, and speed.

This parameter is required.', shrink='json', position='Query'),
  usageDesc?: string(name='UsageDesc', description='The usage description.', example='TestUsage', position='Query'),
}

