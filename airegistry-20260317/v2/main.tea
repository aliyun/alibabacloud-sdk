import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('airegistry', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model DataResourceValue = {
  name?: string(name='Name', description='The resource name (including the file name extension).', example='sample.md'),
  type?: string(name='Type', description='The resource type: template, data, script, etc.', example='script'),
  content?: string(name='Content', description='The resource content.', example='This is a sample file.'),
  metadata?: map[string]any(name='Metadata', description='The resource metadata.'),
}

model CreateNamespaceRequest {
  description?: string(name='Description', description='The workspace description.', example='用于管理客服场景的Prompt'),
  name?: string(name='Name', description='The workspace name.', example='我的Prompt空间'),
  scanPolicy?: string(name='ScanPolicy', description='The scan policy.

This parameter contains two configuration items:
- minBlockRiskLevel: the risk level for blocking.
  - high: blocks high-risk items.
  - medium: blocks medium-risk and high-risk items.
  - low: blocks all risk levels including high, medium, and low.
- maxSkipRatio: the max false positive rate. If the scan skip ratio exceeds this value, the scan is considered as failed.', example='{"minBlockRiskLevel":"medium","maxSkipRatio":0.2}'),
  tags?: string(name='Tags', description='The tags. Separate multiple tags with commas.', example='customer-service,production'),
}

model CreateNamespaceResponseBody = {
  data?: {
    namespaceId?: string(name='NamespaceId', description='The namespace ID. The default namespace cannot be queried, modified, or deleted.', example='a2a9310a-9d91-4283-b4e2-844f6d45fe64'),
  }(name='Data', description='The namespace creation result.'),
  requestId?: string(name='RequestId', description='The request ID.', example='D9E87E66-9EF0-5C10-A5E6-924020A0C9B7'),
}

model CreateNamespaceResponse = {
