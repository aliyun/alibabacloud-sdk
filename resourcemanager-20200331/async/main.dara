model CreateCloudAccountRequest {
  displayName: string(name='DisplayName', description='The member name.

The name must be 2 to 50 characters in length and can contain letters, digits, underscores (_), periods (.), and hyphens (-).

The member name must be unique within the resource directory.

This parameter is required.', example='admin-****', position='Query'),
  email: string(name='Email', description='The email address used to log on to the cloud account.

This parameter is required.', example='someone@example.com', position='Query'),
  parentFolderId?: string(name='ParentFolderId', description='The ID of the parent folder.', example='fd-bVaRIG****', position='Query'),
  payerAccountId?: string(name='PayerAccountId', description='The ID of the settlement account. If this parameter is left empty, the current account is used for settlement.', example='12323344****', position='Query'),
}

model CreateCloudAccountResponseBody = {
  account?: {
    accountId?: string(name='AccountId', description='The account ID.', example='12323344****'),
    accountName?: string(name='AccountName', description='The account name.', example='someone@example.com'),
    displayName?: string(name='DisplayName', description='The member name.', example='admin-****'),
    folderId?: string(name='FolderId', description='The folder ID.', example='fd-bVaRIG****'),
    joinMethod?: string(name='JoinMethod', description='The method used by the member to join the resource directory. Valid values:

- invited: The member is invited to join.
- created: The member is created in the resource directory.', example='created'),
    modifyTime?: string(name='ModifyTime', description='The time when the member was last modified. The time is displayed in UTC, as specified by RFC 3339, with Z indicating UTC.', example='2015-01-23T12:33:18Z'),
    recordId?: string(name='RecordId', description='The account record ID.', example='06950264-3f0d-4ca9-82dd-6ee7a3d3****'),
    resourceDirectoryId?: string(name='ResourceDirectoryId', description='The resource directory ID.', example='rd-k3****'),
    status?: string(name='Status', description='The status of the member. Valid values:

- CreateSuccess: The member is created.
- CreateVerifying: The creation is being confirmed.
- CreateFailed: The member failed to be created.
- CreateExpired: The creation has expired.
- CreateCancelled: The creation is canceled.
- PromoteVerifying: The upgrade is being confirmed.
- PromoteFailed: The member failed to be upgraded.
- PromoteExpired: The upgrade has expired.
- PromoteCancelled: The upgrade is canceled.
- PromoteSuccess: The member is upgraded.
- InviteSuccess: The member is invited.
- Removed: The member is removed.', example='CreateVerifying'),
    type?: string(name='Type', description='The member type. The value CloudAccount indicates a cloud account.', example='CloudAccount'),
  }(name='Account', description='The member information.'),
  requestId?: string(name='RequestId', description='The request ID.', example='9B34724D-54B0-4A51-B34D-4512372FE1BE'),
}

model CreateCloudAccountResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateCloudAccountResponseBody(name='body'),
}

/**
  * @description A resource directory contains two types of members: resource accounts and cloud accounts. 
  * - Resource account (recommended): A resource account serves only as a resource container and fully depends on the resource directory. It is a more secure account type that is easier to create. To create a resource account type member, see [CreateResourceAccount](https://help.aliyun.com/document_detail/159392.html). 
  * > A resource account can also be upgraded to a cloud account. For more information, see [PromoteResourceAccount](https://help.aliyun.com/document_detail/159395.html).
  * - Cloud account: A cloud account has all the features of an Alibaba Cloud account, including root logon access.
  * @param request  the request parameters of CreateCloudAccount  CreateCloudAccountRequest
  * @return CreateCloudAccountResponse
 */
async function createCloudAccount(request: CreateCloudAccountRequest): CreateCloudAccountResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'CreateCloudAccount', 'POST', '/', 'json', false, 'json', request);
}

model CreateControlPolicyRequest {
  description?: string(name='Description', description='The description of the control policy.

The description must be 1 to 1024 characters in length, must start with a letter, and can contain letters, digits, underscores (_), and hyphens (-).', example='ExampleControlPolicy', position='Query'),
  effectScope: string(name='EffectScope', description='The effective scope of the control policy.

Valid values: RAM, which indicates that the control policy takes effect only for Resource Access Management (RAM) users or RAM roles.

This parameter is required.', example='RAM', position='Query'),
  policyDocument: string(name='PolicyDocument', description='The content of the control policy.

The maximum length is 4096 characters.

For information about the control policy language, see [Control policy language](https://help.aliyun.com/document_detail/179096.html).

For examples of control policies, see [Examples of custom control policies](https://help.aliyun.com/document_detail/181474.html).

