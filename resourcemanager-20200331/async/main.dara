      autoGroupingScopeCondition?: string(name='AutoGroupingScopeCondition', description='The scope condition for automatic allocation. Specifies the scope of resources to be automatically allocated.', example='{"children":[{"desired":"{\\\\"env\\\\":\\\\"online\\\\", \\\\"project\\\\":\\\\"A\\\\"}","featurePath":"$.tags","featureSource":"RESOURCE","operator":"TagMatchAll"}],"operator":"and"}', maxLength=50000),
      targetResourceGroupCondition: string(name='TargetResourceGroupCondition', description='The target resource group condition. Specifies the target resource group for automatic allocation.

This parameter is required.', example='{"children":[{"desired":"rg-aek2********qcy","featurePath":"$.resourceGroupId","featureSource":"RESOURCE","operator":"StringEquals"}],"operator":"and"}', maxLength=255),
    }
  ](name='RuleContents', description='The list of rule content entries.

This parameter is required.', position='Query'),
