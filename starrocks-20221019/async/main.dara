  success?: boolean(name='Success', description='Indicates whether the request succeeded.', example='false'),
}

model AddGatewayResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddGatewayResponseBody(name='body'),
}

/**
  * @description The AddGateway operation requires software stack version 1.7.6 or later and at least three front-end (FE) nodes.
  * @param request  the request parameters of AddGateway  AddGatewayRequest
  * @return AddGatewayResponse
 */
async function addGateway(request: AddGatewayRequest): AddGatewayResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddGateway', 'POST', '/webapi/gateway/add', 'json', false, 'json', request);
}

