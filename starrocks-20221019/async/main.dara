model CreateScalingRuleRequest {
  instanceId?: string(name='InstanceId', description='The instance ID.', example='c-b25e21e24388****', position='Query'),
  nodeGroupId: string(name='NodeGroupId', description='The compute group ID.

This parameter is required.', example='ng-3d5ce6454354****', position='Query'),
  rule: string(name='Rule', description='The rule content.

This parameter is required.', example='{
  "nodeNumber": 1,
  "scalingRuleName": "test1",
  "scalingOutRule": {
    "year": 2026,
    "month": 3,
    "day": 2,
    "hour": 5,
    "minute": 50,
    "second": 0,
    "recurrenceInterval": 1,
    "recurrenceType": "DAILY",
    "recurrenceValues": null
  },
  "scalingInRule": {
    "year": 2026,
    "month": 3,
    "day": 2,
