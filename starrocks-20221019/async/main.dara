import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'starrocks';
  @version = '2022-10-19';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model InstanceConfigDto {
  configKey?: string(name='configKey', description='The configuration item name.', example='storage_root_path'),
  configType?: string(name='configType', description='The configuration type.', example='BE'),
  configValue?: string(name='configValue', description='The configuration item value.', example='value1'),
  nodeGroupId?: string(name='nodeGroupId', description='The compute group ID, which is required only when the parameter is exclusive to the compute group. In other scenarios, leave it empty or set it to the cluster ID.', example='ng-e24924dxxxxx'),
}

model ResourceSpec {
  cu?: int32(name='cu', description='The number of CUs. A compute unit (CU) is the basic metering unit of a service. 1 CU = 1 CPU core + 4 GiB of memory.', example='3'),
  diskNumber?: int32(name='diskNumber', description='The number of disk blocks.', example='1'),
  localStorageInstanceType?: string(name='localStorageInstanceType', description='Local SSD Instance Specification for the node group. This parameter is applicable only when the node group is based on ECS instances and the SpecType is set to \\\\"Local SSD / Large-capacity Storage\\\\"', example='local_ssd_4_4xlarge'),
  nodeNumber?: int32(name='nodeNumber', description='The number of nodes.', example='3'),
  specType?: string(name='specType', description='The type of the node group. The following types are included:

*   standard, Standard Edition, ECS + cloud disk.
*   localSSD , local SSD.
*   bigData, which stores large specifications.', example='standard'),
  storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level of the disks. Valid values:

*   PL0: A single disk can achieve up to 10,000 random read/write IOPS.
*   PL1: A single disk can achieve up to 50,000 random read/write IOPS.
*   PL2: A single disk can achieve up to 100,000 random read/write IOPS.
*   PL3: A single disk can achieve up to 1 million random read/write IOPS.', example='pl1'),
  storageSize?: int32(name='storageSize', description='The storage size.', example='100'),
}

model AddBackupPolicyRequest {
  regionId?: string(name='RegionId', position='Host'),
  expireDays?: int32(name='ExpireDays', description='The number of days that the backup data remains valid.', example='7', position='Body'),
  hour?: int32(name='Hour', description='The hour.', example='2', minimum=0, maximum=23, position='Body'),
  instanceId?: string(name='InstanceId', description='The instance ID.', example='c-0104730e9de40215', position='Body'),
  minute?: int32(name='Minute', description='The minute.', example='30', minimum=0, maximum=59, position='Body'),
  recurrenceType?: string(name='RecurrenceType', description='Specifies the execution type of the time rule. Valid values:
- DAILY: Repeats daily.
- WEEKLY: Repeats weekly.
- MONTHLY: Repeats monthly.', example='MONTHLY', position='Body'),
  recurrenceValues?: [ int32 ](name='RecurrenceValues', description='The values for the policy execution cycle.', position='Body'),
  timeoutSeconds?: int32(name='TimeoutSeconds', description='The timeout period for the backup task, in seconds.', example='3600', position='Body'),
}

model AddBackupPolicyResponseBody = {
  accessDeniedDetail?: string(name='AccessDeniedDetail', description='AccessDeniedDetail', example='{     "PolicyType": "AccountLevelIdentityBasedPolicy",     "AuthPrincipalOwnerId": "xxx",     "EncodedDiagnosticMessage": "xxx",     "AuthPrincipalType": "xxx",     "AuthPrincipalDisplayName": "xxx",     "NoPermissionType": "ImplicitDeny",     "AuthAction": "sr:xxx"   }'),
  data?: boolean(name='Data', description='The returned result.', example='true'),
  errCode?: string(name='ErrCode', description='The error code.', example='InvalidParams'),
  errMessage?: string(name='ErrMessage', description='The error message.', example='Invalid params: [Region id should be select from set [cn-beijing, cn-hangzhou]]'),
  httpStatusCode?: int32(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  requestId?: string(name='RequestId', description='The request ID.', example='32A44F0D-BFF6-5664-999A-218BBDE7****'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='false'),
}

model AddBackupPolicyResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddBackupPolicyResponseBody(name='body'),
}

/**
  * @param request  the request parameters of AddBackupPolicy  AddBackupPolicyRequest
  * @return AddBackupPolicyResponse
 */
async function addBackupPolicy(request: AddBackupPolicyRequest): AddBackupPolicyResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'AddBackupPolicy', 'POST', '/webapi/backupRestore/policy/add', 'json', false, 'json', request);
}

model AddGatewayRequest {
  regionId?: string(name='RegionId', position='Host'),
  feNodeNumber?: int32(name='FeNodeNumber', description='The number of gateway nodes.', example='3', position='Query'),
  gatewayName?: string(name='GatewayName', description='The alias for the private gateway.', example='eas_automation_test', position='Query'),
  instanceId?: string(name='InstanceId', description='The ID of the instance.', example='c-b25e21e24388****', position='Query'),
}

model AddGatewayResponseBody = {
