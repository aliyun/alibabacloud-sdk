      cu?: int32(name='cu', description='The number of compute units (CUs). A CU is the basic metering unit of the service. 1 CU equals 1 vCPU and 4 GiB of memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1'),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The instance specification for local SSDs. You do not need to specify this parameter for the Observer compute group.', example='null'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the compute group. Only standard is supported.', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Only PL1 is supported, which delivers up to 50,000 random read/write IOPS per disk.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='ObserverNodeGroups', description='The information about the Observer compute group. Specify this parameter only when you need to enable multi-zone disaster recovery. The configuration of the Observer compute group must be consistent with the specifications of the FE node group.', position='Body'),
  ossAccessingRoleName?: string(name='OssAccessingRoleName', description='The name of the role used for password-free access to OSS.', example='AliyunEMRStarRocksAccessingOSSRole', position='Body'),
  packageType: string(name='PackageType', description='The instance edition. Valid values:
<ul>
<li>trial: Trial Edition.</li>
<li>official: Standard Edition.</li>
</ul>

This parameter is required.', example='official', position='Body'),
  payType: string(name='PayType', description='The billing method of the instance. Valid values:
<ol>
<li>prePaid: subscription.</li>
<li>postPaid: pay-as-you-go.</li>
</ol>

This parameter is required.', example='prePaid', position='Body'),
  pricingCycle?: string(name='PricingCycle', description='The unit of the billing cycle. Valid values:
<ul>
<li>Month</li>
<li>Year</li>
</ul>
This parameter takes effect only when PayType is set to PrePaid.', example='Month', position='Body'),
  principalType?: string(name='PrincipalType', description='The RAM authentication type. A value of RS indicates a Resource Access Management (RAM) user, and a value of RR indicates a RAM role.', example='RR', position='Body'),
  promotionOptionNo?: string(name='PromotionOptionNo', description='The coupon ID.', example='165445235634', position='Body'),
  ramUserId?: string(name='RamUserId', description='The ID of the Resource Access Management (RAM) user or RAM role.', example='123456', position='Body'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-aekzllkih7jqxxx', position='Body'),
  runMode: string(name='RunMode', description='The run mode of the cluster. Valid values:
<ul>
<li>shared_nothing: shared-nothing architecture.</li>
<li>shared_data: shared-data architecture.</li>
</ul>

This parameter is required.', example='shared_data', position='Body'),
  tags?: [ 
    {
      key?: string(name='Key', description='The tag key.', example='k1'),
      value?: string(name='Value', description='The tag value.', example='v1'),
    }
  ](name='Tags', description='The tags of the instance.', position='Body'),
  vSwitches?: [ 
    {
      vswId: string(name='VswId', description='The vSwitch ID.

This parameter is required.', example='vsw-bp19mlh98tm9teyyd****'),
      zoneId?: string(name='ZoneId', description='The zone ID of the vSwitch.', example='cn-hangzhou-i'),
    }
  ](name='VSwitches', description='The vSwitch and zone information.', position='Body'),
  version: string(name='Version', description='The major version of the instance.

