    cu?: int32(name='cu', description='The number of compute units (CUs). A CU is the basic metering unit of the service. 1 CU equals 1 vCPU and 4 GiB of memory.', example='2'),
  }(name='AgentNodeGroup', description='The agent compute group.', position='Body'),
  autoPay?: boolean(name='AutoPay', description='Specifies whether automatic payment is enabled for all products specified in the Products parameter. Valid values:
- true: Enables automatic payment.
- false: Disables automatic payment.', example='false', position='Body'),
  autoRenew?: boolean(name='AutoRenew', description='Specifies whether to enable auto-renewal. This parameter takes effect only when PayType is set to PrePaid. Default value: false.', example='true', position='Body'),
  backendNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU equals 1 vCPU and 4 GiB of memory. If SpecType is set to the memory-enhanced instance family, 1 CU equals 1 vCPU and 8 GiB of memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1', minimum=0),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type of the node group. This parameter is valid only when the instance is based on ECS and SpecType is set to localSSD or bigData.', example='local_ssd_4_4xlarge'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The instance family category of the compute group. Valid values:

- standard: Standard.
- localSSD: Local SSD.
- bigData: Large storage.
- ramEnhanced: Memory-enhanced instance family.
- networkEnhanced: Network-enhanced.', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Valid values:

- pl0: A single disk delivers up to 10,000 random read/write IOPS.
- pl1: A single disk delivers up to 50,000 random read/write IOPS.
- pl2: A single disk delivers up to 100,000 random read/write IOPS.
- pl3: A single disk delivers up to 1,000,000 random read/write IOPS.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='BackendNodeGroups', description='The information about the BE or CN compute groups.', position='Body'),
  clientToken?: string(name='ClientToken', description='The client token that is used to ensure the idempotence of the request. You can use the client to generate the value, but you must make sure that the value is unique among different requests. The token can contain only ASCII characters and cannot exceed 64 characters in length.', example='123e4567-e89b-12d3-a456-426655440000', position='Body'),
  dlfCatalogName?: string(name='DlfCatalogName', description='The name of the DLF catalog.', example='paimon_test', position='Body'),
  dlfCatalogType?: string(name='DlfCatalogType', description='The type of the DLF catalog, such as paimon or iceberg.', example='paimon', position='Body'),
  duration?: int32(name='Duration', description='The subscription duration. This parameter takes effect only when PayType is set to PrePaid.', example='1', position='Body'),
  enableAiFunction?: boolean(name='EnableAiFunction', description='Specifies whether to enable the AI center. Default value: false.', position='Body'),
  enableMultiAz?: boolean(name='EnableMultiAz', description='Specifies whether to enable disaster recovery.', position='Body'),
  encrypted?: boolean(name='Encrypted', description='Specifies whether to enable encryption.', example='true', position='Body'),
  frontendNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of compute units (CUs). A CU is the basic metering unit of the service. 1 CU equals 1 vCPU and 4 GiB of memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1'),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type. You do not need to set this parameter for FE compute groups.', example='null'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the compute group. Only standard is supported.', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Only pl1 is supported, where a single disk delivers up to 50,000 random read/write IOPS.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='FrontendNodeGroups', description='The information about the FE node groups.', position='Body'),
  gatewayType?: string(name='GatewayType', description='The gateway type. Generally, the value is Slb or Privatezone.', example='Traditional\\\\"\\\\"', position='Body'),
  instanceName: string(name='InstanceName', description='The instance name.

This parameter is required.', example='c1', position='Body'),
  kmsKeyId?: string(name='KmsKeyId', description='The KMS key ID.', example='fdsdf****', position='Body'),
  linkedRamUserName?: string(name='LinkedRamUserName', description='The username of the associated Resource Access Management (RAM) user or the name of the RAM role.', example='aliyun.test1', position='Body'),
  observerNodeGroups?: [ 
