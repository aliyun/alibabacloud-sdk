model CreateInstanceV1Request {
  regionId?: string(name='RegionId', position='Host,Body'),
  adminPassword: string(name='AdminPassword', description='The administrator password of the instance.

This parameter is required.', example='password_example', position='Body'),
  agentNodeGroup?: {
    cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU = 1 CPU core + 4 GiB memory.', example='2'),
  }(name='AgentNodeGroup', description='The agent compute group.', position='Body'),
  autoPay?: boolean(name='AutoPay', description='Specifies whether to automatically purchase (pay for) all products specified in the Products parameter.

Valid values:
- true: Automatic payment.
- false: No automatic payment.', example='false', position='Body'),
  autoRenew?: boolean(name='AutoRenew', description='Specifies whether to enable auto-renewal. This parameter takes effect only when payType is set to PrePaid. Auto-renewal is disabled by default.', example='true', position='Body'),
  backendNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU = 1 CPU core + 4 GiB memory. When SpecType is set to memory-enhanced instance family, 1 CU = 1 CPU core + 8 GiB memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1', minimum=0),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type of the node group. This parameter takes effect only when the instance is ECS-based and SpecType is set to local SSD or large-scale storage.', example='local_ssd_4_4xlarge'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the node group. Valid values:', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Valid values:', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='BackendNodeGroups', description='The BE or CN node group information.', position='Body'),
  clientToken?: string(name='ClientToken', description='Ensures the idempotence of the request. Generate a unique parameter value from your client. The ClientToken value supports only ASCII characters and cannot exceed 64 characters in length.', example='123e4567-e89b-12d3-a456-426655440000', position='Body'),
  dlfCatalogName?: string(name='DlfCatalogName', description='The name of the DLF Catalog.', example='paimon_test', position='Body'),
  dlfCatalogType?: string(name='DlfCatalogType', description='The type of the DLF Catalog. Valid values: paimon and iceberg.', example='paimon', position='Body'),
  duration?: int32(name='Duration', description='The subscription duration. This parameter takes effect only when payType is set to PrePaid.', example='1', position='Body'),
  enableAiFunction?: boolean(name='EnableAiFunction', description='Specifies whether to enable the AI Center. Default value: false.', position='Body'),
  enableMultiAz?: boolean(name='EnableMultiAz', description='Specifies whether to enable disaster recovery.', position='Body'),
  encrypted?: boolean(name='Encrypted', description='Specifies whether to enable encryption.', example='true', position='Body'),
  frontendNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU = 1 CPU core + 4 GiB memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1'),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type. This parameter does not need to be set for the FE node group.', example='null'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the node group. Only standard is supported.', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Only pl1 is supported, which provides up to 50,000 random read/write IOPS per disk.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='FrontendNodeGroups', description='The FE node group information.', position='Body'),
  gatewayType?: string(name='GatewayType', description='The gateway type. Valid values: Slb and Privatezone.', example='Traditional\\\\"\\\\"', position='Body'),
  instanceName: string(name='InstanceName', description='The instance name.

This parameter is required.', example='c1', position='Body'),
  kmsKeyId?: string(name='KmsKeyId', description='The KMS key ID.', example='fdsdf****', position='Body'),
  linkedRamUserName?: string(name='LinkedRamUserName', description='The username of the associated Resource Access Management (RAM) user or the name of the associated RAM role.', example='aliyun.test1', position='Body'),
  observerNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU = 1 CPU core + 4 GiB memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1'),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type. This parameter does not need to be set for the Observer node group.', example='null'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the node group. Only standard is supported.', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Only pl1 is supported, which provides up to 50,000 random read/write IOPS per disk.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='ObserverNodeGroups', description='The Observer node group information. Specify this parameter only when you need to enable multi-zone disaster recovery. The Observer node group specifications must be the same as those of the FE node group.', position='Body'),
  ossAccessingRoleName?: string(name='OssAccessingRoleName', description='The name of the role used for password-free access to OSS.', example='AliyunEMRStarRocksAccessingOSSRole', position='Body'),
  packageType: string(name='PackageType', description='The instance edition:
<ul>
<li>  Entry edition (trial).</li>
<li> Standard edition (official).</li>
</ul>

This parameter is required.', example='official', position='Body'),
  payType: string(name='PayType', description='The billing method. Valid values:
<ol>
<li>prePaid: subscription.</li>
<li>postPaid: pay-as-you-go.</li>
</ol>

This parameter is required.', example='prePaid', position='Body'),
  pricingCycle?: string(name='PricingCycle', description='The unit of the subscription duration. Valid values:
<ul>
<li>Month</li>
<li>Year</li>
</ul>
This parameter takes effect only when payType is set to PrePaid.', example='Month', position='Body'),
  principalType?: string(name='PrincipalType', description='The RAM authentication type. Valid values:
- RS: Resource Access Management (RAM) user.
- RR: RAM role.', example='RR', position='Body'),
  promotionOptionNo?: string(name='PromotionOptionNo', description='The coupon ID.', example='165445235634', position='Body'),
  ramUserId?: string(name='RamUserId', description='The ID of the Resource Access Management (RAM) user or RAM role.', example='123456', position='Body'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-aekzllkih7jqxxx', position='Body'),
  runMode: string(name='RunMode', description='The running mode of the cluster. Valid values:

- shared_nothing: compute-storage coupled.
- shared_data: compute-storage decoupled.

This parameter is required.', example='shared_data', position='Body'),
  tags?: [ 
    {
      key?: string(name='Key', description='The tag key.', example='k1'),
      value?: string(name='Value', description='The tag value.', example='v1'),
    }
  ](name='Tags', description='The instance tags.', position='Body'),
  vSwitches?: [ 
    {
      vswId: string(name='VswId', description='The vSwitch ID.

This parameter is required.', example='vsw-bp19mlh98tm9teyyd****'),
      zoneId?: string(name='ZoneId', description='The zone ID of the vSwitch.', example='cn-hangzhou-i'),
    }
  ](name='VSwitches', description='The vSwitch and zone information.', position='Body'),
  version: string(name='Version', description='The major version of the instance.

This parameter is required.', example='3', position='Body'),
  vpcId: string(name='VpcId', description='VPC ID。

This parameter is required.', example='vpc-bp1fll2mci6d7pw8m****', position='Body'),
  zoneId: string(name='ZoneId', description='The primary zone ID.

This parameter is required.', example='cn-hangzhou-i', position='Body'),
}

