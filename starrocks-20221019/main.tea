model CreateInstanceV1Request {
  adminPassword?: string(name='AdminPassword', description='The administrator password of the instance.

This parameter is required.', example='password_example'),
  agentNodeGroup?: {
    cu?: int32(name='cu'),
  }(name='AgentNodeGroup'),
  autoPay?: boolean(name='AutoPay'),
  autoRenew?: boolean(name='AutoRenew', description='Specifies whether to enable auto-renewal. This parameter takes effect only when payType is set to PrePaid. Auto-renewal is disabled by default.', example='true'),
  backendNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU = 1 CPU core + 4 GiB memory. When SpecType is set to memory-enhanced instance family, 1 CU = 1 CPU core + 8 GiB memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1', nullable=false),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type of the node group. This parameter takes effect only when the instance is ECS-based and SpecType is set to local SSD or large-scale storage.', example='local_ssd_4_4xlarge'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the node group. Valid values:', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level of the cloud disk. Valid values:

- pl0: A single disk delivers up to 10,000 random read/write IOPS.
- pl1: A single disk delivers up to 50,000 random read/write IOPS.
- pl2: A single disk delivers up to 100,000 random read/write IOPS.
- pl3: A single disk delivers up to 1,000,000 random read/write IOPS.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='BackendNodeGroups', description='The BE or CN node group information.'),
  clientToken?: string(name='ClientToken', description='Ensures the idempotence of the request. Generate a unique parameter value from your client. The ClientToken value supports only ASCII characters and cannot exceed 64 characters in length.', example='123e4567-e89b-12d3-a456-426655440000'),
  dlfCatalogName?: string(name='DlfCatalogName', description='The name of the DLF Catalog.', example='paimon_test'),
  dlfCatalogType?: string(name='DlfCatalogType', description='The type of the DLF Catalog. Valid values: paimon and iceberg.', example='paimon'),
  duration?: int32(name='Duration', description='The subscription duration. This parameter takes effect only when payType is set to PrePaid.', example='1'),
  enableAiFunction?: boolean(name='EnableAiFunction'),
  enableMultiAz?: boolean(name='EnableMultiAz', description='Specifies whether to enable disaster recovery.'),
  encrypted?: boolean(name='Encrypted', description='Specifies whether to enable encryption.', example='true'),
  frontendNodeGroups?: [ 
    {
      cu?: int32(name='cu', description='The number of CUs. A CU (Compute Unit) is the basic metering unit of the service. 1 CU = 1 CPU core + 4 GiB memory.', example='8'),
      diskNumber?: int32(name='diskNumber', description='The number of disks.', example='1'),
      localStorageInstanceType?: string(name='localStorageInstanceType', description='The local SSD instance type. This parameter does not need to be set for the FE node group.', example='null'),
      residentNodeNumber?: int32(name='residentNodeNumber', description='The number of nodes.', example='3'),
      specType?: string(name='specType', description='The specification type of the node group. Only standard is supported.', example='standard'),
      storagePerformanceLevel?: string(name='storagePerformanceLevel', description='The performance level (PL) of the cloud disk. Only pl1 is supported, which provides up to 50,000 random read/write IOPS per disk.', example='pl1'),
      storageSize?: int32(name='storageSize', description='The storage size. Unit: GiB.', example='100'),
      zoneId?: string(name='zoneId', description='The zone ID.', example='cn-hangzhou-i'),
    }
  ](name='FrontendNodeGroups', description='The FE node group information.'),
  gatewayType?: string(name='GatewayType'),
  instanceName?: string(name='InstanceName', description='The instance name.

This parameter is required.', example='c1'),
  kmsKeyId?: string(name='KmsKeyId', description='The KMS key ID.', example='fdsdf****'),
  linkedRamUserName?: string(name='LinkedRamUserName', description='The username of the associated Resource Access Management (RAM) user or the name of the associated RAM role.', example='aliyun.test1'),
