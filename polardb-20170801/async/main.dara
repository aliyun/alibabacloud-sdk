}

model AddPolarFsQuotaRequest {
  DBClusterId?: string(name='DBClusterId', description='The ID of the PolarDB instance on which the application depends.', example='pc-**************', position='Query'),
  polarFsInstanceId: string(name='PolarFsInstanceId', description='The ID of the Polarlakebase instance.

This parameter is required.', example='pfs-2ze0i74ka607*****', position='Query'),
  quotas: [ 
    {
      accessTTL?: long(name='AccessTTL', description='The time to live (TTL) for the access time. Unit: seconds.', example='7200'),
      changeTTL?: long(name='ChangeTTL', description='The TTL for the change time. Unit: seconds.', example='7200'),
      description?: string(name='Description', description='The description of the resource quota.', example='quota_policy'),
      enabled?: boolean(name='Enabled', description='Specifies whether to enable the rule. Valid values:

- **True**: The rule immediately applies to new items. This is the default value.

- **False**: The rule does not apply to new items.', example='True'),
      exclude?: string(name='Exclude', description='The rule to exclude specific paths from matching.

- A path pattern that starts with a forward slash (/). Supports glob syntax, including `*`, `?`, and `**`.', example='/a/*project*'),
      fileCountLimit?: long(name='FileCountLimit', description='The limit on the number of files for a user in the directory.', example='222'),
      include: string(name='Include', description='The wildcard pattern to match paths.

- A path pattern that starts with a forward slash (/). Supports glob syntax, including `*`, `?`, and `**`.

This parameter is required.', example='/b/*project*'),
      name: string(name='Name', description='The name of the rule.

This parameter is required.', example='rule1'),
      priority?: int32(name='Priority', description='The priority of the quota rule.', example='1'),
      sizeLimit?: long(name='SizeLimit', description='The total size limit for files in the directory. Unit: GB.

- Note: The value must be at least 1 GB.', example='1'),
    }
  ](name='Quotas', description='The details of the quota rules.

This parameter is required.', position='Query'),
}

model AddPolarFsQuotaResponseBody = {
  polarFsInstanceId?: string(name='PolarFsInstanceId', description='The ID of the Polarlakebase instance.', example='pfs-2ze0i74ka607*****'),
  requestId?: string(name='RequestId', description='The ID of the request.', example='7F2007D3-7E74-4ECB-89A8-BF130D******'),
}

model AddPolarFsQuotaResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: AddPolarFsQuotaResponseBody(name='body'),
}

/**
  * @description ## Request description
  * - This operation adds a new path policy—a directory quota rule—to a specified Polarlakebase instance.
  * - The `Quotas` parameter is a list. Each element represents a new quota rule. You can add up to 11 rules in a single request.
  * - Each rule must include the `Name` and `Include` fields. Other fields, such as `Description` and `Exclude`, are optional.
  * - To define the quota limit, specify at least one of the following parameters: `SizeLimit`, `FileCountLimit`, `AccessTTL`, or `ChangeTTL`.
  * - The `Priority` field specifies the rule priority. A larger value indicates higher priority. The default value is 0.
  * - The `Enabled` field determines whether the rule takes effect immediately. The default value is true.
  * @param request  the request parameters of AddPolarFsQuota  AddPolarFsQuotaRequest
  * @return AddPolarFsQuotaResponse
 */
async function addPolarFsQuota(request: AddPolarFsQuotaRequest): AddPolarFsQuotaResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AddPolarFsQuota', 'POST', '/', 'json', false, 'json', request);
}

