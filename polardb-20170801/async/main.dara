model ModifyDBClusterAccessWhitelistRequest {
  DBClusterIPArrayAttribute?: string(name='DBClusterIPArrayAttribute', description='The attribute of the IP address whitelist group. If this parameter is set to **hidden**, the group is invisible in the console.

> - IP address whitelist groups that are already displayed in the console cannot be hidden.
> - This parameter is supported only when **WhiteListType** is set to **IP**.', example='hidden', position='Query'),
  DBClusterIPArrayName?: string(name='DBClusterIPArrayName', description='The name of the IP address whitelist group. The name must be 2 to 120 characters in length and can contain lowercase letters and digits. It must start with a letter and end with a letter or a digit.

- If the specified whitelist group name does not exist, the whitelist group is created.
- If the specified whitelist group name already exists, the whitelist group is modified.
- If this parameter is not specified, the default group is modified. 

> - A cluster supports a maximum of 50 IP address whitelist groups.
> - This parameter is supported only when **WhiteListType** is set to **IP**.', example='default', position='Query'),
  DBClusterId: string(name='DBClusterId', description='The cluster ID.

This parameter is required.', example='pc-*************', position='Query'),
  modifyMode?: string(name='ModifyMode', description='The modification mode of the IP address whitelist. Valid values:
- **Cover**: Overwrites the original IP address whitelist. This is the default value.
- **Append**: Appends IP addresses to the IP address whitelist.
- **Delete**: Deletes IP addresses from the IP address whitelist.

> This parameter is supported only when **WhiteListType** is set to **IP**.', example='Cover', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  pfsInstanceId?: string(name='PfsInstanceId', description='The file system instance ID.', example='pfs-xxx', position='Query'),
  projectId?: string(name='ProjectId', description='The unique identifier of the project.', example='proj-xxxxxxxxxxxxxxxxxxxxxxxxxx', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  securityGroupIds?: string(name='SecurityGroupIds', description='The security group IDs. Separate multiple security group IDs with commas (,).

> - A cluster supports a maximum of three security groups.
> - This parameter is supported only when **WhiteListType** is set to **SecurityGroup**.', example='sg-*********', position='Query'),
  securityIps?: string(name='SecurityIps', description='The IP addresses or CIDR blocks in the IP address whitelist group. A maximum of 1,000 IP addresses or CIDR blocks can be added across all IP address whitelist groups. Separate multiple IP addresses or CIDR blocks with commas (,). The following two formats are supported: 

- IP address format, such as 10.23.12.24.
- CIDR format, such as 10.23.12.24/24. In Classless Inter-Domain Routing (CIDR), 24 indicates the length of the prefix in the IP address. The prefix length ranges from 1 to 32.

> This parameter is supported only when **WhiteListType** is set to **IP**.', example='10.23.12.24', position='Query'),
  whiteListType?: string(name='WhiteListType', description='The whitelist type. Valid values:

- **IP**: IP address whitelist group.
- **SecurityGroup**: Security group.
- **ProjectIP**: ProjectIP whitelist group.

Default value: **IP**.', example='IP', position='Query'),
}

