> * If this parameter is left empty, the task is executed immediately by default.', example='2021-01-14T09:00:00Z', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  standbyClusterIdListNeedToSync?: string(name='StandbyClusterIdListNeedToSync', description='The list of secondary clusters in the Global Database Network (GDN) that require parameter settings synchronization.', example='gdn-**********,gdn-**********', position='Query'),
