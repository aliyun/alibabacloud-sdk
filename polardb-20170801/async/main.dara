  storageAutoScale?: string(name='StorageAutoScale', description='Specifies whether to enable automatic storage scaling for the Standard Edition cluster. Valid values:

- Enable: enables automatic storage scaling.
- Disable: disables automatic storage scaling.', example='Enable', position='Query'),
  storageUpperBound?: long(name='StorageUpperBound', description='The upper limit for automatic storage scaling of the Standard Edition cluster. Unit: GB.

> The maximum value is 32000.', example='800', minimum=20, maximum=64000, position='Query'),
