  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  targetDBRevisionVersionCode?: string(name='TargetDBRevisionVersionCode', description='The version code of the target DB version. You can obtain this value by calling the [DescribeDBClusterVersion](https://help.aliyun.com/document_detail/2319145.html) operation.', example='20230707', position='Query'),
  targetProxyRevisionVersionCode?: string(name='TargetProxyRevisionVersionCode', description='The version code of the target proxy version. You can obtain this value by calling the [DescribeDBClusterVersion](https://help.aliyun.com/document_detail/2319145.html) operation.', example='20240702', position='Query'),
  upgradeLabel?: string(name='UpgradeLabel', description='The label for the kernel version upgrade. Set the value to **INNOVATE**.

> - This parameter is applicable only when you upgrade a PolarDB for MySQL 8.0.1 cluster to PolarDB for MySQL 8.0.2.
