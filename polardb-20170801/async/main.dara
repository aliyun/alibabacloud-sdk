  preferredBackupTime?: string(name='PreferredBackupTime', description='The time period during which automatic backups are performed. The format is `HH:mmZ-HH:mmZ` (UTC).', example='07:00Z-08:00Z'),
  preferredNextBackupTime?: string(name='PreferredNextBackupTime', description='The time of the next backup. The format is `YYYY-MM-DDThh:mmZ` (UTC).', example='2020-11-16T07:30Z'),
