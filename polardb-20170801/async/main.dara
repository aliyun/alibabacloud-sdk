This parameter is required.', example='pc-*************', position='Query'),
  DBNodeCrashList?: string(name='DBNodeCrashList', description='The list of instance names of the nodes to be drilled.
> A node-level drill supports only a single node. For a zone-level drill, you can leave this parameter empty or pass all nodes.', example='pi-rwxxx', position='Query'),
  dataSyncMode?: string(name='DataSyncMode', description='The cross-zone data replication mode of the cluster. Valid values:

- **AsyncSync**: Asynchronous replication.
- **SemiSync**: Semi-synchronous replication.', example='AsynSync', position='Query'),
  faultInjectionType?: string(name='FaultInjectionType', description='The fault injection method. Valid values:

- 0: instance fault injection based on `Crash SQL`.', example='CrashSQLInjection', position='Query'),
  faultSimulateMode?: string(name='FaultSimulateMode', description='The fault drill dimension of the cluster. Valid values:
- `0` or `FaultInjection`: fault drill at the primary zone level.
- `1`: fault drill at the node level.
> - In the **fault drill at the primary zone level** scenario, all compute nodes in the primary zone become unavailable, and the disaster recovery switchover in this scenario is lossy.
> - In the **fault drill at the node level** scenario, only a single compute node can be drilled. You can pass the desired compute node name through `DBNodeCrashList`.', example='0', position='Query'),
  imciAutoIndex?: string(name='ImciAutoIndex', description='The automatic IMCI-based query acceleration feature. Valid values:
- `ON`: Enables the feature.
- `OFF`: Disables the feature.

> - This feature is supported only by PolarDB for MySQL clusters.
> - For cluster version limits, refer to [Automatic seamless acceleration (AutoIndex)](https://help.aliyun.com/document_detail/2854119.html).', example='OFF', position='Query'),
  modifyRowCompression?: string(name='ModifyRowCompression', description='Modifies the row compression settings.', example='OFF', position='Query'),
  ownerAccount?: string(name='OwnerAccount', position='Query'),
  ownerId?: long(name='OwnerId', position='Query'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount', position='Query'),
  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  standbyHAMode?: string(name='StandbyHAMode', description='The cross-zone automatic switchover mode of the cluster. Valid values:

- **ON**: Enables cross-zone automatic switchover.
- **OFF**: Disables cross-zone automatic switchover.', example='ON', position='Query'),
  storageAutoScale?: string(name='StorageAutoScale', description='Specifies whether to enable automatic storage scaling for a Standard Edition cluster. Valid values:

- Enable: Enables automatic storage scaling.
- Disable: Disables automatic storage scaling.', example='Enable', position='Query'),
  storageUpperBound?: long(name='StorageUpperBound', description='The upper limit for automatic storage scaling of a Standard Edition cluster. Unit: GB.

> The maximum value is 32,000.', example='800', minimum=20, maximum=64000, position='Query'),
  tableMeta?: string(name='TableMeta', description='The JSON string of the target database and table information to be restored. The values of the database and table information are all of the string type.
Example: `[
   {
       "tables":[
           {
               "name":"testtb",
               "type":"table",
               "newname":"testtb_restore"
           }
       ],
       "name":"testdb",
       "type":"db",
       "newname":"testdb_restore"
   }
]`.
> You can call the [DescribeMetaList](https://help.aliyun.com/document_detail/194770.html) operation to query the details of the database and table names that support restoration, and fill the supported database and table information into the corresponding positions in the preceding example.', example='[ { "tables":[ { "name":"testtb", "type":"table", "newname":"testtb_restore" } ], "name":"testdb", "type":"db", "newname":"testdb_restore" } ]', position='Query'),
}

