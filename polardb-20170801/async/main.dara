  resourceOwnerId?: long(name='ResourceOwnerId', position='Query'),
  rollBackForDisaster?: boolean(name='RollBackForDisaster', description='Specifies whether to switch back to the original primary zone after a failover. Valid values:

- true: Switch back to the original primary zone.
- false: Do not switch back to the original primary zone.', example='false', position='Query'),
  targetDBNodeId?: string(name='TargetDBNodeId', description='The ID of the node that you want to promote to the primary node. If you leave this parameter empty, the system automatically elects a node. You can call the [DescribeDBClusters](https://help.aliyun.com/document_detail/98094.html) operation to query node IDs and other information.

> - Automatic election of the primary node: The system identifies all read-only nodes that are eligible for election. The system selects one or more read-only nodes with the highest priority. If the switchover to the first node fails due to reasons such as network issues or abnormal replication status, the system attempts to switch to the next node until the switchover succeeds.
>- This parameter is required when the cluster is a PolarDB for PostgreSQL (Compatible with Oracle) or PolarDB for PostgreSQL cluster. This parameter is optional when the cluster is a PolarDB for MySQL cluster.', example='pi-***********', position='Query'),
  targetZoneType?: string(name='TargetZoneType', description='Specifies whether the primary/secondary switchover is performed within the primary zone. Valid values:
- Primary: The primary/secondary switchover is performed within the primary zone.
- Standby: The switchover is performed to the hot standby storage cluster.', example='Primary', position='Query'),
}

