This parameter is required.', example='pfs-2ze0i74ka607*****', position='Query'),
}

model SetPolarFsFileQuotaResponseBody = {
  polarFsInstanceId?: string(name='PolarFsInstanceId', description='The Polarlakebase instance ID.', example='pfs-2ze0i74ka607*****'),
