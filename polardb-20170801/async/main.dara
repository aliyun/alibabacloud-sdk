      inodes?: long(name='Inodes', description='The inode quota.', example='100'),
      maxDepth?: int32(name='MaxDepth', description='The number of directory levels to traverse under `FilePathId`. A value of 1 indicates that only the first-level subdirectories are traversed. A value of 0 indicates that the traversal goes to the deepest level.', example='1'),
      quotaIds?: string(name='QuotaIds', description='The list of rule IDs to be applied, separated by commas (`,`).', example='1,2'),
      strategy?: string(name='Strategy', description='The mode in which the rules take effect on existing files. Valid values:
