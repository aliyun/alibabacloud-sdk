    taskId?: string(name='TaskId', description='The translation task ID.', example='f9c35b0453b'),
    taskType?: string(name='TaskType', description='The task type.

- DOCUMENT: Document type.', example='DOCUMENT'),
    wordCount?: long(name='WordCount', description='The word count of the uploaded document.', example='1600'),
    workSpaceId?: string(name='WorkSpaceId', description='The workspace ID.', example='c2b898f******c985c'),
  }(name='Data', description='The business data.'),
