import Credential;
import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  @endpointMap = {
    'public' = 'realtranslationagent.aliyuncs.com',
  };

  checkConfig(config);
  @endpoint = getEndpoint('realtranslationagent', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model CancelTranslationTaskRequest {
  APIKey?: string(name='APIKey', description='The API key, the identity of member accounts. You can obtain it from the RuiYiBao console.', example='sk-5****7'),
  taskId?: string(name='TaskId', description='The task ID.
- The TaskId is returned after a task is submitted by calling SubmitTranslationTask.
- Only running tasks can be canceled.

This parameter is required.', example='f9c35b0453b'),
}

model CancelTranslationTaskResponseBody = {
  code?: string(name='Code', description='The return code.', example='success'),
  data?: {
    status?: string(name='Status', description='The task status.', example='CANCEL'),
    taskId?: string(name='TaskId', description='The task ID.', example='f9c35b0453b'),
  }(name='Data', description='The business data.'),
  message?: string(name='Message', description='The return message.', example='successful'),
  requestId?: string(name='RequestId', description='The request ID.', example='F22CA868-601F-50D1-99B2-520491F25EB7'),
  success?: boolean(name='Success', description='Indicates whether the request is successful.', example='True'),
}

model CancelTranslationTaskResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CancelTranslationTaskResponseBody(name='body'),
}

/**
 * @summary Cancels a translation task that is currently running.
 *
 * @description **Billing description**
 * After the task is successfully canceled, the Credits frozen for this translation task will be fully refunded to your account.
 * **Before you begin**
 * - This operation only supports canceling translation tasks that are in the processing state. Tasks that are completed or failed cannot be canceled.
 *
 * @param request CancelTranslationTaskRequest
 * @param runtime runtime options for this request RuntimeOptions
 * @return CancelTranslationTaskResponse
 */
@context("cancelTranslationTaskWithContext")
async function cancelTranslationTaskWithOptions(request: CancelTranslationTaskRequest, runtime: $RuntimeOptions): CancelTranslationTaskResponse {
  request.validate();
  var query = {};
  if (!$isNull(request.APIKey)) {
    query['APIKey'] = request.APIKey;
  }
  var body : map[string]any = {};
  if (!$isNull(request.taskId)) {
    body['TaskId'] = request.taskId;
  }
  var req = new OpenApiUtil.OpenApiRequest{ 
    query = OpenApiUtil.query(query),
    body = OpenApiUtil.parseToMap(body),
  };
  var params = new OpenApiUtil.Params{
    action = 'CancelTranslationTask',
    version = '2026-06-22',
    protocol = 'HTTPS',
    pathname = '/',
    method = 'POST',
    authType = 'AK',
    style = 'RPC',
    reqBodyType = 'formData',
    bodyType = 'json',
  };
  return callApi(params, req, runtime);
}

/**
 * @summary Cancels a translation task that is currently running.
 *
 * @description **Billing description**
 * After the task is successfully canceled, the Credits frozen for this translation task will be fully refunded to your account.
 * **Before you begin**
 * - This operation only supports canceling translation tasks that are in the processing state. Tasks that are completed or failed cannot be canceled.
 *
 * @param request CancelTranslationTaskRequest
 * @return CancelTranslationTaskResponse
 */
async function cancelTranslationTask(request: CancelTranslationTaskRequest): CancelTranslationTaskResponse {
  var runtime = new $RuntimeOptions{};
  return cancelTranslationTaskWithOptions(request, runtime);
}

