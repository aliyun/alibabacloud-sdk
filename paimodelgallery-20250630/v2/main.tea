  distillable?: boolean(name='Distillable', description='Indicates whether distillation is supported.', example='true'),
  domain?: string(name='Domain', description='The domain. For example, aigc (generative AI), nlp (natural language processing), or cv (computer vision).', example='aigc'),
  evaluable?: boolean(name='Evaluable', description='Indicates whether evaluation is supported.', example='true'),
  extraInfo?: map[string]any(name='ExtraInfo', description='The additional information.', example='{}'),
  functionCall?: boolean(name='FunctionCall', description='Indicates whether FunctionCall is supported.', example='true'),
  gmtCreateTime?: string(name='GmtCreateTime', description='The creation time.', example='2025-12-03T07:21:28.000Z'),
  gmtLatestVersionModified?: string(name='GmtLatestVersionModified', description='The update time of the latest model version.', example='2025-12-03T07:21:28.000Z'),
  gmtModifiedTime?: string(name='GmtModifiedTime', description='The update time.', example='2025-12-03T07:21:28.000Z'),
  latestVersionName?: string(name='LatestVersionName', description='The latest model version.', example='1.0.0'),
  modelDescription?: string(name='ModelDescription', description='The model description.', example='Large language model'),
  modelDoc?: string(name='ModelDoc', description='The model documentation.', example='http://'),
  modelId?: string(name='ModelId', description='The model ID.', example='model-8npjorqxl8gmdo72nj'),
  modelName?: string(name='ModelName', description='The model name.', example='Qwen3-235B-A22B-Thinking-2507'),
  modelSeries?: string(name='ModelSeries', description='The model series.', example='Qwen'),
  modelType?: string(name='ModelType', description='The model type.', example='LoRA'),
  orderNumber?: long(name='OrderNumber', description='The ordinal number.', example='1'),
  origin?: string(name='Origin', description='The model source, used to filter the list of models that belong to a specific community or organization. For example, ModelScope, PAI, or NIM.', example='PAI'),
  parameterSize?: long(name='ParameterSize', description='The number of parameters, in millions (M).', example='1024'),
  searchWords?: string(name='SearchWords', description='The search keywords.', example='llm'),
  supportedCompressionMethods?: map[string]any(name='SupportedCompressionMethods', description='The supported compression methods.', example='{
  "Methods": [{
    "Method": "Quantization",
    "SubMethod": "MinMax-8Bit",
    "Resource": "GPU"
  }]
}'),
  supportedCompressionResources?: string(name='SupportedCompressionResources', description='The resources supported for compression.', example='GPU,GP7V'),
  supportedDistillationMethods?: map[string]any(name='SupportedDistillationMethods', description='The supported distillation methods.', example='{
  "Methods": [{
    "Method": "EasyDistill",
    "SubMethod": "DataSynthesis",
    "Resource": "GPU"
  }]
}'),
  supportedDistillationResources?: string(name='SupportedDistillationResources', description='The resources supported for distillation.', example='GPU,GP7V'),
  supportedEvaluationMethods?: map[string]any(name='SupportedEvaluationMethods', description='The supported evaluation methods.', example='{
  "Methods": [{
    "Method": "Single-Node-Standard",
    "Resource": "GPU"
  }]
}'),
  supportedEvaluationResources?: string(name='SupportedEvaluationResources', description='The resources supported for evaluation.', example='GPU,GP7V'),
  supportedInferenceMethods?: map[string]any(name='SupportedInferenceMethods', description='The supported deployment methods.', example='{
  "Methods": [{
    "framework": "blade",
    "scenario": "nvidia-standard",
    "Resource": "GPU"
  }]
}'),
  supportedInferenceResources?: string(name='SupportedInferenceResources', description='The resources supported for deployment.', example='GPU,GP7V'),
  supportedTrainingMethods?: map[string]any(name='SupportedTrainingMethods', description='The supported training methods.', example='{
  "Methods": [{
    "Method": "SFT",
    "SubMethod": "LoRA_LLM",
    "Resource": "GPU"
  }]
}'),
  supportedTrainingResources?: string(name='SupportedTrainingResources', description='The resources supported for training.', example='GPU,GP7V'),
  tags?: {
    key?: string(name='Key', description='The tag key.', example='k1'),
    value?: string(name='Value', description='The tag value.', example='v1'),
  }(name='Tags', description='The list of tags.'),
  task?: string(name='Task', description='The task. For example, large-language-model (large language model), image-classification (image classification), or embedding.', example='large-language-model'),
  trainable?: boolean(name='Trainable', description='Indicates whether training is supported.', example='true'),
}

model CreateJobPlanRequest {
  jobPlanName?: string(name='JobPlanName', description='The name of the job plan.', example='ModelGalleryxxx'),
  jobPlanSteps?: [ 
    {
      jobPlanStepName?: string(name='JobPlanStepName', description='The name of the job plan step.', example='DatasetSynthesis'),
      jobPlanStepSpec?: map[string]any(name='JobPlanStepSpec', description='The detailed configuration of the job plan step.'),
      jobPlanStepType?: string(name='JobPlanStepType', description='The type of the job plan step.', example='PAIFlow'),
    }
  ](name='JobPlanSteps', description='The steps of the job plan.'),
  jobPlanType?: string(name='JobPlanType', description='The type of the job plan.', example='Distillation'),
  tag?: [ 
    {
      key?: string(name='Key', description='**Key**', example='foo'),
      value?: string(name='Value', description='**Value**', example='bar'),
    }
  ](name='Tag', description='Note: According to the Alibaba Cloud tag system specification, this parameter name is in singular form.'),
  templateId?: string(name='TemplateId', description='The ID of the scenario-specific distillation template, obtained from ListDistillationTemplates. If this parameter is not specified, a general-purpose job plan is created.', example='advanced_cot_distill'),
  workspaceId?: string(name='WorkspaceId', description='The workspace ID.', example='62469'),
}

