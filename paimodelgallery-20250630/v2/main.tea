import OpenApi;
import OpenApi.OpenApiUtil;

extends OpenApi;


init(config: OpenApiUtil.Config){
  super(config);
  @endpointRule = 'regional';
  
  checkConfig(config);
  @endpoint = getEndpoint('paimodelgallery', @regionId, @endpointRule, @network, @suffix, @endpointMap, @endpoint);
}

function getEndpoint(productId: string, regionId: string, endpointRule: string, network: string, suffix: string, endpointMap: map[string]string, endpoint: string) throws: string{
  if (!$isNull(endpoint)) {
    return endpoint;
  }
  
  if (!$isNull(endpointMap) && !$isNull(endpointMap[regionId])) {
    return endpointMap[regionId];
  }
  return OpenApiUtil.getEndpointRules(productId, regionId, endpointRule, network, suffix);
}

model DistillationTemplate {
  algorithmName?: string(name='AlgorithmName', description='The algorithm name.', example='easydistill'),
  algorithmProvider?: string(name='AlgorithmProvider', description='The algorithm provider.', example='pai'),
  algorithmVersion?: string(name='AlgorithmVersion', description='The algorithm version.', example='v2.0.0'),
  capabilityTags?: [ string ](name='CapabilityTags', description='The list of capability tags used for displaying scenario cards.'),
  category?: string(name='Category', description='The template category. The frontend uses this value to filter scenario cards.', example='reasoning'),
  defaultConfig?: string(name='DefaultConfig', description='The raw YAML content of the EasyDistill default configurations. The frontend uses this content for rendering the configuration form and supports recovering to default configurations. The model and credential fields are intentionally left empty and are populated by the user in the form upon commit.', example='job_type: advanced_cot_distill'),
  description?: string(name='Description', description='The template description, localized based on the requested language. The description specifies the applicable scenarios and outputs.', example='Designed for scenarios that require multi-step reasoning such as math, logic, and code. Produces an SFT dataset'),
  inputDatasetMustBeDirectory?: boolean(name='InputDatasetMustBeDirectory', description='Specifies whether the input data must be an entire directory. If this parameter is set to true, only a directory can be selected on the form, not a single file. If this parameter is absent or set to false, either a file or a directory can be selected. This value is true when seed files reference other files in the same directory by relative path.'),
  inputExampleUri?: string(name='InputExampleUri', description='The OSS address of the sample input data, rendered based on the region. Users can download the sample and prepare their own data in the same format. An empty value indicates that the template does not provide a sample.', example='oss://pai-quickstart-cn-hangzhou.oss-cn-hangzhou-internal.aliyuncs.com/public_datasets/distillation_examples/advanced_cot_distill/input.jsonl'),
  jobType?: string(name='JobType', description='The algorithm job type. The value is the same as TemplateId.', example='advanced_cot_distill'),
  modelSlots?: [ 
    {
      backends?: [ 
        {
          channel?: string(name='Channel', description='The channel name of the PAI-Token gateway. The frontend uses this value to retrieve the list of available models for the channel. This value must be passed back as-is upon submission. This parameter is returned only when Type is pai_token.', example='distillation'),
          type?: string(name='Type', description='The model access method. pai_token indicates the PAI-Token gateway, where the user selects from the list of available models for the channel. pai_eas indicates the user\\\\"s own PAI-EAS service instance, which requires the service address and token.', example='pai_token'),
        }
      ](name='Backends', description='The list of model access methods supported by this slot.'),
      description?: string(name='Description', description='The slot description, localized based on the requested language.', example='The teacher model used to generate distillation data. We recommend selecting a model with strong reasoning capabilities'),
      key?: string(name='Key', description='The slot identifier, which corresponds to the backend section name in the submitted configuration.', example='backend'),
      name?: string(name='Name', description='The slot display name, localized based on the requested language.', example='Teacher model'),
      required?: boolean(name='Required', description='Specifies whether this slot is required. If this parameter is set to false, the user can skip the selection, and the algorithm falls back to other slots.'),
    }
  ](name='ModelSlots', description='The list of model slots that require user selection. The frontend uses this list to render the model selection form.'),
  orderNumber?: int32(name='OrderNumber', description='The display order. A smaller value indicates a higher priority.', example='10'),
  pipelineStages?: [ 
    {
      description?: string(name='Description', description='The stage description, localized based on the requested language.', example='The teacher model generates responses with reasoning processes for each question'),
      key?: string(name='Key', description='The stage identifier, which corresponds to the value of pipeline[].stage in the algorithm configuration.', example='cot_distill'),
      name?: string(name='Name', description='The stage display name, localized based on the requested language.', example='Generate chain of thought'),
    }
  ](name='PipelineStages', description='The list of pipeline stages. The order of the stages represents the execution order.'),
  presetConfig?: [ 
    {
      label?: string(name='Label', description='The configuration item name, localized based on the requested language. Names are matched by position across languages, so the same row can have different names in different languages.', example='Task type'),
      value?: string(name='Value', description='The configuration item value, localized based on the requested language.', example='advanced_cot_distill'),
    }
  ](name='PresetConfig', description='The content of the preset configuration card, displayed in order to show the key default configurations of the template.'),
  templateId?: string(name='TemplateId', description='The distillation template ID, which is the same as the algorithm job_type. Pass this value as TemplateId when creating a task plan.', example='advanced_cot_distill'),
  templateName?: string(name='TemplateName', description='The template display name, localized based on the requested language.', example='Chain-of-thought reasoning distillation'),
  trainingOptions?: [ 
    {
      modelTasks?: [ string ](name='ModelTasks', description='The range of Model Gallery tasks available for the student model.'),
      trainingMethods?: [ string ](name='TrainingMethods', description='The list of supported training method families.'),
      trainingType?: string(name='TrainingType', description='The training type. The frontend uses this value to select the training workflow and display text.', example='sft'),
    }
  ](name='TrainingOptions', description='The capability declaration for the second stage (training the student model with the distilled data). An empty value indicates that the template supports only the distillation stage.'),
}

model DistillationTemplateSummary {
  capabilityTags?: [ string ](name='CapabilityTags', description='The list of capability tags, used for scenario card display.'),
  category?: string(name='Category', description='The template category. The frontend uses this value to filter scenario cards.', example='reasoning'),
  description?: string(name='Description', description='The template description, localized based on the language specified in the request. The description specifies applicable scenarios and outputs.', example='Designed for scenarios that require multi-step reasoning, such as math, logic, and code. Produces an SFT dataset'),
  jobType?: string(name='JobType', description='The algorithm job type. The value is the same as TemplateId.', example='advanced_cot_distill'),
  orderNumber?: int32(name='OrderNumber', description='The display order. A smaller value indicates a higher position.', example='10'),
  pipelineStages?: [ 
    {
      description?: string(name='Description', description='The stage description, localized based on the language specified in the request.', example='The teacher model generates reasoning-augmented responses for each question'),
      key?: string(name='Key', description='The stage identifier, which corresponds to the pipeline[].stage value in the algorithm configuration.', example='cot_distill'),
      name?: string(name='Name', description='The stage display name, localized based on the language specified in the request.', example='Generate Chain-of-Thought'),
    }
  ](name='PipelineStages', description='The list of pipeline stages. The order of the stages represents the execution order.'),
  templateId?: string(name='TemplateId', description='The distillation template ID, which is the same as the algorithm job_type. Pass this value as TemplateId when creating a task plan.', example='advanced_cot_distill'),
  templateName?: string(name='TemplateName', description='The template display name, localized based on the language specified in the request.', example='Chain-of-Thought Reasoning Distillation'),
  trainingOptions?: [ 
    {
      modelTasks?: [ string ](name='ModelTasks', description='The available Model Gallery Task values for the student model.'),
      trainingMethods?: [ string ](name='TrainingMethods', description='The list of supported training method families.'),
      trainingType?: string(name='TrainingType', description='The training type. The frontend uses this value to select the training workflow and display text.', example='sft'),
    }
  ](name='TrainingOptions', description='The capability declaration for the second stage, in which the distilled data is used to train the student model. An empty value indicates that the template supports only the distillation stage.'),
}

model JobPlan {
  gmtCreateTime?: string(name='GmtCreateTime'),
  gmtModifiedTime?: string(name='GmtModifiedTime'),
  jobPlanCurrentStep?: string(name='JobPlanCurrentStep'),
  jobPlanId?: string(name='JobPlanId'),
  jobPlanName?: string(name='JobPlanName'),
  jobPlanSteps?: [ 
    {
      jobPlanStepId?: string(name='JobPlanStepId'),
      jobPlanStepName?: string(name='JobPlanStepName'),
      jobPlanStepSpec?: map[string]any(name='JobPlanStepSpec'),
      jobPlanStepType?: string(name='JobPlanStepType'),
    }
  ](name='JobPlanSteps'),
  jobPlanType?: string(name='JobPlanType'),
  ownerId?: string(name='OwnerId'),
  tags?: [ 
    {
      key?: string(name='Key'),
      value?: string(name='Value'),
    }
  ](name='Tags'),
  templateId?: string(name='TemplateId', description='The distillation template ID used when creating the task plan. An empty value indicates that this is not a scenario-specific distillation task.', example='advanced_cot_distill'),
  templateName?: string(name='TemplateName', description='The display name of the distillation template used, localized based on the language specified in the request.', example='Chain-of-Thought Reasoning Distillation'),
  userId?: string(name='UserId'),
  workspaceId?: string(name='WorkspaceId'),
}

model ModelGalleryModel {
  collection?: string(name='Collection', description='The collection to which the model belongs.', example='QuickStart'),
  compressible?: boolean(name='Compressible', description='Indicates whether compression is supported.', example='true'),
  deepThink?: boolean(name='DeepThink', description='Indicates whether deep thinking is supported.', example='true'),
