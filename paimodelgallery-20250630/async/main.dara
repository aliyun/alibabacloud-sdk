import BaseClientBuilder;
import TeaAsyncHandler;
import TeaRequest;
import AsyncRequestBody;
import RequestBody;
import AsyncResponseHandler;
import ClientConfiguration;
import ClientExecutionParams;
extends BaseClientBuilder;
type @product = string
type @version = string
type @endpointRule = string
type @endpointMap = map[string]string
type @REQUEST = TeaRequest
type @handler = TeaAsyncHandler

init(configuration: ClientConfiguration){
  @handler = new TeaAsyncHandler(configuration);
  @product = 'PAIModelGallery';
  @version = '2025-06-30';
  @endpointRule = 'regional';
  @endpointMap = {
  };
}

function close(): void {
  @handler.close();
}

model DistillationTemplate {
  algorithmName?: string(name='AlgorithmName', example='easydistill'),
  algorithmProvider?: string(name='AlgorithmProvider', example='pai'),
  algorithmVersion?: string(name='AlgorithmVersion', example='v2.0.0'),
  capabilityTags?: [ string ](name='CapabilityTags'),
  category?: string(name='Category', example='reasoning'),
  defaultConfig?: string(name='DefaultConfig', example='job_type: advanced_cot_distill'),
  description?: string(name='Description', example='面向数学、逻辑、代码等需要多步推理的场景，产出 SFT 数据集。'),
  inputDatasetMustBeDirectory?: boolean(name='InputDatasetMustBeDirectory'),
  inputExampleUri?: string(name='InputExampleUri', example='oss://pai-quickstart-cn-hangzhou.oss-cn-hangzhou-internal.aliyuncs.com/public_datasets/distillation_examples/advanced_cot_distill/input.jsonl'),
  jobType?: string(name='JobType', example='advanced_cot_distill'),
  modelSlots?: [ 
    {
      backends?: [ 
        {
          channel?: string(name='Channel', example='distillation'),
          type?: string(name='Type', example='pai_token'),
        }
      ](name='Backends'),
      description?: string(name='Description', example='用于生成蒸馏数据的教师模型，建议选择推理能力强的模型。'),
      key?: string(name='Key', example='backend'),
      name?: string(name='Name', example='教师模型'),
      required?: boolean(name='Required'),
    }
  ](name='ModelSlots'),
  orderNumber?: int32(name='OrderNumber', example='10'),
  pipelineStages?: [ 
    {
      description?: string(name='Description', example='由教师模型对每个问题生成带推理过程的回答。'),
      key?: string(name='Key', example='cot_distill'),
      name?: string(name='Name', example='生成思维链'),
    }
  ](name='PipelineStages'),
  presetConfig?: [ 
    {
      label?: string(name='Label', example='任务类型'),
      value?: string(name='Value', example='advanced_cot_distill'),
    }
  ](name='PresetConfig'),
  processorExampleUri?: string(name='ProcessorExampleUri', example='oss://pai-quickstart-cn-hangzhou.oss-cn-hangzhou-internal.aliyuncs.com/public_datasets/distillation_examples/custom_distill/processor_example.py'),
  templateId?: string(name='TemplateId', example='advanced_cot_distill'),
  templateKind?: string(name='TemplateKind', example='scenario'),
  templateName?: string(name='TemplateName', example='思维链推理蒸馏'),
  trainingOptions?: [ 
    {
      modelTasks?: [ string ](name='ModelTasks'),
      trainingMethods?: [ string ](name='TrainingMethods'),
      trainingType?: string(name='TrainingType', example='sft'),
    }
  ](name='TrainingOptions'),
}

model DistillationTemplateSummary {
  capabilityTags?: [ string ](name='CapabilityTags'),
  category?: string(name='Category', example='reasoning'),
  description?: string(name='Description', example='面向数学、逻辑、代码等需要多步推理的场景，产出 SFT 数据集。'),
  jobType?: string(name='JobType', example='advanced_cot_distill'),
  orderNumber?: int32(name='OrderNumber', example='10'),
  pipelineStages?: [ 
    {
      description?: string(name='Description', example='由教师模型对每个问题生成带推理过程的回答。'),
      key?: string(name='Key', example='cot_distill'),
      name?: string(name='Name', example='生成思维链'),
    }
  ](name='PipelineStages'),
  templateId?: string(name='TemplateId', example='advanced_cot_distill'),
  templateKind?: string(name='TemplateKind', example='scenario'),
  templateName?: string(name='TemplateName', example='思维链推理蒸馏'),
  trainingOptions?: [ 
    {
      modelTasks?: [ string ](name='ModelTasks'),
      trainingMethods?: [ string ](name='TrainingMethods'),
      trainingType?: string(name='TrainingType', example='sft'),
    }
  ](name='TrainingOptions'),
}

model JobPlan {
  gmtCreateTime?: string(name='GmtCreateTime'),
  gmtModifiedTime?: string(name='GmtModifiedTime'),
  jobPlanCurrentStep?: string(name='JobPlanCurrentStep'),
  jobPlanId?: string(name='JobPlanId'),
  jobPlanName?: string(name='JobPlanName'),
  jobPlanSteps?: [ 
    {
      jobPlanStepId?: string(name='JobPlanStepId'),
      jobPlanStepName?: string(name='JobPlanStepName'),
      jobPlanStepSpec?: map[string]any(name='JobPlanStepSpec'),
      jobPlanStepType?: string(name='JobPlanStepType'),
    }
  ](name='JobPlanSteps'),
  jobPlanType?: string(name='JobPlanType'),
  ownerId?: string(name='OwnerId'),
  tags?: [ 
    {
      key?: string(name='Key'),
      value?: string(name='Value'),
    }
  ](name='Tags'),
  templateId?: string(name='TemplateId', example='advanced_cot_distill'),
  templateName?: string(name='TemplateName', example='思维链推理蒸馏'),
  userId?: string(name='UserId'),
  workspaceId?: string(name='WorkspaceId'),
}

model ModelGalleryModel {
  collection?: string(name='Collection'),
  compressible?: boolean(name='Compressible'),
  deepThink?: boolean(name='DeepThink'),
  demonstrable?: boolean(name='Demonstrable'),
  deployable?: boolean(name='Deployable'),
  distillable?: boolean(name='Distillable'),
  domain?: string(name='Domain'),
  evaluable?: boolean(name='Evaluable'),
  extraInfo?: map[string]any(name='ExtraInfo'),
  functionCall?: boolean(name='FunctionCall'),
  gmtCreateTime?: string(name='GmtCreateTime'),
  gmtLatestVersionModified?: string(name='GmtLatestVersionModified'),
  gmtModifiedTime?: string(name='GmtModifiedTime'),
  latestVersionName?: string(name='LatestVersionName'),
  modelDescription?: string(name='ModelDescription'),
  modelDoc?: string(name='ModelDoc'),
  modelId?: string(name='ModelId'),
  modelName?: string(name='ModelName'),
  modelSeries?: string(name='ModelSeries'),
  modelType?: string(name='ModelType'),
  orderNumber?: long(name='OrderNumber'),
  origin?: string(name='Origin'),
  parameterSize?: long(name='ParameterSize'),
  searchWords?: string(name='SearchWords'),
  supportedCompressionMethods?: map[string]any(name='SupportedCompressionMethods'),
  supportedCompressionResources?: string(name='SupportedCompressionResources'),
  supportedDistillationMethods?: map[string]any(name='SupportedDistillationMethods'),
  supportedDistillationResources?: string(name='SupportedDistillationResources'),
  supportedEvaluationMethods?: map[string]any(name='SupportedEvaluationMethods'),
  supportedEvaluationResources?: string(name='SupportedEvaluationResources'),
  supportedInferenceMethods?: map[string]any(name='SupportedInferenceMethods'),
  supportedInferenceResources?: string(name='SupportedInferenceResources'),
  supportedTrainingMethods?: map[string]any(name='SupportedTrainingMethods'),
  supportedTrainingResources?: string(name='SupportedTrainingResources'),
  tags?: {
    key?: string(name='Key'),
    value?: string(name='Value'),
  }(name='Tags'),
  task?: string(name='Task'),
  trainable?: boolean(name='Trainable'),
}

model CreateJobPlanRequest {
  jobPlanName?: string(name='JobPlanName', position='Body'),
  jobPlanSteps?: [ 
    {
      jobPlanStepName?: string(name='JobPlanStepName'),
      jobPlanStepSpec?: map[string]any(name='JobPlanStepSpec'),
      jobPlanStepType?: string(name='JobPlanStepType'),
    }
  ](name='JobPlanSteps', position='Body'),
  jobPlanType?: string(name='JobPlanType', position='Body'),
  tag?: [ 
    {
      key?: string(name='Key'),
      value?: string(name='Value'),
    }
  ](name='Tag', position='Body'),
  templateId?: string(name='TemplateId', example='advanced_cot_distill', position='Body'),
  workspaceId?: string(name='WorkspaceId', position='Body'),
}

model CreateJobPlanResponseBody = {
  jobPlanId?: string(name='JobPlanId'),
  requestId?: string(name='RequestId'),
}

model CreateJobPlanResponse = {
  headers?: map[string]string(name='headers'),
  statusCode?: int32(name='statusCode'),
  body?: CreateJobPlanResponseBody(name='body'),
}

/**
  * @param request  the request parameters of CreateJobPlan  CreateJobPlanRequest
  * @return CreateJobPlanResponse
 */
async function createJobPlan(request: CreateJobPlanRequest): CreateJobPlanResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'CreateJobPlan', 'POST', '/api/v1/jobplans', 'json', false, 'json', request);
}

