  ownerId?: long(name='OwnerId'),
  resourceOwnerAccount?: string(name='ResourceOwnerAccount'),
  resourceOwnerId?: long(name='ResourceOwnerId'),
  securityToken?: string(name='SecurityToken'),
  shardCount?: int32(name='ShardCount', description='The number of shards to add. Default value: **1**.
> The minimum total number of shards for an instance is 2. You can add up to 64 shards in a single operation, and the total number of shards for an instance cannot exceed 256. Make sure that the number of shards does not exceed this limit.', example='2'),
  sourceBiz?: string(name='SourceBiz', description='The request source. This parameter is used only for internal maintenance and does not need to be specified.', example='SDK'),
  vSwitchId?: string(name='VSwitchId', description='The ID of a different vSwitch within the same VPC. The new data shards are created under the specified vSwitch.
