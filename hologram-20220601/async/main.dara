model ScaleInstanceRequest {
  instanceId: string(name='instanceId', description='The ID of the Hologres instance.

This parameter is required.', example='hgprecn-cn-xxxxxxx', position='Path'),
  coldStorageSize?: long(name='coldStorageSize', description='The infrequent access storage space of the instance. Unit: GB.

> This parameter is ignored for pay-as-you-go instances.', example='1000', position='Body'),
  cpu?: long(name='cpu', description='The instance specifications. Valid values:
- 16 cores, 64 GB (Number of compute nodes: 1)
- 32 cores, 128 GB (Number of compute nodes: 2)
- 64 cores, 256 GB (Number of compute nodes: 4)
- 96 cores, 384 GB (Number of compute nodes: 6)
- 128 cores, 512 GB (Number of compute nodes: 8)
- More

>
 >- Specify only the number of cores.
 >- To purchase specifications with more than 1,024 cores, submit a ticket.
