model CreateInstanceRequest {
  autoPay?: boolean(name='autoPay', description='Specifies whether to enable automatic payment. Default value: true. Valid values:
- true: Automatic payment is enabled.
- false: Only an order is generated, and no payment is made.
> Default value: true. If your payment method has insufficient balance, you can set the AutoPay parameter to false. In this case, an unpaid order is generated, and you can log on to the Expenses and Costs console to complete the payment.', example='true', position='Body'),
  autoRenew?: boolean(name='autoRenew', description='Specifies whether to enable monthly auto-renewal. Default value: false. Valid values:
- true: Enabled.
- false: Disabled.', example='false', position='Body'),
  chargeType: string(name='chargeType', description='The billing method. Valid values:
- PrePaid: Subscription.
- PostPaid: Pay-as-you-go.
> This parameter is ignored for Shared instances. Shared is a defined specifications type, and its billing method defaults to PostPaid.

This parameter is required.', example='PostPaid', position='Body'),
  coldStorageSize?: long(name='coldStorageSize', description='The low-frequency storage capacity of the instance. Unit: GB.
> This parameter is ignored for pay-as-you-go instances.', example='500', position='Body'),
  cpu?: long(name='cpu', description='The instance specifications. Valid values:
- 32 cores, 128 GB (Number of compute nodes: 2)
- 64 cores, 256 GB (Number of compute nodes: 4)
- 96 cores, 384 GB (Number of compute nodes: 6)
- 128 cores, 512 GB (Number of compute nodes: 8)
- Other specifications

>
 >- Specify the number of cores.
 >- To purchase an instance with more than 1,024 cores, submit a ticket.
 >- You do not need to specify the specifications for a Shared instance.', example='64', position='Body'),
  duration?: long(name='duration', description='The subscription duration. For example, set this parameter to 2 for a two-month subscription.
> This parameter is not required if the billing method is PostPaid.', example='2', position='Body'),
  enableServerlessComputing?: boolean(name='enableServerlessComputing', description='Specifies whether to enable Serverless Computing.', example='true', position='Body'),
  gatewayCount?: long(name='gatewayCount', description='The number of gateways. Valid values: 2 to 50.

> This parameter is required only for Warehouse instances.', example='4', minimum=2, maximum=50, position='Body'),
  initialDatabases?: string(name='initialDatabases', description='The initial databases.', example='chatbot', position='Body'),
  instanceName: string(name='instanceName', description='The name of the instance. The name must be 2 to 64 characters in length. Each Chinese character or letter counts as one character.

This parameter is required.', example='my_holo', position='Body'),
  instanceType: string(name='instanceType', description='The instance type. Valid values:
- Standard: General-purpose.
- Follower: Read-only secondary instance.
- Warehouse: Compute group.
- Shared: Shared.
- Severless: Serverless.

This parameter is required.', example='Standard', position='Body'),
  leaderInstanceId?: string(name='leaderInstanceId', description='The ID of the primary instance. This parameter is required for Follower instances.

> The primary and secondary instances must meet the following conditions:
> - The primary instance is in the Running state.
> - The primary and secondary instances are in the same region.
> - The primary and secondary instances are in the same zone.
> - The primary instance is associated with fewer than 10 secondary instances.
> - The primary and secondary instances belong to the same Alibaba Cloud account.', example='hgpostcn-cn-lbj3aworq112', position='Body'),
  pricingCycle?: string(name='pricingCycle', description='The billing cycle. Valid values:
- Month: Monthly billing.
- Hour: Hourly billing.
>
> - PrePaid supports only Month.
> - PostPaid supports only Hour.
> - For Shared instances, this parameter is automatically set to Hour and does not need to be specified.', example='Month', position='Body'),
  regionId: string(name='regionId', description='The region ID. You can go to <props="china">[service registration endpoints](https://www.alibabacloud.com/help/en/hologres/developer-reference/api-hologram-2022-06-01-endpoint)
<props="intl">[service registration endpoints](https://www.alibabacloud.com/help/zh/hologres/developer-reference/api-hologram-2022-06-01-endpoint) to view the supported regions.

This parameter is required.', example='cn-hangzhou', position='Body'),
  resourceGroupId?: string(name='resourceGroupId', description='The ID of the resource group. If this parameter is left empty, the default resource group of the account is used.', example='""', position='Body'),
  storageSize?: long(name='storageSize', description='The standard storage capacity of the instance. Unit: GB.
> This parameter is ignored for pay-as-you-go instances.', example='500', position='Body'),
  storageType?: string(name='storageType', description='The storage type.', example='redundant', position='Body'),
  vSwitchId: string(name='vSwitchId', description='The ID of the vSwitch. The zone ID of the vSwitch must be the same as that of the instance.

This parameter is required.', example='vsw-2vccsiymtxxxxxx', position='Body'),
  vpcId: string(name='vpcId', description='The ID of the virtual private cloud (VPC). The region ID of the VPC must be the same as that of the instance.

This parameter is required.', example='vpc-t4netc3y5xxxx', position='Body'),
  zoneId: string(name='zoneId', description='The zone ID. Refer to the usage notes.

This parameter is required.', example='cn-hangzhou-h', position='Body'),
}

model CreateInstanceResponseBody = {
  data?: {
    code?: string(name='Code', description='The error code.', example='InvalidVpcOrVSwitch.NotAvailable'),
    instanceId?: string(name='InstanceId', description='The instance ID.', example='hgpostcn-cn-xxxxxx'),
    message?: string(name='Message', description='The detailed error message.', example='InvalidVpcOrVSwitch.NotAvailable'),
    orderId?: string(name='OrderId', description='The order ID.', example='217523224780172'),
