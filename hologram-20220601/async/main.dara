  leaderInstanceId?: string(name='leaderInstanceId', description='The leader instance ID. The region ID, zone ID, and version of the follower instance must be the same as those of the leader instance. Select the leader instance ID from the list of instances returned by the ListFollowerInstances operation.', example='hgpostcn-cn-uqm3316l1004', position='Body'),
}

