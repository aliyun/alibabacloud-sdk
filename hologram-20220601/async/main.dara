model ListBackupDataResponseBody = {
  backupDataList?: [ 
    {
      backupType?: string(name='BackupType', description='The backup type. Backup types are generally divided into two categories: 1) Local backup, where the snapshot and the instance belong to the same region. 2) Remote backup, where the snapshot and the instance belong to different regions. Valid values:
- redundant: Local backup with cross-zone multi-copy storage in the same region.
- redundant_remote: Remote backup with cross-zone multi-copy storage in the same region, which is a cross-region copy of the redundant type.
- full: Local backup with single-copy storage.
- full_remote: Remote backup with single-copy storage, which is a cross-region copy of the full type.
- local: Does not represent a specific backup type and is only used to filter local backup data.
- remote: Does not represent a specific backup type and is only used to filter remote backup data.', example='redundant'),
      coldDataSize?: long(name='ColdDataSize', description='The size of the cold storage data. Unit: bytes.', example='32413521'),
      dataDesc?: string(name='DataDesc', description='The description of the backup data. This field can be updated.', example='demo'),
      dataGran?: string(name='DataGran', description='The backup granularity.', example='instance'),
      dataSize?: long(name='DataSize', description='The size of the backup data. Unit: bytes.', example='76085723136'),
      dataTime?: string(name='DataTime', description='The data snapshot time. For the format, refer to StartTime.', example='2024-10-28T12:23:37.000+00:00'),
      endTime?: string(name='EndTime', description='The end time of the backup. For the format, refer to StartTime.', example='2024-10-28T12:27:34.000+00:00'),
      id?: long(name='Id', description='The unique ID of the backup.', example='1780805690994479105'),
      instanceId?: string(name='InstanceId', description='The instance ID.', example='hgpostcn-cn-pe33jdxxxxx'),
      instanceName?: string(name='InstanceName', description='The instance name.', example='my-hologres-dw'),
      instanceRegion?: string(name='InstanceRegion', description='The region where the instance resides.', example='cn-hangzhou'),
      instanceType?: string(name='InstanceType', description='The instance type.', example='Warehouse'),
      instanceZoneId?: string(name='InstanceZoneId', description='The zone where the instance resides.', example='cn-hangzhou-j'),
      snapshotRegion?: string(name='SnapshotRegion', description='The region where the backup data resides.', example='cn-hangzhou'),
      snapshotZoneId?: string(name='SnapshotZoneId', description='The zone where the backup data resides. For zone-redundant storage, the data is stored across multiple zones, and this field indicates one of the zones.', example='cn-hangzhou-j'),
      startTime?: string(name='StartTime', description='The start time of the backup. The time is in the UTC+8 time zone and follows the YYYY-MM-DDTHH:mm:ss.SSSTZ format. The same applies to other time fields.', example='2024-10-28T11:19:56.000+00:00'),
      status?: string(name='Status', description='The backup status.', example='completed'),
      triggerType?: string(name='TriggerType', description='The trigger type.', example='scheduled'),
    }
  ](name='BackupDataList', description='The list of backups.'),
