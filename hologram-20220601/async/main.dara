  httpStatusCode?: string(name='HttpStatusCode', description='The HTTP status code.', example='200'),
  requestId?: string(name='RequestId', description='Id of the request', example='6FF2EDFD-3154-5C3E-8CFA-8F7E366BCF9D'),
  success?: boolean(name='Success', description='Indicates whether the request is successful. This parameter is independent of the business result.', example='true'),
}

model BindLeaderInstanceResponse = {
