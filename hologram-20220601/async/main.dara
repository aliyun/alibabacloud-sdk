  * @return BindLeaderInstanceResponse
 */
async function bindLeaderInstance(request: BindLeaderInstanceRequest): BindLeaderInstanceResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RESTFUL', 'BindLeaderInstance', 'POST', '/api/v1/instances/{instanceId}/bindReadOnly', 'json', false, 'json', request);
}

