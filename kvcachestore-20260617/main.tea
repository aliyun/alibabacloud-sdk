This parameter is required.', example='B6'),
  name?: string(name='Name', description='The KVCacheStore name. The name must be 2 to 128 characters in length and can contain characters from the Unicode letter category (including English and Chinese characters) and digits. The name can contain colons (:), underscores (_), periods (.), and hyphens (-). If this parameter is not specified, the default value is the KVCacheStore ID.', example='sc-data-warehouse-server'),
  paymentType?: string(name='PaymentType', description='The billing method. Valid values: POSTPAY (pay-as-you-go). Default value: POSTPAY.', example='POSTPAY'),
  regionId?: string(name='RegionId', description='The region ID in which to create the KVCacheStore. You can call DescribeRegions to query the list of available regions.

This parameter is required.', example='cn-hangzhou'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-aekzafsjd7i4qaq'),
  tag?: [ 
    {
      tagKey?: string(name='TagKey', description='The tag key of the resource.', example='000098da1005a3df'),
      tagValue?: string(name='TagValue', description='The tag value of the resource.', example='000088aabb0023f7'),
    }
