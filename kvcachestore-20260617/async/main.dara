  };
}

function close(): void {
  @handler.close();
}

model AttachKVCacheStoreRequest {
  arns?: [ 
    {
      assumeRoleFor?: string(name='AssumeRoleFor', description='The UID of the target account for role assumption.', example='1193522024229156'),
      roleArn: string(name='RoleArn', description='The Alibaba Cloud Resource Name (ARN) of the RAM role.

This parameter is required.', example='acs:ram::1028257687084022:role/zeus-locationservicerole'),
      roleType: string(name='RoleType', description='The role type. Valid values:
- service
- user

This parameter is required.', example='service'),
    }
  ](name='Arns', description='The cross-account authorization role chain used for cross-account VSC resource verification.', position='Query'),
  clientToken?: string(name='ClientToken', description='A string generated by the server that serves as a unique identifier for the client request.', example='YOUR_CLIENT_TOKEN', position='Query'),
  regionId: string(name='RegionId', description='The region ID, such as cn-hangzhou.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceIds: [ 
    {
      kvcsId: string(name='KvcsId', description='KVCacheStore KvcsId

This parameter is required.', example='kvcs-your-resource-id'),
      vscId: string(name='VscId', description='The VSC ID pre-created on the compute side.

This parameter is required.', example='vsc-uf6acaf6k6mt1ts95to6al'),
    }
  ](name='ResourceIds', description='The list of resources to mount. A maximum of 100 resources can be specified.

This parameter is required.', position='Query'),
}

model AttachKVCacheStoreResponseBody = {
  attachResults?: [ 
    {
      errorCode?: string(name='ErrorCode', description='The error code returned when the operation fails. This value is null when the operation succeeds.', example='InvalidStatus.OperationDenied'),
      errorMessage?: string(name='ErrorMessage', description='The error message returned when the operation fails. This value is null when the operation succeeds.', example='The operation is not allowed for instance in ATTACHED status.'),
      kvcsId?: string(name='KvcsId', description='KVCacheStore KvcsId', example='kvcs-xxxxx'),
      status?: string(name='Status', description='The operation result. Valid values:
- ATTACHING: The request has been accepted and the asynchronous mount is in progress.
- ATTACHED: The resource is already mounted (idempotent).
- Success: The synchronous verification passed and the asynchronous operation is complete.
- Failed: The operation failed.', example='ATTACHING'),
      vscId?: string(name='VscId', description='The VSC ID on the compute side.', example='vsc-001'),
    }
  ](name='AttachResults', description='The list of mount results.'),
  requestId?: string(name='RequestId', description='The request ID. A request ID is returned regardless of whether the API call succeeds.', example='F7BEF1E2-7E56-5BF1-8E36-77A51C5812F1'),
