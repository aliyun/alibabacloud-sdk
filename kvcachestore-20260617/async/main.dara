  body?: AttachKVCacheStoreResponseBody(name='body'),
}

/**
  * @description * This is an asynchronous operation. A return status of Attaching indicates that the request has been accepted. Call ListKVCacheStoreAttachInfo to query mount records. A record status of Attached indicates that the mount is complete.
  * * The KVCacheStore must be in the Available or InUse state before it can be mounted.
  * @param request  the request parameters of AttachKVCacheStore  AttachKVCacheStoreRequest
  * @return AttachKVCacheStoreResponse
 */
async function attachKVCacheStore(request: AttachKVCacheStoreRequest): AttachKVCacheStoreResponse {
  @handler.validateRequestModel(request);
  return @handler.do('RPC', 'AttachKVCacheStore', 'POST', '/', 'json', false, 'json', request);
}

model CreateKVCacheStoreRequest {
  capacity: long(name='Capacity', description='The storage capacity in GiB. The minimum capacity is 300 TiB (307200 GiB), and the capacity is scaled in increments of 300 TiB.

This parameter is required.', example='2395', position='Query'),
  clientToken?: string(name='ClientToken', description='The client token used to ensure idempotence of the request. The token can be up to 64 characters in length. Use a UUID.', example='YOUR_CLIENT_TOKEN', position='Query'),
  description?: string(name='Description', description='The KVCacheStore description. The description must be 2 to 256 characters in length and cannot start with http:// or https://. Default value: empty.', example='No description', position='Query'),
  hpnZone: string(name='HpnZone', description='The HPN cluster ID, which is used to create an affinity scheduling relationship between the KVCacheStore and the specified HPN cluster. After creation, the KVCacheStore may have affinity relationships with multiple HPN clusters based on network topology. You can call GetKVCacheStore to query the available HPN clusters.

This parameter is required.', example='B6', position='Query'),
  name?: string(name='Name', description='The KVCacheStore name. The name must be 2 to 128 characters in length and can contain characters from the Unicode letter category (including English and Chinese characters) and digits. The name can contain colons (:), underscores (_), periods (.), and hyphens (-). If this parameter is not specified, the default value is the KVCacheStore ID.', example='sc-data-warehouse-server', position='Query'),
  paymentType?: string(name='PaymentType', description='The billing method. Valid values: POSTPAY (pay-as-you-go). Default value: POSTPAY.', example='POSTPAY', position='Query'),
  regionId: string(name='RegionId', description='The region ID in which to create the KVCacheStore. You can call DescribeRegions to query the list of available regions.

This parameter is required.', example='cn-hangzhou', position='Query'),
  resourceGroupId?: string(name='ResourceGroupId', description='The resource group ID.', example='rg-aekzafsjd7i4qaq', position='Query'),
  tag?: [ 
    {
      tagKey?: string(name='TagKey', description='The tag key of the resource.', example='000098da1005a3df'),
      tagValue?: string(name='TagValue', description='The tag value of the resource.', example='000088aabb0023f7'),
    }
  ](name='Tag', description='The list of resource tag key-value pairs. A maximum of 20 tags are supported. This overrides the parent TagDTO type and uses the same Tag type as the Get/List response.', position='Query'),
  zoneId: string(name='ZoneId', description='The zone ID. You can call DescribeZones to query the list of zones in the specified region.

This parameter is required.', example='cn-hangzhou-b', position='Query'),
}

model CreateKVCacheStoreResponseBody = {
  kvcsId?: string(name='KvcsId', description='The ID of the newly created KVCacheStore.', example='kvs-xxxxx'),
  orderId?: string(name='OrderId', description='The order ID generated by this creation request.', example='order-xxxxx'),
  requestId?: string(name='RequestId', description='The request ID.', example='API-a6e81d15-1b36-4d37-ad61-593531e7fa58'),
